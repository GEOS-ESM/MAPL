#include "MAPL_TestErr.h"

module Test_MaplServerUtilities
   use mapl_MaplServerUtilities_mod
   use esmf
   use pfunit
   implicit none

contains

   !----------------------------------------------------------------------
   ! pets_on_ssis — pure function, no MPI/ESMF dependency
   !----------------------------------------------------------------------

   @test
   subroutine test_pets_on_ssis_single_ssi()
      integer, allocatable :: pets(:)
      pets = pets_on_ssis([0,0,0], ssi_lo=0, ssi_hi=1)
      @assertEqual([0,1,2], pets)
   end subroutine test_pets_on_ssis_single_ssi

   @test
   subroutine test_pets_on_ssis_second_ssi()
      integer, allocatable :: pets(:)
      pets = pets_on_ssis([0,0,1,1], ssi_lo=1, ssi_hi=2)
      @assertEqual([2,3], pets)
   end subroutine test_pets_on_ssis_second_ssi

   @test
   subroutine test_pets_on_ssis_middle_ssi()
      integer, allocatable :: pets(:)
      pets = pets_on_ssis([0,0,1,1,2,2], ssi_lo=1, ssi_hi=2)
      @assertEqual([2,3], pets)
   end subroutine test_pets_on_ssis_middle_ssi

   @test
   subroutine test_pets_on_ssis_empty_range()
      integer, allocatable :: pets(:)
      pets = pets_on_ssis([0,0,1,1], ssi_lo=2, ssi_hi=3)
      @assertEqual(0, size(pets))
   end subroutine test_pets_on_ssis_empty_range

   @test
   subroutine test_pets_on_ssis_full_range()
      integer, allocatable :: pets(:)
      pets = pets_on_ssis([0,0,1,1], ssi_lo=0, ssi_hi=2)
      @assertEqual([0,1,2,3], pets)
   end subroutine test_pets_on_ssis_full_range

   !----------------------------------------------------------------------
   ! get_num_ssis
   !----------------------------------------------------------------------

   @test
   subroutine test_get_num_ssis_two_ssis()
      integer :: n, rc
      n = get_num_ssis(petCount=4, ssiMap=[0,0,1,1], ssiOffset=0, rc=rc)
      @assertEqual(0, rc)
      @assertEqual(2, n)
   end subroutine test_get_num_ssis_two_ssis

   @test
   subroutine test_get_num_ssis_partial_ssi()
      ! Only 2 of 4 PETs needed; all on ssi 0 — result is 1 SSI.
      integer :: n, rc
      n = get_num_ssis(petCount=2, ssiMap=[0,0,1,1], ssiOffset=0, rc=rc)
      @assertEqual(0, rc)
      @assertEqual(1, n)
   end subroutine test_get_num_ssis_partial_ssi

   @test
   subroutine test_get_num_ssis_with_offset()
      ! SSI 1 has 2 PETs; starting from ssiOffset=1, petCount=2 fits in 1 SSI.
      integer :: n, rc
      n = get_num_ssis(petCount=2, ssiMap=[0,0,1,1,2,2], ssiOffset=1, rc=rc)
      @assertEqual(0, rc)
      @assertEqual(1, n)
   end subroutine test_get_num_ssis_with_offset

   @test
   subroutine test_get_num_ssis_one_per_ssi()
      integer :: n, rc
      n = get_num_ssis(petCount=1, ssiMap=[0,1,2,3], ssiOffset=0, rc=rc)
      @assertEqual(0, rc)
      @assertEqual(1, n)
   end subroutine test_get_num_ssis_one_per_ssi

   @test
   subroutine test_get_num_ssis_all_unique_ssis()
      integer :: n, rc
      n = get_num_ssis(petCount=4, ssiMap=[0,1,2,3], ssiOffset=0, rc=rc)
      @assertEqual(0, rc)
      @assertEqual(4, n)
   end subroutine test_get_num_ssis_all_unique_ssis

   @test
   subroutine test_get_num_ssis_error_insufficient_resources()
      integer :: n, rc
      ! Only 2 PETs available but petCount=5 requested.
      n = get_num_ssis(petCount=5, ssiMap=[0,0], ssiOffset=0, rc=rc)
      @assertExceptionRaised('Insufficient resources for running model.')
   end subroutine test_get_num_ssis_error_insufficient_resources

   !----------------------------------------------------------------------
   ! get_ssis_per_server — wildcard '*' support (requires ESMF)
   !----------------------------------------------------------------------

   @test
   subroutine test_ssis_per_server_single_integer()
      type(ESMF_HConfig) :: hcfg(1)
      integer, allocatable :: result(:)
      integer :: rc

      hcfg(1) = ESMF_HConfigCreate(content='num_nodes: 2', rc=rc)
      @assertEqual(0, rc)

      result = get_ssis_per_server(hcfg, ssiCount=4, num_model_ssis=1, rc=rc)
      @assertEqual(0, rc)
      @assertEqual([2], result)

      call ESMF_HConfigDestroy(hcfg(1), rc=rc)
   end subroutine test_ssis_per_server_single_integer

   @test
   subroutine test_ssis_per_server_two_integers()
      type(ESMF_HConfig) :: hcfg(2)
      integer, allocatable :: result(:)
      integer :: rc

      hcfg(1) = ESMF_HConfigCreate(content='num_nodes: 2', rc=rc)
      @assertEqual(0, rc)
      hcfg(2) = ESMF_HConfigCreate(content='num_nodes: 3', rc=rc)
      @assertEqual(0, rc)

      ! model=1, server1=2, server2=3 → fits in ssiCount=6
      result = get_ssis_per_server(hcfg, ssiCount=6, num_model_ssis=1, rc=rc)
      @assertEqual(0, rc)
      @assertEqual([2, 3], result)

      call ESMF_HConfigDestroy(hcfg(1), rc=rc)
      call ESMF_HConfigDestroy(hcfg(2), rc=rc)
   end subroutine test_ssis_per_server_two_integers

   @test
   subroutine test_ssis_per_server_wildcard_only()
      type(ESMF_HConfig) :: hcfg(1)
      integer, allocatable :: result(:)
      integer :: rc

      hcfg(1) = ESMF_HConfigCreate(content="num_nodes: '*'", rc=rc)
      @assertEqual(0, rc)

      ! model=1, wildcard claims ssiCount-1=3
      result = get_ssis_per_server(hcfg, ssiCount=4, num_model_ssis=1, rc=rc)
      @assertEqual(0, rc)
      @assertEqual([3], result)

      call ESMF_HConfigDestroy(hcfg(1), rc=rc)
   end subroutine test_ssis_per_server_wildcard_only

   @test
   subroutine test_ssis_per_server_wildcard_last()
      type(ESMF_HConfig) :: hcfg(2)
      integer, allocatable :: result(:)
      integer :: rc

      hcfg(1) = ESMF_HConfigCreate(content='num_nodes: 2', rc=rc)
      @assertEqual(0, rc)
      hcfg(2) = ESMF_HConfigCreate(content="num_nodes: '*'", rc=rc)
      @assertEqual(0, rc)

      ! model=1, server1=2 used; wildcard claims 7-1-2=4
      result = get_ssis_per_server(hcfg, ssiCount=7, num_model_ssis=1, rc=rc)
      @assertEqual(0, rc)
      @assertEqual([2, 4], result)

      call ESMF_HConfigDestroy(hcfg(1), rc=rc)
      call ESMF_HConfigDestroy(hcfg(2), rc=rc)
   end subroutine test_ssis_per_server_wildcard_last

   @test
   subroutine test_ssis_per_server_wildcard_not_last()
      ! '*' on first of two servers must fail.
      type(ESMF_HConfig) :: hcfg(2)
      integer, allocatable :: result(:)
      integer :: rc

      hcfg(1) = ESMF_HConfigCreate(content="num_nodes: '*'", rc=rc)
      hcfg(2) = ESMF_HConfigCreate(content='num_nodes: 2', rc=rc)

      result = get_ssis_per_server(hcfg, ssiCount=7, num_model_ssis=1, rc=rc)
      @assertExceptionRaised("'*' for num_nodes is only valid for the last server")
   end subroutine test_ssis_per_server_wildcard_not_last

   @test
   subroutine test_ssis_per_server_wildcard_oversubscribed()
      ! model already uses all SSIs; wildcard gets zero → error.
      type(ESMF_HConfig) :: hcfg(1)
      integer, allocatable :: result(:)
      integer :: rc

      hcfg(1) = ESMF_HConfigCreate(content="num_nodes: '*'", rc=rc)

      result = get_ssis_per_server(hcfg, ssiCount=2, num_model_ssis=2, rc=rc)
      @assertExceptionRaised("PET resources oversubscribed: no SSIs remain for wildcard server")
   end subroutine test_ssis_per_server_wildcard_oversubscribed

end module Test_MaplServerUtilities
