   ! ---- State's own Info (no short_name) -------------------------

   @test
   subroutine test_state_shared_logical()
      type(ESMF_State) :: state
      integer :: status
      logical :: l

      state = ESMF_StateCreate(name='export', _RC)

      call MAPL_InfoSetShared(state, key='a', value=.true., _RC)
      l = .false.
      call MAPL_InfoGetShared(state, key='a', value=l, _RC)
      @assert_that(l, is(true()))

      call MAPL_InfoSetShared(state, key='a', value=.false., _RC)
      l = .true.
      call MAPL_InfoGetShared(state, key='a', value=l, _RC)
      @assert_that(l, is(false()))

      call ESMF_StateDestroy(state, _RC)
   end subroutine test_state_shared_logical

