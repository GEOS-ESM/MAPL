   ! ---- string lists ---------------------------------------------

   @test
   ! Trailing blanks in a stored string do not survive a round trip.
   ! @assertEqual pads the shorter side before comparing, so len_trim
   ! (not @assertEqual against the padded literal) is what actually
   ! distinguishes trimmed from untrimmed.
   subroutine test_info_string_list()
      type(ESMF_Info) :: info
      integer :: status
      type(StringVector) :: v
      character(len=6), parameter :: expected(*) = ['alpha ', 'beta  ', 'gamma ']

      info = ESMF_InfoCreate(_RC)
      call MAPL_InfoSet(info, key='a', values=expected, _RC)
      call MAPL_InfoGet(info, key='a', values=v, _RC)

      @assertEqual(3, v%size())
      @assertEqual('alpha', v%of(1))
      @assertEqual('beta', v%of(2))
      @assertEqual('gamma', v%of(3))
      @assertEqual(5, len_trim(v%of(1)))
      @assertEqual(4, len_trim(v%of(2)))
      @assertEqual(5, len_trim(v%of(3)))

      call ESMF_InfoDestroy(info, _RC)
   end subroutine test_info_string_list

   @test
   subroutine test_info_string_list_absent_key_fails()
      type(ESMF_Info) :: info
      integer :: status
      type(StringVector) :: v

      info = ESMF_InfoCreate(_RC)
      call MAPL_InfoGet(info, key='nokey', values=v, rc=status)

      @assertExceptionRaised()
      @assertTrue(status /= _SUCCESS)

      call ESMF_InfoDestroy(info, _RC)
   end subroutine test_info_string_list_absent_key_fails

   @test
   subroutine test_set_stateitem_shared_string_list()
      type(ESMF_State) :: state
      type(ESMF_Field) :: field
      integer :: status
      type(StringVector) :: v
      character(len=4), parameter :: expected(*) = ['one ', 'two ', 'tre ']

      state = ESMF_StateCreate(name='export', _RC)
      field = ESMF_FieldEmptyCreate(name='f', _RC)
      call ESMF_StateAdd(state, [field], _RC)

      call MAPL_InfoSetShared(state, short_name='f', key='a', values=expected, _RC)
      call MAPL_InfoGetShared(state, short_name='f', key='a', values=v, _RC)

      @assertEqual(3, v%size())
      @assertEqual('one', v%of(1))
      @assertEqual('two', v%of(2))
      @assertEqual('tre', v%of(3))

      call ESMF_FieldDestroy(field, _RC)
      call ESMF_StateDestroy(state, _RC)
   end subroutine test_set_stateitem_shared_string_list

   @test
   subroutine test_set_stateitem_private_string_list()
      type(ESMF_State) :: state
