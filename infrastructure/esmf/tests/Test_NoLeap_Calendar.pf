#include "MAPL_TestErr.h"
module Test_NoLeap_Calendar
   use esmf
   use funit
   implicit none

contains

   ! Test that a calendar created with ESMF_CALKIND_NOLEAP reports the correct kind.
   @Test
   subroutine test_noleap_calendar_kind()
      type(ESMF_Calendar) :: cal
      type(ESMF_CalKind_Flag) :: calKind
      integer :: status

      cal = ESMF_CalendarCreate(ESMF_CALKIND_NOLEAP, name='noleap', rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_CalendarCreate should succeed for NOLEAP')

      call ESMF_CalendarGet(cal, calkindflag=calKind, rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_CalendarGet should succeed')
      @assertEqual(ESMF_CALKIND_NOLEAP, calKind, 'Calendar kind should be ESMF_CALKIND_NOLEAP')

      call ESMF_CalendarDestroy(cal, rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_CalendarDestroy should succeed')

   end subroutine test_noleap_calendar_kind

   ! Test that the default calendar has been set to NOLEAP by the test initialization.
   @Test
   subroutine test_default_calendar_is_noleap()
      type(ESMF_CalKind_Flag) :: calKind
      integer :: status

      call ESMF_CalendarGet(ESMF_DEFAULT_CAL, calkindflag=calKind, rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_CalendarGet on default calendar should succeed')
      @assertEqual(ESMF_CALKIND_NOLEAP, calKind, 'Default calendar should be ESMF_CALKIND_NOLEAP')

   end subroutine test_default_calendar_is_noleap

   ! Test that February 2000 (a Gregorian leap year) has only 28 days
   ! when an explicit NOLEAP calendar is used.
   @Test
   subroutine test_noleap_feb2000_has_28_days_explicit_calendar()
      type(ESMF_Calendar) :: cal
      type(ESMF_Time) :: feb28, next_day
      type(ESMF_TimeInterval) :: one_day
      integer :: yy, mm, dd
      integer :: status

      cal = ESMF_CalendarCreate(ESMF_CALKIND_NOLEAP, name='noleap_test', rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_CalendarCreate should succeed')

      call ESMF_TimeSet(feb28, yy=2000, mm=2, dd=28, h=0, m=0, s=0, calendar=cal, rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_TimeSet for 2000-02-28 should succeed')

      call ESMF_TimeIntervalSet(one_day, d=1, rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_TimeIntervalSet should succeed')

      next_day = feb28 + one_day

      call ESMF_TimeGet(next_day, yy=yy, mm=mm, dd=dd, rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_TimeGet should succeed')
      @assertEqual(2000, yy, 'Year should be 2000')
      @assertEqual(3, mm, 'Month after Feb 28 should be March in NOLEAP (no Feb 29)')
      @assertEqual(1, dd, 'Day after Feb 28 should be March 1 in NOLEAP')

      call ESMF_CalendarDestroy(cal, rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_CalendarDestroy should succeed')

   end subroutine test_noleap_feb2000_has_28_days_explicit_calendar

   ! Test that February 2000 has only 28 days using the default NOLEAP calendar
   ! (set by the test initialization routine).
   @Test
   subroutine test_noleap_feb2000_has_28_days_default_calendar()
      type(ESMF_Time) :: feb28, next_day
      type(ESMF_TimeInterval) :: one_day
      integer :: yy, mm, dd
      integer :: status

      ! Use default calendar (NOLEAP, set in Initialize())
      call ESMF_TimeSet(feb28, yy=2000, mm=2, dd=28, h=0, m=0, s=0, rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_TimeSet for 2000-02-28 should succeed')

      call ESMF_TimeIntervalSet(one_day, d=1, rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_TimeIntervalSet should succeed')

      next_day = feb28 + one_day

      call ESMF_TimeGet(next_day, yy=yy, mm=mm, dd=dd, rc=status)
      @assertEqual(ESMF_SUCCESS, status, 'ESMF_TimeGet should succeed')
      @assertEqual(2000, yy, 'Year should be 2000')
      @assertEqual(3, mm, 'Month after Feb 28 should be March in NOLEAP default calendar')
      @assertEqual(1, dd, 'Day after Feb 28 should be March 1 in NOLEAP default calendar')

   end subroutine test_noleap_feb2000_has_28_days_default_calendar

end module Test_NoLeap_Calendar
