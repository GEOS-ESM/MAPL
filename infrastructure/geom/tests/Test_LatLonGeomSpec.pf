module Test_LatLonGeomSpec

   use mapl_LatLonGeomSpec_mod
   use mapl_LatLonTestHelper_mod
   use pfio, only: FileMetadata
   use esmf
   use funit
   use, intrinsic :: iso_fortran_env, only: REAL64

   implicit none

contains

   @test
   subroutine test_get_horz_ij_index_double_precision()
      type(ESMF_HConfig) :: hconfig
      type(LatLonGeomSpec) :: spec
      integer, allocatable :: ii(:), jj(:)
      real(kind=ESMF_KIND_R8), allocatable :: lonR8(:), latR8(:)
      character(len=:), allocatable :: content
      integer :: status

      content = '{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC}'
      hconfig = ESMF_HConfigCreate(content=content, rc=status)
      @assertEqual(0, status)

      spec = make_LatLonGeomSpec(hconfig, rc=status)
      @assertEqual(0, status)

      lonR8 = [0.1d0, -3.0d0, 1.0d0, 5.5d0]
      latR8 = [0.0d0, 0.0d0, 0.8d0, -0.8d0]

      call spec%get_horz_ij_index(lon=lonR8, lat=latR8, ii=ii, jj=jj, rc=status)
      @assertEqual(0, status)

      @assertTrue(all(ii >= 1))
      @assertTrue(all(ii <= 12))
      @assertTrue(all(jj >= 1))
      @assertTrue(all(jj <= 13))

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_get_horz_ij_index_double_precision

   @test
   subroutine test_get_horz_ij_index_single_precision()
      type(ESMF_HConfig) :: hconfig
      type(LatLonGeomSpec) :: spec
      integer, allocatable :: ii(:), jj(:)
      real(kind=ESMF_KIND_R4), allocatable :: lon(:), lat(:)
      character(len=:), allocatable :: content
      integer :: status

      content = '{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC}'
      hconfig = ESMF_HConfigCreate(content=content, rc=status)
      @assertEqual(0, status)

      spec = make_LatLonGeomSpec(hconfig, rc=status)
      @assertEqual(0, status)

      lon = [0.1, -3.0, 1.0, 5.5]
      lat = [0.0, 0.0, 0.8, -0.8]

      call spec%get_horz_ij_index(lon=lon, lat=lat, ii=ii, jj=jj, rc=status)
      @assertEqual(0, status)

      @assertTrue(all(ii >= 1))
      @assertTrue(all(ii <= 12))
      @assertTrue(all(jj >= 1))
      @assertTrue(all(jj <= 13))

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_get_horz_ij_index_single_precision

   @test
   subroutine test_get_horz_ij_index_single_point()
      type(ESMF_HConfig) :: hconfig
      type(LatLonGeomSpec) :: spec
      integer, allocatable :: ii(:), jj(:)
      real(kind=ESMF_KIND_R8), allocatable :: lonR8(:), latR8(:)
      character(len=:), allocatable :: content
      integer :: status

      content = '{class: latlon, im_world: 10, jm_world: 10, pole: PC, dateline: DC}'
      hconfig = ESMF_HConfigCreate(content=content, rc=status)
      @assertEqual(0, status)

      spec = make_LatLonGeomSpec(hconfig, rc=status)
      @assertEqual(0, status)

      lonR8 = [0.0d0]
      latR8 = [0.0d0]

      call spec%get_horz_ij_index(lon=lonR8, lat=latR8, ii=ii, jj=jj, rc=status)
      @assertEqual(0, status)

      @assertTrue(ii(1) >= 1)
      @assertTrue(ii(1) <= 10)
      @assertTrue(jj(1) >= 1)
      @assertTrue(jj(1) <= 10)

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_get_horz_ij_index_single_point

   @test
   subroutine test_get_horz_ij_index_dateline_crossing()
      type(ESMF_HConfig) :: hconfig
      type(LatLonGeomSpec) :: spec
      integer, allocatable :: ii(:), jj(:)
      real(kind=ESMF_KIND_R8), allocatable :: lonR8(:), latR8(:)
      character(len=:), allocatable :: content
      integer :: status

      content = '{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC}'
      hconfig = ESMF_HConfigCreate(content=content, rc=status)
      @assertEqual(0, status)

      spec = make_LatLonGeomSpec(hconfig, rc=status)
      @assertEqual(0, status)

      lonR8 = [3.0d0, -3.0d0]
      latR8 = [0.0d0, 0.0d0]

      call spec%get_horz_ij_index(lon=lonR8, lat=latR8, ii=ii, jj=jj, rc=status)
      @assertEqual(0, status)

      @assertTrue(all(ii >= 1))
      @assertTrue(all(ii <= 12))
      @assertTrue(all(jj >= 1))
      @assertTrue(all(jj <= 13))

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_get_horz_ij_index_dateline_crossing

   @test
   subroutine test_get_horz_ij_index_out_of_bounds()
      type(ESMF_HConfig) :: hconfig
      type(LatLonGeomSpec) :: spec
      integer, allocatable :: ii(:), jj(:)
      real(kind=ESMF_KIND_R8), allocatable :: lonR8(:), latR8(:)
      character(len=:), allocatable :: content
      integer :: status

      content = '{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC}'
      hconfig = ESMF_HConfigCreate(content=content, rc=status)
      @assertEqual(0, status)

      spec = make_LatLonGeomSpec(hconfig, rc=status)
      @assertEqual(0, status)

      lonR8 = [0.0d0, 0.0d0]
      latR8 = [2.0d0, -2.0d0]

      call spec%get_horz_ij_index(lon=lonR8, lat=latR8, ii=ii, jj=jj, rc=status)
      @assertEqual(0, status)

      @assertTrue(all(ii >= 1))
      @assertTrue(all(ii <= 12))
      @assertTrue(all(jj == -1))

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_get_horz_ij_index_out_of_bounds

   @test
   subroutine test_get_horz_ij_index_zero_points()
      type(ESMF_HConfig) :: hconfig
      type(LatLonGeomSpec) :: spec
      integer, allocatable :: ii(:), jj(:)
      real(kind=ESMF_KIND_R8), allocatable :: lonR8(:), latR8(:)
      character(len=:), allocatable :: content
      integer :: status

      content = '{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC}'
      hconfig = ESMF_HConfigCreate(content=content, rc=status)
      @assertEqual(0, status)

      spec = make_LatLonGeomSpec(hconfig, rc=status)
      @assertEqual(0, status)

      allocate(lonR8(0), latR8(0))

      call spec%get_horz_ij_index(lon=lonR8, lat=latR8, ii=ii, jj=jj, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, size(ii))
      @assertEqual(0, size(jj))

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_get_horz_ij_index_zero_points

   ! -----------------------------------------------------------------------
   ! make_LatLonGeomSpec_from_metadata: "coordinate_tolerance" attribute
   ! handling (absent / present / wrong type / negative).
   ! -----------------------------------------------------------------------

   @test
   subroutine test_make_from_metadata_no_tolerance_attribute()
      type(FileMetadata) :: file_metadata
      type(LatLonGeomSpec) :: spec
      integer :: status

      call create_latlon_file('test_ll_meta_absent.nc', 12, 8, rc=status)
      @assert_that(status, is(0))
      file_metadata = read_latlon_metadata('test_ll_meta_absent.nc', rc=status)
      @assert_that(status, is(0))

      spec = make_LatLonGeomSpec(file_metadata, rc=status)
      @assert_that(status, is(0))
   end subroutine test_make_from_metadata_no_tolerance_attribute

   @test
   subroutine test_make_from_metadata_with_tolerance_attribute()
      type(FileMetadata) :: file_metadata
      type(LatLonGeomSpec) :: spec
      integer :: status

      call create_latlon_file('test_ll_meta_present.nc', 12, 8, rc=status)
      @assert_that(status, is(0))
      file_metadata = read_latlon_metadata('test_ll_meta_present.nc', rc=status)
      @assert_that(status, is(0))
      call file_metadata%add_attribute('coordinate_tolerance', 0.01_REAL64)

      spec = make_LatLonGeomSpec(file_metadata, rc=status)
      @assert_that(status, is(0))
   end subroutine test_make_from_metadata_with_tolerance_attribute

   @test
   subroutine test_make_from_metadata_rejects_non_real_tolerance()
      type(FileMetadata) :: file_metadata
      type(LatLonGeomSpec) :: spec
      integer :: status

      call create_latlon_file('test_ll_meta_badtype.nc', 12, 8, rc=status)
      @assert_that(status, is(0))
      file_metadata = read_latlon_metadata('test_ll_meta_badtype.nc', rc=status)
      @assert_that(status, is(0))
      call file_metadata%add_attribute('coordinate_tolerance', 'oops')

      spec = make_LatLonGeomSpec(file_metadata, rc=status)
      @assertExceptionRaised()
      @assertExceptionRaised()
   end subroutine test_make_from_metadata_rejects_non_real_tolerance

   @test
   subroutine test_make_from_metadata_rejects_negative_tolerance()
      type(FileMetadata) :: file_metadata
      type(LatLonGeomSpec) :: spec
      integer :: status

      call create_latlon_file('test_ll_meta_negative.nc', 12, 8, rc=status)
      @assert_that(status, is(0))
      file_metadata = read_latlon_metadata('test_ll_meta_negative.nc', rc=status)
      @assert_that(status, is(0))
      call file_metadata%add_attribute('coordinate_tolerance', -1.0_REAL64)

      spec = make_LatLonGeomSpec(file_metadata, rc=status)
      @assertExceptionRaised()
      @assertExceptionRaised()
   end subroutine test_make_from_metadata_rejects_negative_tolerance

   ! -----------------------------------------------------------------------
   ! equal_to: coordinate-tolerance-aware comparison at the LatLonGeomSpec
   ! level (mirrors CoordinateAxis cases in Test_CoordinateAxis.pf).
   ! -----------------------------------------------------------------------

   @test
   subroutine test_equal_to_within_tolerance()
      type(FileMetadata) :: metadata_a, metadata_b
      type(LatLonGeomSpec) :: a, b
      integer :: status

      ! Same im/jm; b's coordinates are perturbed by a tiny amount
      ! relative to the grid spacing (10 deg for 36x18).
      call create_latlon_file('test_ll_eq_tol_a.nc', 36, 18, rc=status)
      @assert_that(status, is(0))
      call create_latlon_file('test_ll_eq_tol_b.nc', 36, 18, rc=status, perturbation=1.0e-4_REAL64)
      @assert_that(status, is(0))

      metadata_a = read_latlon_metadata('test_ll_eq_tol_a.nc', rc=status)
      @assert_that(status, is(0))
      metadata_b = read_latlon_metadata('test_ll_eq_tol_b.nc', rc=status)
      @assert_that(status, is(0))
      call metadata_b%add_attribute('coordinate_tolerance', 1.0e-3_REAL64)

      a = make_LatLonGeomSpec(metadata_a, rc=status)
      @assert_that(status, is(0))
      b = make_LatLonGeomSpec(metadata_b, rc=status)
      @assert_that(status, is(0))

      @assertTrue(a == b)
      @assertTrue(b == a)
   end subroutine test_equal_to_within_tolerance

   @test
   subroutine test_equal_to_outside_tolerance()
      type(FileMetadata) :: metadata_a, metadata_b
      type(LatLonGeomSpec) :: a, b
      integer :: status

      call create_latlon_file('test_ll_eq_notol_a.nc', 36, 18, rc=status)
      @assert_that(status, is(0))
      call create_latlon_file('test_ll_eq_notol_b.nc', 36, 18, rc=status, perturbation=1.0e-1_REAL64)
      @assert_that(status, is(0))

      metadata_a = read_latlon_metadata('test_ll_eq_notol_a.nc', rc=status)
      @assert_that(status, is(0))
      metadata_b = read_latlon_metadata('test_ll_eq_notol_b.nc', rc=status)
      @assert_that(status, is(0))
      call metadata_b%add_attribute('coordinate_tolerance', 1.0e-3_REAL64)

      a = make_LatLonGeomSpec(metadata_a, rc=status)
      @assert_that(status, is(0))
      b = make_LatLonGeomSpec(metadata_b, rc=status)
      @assert_that(status, is(0))

      @assertFalse(a == b)
   end subroutine test_equal_to_outside_tolerance

   @test
   subroutine test_equal_to_default_no_attribute_is_strict()
      type(FileMetadata) :: metadata_a, metadata_b
      type(LatLonGeomSpec) :: a, b
      integer :: status

      call create_latlon_file('test_ll_eq_strict_a.nc', 36, 18, rc=status)
      @assert_that(status, is(0))
      call create_latlon_file('test_ll_eq_strict_b.nc', 36, 18, rc=status, perturbation=1.0e-4_REAL64)
      @assert_that(status, is(0))

      metadata_a = read_latlon_metadata('test_ll_eq_strict_a.nc', rc=status)
      @assert_that(status, is(0))
      metadata_b = read_latlon_metadata('test_ll_eq_strict_b.nc', rc=status)
      @assert_that(status, is(0))
      ! No coordinate_tolerance attribute stamped on either side.

      a = make_LatLonGeomSpec(metadata_a, rc=status)
      @assert_that(status, is(0))
      b = make_LatLonGeomSpec(metadata_b, rc=status)
      @assert_that(status, is(0))

      @assertFalse(a == b)
   end subroutine test_equal_to_default_no_attribute_is_strict

   @test
   subroutine test_decomposition_mismatch_ignores_tolerance()
      type(FileMetadata) :: metadata_a, metadata_b
      type(LatLonGeomSpec) :: a, b
      integer :: status

      ! Different im_world (12 vs 10) - a huge tolerance must not paper
      ! over a fundamentally different number of gridpoints/decomposition.
      call create_latlon_file('test_ll_eq_decomp_a.nc', 12, 8, rc=status)
      @assert_that(status, is(0))
      call create_latlon_file('test_ll_eq_decomp_b.nc', 10, 8, rc=status)
      @assert_that(status, is(0))

      metadata_a = read_latlon_metadata('test_ll_eq_decomp_a.nc', rc=status)
      @assert_that(status, is(0))
      metadata_b = read_latlon_metadata('test_ll_eq_decomp_b.nc', rc=status)
      @assert_that(status, is(0))
      call metadata_a%add_attribute('coordinate_tolerance', 1.0e6_REAL64)
      call metadata_b%add_attribute('coordinate_tolerance', 1.0e6_REAL64)

      a = make_LatLonGeomSpec(metadata_a, rc=status)
      @assert_that(status, is(0))
      b = make_LatLonGeomSpec(metadata_b, rc=status)
      @assert_that(status, is(0))

      @assertFalse(a == b)
   end subroutine test_decomposition_mismatch_ignores_tolerance

end module Test_LatLonGeomSpec
