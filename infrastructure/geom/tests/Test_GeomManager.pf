#include "MAPL_TestErr.h"
module Test_GeomManager
   use pfunit
   use mapl_geom_api
   use mapl_GeomId_mod, only: GeomId, operator(==), operator(/=)
   use mapl_LatLonTestHelper_mod
   use pfio, only: FileMetadata
   use esmf_TestMethod_mod ! mapl
   use esmf
   use, intrinsic :: iso_fortran_env, only: REAL64
   implicit none


contains

   @test(type=ESMF_TestMethod, npes=[1])
   ! Basic test to excercise a plausible sequence of steps without
   ! generating a non-zero return code.
   subroutine test_make_from_hconfig(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(mapl_GeomManager), target :: geom_manager
      type(ESMF_HConfig) :: hconfig
      integer :: status
      type(mapl_MaplGeom), pointer :: mapl_geom
      type(ESMF_Geom) :: geom

      hconfig = ESMF_HConfigCreate(content="{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC, nx: 1, ny: 1}", &
           rc=status)
      @assert_that(status, is(0))

      geom_manager = mapl_GeomManager()
      mapl_geom => geom_manager%get_mapl_geom(hconfig, rc=status)
      @assert_that(status, is(0))

      geom = mapl_geom%get_geom()

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assert_that(status, is(0))
      
   end subroutine test_make_from_hconfig

   @test(type=ESMF_TestMethod, npes=[1])
   ! Test that an identical call to geom_manager results in the same
   ! geom object being returned.  This is an essential property of the
   ! manager to ensure that cached values of geoms are used when
   ! appropriate.
   subroutine test_reuse_geom(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(mapl_GeomManager), target :: geom_manager
      type(ESMF_HConfig) :: hconfig
      integer :: status
      class(mapl_GeomSpec), allocatable :: spec
      type(mapl_MaplGeom), pointer :: mapl_geom_a, mapl_geom_b
      type(ESMF_Geom) :: geom_a, geom_b

      type(ESMF_Info) :: infoh
      logical :: flag

      hconfig = ESMF_HConfigCreate(content="{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC, nx: 1, ny: 1}", &
           rc=status)
      @assert_that(status, is(0))

      geom_manager = mapl_GeomManager()
      allocate(spec, source=geom_manager%make_geom_spec(hconfig, rc=status))
      @assert_that(status, is(0))

      mapl_geom_a => geom_manager%get_mapl_geom(spec, rc=status)
      @assert_that(status, is(0))
      mapl_geom_b => geom_manager%get_mapl_geom(spec, rc=status)
      @assert_that(status, is(0))

      geom_a = mapl_geom_a%get_geom()
      call ESMF_InfoGetFromHost(geom_a, infoh, rc=status)
      @assert_that(status, is(0))
      call ESMF_InfoSet(infoh, 'GeomManager was here', .true., rc=status)
      @assert_that(status, is(0))
      
      geom_b = mapl_geom_b%get_geom()
      call ESMF_InfoGetFromHost(geom_b, infoh, rc=status)
      @assert_that(status, is(0))
      flag = .false.
      call ESMF_InfoGet(infoh, 'GeomManager was here', flag, rc=status)
      @assert_that(status, is(0))

      @assertTrue(flag)
      
      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assert_that(status, is(0))
   end subroutine test_reuse_geom

   @test(type=ESMF_TestMethod, npes=[1])
   ! Test that an different specs result in distinct geoms.
   subroutine test_do_not_reuse_geom(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(mapl_GeomManager), target :: geom_manager
      type(ESMF_HConfig) :: hconfig
      integer :: status
      class(mapl_GeomSpec), allocatable :: spec
      type(mapl_MaplGeom), pointer :: mapl_geom_a, mapl_geom_b
      type(ESMF_Geom) :: geom_a, geom_b

      type(ESMF_Info) :: infoh
      logical :: is_present

      ! geom a
      hconfig = ESMF_HConfigCreate(content="{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC, nx: 1, ny: 1}", &
           rc=status)
      @assert_that(status, is(0))
      geom_manager = mapl_GeomManager()
      allocate(spec, source=geom_manager%make_geom_spec(hconfig, rc=status))
      @assert_that(status, is(0))
      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assert_that(status, is(0))
      mapl_geom_a => geom_manager%get_mapl_geom(spec, rc=status)
      @assert_that(status, is(0))
      geom_a = mapl_geom_a%get_geom()
      call ESMF_InfoGetFromHost(geom_a, infoh, rc=status)
      @assert_that(status, is(0))
      call ESMF_InfoSet(infoh, 'GeomManager was here', .true., rc=status)
      @assert_that(status, is(0))
      

      ! geom b
      hconfig = ESMF_HConfigCreate(content="{class: latlon, im_world: 10, jm_world: 13, pole: PC, dateline: DC, nx: 1, ny: 1}", &
           rc=status)
      @assert_that(status, is(0))
      deallocate(spec)
      allocate(spec, source=geom_manager%make_geom_spec(hconfig, rc=status))
      @assert_that(status, is(0))
      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assert_that(status, is(0))
      mapl_geom_b => geom_manager%get_mapl_geom(spec, rc=status)
      @assert_that(status, is(0))

      geom_b = mapl_geom_b%get_geom()
      call ESMF_InfoGetFromHost(geom_b, infoh, rc=status)
      @assert_that(status, is(0))
      ! New grid so should not have the key set on the other.
      is_present = ESMF_InfoIsPresent(infoh, 'GeomManager was here', rc=status)
      @assert_that(status, is(0))

      @assertFalse(is_present)
      
   end subroutine test_do_not_reuse_geom

   @test(type=ESMF_TestMethod, npes=[1])
   ! Two file-based LatLon grids whose coordinates differ only by a tiny
   ! perturbation. metadata_a is registered first (via get_mapl_geom);
   ! metadata_b is looked up second, acting as the new "candidate" not
   ! yet in the registry. Only the CANDIDATE's own "coordinate_tolerance"
   ! attribute (as ExtData would stamp it) matters, interpreted as a
   ! FRACTION of the candidate's own local grid spacing (DX) - here
   ! 1.e-3 * 10 deg spacing (36x18 grid) = 0.01 deg, comfortably
   ! covering the 1.e-4 deg perturbation - so the same MaplGeom is
   ! reused.
   subroutine test_reuse_geom_within_tolerance(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(mapl_GeomManager), target :: geom_manager
      type(FileMetadata) :: metadata_a, metadata_b
      integer :: status
      type(mapl_MaplGeom), pointer :: mapl_geom_a, mapl_geom_b
      type(ESMF_Geom) :: geom_a, geom_b

      type(ESMF_Info) :: infoh
      logical :: flag

      call create_latlon_file('test_gm_tol_a.nc', 36, 18, rc=status)
      @assert_that(status, is(0))
      call create_latlon_file('test_gm_tol_b.nc', 36, 18, rc=status, perturbation=1.0e-4_REAL64)
      @assert_that(status, is(0))

      metadata_a = read_latlon_metadata('test_gm_tol_a.nc', rc=status)
      @assert_that(status, is(0))
      metadata_b = read_latlon_metadata('test_gm_tol_b.nc', rc=status)
      @assert_that(status, is(0))
      call metadata_b%add_attribute('coordinate_tolerance', 1.0e-3_REAL64)

      geom_manager = mapl_GeomManager()

      mapl_geom_a => geom_manager%get_mapl_geom(metadata_a, rc=status)
      @assert_that(status, is(0))
      geom_a = mapl_geom_a%get_geom()
      call ESMF_InfoGetFromHost(geom_a, infoh, rc=status)
      @assert_that(status, is(0))
      call ESMF_InfoSet(infoh, 'GeomManager was here', .true., rc=status)
      @assert_that(status, is(0))

      mapl_geom_b => geom_manager%get_mapl_geom(metadata_b, rc=status)
      @assert_that(status, is(0))
      geom_b = mapl_geom_b%get_geom()
      call ESMF_InfoGetFromHost(geom_b, infoh, rc=status)
      @assert_that(status, is(0))
      flag = .false.
      call ESMF_InfoGet(infoh, 'GeomManager was here', flag, rc=status)
      @assert_that(status, is(0))

      @assertTrue(flag)

   end subroutine test_reuse_geom_within_tolerance

   @test(type=ESMF_TestMethod, npes=[1])
   ! Same setup, but the perturbation (1.e-1 deg) exceeds the
   ! candidate's tolerance*DX (1.e-3 * 10 deg = 0.01 deg) - must NOT
   ! reuse the geom.
   subroutine test_do_not_reuse_geom_outside_tolerance(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(mapl_GeomManager), target :: geom_manager
      type(FileMetadata) :: metadata_a, metadata_b
      integer :: status
      type(mapl_MaplGeom), pointer :: mapl_geom_a, mapl_geom_b
      type(ESMF_Geom) :: geom_a, geom_b

      type(ESMF_Info) :: infoh
      logical :: is_present

      call create_latlon_file('test_gm_notol_a.nc', 36, 18, rc=status)
      @assert_that(status, is(0))
      call create_latlon_file('test_gm_notol_b.nc', 36, 18, rc=status, perturbation=1.0e-1_REAL64)
      @assert_that(status, is(0))

      metadata_a = read_latlon_metadata('test_gm_notol_a.nc', rc=status)
      @assert_that(status, is(0))
      metadata_b = read_latlon_metadata('test_gm_notol_b.nc', rc=status)
      @assert_that(status, is(0))
      call metadata_b%add_attribute('coordinate_tolerance', 1.0e-3_REAL64)

      geom_manager = mapl_GeomManager()

      mapl_geom_a => geom_manager%get_mapl_geom(metadata_a, rc=status)
      @assert_that(status, is(0))
      geom_a = mapl_geom_a%get_geom()
      call ESMF_InfoGetFromHost(geom_a, infoh, rc=status)
      @assert_that(status, is(0))
      call ESMF_InfoSet(infoh, 'GeomManager was here', .true., rc=status)
      @assert_that(status, is(0))

      mapl_geom_b => geom_manager%get_mapl_geom(metadata_b, rc=status)
      @assert_that(status, is(0))
      geom_b = mapl_geom_b%get_geom()
      call ESMF_InfoGetFromHost(geom_b, infoh, rc=status)
      @assert_that(status, is(0))
      is_present = ESMF_InfoIsPresent(infoh, 'GeomManager was here', rc=status)
      @assert_that(status, is(0))

      @assertFalse(is_present)

   end subroutine test_do_not_reuse_geom_outside_tolerance

   @test(type=ESMF_TestMethod, npes=[6])
   ! Two lookups with the same cubed-sphere config must return the same
   ! MaplGeom; a config differing in size must return a different one.
   subroutine test_cs_same_config_same_geom(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(mapl_GeomManager), target :: geom_manager
      type(ESMF_HConfig) :: hconfig_a, hconfig_b
      integer :: status
      type(mapl_MaplGeom), pointer :: geom_a, geom_b, geom_c
      type(GeomId) :: id_a, id_b, id_c

      hconfig_a = ESMF_HConfigCreate( &
           content="{class: CubedSphere, im_world: 12, nx_face: 1, ny_face: 1}", rc=status)
      @assert_that(status, is(0))
      hconfig_b = ESMF_HConfigCreate( &
           content="{class: CubedSphere, im_world: 24, nx_face: 1, ny_face: 1}", rc=status)
      @assert_that(status, is(0))

      geom_manager = mapl_GeomManager()
      geom_a => geom_manager%get_mapl_geom(hconfig_a, rc=status)
      @assert_that(status, is(0))
      geom_b => geom_manager%get_mapl_geom(hconfig_a, rc=status)
      @assert_that(status, is(0))
      geom_c => geom_manager%get_mapl_geom(hconfig_b, rc=status)
      @assert_that(status, is(0))

      id_a = geom_a%get_id()
      id_b = geom_b%get_id()
      id_c = geom_c%get_id()
      @assertTrue(associated(geom_a, geom_b))
      @assertTrue(id_a == id_b)
      @assertFalse(associated(geom_a, geom_c))
      @assertTrue(id_a /= id_c)

      call ESMF_HConfigDestroy(hconfig_a, rc=status)
      @assert_that(status, is(0))
      call ESMF_HConfigDestroy(hconfig_b, rc=status)
      @assert_that(status, is(0))

   end subroutine test_cs_same_config_same_geom

   @test(type=ESMF_TestMethod, npes=[1])
   ! The map is keyed by geom id, not by position in the spec vector.
   ! Advancing the id counter first makes the first spec position (1)
   ! differ from its id (2).
   subroutine test_reuse_geom_id_differs_from_position(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(mapl_GeomManager), target :: geom_manager
      type(ESMF_HConfig) :: hconfig
      integer :: status
      class(mapl_GeomSpec), allocatable :: spec
      type(mapl_MaplGeom), pointer :: geom_a, geom_b
      type(GeomId) :: id_a, id_b, skipped_id
      integer :: value_a, value_skipped

      hconfig = ESMF_HConfigCreate(content="{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC, nx: 1, ny: 1}", &
           rc=status)
      @assert_that(status, is(0))

      geom_manager = mapl_GeomManager()
      skipped_id = geom_manager%id_manager%get_next_geom_id()
      allocate(spec, source=geom_manager%make_geom_spec(hconfig, rc=status))
      @assert_that(status, is(0))

      geom_a => geom_manager%get_mapl_geom(spec, rc=status)
      @assert_that(status, is(0))
      geom_b => geom_manager%get_mapl_geom(spec, rc=status)
      @assert_that(status, is(0))

      id_a = geom_a%get_id()
      id_b = geom_b%get_id()
      value_a = id_a%get_value()
      value_skipped = skipped_id%get_value()
      @assertEqual(value_skipped + 1, value_a)
      @assertTrue(id_a == id_b)
      @assertTrue(associated(geom_a, geom_b))

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assert_that(status, is(0))

   end subroutine test_reuse_geom_id_differs_from_position

end module Test_GeomManager
