#include "MAPL_TestErr.h"

module Test_FieldInfo
   use pfunit
   use mapl_FieldInfo_mod
   use mapl_FieldGet_mod, only: FieldGet
   use esmf
   implicit none(type,external)

contains

   @test
   subroutine test_copy_shared_field()
      type(ESMF_Field) :: f_in, f_out
      integer :: status
      integer :: ia, ib

      f_in = ESMF_FieldEmptyCreate(name='f_in', _RC)
      f_out= ESMF_FieldEmptyCreate(name='f_out', _RC)

      call FieldInfoSetShared(f_in, key='a', value=1, _RC)
      call FieldInfoSetShared(f_in, key='b', value=2, _RC)

      call FieldInfoCopyShared(f_in, f_out, _RC)

      call FieldInfoGetShared(f_out, key='a', value=ia, _RC)
      call FieldInfoGetShared(f_out, key='b', value=ib, _RC)

      @assert_that(ia, is(1))
      @assert_that(ib, is(2))

   end subroutine test_copy_shared_field

   @test
   subroutine test_bootstrapped()
      type(ESMF_Field) :: f
      type(ESMF_Info) :: info
      integer :: status
      logical :: bootstrapped

      f = ESMF_FieldEmptyCreate(name='f', _RC)

      call FieldGet(f, bootstrapped=bootstrapped, _RC)
      @assertFalse(bootstrapped)

      call ESMF_InfoGetFromHost(f, info, _RC)
      call FieldInfoSetInternal(info, bootstrapped=.true., _RC)
      call FieldGet(f, bootstrapped=bootstrapped, _RC)
      @assertTrue(bootstrapped)

      call ESMF_FieldDestroy(f, _RC)
   end subroutine test_bootstrapped

end module Test_FieldInfo
