#include "MAPL_TestErr.h"

module Test_FieldInfo
   use pfunit
   use mapl_FieldInfo_mod
   use mapl_FieldGet_mod, only: FieldGet
   use mapl_field_api, only: MAPL_FieldSet, MAPL_FieldGet, MAPL_NamedAlias
   use mapl_field_api, only: MAPL_RESTART_REQUIRED, MAPL_RESTART_SKIP
   use mapl_RestartModes_mod, only: RestartMode, operator(==)
   use mapl_StateItemFlag_mod
   use mapl_FieldPointerUtilities_mod, only: assign_fptr
   use mapl_FieldCreate_mod, only: FieldEmptyComplete
   use mapl_esmf_info_keys_mod, only: KEY_STATE_ITEM_VARIANT
   use esmf
   implicit none(type,external)

contains

   @test
   subroutine test_copy_shared_field()
      type(ESMF_Field) :: f_in, f_out
      integer :: status
      integer :: ia, ib

      f_in = ESMF_FieldEmptyCreate(name='f_in', _RC)
      f_out= ESMF_FieldEmptyCreate(name='f_out', _RC)

      call FieldInfoSetShared(f_in, key='a', value=1, _RC)
      call FieldInfoSetShared(f_in, key='b', value=2, _RC)

      call FieldInfoCopyShared(f_in, f_out, _RC)

      call FieldInfoGetShared(f_out, key='a', value=ia, _RC)
      call FieldInfoGetShared(f_out, key='b', value=ib, _RC)

      @assert_that(ia, is(1))
      @assert_that(ib, is(2))

   end subroutine test_copy_shared_field

   @test
   subroutine test_bootstrapped()
      type(ESMF_Field) :: f
      type(ESMF_Info) :: info
      integer :: status
      logical :: bootstrapped

      f = ESMF_FieldEmptyCreate(name='f', _RC)

      call FieldGet(f, bootstrapped=bootstrapped, _RC)
      @assertFalse(bootstrapped)

      call ESMF_InfoGetFromHost(f, info, _RC)
      call FieldInfoSetInternal(info, bootstrapped=.true., _RC)
      call FieldGet(f, bootstrapped=bootstrapped, _RC)
      @assertTrue(bootstrapped)

      call ESMF_FieldDestroy(f, _RC)
   end subroutine test_bootstrapped

   @test
   subroutine test_restart_mode_round_trip_on_alias()
      type(ESMF_Field) :: field, alias
      type(RestartMode) :: mode
      integer :: status

      field = ESMF_FieldEmptyCreate(name='f', _RC)
      alias = MAPL_NamedAlias(field, name='a', _RC)

      call MAPL_FieldGet(alias, restart_mode=mode, _RC)
      @assert_that(mode == MAPL_RESTART_REQUIRED, is(.true.))

      call MAPL_FieldSet(alias, restart_mode=MAPL_RESTART_SKIP, _RC)
      call MAPL_FieldGet(alias, restart_mode=mode, _RC)
      @assert_that(mode == MAPL_RESTART_SKIP, is(.true.))
   end subroutine test_restart_mode_round_trip_on_alias

   @test
   subroutine test_state_item_variant_round_trip_on_field()
      type(ESMF_Field) :: field
      type(MAPL_StateItem_Flag) :: variant
      integer :: status

      field = ESMF_FieldEmptyCreate(name='f', _RC)

      call MAPL_FieldGet(field, state_item_variant=variant, _RC)
      @assert_that(variant == MAPL_STATEITEM_INVALID, is(.true.))

      call MAPL_FieldSet(field, state_item_variant=MAPL_STATEITEM_GEOM, _RC)
      call MAPL_FieldGet(field, state_item_variant=variant, _RC)
      @assert_that(variant == MAPL_STATEITEM_GEOM, is(.true.))
   end subroutine test_state_item_variant_round_trip_on_field

   ! Info-only keywords must not reallocate a COMPLETE field.
   @test
   subroutine test_info_only_set_leaves_complete_field_untouched()
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: field
      type(ESMF_FieldStatus_Flag) :: field_status
      type(ESMF_TypeKind_Flag) :: typekind
      type(RestartMode) :: mode
      type(MAPL_StateItem_Flag) :: variant
      real(ESMF_KIND_R4), pointer :: before(:), after(:)
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[4, 4], _RC)
      geom = ESMF_GeomCreate(grid, _RC)
      field = ESMF_FieldEmptyCreate(_RC)
      call ESMF_FieldEmptySet(field, geom=geom, _RC)
      call FieldEmptyComplete(field, typekind=ESMF_TYPEKIND_R4, _RC)
      call assign_fptr(field, before, _RC)
      before = 7.

      call MAPL_FieldSet(field, restart_mode=MAPL_RESTART_SKIP, &
           state_item_variant=MAPL_STATEITEM_GEOM, _RC)

      call ESMF_FieldGet(field, status=field_status, typekind=typekind, _RC)
      @assert_that(field_status == ESMF_FIELDSTATUS_COMPLETE, is(.true.))
      @assert_that(typekind == ESMF_TYPEKIND_R4, is(.true.))
      call assign_fptr(field, after, _RC)
      @assert_that(associated(before, after), is(.true.))
      @assert_that(all(after == 7.), is(.true.))

      call MAPL_FieldGet(field, restart_mode=mode, state_item_variant=variant, _RC)
      @assert_that(mode == MAPL_RESTART_SKIP, is(.true.))
      @assert_that(variant == MAPL_STATEITEM_GEOM, is(.true.))

      call ESMF_FieldDestroy(field, _RC)
      call ESMF_GeomDestroy(geom, _RC)
      call ESMF_GridDestroy(grid, _RC)
   end subroutine test_info_only_set_leaves_complete_field_untouched

   @test
   subroutine test_unrecognized_state_item_variant_fails()
      type(ESMF_Field) :: field
      type(ESMF_Info) :: info
      type(MAPL_StateItem_Flag) :: variant
      integer :: status, rc

      field = ESMF_FieldEmptyCreate(name='f', _RC)
      call ESMF_InfoGetFromHost(field, info, _RC)
      call ESMF_InfoSet(info, key=KEY_STATE_ITEM_VARIANT, value='NOT_A_VARIANT', _RC)

      call MAPL_FieldGet(field, state_item_variant=variant, rc=rc)
      @assertExceptionRaised('unrecognized state item variant: NOT_A_VARIANT')
      @assertExceptionRaised('status=1')
      @assert_that(rc /= 0, is(.true.))
   end subroutine test_unrecognized_state_item_variant_fails

   ! Regression: FieldGet(field, geom=...) must not crash on a plain ESMF field
   ! whose MAPL Info keys were never populated.  An empty field returns an
   ! unallocated geom; a complete field returns its geom.
   @test
   subroutine test_field_get_geom_on_plain_empty_field()
      type(ESMF_Field) :: field
      type(ESMF_Geom), allocatable :: geom
      integer :: status

      field = ESMF_FieldEmptyCreate(name='f', _RC)
      call MAPL_FieldGet(field, geom=geom, _RC)
      @assert_that(allocated(geom), is(.false.))

      call ESMF_FieldDestroy(field, _RC)
   end subroutine test_field_get_geom_on_plain_empty_field

   @test
   subroutine test_field_get_geom_on_plain_complete_field()
      type(ESMF_Grid) :: grid
      type(ESMF_Field) :: field
      type(ESMF_Geom), allocatable :: geom
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[4, 4], _RC)
      field = ESMF_FieldCreate(grid=grid, typekind=ESMF_TYPEKIND_R4, _RC)
      call MAPL_FieldGet(field, geom=geom, _RC)
      @assert_that(allocated(geom), is(.true.))

      call ESMF_FieldDestroy(field, _RC)
      call ESMF_GridDestroy(grid, _RC)
   end subroutine test_field_get_geom_on_plain_complete_field

end module Test_FieldInfo
