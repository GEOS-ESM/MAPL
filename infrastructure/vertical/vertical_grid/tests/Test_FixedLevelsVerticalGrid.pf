module Test_FixedLevelsVerticalGrid
   use pfunit
   use mapl_FixedLevelsVerticalGrid_mod
   use mapl_VerticalGridSpec_mod, only: VerticalGridSpec
   use mapl_VerticalGrid_mod, only: VerticalGrid
   use mapl_VerticalStaggerLoc_mod, only: VERTICAL_STAGGER_CENTER, VERTICAL_STAGGER_EDGE
   use mapl_VerticalCoordinateDirection_mod
   use esmf, only: esmf_HConfig, ESMF_TYPEKIND_R4
   use esmf, only: esmf_HConfigCreate, esmf_HConfigDestroy
   implicit none

contains


   @test
   subroutine test_fixed_level_spec_initialization()
      type(FixedLevelsVerticalGridSpec) :: spec
      real, parameter :: test_levels(5) = [1000.0, 850.0, 700.0, 500.0, 300.0]
      real, allocatable :: retrieved_levels(:)
      
      ! Initialize spec components
      spec%levels = test_levels
      spec%physical_dimension = "pressure"
      spec%units = "hPa"
      
      @assert_that('Spec should have correct number of levels', size(spec%levels), is(5))
      @assertEqual("pressure", spec%physical_dimension, 'Physical dimension should match')
      @assertEqual("hPa", spec%units, 'Units should match')
      
      retrieved_levels = spec%levels
      @assert_that('Retrieved levels should match', size(retrieved_levels), is(5))
      @assert_that('First level should match', retrieved_levels(1), is(1000.0))
      @assert_that('Last level should match', retrieved_levels(5), is(300.0))
   end subroutine test_fixed_level_spec_initialization


   @test
   subroutine test_fixed_level_grid_initialization()
      type(FixedLevelsVerticalGridSpec) :: spec
      type(FixedLevelsVerticalGrid) :: grid
      real, parameter :: test_levels(3) = [1000.0, 500.0, 100.0]
      
      ! Initialize spec
      spec%levels = test_levels
      spec%physical_dimension = "pressure"
      spec%units = "Pa"
      
      call grid%initialize(spec)
      @assert_that('Grid should have correct number of levels', grid%get_num_layers(), is(3))
      @assertEqual("pressure", grid%get_physical_dimension(), 'Physical dimension should match')
      @assertEqual("Pa", grid%get_units('pressure'), 'Units should match')
   end subroutine test_fixed_level_grid_initialization


   @test
   subroutine test_fixed_level_coordinate_direction_default()
      type(FixedLevelsVerticalGridSpec) :: spec
      type(FixedLevelsVerticalGrid) :: grid
      real, parameter :: test_levels(3) = [1000.0, 500.0, 100.0]
      type(VerticalCoordinateDirection) :: direction
      
      spec%levels = test_levels
      spec%physical_dimension = "pressure"
      spec%units = "Pa"
      
      call grid%initialize(spec)
      direction = grid%get_coordinate_direction()
      @assertEqual("upward", direction%to_string(), 'Decreasing levels should be upward')
   end subroutine test_fixed_level_coordinate_direction_default


   @test
   subroutine test_fixed_level_coordinate_direction_increasing()
      type(FixedLevelsVerticalGridSpec) :: spec
      type(FixedLevelsVerticalGrid) :: grid
      type(VerticalCoordinateDirection) :: direction

      spec%levels = [100.0, 500.0, 1000.0]
      spec%physical_dimension = "pressure"
      spec%units = "Pa"

      call grid%initialize(spec)
      direction = grid%get_coordinate_direction()
      @assertEqual("downward", direction%to_string(), 'Increasing levels should be downward')
   end subroutine test_fixed_level_coordinate_direction_increasing


   @test
   subroutine test_fixed_level_non_monotonic_fails()
      type(FixedLevelsVerticalGridSpec) :: spec
      type(FixedLevelsVerticalGrid) :: grid
      integer :: rc

      spec%levels = [100.0, 1000.0, 500.0]
      spec%physical_dimension = "pressure"
      spec%units = "Pa"

      call grid%initialize(spec, rc=rc)
      @assertExceptionRaised('levels must be strictly monotonic (all increasing or all decreasing)')
      @assertTrue(rc /= 0, 'Non-monotonic levels should fail')
   end subroutine test_fixed_level_non_monotonic_fails


   ! Direction of a grid built from a dimension name and levels; dimension
   ! is left unset when the name is empty.
   function direction_of(dimension, levels, status) result(direction_name)
      character(*), intent(in) :: dimension
      real, intent(in) :: levels(:)
      integer, intent(out) :: status
      character(:), allocatable :: direction_name

      type(FixedLevelsVerticalGridSpec) :: spec
      type(FixedLevelsVerticalGrid) :: grid
      type(VerticalCoordinateDirection) :: direction

      spec%levels = levels
      if (len(dimension) > 0) spec%physical_dimension = dimension
      spec%units = "m"
      call grid%initialize(spec, rc=status)
      direction = grid%get_coordinate_direction()
      direction_name = direction%to_string()
   end function direction_of


   ! height increases going up, so increasing levels are upward
   @test
   subroutine test_height_increasing_is_up()
      integer :: status
      character(:), allocatable :: name

      name = direction_of('height', [0.0, 100.0, 500.0], status)
      @assertEqual(0, status)
      @assertEqual("upward", name)
   end subroutine test_height_increasing_is_up


   @test
   subroutine test_height_decreasing_is_down()
      integer :: status
      character(:), allocatable :: name

      name = direction_of('height', [500.0, 100.0, 0.0], status)
      @assertEqual(0, status)
      @assertEqual("downward", name)
   end subroutine test_height_decreasing_is_down


   @test
   subroutine test_altitude_increasing_is_up()
      integer :: status
      character(:), allocatable :: name

      name = direction_of('altitude', [0.0, 100.0, 500.0], status)
      @assertEqual(0, status)
      @assertEqual("upward", name)
   end subroutine test_altitude_increasing_is_up


   @test
   subroutine test_altitude_decreasing_is_down()
      integer :: status
      character(:), allocatable :: name

      name = direction_of('altitude', [500.0, 100.0, 0.0], status)
      @assertEqual(0, status)
      @assertEqual("downward", name)
   end subroutine test_altitude_decreasing_is_down


   ! depth increases going down
   @test
   subroutine test_depth_increasing_is_down()
      integer :: status
      character(:), allocatable :: name

      name = direction_of('depth', [0.0, 10.0, 100.0], status)
      @assertEqual(0, status)
      @assertEqual("downward", name)
   end subroutine test_depth_increasing_is_down


   @test
   subroutine test_depth_decreasing_is_up()
      integer :: status
      character(:), allocatable :: name

      name = direction_of('depth', [100.0, 10.0, 0.0], status)
      @assertEqual(0, status)
      @assertEqual("upward", name)
   end subroutine test_depth_decreasing_is_up


   @test
   subroutine test_pressure_numbers_rule_both_ways()
      integer :: status1, status2
      character(:), allocatable :: inc, dec

      inc = direction_of('pressure', [100.0, 500.0, 1000.0], status1)
      dec = direction_of('pressure', [1000.0, 500.0, 100.0], status2)
      @assertEqual(0, status1)
      @assertEqual(0, status2)
      @assertEqual("downward", inc)
      @assertEqual("upward", dec)
   end subroutine test_pressure_numbers_rule_both_ways


   ! layer and any other name keep the numbers rule
   @test
   subroutine test_layer_keeps_numbers_rule()
      integer :: status1, status2
      character(:), allocatable :: inc, dec

      inc = direction_of('layer', [1.0, 2.0, 3.0], status1)
      dec = direction_of('layer', [3.0, 2.0, 1.0], status2)
      @assertEqual(0, status1)
      @assertEqual(0, status2)
      @assertEqual("downward", inc)
      @assertEqual("upward", dec)
   end subroutine test_layer_keeps_numbers_rule


   @test
   subroutine test_unknown_name_keeps_numbers_rule()
      integer :: status1, status2
      character(:), allocatable :: inc, dec

      inc = direction_of('air_pressure', [100.0, 500.0, 1000.0], status1)
      dec = direction_of('air_pressure', [1000.0, 500.0, 100.0], status2)
      @assertEqual(0, status1)
      @assertEqual(0, status2)
      @assertEqual("downward", inc)
      @assertEqual("upward", dec)
   end subroutine test_unknown_name_keeps_numbers_rule


   ! Matching is exact and case-sensitive, as get_default_units
   @test
   subroutine test_dimension_match_is_case_sensitive()
      integer :: status
      character(:), allocatable :: name

      name = direction_of('Height', [0.0, 100.0, 500.0], status)
      @assertEqual(0, status)
      @assertEqual("downward", name)
   end subroutine test_dimension_match_is_case_sensitive


   ! An unset dimension must not be read
   @test
   subroutine test_unset_dimension_keeps_numbers_rule()
      integer :: status1, status2
      character(:), allocatable :: inc, dec

      inc = direction_of('', [0.0, 100.0, 500.0], status1)
      dec = direction_of('', [500.0, 100.0, 0.0], status2)
      @assertEqual(0, status1)
      @assertEqual(0, status2)
      @assertEqual("downward", inc)
      @assertEqual("upward", dec)
   end subroutine test_unset_dimension_keeps_numbers_rule


   @test
   subroutine test_height_non_monotonic_fails()
      type(FixedLevelsVerticalGridSpec) :: spec
      type(FixedLevelsVerticalGrid) :: grid
      integer :: rc

      spec%levels = [1.0, 3.0, 2.0]
      spec%physical_dimension = "height"
      spec%units = "m"

      call grid%initialize(spec, rc=rc)
      @assertExceptionRaised('levels must be strictly monotonic (all increasing or all decreasing)')
      @assertTrue(rc /= 0, 'Non-monotonic height levels should fail')
   end subroutine test_height_non_monotonic_fails


   ! The factory path: config text to spec to grid
   @test
   subroutine test_factory_height_config_gives_up_grid()
      type(FixedLevelsVerticalGridFactory), target :: factory
      type(esmf_HConfig) :: config
      class(VerticalGridSpec), allocatable :: spec
      class(VerticalGrid), allocatable :: grid
      type(VerticalCoordinateDirection) :: direction
      integer :: rc_spec, rc_grid

      config = esmf_HConfigCreate(content='{levels: [0.0, 100.0, 500.0], physical_dimension: height}')
      spec = factory%create_spec_from_config(config, rc_spec)
      grid = factory%create_grid_from_spec(spec, rc_grid)
      direction = grid%get_coordinate_direction()
      call esmf_HConfigDestroy(config)

      @assertEqual(0, rc_spec)
      @assertEqual(0, rc_grid)
      @assertEqual("upward", direction%to_string())
   end subroutine test_factory_height_config_gives_up_grid


   @test
   subroutine test_single_level_is_unspecified()
      integer :: status1, status2
      character(:), allocatable :: height, pressure

      height = direction_of('height', [100.0], status1)
      pressure = direction_of('pressure', [100.0], status2)
      @assertEqual(0, status1)
      @assertEqual(0, status2)
      @assertEqual("unspecified", height)
      @assertEqual("unspecified", pressure)
   end subroutine test_single_level_is_unspecified


   @test
   subroutine test_create_spec_height_non_monotonic_fails()
      type(FixedLevelsVerticalGridFactory), target :: factory
      type(esmf_HConfig) :: config
      class(VerticalGridSpec), allocatable :: spec
      integer :: rc

      config = esmf_HConfigCreate(content='{levels: [1.0, 3.0, 2.0], physical_dimension: height}')
      spec = factory%create_spec_from_config(config, rc)
      @assertExceptionRaised('levels must be strictly monotonic (all increasing or all decreasing)')
      @assertTrue(rc /= 0, 'Non-monotonic height list should fail')
      call esmf_HConfigDestroy(config)
   end subroutine test_create_spec_height_non_monotonic_fails


   @test
   subroutine test_fixed_level_coordinate_direction_get_set()
      type(FixedLevelsVerticalGridSpec) :: spec
      type(FixedLevelsVerticalGrid) :: grid
      real, parameter :: test_levels(3) = [1000.0, 500.0, 100.0]
      type(VerticalCoordinateDirection) :: direction
      
      spec%levels = test_levels
      spec%physical_dimension = "pressure"
      spec%units = "Pa"
      
      call grid%initialize(spec)
      
      call grid%set_coordinate_direction(VCOORD_DIRECTION_UP)
      direction = grid%get_coordinate_direction()
      @assertEqual("upward", direction%to_string(), 'Should be able to set to upward')
      
      call grid%set_coordinate_direction(VCOORD_DIRECTION_DOWN)
      direction = grid%get_coordinate_direction()
      @assertEqual("downward", direction%to_string(), 'Should be able to set to downward')
   end subroutine test_fixed_level_coordinate_direction_get_set


   @test
   subroutine test_fixed_level_factory_get_name()
      type(FixedLevelsVerticalGridFactory), target :: factory
      character(len=:), allocatable :: name
      
      name = factory%get_name()
      @assertEqual("FixedLevelsVerticalGrid", name, 'Factory should return correct name')
   end subroutine test_fixed_level_factory_get_name


   @test
   subroutine test_fixed_level_factory_supports_config()
      type(FixedLevelsVerticalGridFactory), target :: factory
      type(esmf_HConfig) :: config
      logical :: supported
      real, parameter :: levels(3) = [1000.0, 500.0, 100.0]
      
      ! Create config with required parameters
      config = esmf_HConfigCreate(content='{levels: [1000.0, 500.0, 100.0], physical_dimension: pressure}')
      
      supported = factory%supports_config(config)
      @assert_that('Should support config with levels and physical_dimension', supported, is(.true.))

      call esmf_HConfigDestroy(config)
   end subroutine test_fixed_level_factory_supports_config


   @test
   subroutine test_fixed_level_factory_supports_config_explicit_type()
      type(FixedLevelsVerticalGridFactory), target :: factory
      type(esmf_HConfig) :: config
      logical :: supported
      
      ! Create config with explicit grid type
      config = esmf_HConfigCreate(content='{grid_type: fixed_levels, levels: [1.,2.], physical_dimension: height}')
      
      supported = factory%supports_config(config)
      @assert_that('Should support explicit fixed_level grid type', supported, is(.true.))
      call esmf_HConfigDestroy(config)
   end subroutine test_fixed_level_factory_supports_config_explicit_type


   @test
   subroutine test_fixed_level_factory_unsupported_config()
      type(FixedLevelsVerticalGridFactory), target :: factory
      type(esmf_HConfig) :: config
      logical :: supported
      
      ! Create config without required parameters
      config = esmf_HConfigCreate(content='{grid_type: other, physical_dimension: pressure, levels: [1.,2.]}')
      ! Missing levels array
      
      supported = factory%supports_config(config)
      @assert_that('Should not support config without levels', supported, is(.false.))
      call esmf_HConfigDestroy(config)
   end subroutine test_fixed_level_factory_unsupported_config


   @test
   subroutine test_default_units_pressure()
      character(len=:), allocatable :: units
      
      units = get_default_units("pressure")
      @assertEqual("Pa", units, 'Default units for pressure should be Pa')
   end subroutine test_default_units_pressure


   @test
   subroutine test_default_units_height()
      character(len=:), allocatable :: units
      
      units = get_default_units("height")
      @assertEqual("m", units, 'Default units for height should be m')
   end subroutine test_default_units_height


   @test
   subroutine test_default_units_unknown()
      character(len=:), allocatable :: units
      
      units = get_default_units("unknown_dimension")
      @assertEqual("<unknown>", units, 'Default units for unknown dimension should be dimensionless')
   end subroutine test_default_units_unknown


   @test
   subroutine test_fixed_level_factory_create_spec_with_default_units()
      type(FixedLevelsVerticalGridFactory), target :: factory
      type(esmf_HConfig) :: config
      class(VerticalGridSpec), allocatable :: spec
      real, parameter :: levels(3) = [1000.0, 500.0, 100.0]
      integer :: rc
      
      ! Create config without units (should use defaults)
      config = esmf_HConfigCreate(content='{levels: [1000.0, 500.0, 100.0], physical_dimension: pressure}')
      
      spec = factory%create_spec_from_config(config, rc)
      @assert_that('Create spec should succeed', rc, is(0))
      
      select type (spec)
      type is (FixedLevelsVerticalGridSpec)
         @assertEqual("Pa", spec%units, 'Should use default units for pressure')
      class default
         @assertFail('Spec should be FixedLevelsVerticalGridSpec type')
      end select

      call esmf_HConfigDestroy(config)
   end subroutine test_fixed_level_factory_create_spec_with_default_units


   @test
   subroutine test_fixed_level_factory_create_spec_with_explicit_units()
      type(FixedLevelsVerticalGridFactory), target :: factory
      type(esmf_HConfig) :: config
      class(VerticalGridSpec), allocatable :: spec
      real, parameter :: levels(3) = [1000.0, 500.0, 100.0]
      integer :: rc
      
      ! Create config with explicit units
      
      config = esmf_HConfigCreate(content='{levels: [1000.0, 500.0, 100.0], physical_dimension: pressure, units: hPa}')
      spec = factory%create_spec_from_config(config, rc)
      @assert_that('Create spec should succeed', rc, is(0))
      
      select type (spec)
      type is (FixedLevelsVerticalGridSpec)
         @assertEqual("hPa", spec%units, 'Should use explicit units')
         @assertEqual("pressure", spec%physical_dimension, 'Physical dimension should match')
         @assert_that('Should have correct number of levels', size(spec%levels), is(3))
      class default
         @assertFail('Spec should be FixedLevelsVerticalGridSpec type')
      end select
      call esmf_HConfigDestroy(config)

   end subroutine test_fixed_level_factory_create_spec_with_explicit_units
   
   @test
   ! The result of get_units is allocatable, so the caller copies it even
   ! when the physical dimension is wrong.  It must be allocated there.
   subroutine test_get_units_allocates_result_on_error()
      type(FixedLevelsVerticalGridSpec) :: spec
      type(FixedLevelsVerticalGrid) :: grid
      real, parameter :: test_levels(3) = [1000.0, 500.0, 100.0]
      character(:), allocatable :: units
      integer :: status

      spec%levels = test_levels
      spec%physical_dimension = "pressure"
      spec%units = "Pa"
      call grid%initialize(spec)

      units = grid%get_units('bogus', rc=status)
      @assertExceptionRaised('Unsupported physical dimension: bogus')
      @assertTrue(status /= 0, 'An unsupported dimension must give a nonzero rc')
      @assertTrue(allocated(units), 'The result must be allocated on the error path')
   end subroutine test_get_units_allocates_result_on_error

end module Test_FixedLevelsVerticalGrid

