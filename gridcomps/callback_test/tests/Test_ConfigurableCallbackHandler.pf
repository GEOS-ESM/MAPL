      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  bias: {constant: 1.0}' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler toy_handler: ' // &
           'supply argument bias is not out or inout in any method')
      ! Drop the _RC propagation of the error through the caller.
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, &
           'supply on bias (in-only in every method) must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_supply_on_in_only_argument_fails

   ! mixed_quantity is "out" (not in/inout) in method "get", so
   ! record: {get: [mixed_quantity]} is illegal, even though the same
   ! argument is legally recordable under "put".
   @test
   subroutine test_record_on_out_only_argument_in_that_method_fails()
      character(*), parameter :: FILENAME = 'record_on_out_only_argument_fails.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_mixing' // NL // &
           geometry_yaml(num_levels=3) // &
           'supply:' // NL // &
           '  mixed_quantity: {constant: 1.0}' // NL // &
           'record:' // NL // &
           '  get: [mixed_quantity]' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'mixing_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler mixing_handler: record: method get: ' // &
           'argument mixed_quantity is out-only in this method')
      ! Drop the _RC propagation of the error through the caller.
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, &
           'record: get: [mixed_quantity] is illegal because mixed_quantity is out-only in get')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_record_on_out_only_argument_in_that_method_fails

