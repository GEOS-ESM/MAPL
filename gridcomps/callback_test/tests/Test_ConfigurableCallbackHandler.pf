      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  quantity: {constant: 1.0}' // NL // &
           'member_attributes:' // NL // &
           '  quantity:' // NL // &
           '    operation: scale' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler toy_handler: member_attributes names ' // &
           'operation, which is a state-scoped attribute; put it under state_attributes')
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, 'a state-scoped attribute under member_attributes must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_member_attributes_rejects_state_scoped_attribute

