   !-----------------------------------------------------------------
   ! attribute placement (state_attributes vs member_attributes, and
   ! member_attributes against the attribute's own declared host)
   !-----------------------------------------------------------------

   ! mix_like is declared scope: member (hosted on mixed_quantity); it
   ! must be rejected under state_attributes.
   @test
   subroutine test_state_attributes_rejects_member_scoped_attribute()
      character(*), parameter :: FILENAME = 'state_attributes_rejects_member_scoped.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_mixing' // NL // &
           geometry_yaml(num_levels=3) // &
           'supply:' // NL // &
           '  mixed_quantity: {constant: 1.0}' // NL // &
           'state_attributes:' // NL // &
           '  mix_like: heat' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'mixing_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler mixing_handler: state_attributes names ' // &
           'mix_like, which is a member-scoped attribute; put it under member_attributes')
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, 'a member-scoped attribute under state_attributes must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_state_attributes_rejects_member_scoped_attribute

   ! operation is declared scope: state; it must be rejected under
   ! member_attributes even when the named member (quantity) is real.
   @test
   subroutine test_member_attributes_rejects_state_scoped_attribute()
      character(*), parameter :: FILENAME = 'member_attributes_rejects_state_scoped.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
