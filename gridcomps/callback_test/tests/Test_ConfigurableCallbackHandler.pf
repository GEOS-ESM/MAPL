      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  quantity: {function: level}' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler toy_handler: argument quantity: ' // &
           'supply function "level" failed to evaluate')
      ! Drop the parser's own diagnostic and the _RC propagation through the callers.
      do while (catch('Invalid element: level'))
      end do
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, 'function: level on an xy argument must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_supply_function_unknown_variable_fails

   ! bias is "in" (not out/inout) in every method of mock_toy, so it is
   ! not legally configurable under supply.
   @test
   subroutine test_supply_on_in_only_argument_fails()
      character(*), parameter :: FILENAME = 'supply_on_in_only_argument_fails.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
