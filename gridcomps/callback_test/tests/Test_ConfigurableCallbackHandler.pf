      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'mixing_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler mixing_handler: non_negative argument ' // &
           'mixed_quantity: only fill is a legal key')
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, 'a non_negative entry with an extra sub-key must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_non_negative_rejects_extra_subkey

   ! quantity is xy (horizontal-only); column fill is meaningless there.
   @test
   subroutine test_non_negative_rejects_non_xyz_argument()
      character(*), parameter :: FILENAME = 'non_negative_rejects_non_xyz_argument.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  quantity: {constant: 1.0}' // NL // &
           'non_negative:' // NL // &
           '  quantity: {fill: column}' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler toy_handler: non_negative argument ' // &
           'quantity: column fill needs dims xyz')
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, 'non_negative on an xy argument must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_non_negative_rejects_non_xyz_argument

   !-----------------------------------------------------------------
   ! record: unknown names
   !-----------------------------------------------------------------

   @test
   subroutine test_record_unknown_argument_fails()
      character(*), parameter :: FILENAME = 'record_unknown_argument_fails.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_mixing' // NL // &
           geometry_yaml(num_levels=3) // &
           'supply:' // NL // &
           '  mixed_quantity: {constant: 1.0}' // NL // &
           'record:' // NL // &
           '  put: [bogus_arg]' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'mixing_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler mixing_handler: record: method put: ' // &
           'unknown argument bogus_arg')
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, 'record naming an unknown argument must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_record_unknown_argument_fails

   @test
   subroutine test_record_unknown_method_fails()
      character(*), parameter :: FILENAME = 'record_unknown_method_fails.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  quantity: {constant: 1.0}' // NL // &
           'record:' // NL // &
           '  bogus_method: [quantity]' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler toy_handler: record names unknown ' // &
           'method bogus_method')
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, 'record naming an unknown method must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_record_unknown_method_fails

end module Test_ConfigurableCallbackHandler
