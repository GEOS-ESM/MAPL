! Tests for mapl_ConfigurableCallbackHandler_mod: building a callback
! State from a Handler's own YAML section and checking it with
! check_callback_state_conformance - no Invoker, no graph STATE-item
! population, just the same hand-built-State style
! Test_CallbackStateConformance.pf uses, driven by YAML instead of
! Fortran calls. Interfaces are registered the same way
! Test_CallbackRegistrationLoader.pf does: write a real
! callback_interfaces.yaml-style file at runtime, then
! load_callback_registration_file it.
module Test_ConfigurableCallbackHandler
   use mapl_ConfigurableCallbackHandler_mod, only: build_configurable_handler
   use mapl_CallbackRegistrationLoader_mod, only: load_callback_registration_file
   use mapl_CallbackInterfaceRegistry_mod, only: get_callback_interface_by_name
   use mapl_CallbackInterfaceRegistry_mod, only: reset_callback_registry_for_testing
   use mapl_CallbackInterface_mod, only: CallbackInterface
   use mapl_CallbackStateConformance_mod, only: check_callback_state_conformance
   use mapl_CallbackContractViolation_mod, only: CallbackContractViolation
   use mapl_StateItemDescriptor_mod, only: StateItemDescriptor
   use mapl_StateItemCharacteristicKind_mod, only: NON_NEGATIVE_CHARACTERISTIC_KIND
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristic
   use mapl_NonNegativeCharacteristic_mod, only: NonNegativeCharacteristic
   use ESMF, only: ESMF_HConfig, ESMF_HConfigCreate, ESMF_HConfigDestroy
   use ESMF, only: ESMF_State, ESMF_StateGet, ESMF_Field, ESMF_FieldGet
   use ESMF, only: ESMF_MAXSTR, ESMF_KIND_R8
   use funit
   implicit none

   character(*), parameter :: NL = new_line('a')
   real(kind=ESMF_KIND_R8), parameter :: TOL = 1.0e-12_ESMF_KIND_R8

   ! A small callback_interfaces.yaml with two interfaces:
   !  - mock_toy: a 2-D argument (quantity, out in "get") plus a
   !    second, in-only argument (bias, in in "get") so supply's
   !    out/inout restriction has something illegal to reject. tag is a
   !    member-scoped attribute hosted on quantity, so a misplaced
   !    member_attributes entry (wrong host, or under state_attributes)
   !    has something to be misplaced onto.
   !  - mock_mixing: a 3-D argument (mixed_quantity), out in "get" and
   !    in in "put" (the PassiveTracer-style shared-argument pattern),
   !    so record has a legal (put) and an illegal (get) method to name.
   character(*), parameter :: INTERFACES_YAML = &
        'mock_toy:' // NL // &
        '  version: 1' // NL // &
        '  summary: mock toy interface for the Configurable Handler tests' // NL // &
        '  arguments:' // NL // &
        '    quantity:' // NL // &
        '      kind: field' // NL // &
        '      dims: xy' // NL // &
        '    bias:' // NL // &
        '      kind: field' // NL // &
        '      dims: xy' // NL // &
        '  methods:' // NL // &
        '    get:' // NL // &
        '      quantity: out' // NL // &
        '      bias: in' // NL // &
        '  attributes:' // NL // &
        '    operation:' // NL // &
        '      type: string' // NL // &
        '      scope: state' // NL // &
        '      required: true' // NL // &
        '      allowed: [scale, offset]' // NL // &
        '    factor:' // NL // &
        '      type: real' // NL // &
        '      scope: state' // NL // &
        '      default: 2.0' // NL // &
        '    tag:' // NL // &
        '      type: string' // NL // &
        '      scope: member' // NL // &
        '      host_argument: quantity' // NL // &
        'mock_mixing:' // NL // &
        '  version: 1' // NL // &
        '  summary: mock mixing interface for the Configurable Handler tests' // NL // &
        '  arguments:' // NL // &
        '    mixed_quantity:' // NL // &
        '      kind: field' // NL // &
        '      dims: xyz' // NL // &
        '  methods:' // NL // &
        '    get:' // NL // &
        '      mixed_quantity: out' // NL // &
        '    put:' // NL // &
        '      mixed_quantity: in' // NL // &
        '  attributes:' // NL // &
        '    mix_like:' // NL // &
        '      type: string' // NL // &
        '      scope: member' // NL // &
        '      host_argument: mixed_quantity' // NL // &
        '      required: true' // NL // &
        '      allowed: [heat, moisture]' // NL

contains

   subroutine write_file(filename, content)
      character(*), intent(in) :: filename
      character(*), intent(in) :: content

      integer :: unit

      open(newunit=unit, file=filename, form='formatted', status='replace')
      write(unit, '(a)') content
      close(unit)
   end subroutine write_file

   subroutine delete_file(filename)
      character(*), intent(in) :: filename

      integer :: unit

      open(newunit=unit, file=filename, form='formatted', status='old')
      close(unit, status='delete')
   end subroutine delete_file

   ! Registers mock_toy and mock_mixing from INTERFACES_YAML into a
   ! freshly reset registry.
   subroutine load_mock_interfaces(filename)
      character(*), intent(in) :: filename

      logical :: found
      integer :: status

      call reset_callback_registry_for_testing()
      call write_file(filename, INTERFACES_YAML)
      call load_callback_registration_file(filename, found, rc=status)
      @assertEqual(0, status, 'load_callback_registration_file failed')
      @assertTrue(found, trim(filename) // ' must be found')
      call delete_file(filename)
   end subroutine load_mock_interfaces

   ! geometry: a tiny global lat-lon grid, the same shape
   ! StateItemTestSupport_mod's make_latlon_geom builds, under the
   ! same esmf_geom/vertical_grid keys the generic layer's own
   ! `geometry:` section uses.
   function geometry_yaml(num_levels) result(text)
      integer, optional, intent(in) :: num_levels
      character(:), allocatable :: text
      character(32) :: level_text

      text = 'geometry:' // NL // &
           '  esmf_geom: {class: latlon, im_world: 4, jm_world: 3, pole: PC, ' // &
           'dateline: DC, nx: 1, ny: 1}' // NL
      if (present(num_levels)) then
         write(level_text, '(i0)') num_levels
         text = text // '  vertical_grid: {num_levels: ' // trim(level_text) // '}' // NL
      end if
   end function geometry_yaml

   ! Whether any of violations carries a code with this prefix (a
   ! category check, not an exact-text check - message wording is the
   ! conformance checker's own concern, tested there).
   logical function has_violation_code(violations, prefix) result(found)
      type(CallbackContractViolation), intent(in) :: violations(:)
      character(*), intent(in) :: prefix

      integer :: i

      found = .false.
      do i = 1, size(violations)
         if (index(violations(i)%get_code(), prefix) == 1) then
            found = .true.
            return
         end if
      end do
   end function has_violation_code

   !-----------------------------------------------------------------
   ! happy paths
   !-----------------------------------------------------------------

   @test
   subroutine test_mock_toy_builds_a_conforming_state()
      character(*), parameter :: FILENAME = 'mock_toy_builds_a_conforming_state.yaml'
      type(ESMF_HConfig) :: hconfig
      type(CallbackInterface) :: iface
      type(ESMF_State) :: cb_state, mock_state
      type(ESMF_Field) :: field
      real(kind=ESMF_KIND_R8), pointer :: ptr2d(:,:)
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      type(CallbackContractViolation), allocatable :: violations(:)
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  quantity: {constant: 1.0}' // NL // &
           'state_attributes:' // NL // &
           '  operation: scale' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertEqual(0, status, 'build_configurable_handler failed')
      @assertEqual('mock_toy', interface_name)
      @assertEqual(0, size(non_negative_names), 'no non_negative section was configured')

      ! quantity (configured under supply) must hold the constant
      ! value; bias (not configured) must still exist as a real member.
      call ESMF_StateGet(cb_state, itemName='quantity', field=field, rc=status)
      @assertEqual(0, status)
      call ESMF_FieldGet(field, farrayPtr=ptr2d, rc=status)
      @assertEqual(0, status)
      @assertEqual(1.0_ESMF_KIND_R8, ptr2d, tolerance=TOL, message='quantity must be the configured constant')

      call ESMF_StateGet(cb_state, itemName='bias', field=field, rc=status)
      @assertEqual(0, status, 'bias must be a real member even though it is not under supply')

      iface = get_callback_interface_by_name(interface_name, rc=status)
      @assertEqual(0, status)
      call check_callback_state_conformance(cb_state, iface, interface_name, &
           'toy_handler', violations, rc=status)
      @assertEqual(0, status, 'check_callback_state_conformance failed')
      @assertEqual(0, size(violations), 'a correctly configured mock_toy must have no violations')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_mock_toy_builds_a_conforming_state

   ! A richer happy path: mock_mixing's xyz mixed_quantity supplied by
   ! profile (one value per level), member_attributes setting mix_like
   ! on it, and record naming put/mixed_quantity (legal: mixed_quantity
   ! is "in" in "put") - a placeholder export field in mock_state, not
   ! a value, since recording an actual value needs a real Invoker to
   ! drive the callback.
   @test
   subroutine test_mock_mixing_profile_supply_and_record()
      character(*), parameter :: FILENAME = 'mock_mixing_profile_supply_and_record.yaml'
      type(ESMF_HConfig) :: hconfig
      type(CallbackInterface) :: iface
      type(ESMF_State) :: cb_state, mock_state
      type(ESMF_Field) :: field
      real(kind=ESMF_KIND_R8), pointer :: ptr3d(:,:,:)
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      type(CallbackContractViolation), allocatable :: violations(:)
      integer :: item_count, status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_mixing' // NL // &
           geometry_yaml(num_levels=3) // &
           'supply:' // NL // &
           '  mixed_quantity: {profile: [1.0e-6, 2.0e-6, 3.0e-6]}' // NL // &
           'member_attributes:' // NL // &
           '  mixed_quantity:' // NL // &
           '    mix_like: heat' // NL // &
           'record:' // NL // &
           '  put: [mixed_quantity]' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'mixing_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertEqual(0, status, 'build_configurable_handler failed')
      @assertEqual('mock_mixing', interface_name)

      call ESMF_StateGet(cb_state, itemName='mixed_quantity', field=field, rc=status)
      @assertEqual(0, status)
      call ESMF_FieldGet(field, farrayPtr=ptr3d, rc=status)
      @assertEqual(0, status)
      @assertEqual(1.0e-6_ESMF_KIND_R8, ptr3d(:,:,1), tolerance=TOL, message='level 1 of the profile')
      @assertEqual(2.0e-6_ESMF_KIND_R8, ptr3d(:,:,2), tolerance=TOL, message='level 2 of the profile')
      @assertEqual(3.0e-6_ESMF_KIND_R8, ptr3d(:,:,3), tolerance=TOL, message='level 3 of the profile')

      iface = get_callback_interface_by_name(interface_name, rc=status)
      @assertEqual(0, status)
      call check_callback_state_conformance(cb_state, iface, interface_name, &
           'mixing_handler', violations, rc=status)
      @assertEqual(0, status, 'check_callback_state_conformance failed')
      @assertEqual(0, size(violations), 'a correctly configured mock_mixing must have no violations')

      ! The record placeholder landed in mock_state, not cb_state.
      call ESMF_StateGet(mock_state, itemCount=item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, item_count, 'mock_state must hold exactly the one record placeholder field')
      call ESMF_StateGet(mock_state, itemName='mapl_mock_put_mixed_quantity', field=field, rc=status)
      @assertEqual(0, status, 'the record placeholder must be named mapl_mock_<method>_<argument>')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_mock_mixing_profile_supply_and_record

   ! non_negative is a Handler config key like any other, read in the
   ! same build_configurable_handler call; it reports descriptors back
   ! rather than writing to cb_state (NonNegativeCharacteristic writes
   ! no Info key, so it cannot be observed on a realized State). Uses
   ! mock_mixing's mixed_quantity (xyz): column fill is meaningless on
   ! a 2-D argument, so the fixture must be a vertical one.
   @test
   subroutine test_non_negative_is_a_handler_config_key()
      character(*), parameter :: FILENAME = 'non_negative_is_a_handler_config_key.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      class(StateItemCharacteristic), allocatable :: c
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_mixing' // NL // &
           geometry_yaml(num_levels=3) // &
           'supply:' // NL // &
           '  mixed_quantity: {constant: 1.0}' // NL // &
           'non_negative:' // NL // &
           '  mixed_quantity: {fill: column}' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'mixing_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertEqual(0, status, 'build_configurable_handler failed')
      @assertEqual(1, size(non_negative_names))
      @assertEqual('mixed_quantity', trim(non_negative_names(1)))

      call non_negative_descriptors(1)%get_characteristic(NON_NEGATIVE_CHARACTERISTIC_KIND, c, rc=status)
      @assertEqual(0, status, 'descriptor must carry a NonNegativeCharacteristic')
      select type (c)
      type is (NonNegativeCharacteristic)
         @assertEqual('column', c%get_fill())
      class default
         @assertTrue(.false., 'NON_NEGATIVE entry has the wrong type')
      end select

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_non_negative_is_a_handler_config_key

   !-----------------------------------------------------------------
   ! conformance failures (build succeeds; check_callback_state_conformance
   ! must catch a badly configured attribute)
   !-----------------------------------------------------------------

   ! operation: ofset (misspelled) is not in the allowed set [scale,
   ! offset]: check_callback_state_conformance must catch it, and
   ! report it as an attribute_value_not_allowed violation.
   @test
   subroutine test_mock_toy_value_not_allowed_is_caught()
      character(*), parameter :: FILENAME = 'mock_toy_value_not_allowed_is_caught.yaml'
      type(ESMF_HConfig) :: hconfig
      type(CallbackInterface) :: iface
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      type(CallbackContractViolation), allocatable :: violations(:)
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  quantity: {constant: 1.0}' // NL // &
           'state_attributes:' // NL // &
           '  operation: ofset' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertEqual(0, status, 'build_configurable_handler failed')

      iface = get_callback_interface_by_name(interface_name, rc=status)
      @assertEqual(0, status)
      call check_callback_state_conformance(cb_state, iface, interface_name, &
           'toy_handler', violations, rc=status)
      @assertEqual(0, status, 'check_callback_state_conformance failed')
      @assertEqual(1, size(violations), 'operation: ofset is not an allowed value and must be caught')
      @assertTrue(has_violation_code(violations, 'attribute_value_not_allowed:'), &
           'the violation must be attribute_value_not_allowed, got ' // violations(1)%get_code())

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_mock_toy_value_not_allowed_is_caught

   ! state_attributes omits operation, which is required: a missing
   ! required attribute must be caught as a missing_attribute violation.
   @test
   subroutine test_mock_toy_missing_required_attribute_is_caught()
      character(*), parameter :: FILENAME = 'mock_toy_missing_required_attribute_is_caught.yaml'
      type(ESMF_HConfig) :: hconfig
      type(CallbackInterface) :: iface
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      type(CallbackContractViolation), allocatable :: violations(:)
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  quantity: {constant: 1.0}' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertEqual(0, status, 'build_configurable_handler failed')

      iface = get_callback_interface_by_name(interface_name, rc=status)
      @assertEqual(0, status)
      call check_callback_state_conformance(cb_state, iface, interface_name, &
           'toy_handler', violations, rc=status)
      @assertEqual(0, status, 'check_callback_state_conformance failed')
      @assertEqual(1, size(violations), 'a missing required attribute (operation) must be caught')
      @assertTrue(has_violation_code(violations, 'missing_attribute:'), &
           'the violation must be missing_attribute, got ' // violations(1)%get_code())

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_mock_toy_missing_required_attribute_is_caught

   !-----------------------------------------------------------------
   ! build_configurable_handler failures (bad Handler config; build
   ! itself must fail, not silently produce a bad State)
   !-----------------------------------------------------------------

   @test
   subroutine test_supply_profile_wrong_length_fails()
      character(*), parameter :: FILENAME = 'supply_profile_wrong_length_fails.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_mixing' // NL // &
           geometry_yaml(num_levels=3) // &
           'supply:' // NL // &
           '  mixed_quantity: {profile: [1.0e-6, 2.0e-6]}' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'mixing_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler mixing_handler: argument mixed_quantity: ' // &
           'supply profile length does not match the vertical grid')
      ! Drop the _RC propagation of the error through the callers.
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, &
           'a 2-value profile against a 3-level vertical grid must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_supply_profile_wrong_length_fails

   @test
   subroutine test_supply_unknown_key_fails()
      character(*), parameter :: FILENAME = 'supply_unknown_key_fails.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  quantity: {bogus: 1.0}' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler toy_handler: argument quantity: ' // &
           'supply needs one of constant, profile, function')
      ! Drop the _RC propagation of the error through the callers.
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, 'an unrecognized supply key (bogus) must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_supply_unknown_key_fails

   ! quantity (xy, mock_toy) supplied by function: lon - a simple
   ! function of lon only, checkable against the known grid-point
   ! longitudes of geometry_yaml()'s 4x3 dateline/pole-centered grid
   ! (im_world=4 -> column longitudes -180, -90, 0, 90 degrees).
   @test
   subroutine test_supply_function_of_lon_on_xy_argument()
      character(*), parameter :: FILENAME = 'supply_function_of_lon.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      type(ESMF_Field) :: field
      real(kind=ESMF_KIND_R8), pointer :: ptr2d(:,:)
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  quantity: {function: lon}' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertEqual(0, status, 'build_configurable_handler failed')

      call ESMF_StateGet(cb_state, itemName='quantity', field=field, rc=status)
      @assertEqual(0, status)
      call ESMF_FieldGet(field, farrayPtr=ptr2d, rc=status)
      @assertEqual(0, status)
      @assertEqual(-180.0_ESMF_KIND_R8, ptr2d(1,:), tolerance=TOL, message='column 1 longitude')
      @assertEqual(-90.0_ESMF_KIND_R8, ptr2d(2,:), tolerance=TOL, message='column 2 longitude')
      @assertEqual(0.0_ESMF_KIND_R8, ptr2d(3,:), tolerance=TOL, message='column 3 longitude')
      @assertEqual(90.0_ESMF_KIND_R8, ptr2d(4,:), tolerance=TOL, message='column 4 longitude')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_supply_function_of_lon_on_xy_argument

   ! mixed_quantity (xyz, mock_mixing) supplied by function: level - a
   ! function of the (1-based) level index only, broadcast over every
   ! column, checkable exactly like test_mock_mixing_profile_supply_and_record's
   ! profile: [1.0e-6, 2.0e-6, 3.0e-6] checks its own per-level values.
   @test
   subroutine test_supply_function_of_level_on_xyz_argument()
      character(*), parameter :: FILENAME = 'supply_function_of_level.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      type(ESMF_Field) :: field
      real(kind=ESMF_KIND_R8), pointer :: ptr3d(:,:,:)
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_mixing' // NL // &
           geometry_yaml(num_levels=3) // &
           'supply:' // NL // &
           '  mixed_quantity: {function: level*1.0e-6}' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'mixing_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertEqual(0, status, 'build_configurable_handler failed')

      call ESMF_StateGet(cb_state, itemName='mixed_quantity', field=field, rc=status)
      @assertEqual(0, status)
      call ESMF_FieldGet(field, farrayPtr=ptr3d, rc=status)
      @assertEqual(0, status)
      @assertEqual(1.0e-6_ESMF_KIND_R8, ptr3d(:,:,1), tolerance=TOL, message='level 1')
      @assertEqual(2.0e-6_ESMF_KIND_R8, ptr3d(:,:,2), tolerance=TOL, message='level 2')
      @assertEqual(3.0e-6_ESMF_KIND_R8, ptr3d(:,:,3), tolerance=TOL, message='level 3')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_supply_function_of_level_on_xyz_argument

   ! An unparseable function: expression must fail clearly (the state
   ! arithmetic parser's own diagnostic, not a cryptic internal error) -
   ! here a bare operator with no operand.
   @test
   subroutine test_supply_function_malformed_expression_fails()
      character(*), parameter :: FILENAME = 'supply_function_malformed_expression.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
      character(:), allocatable :: interface_name, handler_cfg
      integer :: status

      call load_mock_interfaces(FILENAME)

      handler_cfg = &
           'interface: mock_toy' // NL // &
           geometry_yaml() // &
           'supply:' // NL // &
           '  quantity: {function: "+"}' // NL
      hconfig = ESMF_HConfigCreate(content=handler_cfg, rc=status)
      @assertEqual(0, status)

      call build_configurable_handler(hconfig, 'toy_handler', interface_name, &
           cb_state, mock_state, non_negative_names, non_negative_descriptors, rc=status)
      @assertExceptionRaised('ConfigurableCallbackHandler toy_handler: argument quantity: ' // &
           'supply function "+" failed to evaluate')
      ! Drop the parser's own diagnostic and the _RC propagation through the callers.
      do while (catch('Missing operand in +'))
      end do
      do while (catch('status=1'))
      end do
      @assertFalse(status == 0, 'a malformed function expression must fail at build')

      call ESMF_HConfigDestroy(hconfig, rc=status)
      @assertEqual(0, status)
   end subroutine test_supply_function_malformed_expression_fails

   ! A function: expression referencing a name that is not lon, lat, or
   ! (xyz only) level must fail clearly - here level on an xy argument,
   ! which is legal syntax but not a variable available to a 2-D field.
   @test
   subroutine test_supply_function_unknown_variable_fails()
      character(*), parameter :: FILENAME = 'supply_function_unknown_variable.yaml'
      type(ESMF_HConfig) :: hconfig
      type(ESMF_State) :: cb_state, mock_state
      character(ESMF_MAXSTR), allocatable :: non_negative_names(:)
      type(StateItemDescriptor), allocatable :: non_negative_descriptors(:)
