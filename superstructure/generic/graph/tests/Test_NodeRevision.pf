! Spec: spec/11-revision-and-update.md.
module Test_NodeRevision
   use mapl_NodeRevision_mod, only: NodeRevision, operator(==), operator(/=)
   use funit
   implicit none

contains

   ! Initial state is invalid, distinct from any value
   ! reachable by advance().
   @test
   subroutine test_default_constructed_is_invalid()
      type(NodeRevision) :: revision

      @assertFalse(revision%is_valid())
   end subroutine test_default_constructed_is_invalid

   ! First advance() transitions invalid -> first valid.
   @test
   subroutine test_first_advance_produces_valid_revision()
      type(NodeRevision) :: revision
      integer :: status

      call revision%advance(rc=status)
      @assertEqual(0, status)
      @assertTrue(revision%is_valid())
   end subroutine test_first_advance_produces_valid_revision

   ! Repeated advance() strictly changes the observable
   ! revision each time.
   @test
   subroutine test_repeated_advance_changes_revision()
      type(NodeRevision) :: revision
      type(NodeRevision) :: after_first, after_second
      integer :: status

      call revision%advance(rc=status)
      @assertEqual(0, status)
      after_first = revision

      call revision%advance(rc=status)
      @assertEqual(0, status)
      after_second = revision

      @assertTrue(after_first /= after_second)
   end subroutine test_repeated_advance_changes_revision

   ! Two independently-advanced-the-same-number-of-times
   ! revisions compare equal (equality is value-based, not identity-based).
   @test
   subroutine test_equal_advance_counts_compare_equal()
      type(NodeRevision) :: left, right
      integer :: status

      call left%advance(rc=status)
      @assertEqual(0, status)
      call left%advance(rc=status)
      @assertEqual(0, status)

      call right%advance(rc=status)
      @assertEqual(0, status)
      call right%advance(rc=status)
      @assertEqual(0, status)

      @assertTrue(left == right)
   end subroutine test_equal_advance_counts_compare_equal

   ! Overflow is detected before wrapping, leaving the
   ! observable value unchanged. Uses the test-only
   ! debug_force_max_for_test() backdoor to reach the boundary directly,
   ! rather than looping ~2^63 times.
   @test
   subroutine test_advance_overflow_detected_not_wrapped()
      type(NodeRevision) :: revision
      character(:), allocatable :: before_overflow_attempt
      integer :: status

      call revision%debug_force_max_for_test()
      before_overflow_attempt = revision%to_string()

      call revision%advance(rc=status)
      @assertTrue(status /= 0)
      @assertEqual(before_overflow_attempt, revision%to_string())
   end subroutine test_advance_overflow_detected_not_wrapped

   ! Diagnostic accessor, exercised here since the exporter depends on it:
   ! to_string() reports a sentinel for an invalid revision and a
   ! numeric-looking string for a valid one.
   @test
   subroutine test_to_string_reports_invalid_then_numeric()
      type(NodeRevision) :: revision
      integer :: status

      @assertEqual('INVALID', revision%to_string())

      call revision%advance(rc=status)
      @assertEqual(0, status)
      @assertEqual('0', revision%to_string())

      call revision%advance(rc=status)
      @assertEqual(0, status)
      @assertEqual('1', revision%to_string())
   end subroutine test_to_string_reports_invalid_then_numeric

end module Test_NodeRevision
