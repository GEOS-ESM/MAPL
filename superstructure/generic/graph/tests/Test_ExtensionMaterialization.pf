! Real payload materialization for a framework-created extension item
! (mapl_ExtensionMaterialization_mod), gated by
! mapl_ExtensionResolution_mod's materialize_extensions_enabled()/
! set_materialize_extensions(). Synthetic ComponentGraph/StateItemNode
! setup, same style as Test_ExtensionResolution.pf - extended here with a
! real ESMF_Geom (ESMF_GridCreateNoPeriDim/ESMF_GeomCreate,
! Test_FieldCreate.pf's own precedent) since this capability's whole job
! is a real, allocated ESMF_Field, not a synthetic MockPayload.
!
! Gate hygiene (module-level mutable state can leak across pFUnit
! tests): every test that calls set_materialize_extensions
! resets it to .false. before returning.
module Test_ExtensionMaterialization
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetworkId_mod, only: DependencyNetworkId
   use mapl_NodeId_mod, only: NodeId, operator(==)
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem, operator(==)
   use mapl_NodeRevision_mod, only: NodeRevision
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristicMap
   use mapl_StateItemCharacteristicKind_mod, only: &
        StateItemCharacteristicKind, &
        PHYSICAL_UNITS_CHARACTERISTIC_KIND, GEOMETRY_CHARACTERISTIC_KIND, &
        TYPE_KIND_CHARACTERISTIC_KIND, HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND
   use mapl_PhysicalUnitsCharacteristic_mod, only: PhysicalUnitsCharacteristic
   use mapl_GeometryCharacteristic_mod, only: GeometryCharacteristic
   use mapl_TypeKindCharacteristic_mod, only: TypeKindCharacteristic
   use mapl_HorizontalDimsSpecCharacteristic_mod, only: HorizontalDimsSpecCharacteristic
   use mapl_HorizontalDimsSpec_mod, only: HORIZONTAL_DIMS_GEOM
   use mapl_ExtensionResolution_mod, only: find_mismatched_characteristics, find_or_build_extension_chain, &
        set_materialize_extensions, materialize_extensions_enabled
   use mapl_ExtensionMaterialization_mod, only: materialize_field_extension, &
        create_field_extension, field_extension_is_created, &
             rebuild_field_extension, create_bundle_extension
   use mapl_field_api, only: MAPL_FieldGet
   use mapl_field_bundle_api, only: MAPL_FieldBundleGet, MAPL_FieldBundlesAreAliased
   use mapl_ItemShapeCharacteristic_mod, only: ItemShapeCharacteristic
   use mapl_StateItemCharacteristicKind_mod, only: ITEM_SHAPE_CHARACTERISTIC_KIND
   use mapl_StateItem_mod, only: MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_BRACKET
   use mapl_StateItem_mod, only: MAPL_STATEITEM_FIELD
   use mapl_enums_api, only: MAPL_FieldBundleType_Flag
   use mapl_enums_api, only: MAPL_FIELDBUNDLETYPE_VECTOR, MAPL_FIELDBUNDLETYPE_BRACKET
   use mapl_enums_api, only: MAPL_VectorBasisKind, MAPL_VECTOR_BASIS_KIND_GRID, &
        MAPL_VECTOR_BASIS_KIND_NS
   use StateItemTestSupport_mod, only: make_latlon_geom
   use ESMF, only: ESMF_FieldBundle, ESMF_FieldBundleGet, ESMF_Geom
   use ESMF, only: ESMF_STATEITEM_FIELDBUNDLE, ESMF_StateItem_Flag
   use ESMF, only: ESMF_FieldStatus_Flag, ESMF_FIELDSTATUS_EMPTY, &
        ESMF_FIELDSTATUS_COMPLETE
   use mapl_SetSharedCharacteristic_mod, only: set_shared_characteristic
   use ESMF, only: ESMF_FieldGet, ESMF_MAXSTR
   use mapl_StateItemDescriptor_mod, only: StateItemDescriptor
   use mapl_FieldCreate_mod, only: FieldCreate, FieldsAreAliased
   use mapl_FieldGet_mod, only: FieldGet
   use mapl_enums_api, only: MAPL_StateItemAllocation, &
        MAPL_STATEITEM_ALLOCATION_ALLOCATED, &
        MAPL_STATEITEM_ALLOCATION_CREATED, operator(==)
   use mapl_FieldPointerUtilities_mod, only: assign_fptr
   use ESMF, only: ESMF_Grid, ESMF_Field, ESMF_TypeKind_Flag
   use ESMF, only: ESMF_GridCreateNoPeriDim, ESMF_GeomCreate
   use ESMF, only: ESMF_TYPEKIND_R4, ESMF_TYPEKIND_R8, ESMF_KIND_R4
   use ESMF, only: ESMF_STATEITEM_FIELD, ESMF_STATEITEM_NOTFOUND
   use ESMF, only: operator(==)
   use funit
   implicit none

contains

   ! -- gate ----------------------------------------------------------------

   @test
   subroutine test_gate_defaults_off_and_setter_round_trips()
      call set_materialize_extensions(.false.)
      @assertFalse(materialize_extensions_enabled())

      call set_materialize_extensions(.true.)
      @assertTrue(materialize_extensions_enabled())

      call set_materialize_extensions(.false.)
      @assertFalse(materialize_extensions_enabled())
   end subroutine test_gate_defaults_off_and_setter_round_trips

   ! -- materialization -------------------------------------------------------

   @test
   subroutine test_materialize_creates_real_field_with_correct_metadata()
      type(ComponentGraph), target :: graph
      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id, final_id
      type(StateItemNode) :: export_node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)
      type(NodeId), allocatable :: intermediate_ids(:)
      character(:), allocatable :: unsupported
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: result_payload
      type(ESMF_Field) :: result_field
      type(ESMF_TypeKind_Flag) :: got_typekind
      character(:), allocatable :: got_units
      type(MAPL_StateItemAllocation) :: got_allocation
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)

      graph = ComponentGraph()
      net_id = graph%get_forward_network_id()

      export_id = graph%next_node_id(rc=status)
      export_node = StateItemNode(export_id, payload, revision)
      call graph%register_node(export_node, rc=status)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('km'))
      ! The extension field is built from its descriptor: the geom comes
      ! from the export and typekind matches, so only units are converted.
      call export_map%insert(GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(geom_id='1', geom=geom))
      call export_map%insert(HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, &
           HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM))
      call export_map%insert(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'))
      call import_map%insert(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'))
      mismatched = find_mismatched_characteristics(export_map, import_map)

      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map, &
           mismatched, final_id, intermediate_ids, unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual('', unsupported)

      ! Before materialization: 3c's own unallocated placeholder (spec.md
      ! "Materialization disabled by default").
      node => graph%get_node(final_id)
      select type (node)
      class is (StateItemNode)
         result_payload = node%get_payload()
      class default
         @assertTrue(.false.)
      end select
      @assertTrue(result_payload%itemType(rc=status) == ESMF_STATEITEM_NOTFOUND)

      call set_materialize_extensions(.true.)
      call materialize_field_extension(graph, final_id, rc=status)
      @assertEqual(0, status)
      call set_materialize_extensions(.false.)

      node => graph%get_node(final_id)
      select type (node)
      class is (StateItemNode)
         result_payload = node%get_payload()
      class default
         @assertTrue(.false.)
      end select
      @assertTrue(result_payload%itemType(rc=status) == ESMF_STATEITEM_FIELD)

      result_field = result_payload%get_field(rc=status)
      @assertEqual(0, status)
      call FieldGet(result_field, typekind=got_typekind, units=got_units, &
           allocation_status=got_allocation, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_allocation == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R4)
      @assertEqual('km', got_units)
   end subroutine test_materialize_creates_real_field_with_correct_metadata

   ! spec.md "Reused extension is not re-materialized": a second call on
   ! the same (already-materialized) NodeId - as GraphBuilder.F90 makes
   ! whenever find_or_build_extension_chain reuses an existing chain for
   ! a second import - must be a no-op, not a second FieldCreate.
   @test
   subroutine test_materialize_is_idempotent_on_reuse()
      type(ComponentGraph), target :: graph
      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id, final_id
      type(StateItemNode) :: export_node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)
      type(NodeId), allocatable :: intermediate_ids(:)
      character(:), allocatable :: unsupported
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: result_payload
      type(ESMF_Field) :: field1, field2
      logical :: are_aliased
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      geom = ESMF_GeomCreate(grid, rc=status)

      graph = ComponentGraph()
      net_id = graph%get_forward_network_id()

      export_id = graph%next_node_id(rc=status)
      export_node = StateItemNode(export_id, payload, revision)
      call graph%register_node(export_node, rc=status)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('km'))
      ! The extension field is built from its descriptor: the geom comes
      ! from the export and typekind matches, so only units are converted.
      call export_map%insert(GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(geom_id='1', geom=geom))
      call export_map%insert(HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, &
           HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM))
      call export_map%insert(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'))
      call import_map%insert(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'))
      mismatched = find_mismatched_characteristics(export_map, import_map)

      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map, &
           mismatched, final_id, intermediate_ids, unsupported, rc=status)

      call set_materialize_extensions(.true.)

      call materialize_field_extension(graph, final_id, rc=status)
      @assertEqual(0, status)

      node => graph%get_node(final_id)
      select type (node)
      class is (StateItemNode)
         result_payload = node%get_payload()
      end select
      field1 = result_payload%get_field(rc=status)

      call materialize_field_extension(graph, final_id, rc=status)
      @assertEqual(0, status)

      call set_materialize_extensions(.false.)

      node => graph%get_node(final_id)
      select type (node)
      class is (StateItemNode)
         result_payload = node%get_payload()
      end select
      field2 = result_payload%get_field(rc=status)

      are_aliased = FieldsAreAliased(field1, field2, rc=status)
      @assertEqual(0, status)
      @assertTrue(are_aliased)
   end subroutine test_materialize_is_idempotent_on_reuse

   ! -- numerical correctness -----------------------------------------------

   @test
   subroutine test_materialized_field_supports_correct_unit_conversion()
      type(ComponentGraph), target :: graph
      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id, final_id
      type(StateItemNode) :: export_node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)
      type(NodeId), allocatable :: intermediate_ids(:)
      character(:), allocatable :: unsupported
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: input_field, output_field
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: input_payload, output_payload
      real(kind=ESMF_KIND_R4), pointer :: x_in(:), x_out(:)
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      geom = ESMF_GeomCreate(grid, rc=status)

      graph = ComponentGraph()
      net_id = graph%get_forward_network_id()

      export_id = graph%next_node_id(rc=status)
      export_node = StateItemNode(export_id, payload, revision)
      call graph%register_node(export_node, rc=status)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('km'))
      ! The extension field is built from its descriptor: the geom comes
      ! from the export and typekind matches, so only units are converted.
      call export_map%insert(GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(geom_id='1', geom=geom))
      call export_map%insert(HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, &
           HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM))
      call export_map%insert(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'))
      call import_map%insert(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'))
      mismatched = find_mismatched_characteristics(export_map, import_map)

      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map, &
           mismatched, final_id, intermediate_ids, unsupported, rc=status)
      @assertEqual(0, status)

      ! Simulate the export item already having a real, populated field -
      ! out of scope for this test (it only materializes the
      ! *extension* item; the export/source item's own realization is
      ! separate integration work).
      input_field = FieldCreate(geom=geom, typekind=ESMF_TYPEKIND_R4, units='m', rc=status)
      @assertEqual(0, status)
      call assign_fptr(input_field, x_in, rc=status)
      @assertEqual(0, status)
      x_in = 1000.0

      call input_payload%set(input_field, rc=status)
      node => graph%get_node(export_id)
      select type (node)
      class is (StateItemNode)
         call node%set_payload(input_payload)
      end select

      call set_materialize_extensions(.true.)
      call materialize_field_extension(graph, final_id, rc=status)
      @assertEqual(0, status)
      call set_materialize_extensions(.false.)

      call graph%update(final_id, rc=status)
      @assertEqual(0, status)

      node => graph%get_node(final_id)
      select type (node)
      class is (StateItemNode)
         output_payload = node%get_payload()
      end select
      output_field = output_payload%get_field(rc=status)
      @assertEqual(0, status)

      call assign_fptr(output_field, x_out, rc=status)
      @assertEqual(0, status)
      ! 1000 m == 1 km
      @assertEqual(1.0, x_out(1), tolerance=1.0e-4)
   end subroutine test_materialized_field_supports_correct_unit_conversion

   ! -- fill_value (not a characteristic) ----------------------------------

   ! Builds an export (units m, optional fill_value on its descriptor) and a
   ! km import chain, materializes the extension, and returns its data.
   subroutine materialize_with_fill(export_fill, x_out, rc)
      real, optional, intent(in) :: export_fill
      real(kind=ESMF_KIND_R4), allocatable, intent(out) :: x_out(:)
      integer, intent(out) :: rc

      type(ComponentGraph), target :: graph
      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id, final_id
      type(StateItemNode), target :: export_node
      type(GraphStateItem) :: payload, result_payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)
      type(NodeId), allocatable :: intermediate_ids(:)
      character(:), allocatable :: unsupported
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: field
      class(GraphNode), pointer :: node
      type(StateItemDescriptor), pointer :: descriptor
      real(kind=ESMF_KIND_R4), pointer :: x(:)

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=rc)
      geom = ESMF_GeomCreate(grid, rc=rc)

      graph = ComponentGraph()
      net_id = graph%get_forward_network_id()

      export_id = graph%next_node_id(rc=rc)
      export_node = StateItemNode(export_id, payload, revision)
      if (present(export_fill)) then
         descriptor => export_node%get_descriptor()
         call descriptor%set_fill_value(export_fill)
      end if
      call graph%register_node(export_node, rc=rc)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           PhysicalUnitsCharacteristic('m'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           PhysicalUnitsCharacteristic('km'))
      call export_map%insert(GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(geom_id='1', geom=geom))
      call export_map%insert(HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, &
           HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM))
      call export_map%insert(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'))
      call import_map%insert(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'))
      mismatched = find_mismatched_characteristics(export_map, import_map)

      call find_or_build_extension_chain(graph, net_id, export_id, &
           export_map, import_map, mismatched, final_id, intermediate_ids, &
           unsupported, rc=rc)
      if (rc /= 0) return

      call materialize_field_extension(graph, final_id, rc=rc)
      if (rc /= 0) return

      node => graph%get_node(final_id)
      select type (node)
      class is (StateItemNode)
         result_payload = node%get_payload()
      end select
      field = result_payload%get_field(rc=rc)
      call assign_fptr(field, x, rc=rc)
      x_out = x
   end subroutine materialize_with_fill

   ! Red before: the extension field was never filled (data not 15).
   @test
   subroutine test_extension_field_filled_from_export_fill_value()
      real(kind=ESMF_KIND_R4), allocatable :: x(:)
      integer :: status

      call materialize_with_fill(export_fill=15.0, x_out=x, rc=status)
      @assertEqual(0, status)
      @assertEqual(15.0, x(1), tolerance=1.0e-6)
   end subroutine test_extension_field_filled_from_export_fill_value

   ! Pins the no-fill case: no fill is applied, so the call succeeds and the
   ! data is whatever a fresh field holds (not asserted).
   @test
   subroutine test_extension_field_without_fill_value_is_not_filled()
      real(kind=ESMF_KIND_R4), allocatable :: x(:)
      integer :: status

      call materialize_with_fill(x_out=x, rc=status)
      @assertEqual(0, status)
      @assertEqual(4, size(x))
   end subroutine test_extension_field_without_fill_value_is_not_filled

   ! -- set_shared_characteristic rebuild --------------------------------

   ! Builds a node whose descriptor is complete and materializes its
   ! field under the name 'f1'.
   subroutine make_named_field_node(graph, node_id, geom, fill, rc)
      type(ComponentGraph), target, intent(inout) :: graph
      type(NodeId), intent(out) :: node_id
      type(ESMF_Geom), intent(out) :: geom
      real, optional, intent(in) :: fill
      integer, intent(out) :: rc

      type(ESMF_Grid) :: grid
      type(StateItemNode), target :: node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemDescriptor), pointer :: descriptor

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=rc)
      geom = ESMF_GeomCreate(grid, rc=rc)
      graph = ComponentGraph()
      node_id = graph%next_node_id(rc=rc)
      node = StateItemNode(node_id, payload, revision)
      descriptor => node%get_descriptor()
      call descriptor%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           PhysicalUnitsCharacteristic('m'), rc=rc)
      call descriptor%set_characteristic(GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(geom_id='1', geom=geom), rc=rc)
      call descriptor%set_characteristic( &
           HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, &
           HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM), rc=rc)
      call descriptor%set_characteristic(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'), rc=rc)
      if (present(fill)) call descriptor%set_fill_value(fill)
      call graph%register_node(node, rc=rc)
      call materialize_field_extension(graph, node_id, name='f1', rc=rc)
   end subroutine make_named_field_node

   subroutine get_node_field(graph, node_id, field, rc)
      type(ComponentGraph), target, intent(in) :: graph
      type(NodeId), intent(in) :: node_id
      type(ESMF_Field), intent(out) :: field
      integer, intent(out) :: rc

      class(GraphNode), pointer :: node
      type(GraphStateItem) :: payload

      node => graph%get_node(node_id)
      select type (node)
      class is (StateItemNode)
         payload = node%get_payload()
      end select
      field = payload%get_field(rc=rc)
   end subroutine get_node_field

   @test
   subroutine test_set_shared_structural_rebuilds_field()
      type(ComponentGraph), target :: graph
      type(NodeId) :: id
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: before, after
      type(ESMF_TypeKind_Flag) :: got_typekind
      character(len=ESMF_MAXSTR) :: got_name
      logical :: same
      integer :: s1, s2, s3, s4, s5, s6

      call make_named_field_node(graph, id, geom, fill=7.0, rc=s1)
      call get_node_field(graph, id, before, s2)
      call set_shared_characteristic(graph, id, TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R8'), rc=s3)
      call get_node_field(graph, id, after, s4)
      same = FieldsAreAliased(before, after)
      call FieldGet(after, typekind=got_typekind, rc=s5)
      call ESMF_FieldGet(after, name=got_name, rc=s6)

      @assertEqual(0, s1 + s2 + s3 + s4 + s5 + s6)
      @assertFalse(same)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R8)
      @assertEqual('f1', trim(got_name))
   end subroutine test_set_shared_structural_rebuilds_field

   @test
   subroutine test_set_shared_rebuilt_field_has_fill_value()
      type(ComponentGraph), target :: graph
      type(NodeId) :: id
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: before, after
      real(kind=ESMF_KIND_R4), pointer :: x(:), x_old(:)
      integer :: s1, s2, s3, s4, s5, s6

      call make_named_field_node(graph, id, geom, fill=7.0, rc=s1)
      ! Zero the old data so only a real rebuild can read 7.0 back.
      call get_node_field(graph, id, before, s5)
      call assign_fptr(before, x_old, rc=s6)
      x_old = 0.0
      ! Same typekind, new geometry object: still a structural change.
      call set_shared_characteristic(graph, id, GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(geom_id='1', geom=geom), rc=s2)
      call get_node_field(graph, id, after, s3)
      call assign_fptr(after, x, rc=s4)
      @assertEqual(0, s1 + s2 + s3 + s4 + s5 + s6)
      @assertEqual(7.0, x(1), tolerance=1.0e-6)
   end subroutine test_set_shared_rebuilt_field_has_fill_value

   @test
   subroutine test_set_shared_nonstructural_keeps_same_field()
      type(ComponentGraph), target :: graph
      type(NodeId) :: id
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: before, after
      logical :: same
      integer :: s1, s2, s3, s4

      call make_named_field_node(graph, id, geom, rc=s1)
      call get_node_field(graph, id, before, s2)
      call set_shared_characteristic(graph, id, &
           PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           PhysicalUnitsCharacteristic('km'), rc=s3)
      call get_node_field(graph, id, after, s4)
      same = FieldsAreAliased(before, after)
      @assertEqual(0, s1 + s2 + s3 + s4)
      @assertTrue(same)
   end subroutine test_set_shared_nonstructural_keeps_same_field

   @test
   subroutine test_set_shared_without_field_payload_does_not_rebuild()
      type(ComponentGraph), target :: graph
      type(NodeId) :: id
      type(StateItemNode) :: node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      integer :: s1, s2

      graph = ComponentGraph()
      id = graph%next_node_id(rc=s1)
      node = StateItemNode(id, payload, revision)
      call graph%register_node(node, rc=s1)
      call set_shared_characteristic(graph, id, TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R8'), rc=s2)
      @assertEqual(0, s1)
      @assertEqual(0, s2)
   end subroutine test_set_shared_without_field_payload_does_not_rebuild

   ! A node first gets an empty Field (status CREATED), then the same Field
   ! object is completed and allocated from the node descriptor; a rebuild
   ! of a merely created Field changes nothing; a second materialize is a
   ! no-op on the allocated Field.
   @test
   subroutine test_create_then_materialize_keeps_one_field()
      type(ComponentGraph), target :: graph
      type(NodeId) :: node_id
      type(StateItemNode) :: item_node
      type(GraphStateItem) :: payload, after_payload
      type(NodeRevision) :: revision
      type(StateItemDescriptor), pointer :: descriptor
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      class(GraphNode), pointer :: node
      type(ESMF_Field) :: created, completed, again
      type(ESMF_FieldStatus_Flag) :: created_fstatus, completed_fstatus
      type(MAPL_StateItemAllocation) :: created_alloc, completed_alloc
      logical :: was_created, is_created_after, same_field, same_again
      integer :: status, st1, st2, st3, st4

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      geom = ESMF_GeomCreate(grid, rc=status)

      graph = ComponentGraph()
      node_id = graph%next_node_id(rc=status)
      item_node = StateItemNode(node_id, payload, revision)
      call graph%register_node(item_node, rc=status)

      node => graph%get_node(node_id)
      select type (node)
      class is (StateItemNode)
         descriptor => node%get_descriptor()
      end select
      call descriptor%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           PhysicalUnitsCharacteristic('m'), rc=status)
      call descriptor%set_characteristic(GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(geom_id='1', geom=geom), rc=status)
      call descriptor%set_characteristic( &
           HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, &
           HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM), rc=status)
      call descriptor%set_characteristic(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'), rc=status)

      call create_field_extension(graph, node_id, 'T', rc=status)
      @assertEqual(0, status)
      was_created = field_extension_is_created(graph, node_id)
      select type (node)
      class is (StateItemNode)
         payload = node%get_payload()
      end select
      created = payload%get_field(rc=st1)
      call ESMF_FieldGet(created, status=created_fstatus, rc=st2)
      call MAPL_FieldGet(created, allocation_status=created_alloc, rc=st3)
      @assertEqual(0, st1)
      @assertEqual(0, st2)
      @assertEqual(0, st3)
      @assertTrue(was_created)
      @assertTrue(created_fstatus == ESMF_FIELDSTATUS_EMPTY)
      @assertTrue(created_alloc == MAPL_STATEITEM_ALLOCATION_CREATED)

      ! Nothing to rebuild on a Field that is only created.
      call rebuild_field_extension(graph, node_id, rc=status)
      @assertEqual(0, status)
      @assertTrue(field_extension_is_created(graph, node_id))

      call materialize_field_extension(graph, node_id, rc=status)
      @assertEqual(0, status)
      is_created_after = field_extension_is_created(graph, node_id)
      select type (node)
      class is (StateItemNode)
         after_payload = node%get_payload()
      end select
      completed = after_payload%get_field(rc=st1)
      call ESMF_FieldGet(completed, status=completed_fstatus, rc=st2)
      call MAPL_FieldGet(completed, allocation_status=completed_alloc, rc=st3)
      same_field = FieldsAreAliased(created, completed, rc=st4)
      @assertEqual(0, st1)
      @assertEqual(0, st2)
      @assertEqual(0, st3)
      @assertEqual(0, st4)
      @assertFalse(is_created_after)
      @assertTrue(completed_fstatus == ESMF_FIELDSTATUS_COMPLETE)
      @assertTrue(completed_alloc == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertTrue(same_field)

      call materialize_field_extension(graph, node_id, rc=status)
      @assertEqual(0, status)
      select type (node)
      class is (StateItemNode)
         after_payload = node%get_payload()
      end select
      again = after_payload%get_field(rc=status)
      same_again = FieldsAreAliased(completed, again, rc=st4)
      @assertEqual(0, st4)
      @assertTrue(same_again)
   end subroutine test_create_then_materialize_keeps_one_field

   ! -- bundle links ------------------------------------------------------

   ! Builds the chain from an export of shape `export_class` on one geom to
   ! an import of shape `import_class` on another (units and typekind equal),
   ! and returns the chain links. Test helper.
   subroutine build_bundle_chain(graph, export_class, import_class, &
        final_id, intermediate_ids)
      type(ComponentGraph), target, intent(inout) :: graph
      type(ESMF_StateItem_Flag), intent(in) :: export_class, import_class
      type(NodeId), intent(out) :: final_id
      type(NodeId), allocatable, intent(out) :: intermediate_ids(:)

      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id
      type(StateItemNode) :: export_node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)
      type(ESMF_Geom) :: src_geom, dst_geom
      character(:), allocatable :: unsupported
      integer :: status

      graph = ComponentGraph()
      net_id = graph%get_forward_network_id()
      export_id = graph%next_node_id(rc=status)
      export_node = StateItemNode(export_id, payload, revision)
      call graph%register_node(export_node, rc=status)

      src_geom = make_latlon_geom(12, 13, status)
      @assertEqual(0, status)
      dst_geom = make_latlon_geom(6, 7, status)
      @assertEqual(0, status)
      call export_map%insert(ITEM_SHAPE_CHARACTERISTIC_KIND, &
           ItemShapeCharacteristic(export_class))
      call import_map%insert(ITEM_SHAPE_CHARACTERISTIC_KIND, &
           ItemShapeCharacteristic(import_class))
      call export_map%insert(GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(geom_id='1', geom=src_geom))
      call import_map%insert(GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(geom_id='2', geom=dst_geom))
      call export_map%insert(HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, &
           HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM))
      call import_map%insert(HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, &
           HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM))
      call export_map%insert(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R8'))
      call import_map%insert(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R8'))
      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           PhysicalUnitsCharacteristic('m s-1'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           PhysicalUnitsCharacteristic('m s-1'))
      mismatched = find_mismatched_characteristics(export_map, import_map)

      call find_or_build_extension_chain(graph, net_id, export_id, &
           export_map, import_map, mismatched, final_id, intermediate_ids, &
           unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual('', unsupported)
   end subroutine build_bundle_chain

   ! The payload bundle of node_id, or failure.
   subroutine bundle_of(graph, node_id, bundle)
      type(ComponentGraph), target, intent(inout) :: graph
      type(NodeId), intent(in) :: node_id
      type(ESMF_FieldBundle), intent(out) :: bundle

      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: payload
      type(ESMF_StateItem_Flag) :: item_type
      integer :: status

      node => graph%get_node(node_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
         item_type = payload%itemType(rc=status)
         @assertEqual(0, status)
         @assertTrue(item_type == ESMF_STATEITEM_FIELDBUNDLE)
         bundle = payload%get_field_bundle(rc=status)
         @assertEqual(0, status)
      class default
         @assertTrue(.false.)
      end select
   end subroutine bundle_of

   ! A VECTOR link is an allocated VECTOR bundle with the descriptor written
   ! on it and no members: the Transform makes them at compute.
   @test
   subroutine test_vector_link_is_allocated_bundle_without_members()
      type(ComponentGraph), target :: graph
      type(NodeId) :: final_id
      type(NodeId), allocatable :: intermediate_ids(:)
      type(ESMF_FieldBundle) :: bundle
      type(MAPL_FieldBundleType_Flag) :: bundle_type
      type(MAPL_StateItemAllocation) :: alloc_status
      type(ESMF_TypeKind_Flag) :: got_typekind
      type(ESMF_Geom), allocatable :: got_geom
      character(:), allocatable :: got_units
      integer :: n_members, status

      call build_bundle_chain(graph, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTOR, final_id, intermediate_ids)
      @assertEqual(1, size(intermediate_ids))

      call materialize_field_extension(graph, intermediate_ids(1), &
           name='uv', rc=status)
      @assertEqual(0, status)

      call bundle_of(graph, intermediate_ids(1), bundle)
      call MAPL_FieldBundleGet(bundle, fieldBundleType=bundle_type, &
           typekind=got_typekind, geom=got_geom, units=got_units, &
           allocation_status=alloc_status, rc=status)
      @assertEqual(0, status)
      call ESMF_FieldBundleGet(bundle, fieldCount=n_members, rc=status)
      @assertEqual(0, status)
      @assertTrue(bundle_type == MAPL_FIELDBUNDLETYPE_VECTOR)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R8)
      @assertTrue(allocated(got_geom))
      @assertEqual('m s-1', got_units)
      @assertTrue(alloc_status == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertEqual(0, n_members)
   end subroutine test_vector_link_is_allocated_bundle_without_members

   ! A BRACKET export into a FIELD import: the regrid link is a BRACKET
   ! bundle and the time-interpolation link a plain Field.
   @test
   subroutine test_bracket_chain_links_are_bundle_then_field()
      type(ComponentGraph), target :: graph
      type(NodeId) :: final_id
      type(NodeId), allocatable :: intermediate_ids(:)
      type(ESMF_FieldBundle) :: bundle
      type(MAPL_FieldBundleType_Flag) :: bundle_type
      type(GraphStateItem), pointer :: payload
      class(GraphNode), pointer :: node
      type(ESMF_StateItem_Flag) :: item_type
      integer :: n_members, status

      call build_bundle_chain(graph, MAPL_STATEITEM_BRACKET, &
           MAPL_STATEITEM_FIELD, final_id, intermediate_ids)
      @assertEqual(2, size(intermediate_ids))

      call materialize_field_extension(graph, intermediate_ids(1), rc=status)
      @assertEqual(0, status)
      call materialize_field_extension(graph, intermediate_ids(2), rc=status)
      @assertEqual(0, status)

      call bundle_of(graph, intermediate_ids(1), bundle)
      call MAPL_FieldBundleGet(bundle, fieldBundleType=bundle_type, rc=status)
      @assertEqual(0, status)
      call ESMF_FieldBundleGet(bundle, fieldCount=n_members, rc=status)
      @assertEqual(0, status)
      @assertTrue(bundle_type == MAPL_FIELDBUNDLETYPE_BRACKET)
      @assertEqual(0, n_members)

      node => graph%get_node(intermediate_ids(2))
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
         item_type = payload%itemType(rc=status)
         @assertEqual(0, status)
         @assertTrue(item_type == ESMF_STATEITEM_FIELD)
      class default
         @assertTrue(.false.)
      end select
   end subroutine test_bracket_chain_links_are_bundle_then_field

   ! A bundle that already exists (a reused chain) is the same bundle after
   ! another materialization.
   @test
   subroutine test_bundle_link_is_not_rebuilt()
      type(ComponentGraph), target :: graph
      type(NodeId) :: final_id
      type(NodeId), allocatable :: intermediate_ids(:)
      type(ESMF_FieldBundle) :: first, second
      logical :: same_bundle
      integer :: status

      call build_bundle_chain(graph, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTOR, final_id, intermediate_ids)
      call materialize_field_extension(graph, intermediate_ids(1), rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, intermediate_ids(1), first)

      call materialize_field_extension(graph, intermediate_ids(1), rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, intermediate_ids(1), second)

      same_bundle = MAPL_FieldBundlesAreAliased(first, second, rc=status)
      @assertEqual(0, status)
      @assertTrue(same_bundle)
   end subroutine test_bundle_link_is_not_rebuilt

   ! -- export bundles (VECTOR, BRACKET) the graph owns ---------------------

   ! Registers an export node on a 2x2 geom with units, typekind R4 and the
   ! shape of `item_class`, as advertise leaves it. Test helper.
   subroutine make_bundle_export(graph, node_id, item_class, rc, &
        bracket_size, fill, names, basis)
      type(ComponentGraph), target, intent(inout) :: graph
      type(NodeId), intent(out) :: node_id
      type(ESMF_StateItem_Flag), intent(in) :: item_class
      integer, intent(out) :: rc
      integer, optional, intent(in) :: bracket_size
      real, optional, intent(in) :: fill
      character(*), optional, intent(in) :: names(2)
      type(MAPL_VectorBasisKind), optional, intent(in) :: basis

      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(StateItemNode), target :: node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemDescriptor), pointer :: descriptor

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=rc)
      geom = ESMF_GeomCreate(grid, rc=rc)
      graph = ComponentGraph()
      node_id = graph%next_node_id(rc=rc)
      node = StateItemNode(node_id, payload, revision)
      descriptor => node%get_descriptor()
      call descriptor%set_declared_item_type(item_class)
      call descriptor%set_characteristic(ITEM_SHAPE_CHARACTERISTIC_KIND, &
           ItemShapeCharacteristic(item_class), rc=rc)
      call descriptor%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           PhysicalUnitsCharacteristic('m s-1'), rc=rc)
      call descriptor%set_characteristic(GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(geom_id='1', geom=geom), rc=rc)
      call descriptor%set_characteristic( &
           HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, &
           HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM), rc=rc)
      call descriptor%set_characteristic(TYPE_KIND_CHARACTERISTIC_KIND, &
           TypeKindCharacteristic('R4'), rc=rc)
      if (present(bracket_size)) call descriptor%set_bracket_size(bracket_size)
      if (present(fill)) call descriptor%set_fill_value(fill)
      if (present(names)) call descriptor%set_vector_component_names( &
           trim(names(1)), trim(names(2)))
      if (present(basis)) call descriptor%set_vector_basis_kind(basis)
      call graph%register_node(node, rc=rc)
   end subroutine make_bundle_export

   ! A created VECTOR export is an empty bundle: type VECTOR, status CREATED,
   ! the declared basis, no members. A bracket likewise has bracket_updated
   ! set, as legacy create does. Neither is completed by creating it.
   @test
   subroutine test_created_bundle_export_is_memberless_and_created()
      type(ComponentGraph), target :: graph
      type(NodeId) :: vector_id, bracket_id
      type(ESMF_FieldBundle) :: bundle
      type(MAPL_FieldBundleType_Flag) :: bundle_type
      type(MAPL_StateItemAllocation) :: alloc_status
      type(MAPL_VectorBasisKind) :: basis
      logical :: updated, vector_created, bracket_created
      integer :: n_members, status

      call make_bundle_export(graph, vector_id, MAPL_STATEITEM_VECTOR, &
           status, basis=MAPL_VECTOR_BASIS_KIND_GRID)
      @assertEqual(0, status)
      call create_bundle_extension(graph, vector_id, 'uv', rc=status)
      @assertEqual(0, status)
      vector_created = field_extension_is_created(graph, vector_id)
      call bundle_of(graph, vector_id, bundle)
      call MAPL_FieldBundleGet(bundle, fieldBundleType=bundle_type, &
           allocation_status=alloc_status, vector_basis_kind=basis, rc=status)
      @assertEqual(0, status)
      call ESMF_FieldBundleGet(bundle, fieldCount=n_members, rc=status)
      @assertEqual(0, status)
      @assertTrue(vector_created)
      @assertTrue(bundle_type == MAPL_FIELDBUNDLETYPE_VECTOR)
      @assertTrue(alloc_status == MAPL_STATEITEM_ALLOCATION_CREATED)
      @assertTrue(basis == MAPL_VECTOR_BASIS_KIND_GRID)
      @assertEqual(0, n_members)

      call make_bundle_export(graph, bracket_id, MAPL_STATEITEM_BRACKET, &
           status, bracket_size=2)
      @assertEqual(0, status)
      call create_bundle_extension(graph, bracket_id, 'b', rc=status)
      @assertEqual(0, status)
      bracket_created = field_extension_is_created(graph, bracket_id)
      call bundle_of(graph, bracket_id, bundle)
      call MAPL_FieldBundleGet(bundle, fieldBundleType=bundle_type, &
           allocation_status=alloc_status, bracket_updated=updated, rc=status)
      @assertEqual(0, status)
      call ESMF_FieldBundleGet(bundle, fieldCount=n_members, rc=status)
      @assertEqual(0, status)
      @assertTrue(bracket_created)
      @assertTrue(bundle_type == MAPL_FIELDBUNDLETYPE_BRACKET)
      @assertTrue(alloc_status == MAPL_STATEITEM_ALLOCATION_CREATED)
      @assertTrue(updated)
      @assertEqual(0, n_members)
   end subroutine test_created_bundle_export_is_memberless_and_created

   ! A node declared FIELD gets no bundle from create_bundle_extension, and a
   ! second call leaves the same bundle.
   @test
   subroutine test_create_bundle_extension_only_for_bundle_classes()
      type(ComponentGraph), target :: graph
      type(NodeId) :: field_id, vector_id
      type(ESMF_FieldBundle) :: first, second
      type(GraphStateItem), pointer :: payload
      class(GraphNode), pointer :: node
      type(ESMF_StateItem_Flag) :: kind_flag
      logical :: same_bundle
      integer :: status

      call make_bundle_export(graph, field_id, MAPL_STATEITEM_FIELD, status)
      @assertEqual(0, status)
      call create_bundle_extension(graph, field_id, 'f', rc=status)
      @assertEqual(0, status)
      node => graph%get_node(field_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
         kind_flag = payload%itemType(rc=status)
      end select
      @assertEqual(0, status)
      @assertTrue(kind_flag == ESMF_STATEITEM_NOTFOUND)

      call make_bundle_export(graph, vector_id, MAPL_STATEITEM_VECTOR, status)
      @assertEqual(0, status)
      call create_bundle_extension(graph, vector_id, 'uv', rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, vector_id, first)
      call create_bundle_extension(graph, vector_id, 'uv', rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, vector_id, second)
      same_bundle = MAPL_FieldBundlesAreAliased(first, second, rc=status)
      @assertEqual(0, status)
      @assertTrue(same_bundle)
   end subroutine test_create_bundle_extension_only_for_bundle_classes

   ! Materializing a created VECTOR export completes the same bundle in
   ! place: ALLOCATED, two complete members on the item geom named for the
   ! two components, with the units, typekind and fill value of the
   ! descriptor, and the declared basis kept.
   @test
   subroutine test_vector_export_completed_in_place_with_two_members()
      type(ComponentGraph), target :: graph
      type(NodeId) :: node_id
      type(ESMF_FieldBundle) :: created, completed
      type(ESMF_Field), allocatable :: members(:)
      type(MAPL_FieldBundleType_Flag) :: bundle_type
      type(MAPL_StateItemAllocation) :: alloc_status
      type(MAPL_VectorBasisKind) :: basis
      type(ESMF_FieldStatus_Flag) :: fstatus
      type(ESMF_TypeKind_Flag) :: got_typekind
      type(ESMF_Geom), allocatable :: got_geom
      character(:), allocatable :: units_1, units_2, name_1, name_2
      real(kind=ESMF_KIND_R4), pointer :: x(:)
      logical :: same_bundle, still_created, geom_1, geom_2
      real :: value_1
      integer :: n_members, status

      call make_bundle_export(graph, node_id, MAPL_STATEITEM_VECTOR, status, &
           fill=3.0, names=['eastward wind ', 'northward wind'], &
           basis=MAPL_VECTOR_BASIS_KIND_GRID)
      @assertEqual(0, status)
      call create_bundle_extension(graph, node_id, 'uv', rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, node_id, created)

      call materialize_field_extension(graph, node_id, name='uv', &
           with_members=.true., rc=status)
      @assertEqual(0, status)
      still_created = field_extension_is_created(graph, node_id)
      call bundle_of(graph, node_id, completed)
      same_bundle = MAPL_FieldBundlesAreAliased(created, completed, rc=status)
      @assertEqual(0, status)
      @assertTrue(same_bundle)
      @assertFalse(still_created)

      call MAPL_FieldBundleGet(completed, fieldBundleType=bundle_type, &
           allocation_status=alloc_status, vector_basis_kind=basis, &
           fieldList=members, geom=got_geom, rc=status)
      @assertEqual(0, status)
      n_members = size(members)
      @assertTrue(bundle_type == MAPL_FIELDBUNDLETYPE_VECTOR)
      @assertTrue(alloc_status == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertTrue(basis == MAPL_VECTOR_BASIS_KIND_GRID)
      @assertEqual(2, n_members)
      @assertTrue(allocated(got_geom))

      call ESMF_FieldGet(members(1), status=fstatus, rc=status)
      @assertEqual(0, status)
      @assertTrue(fstatus == ESMF_FIELDSTATUS_COMPLETE)
      call ESMF_FieldGet(members(2), status=fstatus, rc=status)
      @assertEqual(0, status)
      @assertTrue(fstatus == ESMF_FIELDSTATUS_COMPLETE)
      call MAPL_FieldGet(members(1), units=units_1, standard_name=name_1, &
           typekind=got_typekind, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R4)
      call MAPL_FieldGet(members(2), units=units_2, standard_name=name_2, &
           rc=status)
      @assertEqual(0, status)
      @assertEqual('m s-1', units_1)
      @assertEqual('m s-1', units_2)
      @assertEqual('eastward wind', name_1)
      @assertEqual('northward wind', name_2)
      call assign_fptr(members(1), x, rc=status)
      @assertEqual(0, status)
      value_1 = x(1)
      @assertEqual(3.0, value_1, tolerance=1.0e-6)
      call assign_fptr(members(2), x, rc=status)
      @assertEqual(0, status)
      value_1 = x(1)
      @assertEqual(3.0, value_1, tolerance=1.0e-6)
      call MAPL_FieldGet(members(1), geom=got_geom, rc=status)
      @assertEqual(0, status)
      geom_1 = allocated(got_geom)
      call MAPL_FieldGet(members(2), geom=got_geom, rc=status)
      @assertEqual(0, status)
      geom_2 = allocated(got_geom)
      @assertTrue(geom_1)
      @assertTrue(geom_2)
   end subroutine test_vector_export_completed_in_place_with_two_members

   ! A vector without a declared basis defaults to NS, as legacy does.
   @test
   subroutine test_vector_export_defaults_basis_to_ns()
      type(ComponentGraph), target :: graph
      type(NodeId) :: node_id
      type(ESMF_FieldBundle) :: bundle
      type(MAPL_VectorBasisKind) :: basis
      integer :: status

      call make_bundle_export(graph, node_id, MAPL_STATEITEM_VECTOR, status)
      @assertEqual(0, status)
      call create_bundle_extension(graph, node_id, 'uv', rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, node_id, bundle)
      call MAPL_FieldBundleGet(bundle, vector_basis_kind=basis, rc=status)
      @assertEqual(0, status)
      @assertTrue(basis == MAPL_VECTOR_BASIS_KIND_NS)
   end subroutine test_vector_export_defaults_basis_to_ns

   ! Materializing a created BRACKET export gives bracket_size members (2),
   ! each complete with the fill value, in the same bundle; bracket_updated
   ! stays set.
   @test
   subroutine test_bracket_export_completed_with_bracket_size_members()
      type(ComponentGraph), target :: graph
      type(NodeId) :: node_id
      type(ESMF_FieldBundle) :: created, completed
      type(ESMF_Field), allocatable :: members(:)
      type(MAPL_FieldBundleType_Flag) :: bundle_type
      type(MAPL_StateItemAllocation) :: alloc_status
      type(ESMF_FieldStatus_Flag) :: fstatus
      real(kind=ESMF_KIND_R4), pointer :: x(:)
      logical :: same_bundle, updated
      real :: value_2
      integer :: n_members, status

      call make_bundle_export(graph, node_id, MAPL_STATEITEM_BRACKET, status, &
           bracket_size=2, fill=5.0)
      @assertEqual(0, status)
      call create_bundle_extension(graph, node_id, 'b', rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, node_id, created)
      call materialize_field_extension(graph, node_id, name='b', &
           with_members=.true., rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, node_id, completed)
      same_bundle = MAPL_FieldBundlesAreAliased(created, completed, rc=status)
      @assertEqual(0, status)
      @assertTrue(same_bundle)

      call MAPL_FieldBundleGet(completed, fieldBundleType=bundle_type, &
           allocation_status=alloc_status, bracket_updated=updated, &
           fieldList=members, rc=status)
      @assertEqual(0, status)
      n_members = size(members)
      @assertTrue(bundle_type == MAPL_FIELDBUNDLETYPE_BRACKET)
      @assertTrue(alloc_status == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertTrue(updated)
      @assertEqual(2, n_members)
      call ESMF_FieldGet(members(2), status=fstatus, rc=status)
      @assertEqual(0, status)
      @assertTrue(fstatus == ESMF_FIELDSTATUS_COMPLETE)
      call assign_fptr(members(2), x, rc=status)
      @assertEqual(0, status)
      value_2 = x(1)
      @assertEqual(5.0, value_2, tolerance=1.0e-6)
   end subroutine test_bracket_export_completed_with_bracket_size_members

   ! bracket_size 1 gives one member.
   @test
   subroutine test_bracket_export_of_size_one_has_one_member()
      type(ComponentGraph), target :: graph
      type(NodeId) :: node_id
      type(ESMF_FieldBundle) :: bundle
      integer :: n_members, status

      call make_bundle_export(graph, node_id, MAPL_STATEITEM_BRACKET, status, &
           bracket_size=1)
      @assertEqual(0, status)
      call materialize_field_extension(graph, node_id, name='b', &
           with_members=.true., rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, node_id, bundle)
      call ESMF_FieldBundleGet(bundle, fieldCount=n_members, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, n_members)
   end subroutine test_bracket_export_of_size_one_has_one_member

   ! A BRACKET export without bracket_size cannot be given members: legacy
   ! leaves the size undefined, the graph fails with a message.
   @test
   subroutine test_bracket_export_without_size_fails()
      type(ComponentGraph), target :: graph
      type(NodeId) :: node_id
      integer :: status

      call make_bundle_export(graph, node_id, MAPL_STATEITEM_BRACKET, status)
      @assertEqual(0, status)
      call materialize_field_extension(graph, node_id, name='b', &
           with_members=.true., rc=status)
      @assertTrue(status /= 0)
   end subroutine test_bracket_export_without_size_fails

   ! A BRACKET holds at most two fields, as in legacy.
   @test
   subroutine test_bracket_export_larger_than_two_fails()
      type(ComponentGraph), target :: graph
      type(NodeId) :: node_id
      integer :: status

      call make_bundle_export(graph, node_id, MAPL_STATEITEM_BRACKET, status, &
           bracket_size=3)
      @assertEqual(0, status)
      call materialize_field_extension(graph, node_id, name='b', &
           with_members=.true., rc=status)
      @assertTrue(status /= 0)
   end subroutine test_bracket_export_larger_than_two_fails

   ! Without with_members (a chain link) a created bundle is completed and
   ! allocated but stays memberless, even for a bracket with no size.
   @test
   subroutine test_created_bundle_without_members_flag_stays_memberless()
      type(ComponentGraph), target :: graph
      type(NodeId) :: node_id
      type(ESMF_FieldBundle) :: bundle
      type(MAPL_StateItemAllocation) :: alloc_status
      integer :: n_members, status

      call make_bundle_export(graph, node_id, MAPL_STATEITEM_BRACKET, status)
      @assertEqual(0, status)
      call create_bundle_extension(graph, node_id, 'b', rc=status)
      @assertEqual(0, status)
      call materialize_field_extension(graph, node_id, name='b', rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, node_id, bundle)
      call MAPL_FieldBundleGet(bundle, allocation_status=alloc_status, rc=status)
      @assertEqual(0, status)
      call ESMF_FieldBundleGet(bundle, fieldCount=n_members, rc=status)
      @assertEqual(0, status)
      @assertTrue(alloc_status == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertEqual(0, n_members)
   end subroutine test_created_bundle_without_members_flag_stays_memberless

   ! A completed export bundle is not rebuilt or given members twice.
   @test
   subroutine test_completed_export_bundle_is_not_completed_again()
      type(ComponentGraph), target :: graph
      type(NodeId) :: node_id
      type(ESMF_FieldBundle) :: bundle
      integer :: n_members, status

      call make_bundle_export(graph, node_id, MAPL_STATEITEM_VECTOR, status)
      @assertEqual(0, status)
      call create_bundle_extension(graph, node_id, 'uv', rc=status)
      @assertEqual(0, status)
      call materialize_field_extension(graph, node_id, name='uv', &
           with_members=.true., rc=status)
      @assertEqual(0, status)
      call materialize_field_extension(graph, node_id, name='uv', &
           with_members=.true., rc=status)
      @assertEqual(0, status)
      call bundle_of(graph, node_id, bundle)
      call ESMF_FieldBundleGet(bundle, fieldCount=n_members, rc=status)
      @assertEqual(0, status)
      @assertEqual(2, n_members)
   end subroutine test_completed_export_bundle_is_not_completed_again

end module Test_ExtensionMaterialization
