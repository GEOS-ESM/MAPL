      geom = GeometryCharacteristic(geom_id='1')

      @assertEqual('geom=1', geom%get_signature())
   end subroutine test_geometry_get_signature

   ! --- openspec/changes/phase-7a-shape-dispatch-wiring, task 7:
   ! ItemShapeCharacteristic (design.md D1-D3) ---

   @test
   subroutine test_item_shape_is_a_value_characteristic()
      class(ValueCharacteristic), allocatable :: v

      allocate(v, source=ItemShapeCharacteristic(MAPL_STATEITEM_FIELD))
      @assertTrue(v%get_kind() == ITEM_SHAPE_CHARACTERISTIC_KIND)
   end subroutine test_item_shape_is_a_value_characteristic

   @test
   subroutine test_item_shape_matching_field_does_not_need_extension()
      type(ItemShapeCharacteristic) :: a, same_as_a

      a = ItemShapeCharacteristic(MAPL_STATEITEM_FIELD)
      same_as_a = ItemShapeCharacteristic(MAPL_STATEITEM_FIELD)

      @assertFalse(a%needs_extension_for(same_as_a))
   end subroutine test_item_shape_matching_field_does_not_need_extension

   @test
   subroutine test_item_shape_bracket_vs_field_needs_extension()
      type(ItemShapeCharacteristic) :: bracket, field

      bracket = ItemShapeCharacteristic(MAPL_STATEITEM_BRACKET)
      field = ItemShapeCharacteristic(MAPL_STATEITEM_FIELD)

      @assertTrue(bracket%needs_extension_for(field))
   end subroutine test_item_shape_bracket_vs_field_needs_extension

   ! Mismatch correctly detected even though no Transform exists for
   ! this particular pairing (design.md Non-Goals).
   @test
   subroutine test_item_shape_vectorbracket_vs_vector_needs_extension()
      type(ItemShapeCharacteristic) :: vectorbracket, vector

      vectorbracket = ItemShapeCharacteristic(MAPL_STATEITEM_VECTORBRACKET)
      vector = ItemShapeCharacteristic(MAPL_STATEITEM_VECTOR)

      @assertTrue(vectorbracket%needs_extension_for(vector))
   end subroutine test_item_shape_vectorbracket_vs_vector_needs_extension

   @test
   subroutine test_item_shape_build_transform_bracket_to_field_succeeds()
      type(ItemShapeCharacteristic) :: bracket, field
      class(TransformBase), allocatable :: transformer
      integer :: status

      bracket = ItemShapeCharacteristic(MAPL_STATEITEM_BRACKET)
      field = ItemShapeCharacteristic(MAPL_STATEITEM_FIELD)

      call bracket%build_transform(field, transformer, rc=status)

      @assertEqual(0, status)
      @assertTrue(allocated(transformer))
      select type (transformer)
      type is (BracketTimeInterpolationTransform)
         ! expected concrete type
      class default
         @assertTrue(.false.)
      end select
   end subroutine test_item_shape_build_transform_bracket_to_field_succeeds

   ! Matrix cells that need no step.
   @test
   subroutine test_item_shape_matching_cells()
      @assertFalse(needs_extension(S_FIELD, S_WILDCARD))
      @assertFalse(needs_extension(S_BUNDLE, S_BUNDLE))
      @assertFalse(needs_extension(S_BUNDLE, S_WILDCARD))
      @assertFalse(needs_extension(S_STATE, S_STATE))
      @assertFalse(needs_extension(S_STATE, S_WILDCARD))
      @assertFalse(needs_extension(S_VECTOR, S_VECTOR))
      @assertFalse(needs_extension(S_SERVICE, S_SERVICE))
      @assertFalse(needs_extension(S_EXPRESSION, S_FIELD))
   end subroutine test_item_shape_matching_cells

   ! VECTORBRACKET -> VECTOR has no time-interpolation step yet.
   @test
   subroutine test_item_shape_vectorbracket_reports_unsupported()
      class(TransformBase), allocatable :: transformer
      integer :: status
      type(ItemShapeCharacteristic) :: vectorbracket

      vectorbracket = shape_of(S_VECTORBRACKET)
      call vectorbracket%build_transform(shape_of(S_VECTOR), transformer, &
           rc=status)
      @assertEqual(BUILD_TRANSFORM_UNSUPPORTED, status)
      @assertFalse(allocated(transformer))
   end subroutine test_item_shape_vectorbracket_reports_unsupported

   ! Pairs that can never connect: each needs extension and reports
   ! incompatible.
   @test
   subroutine test_item_shape_error_cells_report_incompatible()
      call check_incompatible(S_FIELD, S_BUNDLE)
      call check_incompatible(S_FIELD, S_STATE)
      call check_incompatible(S_FIELD, S_VECTOR)
      call check_incompatible(S_BRACKET, S_BUNDLE)
      call check_incompatible(S_BRACKET, S_WILDCARD)
      call check_incompatible(S_EXPRESSION, S_STATE)
      call check_incompatible(S_EXPRESSION, S_WILDCARD)
      call check_incompatible(S_BUNDLE, S_FIELD)
      call check_incompatible(S_STATE, S_BUNDLE)
      call check_incompatible(S_VECTOR, S_FIELD)
      call check_incompatible(S_VECTOR, S_WILDCARD)
      call check_incompatible(S_SERVICE, S_FIELD)
      call check_incompatible(S_SERVICE, S_WILDCARD)
      call check_incompatible(S_VECTORBRACKET, S_VECTORBRACKET)
      call check_incompatible(S_VECTORBRACKET, S_FIELD)
      call check_incompatible(S_VECTORBRACKET, S_WILDCARD)
   end subroutine test_item_shape_error_cells_report_incompatible

   subroutine check_incompatible(export_class, import_class)
      type(ESMF_StateItem_Flag), intent(in) :: export_class, import_class

      type(ItemShapeCharacteristic) :: export_shape
      class(TransformBase), allocatable :: transformer
      integer :: status

      export_shape = shape_of(export_class)
      @assertTrue(export_shape%needs_extension_for(shape_of(import_class)))
      call export_shape%build_transform(shape_of(import_class), transformer, &
           rc=status)
      @assertEqual(BUILD_TRANSFORM_INCOMPATIBLE, status)
      @assertFalse(allocated(transformer))
   end subroutine check_incompatible

   function shape_of(item_class) result(item_shape)
      type(ESMF_StateItem_Flag), intent(in) :: item_class
      type(ItemShapeCharacteristic) :: item_shape

      item_shape = ItemShapeCharacteristic(item_class)
   end function shape_of

   logical function needs_extension(export_class, import_class)
      type(ESMF_StateItem_Flag), intent(in) :: export_class, import_class

      type(ItemShapeCharacteristic) :: export_shape

      export_shape = shape_of(export_class)
      needs_extension = &
           export_shape%needs_extension_for(shape_of(import_class))
   end function needs_extension

   ! --- get_extension_order: one golden list per shape ---

   @test
   subroutine test_extension_order_field()
      call check_order(shape_of(S_FIELD), [character(len=24) :: &
           'ITEM_SHAPE', 'ATTRIBUTES', 'UNGRIDDED_DIMS', 'QUANTITY_TYPE', &
           'CONSERVATION', 'HORIZONTAL_DIMS_SPEC', 'GEOMETRY', &
           'VERTICAL_GRID', 'VERTICAL_STAGGER', 'VERTICAL_ORIENTATION', &
           'NORMALIZATION', 'PHYSICAL_UNITS', 'STANDARD_NAME', 'TYPE_KIND'])
   end subroutine test_extension_order_field

   @test
   subroutine test_extension_order_fieldbundle()
      call check_order(shape_of(S_BUNDLE), [character(len=24) :: &
           'ITEM_SHAPE', 'ATTRIBUTES', 'UNGRIDDED_DIMS', 'QUANTITY_TYPE', &
           'CONSERVATION', 'HORIZONTAL_DIMS_SPEC', 'GEOMETRY', &
           'VERTICAL_GRID', 'VERTICAL_STAGGER', 'VERTICAL_ORIENTATION', &
           'NORMALIZATION', 'PHYSICAL_UNITS', 'TYPE_KIND'])
   end subroutine test_extension_order_fieldbundle

   @test
   subroutine test_extension_order_vector()
      call check_order(shape_of(S_VECTOR), [character(len=24) :: &
           'ITEM_SHAPE', 'ATTRIBUTES', 'UNGRIDDED_DIMS', 'QUANTITY_TYPE', &
           'CONSERVATION', 'HORIZONTAL_DIMS_SPEC', 'GEOMETRY', &
           'VERTICAL_GRID', 'VERTICAL_STAGGER', 'VERTICAL_ORIENTATION', &
           'NORMALIZATION', 'PHYSICAL_UNITS', 'TYPE_KIND'])
   end subroutine test_extension_order_vector

   @test
   subroutine test_extension_order_bracket()
      call check_order(shape_of(S_BRACKET), [character(len=24) :: &
           'ATTRIBUTES', 'UNGRIDDED_DIMS', 'QUANTITY_TYPE', &
           'HORIZONTAL_DIMS_SPEC', 'GEOMETRY', 'ITEM_SHAPE'])
   end subroutine test_extension_order_bracket

   @test
   subroutine test_extension_order_vectorbracket()
      call check_order(shape_of(S_VECTORBRACKET), [character(len=24) :: &
           'ATTRIBUTES', 'UNGRIDDED_DIMS', 'QUANTITY_TYPE', &
           'HORIZONTAL_DIMS_SPEC', 'GEOMETRY', 'ITEM_SHAPE'])
   end subroutine test_extension_order_vectorbracket

   @test
   subroutine test_extension_order_expression()
      call check_order(shape_of(S_EXPRESSION), [character(len=24) :: &
           'GEOMETRY', 'VERTICAL_GRID', 'VERTICAL_STAGGER', &
           'VERTICAL_ORIENTATION', 'TYPE_KIND', 'ITEM_SHAPE'])
   end subroutine test_extension_order_expression

   @test
   subroutine test_extension_order_service()
      call check_order(shape_of(S_SERVICE), &
           [character(len=24) :: &
           'ITEM_SHAPE', 'GEOMETRY'])
   end subroutine test_extension_order_service

   @test
   subroutine test_extension_order_state()
      character(len=24), allocatable :: empty(:)

      allocate(empty(0))
      call check_order(shape_of(S_STATE), empty)
   end subroutine test_extension_order_state

   @test
   subroutine test_extension_order_wildcard()
      character(len=24), allocatable :: empty(:)

      allocate(empty(0))
      call check_order(shape_of(S_WILDCARD), empty)
   end subroutine test_extension_order_wildcard

   @test
   subroutine test_extension_order_geom_variant()
      call check_order(ItemShapeCharacteristic(S_FIELD, VARIANT_GEOM), &
           [character(len=24) :: &
           'GEOMETRY'])
   end subroutine test_extension_order_geom_variant

   @test
   subroutine test_extension_order_verticalgrid_variant()
      call check_order(ItemShapeCharacteristic(S_STATE, VARIANT_VERTICALGRID), &
           [character(len=24) :: &
           'VERTICAL_GRID'])
   end subroutine test_extension_order_verticalgrid_variant

   subroutine check_order(item_shape, expected)
      type(ItemShapeCharacteristic), intent(in) :: item_shape
      character(len=*), intent(in) :: expected(:)

      type(StateItemCharacteristicMap) :: goal
      type(StateItemCharacteristicKind), allocatable :: order(:)
      integer :: status, i

      order = item_shape%get_extension_order(goal, rc=status)
      @assertEqual(0, status)
      @assertEqual(size(expected), size(order))
      if (size(expected) /= size(order)) return
      do i = 1, size(order)
         @assertEqual(trim(expected(i)), order(i)%to_string())
      end do
   end subroutine check_order

   subroutine use_validation(content)
      character(*), intent(in) :: content
      type(ESMF_HConfig) :: node

      node = ESMF_HConfigCreate(content=content)
      call set_field_dictionary_config(FieldDictionaryConfig(node))
      call ESMF_HConfigDestroy(node)
   end subroutine use_validation

end module Test_StateItemCharacteristicSubclasses
