! openspec/changes/state-item-characteristic-subclasses, tasks 2.3/3.5/4.3/
! 5.3/6.3: the seven new concrete StateItemCharacteristic subclasses -
! correct Value/Reference classification, correct get_kind(), and
! needs_extension_for() comparison semantics (design.md D1-D5).
!
! build_transform/get_signature coverage - incompatible for five of the six
! subclasses with no Transform (Attributes, UngriddedDims, QuantityType,
! Conservation, Normalization), incompatible for StandardName in strict
! validation mode (permissive mode tolerates a mismatch), and the four real, moved
! implementations (PhysicalUnitsCharacteristic/TypeKindCharacteristic/
! VerticalGridCharacteristic/GeometryCharacteristic) producing the
! same outcomes Test_Characteristic.pf/Test_GeomCharacteristic.pf
! already asserted (ported, not just a smoke test).
module Test_StateItemCharacteristicSubclasses
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristic, ValueCharacteristic, &
                                                ReferenceCharacteristic, &
                                                BUILD_TRANSFORM_UNSUPPORTED, BUILD_TRANSFORM_INCOMPATIBLE
   use mapl_StateItemCharacteristicKind_mod, only: operator(==), &
                                                    VERTICAL_GRID_CHARACTERISTIC_KIND, &
                                                    ATTRIBUTES_CHARACTERISTIC_KIND, &
                                                    UNGRIDDED_DIMS_CHARACTERISTIC_KIND, &
                                                    QUANTITY_TYPE_CHARACTERISTIC_KIND, &
                                                    CONSERVATION_CHARACTERISTIC_KIND, &
                                                    NORMALIZATION_CHARACTERISTIC_KIND, &
                                                    STANDARD_NAME_CHARACTERISTIC_KIND, &
                                                    ITEM_SHAPE_CHARACTERISTIC_KIND, &
                                                    VERTICAL_STAGGER_CHARACTERISTIC_KIND, &
                                                    VERTICAL_ORIENTATION_CHARACTERISTIC_KIND, &
        HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, &
        LONG_NAME_CHARACTERISTIC_KIND, &
        RESTART_MODE_CHARACTERISTIC_KIND, &
        EXPRESSION_CHARACTERISTIC_KIND
   use mapl_NodeId_mod, only: NodeId, NodeIdGenerator, operator(==)
   use mapl_TransformBase_mod, only: TransformBase

   use mapl_VerticalGridCharacteristic_mod, only: VerticalGridCharacteristic
   use mapl_AttributesCharacteristic_mod, only: AttributesCharacteristic
   use mapl_UngriddedDimsCharacteristic_mod, only: UngriddedDimsCharacteristic
   use mapl_VerticalStaggerCharacteristic_mod, only: VerticalStaggerCharacteristic
   use mapl_VerticalStaggerLoc_mod, only: VerticalStaggerLoc, VERTICAL_STAGGER_NONE, VERTICAL_STAGGER_CENTER, &
        VERTICAL_STAGGER_EDGE, VERTICAL_STAGGER_MIRROR
   use mapl_VerticalOrientationCharacteristic_mod, only: VerticalOrientationCharacteristic
   use mapl_HorizontalDimsSpecCharacteristic_mod, only: HorizontalDimsSpecCharacteristic
   use mapl_CharacteristicStatus_mod, only: CHARACTERISTIC_STATUS_MIRRORED, &
        CHARACTERISTIC_STATUS_DEFERRED, CHARACTERISTIC_STATUS_SPECIFIED, &
        CHARACTERISTIC_STATUS_UNCHECKED, operator(==)
   use mapl_CharacteristicDefaults_mod, only: CharacteristicDefaults
   use mapl_HorizontalDimsSpec_mod, only: HorizontalDimsSpec, HORIZONTAL_DIMS_GEOM, HORIZONTAL_DIMS_NONE, &
        HORIZONTAL_DIMS_MIRROR, operator(==)
   use mapl_VerticalCoordinateDirection_mod, only: VerticalCoordinateDirection, VCOORD_DIRECTION_UP, &
        VCOORD_DIRECTION_DOWN, operator(==)
   use mapl_QuantityTypeCharacteristic_mod, only: QuantityTypeCharacteristic
   use mapl_ConservationCharacteristic_mod, only: ConservationCharacteristic
   use mapl_NormalizationCharacteristic_mod, only: NormalizationCharacteristic
   use mapl_StandardNameCharacteristic_mod, only: StandardNameCharacteristic
   use mapl_LongNameCharacteristic_mod, only: LongNameCharacteristic
   use mapl_RestartModeCharacteristic_mod, only: RestartModeCharacteristic
   use mapl_RestartModes_mod, only: RestartMode, RESTART_REQUIRED, RESTART_SKIP, operator(==)
   use mapl_ExpressionCharacteristic_mod, only: ExpressionCharacteristic
   use mapl_PhysicalUnitsCharacteristic_mod, only: PhysicalUnitsCharacteristic
   use mapl_TypeKindCharacteristic_mod, only: TypeKindCharacteristic
   use mapl_GeometryCharacteristic_mod, only: GeometryCharacteristic
   ! openspec/changes/phase-7a-shape-dispatch-wiring
   use mapl_ItemShapeCharacteristic_mod, only: ItemShapeCharacteristic
   use mapl_BracketTimeInterpolationTransform_mod, only: BracketTimeInterpolationTransform
   use mapl_StateItem_mod, only: MAPL_STATEITEM_FIELD, &
        MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
        MAPL_STATEITEM_VECTORBRACKET
   use mapl_StateItem_mod, only: S_FIELD => MAPL_STATEITEM_FIELD, &
        S_BUNDLE => MAPL_STATEITEM_FIELDBUNDLE, &
        S_STATE => MAPL_STATEITEM_STATE, &
        S_SERVICE => MAPL_STATEITEM_SERVICE, &
        S_WILDCARD => MAPL_STATEITEM_WILDCARD, &
        S_BRACKET => MAPL_STATEITEM_BRACKET, &
        S_VECTOR => MAPL_STATEITEM_VECTOR, &
        S_VECTORBRACKET => MAPL_STATEITEM_VECTORBRACKET, &
        S_EXPRESSION => MAPL_STATEITEM_EXPRESSION
   use mapl_StateItemFlag_mod, only: VARIANT_GEOM => MAPL_STATEITEM_GEOM, &
        VARIANT_VERTICALGRID => MAPL_STATEITEM_VERTICALGRID
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristicMap
   use mapl_StateItemCharacteristicKind_mod, only: StateItemCharacteristicKind
   use ESMF, only: ESMF_StateItem_Flag, ESMF_HConfig, ESMF_HConfigCreate, ESMF_HConfigDestroy
   use mapl_FieldDictionaryConfig_mod, only: FieldDictionaryConfig, set_field_dictionary_config, &
        get_field_dictionary_config

   use mapl_UngriddedDims_mod, only: UngriddedDims
   use mapl_QuantityType_mod, only: QUANTITY_MIXING_RATIO, QUANTITY_TEMPERATURE, QUANTITY_UNKNOWN, &
                                     BASIS_WET_MASS, BASIS_DRY_MASS, BASIS_NONE, operator(==)
   use mapl_ConservationMetadata_mod, only: ConservationMetadata, new_ConservationMetadata_mirror
   use mapl_ConservationType_mod, only: CONSERVE_MASS, CONSERVE_ENERGY
   use mapl_NormalizationMetadata_mod, only: NormalizationMetadata
   use mapl_NormalizationType_mod, only: NORMALIZE_DELP, NORMALIZE_DZ

   use gFTL2_StringVector, only: StringVector

   use funit
   implicit none

contains

   ! --- 2.3: VerticalGridCharacteristic (ReferenceCharacteristic) ---

   @test
   subroutine test_vertical_grid_is_a_reference_characteristic()
      class(ReferenceCharacteristic), allocatable :: r
      type(NodeIdGenerator) :: gen
      type(NodeId) :: id

      id = gen%next()
      allocate(r, source=VerticalGridCharacteristic(id))

      @assertTrue(r%get_kind() == VERTICAL_GRID_CHARACTERISTIC_KIND)
      @assertTrue(r%get_referenced_node_id() == id)
   end subroutine test_vertical_grid_is_a_reference_characteristic

   @test
   subroutine test_vcoord_needs_extension_compares_node_id()
      type(VerticalGridCharacteristic) :: a, same_as_a, b
      type(NodeIdGenerator) :: gen
      type(NodeId) :: id_a, id_b

      id_a = gen%next()
      id_b = gen%next()
      a = VerticalGridCharacteristic(id_a)
      same_as_a = VerticalGridCharacteristic(id_a)
      b = VerticalGridCharacteristic(id_b)

      @assertFalse(a%needs_extension_for(same_as_a))
      @assertTrue(a%needs_extension_for(b))
   end subroutine test_vcoord_needs_extension_compares_node_id

   ! --- 3.5: UngriddedDimsCharacteristic ---

   @test
   subroutine test_ungridded_dims_is_a_value_characteristic()
      class(ValueCharacteristic), allocatable :: v

      allocate(v, source=UngriddedDimsCharacteristic(UngriddedDims([5])))
      @assertTrue(v%get_kind() == UNGRIDDED_DIMS_CHARACTERISTIC_KIND)
   end subroutine test_ungridded_dims_is_a_value_characteristic

   @test
   subroutine test_ungridded_dims_needs_extension_for()
      type(UngriddedDimsCharacteristic) :: a, same_as_a, b

      a = UngriddedDimsCharacteristic(UngriddedDims([5]))
      same_as_a = UngriddedDimsCharacteristic(UngriddedDims([5]))
      b = UngriddedDimsCharacteristic(UngriddedDims([3]))

      @assertFalse(a%needs_extension_for(same_as_a))
      @assertTrue(a%needs_extension_for(b))
   end subroutine test_ungridded_dims_needs_extension_for

   ! --- VerticalStaggerCharacteristic ---

   @test
   subroutine test_vertical_stagger_is_a_structural_value_characteristic()
      class(ValueCharacteristic), allocatable :: v

      allocate(v, source=VerticalStaggerCharacteristic(VERTICAL_STAGGER_CENTER))
      @assertTrue(v%get_kind() == VERTICAL_STAGGER_CHARACTERISTIC_KIND)
      @assertTrue(v%is_structural())
   end subroutine test_vertical_stagger_is_a_structural_value_characteristic

   @test
   subroutine test_vertical_stagger_needs_extension_for()
      type(VerticalStaggerCharacteristic) :: center, same_as_center, edge, none

      center = VerticalStaggerCharacteristic(VERTICAL_STAGGER_CENTER)
      same_as_center = VerticalStaggerCharacteristic(VERTICAL_STAGGER_CENTER)
      edge = VerticalStaggerCharacteristic(VERTICAL_STAGGER_EDGE)
      none = VerticalStaggerCharacteristic(VERTICAL_STAGGER_NONE)

      @assertFalse(center%needs_extension_for(same_as_center))
      @assertTrue(center%needs_extension_for(edge))
      @assertTrue(center%needs_extension_for(none))
      @assertTrue(none%needs_extension_for(center))
   end subroutine test_vertical_stagger_needs_extension_for

   ! VerticalStaggerLoc's own == treats MIRROR as a wildcard; the
   ! characteristic must not.
   @test
   subroutine test_vertical_stagger_compare_ignores_mirror_wildcard()
      type(VerticalStaggerCharacteristic) :: center, mirror

      center = VerticalStaggerCharacteristic(VERTICAL_STAGGER_CENTER)
      mirror = VerticalStaggerCharacteristic(VERTICAL_STAGGER_MIRROR)
      @assertTrue(center%needs_extension_for(mirror))
   end subroutine test_vertical_stagger_compare_ignores_mirror_wildcard

   @test
   subroutine test_vertical_stagger_signature_and_getter()
      type(VerticalStaggerCharacteristic) :: edge
      type(VerticalStaggerLoc) :: got

      edge = VerticalStaggerCharacteristic(VERTICAL_STAGGER_EDGE)
      @assertEqual('vertical_stagger=VERTICAL_STAGGER_EDGE', edge%get_signature())
      got = edge%get_vertical_stagger()
      @assertEqual(VERTICAL_STAGGER_EDGE%to_string(), got%to_string())
   end subroutine test_vertical_stagger_signature_and_getter

   @test
   subroutine test_vertical_stagger_build_transform_unsupported()
      type(VerticalStaggerCharacteristic) :: center, edge
      class(TransformBase), allocatable :: transformer
      integer :: status

      center = VerticalStaggerCharacteristic(VERTICAL_STAGGER_CENTER)
      edge = VerticalStaggerCharacteristic(VERTICAL_STAGGER_EDGE)
      call center%build_transform(edge, transformer, rc=status)
      @assertEqual(BUILD_TRANSFORM_UNSUPPORTED, status)
   end subroutine test_vertical_stagger_build_transform_unsupported

   ! --- VerticalOrientationCharacteristic ---

   @test
   subroutine test_vertical_orientation_is_a_structural_value_characteristic()
      class(ValueCharacteristic), allocatable :: v

      allocate(v, source=VerticalOrientationCharacteristic(VCOORD_DIRECTION_UP))
      @assertTrue(v%get_kind() == VERTICAL_ORIENTATION_CHARACTERISTIC_KIND)
      @assertTrue(v%is_structural())
   end subroutine test_vertical_orientation_is_a_structural_value_characteristic

   @test
   subroutine test_vertical_orientation_needs_extension_for()
      type(VerticalOrientationCharacteristic) :: up, same_as_up, down

      up = VerticalOrientationCharacteristic(VCOORD_DIRECTION_UP)
      same_as_up = VerticalOrientationCharacteristic(VCOORD_DIRECTION_UP)
      down = VerticalOrientationCharacteristic(VCOORD_DIRECTION_DOWN)

      @assertFalse(up%needs_extension_for(same_as_up))
      @assertTrue(up%needs_extension_for(down))
      @assertTrue(down%needs_extension_for(up))
   end subroutine test_vertical_orientation_needs_extension_for

   @test
   subroutine test_vertical_orientation_signature_and_getter()
      type(VerticalOrientationCharacteristic) :: down
      type(VerticalCoordinateDirection) :: got

      down = VerticalOrientationCharacteristic(VCOORD_DIRECTION_DOWN)
      @assertEqual('vertical_orientation=downward', down%get_signature())
      got = down%get_direction()
      @assertTrue(got == VCOORD_DIRECTION_DOWN)
   end subroutine test_vertical_orientation_signature_and_getter

   @test
   subroutine test_vertical_orientation_build_transform_unsupported()
      type(VerticalOrientationCharacteristic) :: up, down
      class(TransformBase), allocatable :: transformer
      integer :: status

      up = VerticalOrientationCharacteristic(VCOORD_DIRECTION_UP)
      down = VerticalOrientationCharacteristic(VCOORD_DIRECTION_DOWN)
      call up%build_transform(down, transformer, rc=status)
      @assertEqual(BUILD_TRANSFORM_UNSUPPORTED, status)
   end subroutine test_vertical_orientation_build_transform_unsupported

   ! --- HorizontalDimsSpecCharacteristic ---

   @test
   subroutine test_horizontal_dims_spec_is_a_structural_value_characteristic()
      class(ValueCharacteristic), allocatable :: v

      allocate(v, source=HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM))
      @assertTrue(v%get_kind() == HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND)
      @assertTrue(v%is_structural())
   end subroutine test_horizontal_dims_spec_is_a_structural_value_characteristic

   @test
   subroutine test_horizontal_dims_spec_needs_extension_for()
      type(HorizontalDimsSpecCharacteristic) :: geom, same_as_geom, none

      geom = HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM)
      same_as_geom = HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM)
      none = HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_NONE)

      @assertFalse(geom%needs_extension_for(same_as_geom))
      @assertTrue(geom%needs_extension_for(none))
      @assertTrue(none%needs_extension_for(geom))
   end subroutine test_horizontal_dims_spec_needs_extension_for

   @test
   subroutine test_horizontal_dims_spec_signature_and_getter()
      type(HorizontalDimsSpecCharacteristic) :: none
      type(HorizontalDimsSpec) :: got

      none = HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_NONE)
      @assertEqual('horizontal_dims_spec=HORIZONTAL_DIMS_NONE', none%get_signature())
      got = none%get_horizontal_dims_spec()
      @assertTrue(got == HORIZONTAL_DIMS_NONE)
   end subroutine test_horizontal_dims_spec_signature_and_getter

   @test
   subroutine test_horizontal_dims_spec_build_transform_incompatible()
      type(HorizontalDimsSpecCharacteristic) :: geom, none
      class(TransformBase), allocatable :: transformer
      integer :: status

      geom = HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_GEOM)
      none = HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_NONE)
      call geom%build_transform(none, transformer, rc=status)
      @assertEqual(BUILD_TRANSFORM_INCOMPATIBLE, status)
      @assertFalse(allocated(transformer))
      call none%build_transform(geom, transformer, rc=status)
      @assertEqual(BUILD_TRANSFORM_INCOMPATIBLE, status)
      @assertFalse(allocated(transformer))
   end subroutine test_horizontal_dims_spec_build_transform_incompatible

   ! HORIZONTAL_DIMS_MIRROR is not a value: it becomes MIRRORED status.
   @test
   subroutine test_horizontal_dims_spec_mirror_is_mirrored_without_value()
      type(HorizontalDimsSpecCharacteristic) :: mirrored

      mirrored = HorizontalDimsSpecCharacteristic(HORIZONTAL_DIMS_MIRROR)
      @assertTrue(mirrored%get_status() == CHARACTERISTIC_STATUS_MIRRORED)
   end subroutine test_horizontal_dims_spec_mirror_is_mirrored_without_value

   ! --- ConservationCharacteristic ---

   @test
   subroutine test_conservation_is_a_value_characteristic()
      class(ValueCharacteristic), allocatable :: v

      allocate(v, source=ConservationCharacteristic(ConservationMetadata(CONSERVE_MASS)))
      @assertTrue(v%get_kind() == CONSERVATION_CHARACTERISTIC_KIND)
   end subroutine test_conservation_is_a_value_characteristic

   @test
   subroutine test_conservation_needs_extension_for()
      type(ConservationCharacteristic) :: a, same_as_a, b

      a = ConservationCharacteristic(ConservationMetadata(CONSERVE_MASS))
      same_as_a = ConservationCharacteristic(ConservationMetadata(CONSERVE_MASS))
      b = ConservationCharacteristic(ConservationMetadata(CONSERVE_ENERGY))

      @assertFalse(a%needs_extension_for(same_as_a))
      @assertTrue(a%needs_extension_for(b))
   end subroutine test_conservation_needs_extension_for

   ! The constructor accepts mirror metadata and needs_extension_for relies
   ! on the metadata's own mirror-aware operator(==) (both mirrors compare
   ! equal). The factory never builds this state: it makes a MIRRORED entry
   ! instead.
   @test
   subroutine test_conservation_mirror_instances_do_not_need_extension()
      type(ConservationCharacteristic) :: mirror_a, mirror_b, mass

      mirror_a = ConservationCharacteristic(new_ConservationMetadata_mirror())
      mirror_b = ConservationCharacteristic(new_ConservationMetadata_mirror())
      mass = ConservationCharacteristic(ConservationMetadata(CONSERVE_MASS))

      @assertFalse(mirror_a%needs_extension_for(mirror_b))
      @assertTrue(mirror_a%needs_extension_for(mass))
   end subroutine test_conservation_mirror_instances_do_not_need_extension

   ! --- NormalizationCharacteristic ---

   @test
   subroutine test_normalization_is_a_value_characteristic()
      class(ValueCharacteristic), allocatable :: v

      allocate(v, source=NormalizationCharacteristic(NormalizationMetadata(NORMALIZE_DELP)))
      @assertTrue(v%get_kind() == NORMALIZATION_CHARACTERISTIC_KIND)
   end subroutine test_normalization_is_a_value_characteristic

   @test
   subroutine test_normalization_needs_extension_for()
      type(NormalizationCharacteristic) :: a, same_as_a, b

      a = NormalizationCharacteristic(NormalizationMetadata(NORMALIZE_DELP))
      same_as_a = NormalizationCharacteristic(NormalizationMetadata(NORMALIZE_DELP))
      b = NormalizationCharacteristic(NormalizationMetadata(NORMALIZE_DZ))

      @assertFalse(a%needs_extension_for(same_as_a))
      @assertTrue(a%needs_extension_for(b))
   end subroutine test_normalization_needs_extension_for

   @test
   subroutine test_normalization_mirror_instances_do_not_need_extension()
      type(NormalizationCharacteristic) :: mirror_a, mirror_b, delp

      mirror_a = NormalizationCharacteristic(NormalizationMetadata())
      mirror_b = NormalizationCharacteristic(NormalizationMetadata())
      delp = NormalizationCharacteristic(NormalizationMetadata(NORMALIZE_DELP))

      @assertFalse(mirror_a%needs_extension_for(mirror_b))
      @assertTrue(mirror_a%needs_extension_for(delp))
   end subroutine test_normalization_mirror_instances_do_not_need_extension

   ! --- QuantityTypeCharacteristic ---

   @test
   subroutine test_quantity_type_is_a_value_characteristic()
      class(ValueCharacteristic), allocatable :: v

      allocate(v, source=QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS))
      @assertTrue(v%get_kind() == QUANTITY_TYPE_CHARACTERISTIC_KIND)
   end subroutine test_quantity_type_is_a_value_characteristic

   @test
   subroutine test_quantity_type_matching_does_not_need_extension()
      type(QuantityTypeCharacteristic) :: a, same_as_a

      a = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      same_as_a = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)

      @assertFalse(a%needs_extension_for(same_as_a))
   end subroutine test_quantity_type_matching_does_not_need_extension

   @test
   subroutine test_quantity_type_either_side_unknown_needs_extension()
      type(QuantityTypeCharacteristic) :: known, unknown

      known = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      unknown = QuantityTypeCharacteristic(QUANTITY_UNKNOWN, BASIS_WET_MASS)

      @assertTrue(known%needs_extension_for(unknown))
      @assertTrue(unknown%needs_extension_for(known))
   end subroutine test_quantity_type_either_side_unknown_needs_extension

   @test
   subroutine test_quantity_type_basis_none_no_extension()
      type(QuantityTypeCharacteristic) :: with_basis, no_basis

      with_basis = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      no_basis = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_NONE)

      @assertFalse(with_basis%needs_extension_for(no_basis))
      @assertFalse(no_basis%needs_extension_for(with_basis))
   end subroutine test_quantity_type_basis_none_no_extension

   ! Genuine quantity_type mismatch, neither side UNKNOWN: needs extension.
   @test
   subroutine test_quantity_type_mismatch_needs_extension()
      type(QuantityTypeCharacteristic) :: mixing_ratio, temperature

      mixing_ratio = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_NONE)
      temperature = QuantityTypeCharacteristic(QUANTITY_TEMPERATURE, BASIS_NONE)

      @assertTrue(mixing_ratio%needs_extension_for(temperature))
   end subroutine test_quantity_type_mismatch_needs_extension

   ! Genuine basis mismatch, neither side NONE: needs extension.
   @test
   subroutine test_quantity_type_genuine_basis_mismatch_needs_extension()
      type(QuantityTypeCharacteristic) :: wet_mass, dry_mass

      wet_mass = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      dry_mass = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_DRY_MASS)

      @assertTrue(wet_mass%needs_extension_for(dry_mass))
   end subroutine test_quantity_type_genuine_basis_mismatch_needs_extension

   ! A DEFERRED entry takes the harvested quantity type and basis.
   @test
   subroutine test_quantity_type_deferred_takes_supplied_value()
      type(QuantityTypeCharacteristic) :: c
      type(CharacteristicDefaults) :: defaults
      integer :: status

      c = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      call c%set_status(CHARACTERISTIC_STATUS_DEFERRED)
      call defaults%set_quantity_type(QUANTITY_TEMPERATURE, BASIS_DRY_MASS)

      call c%resolve_deferred(defaults, rc=status)
      @assertEqual(0, status)
      @assertTrue(c%get_status() == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertTrue(c%get_quantity_type() == QUANTITY_TEMPERATURE)
      @assertTrue(c%get_basis() == BASIS_DRY_MASS)
   end subroutine test_quantity_type_deferred_takes_supplied_value

   @test
   subroutine test_quantity_type_deferred_without_value_stays_deferred()
      type(QuantityTypeCharacteristic) :: c
      integer :: status

      c = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      call c%set_status(CHARACTERISTIC_STATUS_DEFERRED)

      call c%resolve_deferred(CharacteristicDefaults(), rc=status)
      @assertEqual(0, status)
      @assertTrue(c%get_status() == CHARACTERISTIC_STATUS_DEFERRED)
      @assertTrue(c%get_quantity_type() == QUANTITY_MIXING_RATIO)
      @assertTrue(c%get_basis() == BASIS_WET_MASS)
   end subroutine test_quantity_type_deferred_without_value_stays_deferred

   ! A SPECIFIED or UNCHECKED entry keeps its value and status; the
   ! descriptor offers the defaults to UNCHECKED ones too.
   @test
   subroutine test_quantity_type_resolve_leaves_specified_and_unchecked()
      type(QuantityTypeCharacteristic) :: specified, unchecked
      type(CharacteristicDefaults) :: defaults
      integer :: status

      specified = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      unchecked = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      call unchecked%set_status(CHARACTERISTIC_STATUS_UNCHECKED)
      call defaults%set_quantity_type(QUANTITY_TEMPERATURE, BASIS_DRY_MASS)

      call specified%resolve_deferred(defaults, rc=status)
      @assertEqual(0, status)
      @assertTrue(specified%get_status() == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertTrue(specified%get_quantity_type() == QUANTITY_MIXING_RATIO)
      @assertTrue(specified%get_basis() == BASIS_WET_MASS)

      call unchecked%resolve_deferred(defaults, rc=status)
      @assertEqual(0, status)
      @assertTrue(unchecked%get_status() == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertTrue(unchecked%get_quantity_type() == QUANTITY_MIXING_RATIO)
      @assertTrue(unchecked%get_basis() == BASIS_WET_MASS)
   end subroutine test_quantity_type_resolve_leaves_specified_and_unchecked

   ! --- 5.3: AttributesCharacteristic (asymmetric) ---

   @test
   subroutine test_attributes_is_a_value_characteristic()
      class(ValueCharacteristic), allocatable :: v
      type(StringVector) :: names

      call names%push_back('units')
      allocate(v, source=AttributesCharacteristic(names))
      @assertTrue(v%get_kind() == ATTRIBUTES_CHARACTERISTIC_KIND)
   end subroutine test_attributes_is_a_value_characteristic

   @test
   subroutine test_attributes_provides_superset_does_not_need_extension()
      type(AttributesCharacteristic) :: provides, requires
      type(StringVector) :: provided_names, required_names

      call provided_names%push_back('units')
      call provided_names%push_back('long_name')
      call provided_names%push_back('standard_name')
      call required_names%push_back('units')
      call required_names%push_back('long_name')

      provides = AttributesCharacteristic(provided_names)
      requires = AttributesCharacteristic(required_names)

      @assertFalse(provides%needs_extension_for(requires))
   end subroutine test_attributes_provides_superset_does_not_need_extension

   @test
   subroutine test_attributes_missing_required_name_needs_extension()
      type(AttributesCharacteristic) :: provides, requires
      type(StringVector) :: provided_names, required_names

      call provided_names%push_back('units')
      call required_names%push_back('units')
      call required_names%push_back('standard_name')

      provides = AttributesCharacteristic(provided_names)
      requires = AttributesCharacteristic(required_names)

      @assertTrue(provides%needs_extension_for(requires))
   end subroutine test_attributes_missing_required_name_needs_extension

   ! Swapping this/goal for the same two non-equal sets produces the
   ! opposite result, making the asymmetry visible (design.md Risks).
   @test
   subroutine test_attributes_needs_extension_for_is_asymmetric()
      type(AttributesCharacteristic) :: larger, smaller
      type(StringVector) :: larger_names, smaller_names

      call larger_names%push_back('units')
      call larger_names%push_back('long_name')
      call smaller_names%push_back('units')

      larger = AttributesCharacteristic(larger_names)
      smaller = AttributesCharacteristic(smaller_names)

      ! larger provides everything smaller requires.
      @assertFalse(larger%needs_extension_for(smaller))
      ! smaller does not provide everything larger requires.
      @assertTrue(smaller%needs_extension_for(larger))
   end subroutine test_attributes_needs_extension_for_is_asymmetric

   ! --- 6.3: StandardNameCharacteristic (value comparison only) ---

   @test
   subroutine test_standard_name_is_a_value_characteristic()
      class(ValueCharacteristic), allocatable :: v

      allocate(v, source=StandardNameCharacteristic('air_temperature'))
      @assertTrue(v%get_kind() == STANDARD_NAME_CHARACTERISTIC_KIND)
   end subroutine test_standard_name_is_a_value_characteristic

   @test
   subroutine test_standard_name_equal_names_do_not_need_extension()
      type(StandardNameCharacteristic) :: a, same_as_a

      a = StandardNameCharacteristic('air_temperature')
      same_as_a = StandardNameCharacteristic('air_temperature')

      @assertFalse(a%needs_extension_for(same_as_a))
   end subroutine test_standard_name_equal_names_do_not_need_extension

   ! Permissive mode tolerates a disagreement (match with a warning); strict
   ! mode does not.
   @test
   subroutine test_standard_name_mismatch_extends_only_when_strict()
      type(StandardNameCharacteristic) :: a, b
      type(FieldDictionaryConfig) :: saved

      a = StandardNameCharacteristic('air_temperature')
      b = StandardNameCharacteristic('surface_pressure')
      saved = get_field_dictionary_config()

      call use_validation('{validation_mode: permissive}')
      @assertFalse(a%needs_extension_for(b))

      call use_validation('{validation_mode: strict}')
      @assertTrue(a%needs_extension_for(b))

      call set_field_dictionary_config(saved)
   end subroutine test_standard_name_mismatch_extends_only_when_strict

   @test
   subroutine test_standard_name_match_warning()
      type(StandardNameCharacteristic) :: a, b, unchecked
      type(FieldDictionaryConfig) :: saved

      a = StandardNameCharacteristic('air_temperature')
      b = StandardNameCharacteristic('surface_pressure')
      call unchecked%set_status(CHARACTERISTIC_STATUS_UNCHECKED)
      saved = get_field_dictionary_config()
      call use_validation('{validation_mode: permissive}')

      @assertEqual('standard_name convention violation (permissive mode): Export declares standard_name "air_temperature" but connected Import declares "surface_pressure". Connecting anyway; the Export value wins.', a%match_warning(b))
      @assertEqual('', a%match_warning(a))
      @assertEqual('standard_name convention: Import declares standard_name "surface_pressure" but the connected Export declares none.', unchecked%match_warning(b))
      @assertEqual('', a%match_warning(unchecked))

      call use_validation('{validation_mode: permissive, suppress_standard_name_warnings: true}')
      @assertEqual('', a%match_warning(b))
      @assertEqual('', unchecked%match_warning(b))

      call set_field_dictionary_config(saved)
   end subroutine test_standard_name_match_warning

