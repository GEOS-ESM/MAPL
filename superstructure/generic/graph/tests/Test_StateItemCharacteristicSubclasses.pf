   ! --- build_transform reports BUILD_TRANSFORM_INCOMPATIBLE for the five
   ! subclasses whose legacy aspect rejects every mismatch of two non-mirror
   ! values and converts nothing (QuantityType: all but a basis-only
   ! mismatch, which is UNSUPPORTED), and for StandardName (reached only in
   ! strict validation mode) ---

   @test
   subroutine test_attributes_build_transform_reports_incompatible()
      type(AttributesCharacteristic) :: a, b
      class(TransformBase), allocatable :: transformer
      integer :: status

      a = AttributesCharacteristic()
      b = AttributesCharacteristic()

      call a%build_transform(b, transformer, rc=status)

      @assertEqual(BUILD_TRANSFORM_INCOMPATIBLE, status)
      @assertFalse(allocated(transformer))
   end subroutine test_attributes_build_transform_reports_incompatible

   @test
   subroutine test_conservation_build_transform_reports_incompatible()
      type(ConservationCharacteristic) :: a, b
      class(TransformBase), allocatable :: transformer
      integer :: status

      a = ConservationCharacteristic(ConservationMetadata(CONSERVE_MASS))
      b = ConservationCharacteristic(ConservationMetadata(CONSERVE_MASS))

      call a%build_transform(b, transformer, rc=status)

      @assertEqual(BUILD_TRANSFORM_INCOMPATIBLE, status)
      @assertFalse(allocated(transformer))
   end subroutine test_conservation_build_transform_reports_incompatible

   @test
   subroutine test_normalization_build_transform_reports_incompatible()
      type(NormalizationCharacteristic) :: a, b
      class(TransformBase), allocatable :: transformer
      integer :: status

      a = NormalizationCharacteristic(NormalizationMetadata(NORMALIZE_DELP))
      b = NormalizationCharacteristic(NormalizationMetadata(NORMALIZE_DELP))

      call a%build_transform(b, transformer, rc=status)

