   subroutine test_attributes_get_signature_distinguishes_values()
      type(AttributesCharacteristic) :: a, same_as_a, b
      type(StringVector) :: names_a, names_b

      call names_a%push_back('units')
      call names_b%push_back('long_name')

      a = AttributesCharacteristic(names_a)
      same_as_a = AttributesCharacteristic(names_a)
      b = AttributesCharacteristic(names_b)

