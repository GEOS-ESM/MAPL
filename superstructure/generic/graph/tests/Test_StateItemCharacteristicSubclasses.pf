   ! Only the two characteristics stored under the item's own alias are
   ! per-alias; the base default is field-wide.
   @test
   subroutine test_is_per_alias()
      type(RestartModeCharacteristic) :: restart_mode
      type(LongNameCharacteristic) :: long_name
      type(StandardNameCharacteristic) :: standard_name
      type(PhysicalUnitsCharacteristic) :: units

      restart_mode = RestartModeCharacteristic(RESTART_SKIP)
      long_name = LongNameCharacteristic('x')
      standard_name = StandardNameCharacteristic('x')
      units = PhysicalUnitsCharacteristic('K')
      @assertTrue(restart_mode%is_per_alias())
      @assertTrue(long_name%is_per_alias())
      @assertFalse(standard_name%is_per_alias())
      @assertFalse(units%is_per_alias())
   end subroutine test_is_per_alias

