   ! A quantity-type mismatch can never connect.
   @test
   subroutine test_quantity_type_mismatch_reports_incompatible()
      type(QuantityTypeCharacteristic) :: a, b
      class(TransformBase), allocatable :: transformer
      integer :: status

      a = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      b = QuantityTypeCharacteristic(QUANTITY_TEMPERATURE, BASIS_WET_MASS)

      status = BUILD_TRANSFORM_UNSUPPORTED
      call a%build_transform(b, transformer, rc=status)

      @assertEqual(BUILD_TRANSFORM_INCOMPATIBLE, status)
      @assertFalse(allocated(transformer))
   end subroutine test_quantity_type_mismatch_reports_incompatible

   ! The quantity axis decides: a quantity mismatch is incompatible even
   ! when the bases also differ.
   @test
   subroutine test_quantity_type_and_basis_mismatch_reports_incompatible()
      type(QuantityTypeCharacteristic) :: a, b
      class(TransformBase), allocatable :: transformer
      integer :: status

      a = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      b = QuantityTypeCharacteristic(QUANTITY_TEMPERATURE, BASIS_DRY_MASS)

      status = BUILD_TRANSFORM_UNSUPPORTED
      call a%build_transform(b, transformer, rc=status)

      @assertEqual(BUILD_TRANSFORM_INCOMPATIBLE, status)
      @assertFalse(allocated(transformer))
   end subroutine test_quantity_type_and_basis_mismatch_reports_incompatible

   ! Same quantity type, different real bases: a conversion is possible but
   ! not built yet.
   @test
   subroutine test_quantity_type_basis_only_mismatch_reports_unsupported()
      type(QuantityTypeCharacteristic) :: wet_mass, dry_mass
      class(TransformBase), allocatable :: transformer
      integer :: status

      wet_mass = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, &
           BASIS_WET_MASS)
      dry_mass = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, &
           BASIS_DRY_MASS)

      status = BUILD_TRANSFORM_INCOMPATIBLE
      call wet_mass%build_transform(dry_mass, transformer, rc=status)
      @assertEqual(BUILD_TRANSFORM_UNSUPPORTED, status)
      @assertFalse(allocated(transformer))

      status = BUILD_TRANSFORM_INCOMPATIBLE
      call dry_mass%build_transform(wet_mass, transformer, rc=status)
      @assertEqual(BUILD_TRANSFORM_UNSUPPORTED, status)
      @assertFalse(allocated(transformer))
   end subroutine test_quantity_type_basis_only_mismatch_reports_unsupported

   ! QUANTITY_UNKNOWN is a real mismatch against a known type; the quantity
   ! axis wins even when the bases also differ.
   @test
   subroutine test_quantity_type_unknown_with_differing_bases_incompatible()
      type(QuantityTypeCharacteristic) :: known, unknown
      class(TransformBase), allocatable :: transformer
      integer :: status

      known = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_WET_MASS)
      unknown = QuantityTypeCharacteristic(QUANTITY_UNKNOWN, BASIS_DRY_MASS)

      @assertTrue(known%needs_extension_for(unknown))
      @assertTrue(unknown%needs_extension_for(known))

      status = BUILD_TRANSFORM_INCOMPATIBLE
      call known%build_transform(unknown, transformer, rc=status)
      @assertEqual(BUILD_TRANSFORM_INCOMPATIBLE, status)
      @assertFalse(allocated(transformer))

      status = BUILD_TRANSFORM_INCOMPATIBLE
      call unknown%build_transform(known, transformer, rc=status)
      @assertEqual(BUILD_TRANSFORM_INCOMPATIBLE, status)
      @assertFalse(allocated(transformer))
   end subroutine test_quantity_type_unknown_with_differing_bases_incompatible

   ! BASIS_NONE matches any basis, but does not hide a quantity mismatch.
   @test
   subroutine test_quantity_type_basis_none_is_only_a_basis_wildcard()
      type(QuantityTypeCharacteristic) :: wet_mass, no_basis, unknown_none

      wet_mass = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, &
           BASIS_WET_MASS)
      no_basis = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_NONE)
      unknown_none = QuantityTypeCharacteristic(QUANTITY_UNKNOWN, BASIS_NONE)

      @assertFalse(wet_mass%needs_extension_for(no_basis))
      @assertFalse(no_basis%needs_extension_for(wet_mass))
      @assertTrue(wet_mass%needs_extension_for(unknown_none))
      @assertTrue(unknown_none%needs_extension_for(wet_mass))
   end subroutine test_quantity_type_basis_none_is_only_a_basis_wildcard

   @test
   subroutine test_quantity_type_deferred_is_fatal_only_when_required()
      type(QuantityTypeCharacteristic) :: quantity_type
      type(PhysicalUnitsCharacteristic) :: units
      type(FieldDictionaryConfig) :: saved

      quantity_type = QuantityTypeCharacteristic(QUANTITY_TEMPERATURE)
      units = PhysicalUnitsCharacteristic('K')
      saved = get_field_dictionary_config()

      call use_validation( &
           '{validation_mode: permissive, require_quantity_type: false}')
      @assertFalse(quantity_type%is_deferred_fatal())
      @assertTrue(units%is_deferred_fatal())

      call use_validation( &
           '{validation_mode: strict, require_quantity_type: false}')
      @assertFalse(quantity_type%is_deferred_fatal())

      call use_validation( &
           '{validation_mode: permissive, require_quantity_type: true}')
      @assertTrue(quantity_type%is_deferred_fatal())

      call use_validation( &
           '{validation_mode: strict, require_quantity_type: true}')
      @assertTrue(quantity_type%is_deferred_fatal())

      call set_field_dictionary_config(saved)
   end subroutine test_quantity_type_deferred_is_fatal_only_when_required

