      integer :: status
      real, allocatable :: c(:)

      geom = make_geom()
      g_in => make_basic(3)
      g_out => make_fixed('pressure', [100., 500., 1000.], 'hPa')
      f_in = make_field(geom, g_in, 'T')
      f_out = make_field(geom, g_out, 'T')
      call fill(f_in, [1., 2., 3.])

      status = regrid(f_in, f_out)
      c = column(f_out)
      @assertEqual(0, status)
      @assertEqual([1., 2., 3.], c)
   end subroutine test_basic_equal_count_copies

   @test
   subroutine test_basic_different_count_fails()
