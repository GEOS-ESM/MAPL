   end subroutine test_basic_different_count_fails

   ! Export levels in hPa, import levels in Pa.
   @test
   subroutine test_levels_converted_to_import_units()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_out
      class(mapl_VerticalGrid), pointer :: g_in, g_out
      integer :: status
      real, allocatable :: c(:)

      geom = make_geom()
      g_in => make_fixed('pressure', [1000., 500., 100.], 'hPa')
      g_out => make_fixed('pressure', [80000., 30000.], 'Pa')
      f_in = make_field(geom, g_in, 'T')
      f_out = make_field(geom, g_out, 'T')
      call fill(f_in, [2001., 1001., 201.])

      status = regrid(f_in, f_out)
      c = column(f_out)
      @assertEqual(0, status)
      @assertEqual([1601., 601.], c, tolerance=TOL)
   end subroutine test_levels_converted_to_import_units

