   @test
   subroutine test_column_coordinate_default_fails()
      class(mapl_VerticalGrid), pointer :: g
      real, allocatable :: levels(:)
      integer :: status

      g => make_basic(3)
      call g%get_column_coordinate('pressure', levels, rc=status)
      @assertTrue(status /= 0)
   end subroutine test_column_coordinate_default_fails

   @test
   subroutine test_column_coordinate_fixed_levels()
      class(mapl_VerticalGrid), pointer :: g
      real, allocatable :: levels(:)
      integer :: status(2)

      g => make_fixed('pressure', [1000., 500., 100.], 'hPa')
      call g%get_column_coordinate('pressure', levels, rc=status(1))
      @assertEqual(0, status(1))
      @assertEqual([1000., 500., 100.], levels)
      call g%get_column_coordinate('height', levels, rc=status(2))
      @assertTrue(status(2) /= 0)
   end subroutine test_column_coordinate_fixed_levels

   ! The flip step reverses the level index, whichever way the two
   ! orientations differ.
   @test
   subroutine test_flip_3d()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_out
      class(mapl_VerticalGrid), pointer :: g
      type(VerticalFlipTransform) :: transform
      type(PortNameGraphStateItemMap) :: inputs, outputs
      integer :: status(2)
      real, allocatable :: c1(:), c2(:)

      geom = make_geom()
      g => make_basic(3)
      f_in = make_field(geom, g, 'T', alignment=VALIGN_DOWN)
      f_out = make_field(geom, g, 'T', alignment=VALIGN_UP)
      call fill(f_in, [1., 2., 3.])
      call bind(inputs, SRC_PORT, f_in)
      call bind(outputs, DST_PORT, f_out)

      transform = VerticalFlipTransform()
      call transform%compute(inputs, outputs, status(1))
      c1 = column(f_out)

      call bind(inputs, SRC_PORT, f_out)
      call bind(outputs, DST_PORT, f_in)
      call fill(f_out, [4., 5., 6.])
      call transform%compute(inputs, outputs, status(2))
      c2 = column(f_in)

      @assertEqual([0, 0], status)
      @assertEqual([3., 2., 1.], c1)
      @assertEqual([6., 5., 4.], c2)
   end subroutine test_flip_3d

   @test
   subroutine test_flip_4d()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_out
      class(mapl_VerticalGrid), pointer :: g
      type(VerticalFlipTransform) :: transform
      type(PortNameGraphStateItemMap) :: inputs, outputs
      real(kind=ESMF_KIND_R4), pointer :: x(:,:,:)
      real :: got(NX, 3, 2), expected(NX, 3, 2)
      integer :: status, i, u

      geom = make_geom()
      g => make_basic(3)
      f_in = make_field(geom, g, 'T', alignment=VALIGN_DOWN, num_ungridded=2)
      f_out = make_field(geom, g, 'T', alignment=VALIGN_UP, num_ungridded=2)
      x => view(f_in)
      do u = 1, 2
         do i = 1, NX
            x(i, :, u) = [1., 2., 3.] + 10*i + 100*u
            expected(i, :, u) = [3., 2., 1.] + 10*i + 100*u
         end do
      end do
      call bind(inputs, SRC_PORT, f_in)
      call bind(outputs, DST_PORT, f_out)

      transform = VerticalFlipTransform()
      call transform%compute(inputs, outputs, status)
      x => view(f_out)
      got = x
      @assertEqual(0, status)
      @assertEqual(expected, got)
   end subroutine test_flip_4d

   @test
   subroutine test_flip_r8()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_out
      class(mapl_VerticalGrid), pointer :: g
      type(VerticalFlipTransform) :: transform
      type(PortNameGraphStateItemMap) :: inputs, outputs
      real(kind=ESMF_KIND_R8), pointer :: x8(:,:,:)
      real(kind=ESMF_KIND_R8), allocatable :: c(:)
      integer :: status(3)

      geom = make_geom()
      g => make_basic(3)
      f_in = make_field(geom, g, 'T', typekind=ESMF_TYPEKIND_R8)
      f_out = make_field(geom, g, 'T', typekind=ESMF_TYPEKIND_R8)
      call assign_fptr_condensed_array(f_in, x8, rc=status(1))
      x8(1, :, 1) = [1.d0, 2.d0, 3.d0]
      call bind(inputs, SRC_PORT, f_in)
      call bind(outputs, DST_PORT, f_out)

      transform = VerticalFlipTransform()
      call transform%compute(inputs, outputs, status(2))
      call assign_fptr_condensed_array(f_out, x8, rc=status(3))
      c = x8(1, :, 1)
      @assertEqual([0, 0, 0], status)
      @assertEqual([3.d0, 2.d0, 1.d0], c)
   end subroutine test_flip_r8

   ! Ocean to atmosphere: an increasing (DOWN) grid from a decreasing (UP)
   ! one, both fields stored as their grids.
   @test
   subroutine test_up_grid_to_down_grid()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_out
      class(mapl_VerticalGrid), pointer :: g_in, g_out
      integer :: status
      real, allocatable :: c(:)

      geom = make_geom()
      g_in => make_fixed('pressure', [1000., 500., 100.], 'hPa')
      g_out => make_fixed('pressure', [300., 800.], 'hPa')
      f_in = make_field(geom, g_in, 'T')
      f_out = make_field(geom, g_out, 'T')
      call fill(f_in, [2001., 1001., 201.])

      status = regrid(f_in, f_out)
      c = column(f_out)
      @assertEqual(0, status)
      @assertEqual([601., 1601.], c, tolerance=TOL)
   end subroutine test_up_grid_to_down_grid

   ! Both fields stored opposite to their (UP) grids at once.
   @test
   subroutine test_both_alignments_opposite_grids()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_out
      class(mapl_VerticalGrid), pointer :: g_in, g_out
      integer :: status
      real, allocatable :: c(:)

      geom = make_geom()
      g_in => make_fixed('pressure', [1000., 500., 100.], 'hPa')
      g_out => make_fixed('pressure', [800., 300.], 'hPa')
      f_in = make_field(geom, g_in, 'T', alignment=VALIGN_DOWN)
      f_out = make_field(geom, g_out, 'T', alignment=VALIGN_DOWN)
      call fill(f_in, [201., 1001., 2001.])

      status = regrid(f_in, f_out)
      c = column(f_out)
      @assertEqual(0, status)
      @assertEqual([601., 1601.], c, tolerance=TOL)
   end subroutine test_both_alignments_opposite_grids

   ! A single-level grid has no direction; an explicit alignment on it
   ! changes nothing. Both as destination and as source.
   @test
   subroutine test_single_level_grid()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_one, f_out
      class(mapl_VerticalGrid), pointer :: g_in, g_one, g_out
      integer :: status(2)
      real, allocatable :: c1(:), c2(:)

      geom = make_geom()
      g_in => make_fixed('pressure', [1000., 500., 100.], 'hPa')
      g_one => make_fixed('pressure', [800.], 'hPa')
      g_out => make_fixed('pressure', [900., 300.], 'hPa')
      f_in = make_field(geom, g_in, 'T')
      f_one = make_field(geom, g_one, 'T', alignment=VALIGN_DOWN)
      f_out = make_field(geom, g_out, 'T')
      call fill(f_in, [2001., 1001., 201.])

      status(1) = regrid(f_in, f_one)
      c1 = column(f_one)
      status(2) = regrid(f_one, f_out)
      c2 = column(f_out)
      @assertEqual([0, 0], status)
      @assertEqual([1601.], c1, tolerance=TOL)
      @assertEqual([1601., 1601.], c2, tolerance=TOL)
   end subroutine test_single_level_grid

   ! A matching-grid pair is a copy or flip whatever the method, as in
   ! legacy; only a real regrid needs linear.
   @test
   subroutine test_conservative_on_matching_grids_flips()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_out
      class(mapl_VerticalGrid), pointer :: g_in, g_out
      type(VerticalColumnRegridTransform) :: transform
      type(PortNameGraphStateItemMap) :: inputs, outputs
      integer :: status
      real, allocatable :: c(:)

      geom = make_geom()
      g_in => make_basic(3)
      g_out => make_basic(3)
      f_in = make_field(geom, g_in, 'T', alignment=VALIGN_UP)
      f_out = make_field(geom, g_out, 'T', alignment=VALIGN_DOWN)
      call fill(f_in, [1., 2., 3.])
      call bind(inputs, SRC_PORT, f_in)
      call bind(outputs, DST_PORT, f_out)

      transform = VerticalColumnRegridTransform(VERTICAL_REGRID_CONSERVATIVE)
      call transform%compute(inputs, outputs, status)
      c = column(f_out)
      @assertEqual(0, status)
      @assertEqual([3., 2., 1.], c)
   end subroutine test_conservative_on_matching_grids_flips

   @test
   subroutine test_invalid_alignment_fails()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_out
      class(mapl_VerticalGrid), pointer :: g_in, g_out
      integer :: status, set_status

      geom = make_geom()
      g_in => make_fixed('pressure', [1000., 500., 100.], 'hPa')
      g_out => make_fixed('pressure', [800., 300.], 'hPa')
      f_in = make_field(geom, g_in, 'T')
      f_out = make_field(geom, g_out, 'T')
      call MAPL_FieldSet(f_in, vert_alignment=VALIGN_INVALID, rc=set_status)

      status = regrid(f_in, f_out)
      @assertEqual(0, set_status)
      @assertTrue(status /= 0)
   end subroutine test_invalid_alignment_fails

   ! A model grid (coordinate from a PLE-like field) has no column
   ! coordinate, so a regrid to fixed levels is unsupported.
   @test
   subroutine test_model_grid_fails()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_out
      class(mapl_VerticalGrid), pointer :: g_in, g_out
      type(mapl_VerticalGridManager), pointer :: manager
      integer :: status, add_status

      geom = make_geom()
      manager => mapl_get_vertical_grid_manager()
      g_in => manager%add_grid(ModelVerticalGrid('pressure', 'PL', 4), &
           rc=add_status)
      g_out => make_fixed('pressure', [800., 300.], 'hPa')
      f_in = make_field(geom, g_in, 'T')
      f_out = make_field(geom, g_out, 'T')

      status = regrid(f_in, f_out)
      @assertEqual(0, add_status)
      @assertTrue(status /= 0)
   end subroutine test_model_grid_fails

   ! Export levels that equal the import ends only up to rounding after a
   ! units conversion are not reported out of range.
   @test
   subroutine test_out_of_range_tolerance()
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: f_in, f_out
      class(mapl_VerticalGrid), pointer :: g_in, g_out
      type(VerticalColumnRegridTransform) :: transform
      type(PortNameGraphStateItemMap) :: inputs, outputs
      integer :: status, n

      geom = make_geom()
      ! 543.21 hPa converts to 54321.004 Pa in R4, just above 54321.
      g_in => make_fixed('pressure', [1000., 800., 543.21], 'hPa')
      g_out => make_fixed('pressure', [90000., 54321.], 'Pa')
      f_in = make_field(geom, g_in, 'T')
      f_out = make_field(geom, g_out, 'T')
      call fill(f_in, [2001., 1001., 201.])
      call bind(inputs, SRC_PORT, f_in)
      call bind(outputs, DST_PORT, f_out)

      transform = VerticalColumnRegridTransform()
      call transform%compute(inputs, outputs, status)
      n = transform%get_num_out_of_range()
      @assertEqual(0, status)
      @assertEqual(0, n)
   end subroutine test_out_of_range_tolerance

end module Test_VerticalColumnRegridTransform
