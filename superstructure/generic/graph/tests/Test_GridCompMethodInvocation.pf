! Task 3.5 (spec/12-methods-and-drivers.md REQ-MTH-001/003).
module Test_GridCompMethodInvocation
   use mapl_GridCompMethodInvocation_mod, only: GridCompMethodInvocation
   use mapl_MethodInvocationAdapter_mod, only: GridCompPhaseInvoker
   use mapl_ArgumentSpecMap_mod, only: ArgumentSpecMap
   use mapl_StateItemMemberMap_mod, only: StateItemMemberMap
   use mapl_ArgumentSpec_mod, only: ArgumentSpec
   use mapl_AccessSpec_mod, only: MAPL_ACCESS_IN
   use mapl_NodeId_mod, only: NodeId, NodeIdGenerator
   use ESMF, only: ESMF_Clock
   use funit
   implicit none

   ! Records exactly what invoke_phase() was called with. Held via a
   ! pointer (not a value component) so the recording survives the
   ! sourced-allocation copy GridCompMethodInvocation's constructor
   ! performs - same pattern Test_TransformGraphNode.pf uses for its
   ! run_count pointer.
   type :: CallRecord
      integer :: call_count = 0
      character(:), allocatable :: driver_key
      integer :: phase_idx = -1
      integer :: argument_count = -1
      integer :: binding_count = -1
      logical :: clock_present = .false.
   end type CallRecord

   type, extends(GridCompPhaseInvoker) :: RecordingPhaseInvoker
      type(CallRecord), pointer :: record => null()
   contains
      procedure :: invoke_phase => recording_invoke_phase
   end type RecordingPhaseInvoker

contains

   subroutine recording_invoke_phase(this, driver_key, phase_idx, arguments, bindings, clock, rc)
      class(RecordingPhaseInvoker), intent(inout) :: this
      character(*), intent(in) :: driver_key
      integer, intent(in) :: phase_idx
      type(ArgumentSpecMap), intent(in) :: arguments
      type(StateItemMemberMap), intent(in) :: bindings
      type(ESMF_Clock), optional, intent(in) :: clock
      integer, optional, intent(out) :: rc

      this%record%call_count = this%record%call_count + 1
      this%record%driver_key = driver_key
      this%record%phase_idx = phase_idx
      this%record%argument_count = int(arguments%size())
      this%record%binding_count = int(bindings%size())
      this%record%clock_present = present(clock)

      rc = 0
   end subroutine recording_invoke_phase

   @test
   subroutine test_invoke_calls_injected_invoker_exactly_once()
      type(GridCompMethodInvocation) :: adapter
      type(RecordingPhaseInvoker) :: invoker
      type(CallRecord), target :: record
      type(ArgumentSpecMap) :: arguments
      type(StateItemMemberMap) :: bindings
      type(NodeIdGenerator) :: gen
      integer :: status

      invoker%record => record
      adapter = GridCompMethodInvocation('driver-1', 2, invoker)

      call arguments%insert('x', ArgumentSpec('x', MAPL_ACCESS_IN))
      call bindings%insert('x', gen%next())

      call adapter%invoke(arguments, bindings, rc=status)
      @assertEqual(0, status)

      @assertEqual(1, record%call_count)
      @assertEqual('driver-1', record%driver_key)
      @assertEqual(2, record%phase_idx)
      @assertEqual(1, record%argument_count)
      @assertEqual(1, record%binding_count)
      @assertFalse(record%clock_present)

      call adapter%invoke(arguments, bindings, rc=status)
      @assertEqual(0, status)
      @assertEqual(2, record%call_count)
   end subroutine test_invoke_calls_injected_invoker_exactly_once

   @test
   subroutine test_invoke_fails_with_no_invoker_attached()
      type(GridCompMethodInvocation) :: adapter
      type(ArgumentSpecMap) :: arguments
      type(StateItemMemberMap) :: bindings
      integer :: status

      adapter = GridCompMethodInvocation('driver-1', 2)

      call adapter%invoke(arguments, bindings, rc=status)
      @assertTrue(status /= 0)
   end subroutine test_invoke_fails_with_no_invoker_attached

end module Test_GridCompMethodInvocation
