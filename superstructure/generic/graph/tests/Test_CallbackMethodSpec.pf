! Spec: spec/15-callbacks.md.
module Test_CallbackMethodSpec
   use mapl_CallbackMethodSpec_mod, only: CallbackMethodSpec
   use mapl_CallbackArgumentOptions_mod, only: CallbackArgumentOptions, &
        operator(==), &
        CALLBACK_PUT_FLAVOUR_VALUE, CALLBACK_PUT_FLAVOUR_DELTA
   use mapl_AccessSpec_mod, only: AccessSpec, operator(==), &
        MAPL_ACCESS_OUT, MAPL_ACCESS_IN
   use funit
   implicit none

contains

   @test
   subroutine test_declare_and_retrieve_argument_access()
      type(CallbackMethodSpec) :: spec
      type(AccessSpec) :: access
      integer :: status

      call spec%declare_argument_access('tracers', MAPL_ACCESS_OUT, rc=status)
      @assertEqual(0, status)

      @assertTrue(spec%is_argument_access('tracers'))
      access = spec%get_argument_access('tracers', rc=status)
      @assertEqual(0, status)
      @assertTrue(access == MAPL_ACCESS_OUT)
   end subroutine test_declare_and_retrieve_argument_access

   @test
   subroutine test_duplicate_argument_access_rejected()
      type(CallbackMethodSpec) :: spec
      type(AccessSpec) :: access
      integer :: status

      call spec%declare_argument_access('tracers', MAPL_ACCESS_OUT, rc=status)
      @assertEqual(0, status)

      call spec%declare_argument_access('tracers', MAPL_ACCESS_IN, rc=status)
      @assertTrue(status /= 0)

      ! Original declaration is unaffected.
      access = spec%get_argument_access('tracers', rc=status)
      @assertEqual(0, status)
      @assertTrue(access == MAPL_ACCESS_OUT)
   end subroutine test_duplicate_argument_access_rejected

   @test
   subroutine test_get_argument_access_fails_when_undeclared()
      type(CallbackMethodSpec) :: spec
      type(AccessSpec) :: access
      integer :: status

      access = spec%get_argument_access('never_declared', rc=status)
      @assertTrue(status /= 0)
      @assertFalse(spec%is_argument_access('never_declared'))
   end subroutine test_get_argument_access_fails_when_undeclared

   @test
   subroutine test_get_argument_accesses_reports_size()
      use mapl_AccessSpecMap_mod, only: AccessSpecMap
      type(CallbackMethodSpec) :: spec
      type(AccessSpecMap) :: accesses
      integer :: status

      call spec%declare_argument_access('a', MAPL_ACCESS_IN, rc=status)
      call spec%declare_argument_access('b', MAPL_ACCESS_OUT, rc=status)

      accesses = spec%get_argument_accesses()
      @assertEqual(2, int(accesses%size()))
   end subroutine test_get_argument_accesses_reports_size

   @test
   subroutine test_put_flavour_is_retrievable()
      type(CallbackMethodSpec) :: spec
      type(CallbackArgumentOptions) :: options, reported
      type(AccessSpec) :: access
      integer :: status

      call options%set_option('put_flavour', 'value', rc=status)
      @assertEqual(0, status)
      call spec%declare_argument_access('mixed_quantity', MAPL_ACCESS_IN, &
           options=options, rc=status)
      @assertEqual(0, status)

      access = spec%get_argument_access('mixed_quantity', rc=status)
      @assertEqual(0, status)
      @assertTrue(access == MAPL_ACCESS_IN)
      reported = spec%get_argument_options('mixed_quantity', rc=status)
      @assertEqual(0, status)
      @assertTrue(reported%has_put_flavour())
      @assertTrue(reported%get_put_flavour() == CALLBACK_PUT_FLAVOUR_VALUE)
   end subroutine test_put_flavour_is_retrievable

   @test
   subroutine test_delta_put_flavour_is_retrievable()
      type(CallbackMethodSpec) :: spec
      type(CallbackArgumentOptions) :: options, reported
      integer :: status

      call options%set_option('put_flavour', 'delta', rc=status)
      @assertEqual(0, status)
      call spec%declare_argument_access('mixed_quantity', MAPL_ACCESS_IN, &
           options=options, rc=status)
      @assertEqual(0, status)

      reported = spec%get_argument_options('mixed_quantity', rc=status)
      @assertEqual(0, status)
      @assertTrue(reported%get_put_flavour() == CALLBACK_PUT_FLAVOUR_DELTA)
   end subroutine test_delta_put_flavour_is_retrievable

   @test
   subroutine test_unknown_option_name_rejected()
      type(CallbackArgumentOptions) :: options
      integer :: status

      call options%set_option('put_flavor', 'value', rc=status)
      @assertTrue(status /= 0)
      @assertFalse(options%has_put_flavour())
   end subroutine test_unknown_option_name_rejected

   @test
   subroutine test_illegal_put_flavour_value_rejected()
      type(CallbackArgumentOptions) :: options
      integer :: status

      call options%set_option('put_flavour', 'increment', rc=status)
      @assertTrue(status /= 0)
      @assertFalse(options%has_put_flavour())
   end subroutine test_illegal_put_flavour_value_rejected

   @test
   subroutine test_rejected_option_leaves_earlier_value()
      type(CallbackArgumentOptions) :: options
      integer :: status

      call options%set_option('put_flavour', 'delta', rc=status)
      @assertEqual(0, status)
      call options%set_option('put_flavour', 'bogus', rc=status)
      @assertTrue(status /= 0)
      @assertTrue(options%get_put_flavour() == CALLBACK_PUT_FLAVOUR_DELTA)
   end subroutine test_rejected_option_leaves_earlier_value

   @test
   subroutine test_argument_without_options_reports_none()
      type(CallbackMethodSpec) :: spec
      type(CallbackArgumentOptions) :: reported
      integer :: status

      call spec%declare_argument_access('tracers', MAPL_ACCESS_OUT, &
           rc=status)
      @assertEqual(0, status)

      reported = spec%get_argument_options('tracers', rc=status)
      @assertEqual(0, status)
      @assertFalse(reported%has_put_flavour())
   end subroutine test_argument_without_options_reports_none

   @test
   subroutine test_get_argument_options_fails_when_undeclared()
      type(CallbackMethodSpec) :: spec
      type(CallbackArgumentOptions) :: reported
      integer :: status

      reported = spec%get_argument_options('never_declared', rc=status)
      @assertTrue(status /= 0)
   end subroutine test_get_argument_options_fails_when_undeclared

   @test
   subroutine test_duplicate_declaration_keeps_original_options()
      type(CallbackMethodSpec) :: spec
      type(CallbackArgumentOptions) :: first, second, reported
      integer :: status

      call first%set_option('put_flavour', 'value', rc=status)
      call second%set_option('put_flavour', 'delta', rc=status)
      call spec%declare_argument_access('q', MAPL_ACCESS_IN, &
           options=first, rc=status)
      @assertEqual(0, status)
      call spec%declare_argument_access('q', MAPL_ACCESS_IN, &
           options=second, rc=status)
      @assertTrue(status /= 0)

      reported = spec%get_argument_options('q', rc=status)
      @assertEqual(0, status)
      @assertTrue(reported%get_put_flavour() == CALLBACK_PUT_FLAVOUR_VALUE)
   end subroutine test_duplicate_declaration_keeps_original_options

end module Test_CallbackMethodSpec
