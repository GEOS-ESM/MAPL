! openspec/changes/extension-reuse - task group 6 (unit tests for
! mapl_StateItemCharacteristic_mod / mapl_ExtensionResolution_mod).
!
! Uses only synthetic graph nodes (StateItemNode/TransformGraphNode) - no
! OuterComponent/StateRegistry/GraphBuilder type is referenced anywhere,
! matching Test_ComponentGraph_PortBindings.pf's existing style. The
! multi-step chain test uses a test-only FakeCharacteristic
! (MOCK_CHARACTERISTIC_KIND, mirroring AspectId.F90's own MOCK_ASPECT_ID
! precedent) so the chain-building loop can be exercised with two links
! without needing a second real, executing characteristic (extension-
! reuse change design.md Decisions).
!
! openspec/changes/merge-characteristic-families, task 6.4: re-typed from
! the retired mapl_Characteristic_mod/mapl_CharacteristicId_mod onto the
! surviving mapl_StateItemCharacteristic_mod/
! mapl_StateItemCharacteristicKind_mod family. FakeCharacteristic now
! extends StateItemCharacteristic (nopass get_kind, four-argument
! build_transform, no graph/NodeId argument - already the shape
! post-decouple-transform-from-graph) and gains a new get_signature
! implementation (task 1.1's new deferred method) - a simple
! 'mock=' // this%value mirrors its existing get_signature-style naming
! already used elsewhere in this hierarchy.
module Test_ExtensionResolution
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetworkId_mod, only: DependencyNetworkId
   use mapl_NodeId_mod, only: NodeId, operator(==)
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem
   use mapl_NodeRevision_mod, only: NodeRevision
   use mapl_Transform_mod, only: Transform
   use mapl_TransformBase_mod, only: TransformBase
   use mapl_PortNameGraphStateItemMap_mod, only: PortNameGraphStateItemMap
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristic, StateItemCharacteristicMap
   use mapl_StateItemCharacteristicKind_mod, only: StateItemCharacteristicKind, PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
        VERTICAL_COORDINATE_CHARACTERISTIC_KIND, MOCK_CHARACTERISTIC_KIND, operator(==)
   use mapl_PhysicalUnitsCharacteristic_mod, only: PhysicalUnitsCharacteristic
   use mapl_VerticalCoordinateCharacteristic_mod, only: VerticalCoordinateCharacteristic
   use mapl_ExtensionResolution_mod, only: find_mismatched_characteristics, find_or_build_extension_chain
   ! openspec/changes/phase-7a-shape-dispatch-wiring, task 9.2/9.3:
   ! ITEM_SHAPE_CHARACTERISTIC_KIND walked by this same, uniform
   ! find_mismatched_characteristics/build_chain machinery.
   use mapl_StateItemCharacteristicKind_mod, only: ITEM_SHAPE_CHARACTERISTIC_KIND
   use mapl_ItemShapeCharacteristic_mod, only: ItemShapeCharacteristic
   use mapl_StateItem_mod, only: MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET
   use funit
   implicit none

   type, extends(Transform) :: FakeCompute
      integer :: placeholder = 1
   contains
      procedure :: compute => fake_compute
   end type FakeCompute

   ! Test-only StateItemCharacteristic - see module header.
   type, extends(StateItemCharacteristic) :: FakeCharacteristic
      private
      character(:), allocatable :: value
   contains
      procedure, nopass :: get_kind => fake_get_kind
      procedure :: get_signature => fake_get_signature
      procedure :: needs_extension_for => fake_needs_extension_for
      procedure :: build_transform => fake_build_transform
   end type FakeCharacteristic

   interface FakeCharacteristic
      module procedure new_FakeCharacteristic
   end interface FakeCharacteristic

contains

   function new_FakeCharacteristic(value) result(characteristic)
      character(*), intent(in) :: value
      type(FakeCharacteristic) :: characteristic

      characteristic%value = value
   end function new_FakeCharacteristic

   function fake_get_kind() result(kind)
      type(StateItemCharacteristicKind) :: kind

      kind = MOCK_CHARACTERISTIC_KIND
   end function fake_get_kind

   function fake_get_signature(this) result(signature)
      class(FakeCharacteristic), intent(in) :: this
      character(:), allocatable :: signature

      signature = 'mock=' // this%value
   end function fake_get_signature

   logical function fake_needs_extension_for(this, goal) result(needs_extension)
      class(FakeCharacteristic), intent(in) :: this
      class(StateItemCharacteristic), intent(in) :: goal

      select type (goal)
      class is (FakeCharacteristic)
         needs_extension = (this%value /= goal%value)
      class default
         needs_extension = .true.
      end select
   end function fake_needs_extension_for

   subroutine fake_build_transform(this, goal, transformer, rc)
      class(FakeCharacteristic), intent(in) :: this
      class(StateItemCharacteristic), intent(in) :: goal
      class(TransformBase), allocatable, intent(out) :: transformer
      integer, optional, intent(out) :: rc

      type(FakeCompute) :: strategy

      ! kludge      
      strategy%placeholder = 2
      allocate(transformer, source=strategy)
      call transformer%declare_input_port('source_field')
      call transformer%declare_output_port('destination_field')
      if (present(rc)) rc = 0
   end subroutine fake_build_transform

   subroutine fake_compute(this, inputs, outputs, rc)
      class(FakeCompute), intent(inout) :: this
      type(PortNameGraphStateItemMap), intent(in) :: inputs
      type(PortNameGraphStateItemMap), intent(in) :: outputs
      integer, intent(out) :: rc

      rc = 0
   end subroutine fake_compute

   ! -- mismatch detection ---------------------------------------------

   @test
   subroutine test_no_mismatch_reports_empty()
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))

      mismatched = find_mismatched_characteristics(export_map, import_map)
      @assertEqual(0, size(mismatched))
   end subroutine test_no_mismatch_reports_empty

   @test
   subroutine test_units_mismatch_detected()
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('km'))

      mismatched = find_mismatched_characteristics(export_map, import_map)
      @assertEqual(1, size(mismatched))
      @assertTrue(mismatched(1) == PHYSICAL_UNITS_CHARACTERISTIC_KIND)
   end subroutine test_units_mismatch_detected

   @test
   subroutine test_units_and_vertical_grid_mismatch_detected()
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call export_map%insert(VERTICAL_COORDINATE_CHARACTERISTIC_KIND, VerticalCoordinateCharacteristic(grid_id='gridA'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('km'))
      call import_map%insert(VERTICAL_COORDINATE_CHARACTERISTIC_KIND, VerticalCoordinateCharacteristic(grid_id='gridB'))

      mismatched = find_mismatched_characteristics(export_map, import_map)
      @assertEqual(2, size(mismatched))
   end subroutine test_units_and_vertical_grid_mismatch_detected

   ! -- chain creation ---------------------------------------------------

   @test
   subroutine test_single_step_chain_creates_one_transform()
      type(ComponentGraph), target :: graph
      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id
      type(StateItemNode) :: export_node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)
      type(NodeId) :: final_id
      type(NodeId), allocatable :: intermediate_ids(:)
      character(:), allocatable :: unsupported
      integer :: status

      graph = ComponentGraph()
      net_id = graph%get_default_network_id()

      export_id = graph%next_node_id(rc=status)
      export_node = StateItemNode(export_id, payload, revision)
      call graph%register_node(export_node, rc=status)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('km'))
      mismatched = find_mismatched_characteristics(export_map, import_map)

      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map, &
           mismatched, final_id, intermediate_ids, unsupported, rc=status)

      @assertEqual(0, status)
      @assertEqual('', unsupported)
      @assertFalse(final_id == export_id)
      ! openspec/changes/phase-11b-chain-intermediate-materialization:
      ! a single-characteristic chain's own intermediate_ids array has
      ! length 1, and that one entry is the chain's own final node.
      @assertEqual(1, size(intermediate_ids))
      @assertTrue(intermediate_ids(1) == final_id)
   end subroutine test_single_step_chain_creates_one_transform

   @test
   subroutine test_multi_step_chain_with_fake_characteristic()
      type(ComponentGraph), target :: graph
      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id
      type(StateItemNode) :: export_node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)
      type(NodeId) :: final_id
      type(NodeId), allocatable :: intermediate_ids(:)
      character(:), allocatable :: unsupported
      integer :: status

      graph = ComponentGraph()
      net_id = graph%get_default_network_id()

      export_id = graph%next_node_id(rc=status)
      export_node = StateItemNode(export_id, payload, revision)
      call graph%register_node(export_node, rc=status)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call export_map%insert(MOCK_CHARACTERISTIC_KIND, FakeCharacteristic('a'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('km'))
      call import_map%insert(MOCK_CHARACTERISTIC_KIND, FakeCharacteristic('b'))
      mismatched = find_mismatched_characteristics(export_map, import_map)
      @assertEqual(2, size(mismatched))

      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map, &
           mismatched, final_id, intermediate_ids, unsupported, rc=status)

      @assertEqual(0, status)
      @assertEqual('', unsupported)
      @assertFalse(final_id == export_id)
      ! openspec/changes/phase-11b-chain-intermediate-materialization,
      ! design.md D1/D5: a two-characteristic chain's own
      ! intermediate_ids array has length 2, its last entry equals
      ! final_node_id, and both entries are distinct NodeIds.
      @assertEqual(2, size(intermediate_ids))
      @assertTrue(intermediate_ids(2) == final_id)
      @assertFalse(intermediate_ids(1) == intermediate_ids(2))
      @assertFalse(intermediate_ids(1) == export_id)
   end subroutine test_multi_step_chain_with_fake_characteristic

   @test
   subroutine test_no_mismatch_case_creates_nothing()
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      mismatched = find_mismatched_characteristics(export_map, import_map)

      ! spec "No-op case creates nothing": nothing to chain-build - the
      ! no-mismatch case is handled entirely by the caller
      ! (GraphBuilder.F90's resolve_one) wiring the import directly to
      ! the export, never calling find_or_build_extension_chain at all.
      @assertEqual(0, size(mismatched))
   end subroutine test_no_mismatch_case_creates_nothing

   ! -- unregistered characteristic --------------------------------------

   @test
   subroutine test_unregistered_characteristic_fails_loudly()
      type(ComponentGraph), target :: graph
      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id
      type(StateItemNode) :: export_node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)
      type(NodeId) :: final_id
      type(NodeId), allocatable :: intermediate_ids(:)
      character(:), allocatable :: unsupported
      integer :: status

      graph = ComponentGraph()
      net_id = graph%get_default_network_id()

      export_id = graph%next_node_id(rc=status)
      export_node = StateItemNode(export_id, payload, revision)
      call graph%register_node(export_node, rc=status)

      call export_map%insert(VERTICAL_COORDINATE_CHARACTERISTIC_KIND, VerticalCoordinateCharacteristic(grid_id='gridA'))
      call import_map%insert(VERTICAL_COORDINATE_CHARACTERISTIC_KIND, VerticalCoordinateCharacteristic(grid_id='gridB'))
      mismatched = find_mismatched_characteristics(export_map, import_map)

      ! VerticalCoordinateCharacteristic%build_transform always fails -
      ! no real vertical-regrid Transform exists yet.
      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map, &
           mismatched, final_id, intermediate_ids, unsupported, rc=status)

      @assertEqual(0, status)
      @assertEqual('VERTICAL_COORDINATE', unsupported)
   end subroutine test_unregistered_characteristic_fails_loudly

   ! -- reuse -------------------------------------------------------------

   @test
   subroutine test_reuse_second_import_same_variant()
      type(ComponentGraph), target :: graph
      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id
      type(StateItemNode) :: export_node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)
      type(NodeId) :: final_id1, final_id2
      type(NodeId), allocatable :: intermediate_ids1(:), intermediate_ids2(:)
      character(:), allocatable :: unsupported
      integer :: status

      graph = ComponentGraph()
      net_id = graph%get_default_network_id()

      export_id = graph%next_node_id(rc=status)
      export_node = StateItemNode(export_id, payload, revision)
      call graph%register_node(export_node, rc=status)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('km'))
      mismatched = find_mismatched_characteristics(export_map, import_map)

      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map, &
           mismatched, final_id1, intermediate_ids1, unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, size(intermediate_ids1))

      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map, &
           mismatched, final_id2, intermediate_ids2, unsupported, rc=status)
      @assertEqual(0, status)

      @assertTrue(final_id1 == final_id2)
      ! openspec/changes/phase-11b-chain-intermediate-materialization,
      ! design.md D1: the reuse-hit path returns a zero-size
      ! intermediate_node_ids array - a reused chain's own links were
      ! already materialized by the first call, no re-materialization
      ! work is ever needed.
      @assertEqual(0, size(intermediate_ids2))
   end subroutine test_reuse_second_import_same_variant

   @test
   subroutine test_different_variant_creates_new_extension()
      type(ComponentGraph), target :: graph
      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id
      type(StateItemNode) :: export_node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map1, import_map2
      type(StateItemCharacteristicKind), allocatable :: mismatched1(:), mismatched2(:)
      type(NodeId) :: final_id1, final_id2
      type(NodeId), allocatable :: intermediate_ids1(:), intermediate_ids2(:)
      character(:), allocatable :: unsupported
      integer :: status

      graph = ComponentGraph()
      net_id = graph%get_default_network_id()

      export_id = graph%next_node_id(rc=status)
      export_node = StateItemNode(export_id, payload, revision)
      call graph%register_node(export_node, rc=status)

      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call import_map1%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('km'))
      call import_map2%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('cm'))

      mismatched1 = find_mismatched_characteristics(export_map, import_map1)
      mismatched2 = find_mismatched_characteristics(export_map, import_map2)

      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map1, &
           mismatched1, final_id1, intermediate_ids1, unsupported, rc=status)
      @assertEqual(0, status)

      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map2, &
           mismatched2, final_id2, intermediate_ids2, unsupported, rc=status)
      @assertEqual(0, status)

      @assertFalse(final_id1 == final_id2)
      @assertEqual(1, size(intermediate_ids2))
   end subroutine test_different_variant_creates_new_extension

   ! -- openspec/changes/phase-7a-shape-dispatch-wiring, task 9.2/9.3:
   ! a genuine BRACKET (export) -> FIELD (import) mismatch is reported
   ! by find_mismatched_characteristics and successfully chain-built -
   ! no unsupported_characteristic - producing one
   ! BracketTimeInterpolationTransform-backed extension node (design.md
   ! D7(a), structure-only - find_mismatched_characteristics/build_chain
   ! exercised directly, exactly as every other characteristic above,
   ! with no GraphBuilder/OuterMetaComponent involved). ------------------

   @test
   subroutine test_bracket_to_field_mismatch_builds_interpolation_chain()
      type(ComponentGraph), target :: graph
      type(DependencyNetworkId) :: net_id
      type(NodeId) :: export_id
      type(StateItemNode) :: export_node
      type(GraphStateItem) :: payload
      type(NodeRevision) :: revision
      type(StateItemCharacteristicMap) :: export_map, import_map
      type(StateItemCharacteristicKind), allocatable :: mismatched(:)
      type(NodeId) :: final_id
      type(NodeId), allocatable :: intermediate_ids(:)
      character(:), allocatable :: unsupported
      integer :: status

      graph = ComponentGraph()
      net_id = graph%get_default_network_id()

      export_id = graph%next_node_id(rc=status)
      export_node = StateItemNode(export_id, payload, revision)
      call graph%register_node(export_node, rc=status)

      ! Units/typekind deliberately matched on both sides - isolating
      ! the shape axis (task 9.2's own stated intent).
      call export_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call export_map%insert(ITEM_SHAPE_CHARACTERISTIC_KIND, ItemShapeCharacteristic(MAPL_STATEITEM_BRACKET))
      call import_map%insert(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      call import_map%insert(ITEM_SHAPE_CHARACTERISTIC_KIND, ItemShapeCharacteristic(MAPL_STATEITEM_FIELD))

      mismatched = find_mismatched_characteristics(export_map, import_map)
      @assertEqual(1, size(mismatched))
      @assertTrue(mismatched(1) == ITEM_SHAPE_CHARACTERISTIC_KIND)

      call find_or_build_extension_chain(graph, net_id, export_id, export_map, import_map, &
           mismatched, final_id, intermediate_ids, unsupported, rc=status)

      @assertEqual(0, status)
      @assertEqual('', unsupported)
      @assertFalse(final_id == export_id)
      @assertEqual(1, size(intermediate_ids))
      @assertTrue(intermediate_ids(1) == final_id)
   end subroutine test_bracket_to_field_mismatch_builds_interpolation_chain

end module Test_ExtensionResolution
