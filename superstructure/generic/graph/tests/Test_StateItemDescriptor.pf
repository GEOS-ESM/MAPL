module Test_StateItemDescriptor
   use mapl_StateItemDescriptor_mod, only: StateItemDescriptor
   use mapl_NodeId_mod, only: NodeId, NodeIdGenerator
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristic, SYNC_PHASE_STRUCTURAL, &
        SYNC_PHASE_DESCRIPTIVE
   use mapl_StateItemCharacteristicKind_mod, only: PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
        GEOMETRY_CHARACTERISTIC_KIND
   use mapl_CharacteristicStatus_mod, only: CHARACTERISTIC_STATUS_UNCHECKED
   use mapl_PhysicalUnitsCharacteristic_mod, only: PhysicalUnitsCharacteristic, UNKNOWN_UNITS
   use mapl_GeometryCharacteristic_mod, only: GeometryCharacteristic
   use mapl_GraphStateItem_mod, only: GraphStateItem
   use mapl_field_api, only: MAPL_FieldGet
   use mapl_field_bundle_api, only: MAPL_FieldBundleGet
   use ESMF, only: ESMF_Field, ESMF_FieldEmptyCreate, ESMF_FieldDestroy, &
        ESMF_FieldBundle, ESMF_FieldBundleCreate, ESMF_FieldBundleDestroy
   use funit
   implicit none

contains

   @test
   subroutine test_characteristics_map_starts_empty()
      type(StateItemDescriptor) :: item

      @assertFalse(item%has_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND))
   end subroutine test_characteristics_map_starts_empty

   ! Spec "Established characteristic is retrievable by its type tag":
   ! round-trips through set_characteristic/get_characteristic/
   ! has_characteristic, and a never-established kind stays absent
   ! rather than reporting some INVALID placeholder.
   @test
   subroutine test_set_get_characteristic_roundtrip()
      type(StateItemDescriptor) :: item
      class(StateItemCharacteristic), allocatable :: found
      integer :: status

      @assertFalse(item%has_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND))

      call item%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'), rc=status)
      @assertEqual(0, status)

      @assertTrue(item%has_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND))
      @assertFalse(item%has_characteristic(GEOMETRY_CHARACTERISTIC_KIND))

      call item%get_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, found, rc=status)
      @assertEqual(0, status)
      select type (found)
      class is (PhysicalUnitsCharacteristic)
         @assertEqual('m', found%get_units())
      class default
         @assertTrue(.false.)
      end select
   end subroutine test_set_get_characteristic_roundtrip

   @test
   subroutine test_get_characteristic_absent_fails_explicitly()
      type(StateItemDescriptor) :: item
      class(StateItemCharacteristic), allocatable :: found
      integer :: status

      call item%get_characteristic(GEOMETRY_CHARACTERISTIC_KIND, found, rc=status)
      @assertTrue(status /= 0)
   end subroutine test_get_characteristic_absent_fails_explicitly

   @test
   subroutine test_set_characteristic_replaces_existing_entry()
      type(StateItemDescriptor) :: item
      class(StateItemCharacteristic), allocatable :: found
      integer :: status

      call item%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'), rc=status)
      call item%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('km'), rc=status)
      @assertEqual(0, status)

      call item%get_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, found, rc=status)
      select type (found)
      class is (PhysicalUnitsCharacteristic)
         @assertEqual('km', found%get_units())
      class default
         @assertTrue(.false.)
      end select
   end subroutine test_set_characteristic_replaces_existing_entry

   ! REQ-CHAR-006/009 invariant: a characteristic may only be stored
   ! under its own kind's key - set_characteristic rejects a mismatched
   ! pairing explicitly rather than silently accepting it (which would
   ! otherwise let find_mismatched_state_item_characteristics pair a
   ! GeometryCharacteristic against a PhysicalUnitsCharacteristic goal
   ! later, a defect no reconciling Transform could ever resolve).
   @test
   subroutine test_set_characteristic_rejects_kind_mismatch()
      type(StateItemDescriptor) :: item
      type(NodeIdGenerator) :: gen
      type(NodeId) :: id
      integer :: status

      id = gen%next()
      call item%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, GeometryCharacteristic(id), rc=status)
      @assertTrue(status /= 0)
      @assertFalse(item%has_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND))
   end subroutine test_set_characteristic_rejects_kind_mismatch

   @test
   subroutine test_sync_structural_writes_specified_units()
      type(StateItemDescriptor) :: item
      character(:), allocatable :: units

      call item%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      units = synced_units(item, SYNC_PHASE_STRUCTURAL)
      @assertEqual('m', units)
   end subroutine test_sync_structural_writes_specified_units

   @test
   subroutine test_sync_structural_writes_unknown_for_unchecked_units()
      type(StateItemDescriptor) :: item
      type(PhysicalUnitsCharacteristic) :: unchecked
      character(:), allocatable :: units

      call unchecked%set_status(CHARACTERISTIC_STATUS_UNCHECKED)
      call item%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, unchecked)
      units = synced_units(item, SYNC_PHASE_STRUCTURAL)
      @assertEqual(UNKNOWN_UNITS, units)
   end subroutine test_sync_structural_writes_unknown_for_unchecked_units

   ! units= on a completed field would enter FieldDelta.
   @test
   subroutine test_sync_descriptive_skips_units()
      type(StateItemDescriptor) :: item
      character(:), allocatable :: units

      call item%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('m'))
      units = synced_units(item, SYNC_PHASE_DESCRIPTIVE)
      @assertEqual('(none)', units)
   end subroutine test_sync_descriptive_skips_units

   @test
   subroutine test_sync_skips_invalid_characteristic()
      type(StateItemDescriptor) :: item
      type(PhysicalUnitsCharacteristic) :: invalid
      character(:), allocatable :: units

      call item%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, invalid)
      units = synced_units(item, SYNC_PHASE_STRUCTURAL)
      @assertEqual('(none)', units)
   end subroutine test_sync_skips_invalid_characteristic

   @test
   subroutine test_sync_structural_writes_units_on_bundle()
      type(StateItemDescriptor) :: item
      type(GraphStateItem) :: handle
      type(ESMF_FieldBundle) :: bundle
      character(:), allocatable :: units
      integer :: status

      call item%set_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, PhysicalUnitsCharacteristic('K'))
      bundle = ESMF_FieldBundleCreate(rc=status)
      @assertEqual(0, status)
      call handle%set(bundle, rc=status)
      @assertEqual(0, status)
      call item%sync_to_info(handle, SYNC_PHASE_STRUCTURAL, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldBundleGet(bundle, units=units, rc=status)
      @assertEqual(0, status)
      @assertEqual('K', units)
      call ESMF_FieldBundleDestroy(bundle, noGarbage=.true.)
   end subroutine test_sync_structural_writes_units_on_bundle

   @test
   subroutine test_sync_fails_for_kind_without_write_info()
      type(StateItemDescriptor) :: item
      type(NodeIdGenerator) :: gen
      type(GraphStateItem) :: handle
      type(ESMF_Field) :: field
      integer :: status

      call item%set_characteristic(GEOMETRY_CHARACTERISTIC_KIND, GeometryCharacteristic(gen%next()))
      field = ESMF_FieldEmptyCreate(name='f', rc=status)
      @assertEqual(0, status)
      call handle%set(field)
      call item%sync_to_info(handle, SYNC_PHASE_STRUCTURAL, rc=status)
      @assertTrue(status /= 0)
      call ESMF_FieldDestroy(field, noGarbage=.true.)
   end subroutine test_sync_fails_for_kind_without_write_info

   function synced_units(item, phase) result(units)
      type(StateItemDescriptor), intent(in) :: item
      integer, intent(in) :: phase
      character(:), allocatable :: units

      type(GraphStateItem) :: handle
      type(ESMF_Field) :: field
      integer :: status

      field = ESMF_FieldEmptyCreate(name='f', rc=status)
      @assertEqual(0, status)
      call handle%set(field, rc=status)
      @assertEqual(0, status)
      call item%sync_to_info(handle, phase, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(field, units=units, rc=status)
      @assertEqual(0, status)
      if (.not. allocated(units)) units = '(none)'
      call ESMF_FieldDestroy(field, noGarbage=.true.)
   end function synced_units

end module Test_StateItemDescriptor
