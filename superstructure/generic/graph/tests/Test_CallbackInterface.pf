      spec = iface%get_call_scalar('time_step', rc=status)
      @assertEqual(0, status)
      @assertTrue(spec%get_value_type() == CALLBACK_VALUE_STRING)
      @assertTrue(spec%get_writer() == CALLBACK_WRITER_INVOKER)
