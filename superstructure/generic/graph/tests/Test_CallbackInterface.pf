! Spec: spec/15-callbacks.md.
module Test_CallbackInterface
   use mapl_CallbackInterface_mod, only: CallbackInterface, &
        make_CallbackInterface
   use mapl_CallbackArgumentSpec_mod, only: CallbackArgumentSpec
   use mapl_CallbackAttributeSpec_mod, only: CallbackAttributeSpec, &
        CALLBACK_SCOPE_MEMBER, CALLBACK_SCOPE_STATE, operator(==)
   use mapl_CallbackCallScalarSpec_mod, only: CallbackCallScalarSpec, &
        CALLBACK_WRITER_INVOKER, CALLBACK_WRITER_HANDLER, operator(==)
   use mapl_CallbackRule_mod, only: CallbackRule
   use mapl_CallbackRuleVector_mod, only: CallbackRuleVector
   use mapl_CallbackValueType_mod, only: CALLBACK_VALUE_INTEGER, &
        CALLBACK_VALUE_REAL, CALLBACK_VALUE_LOGICAL, CALLBACK_VALUE_STRING, &
        operator(==)
   use mapl_CallbackArgumentOptions_mod, only: CallbackArgumentOptions, &
        operator(==), CALLBACK_PUT_FLAVOUR_VALUE
   use mapl_CallbackMethodSpec_mod, only: CallbackMethodSpec
   use gFTL2_StringVector, only: StringVector
   use mapl_AccessSpec_mod, only: AccessSpec, operator(==), &
        MAPL_ACCESS_OUT, MAPL_ACCESS_IN
   use mapl_StateItemFlag_mod, only: MAPL_STATEITEM_FIELDBUNDLE, &
        MAPL_STATEITEM_FIELD, operator(==)
   use funit
   implicit none

contains

   @test
   subroutine test_declare_argument_and_retrieve()
      type(CallbackInterface) :: iface
      type(CallbackArgumentSpec) :: spec
      integer :: status

      call iface%declare_argument('tracers', MAPL_STATEITEM_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      @assertTrue(iface%is_argument('tracers'))

      spec = iface%get_argument('tracers', rc=status)
      @assertEqual(0, status)
      @assertEqual('tracers', spec%get_name())
      @assertTrue(spec%get_expected_kind() == MAPL_STATEITEM_FIELDBUNDLE)
   end subroutine test_declare_argument_and_retrieve

   @test
   subroutine test_duplicate_argument_name_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_argument('tracers', MAPL_STATEITEM_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('tracers', MAPL_STATEITEM_FIELDBUNDLE, rc=status)
      @assertTrue(status /= 0)
   end subroutine test_duplicate_argument_name_rejected

   @test
   subroutine test_declare_method_and_retrieve()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_method('get', rc=status)
      @assertEqual(0, status)
      @assertTrue(iface%is_method('get'))
   end subroutine test_declare_method_and_retrieve

   @test
   subroutine test_duplicate_method_name_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_method('get', rc=status)
      @assertEqual(0, status)

      call iface%declare_method('get', rc=status)
      @assertTrue(status /= 0)
   end subroutine test_duplicate_method_name_rejected

   @test
   subroutine test_set_method_argument_access_rejects_undeclared_argument()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_method('get', rc=status)
      @assertEqual(0, status)

      call iface%set_method_argument_access('get', 'tracers', MAPL_ACCESS_OUT, rc=status)
      @assertTrue(status /= 0)
   end subroutine test_set_method_argument_access_rejects_undeclared_argument

   @test
   subroutine test_set_method_argument_access_rejects_undeclared_method()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_argument('tracers', MAPL_STATEITEM_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)

      call iface%set_method_argument_access('get', 'tracers', MAPL_ACCESS_OUT, rc=status)
      @assertTrue(status /= 0)
   end subroutine test_set_method_argument_access_rejects_undeclared_method

   ! Spec scenario: "Same argument has different access modes in
   ! different methods" - the PassiveTracer example (15-callbacks.md
   ! §15.3).
   @test
   subroutine test_passive_tracer_example()
      type(CallbackInterface) :: iface
      type(CallbackMethodSpec) :: get_spec, put_spec
      type(AccessSpec) :: access
      integer :: status

      call iface%declare_argument('tracers', MAPL_STATEITEM_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)

      call iface%declare_method('get', rc=status)
      @assertEqual(0, status)
      call iface%declare_method('put', rc=status)
      @assertEqual(0, status)

      call iface%set_method_argument_access('get', 'tracers', MAPL_ACCESS_OUT, rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('put', 'tracers', MAPL_ACCESS_IN, rc=status)
      @assertEqual(0, status)

      get_spec = iface%get_method('get', rc=status)
      @assertEqual(0, status)
      access = get_spec%get_argument_access('tracers', rc=status)
      @assertEqual(0, status)
      @assertTrue(access == MAPL_ACCESS_OUT)

      put_spec = iface%get_method('put', rc=status)
      @assertEqual(0, status)
      access = put_spec%get_argument_access('tracers', rc=status)
      @assertEqual(0, status)
      @assertTrue(access == MAPL_ACCESS_IN)
   end subroutine test_passive_tracer_example

   ! Builds the turbulent_mixing-like argument set the cross-check tests
   ! share: mixed_quantity (required, xyz), air_mass (required, extensive,
   ! the weight of mixed_quantity) and offset_value (optional, xy).
   subroutine declare_mixing_arguments(iface, rc)
      type(CallbackInterface), intent(inout) :: iface
      integer, intent(out) :: rc

      call iface%declare_argument('mixed_quantity', MAPL_STATEITEM_FIELD, &
           dims='xyz', rc=rc)
      if (rc /= 0) return
      call iface%declare_argument('air_mass', MAPL_STATEITEM_FIELD, &
           dims='xyz', extensive=.true., weight_for='mixed_quantity', rc=rc)
      if (rc /= 0) return
      call iface%declare_argument('offset_value', MAPL_STATEITEM_FIELD, &
           dims='xy', optional=.true., rc=rc)
   end subroutine declare_mixing_arguments

   ! ---- version, summary, description ----

   @test
   subroutine test_version_and_summary_retrievable()
      type(CallbackInterface) :: iface
      integer :: status

      iface = make_CallbackInterface(1, 'Scale a field', rc=status)
      @assertEqual(0, status)
      @assertEqual(1, iface%get_version())
      @assertEqual('Scale a field', iface%get_summary())
      @assertFalse(iface%has_description())
   end subroutine test_version_and_summary_retrievable

   @test
   subroutine test_description_retrievable()
      type(CallbackInterface) :: iface
      integer :: status

      iface = make_CallbackInterface(3, 'Scale a field', &
           description='A longer text.', rc=status)
      @assertEqual(0, status)
      @assertEqual(3, iface%get_version())
      @assertTrue(iface%has_description())
      @assertEqual('A longer text.', iface%get_description())
   end subroutine test_description_retrievable

   @test
   subroutine test_version_below_one_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      iface = make_CallbackInterface(0, 'Scale a field', rc=status)
      @assertTrue(status /= 0)
      iface = make_CallbackInterface(-2, 'Scale a field', rc=status)
      @assertTrue(status /= 0)
   end subroutine test_version_below_one_rejected

   @test
   subroutine test_blank_or_multiline_summary_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      iface = make_CallbackInterface(1, '   ', rc=status)
      @assertTrue(status /= 0)
      iface = make_CallbackInterface(1, 'one' // new_line('a') // 'two', &
           rc=status)
      @assertTrue(status /= 0)
   end subroutine test_blank_or_multiline_summary_rejected

   ! The structure constructor stores what it is given and checks nothing.
   @test
   subroutine test_structure_constructor_does_not_validate()
      type(CallbackInterface) :: iface

      iface = CallbackInterface(0, 'text')
      @assertEqual(0, iface%get_version())
      @assertEqual('text', iface%get_summary())
   end subroutine test_structure_constructor_does_not_validate

   ! ---- attribute schema ----

   @test
   subroutine test_attribute_with_allowed_values_retrievable()
      type(CallbackInterface) :: iface
      type(CallbackAttributeSpec) :: spec
      type(StringVector) :: allowed
      integer :: status

      call iface%declare_attribute('operation', CALLBACK_VALUE_STRING, &
           scope=CALLBACK_SCOPE_STATE, required=.true., &
           allowed_values=['scale ', 'offset'], rc=status)
      @assertEqual(0, status)
      @assertTrue(iface%is_attribute('operation'))

      spec = iface%get_attribute('operation', rc=status)
      @assertEqual(0, status)
      @assertTrue(spec%get_value_type() == CALLBACK_VALUE_STRING)
      @assertTrue(spec%get_scope() == CALLBACK_SCOPE_STATE)
      @assertTrue(spec%is_required())
      @assertTrue(spec%has_allowed_values())
      allowed = spec%get_allowed_strings(rc=status)
      @assertEqual(2, allowed%size())
      @assertEqual('scale', allowed%of(1))
      @assertEqual('offset', allowed%of(2))
   end subroutine test_attribute_with_allowed_values_retrievable

   @test
   subroutine test_attribute_default_on_required_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_attribute('operation', CALLBACK_VALUE_STRING, &
           scope=CALLBACK_SCOPE_STATE, required=.true., default='scale', &
           rc=status)
      @assertTrue(status /= 0)
      @assertFalse(iface%is_attribute('operation'))
   end subroutine test_attribute_default_on_required_rejected

   @test
   subroutine test_attribute_default_outside_allowed_set_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_attribute('operation', CALLBACK_VALUE_STRING, &
           scope=CALLBACK_SCOPE_STATE, allowed_values=['a', 'b'], &
           default='c', rc=status)
      @assertTrue(status /= 0)
   end subroutine test_attribute_default_outside_allowed_set_rejected

   @test
   subroutine test_attribute_allowed_set_on_real_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_attribute('factor', CALLBACK_VALUE_REAL, &
           scope=CALLBACK_SCOPE_STATE, allowed_values=[1.0, 2.0], &
           rc=status)
      @assertTrue(status /= 0)
   end subroutine test_attribute_allowed_set_on_real_rejected

   @test
   subroutine test_duplicate_attribute_name_rejected()
      type(CallbackInterface) :: iface
      type(CallbackAttributeSpec) :: spec
      integer :: status

      call iface%declare_attribute('factor', CALLBACK_VALUE_REAL, &
           scope=CALLBACK_SCOPE_STATE, default=2.0, rc=status)
      @assertEqual(0, status)
      call iface%declare_attribute('factor', CALLBACK_VALUE_INTEGER, &
           scope=CALLBACK_SCOPE_STATE, rc=status)
      @assertTrue(status /= 0)

      ! The first declaration stands.
      spec = iface%get_attribute('factor', rc=status)
      @assertTrue(spec%get_value_type() == CALLBACK_VALUE_REAL)
   end subroutine test_duplicate_attribute_name_rejected

   @test
   subroutine test_get_undeclared_attribute_rejected()
      type(CallbackInterface) :: iface
      type(CallbackAttributeSpec) :: spec
      integer :: status

      spec = iface%get_attribute('nothing', rc=status)
      @assertTrue(status /= 0)
   end subroutine test_get_undeclared_attribute_rejected

   ! ---- host argument ----

   @test
   subroutine test_host_argument_retrievable()
      type(CallbackInterface) :: iface
      type(CallbackAttributeSpec) :: spec
      integer :: status

      call declare_mixing_arguments(iface, status)
      @assertEqual(0, status)

      call iface%declare_attribute('mix_like', CALLBACK_VALUE_STRING, &
           host_argument='mixed_quantity', rc=status)
      @assertEqual(0, status)

      spec = iface%get_attribute('mix_like', rc=status)
      @assertEqual(0, status)
      @assertTrue(spec%get_scope() == CALLBACK_SCOPE_MEMBER)
      @assertEqual('mixed_quantity', spec%get_host_argument())
   end subroutine test_host_argument_retrievable

