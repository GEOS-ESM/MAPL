   ! ---- rules ----

   subroutine declare_scaling_interface(iface, rc)
      type(CallbackInterface), intent(inout) :: iface
      integer, intent(out) :: rc

      call declare_mixing_arguments(iface, rc)
      if (rc /= 0) return
      call iface%declare_attribute('operation', CALLBACK_VALUE_STRING, &
           scope=CALLBACK_SCOPE_STATE, required=.true., &
           allowed_values=['scale ', 'offset'], rc=rc)
   end subroutine declare_scaling_interface

   @test
   subroutine test_rule_retrievable()
      type(CallbackInterface) :: iface
      type(CallbackRuleVector) :: rules
      type(CallbackRule) :: rule
      type(StringVector) :: required
      integer :: status

      call declare_scaling_interface(iface, status)
      @assertEqual(0, status)

      call iface%declare_rule('operation', 'offset', ['offset_value'], &
           rc=status)
      @assertEqual(0, status)

      rules = iface%get_rules()
      @assertEqual(1, rules%size())
      rule = rules%of(1)
      @assertEqual('operation', rule%get_attribute())
      @assertEqual('offset', rule%get_value())
      required = rule%get_required_arguments()
      @assertEqual(1, required%size())
      @assertEqual('offset_value', required%of(1))
   end subroutine test_rule_retrievable

   @test
   subroutine test_rules_keep_declaration_order()
      type(CallbackInterface) :: iface
      type(CallbackRuleVector) :: rules
      type(CallbackRule) :: rule
      integer :: status

      call declare_scaling_interface(iface, status)
      @assertEqual(0, status)

      call iface%declare_rule('operation', 'offset', ['offset_value'], &
           rc=status)
      @assertEqual(0, status)
      call iface%declare_rule('operation', 'scale', ['offset_value'], &
           rc=status)
      @assertEqual(0, status)

      rules = iface%get_rules()
      @assertEqual(2, rules%size())
      rule = rules%of(2)
      @assertEqual('scale', rule%get_value())
   end subroutine test_rules_keep_declaration_order

   @test
   subroutine test_rule_naming_required_argument_rejected()
      type(CallbackInterface) :: iface
      type(CallbackRuleVector) :: rules
      integer :: status

      call declare_scaling_interface(iface, status)
      @assertEqual(0, status)

      call iface%declare_rule('operation', 'offset', ['mixed_quantity'], &
           rc=status)
      @assertTrue(status /= 0)
      call iface%declare_rule('operation', 'offset', &
           ['offset_value  ', 'mixed_quantity'], rc=status)
      @assertTrue(status /= 0)

      rules = iface%get_rules()
      @assertEqual(0, rules%size())
   end subroutine test_rule_naming_required_argument_rejected

