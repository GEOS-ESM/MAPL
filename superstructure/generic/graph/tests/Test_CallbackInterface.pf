      call declare_scaling_interface(iface, status)
      @assertEqual(0, status)

      call iface%declare_rule('operation', 'offset', ['offset_valu'], &
           rc=status)
      @assertTrue(status /= 0)
   end subroutine test_rule_naming_unknown_argument_rejected

   @test
   subroutine test_rule_value_outside_allowed_set_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call declare_scaling_interface(iface, status)
      @assertEqual(0, status)

      call iface%declare_rule('operation', 'rotate', ['offset_value'], &
           rc=status)
      @assertTrue(status /= 0)
   end subroutine test_rule_value_outside_allowed_set_rejected

   @test
   subroutine test_rule_value_must_have_attribute_type()
      type(CallbackInterface) :: iface
      integer :: status

      call declare_mixing_arguments(iface, status)
      @assertEqual(0, status)
      call iface%declare_attribute('mode', CALLBACK_VALUE_INTEGER, &
           scope=CALLBACK_SCOPE_STATE, allowed_values=[1, 2, 3], &
           rc=status)
      @assertEqual(0, status)
      call iface%declare_attribute('flag', CALLBACK_VALUE_LOGICAL, &
           scope=CALLBACK_SCOPE_STATE, rc=status)
      @assertEqual(0, status)
      call iface%declare_attribute('factor', CALLBACK_VALUE_REAL, &
           scope=CALLBACK_SCOPE_STATE, rc=status)
      @assertEqual(0, status)

      call iface%declare_rule('mode', '2', ['offset_value'], rc=status)
      @assertEqual(0, status)
      call iface%declare_rule('mode', 'two', ['offset_value'], rc=status)
      @assertTrue(status /= 0)
      call iface%declare_rule('mode', '4', ['offset_value'], rc=status)
      @assertTrue(status /= 0)

      call iface%declare_rule('flag', 'true', ['offset_value'], rc=status)
      @assertEqual(0, status)
      call iface%declare_rule('flag', 'yes', ['offset_value'], rc=status)
      @assertTrue(status /= 0)

      call iface%declare_rule('factor', '2.5', ['offset_value'], rc=status)
      @assertEqual(0, status)
      call iface%declare_rule('factor', 'big', ['offset_value'], rc=status)
      @assertTrue(status /= 0)
      ! Beyond default-real range, within 8-byte range.
      call iface%declare_rule('factor', '1.0e300', ['offset_value'], &
           rc=status)
      @assertEqual(0, status)

      call iface%declare_attribute('big', CALLBACK_VALUE_INTEGER, &
           scope=CALLBACK_SCOPE_STATE, rc=status)
      @assertEqual(0, status)
      call iface%declare_rule('big', '9223372036854775807', &
           ['offset_value'], rc=status)
      @assertEqual(0, status)
      call iface%declare_rule('big', '9223372036854775808', &
           ['offset_value'], rc=status)
      @assertTrue(status /= 0)
   end subroutine test_rule_value_must_have_attribute_type

   @test
   subroutine test_rule_on_list_attribute_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call declare_mixing_arguments(iface, status)
      @assertEqual(0, status)
      call iface%declare_attribute('names', CALLBACK_VALUE_STRING, &
           is_list=.true., scope=CALLBACK_SCOPE_STATE, rc=status)
      @assertEqual(0, status)

      call iface%declare_rule('names', 'a', ['offset_value'], rc=status)
      @assertTrue(status /= 0)
   end subroutine test_rule_on_list_attribute_rejected

   @test
   subroutine test_rule_that_requires_nothing_rejected()
      type(CallbackInterface) :: iface
      character(len=1) :: none(0)
      integer :: status

      call declare_scaling_interface(iface, status)
      @assertEqual(0, status)

      call iface%declare_rule('operation', 'offset', none, rc=status)
      @assertTrue(status /= 0)
   end subroutine test_rule_that_requires_nothing_rejected

