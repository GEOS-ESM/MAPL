      integer :: status

      call iface%declare_call_scalar('time_step', CALLBACK_VALUE_STRING, &
           CALLBACK_WRITER_INVOKER, rc=status)
      @assertEqual(0, status)
      call iface%declare_call_scalar('time_step', CALLBACK_VALUE_INTEGER, &
           CALLBACK_WRITER_HANDLER, rc=status)
      @assertTrue(status /= 0)

      spec = iface%get_call_scalar('time_step', rc=status)
      @assertTrue(spec%get_writer() == CALLBACK_WRITER_INVOKER)
