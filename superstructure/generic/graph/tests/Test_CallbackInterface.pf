   ! ---- weights ----

   @test
   subroutine test_weight_relation_retrievable()
      type(CallbackInterface) :: iface
      type(CallbackArgumentSpec) :: spec
      integer :: status

      call declare_mixing_arguments(iface, status)
      @assertEqual(0, status)

      spec = iface%get_argument('air_mass', rc=status)
      @assertEqual(0, status)
      @assertTrue(spec%is_extensive())
      @assertTrue(spec%has_weight_for())
      @assertEqual('mixed_quantity', spec%get_weight_for())
   end subroutine test_weight_relation_retrievable

   @test
   subroutine test_weight_of_unknown_argument_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_argument('mixed_quantity', MAPL_STATEITEM_FIELD, &
           dims='xyz', rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('air_mass', MAPL_STATEITEM_FIELD, &
           dims='xyz', extensive=.true., weight_for='mixed_quantiy', &
           rc=status)
      @assertTrue(status /= 0)
      @assertFalse(iface%is_argument('air_mass'))
   end subroutine test_weight_of_unknown_argument_rejected

   ! A weight is declared after the argument it weights; the reverse
   ! order names an argument that does not exist yet.
   @test
   subroutine test_weight_declared_before_weighted_argument_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_argument('air_mass', MAPL_STATEITEM_FIELD, &
           dims='xyz', extensive=.true., weight_for='mixed_quantity', &
           rc=status)
      @assertTrue(status /= 0)
   end subroutine test_weight_declared_before_weighted_argument_rejected

   @test
   subroutine test_non_extensive_weight_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_argument('mixed_quantity', MAPL_STATEITEM_FIELD, &
           dims='xyz', rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('air_mass', MAPL_STATEITEM_FIELD, &
           dims='xyz', weight_for='mixed_quantity', rc=status)
      @assertTrue(status /= 0)
   end subroutine test_non_extensive_weight_rejected

   @test
   subroutine test_weight_of_extensive_argument_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_argument('mixed_quantity', MAPL_STATEITEM_FIELD, &
           dims='xyz', extensive=.true., rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('air_mass', MAPL_STATEITEM_FIELD, &
           dims='xyz', extensive=.true., weight_for='mixed_quantity', &
           rc=status)
      @assertTrue(status /= 0)
   end subroutine test_weight_of_extensive_argument_rejected

   @test
   subroutine test_optional_weight_of_required_argument_rejected()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_argument('mixed_quantity', MAPL_STATEITEM_FIELD, &
           dims='xyz', rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('air_mass', MAPL_STATEITEM_FIELD, &
           dims='xyz', extensive=.true., optional=.true., &
           weight_for='mixed_quantity', rc=status)
      @assertTrue(status /= 0)
   end subroutine test_optional_weight_of_required_argument_rejected

   ! An optional weight of an optional argument is consistent.
   @test
   subroutine test_optional_weight_of_optional_argument_accepted()
      type(CallbackInterface) :: iface
      integer :: status

      call iface%declare_argument('mixed_quantity', MAPL_STATEITEM_FIELD, &
           dims='xyz', optional=.true., rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('air_mass', MAPL_STATEITEM_FIELD, &
           dims='xyz', extensive=.true., optional=.true., &
           weight_for='mixed_quantity', rc=status)
      @assertEqual(0, status)
   end subroutine test_optional_weight_of_optional_argument_accepted

   ! ---- units ----

   @test
   subroutine test_concrete_units_passed_through()
      type(CallbackInterface) :: iface
      type(CallbackArgumentSpec) :: spec
      integer :: status

      call iface%declare_argument('mixed_quantity', MAPL_STATEITEM_FIELD, &
           dims='xyz', units='kg kg-1', rc=status)
      @assertEqual(0, status)

      spec = iface%get_argument('mixed_quantity', rc=status)
      @assertEqual(0, status)
      @assertTrue(spec%has_units())
      @assertEqual('kg kg-1', spec%get_units())
   end subroutine test_concrete_units_passed_through

   ! Arguments sharing a placeholder are linked only by the shared raw
   ! name; no agreement check runs here.
   @test
   subroutine test_two_arguments_share_a_placeholder_name()
      type(CallbackInterface) :: iface
      type(CallbackArgumentSpec) :: mixed_quantity, offset_value
      integer :: status

      call iface%declare_argument('mixed_quantity', MAPL_STATEITEM_FIELD, &
           dims='xyz', units='$U', rc=status)
      @assertEqual(0, status)
      call iface%declare_argument('offset_value', MAPL_STATEITEM_FIELD, &
           dims='xy', optional=.true., units='$U', rc=status)
      @assertEqual(0, status)

      mixed_quantity = iface%get_argument('mixed_quantity', rc=status)
      @assertEqual(0, status)
      offset_value = iface%get_argument('offset_value', rc=status)
      @assertEqual(0, status)
      @assertTrue(mixed_quantity%has_units())
      @assertTrue(offset_value%has_units())
      @assertEqual('$U', mixed_quantity%get_units())
      @assertEqual(mixed_quantity%get_units(), offset_value%get_units())
   end subroutine test_two_arguments_share_a_placeholder_name

   @test
   subroutine test_argument_without_units_declared()
      type(CallbackInterface) :: iface
      type(CallbackArgumentSpec) :: spec
      integer :: status

      call iface%declare_argument('tracers', MAPL_STATEITEM_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)

      spec = iface%get_argument('tracers', rc=status)
      @assertEqual(0, status)
      @assertFalse(spec%has_units())
      @assertEqual('', spec%get_units())
   end subroutine test_argument_without_units_declared

   ! ---- method argument options ----

   @test
   subroutine test_method_argument_options_forwarded()
      type(CallbackInterface) :: iface
      type(CallbackMethodSpec) :: put_spec
      type(CallbackArgumentOptions) :: options, reported
      type(AccessSpec) :: access
      integer :: status

      call declare_mixing_arguments(iface, status)
      @assertEqual(0, status)
      call iface%declare_method('put', rc=status)
      @assertEqual(0, status)

      call options%set_option('put_flavour', 'value', rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('put', 'mixed_quantity', &
           MAPL_ACCESS_IN, options=options, rc=status)
      @assertEqual(0, status)

      put_spec = iface%get_method('put', rc=status)
      @assertEqual(0, status)
      access = put_spec%get_argument_access('mixed_quantity', rc=status)
      @assertTrue(access == MAPL_ACCESS_IN)
      reported = put_spec%get_argument_options('mixed_quantity', rc=status)
      @assertEqual(0, status)
      @assertTrue(reported%has_put_flavour())
      @assertTrue(reported%get_put_flavour() == CALLBACK_PUT_FLAVOUR_VALUE)
   end subroutine test_method_argument_options_forwarded

   ! Without options the argument reports no options.
   @test
   subroutine test_method_argument_without_options_reports_none()
      type(CallbackInterface) :: iface
      type(CallbackMethodSpec) :: get_spec
      type(CallbackArgumentOptions) :: reported
      integer :: status

      call declare_mixing_arguments(iface, status)
      @assertEqual(0, status)
      call iface%declare_method('get', rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('get', 'mixed_quantity', &
           MAPL_ACCESS_OUT, rc=status)
      @assertEqual(0, status)

      get_spec = iface%get_method('get', rc=status)
      reported = get_spec%get_argument_options('mixed_quantity', rc=status)
      @assertEqual(0, status)
      @assertFalse(reported%has_put_flavour())
   end subroutine test_method_argument_without_options_reports_none

end module Test_CallbackInterface
