   subroutine check_invalid_expression_reference(expression, item_name, &
        add_other, expected_reason, this)
      character(*), intent(in) :: expression, item_name, expected_reason
      logical, intent(in) :: add_other
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(VariableSpec) :: var_spec
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(GraphResolutionEntry), pointer :: entry
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_invalid_expression', outer_gc, outer_meta, &
           _RC)
      comp_spec => outer_meta%get_component_spec()
      if (add_other) then
         call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, &
              'A', units='m'))
         var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'other', units='m')
         var_spec%itemType = MAPL_STATEITEM_EXPRESSION
         var_spec%expression = 'A'
         call comp_spec%add_var_spec(var_spec)
      end if
      var_spec = make_var(ESMF_STATEINTENT_EXPORT, item_name, units='m')
      var_spec%itemType = MAPL_STATEITEM_EXPRESSION
      var_spec%expression = expression
      call comp_spec%add_var_spec(var_spec)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))
      call gb%run_expression_hook(outer_meta, unresolved=unresolved, &
           unsupported=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      entry => unsupported%at(1, status)
      @assertEqual(item_name, entry%short_name)
      @assertEqual(expected_reason, entry%reason)

      _UNUSED_DUMMY(this)
   end subroutine check_invalid_expression_reference

   ! A SERVICE import, which no ancestor connection could resolve, is
   ! excluded from the unresolved-import scan (is_ordinary_resolvable_import).
   @test(npes=[0])
   subroutine test_service_import_excluded_from_gate(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: child_meta
      type(GriddedComponentDriver) :: child_driver
      type(ESMF_GridComp) :: child_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: child_spec_obj
      type(VariableSpec) :: var_spec
      type(UnresolvedImportEntry), allocatable :: unresolved_ids(:)
      integer :: status
      type(GraphBuilder) :: gb
      integer :: i
      logical :: found_service, found_plain

      call make_outer_meta('comp_service_gate_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_svc', child_spec, _RC)
      child_driver = parent_meta%get_child('child_svc', _RC)
      child_gc = child_driver%get_gridcomp()
      child_meta => get_outer_meta(child_gc, _RC)

      child_spec_obj => child_meta%get_component_spec()

      var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'svc')
      var_spec%itemType = MAPL_STATEITEM_SERVICE
      call child_spec_obj%add_var_spec(var_spec)
      ! An ordinary unconnected import is reported, so the scan does run.
      call child_spec_obj%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'plain', units='m'))

      call gb%advertise(child_meta, status)
      @assert_that(status, is(0))

      unresolved_ids = graphbuilder_unresolved_import_node_ids(parent_meta, child_meta, status)
      @assert_that(status, is(0))

      found_service = .false.
      found_plain = .false.
      do i = 1, size(unresolved_ids)
         if (unresolved_ids(i)%short_name == 'svc') found_service = .true.
         if (unresolved_ids(i)%short_name == 'plain') found_plain = .true.
      end do
      @assert_that(found_plain, is(true()))
      @assert_that(found_service, is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_service_import_excluded_from_gate

   ! An unconnected WILDCARD import falls through to the unresolved-import
   ! scan's ordinary Connection-based check and never resolves that way: its
   ! real resolution is resolve_one's WILDCARD branch
   ! (resolve_wildcard_destination), reached only through a Connection. So it
   ! appears in the unresolved-imports report.
   @test(npes=[0])
   subroutine test_wildcard_no_longer_excluded_from_gate(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: child_meta
      type(GriddedComponentDriver) :: child_driver
      type(ESMF_GridComp) :: child_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: child_spec_obj
      type(VariableSpec) :: var_spec
      type(UnresolvedImportEntry), allocatable :: unresolved_ids(:)
      integer :: status
      type(GraphBuilder) :: gb
      integer :: i
      logical :: found_wildcard

      call make_outer_meta('comp_wildcard_gate_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_wild', child_spec, _RC)
      child_driver = parent_meta%get_child('child_wild', _RC)
      child_gc = child_driver%get_gridcomp()
      child_meta => get_outer_meta(child_gc, _RC)

      child_spec_obj => child_meta%get_component_spec()

      var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'wild')
      var_spec%itemType = MAPL_STATEITEM_WILDCARD
      call child_spec_obj%add_var_spec(var_spec)

      call gb%advertise(child_meta, status)
      @assert_that(status, is(0))

      unresolved_ids = graphbuilder_unresolved_import_node_ids(parent_meta, child_meta, status)
      @assert_that(status, is(0))

      found_wildcard = .false.
      do i = 1, size(unresolved_ids)
         if (unresolved_ids(i)%short_name == 'wild') found_wildcard = .true.
      end do
      @assert_that(found_wildcard, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_wildcard_no_longer_excluded_from_gate

   ! openspec/changes/phase-7c-wildcard-dispatch-wiring, tasks.md 3.1-3.6:
   ! fixture mirroring history_wildcard's own shape (root/A, root/B
   ! sources; a destination with a WILDCARD import matching across
   ! both) - a root component with two source children ('A' exporting
   ! 'E_A1'/'E_A2'/'E1_A0', 'B' exporting 'E_B1'/'E_B2') and a
   ! destination child ('dst') whose WILDCARD import's own declared
   ! short name is the regex pattern passed in (e.g. history_wildcard's
   ! own 'A/E_A.*', here parameterized so individual tests can vary it -
   ! 3.3's zero-match case needs a pattern that matches nothing).
   ! Advertises every child but does NOT resolve connections - callers
   ! add their own connection(s) and call gb%resolve_connections
   ! themselves (mirrors build_tracer_hierarchy's own split of "build
   ! the tree" from "wire the one connection under test").
   ! With add_non_field, 'A' also exports 'E_A3' (FIELDBUNDLE) and 'E_A4'
   ! (BRACKET): they match 'A/E_A.*' by name but are not Wildcard members.
   subroutine build_wildcard_hierarchy(name_suffix, wildcard_pattern, &
        root_gc, root_meta, a_meta, b_meta, dst_meta, rc, add_non_field)
      character(*), intent(in) :: name_suffix
      character(*), intent(in) :: wildcard_pattern
      type(ESMF_GridComp), intent(out) :: root_gc
      type(OuterMetaComponent), pointer, intent(out) :: root_meta
      type(OuterMetaComponent), pointer, intent(out) :: a_meta
      type(OuterMetaComponent), pointer, intent(out) :: b_meta
      type(OuterMetaComponent), pointer, intent(out) :: dst_meta
      integer, optional, intent(out) :: rc
      logical, optional, intent(in) :: add_non_field

      integer :: status
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: a_driver, b_driver, dst_driver
      type(ESMF_GridComp) :: a_gc, b_gc, dst_gc
      type(ComponentSpec), pointer :: a_spec, b_spec, dst_spec
      type(VariableSpec) :: wild_import
      type(VariableSpec) :: non_field
      type(GraphBuilder) :: gb

      call make_outer_meta('root_wild_' // name_suffix, root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('A', child_spec, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('B', child_spec, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('dst', child_spec, _RC)

      a_driver = root_meta%get_child('A', _RC)
      a_gc = a_driver%get_gridcomp()
      a_meta => get_outer_meta(a_gc, _RC)

      b_driver = root_meta%get_child('B', _RC)
      b_gc = b_driver%get_gridcomp()
      b_meta => get_outer_meta(b_gc, _RC)

      dst_driver = root_meta%get_child('dst', _RC)
      dst_gc = dst_driver%get_gridcomp()
      dst_meta => get_outer_meta(dst_gc, _RC)

      a_spec => a_meta%get_component_spec()
      call a_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'E_A1', units='m'))
      call a_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'E_A2', units='m'))
      call a_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'E1_A0', units='m'))
      if (present(add_non_field)) then
         if (add_non_field) then
            non_field = make_var(ESMF_STATEINTENT_EXPORT, 'E_A3', units='m')
            non_field%itemType = MAPL_STATEITEM_FIELDBUNDLE
            call a_spec%add_var_spec(non_field)
            non_field = make_var(ESMF_STATEINTENT_EXPORT, 'E_A4', units='m')
            non_field%itemType = MAPL_STATEITEM_BRACKET
            call a_spec%add_var_spec(non_field)
         end if
      end if

      b_spec => b_meta%get_component_spec()
      call b_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'E_B1', units='m'))
      call b_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'E_B2', units='m'))

      wild_import = make_var(ESMF_STATEINTENT_IMPORT, wildcard_pattern)
      wild_import%itemType = MAPL_STATEITEM_WILDCARD
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(wild_import)

      call gb%advertise(a_meta, _RC)
      call gb%advertise(b_meta, _RC)
      call gb%advertise(dst_meta, _RC)
      call gb%advertise(root_meta, _RC)

      _RETURN(_SUCCESS)
   end subroutine build_wildcard_hierarchy

   ! Task 3.1 ("construct a component with a WILDCARD-typed import ...
   ! and a sibling/descendant component tree with two or more real
   ! exports matching that pattern ... drive the match through a real
   ! MatchConnection/all_unsatisfied-style connection, run connection
   ! resolution, and assert ...") + 3.5 ("a matching export reachable
   ! only through a descendant's own qualified export name"):
   ! build_wildcard_hierarchy's own 'A'/'B' are direct children of
   ! root, not root itself, so every match here is already exercising
   ! build_qualified_export_namespace's cross-level qualification
   ! (qualified_name 'A/E_A1', not 'E_A1') - the same shape history_
   ! wildcard's own root/A, root/B hierarchy has one level up from this
   ! change's own single all_unsatisfied-style connection.
   @test(npes=[0])
   subroutine test_wildcard_import_fans_out_into_composite_members(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, a_meta, b_meta, dst_meta
      type(ComponentSpec), pointer :: root_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(ComponentGraph), pointer :: dst_graph, a_graph, b_graph
      type(NodeId), pointer :: import_id
      type(NodeId), pointer :: e_a1_id, e_a2_id
      class(GraphNode), pointer :: import_node
      type(GraphStateItem), pointer :: import_payload
      type(StateItemMemberMap), pointer :: members
      type(NodeId), pointer :: member_id
      integer :: status
      type(GraphBuilder) :: gb

      call build_wildcard_hierarchy('fanout', 'A/E_A.*', root_gc, root_meta, a_meta, b_meta, dst_meta, _RC)

      ! all_unsatisfied's own exact shape (ComponentSpecParser/
      ! parse_connections.F90): a single ^.*$/^.*$ MatchConnection
      ! spanning the whole root->dst relationship, matching every
      ! export against every import, wildcard or not.
      conn = MatchConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      root_spec => root_meta%get_component_spec()
      call root_spec%add_connection(conn)

      call gb%resolve_connections(root_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      dst_graph => dst_meta%get_component_graph()
      import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'A/E_A.*'))
      @assert_that(associated(import_id), is(true()))

      import_node => dst_graph%get_node(import_id)
      select type (import_node)
      class is (StateItemNode)
         import_payload => import_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select

      @assertTrue(import_payload%itemType(rc=status) == ESMF_STATEITEM_STATE)
      @assert_that(status, is(0))

      members => import_payload%state_members_ptr()
      @assertEqual(2, members%size())

      a_graph => a_meta%get_component_graph()
      b_graph => b_meta%get_component_graph()
      e_a1_id => a_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'E_A1'))
      e_a2_id => a_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'E_A2'))
      @assert_that(associated(e_a1_id), is(true()))
      @assert_that(associated(e_a2_id), is(true()))

      member_id => members%at('A/E_A1')
      @assert_that(associated(member_id), is(true()))
      @assert_that(member_id == e_a1_id, is(true()))

      member_id => members%at('A/E_A2')
      @assert_that(associated(member_id), is(true()))
      @assert_that(member_id == e_a2_id, is(true()))

      ! 'A/E1_A0' and every 'B/*' export do not match 'A/E_A.*' - never
      ! bound as members.
      @assert_that(associated(members%at('A/E1_A0')), is(false()))
      @assert_that(associated(members%at('B/E_B1')), is(false()))
      @assert_that(associated(members%at('B/E_B2')), is(false()))

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(b_graph)
   end subroutine test_wildcard_import_fans_out_into_composite_members

   ! Task 3.2: a pattern matching exactly one export (degenerate N=1)
   ! resolves through the identical code path as the N>=2 case above -
   ! no separate single-match branch exists in resolve_wildcard_
   ! destination (confirmed here by direct coverage, not by inspection
   ! alone).
   @test(npes=[0])
   subroutine test_wildcard_import_resolves_single_match(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, a_meta, b_meta, dst_meta
      type(ComponentSpec), pointer :: root_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(ComponentGraph), pointer :: dst_graph, a_graph
      type(NodeId), pointer :: import_id
      type(NodeId), pointer :: e_a1_id
      class(GraphNode), pointer :: import_node
      type(GraphStateItem), pointer :: import_payload
      type(StateItemMemberMap), pointer :: members
      type(NodeId), pointer :: member_id
      integer :: status
      type(GraphBuilder) :: gb

      call build_wildcard_hierarchy('single', 'A/E_A1', root_gc, root_meta, a_meta, b_meta, dst_meta, _RC)

      conn = MatchConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      root_spec => root_meta%get_component_spec()
      call root_spec%add_connection(conn)

      call gb%resolve_connections(root_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      dst_graph => dst_meta%get_component_graph()
      import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'A/E_A1'))
      @assert_that(associated(import_id), is(true()))

      import_node => dst_graph%get_node(import_id)
      select type (import_node)
      class is (StateItemNode)
         import_payload => import_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select

      @assertTrue(import_payload%itemType(rc=status) == ESMF_STATEITEM_STATE)
      members => import_payload%state_members_ptr()
      @assertEqual(1, members%size())

      a_graph => a_meta%get_component_graph()
      e_a1_id => a_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'E_A1'))
      member_id => members%at('A/E_A1')
      @assert_that(associated(member_id), is(true()))
      @assert_that(member_id == e_a1_id, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_wildcard_import_resolves_single_match

   ! Task 3.3: zero matches reports a GraphResolutionEntry via the
   ! unresolved output (design.md D5) and creates no resource-index
   ! entry, no composite payload (itemType() stays NOT ESMF_STATEITEM_
   ! STATE).
   @test(npes=[0])
   subroutine test_wildcard_import_zero_matches_reports_unresolved(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, a_meta, b_meta, dst_meta
      type(ComponentSpec), pointer :: root_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(GraphResolutionEntry), pointer :: entry
      type(ComponentGraph), pointer :: dst_graph
      type(NodeId), pointer :: import_id
      class(GraphNode), pointer :: import_node
      type(GraphStateItem), pointer :: import_payload
      integer :: status
      type(GraphBuilder) :: gb

      ! 'C/E_C.*' matches nothing in a tree with only 'A'/'B' exports.
      call build_wildcard_hierarchy('zero', 'C/E_C.*', root_gc, root_meta, a_meta, b_meta, dst_meta, _RC)

      conn = MatchConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      root_spec => root_meta%get_component_spec()
      call root_spec%add_connection(conn)

      call gb%resolve_connections(root_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))

      @assertEqual(1, unresolved%size())
      entry => unresolved%at(1, status)
      @assertEqual('dst', entry%component_name)
      @assertEqual('C/E_C.*', entry%short_name)

      dst_graph => dst_meta%get_component_graph()
      import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'C/E_C.*'))
      @assert_that(associated(import_id), is(true()))

      import_node => dst_graph%get_node(import_id)
      select type (import_node)
      class is (StateItemNode)
         import_payload => import_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select

      ! No resource-index entry, no composite payload materialized.
      @assert_that(.not. associated(dst_graph%get_resource_index('WILDCARD_COLLECTION:' // import_id%to_string())), is(true()))
      @assertTrue(import_payload%itemType(rc=status) /= ESMF_STATEITEM_STATE)

      _UNUSED_DUMMY(this)
   end subroutine test_wildcard_import_zero_matches_reports_unresolved

   ! Task 3.4: re-running connection resolution a second time for the
   ! same already-resolved wildcard import does not duplicate state_
   ! members() entries and does not re-create the ESMF_State payload
   ! (idempotency, design.md D4).
   @test(npes=[0])
   subroutine test_wildcard_import_resolution_is_idempotent(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, a_meta, b_meta, dst_meta
      type(ComponentSpec), pointer :: root_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(ComponentGraph), pointer :: dst_graph
      type(NodeId), pointer :: import_id
      class(GraphNode), pointer :: import_node
      type(GraphStateItem), pointer :: import_payload
      type(StateItemMemberMap), pointer :: members
      integer :: status
      type(GraphBuilder) :: gb

      call build_wildcard_hierarchy('idempotent', 'A/E_A.*', root_gc, root_meta, a_meta, b_meta, dst_meta, _RC)

      conn = MatchConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      root_spec => root_meta%get_component_spec()
      call root_spec%add_connection(conn)

      call gb%resolve_connections(root_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      dst_graph => dst_meta%get_component_graph()
      import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'A/E_A.*'))

      import_node => dst_graph%get_node(import_id)
      select type (import_node)
      class is (StateItemNode)
         import_payload => import_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      members => import_payload%state_members_ptr()
      @assertEqual(2, members%size())

      ! Re-resolve: must not duplicate members or re-create the payload.
      call gb%resolve_connections(root_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(2, members%size())

      _UNUSED_DUMMY(this)
   end subroutine test_wildcard_import_resolution_is_idempotent

   ! Only FIELD exports are Wildcard members: a FIELDBUNDLE and a BRACKET
   ! export whose names match the pattern are skipped, and the skip is
   ! neither a conflict nor an unresolved import.
   @test(npes=[0])
   subroutine test_wildcard_non_field_export_is_not_a_member(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, a_meta, b_meta, dst_meta
      type(ComponentSpec), pointer :: root_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(ComponentGraph), pointer :: dst_graph
      type(NodeId), pointer :: import_id
      class(GraphNode), pointer :: import_node
      type(GraphStateItem), pointer :: import_payload
      type(StateItemMemberMap), pointer :: members
      integer :: status
      type(GraphBuilder) :: gb

      call build_wildcard_hierarchy('nonfield', 'A/E_A.*', root_gc, &
           root_meta, a_meta, b_meta, dst_meta, add_non_field=.true., &
           rc=status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('<self>', VirtualConnectionPt( &
           state_intent='export', short_name='^.*$')), &
           ConnectionPt('dst', VirtualConnectionPt( &
           state_intent='import', short_name='^.*$')))
      root_spec => root_meta%get_component_spec()
      call root_spec%add_connection(conn)

      call gb%resolve_connections(root_meta, &
           unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      dst_graph => dst_meta%get_component_graph()
      import_id => dst_graph%get_resource_index( &
           item_key(ESMF_STATEINTENT_IMPORT, 'A/E_A.*'))
      @assert_that(associated(import_id), is(true()))
      import_node => dst_graph%get_node(import_id)
      select type (import_node)
      class is (StateItemNode)
         import_payload => import_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select

      members => import_payload%state_members_ptr()
      @assertEqual(2, members%size())
      @assert_that(associated(members%at('A/E_A1')), is(true()))
      @assert_that(associated(members%at('A/E_A2')), is(true()))
      @assert_that(associated(members%at('A/E_A3')), is(false()))
      @assert_that(associated(members%at('A/E_A4')), is(false()))

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(a_meta)
      _UNUSED_DUMMY(b_meta)
   end subroutine test_wildcard_non_field_export_is_not_a_member

   ! A pattern whose only matches are non-FIELD exports behaves as zero
   ! matches: the import is reported unresolved and no collection is made.
   ! The read-only check agrees with the resolution.
   @test(npes=[0])
   subroutine test_wildcard_only_non_field_matches_is_unresolved(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, a_meta, b_meta, dst_meta
      type(ComponentSpec), pointer :: root_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, checked
      type(GraphResolutionEntry), pointer :: entry
      type(ComponentGraph), pointer :: dst_graph
      type(NodeId), pointer :: import_id
      class(GraphNode), pointer :: import_node
      type(GraphStateItem), pointer :: import_payload
      integer :: status
      type(GraphBuilder) :: gb

      call build_wildcard_hierarchy('onlybundle', 'A/E_A3', root_gc, &
           root_meta, a_meta, b_meta, dst_meta, add_non_field=.true., &
           rc=status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('<self>', VirtualConnectionPt( &
           state_intent='export', short_name='^.*$')), &
           ConnectionPt('dst', VirtualConnectionPt( &
           state_intent='import', short_name='^.*$')))
      root_spec => root_meta%get_component_spec()
      call root_spec%add_connection(conn)

      ! Read-only check, before any resolution.
      call gb%check_unsatisfied_imports(root_meta, &
           unresolved_imports=checked, rc=status)
      @assert_that(status, is(0))
      @assertEqual(1, checked%size())
      entry => checked%at(1, status)
      @assertEqual('A/E_A3', entry%short_name)

      call gb%resolve_connections(root_meta, &
           unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(1, unresolved%size())
      entry => unresolved%at(1, status)
      @assertEqual('dst', entry%component_name)
      @assertEqual('A/E_A3', entry%short_name)

      dst_graph => dst_meta%get_component_graph()
      import_id => dst_graph%get_resource_index( &
           item_key(ESMF_STATEINTENT_IMPORT, 'A/E_A3'))
      @assert_that(associated(import_id), is(true()))
      import_node => dst_graph%get_node(import_id)
      select type (import_node)
      class is (StateItemNode)
         import_payload => import_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select

      @assert_that(.not. associated(dst_graph%get_resource_index( &
           'WILDCARD_COLLECTION:' // import_id%to_string())), is(true()))
      @assertTrue(import_payload%itemType(rc=status) /= ESMF_STATEITEM_STATE)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(a_meta)
      _UNUSED_DUMMY(b_meta)
   end subroutine test_wildcard_only_non_field_matches_is_unresolved

   ! A pair with a DEFERRED side is neither wired nor reported; it is
   ! retried on the next pass, once the component has filled the value.
   @test(npes=[0])
   subroutine test_deferred_geometry_connection_waits_then_wires(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: deferred_import
      type(SimpleConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_export, t_import
      class(GraphNode), pointer :: import_node
      type(StateItemDescriptor), pointer :: descriptor
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_deferred_wait', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))
      deferred_import%state_intent = ESMF_STATEINTENT_IMPORT
      deferred_import%short_name = 'T'
      deferred_import%vertical_stagger = VERTICAL_STAGGER_NONE
      call comp_spec%add_var_spec(deferred_import)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      conn = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='T')), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='import', short_name='T')))
      call comp_spec%add_connection(conn)

      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unsupported%size())

      graph => outer_meta%get_component_graph()
      t_export => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      net => graph%get_network(graph%get_forward_network_id())
      @assert_that(net%contains_dependency(t_export, t_import), is(false()))
      @assert_that(outer_meta%connections_already_resolved(), is(false()))
      @assert_that(outer_meta%has_waiting_connections(), is(true()))

      ! The component supplies the geometry in its own phase.
      import_node => graph%get_node(t_import)
      select type (import_node)
      class is (StateItemNode)
         descriptor => import_node%get_descriptor()
         call descriptor%set_characteristic(GEOMETRY_CHARACTERISTIC_KIND, GeometryCharacteristic(geom_id='1'))
      end select

      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unsupported%size())
      @assert_that(net%contains_dependency(t_export, t_import), is(true()))
      @assert_that(outer_meta%connections_already_resolved(), is(true()))
      @assert_that(outer_meta%has_waiting_connections(), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_deferred_geometry_connection_waits_then_wires

   ! An import that mirrors geometry adopts the export's, so the pair wires
   ! with no transform and nothing waits.
   @test(npes=[0])
   subroutine test_mirrored_geometry_import_wires(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: mirror_import
      type(SimpleConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_export, t_import
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_mirror_geom', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))
      mirror_import%state_intent = ESMF_STATEINTENT_IMPORT
      mirror_import%short_name = 'T'
      mirror_import%vertical_stagger = VERTICAL_STAGGER_NONE
      mirror_import%mirror_geom = .true.
      call comp_spec%add_var_spec(mirror_import)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      conn = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='T')), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='import', short_name='T')))
      call comp_spec%add_connection(conn)

      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unsupported%size())

      graph => outer_meta%get_component_graph()
      t_export => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      net => graph%get_network(graph%get_forward_network_id())
      @assert_that(net%contains_dependency(t_export, t_import), is(true()))
      @assert_that(outer_meta%has_waiting_connections(), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_mirrored_geometry_import_wires

   ! Two connections name one import. One waits on a DEFERRED export; the
   ! other settles the import in the same pass. On retry the waiting
   ! connection would add a second producer for T: it is recorded as a
   ! pair-level conflict naming T, and later connections still resolve.
   @test(npes=[0])
   subroutine test_waiting_connection_survives_sibling_settling_import(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: deferred_export
      type(SimpleConnection) :: conn_a, conn_b, conn_c
      type(GraphResolutionEntryVector) :: unresolved, unsupported, conflicts
      type(GraphResolutionEntry), pointer :: entry
      type(NodeId), pointer :: ta_export, tb_export, t_import, u_import
      class(GraphNode), pointer :: export_node
      type(StateItemDescriptor), pointer :: descriptor
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_two_conn_wait', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      deferred_export%state_intent = ESMF_STATEINTENT_EXPORT
      deferred_export%short_name = 'TA'
      deferred_export%vertical_stagger = VERTICAL_STAGGER_NONE
      call comp_spec%add_var_spec(deferred_export)
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'TB'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'U'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      conn_a = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='TA')), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='import', short_name='T')))
      conn_b = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='TB')), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='import', short_name='T')))
      ! Processed after conn_a on the retry pass.
      conn_c = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='TA')), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='import', short_name='U')))
      call comp_spec%add_connection(conn_a)
      call comp_spec%add_connection(conn_b)
      call comp_spec%add_connection(conn_c)

      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, connection_conflicts=conflicts, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, conflicts%size())

      graph => outer_meta%get_component_graph()
      ta_export => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'TA'))
      tb_export => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'TB'))
      t_import => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      u_import => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'U'))
      net => graph%get_network(graph%get_forward_network_id())
      @assert_that(net%contains_dependency(ta_export, t_import), is(false()))
      @assert_that(net%contains_dependency(ta_export, u_import), is(false()))
      @assert_that(outer_meta%has_waiting_connections(), is(true()))

      export_node => graph%get_node(ta_export)
      select type (export_node)
      class is (StateItemNode)
         descriptor => export_node%get_descriptor()
         call descriptor%set_characteristic(GEOMETRY_CHARACTERISTIC_KIND, GeometryCharacteristic(geom_id='1'))
      end select

      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, connection_conflicts=conflicts, rc=status)
      @assert_that(status, is(0))
      @assertEqual(1, conflicts%size())
      entry => conflicts%at(1, status)
      @assertEqual('T', entry%short_name)
      @assert_that(index(entry%reason, '"T"') > 0, is(true()))
      @assert_that(net%contains_dependency(ta_export, t_import), is(false()))
      @assert_that(net%contains_dependency(tb_export, t_import), is(true()))
      @assert_that(net%contains_dependency(ta_export, u_import), is(true()))
      @assert_that(outer_meta%has_waiting_connections(), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_waiting_connection_survives_sibling_settling_import

   ! One connection waits on a DEFERRED export while another settles a
   ! different import in the same pass; the waiting one is still retried
   ! and wired once its export is filled.
   @test(npes=[0])
   subroutine test_waiting_connection_survives_sibling_settling_other_import(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: deferred_export
      type(SimpleConnection) :: conn_a, conn_b
      type(GraphResolutionEntryVector) :: unresolved, unsupported, conflicts
      type(NodeId), pointer :: ta_export, tb_export, t_import, u_import
      class(GraphNode), pointer :: export_node
      type(StateItemDescriptor), pointer :: descriptor
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_two_conn_wait_other', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      deferred_export%state_intent = ESMF_STATEINTENT_EXPORT
      deferred_export%short_name = 'TA'
      deferred_export%vertical_stagger = VERTICAL_STAGGER_NONE
      call comp_spec%add_var_spec(deferred_export)
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'TB'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'U'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      conn_a = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='TA')), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='import', short_name='T')))
      conn_b = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='TB')), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='import', short_name='U')))
      call comp_spec%add_connection(conn_a)
      call comp_spec%add_connection(conn_b)

      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, connection_conflicts=conflicts, rc=status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      ta_export => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'TA'))
      tb_export => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'TB'))
      t_import => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      u_import => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'U'))
      net => graph%get_network(graph%get_forward_network_id())
      @assert_that(net%contains_dependency(ta_export, t_import), is(false()))
      @assert_that(net%contains_dependency(tb_export, u_import), is(true()))
      @assert_that(outer_meta%has_waiting_connections(), is(true()))

      export_node => graph%get_node(ta_export)
      select type (export_node)
      class is (StateItemNode)
         descriptor => export_node%get_descriptor()
         call descriptor%set_characteristic(GEOMETRY_CHARACTERISTIC_KIND, GeometryCharacteristic(geom_id='1'))
      end select

      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, connection_conflicts=conflicts, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, conflicts%size())
      @assert_that(net%contains_dependency(ta_export, t_import), is(true()))
      @assert_that(net%contains_dependency(tb_export, u_import), is(true()))
      @assert_that(outer_meta%has_waiting_connections(), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_waiting_connection_survives_sibling_settling_other_import

end module Test_GraphBuilder_ConnectionResolution
