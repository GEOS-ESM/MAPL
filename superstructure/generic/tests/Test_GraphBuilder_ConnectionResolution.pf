   @test(npes=[0])
   subroutine test_expression_input_stagger_is_unsupported(this)
      class(MpiTestMethod), intent(inout) :: this
      type(OuterMetaComponent), pointer :: parent, src, dst
      type(ComponentGraph), pointer :: pg, dg
      type(DependencyNetwork), pointer :: net
      type(NodeId), pointer :: import_id
      type(GraphResolutionEntryVector) :: unsupported, conflicts
      type(GraphResolutionEntry), pointer :: entry
      integer :: status
      type(GraphBuilder) :: gb

      call make_expression_fixture('expr_input_stagger', ['I'], ['m'], &
           [ESMF_TYPEKIND_R4], parent, src, dst, _RC)
      call set_expression_characteristic(src, ESMF_STATEINTENT_EXPORT, &
           'A', VerticalStaggerCharacteristic(VERTICAL_STAGGER_CENTER))
      call gb%resolve_connections(parent, &
           unsupported_characteristics=unsupported, &
           connection_conflicts=conflicts, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, conflicts%size())
      @assertEqual(1, unsupported%size())
      if (unsupported%size() /= 1) return
      entry => unsupported%at(1, status)
      @assertEqual('dst', entry%component_name)
      @assertEqual('I', entry%short_name)
      @assertEqual('VERTICAL_STAGGER', entry%reason)
      pg => parent%get_component_graph()
      dg => dst%get_component_graph()
      import_id => dg%get_resource_index( &
           item_key(ESMF_STATEINTENT_IMPORT, 'I'))
      net => pg%get_network(pg%get_forward_network_id())
      @assertFalse(net%has_predecessors(import_id))
      @assertEqual(0, expression_evaluation_count(pg))
      _UNUSED_DUMMY(this)
   end subroutine test_expression_input_stagger_is_unsupported

   @test(npes=[0])
   subroutine test_expression_partial_input_failure_has_no_evaluation(this)
      class(MpiTestMethod), intent(inout) :: this
      type(OuterMetaComponent), pointer :: parent, src, dst
      type(ComponentGraph), pointer :: pg, dg
      type(DependencyNetwork), pointer :: net
      type(NodeId), pointer :: import_id
      type(NodeIdSet), target :: ids
      type(NodeIdSetIterator) :: iter
      type(StateItemDescriptor), pointer :: descriptor
      type(GraphResolutionEntryVector) :: unsupported
      type(GraphResolutionEntry), pointer :: entry
      integer :: status
      type(GraphBuilder) :: gb

      call make_expression_fixture('expr_partial_inputs', ['I'], ['m'], &
           [ESMF_TYPEKIND_R8], parent, src, dst, _RC)
      call set_expression_characteristic(src, ESMF_STATEINTENT_EXPORT, &
           'B', GeometryCharacteristic(geom_id='2'))
      call gb%resolve_connections(parent, &
           unsupported_characteristics=unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, unsupported%size())
      if (unsupported%size() /= 1) return
      entry => unsupported%at(1, status)
      @assertEqual('GEOMETRY', entry%reason)
      pg => parent%get_component_graph()
      dg => dst%get_component_graph()
      import_id => dg%get_resource_index( &
           item_key(ESMF_STATEINTENT_IMPORT, 'I'))
      net => pg%get_network(pg%get_forward_network_id())
      @assertFalse(net%has_predecessors(import_id))
      @assertEqual(0, expression_evaluation_count(pg))
      ids = pg%get_node_ids()
      iter = ids%ftn_begin()
      do while (iter /= ids%ftn_end())
         call iter%next()
         descriptor => node_descriptor(pg, iter%of())
         if (.not. associated(descriptor)) cycle
         ! An input chain may survive failure, but never an expression result.
         @assertFalse(descriptor%has_characteristic( &
              EXPRESSION_CHARACTERISTIC_KIND))
      end do
      _UNUSED_DUMMY(this)
   end subroutine test_expression_partial_input_failure_has_no_evaluation

   @test(npes=[0])
   subroutine test_expression_unsupported_input_reaches_strict_freeze(this)
      class(MpiTestMethod), intent(inout) :: this
      type(OuterMetaComponent), pointer :: parent, src, dst
      type(StringVector) :: pairs
      integer :: status
      type(GraphBuilder) :: gb

      call make_expression_fixture('expr_strict_input', ['I'], ['m'], &
           [ESMF_TYPEKIND_R4], parent, src, dst, _RC)
      call set_expression_characteristic(src, ESMF_STATEINTENT_EXPORT, &
           'A', GeometryCharacteristic(geom_id='2'))
      call gb%resolve_connections(parent, rc=status)
      @assertEqual(0, status)
      pairs = parent%get_unsupported_pairs()
      @assertEqual(1, pairs%size())
      if (pairs%size() == 1) then
         @assertEqual('dst:I:GEOMETRY', pairs%of(1))
      end if
      call use_validation('{validation_mode: strict}')
      call gb%check_unsupported_pairs(parent, rc=status)
      @assertExceptionRaised('GraphBuilder: unsupported pairs remain at freeze (strict validation mode)')
      @assertEqual(1, status)
      _UNUSED_DUMMY(this)
   end subroutine test_expression_unsupported_input_reaches_strict_freeze

