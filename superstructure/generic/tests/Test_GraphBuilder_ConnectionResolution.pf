#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! Phase 17-5a (docs/graph/spec/20-implementation-roadmap.md sec
! 20.4.17, 17-5): split out of Test_GraphBuilder.pf - holds the
! ConnectionResolution-exclusive buckets identified by 17-2/17-3's
! characterization (buckets 2, 3, 4, 5, 7, 10, 12, 15, 17, 21, 22):
! ordinary (MatchConnection) resolution match/unresolved, inout
! borrowing, the activate-time unsatisfied-import check,
! SimpleConnection resolution, materialize-extensions gating,
! composite connection wiring, vertical-grid composite overlap
! resolution, the non-callback-destination negative control, the
! callback-collection full-pipeline test (exercises ConnectionResolution's
! own resolve_callback_destination, despite its "callback" name - see
! bucket 17's own 17-3 note), multi-level qualified-component
! connection resolution, and node-identity-based resolution with no
! live VariableSpec reference.
!
! Every test here goes through GraphBuilder%resolve_connections (or,
! for bucket 4, %check_unsatisfied_imports) exercising the
! ConnectionResolution submodule, directly or (bucket 17/21) via one
! specific call site into a shared helper - see the roadmap's own
! 17-3 table for the full per-bucket submodule attribution.
!
! Carries along two bucket-local fixture helpers (single_predecessor
! for bucket 7, resolve_vertical_grid_membership_mismatch for bucket
! 12) and bucket 7's own callback-wiring fixture helpers needed by
! bucket 17 (make_passive_tracer_interface, make_tracer_callback_export,
! build_tracer_hierarchy - NOT make_exchanger_interface, which is
! needed only by bucket 18's test_callback_method_binding_builds_get_put_networks,
! staying in Test_GraphBuilder.pf).
!
! Also carries the reset_materialize_extensions_gate/
! restore_materialize_extensions_gate @before/@after pair (bucket 23):
! required because bucket 7 (materialize-extensions gating) moved
! here, and pFUnit's @before/@after typing is NOT disambiguated per
! test (see Test_GraphBuilder.pf's own module header for the full
! explanation, including the exact NAG compile error that confirmed
! this) - every @test below is MpiTestMethod-typed to match.
!
! Test-only OuterMetaComponent instances are built the same way
! Test_GraphBuilder.pf's own fixtures are (bypassing SetServices/DSO
! machinery) - see GraphBuilderTestSupport_mod.
module Test_GraphBuilder_ConnectionResolution
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetwork_mod, only: DependencyNetwork
   use mapl_DependencyNetworkId_mod, only: DependencyNetworkId, operator(==)
   use mapl_DependencyNetworkIdSet_mod, only: DependencyNetworkIdSet, DependencyNetworkIdSetIterator, operator(/=)
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_ChildSpec_mod, only: ChildSpec
   use mapl_ComponentSpec_mod, only: ComponentSpec
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_VariableSpecVector_mod, only: VariableSpecVector
   use mapl_ConnectionPt_mod, only: ConnectionPt
   use mapl_VirtualConnectionPt_mod, only: VirtualConnectionPt
   use mapl_MatchConnection_mod, only: MatchConnection
   use mapl_SimpleConnection_mod, only: SimpleConnection
   use mapl_NodeId_mod, only: NodeId, operator(==)
   use mapl_NodeIdSet_mod, only: NodeIdSet, NodeIdSetIterator, operator(/=)
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem
   use mapl_StateItemMemberMap_mod, only: StateItemMemberMap
   use mapl_ExtensionResolution_mod, only: set_materialize_extensions
   use mapl_StateItem_mod, only: MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_STATE, MAPL_STATEITEM_FIELDBUNDLE
   ! -- openspec/changes/callback-wiring -----------------------------------
   use mapl_CallbackInterfaceId_mod, only: CallbackInterfaceId
   use mapl_CallbackInterface_mod, only: CallbackInterface
   use mapl_CallbackInterfaceRegistry_mod, only: register_callback_interface
   use mapl_AccessSpec_mod, only: MAPL_ACCESS_IN, MAPL_ACCESS_OUT
   use mapl_StateItemFlag_mod, only: MAPL_VARIANT_FIELDBUNDLE => MAPL_STATEITEM_FIELDBUNDLE
   ! -- openspec/changes/vertical-grid-graph-state-item ---------------------
   use mapl_StateItemFlag_mod, only: MAPL_STATEITEM_VERTICALGRID
   use mapl_vertical_grid_api, only: mapl_BasicVerticalGrid
   use mapl_GraphResolutionEntry_mod, only: GraphResolutionEntry
   use mapl_GraphResolutionEntryVector_mod, only: GraphResolutionEntryVector
   use mapl_PortIdNodeIdMap_mod, only: PortIdNodeIdMap, PortIdNodeIdMapIterator, operator(/=)
   use GraphBuilderTestSupport_mod, only: make_outer_meta, make_var
   use esmf
   use pfunit
   implicit none(type, external)

contains

   @before
   subroutine reset_materialize_extensions_gate(this)
      class(MpiTestMethod), intent(inout) :: this

      call set_materialize_extensions(.false.)
      _UNUSED_DUMMY(this)
   end subroutine reset_materialize_extensions_gate

   @after
   subroutine restore_materialize_extensions_gate(this)
      class(MpiTestMethod), intent(inout) :: this

      call set_materialize_extensions(.false.)
      _UNUSED_DUMMY(this)
   end subroutine restore_materialize_extensions_gate

   ! Task 6.2 / spec "Matching export and import are wired" + "Import
   ! with no matching export is left unresolved" + task 4.2 "Child's
   ! published port gets a parent-local proxy": a parent declares a
   ! connect_all-style MatchConnection between two children; the parent
   ! ends up with proxy nodes (not the children's own NodeIds) wired in
   ! its own default network, and the one import with no matching export
   ! is reported, not silently dropped.
   @test(npes=[0])
   subroutine test_ordinary_connection_wires_matching_and_reports_unresolved(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph, src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(GraphResolutionEntry), pointer :: entry
      type(NodeId), pointer :: t_export_id, t_import_id, q_import_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'Q')) ! no matching export

      ! Children advertise first - mirrors recursion order in
      ! OuterMetaComponent/initialize_advertise.F90 (children complete
      ! before the parent resolves its own connections).
      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      ! connect_all('child_src', 'child_dst')'s own "magic connect" shape
      ! (superstructure/generic/OuterMetaComponent/connect_all.F90).
      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))

      @assertEqual(1, unresolved%size())
      entry => unresolved%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('Q', entry%short_name)

      ! openspec/changes/hierarchy-wide-component-graph, tasks.md 3.1/3.4:
      ! no parent-local proxy exists anymore - the edge below connects
      ! each child's own real NodeId directly (graph/component-hierarchy
      ! "Cross-component dependency wiring uses real node identities
      ! directly").
      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      q_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'Q'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))
      @assert_that(associated(q_import_id), is(true()))

      ! Each child's own real NodeId is owned by that child's OWN graph,
      ! not the parent's - no proxy, no parent-side ownership record for
      ! either side (graph/component-hierarchy "No proxy node is created
      ! for a cross-component edge").
      @assert_that(src_graph%owns_node(t_export_id), is(true()))
      @assert_that(dst_graph%owns_node(t_import_id), is(true()))
      @assert_that(parent_graph%owns_node(t_export_id), is(false()))
      @assert_that(parent_graph%owns_node(t_import_id), is(false()))

      ! The edge itself lives in the PARENT's own default network (the
      ! declaring component's network), connecting the two children's
      ! own real NodeIds directly.
      net_id = parent_graph%get_default_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(true()))
      @assert_that(net%has_predecessors(q_import_id), is(false()))
      @assert_that(net%has_successors(t_export_id), is(true()))
      @assert_that(net%has_predecessors(t_export_id), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_ordinary_connection_wires_matching_and_reports_unresolved

   ! openspec/changes/extension-reuse (roadmap sub-change 3c) - REQ-EXT-001/
   ! 002/003 end-to-end through GraphBuilder: a units mismatch between a
   ! matched export/import pair gets a real TransformGraphNode + extension
   ! StateItemNode interposed instead of a direct dependency edge, and the
   ! no-op case (elsewhere, a second, exactly-matching pair) still wires
   ! directly - both handled by the same resolve_connections() call.
   @test(npes=[0])
   subroutine test_ordinary_connection_units_mismatch_creates_chain(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_export_id, t_import_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_units', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='km'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))

      ! REQ-EXT scenario "Mismatched export and import are wired through
      ! an extension chain": not reported as unresolved, not reported as
      ! unsupported (units has a real registered provider).
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      ! openspec/changes/hierarchy-wide-component-graph, tasks.md 3.4:
      ! each child's own real NodeId, in its own graph - no parent-local
      ! proxy exists anymore.
      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      net_id = parent_graph%get_default_network_id()
      net => parent_graph%get_network(net_id)

      ! Not a direct edge (spec "Mismatched export and import are wired
      ! through an extension chain") - a transform node is interposed.
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(false()))
      @assert_that(net%has_successors(t_export_id), is(true()))
      @assert_that(net%has_predecessors(t_import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_ordinary_connection_units_mismatch_creates_chain

   ! openspec/changes/ordinary-inout-direct-alias - REQ-INOUT-001 direct-
   ! alias case: a destination item declared an ordinary inout borrower
   ! (VariableSpec%is_inout_borrower) wires a forward edge (owner ->
   ! borrower) in the default network - identical wiring shape to the
   ! ordinary REQ-EXT-003 no-op case above, so owner/borrower payload
   ! sharing is inherited from that same materialization path (not
   ! independently testable at this synthetic-node layer - neither this
   ! test nor the ordinary no-op test above exercises real ESMF Field
   ! materialization, which happens outside GraphBuilder/ComponentGraph
   ! entirely) - plus a return edge (borrower -> owner) in a second,
   ! distinct per-pairing network (design.md Decision 2, revised).
   ! ComponentGraph%validate() (REQ-DEP-008a's cross-network check)
   ! succeeds since the two edges write two different NodeIds - no
   ! special-case validation code needed (design.md Risk 2).
   @test(npes=[0])
   subroutine test_inout_direct_alias_wires_forward_and_return_edges(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(VariableSpec) :: borrower_spec
      type(NodeId), pointer :: t_export_id, t_import_id
      type(DependencyNetwork), pointer :: net, candidate_net
      type(DependencyNetworkId) :: net_id
      type(DependencyNetworkId), pointer :: candidate_id
      type(DependencyNetworkIdSet), target :: all_net_ids
      type(DependencyNetworkIdSetIterator) :: net_iter
      logical :: found_return_edge
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_inout', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      dst_spec => dst_meta%get_component_spec()
      borrower_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T')
      borrower_spec%is_inout_borrower = .true.
      call dst_spec%add_var_spec(borrower_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))

      ! spec "A borrower whose required payload exactly matches its
      ! owner's is wired with no transform in either direction" - not
      ! reported as unresolved or unsupported.
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      ! openspec/changes/hierarchy-wide-component-graph, tasks.md 3.4:
      ! each child's own real NodeId, in its own graph.
      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      ! Forward edge: owner -> borrower, in the default network -
      ! identical wiring shape to the ordinary REQ-EXT-003 no-op case.
      net_id = parent_graph%get_default_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(true()))

      ! Return edge: borrower -> owner, in a DIFFERENT network from the
      ! default one (design.md Decision 2, revised: a fresh per-pairing
      ! network, not the default network, not the same one as forward).
      found_return_edge = .false.
      all_net_ids = parent_graph%get_network_ids()
      net_iter = all_net_ids%ftn_begin()
      do while (net_iter /= all_net_ids%ftn_end())
         call net_iter%next()
         candidate_id => net_iter%of()
         if (candidate_id == net_id) cycle
         candidate_net => parent_graph%get_network(candidate_id)
         if (candidate_net%contains_dependency(t_import_id, t_export_id)) then
            found_return_edge = .true.
         end if
      end do
      @assert_that(found_return_edge, is(true()))

      ! REQ-DEP-008a: the forward edge writes the borrower's NodeId, the
      ! return edge writes the owner's NodeId - two different ids, so
      ! cross-network validation succeeds with no special-case code.
      call parent_graph%validate(status)
      @assert_that(status, is(0))

      _UNUSED_DUMMY(this)
   end subroutine test_inout_direct_alias_wires_forward_and_return_edges

   ! spec "A mismatched pairing is rejected rather than silently chained"
   ! - REQ-INOUT-002 reserves the non-direct-alias case; an inout
   ! borrower whose payload does not exactly match its owner's is
   ! reported via unsupported_characteristics, and MUST NOT get an
   ! extension chain the way an ordinary (non-inout) mismatch does
   ! (contrast with test_ordinary_connection_units_mismatch_creates_chain
   ! above).
   @test(npes=[0])
   subroutine test_inout_mismatch_is_rejected_not_chained(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(GraphResolutionEntry), pointer :: entry
      type(VariableSpec) :: borrower_spec
      type(NodeId), pointer :: t_export_id, t_import_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_inout_mismatch', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m'))

      dst_spec => dst_meta%get_component_spec()
      borrower_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T', units='km')
      borrower_spec%is_inout_borrower = .true.
      call dst_spec%add_var_spec(borrower_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))

      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      entry => unsupported%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('T', entry%short_name)
      @assertEqual('inout borrower payload does not exactly match its owner (non-direct-alias case not supported)', &
           entry%reason)

      ! No extension chain, no direct edge either - the pairing is
      ! rejected outright (contrast with the ordinary mismatch test,
      ! where a TransformGraphNode is interposed). Each child's own
      ! real NodeId, in its own graph (tasks.md 3.4 - no parent-local
      ! proxy exists anymore).
      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      net_id = parent_graph%get_default_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(false()))
      @assert_that(net%has_successors(t_export_id), is(false()))
      @assert_that(net%has_predecessors(t_import_id), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_inout_mismatch_is_rejected_not_chained

   ! spec "A borrower declaration with no identifiable owner is rejected"
   ! - no export of the same short name exists at all; reported via
   ! unsupported, never silently treated as an ordinary unresolved
   ! import.
   @test(npes=[0])
   subroutine test_inout_borrower_with_no_owner_is_rejected(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(GraphResolutionEntry), pointer :: entry
      type(VariableSpec) :: borrower_spec
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_inout_no_owner', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      ! No export declared on child_src at all.

      dst_spec => dst_meta%get_component_spec()
      borrower_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T')
      borrower_spec%is_inout_borrower = .true.
      call dst_spec%add_var_spec(borrower_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))

      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      entry => unsupported%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('T', entry%short_name)
      @assertEqual('inout borrower has no identifiable owner', entry%reason)

      _UNUSED_DUMMY(this)
   end subroutine test_inout_borrower_with_no_owner_is_rejected

   ! spec "A borrower-of-a-borrower pairing is rejected" - the owner item
   ! is itself declared as an inout borrower in another pairing; chained
   ! (recursive) borrowing is unspecified behavior reserved for a future
   ! design addendum (REQ-INOUT-002), same as the general case.
   @test(npes=[0])
   subroutine test_inout_chained_borrowing_is_rejected(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: a_meta, b_meta, c_meta
      type(GriddedComponentDriver) :: a_driver, b_driver, c_driver
      type(ESMF_GridComp) :: a_gc, b_gc, c_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, a_spec, b_spec, c_spec
      type(MatchConnection) :: conn_ab, conn_bc
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(GraphResolutionEntry), pointer :: entry
      type(VariableSpec) :: borrower_spec
      integer :: status
      type(GraphBuilder) :: gb

      ! Chain: comp_a (owner, export T) -> comp_b (borrows from comp_a,
      ! also declares T an inout borrower) -> comp_c (tries to borrow
      ! from comp_b, which is itself a declared borrower - rejected).
      call make_outer_meta('comp_parent_inout_chain', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('comp_a', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('comp_b', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('comp_c', child_spec, _RC)

      a_driver = parent_meta%get_child('comp_a', _RC)
      b_driver = parent_meta%get_child('comp_b', _RC)
      c_driver = parent_meta%get_child('comp_c', _RC)
      a_gc = a_driver%get_gridcomp()
      b_gc = b_driver%get_gridcomp()
      c_gc = c_driver%get_gridcomp()
      a_meta => get_outer_meta(a_gc, _RC)
      b_meta => get_outer_meta(b_gc, _RC)
      c_meta => get_outer_meta(c_gc, _RC)

      a_spec => a_meta%get_component_spec()
      call a_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      b_spec => b_meta%get_component_spec()
      borrower_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T')
      borrower_spec%is_inout_borrower = .true.
      call b_spec%add_var_spec(borrower_spec)
      ! comp_b also exports T (so comp_c can attempt to borrow from it) -
      ! the exported VariableSpec is a separate declaration from the
      ! imported (borrower) one above, matching how an ordinary component
      ! declares distinct import/export VariableSpecs for the same
      ! short_name.
      call b_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      c_spec => c_meta%get_component_spec()
      borrower_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T')
      borrower_spec%is_inout_borrower = .true.
      call c_spec%add_var_spec(borrower_spec)

      call gb%advertise(a_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(b_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(c_meta, status)
      @assert_that(status, is(0))

      conn_ab = MatchConnection( &
           ConnectionPt('comp_a', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('comp_b', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      conn_bc = MatchConnection( &
           ConnectionPt('comp_b', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('comp_c', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn_ab)
      call parent_spec%add_connection(conn_bc)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))

      ! comp_a -> comp_b resolves fine (comp_a's export T is not itself a
      ! declared borrower); comp_b -> comp_c is rejected (comp_b's
      ! exported T belongs to a component that also declares T an inout
      ! borrower, i.e. chained borrowing).
      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      entry => unsupported%at(1, status)
      @assertEqual('comp_c', entry%component_name)
      @assertEqual('T', entry%short_name)
      @assertEqual('inout borrower owner is itself a declared inout borrower (chained borrowing)', entry%reason)

      _UNUSED_DUMMY(this)
   end subroutine test_inout_chained_borrowing_is_rejected

   ! Two-phase timing correction (GraphBuilder.F90 module header):
   ! graphbuilder_check_unsatisfied_imports() is the GENERIC_INIT_ADVERTISE
   ! -time (Connection%activate()) analog - it must report the same
   ! unresolved import as graphbuilder_resolve_connections() does, but
   ! MUST NOT create any graph structure (no proxy nodes, no dependency
   ! edges) - that is graphbuilder_resolve_connections()'s job, run later
   ! at GENERIC_INIT_ACCEPT_TRANSFER time (Connection%connect()).
   @test(npes=[0])
   subroutine test_check_unsatisfied_imports_reports_without_mutating_graph(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(GraphResolutionEntry), pointer :: entry
      type(NodeIdSet) :: parent_ids
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_activate', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'Q')) ! no matching export

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      parent_graph => parent_meta%get_component_graph()
      parent_ids = parent_graph%get_node_ids()
      @assertEqual(0, parent_ids%size())

      call gb%check_unsatisfied_imports(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))

      ! Same unresolved report as the real (connect-time) resolution.
      @assertEqual(1, unresolved%size())
      entry => unresolved%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('Q', entry%short_name)

      ! No graph mutation: the parent's own graph still has zero nodes
      ! of its own (openspec/changes/hierarchy-wide-component-graph,
      ! tasks.md 3.4: there is no parent-local proxy mechanism left to
      ! check "did not get created" - the stronger, still-correct
      ! check is that the parent's own node count stayed at zero).
      parent_ids = parent_graph%get_node_ids()
      @assertEqual(0, parent_ids%size())
      @assert_that(parent_graph%is_frozen(), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_check_unsatisfied_imports_reports_without_mutating_graph

   ! openspec/changes/simpleconnection-graph-resolution: REPLACES the
   ! old test_non_matchconnection_is_skipped, which asserted a declared
   ! SimpleConnection was skipped entirely (no dependency edge) - that
   ! was exactly the design error this change fixes. This test asserts
   ! the opposite, now-correct behavior: a SimpleConnection and an
   ! equivalent single-match MatchConnection produce IDENTICAL
   ! outcomes (spec "A declared SimpleConnection is resolved exactly
   ! as an equivalent MatchConnection match would be").
   @test(npes=[0])
   subroutine test_simple_connection_resolves_exact_match(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(SimpleConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(NodeId), pointer :: t_export, t_import
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_simple', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      conn = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='T')), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='import', short_name='T')))
      call comp_spec%add_connection(conn)

      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      graph => outer_meta%get_component_graph()
      t_export => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      net => graph%get_network(graph%get_default_network_id())
      ! The now-correct outcome: a real dependency edge IS created -
      ! the opposite of what the old (replaced) test asserted.
      @assert_that(net%contains_dependency(t_export, t_import), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_simple_connection_resolves_exact_match

   ! openspec/changes/simpleconnection-graph-resolution: the exact case
   ! the real-fixture regression (design.md D1's own correction
   ! narrative) was caught by - a SimpleConnection with src_name /=
   ! dst_name (mirrors scenarios/names_1/parent.yaml's real shape:
   ! 'E_A1' -> 'I_B1'). Before the D1 fix, resolve_one's export lookup
   ! substituted the DESTINATION's own name ('I_B1') for the source
   ! lookup, finding nothing on child_src (which exports 'E_A1', not
   ! 'I_B1') - this test fails without effective_source_name's fix.
   @test(npes=[0])
   subroutine test_simple_connection_resolves_with_different_src_dst_names(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph, src_graph, dst_graph
      type(SimpleConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(NodeId), pointer :: export_id, import_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_names', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'E_A1'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'I_B1'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = SimpleConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='E_A1')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='I_B1')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'E_A1'))
      import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'I_B1'))
      @assert_that(associated(export_id), is(true()))
      @assert_that(associated(import_id), is(true()))

      net_id = parent_graph%get_default_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%contains_dependency(export_id, import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_simple_connection_resolves_with_different_src_dst_names

   ! openspec/changes/simpleconnection-graph-resolution: a SimpleConnection
   ! between a mismatched export/import pair, with src_name /= dst_name
   ! too (covers both bugs this change fixes in one test) - delegates to
   ! the extension-reuse capability exactly as an equivalent MatchConnection
   ! match already does (test_ordinary_connection_units_mismatch_creates_chain
   ! above).
   @test(npes=[0])
   subroutine test_simple_connection_resolves_through_extension_chain(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(SimpleConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: export_id, import_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_simple_units', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'E_A1', units='m'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'I_B1', units='km'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = SimpleConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='E_A1')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='I_B1')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'E_A1'))
      import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'I_B1'))
      @assert_that(associated(export_id), is(true()))
      @assert_that(associated(import_id), is(true()))

      net_id = parent_graph%get_default_network_id()
      net => parent_graph%get_network(net_id)

      ! Not a direct edge - a transform node is interposed (same shape
      ! as the MatchConnection mismatch test).
      @assert_that(net%contains_dependency(export_id, import_id), is(false()))
      @assert_that(net%has_successors(export_id), is(true()))
      @assert_that(net%has_predecessors(import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_simple_connection_resolves_through_extension_chain

   ! openspec/changes/simpleconnection-graph-resolution: spec "Import
   ! with no matching export is left unresolved" - exercised through a
   ! SimpleConnection directly (previously only MatchConnection ever
   ! reached this reporting path).
   @test(npes=[0])
   subroutine test_simple_connection_unresolved_import_is_reported(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(SimpleConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(GraphResolutionEntry), pointer :: entry
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_simple_unresolved', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      ! src_meta deliberately does NOT advertise 'E_A1' - the
      ! connection's own declared source does not actually exist.
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'OTHER'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'I_B1'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = SimpleConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='E_A1')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='I_B1')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))

      @assertEqual(1, unresolved%size())
      entry => unresolved%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('I_B1', entry%short_name)

      _UNUSED_DUMMY(this)
   end subroutine test_simple_connection_unresolved_import_is_reported

   ! openspec/changes/simpleconnection-graph-resolution: spec "Real
   ! resolution tolerates being invoked more than once" - exercised
   ! through a SimpleConnection directly.
   @test(npes=[0])
   subroutine test_simple_connection_resolution_is_idempotent(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(SimpleConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_simple_idempotent', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      conn = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='T')), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='import', short_name='T')))
      call comp_spec%add_connection(conn)

      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      @assert_that(graph%is_frozen(), is(false()))
      call graph%freeze(status)
      @assert_that(status, is(0))
      @assert_that(graph%is_frozen(), is(true()))

      ! Second call: connections_already_resolved() guard makes this a
      ! safe no-op, not a re-resolution attempt against an already-
      ! frozen graph.
      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))

      _UNUSED_DUMMY(this)
   end subroutine test_simple_connection_resolution_is_idempotent

   ! openspec/changes/simpleconnection-graph-resolution: resolve_inout_destination's
   ! own two instances of the same name-substitution bug (design.md D1's
   ! correction) are unreachable by any other existing test - no
   ! is_inout_borrower fixture exercises a non-same-name connection at
   ! all. This test exercises both fixes directly: the owner lookup
   ! (effective_source_name) and the chained-borrower scan (comparing
   ! against owner_node's own name, not dst_node's).
   @test(npes=[0])
   subroutine test_simple_connection_resolves_inout_different_names(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(SimpleConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(VariableSpec) :: borrower_spec
      type(NodeId), pointer :: export_id, import_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_simple_inout', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'E_A1'))

      dst_spec => dst_meta%get_component_spec()
      borrower_spec = make_var(ESMF_STATEINTENT_IMPORT, 'I_B1')
      borrower_spec%is_inout_borrower = .true.
      call dst_spec%add_var_spec(borrower_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = SimpleConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='E_A1')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='I_B1')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))

      ! Without the fix: find_export_node_id would look for an export
      ! named 'I_B1' (dst_node's own name) on child_src, which only
      ! advertises 'E_A1' - "no identifiable owner", reported
      ! unsupported, no edge. With the fix: the owner IS found via
      ! 'E_A1' (the connection's own effective source name), so this
      ! resolves cleanly.
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'E_A1'))
      import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'I_B1'))
      @assert_that(associated(export_id), is(true()))
      @assert_that(associated(import_id), is(true()))

      net_id = parent_graph%get_default_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%contains_dependency(export_id, import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_simple_connection_resolves_inout_different_names

   ! -- openspec/changes/extension-registry-visibility, task group 6 -----

   ! Test-only helper: the extension chain's final item is wired as the
   ! sole predecessor of the import proxy (GraphBuilder.F90's own
   ! resolve_one - the last add_dependency call). Assumes exactly one
   ! predecessor, true for every single-mismatch fixture below.
   function single_predecessor(net, node) result(pred_id)
      type(DependencyNetwork), intent(in) :: net
      type(NodeId), intent(in) :: node
      type(NodeId) :: pred_id

      type(NodeIdSet), target :: preds
      type(NodeIdSetIterator) :: iter

      preds = net%get_predecessors(node)
      iter = preds%ftn_begin()
      call iter%next()
      pred_id = iter%of()
   end function single_predecessor

   ! Task 6.1 / spec "Materialization disabled by default": with the
   ! gate untouched (off), a units-mismatch extension chain's final item
   ! keeps 3c's own unallocated placeholder payload - zero behavior
   ! change from today.
   @test(npes=[0])
   subroutine test_materialize_extensions_disabled_leaves_placeholder(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_import_id
      type(NodeId) :: extension_id
      type(DependencyNetwork), pointer :: net
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: extension_payload
      integer :: status
      type(GraphBuilder) :: gb

      call set_materialize_extensions(.false.)

      call make_outer_meta('comp_parent_gate_off', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='km'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_import_id), is(true()))

      net => parent_graph%get_network(parent_graph%get_default_network_id())
      extension_id = single_predecessor(net, t_import_id)

      node => parent_graph%get_node(extension_id)
      select type (node)
      class is (StateItemNode)
         extension_payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(extension_payload%itemType(rc=status) == ESMF_STATEITEM_NOTFOUND)

      _UNUSED_DUMMY(this)
   end subroutine test_materialize_extensions_disabled_leaves_placeholder

   ! openspec/changes/graph-builder-stateitem-resolution: the
   ! "materialize_extensions enabled" counterpart test
   ! (test_materialize_extensions_enabled_creates_real_field) moved to
   ! Test_GraphBuilderMaterializeGate.pf - see that file's own module
   ! header for why (pFUnit @before/@after type-matching limitation
   ! when this suite's own tests mix MpiTestMethod/ESMF_TestMethod).

   ! Task 6.6 / spec "A non-field item class fails explicitly": a
   ! Vector-typed mismatched pair is reported as an explicit,
   ! distinguishable failure - not a fabricated payload, and not
   ! confused with "no matching export" or "unregistered
   ! characteristic."
   @test(npes=[0])
   subroutine test_materialize_extensions_reports_unsupported_item_class(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(GraphResolutionEntry), pointer :: entry
      type(VariableSpec) :: export_var_spec, import_var_spec
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_vector_mismatch', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      export_var_spec%itemType = MAPL_STATEITEM_VECTOR
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T', units='km')
      import_var_spec%itemType = MAPL_STATEITEM_VECTOR
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_var_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_materialize_extensions(.true.)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      call set_materialize_extensions(.false.)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      entry => unsupported%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('T', entry%short_name)
      @assertEqual('unsupported_item_class:VECTOR', entry%reason)

      _UNUSED_DUMMY(this)
   end subroutine test_materialize_extensions_reports_unsupported_item_class

   ! Task 6.5 / spec "An extension with no executing provider is still
   ! not given a payload": a vertical-grid mismatch (3c's own
   ! "unregistered characteristic fails loudly" case, no real
   ! build_transform) is unaffected by the materialization gate.
   @test(npes=[0])
   subroutine test_materialize_extensions_vgrid_mismatch_unaffected(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(GraphResolutionEntry), pointer :: entry
      type(VariableSpec) :: export_var_spec, import_var_spec
      type(mapl_BasicVerticalGrid) :: export_vgrid, import_vgrid
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_vgrid_mismatch', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      call export_vgrid%set_id(1)
      call import_vgrid%set_id(2)

      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T')
      export_var_spec%vertical_grid = export_vgrid
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T')
      import_var_spec%vertical_grid = import_vgrid
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_var_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_materialize_extensions(.true.)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      call set_materialize_extensions(.false.)
      ! VerticalGridCharacteristic%build_transform's own internal _FAIL
      ! (no real vertical-regrid Transform implemented, unchanged 3c
      ! behavior) - a structured "unsupported" report to this test's own
      ! caller (status remains 0 below), but still registered with
      ! pFUnit's own exception mechanism and must be consumed here,
      ! matching this suite's test_freeze_fails_and_leaves_graph_unfrozen_on_conflict
      ! precedent for a propagated internal _FAIL/_ASSERT.
      !
      ! openspec/changes/vertical-grid-graph-state-item: VerticalGridCharacteristic
      ! now also carries each side's declared physical dimensions
      ! (var_spec%vertical_grid%get_supported_physical_dimensions(), a
      ! pure accessor - GraphBuilder.F90's build_characteristics), so a
      ! mismatch's build_transform failure is now REQ-GEO-007a's
      ! three-way classification rather than one flat message.
      ! mapl_BasicVerticalGrid%get_supported_physical_dimensions()
      ! (BasicVerticalGrid.F90) always reports exactly one dimension,
      ! the literal "<unknown>" - both sides here report that same
      ! single dimension, so this is the "exactly one overlap" case.
      @assertExceptionRaised('VerticalCoordinateCharacteristic: single overlapping physical ' // &
           'dimension "<unknown>" identified as the adaptation candidate, but no real ' // &
           'vertical-regrid Transform is implemented yet')
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      entry => unsupported%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('T', entry%short_name)
      @assertEqual('VERTICAL_COORDINATE', entry%reason)

      _UNUSED_DUMMY(this)
   end subroutine test_materialize_extensions_vgrid_mismatch_unaffected

   ! openspec/changes/phase-10a-state-materialization, spec "Matching
   ! export is not materialized in registry mode": the default graph
   ! mode (GRAPH_MODE_REGISTRY, no setter ever called) leaves an
   ! exact-match export's own node an unallocated placeholder, exactly
   ! as before this sub-change - mirrors
   ! test_materialize_extensions_disabled_leaves_placeholder's own shape
   ! (no real ESMF_TestMethod/geom needed: the new materialization call
   ! is skipped entirely in this mode, never reaching geom resolution).
   @test(npes=[0])
   subroutine test_exact_match_not_materialized_in_registry_mode(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_export_id
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: export_payload
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_mode_registry', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='m'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      ! GRAPH_MODE_REGISTRY is the default - no setter call needed.
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))

      node => src_graph%get_node(t_export_id)
      select type (node)
      class is (StateItemNode)
         export_payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(export_payload%itemType(rc=status) == ESMF_STATEITEM_NOTFOUND)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(parent_graph)
   end subroutine test_exact_match_not_materialized_in_registry_mode

   ! Task 4.3: this is the test that would have failed against this
   ! change's first (separate-CompositeStateSpec-vector) design - two
   ! components each advertise a composite VariableSpec under the same
   ! top-level short_name via ordinary add_var_spec; an ordinary
   ! MatchConnection wires the top-level composite items directly, using
   ! the EXISTING graphbuilder_resolve_connections/for_each_matching_import
   ! code path completely unmodified (design.md Decisions "Top-level
   ! connectability is a consequence of the representation, not
   ! separately-implemented logic"). Direct wire, not an extension chain,
   ! since neither composite carries units/vertical_grid of its own.
   @test(npes=[0])
   subroutine test_ordinary_connection_wires_matching_composite(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(VariableSpec) :: export_composite, import_composite
      type(NodeId), pointer :: export_id, import_id
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_composite_match', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_composite = make_var(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE')
      export_composite%itemType = MAPL_STATEITEM_STATE
      call export_composite%declare_member('tracers', make_var(ESMF_STATEINTENT_EXPORT, 'tracers'), rc=status)
      @assert_that(status, is(0))
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_composite)

      import_composite = make_var(ESMF_STATEINTENT_IMPORT, 'PHYS_STATE')
      import_composite%itemType = MAPL_STATEITEM_STATE
      call import_composite%declare_member('tracers', make_var(ESMF_STATEINTENT_IMPORT, 'tracers'), rc=status)
      @assert_that(status, is(0))
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_composite)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      ! Unmodified call - no composite-aware branch added anywhere in
      ! graphbuilder_resolve_connections/for_each_matching_import/
      ! find_export_var_spec.
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE'))
      import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'PHYS_STATE'))
      @assert_that(associated(export_id), is(true()))
      @assert_that(associated(import_id), is(true()))

      net => parent_graph%get_network(parent_graph%get_default_network_id())
      ! Direct wire (spec "Matching export and import are wired"), not an
      ! extension chain - the composite items carry no units/vertical_grid
      ! of their own, so find_mismatched_characteristics reports none.
      @assert_that(net%contains_dependency(export_id, import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_ordinary_connection_wires_matching_composite

   ! openspec/changes/hierarchy-wide-component-graph, tasks.md 8.1 /
   ! graph/component-hierarchy delta spec "Composite member items are not
   ! independently nameable in a connection": confirms, with zero code
   ! change (design.md D6 - "already confirmed to hold structurally"),
   ! that a composite's internal member never becomes independently
   ! addressable. advertise_one only ever calls add_resource_index/
   ! add_import_port/add_export_port for the top-level composite
   ! identity itself (GraphBuilder_Advertising_smod.F90) -
   ! materialize_composite/materialize_member (CompositeStateMaterialization.F90)
   ! register each member's own StateItemNode but never call any of
   ! those three port/index-population procedures for it. Consequence:
   ! the member's own node is reachable only via the top-level node's own
   ! GraphStateItem%state_members map (already covered by
   ! test_composite_advertise_creates_node_tree above) - never via the
   ! component's own resource index or import/export-port tables, which
   ! is exactly what a connection endpoint lookup (resolve_local_node_id,
   ! for_each_matching_import, find_export_node) consults - confirmed
   ! here directly, by checking the member's own NodeId is absent from
   ! both port tables, and indirectly, by observing that an ordinary
   ! connection naming the member by its own short_name resolves nothing
   ! at all (no match, no unresolved report either - 'tracers' was never
   ! a declared import to begin with).
   @test(npes=[0])
   subroutine test_composite_member_not_independently_addressable(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(VariableSpec) :: export_composite, import_composite
      type(NodeId), pointer :: top_export_id, top_import_id
      type(NodeId), pointer :: export_member_id, import_member_id
      class(GraphNode), pointer :: generic_node
      type(GraphStateItem), pointer :: payload
      type(StateItemMemberMap), pointer :: members
      type(PortIdNodeIdMap) :: src_export_ports, dst_import_ports
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_composite_member', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_composite = make_var(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE')
      export_composite%itemType = MAPL_STATEITEM_STATE
      call export_composite%declare_member('tracers', make_var(ESMF_STATEINTENT_EXPORT, 'tracers'), rc=status)
      @assert_that(status, is(0))
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_composite)

      import_composite = make_var(ESMF_STATEINTENT_IMPORT, 'PHYS_STATE')
      import_composite%itemType = MAPL_STATEITEM_STATE
      call import_composite%declare_member('tracers', make_var(ESMF_STATEINTENT_IMPORT, 'tracers'), rc=status)
      @assert_that(status, is(0))
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_composite)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()

      ! Member is NOT in either component's own resource index, under
      ! either state intent - only the top-level composite's own
      ! identity key ('PHYS_STATE') is registered there.
      @assert_that(associated(src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'tracers'))), is(false()))
      @assert_that(associated(dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'tracers'))), is(false()))

      ! Find each member's own real NodeId the only way it IS reachable
      ! - through its own top-level node's state_members map (same path
      ! test_composite_advertise_creates_node_tree already confirms).
      top_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE'))
      @assert_that(associated(top_export_id), is(true()))
      generic_node => src_graph%get_node(top_export_id)
      select type (generic_node)
      class is (StateItemNode)
         payload => generic_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      members => payload%state_members_ptr()
      export_member_id => members%at('tracers')
      @assert_that(associated(export_member_id), is(true()))

      top_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'PHYS_STATE'))
      @assert_that(associated(top_import_id), is(true()))
      generic_node => dst_graph%get_node(top_import_id)
      select type (generic_node)
      class is (StateItemNode)
         payload => generic_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      members => payload%state_members_ptr()
      import_member_id => members%at('tracers')
      @assert_that(associated(import_member_id), is(true()))

      ! Member's own real NodeId is NOT a value anywhere in either
      ! component's own public import/export-port table - only the
      ! top-level composite's own NodeId is.
      src_export_ports = src_graph%get_export_ports()
      @assert_that(port_map_contains_value(src_export_ports, export_member_id), is(false()))
      @assert_that(port_map_contains_value(src_export_ports, top_export_id), is(true()))

      dst_import_ports = dst_graph%get_import_ports()
      @assert_that(port_map_contains_value(dst_import_ports, import_member_id), is(false()))
      @assert_that(port_map_contains_value(dst_import_ports, top_import_id), is(true()))

      ! An ordinary connection naming the member directly by its own
      ! short_name ('tracers') therefore cannot resolve it:
      ! for_each_matching_import (which drives resolve_match_connection
      ! below) only ever iterates dst_graph's own import-port table,
      ! which has no entry for 'tracers' - the connection's own pattern
      ! matches nothing at all. Left silently unmatched, not reported as
      ! unresolved either: unsatisfied-import reporting only covers
      ! DECLARED (import-port-table) items, and 'tracers' is not one.
      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='tracers')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='tracers')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      _UNUSED_DUMMY(this)
   end subroutine test_composite_member_not_independently_addressable

   logical function port_map_contains_value(ports, target) result(found)
      type(PortIdNodeIdMap), target, intent(in) :: ports
      type(NodeId), pointer, intent(in) :: target
      type(PortIdNodeIdMapIterator) :: iter
      type(NodeId) :: candidate

      found = .false.
      associate (e => ports%ftn_end())
         iter = ports%ftn_begin()
         do while (iter /= e)
            call iter%next()
            candidate = iter%second()
            if (candidate == target) then
               found = .true.
               return
            end if
         end do
      end associate
   end function port_map_contains_value

   ! Task 3.2 / design.md D3: exercises the EXISTING, unmodified
   ! resolve_match_connection/resolve_one/build_characteristics/
   ! find_mismatched_characteristics path - no new GraphBuilder hook -
   ! with two child components each advertising a
   ! MAPL_STATEITEM_VERTICALGRID-tagged composite under the same
   ! short_name. Identical declared physical-dimension sets wire a
   ! direct dependency edge (no extension chain), mirroring
   ! test_ordinary_connection_wires_matching_composite's own shape.
   @test(npes=[0])
   subroutine test_vertical_grid_composites_match_wires_directly(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(VariableSpec) :: export_vgrid, import_vgrid
      type(NodeId), pointer :: export_id, import_id
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_vgrid_match', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_vgrid = make_var(ESMF_STATEINTENT_EXPORT, 'MY_VGRID')
      export_vgrid%itemType = MAPL_STATEITEM_STATE
      export_vgrid%state_item_variant = MAPL_STATEITEM_VERTICALGRID
      call export_vgrid%declare_member('pressure', make_var(ESMF_STATEINTENT_EXPORT, 'PLE'), rc=status)
      @assert_that(status, is(0))
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_vgrid)

      import_vgrid = make_var(ESMF_STATEINTENT_IMPORT, 'MY_VGRID')
      import_vgrid%itemType = MAPL_STATEITEM_STATE
      import_vgrid%state_item_variant = MAPL_STATEITEM_VERTICALGRID
      call import_vgrid%declare_member('pressure', make_var(ESMF_STATEINTENT_IMPORT, 'PLE'), rc=status)
      @assert_that(status, is(0))
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_vgrid)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'MY_VGRID'))
      import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'MY_VGRID'))
      @assert_that(associated(export_id), is(true()))
      @assert_that(associated(import_id), is(true()))

      net => parent_graph%get_network(parent_graph%get_default_network_id())
      @assert_that(net%contains_dependency(export_id, import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_vertical_grid_composites_match_wires_directly

   ! Task 3.2: differing dimension sets with exactly one overlap -
   ! delegates to find_or_build_extension_chain (unmodified dispatch),
   ! which fails explicitly via the SAME VerticalGridCharacteristic used
   ! for ordinary Field-level vertical-grid matching
   ! (test_materialize_extensions_vgrid_mismatch_unaffected, above) - its
   ! build_transform's REQ-GEO-007a "single dimension identified"
   ! message, reported as an "unsupported" entry under this composite's
   ! own short_name.
   @test(npes=[0])
   subroutine test_vertical_grid_composites_single_overlap_fails_explicitly(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(GraphResolutionEntry), pointer :: entry
      type(VariableSpec) :: export_vgrid, import_vgrid
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_vgrid_single_overlap', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_vgrid = make_var(ESMF_STATEINTENT_EXPORT, 'MY_VGRID')
      export_vgrid%itemType = MAPL_STATEITEM_STATE
      export_vgrid%state_item_variant = MAPL_STATEITEM_VERTICALGRID
      call export_vgrid%declare_member('pressure', make_var(ESMF_STATEINTENT_EXPORT, 'PLE'), rc=status)
      @assert_that(status, is(0))
      call export_vgrid%declare_member('height', make_var(ESMF_STATEINTENT_EXPORT, 'ZLE'), rc=status)
      @assert_that(status, is(0))
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_vgrid)

      import_vgrid = make_var(ESMF_STATEINTENT_IMPORT, 'MY_VGRID')
      import_vgrid%itemType = MAPL_STATEITEM_STATE
      import_vgrid%state_item_variant = MAPL_STATEITEM_VERTICALGRID
      call import_vgrid%declare_member('pressure', make_var(ESMF_STATEINTENT_IMPORT, 'PLE'), rc=status)
      @assert_that(status, is(0))
      call import_vgrid%declare_member('depth', make_var(ESMF_STATEINTENT_IMPORT, 'DEPTH'), rc=status)
      @assert_that(status, is(0))
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_vgrid)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assertExceptionRaised('VerticalCoordinateCharacteristic: single overlapping physical ' // &
           'dimension "pressure" identified as the adaptation candidate, but no real ' // &
           'vertical-regrid Transform is implemented yet')
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      entry => unsupported%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('MY_VGRID', entry%short_name)
      @assertEqual('VERTICAL_COORDINATE', entry%reason)

      _UNUSED_DUMMY(this)
   end subroutine test_vertical_grid_composites_single_overlap_fails_explicitly

   ! Shared fixture for the remaining REQ-GEO-007a connection-path
   ! outcomes. The single-overlap case above uses an explicit fixture so
   ! its expected diagnostic remains especially clear.
   subroutine resolve_vertical_grid_membership_mismatch(export_dimensions, import_dimensions, &
         unresolved, unsupported, rc)
      character(*), intent(in) :: export_dimensions(:)
      character(*), intent(in) :: import_dimensions(:)
      type(GraphResolutionEntryVector), intent(out) :: unresolved
      type(GraphResolutionEntryVector), intent(out) :: unsupported
      integer, optional, intent(out) :: rc

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(VariableSpec) :: export_vgrid, import_vgrid, member
      integer :: status, i
      character(:), allocatable :: dimension
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_vgrid_overlap_case', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_vgrid = make_var(ESMF_STATEINTENT_EXPORT, 'MY_VGRID')
      export_vgrid%itemType = MAPL_STATEITEM_STATE
      export_vgrid%state_item_variant = MAPL_STATEITEM_VERTICALGRID
      do i = 1, size(export_dimensions)
         dimension = trim(export_dimensions(i))
         member = make_var(ESMF_STATEINTENT_EXPORT, dimension)
         call export_vgrid%declare_member(dimension, member, _RC)
      end do
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_vgrid)

      import_vgrid = make_var(ESMF_STATEINTENT_IMPORT, 'MY_VGRID')
      import_vgrid%itemType = MAPL_STATEITEM_STATE
      import_vgrid%state_item_variant = MAPL_STATEITEM_VERTICALGRID
      do i = 1, size(import_dimensions)
         dimension = trim(import_dimensions(i))
         member = make_var(ESMF_STATEINTENT_IMPORT, dimension)
         call import_vgrid%declare_member(dimension, member, _RC)
      end do
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_vgrid)

      call gb%advertise(src_meta, _RC)
      call gb%advertise(dst_meta, _RC)

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)

      if (present(rc)) rc = status
   end subroutine resolve_vertical_grid_membership_mismatch

   @test(npes=[0])
   subroutine test_vertical_grid_composites_zero_overlap_fails_incompatible(this)
      class(MpiTestMethod), intent(inout) :: this
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(GraphResolutionEntry), pointer :: entry
      integer :: status

      call resolve_vertical_grid_membership_mismatch([character(8) :: 'pressure'], [character(8) :: 'height'], &
           unresolved, unsupported, status)
      @assertExceptionRaised('VerticalCoordinateCharacteristic: incompatible - no common ' // &
           'physical dimension between export and import vertical grids')
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      entry => unsupported%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('MY_VGRID', entry%short_name)
      @assertEqual('VERTICAL_COORDINATE', entry%reason)

      _UNUSED_DUMMY(this)
   end subroutine test_vertical_grid_composites_zero_overlap_fails_incompatible

   @test(npes=[0])
   subroutine test_vertical_grid_composites_multiple_overlap_fails_ambiguous(this)
      class(MpiTestMethod), intent(inout) :: this
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(GraphResolutionEntry), pointer :: entry
      integer :: status

      call resolve_vertical_grid_membership_mismatch([character(8) :: 'pressure', 'height'], &
           [character(8) :: 'height', 'pressure', 'depth'], &
           unresolved, unsupported, status)
      @assertExceptionRaised('VerticalCoordinateCharacteristic: ambiguous - more than one ' // &
           'common physical dimension between export and import vertical grids (height,pressure)')
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      entry => unsupported%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('MY_VGRID', entry%short_name)
      @assertEqual('VERTICAL_COORDINATE', entry%reason)

      _UNUSED_DUMMY(this)
   end subroutine test_vertical_grid_composites_multiple_overlap_fails_ambiguous

   ! -- openspec/changes/callback-wiring ------------------------------------

   ! Builds the PassiveTracer CallbackInterface (15-callbacks.md sec
   ! 15.3): one "tracers" FieldBundle argument, "get" (OUT) / "put" (IN)
   ! methods - same fixture shape as
   ! graph/tests/Test_CallbackStateBinding.pf's own
   ! make_passive_tracer_interface.
   function make_passive_tracer_interface(rc) result(iface)
      integer, optional, intent(out) :: rc
      type(CallbackInterface) :: iface

      integer :: status

      call iface%declare_argument('tracers', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call iface%declare_method('get', rc=status)
      @assertEqual(0, status)
      call iface%declare_method('put', rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('get', 'tracers', MAPL_ACCESS_OUT, rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('put', 'tracers', MAPL_ACCESS_IN, rc=status)
      @assertEqual(0, status)

      _RETURN(_SUCCESS)
   end function make_passive_tracer_interface

   ! One composite export satisfying PassiveTracer: itemType STATE, one
   ! declared 'tracers' FieldBundle member.
   function make_tracer_callback_export(short_name) result(var_spec)
      character(*), intent(in) :: short_name
      type(VariableSpec) :: var_spec

      type(VariableSpec) :: tracers_member
      integer :: status

      var_spec = make_var(ESMF_STATEINTENT_EXPORT, short_name)
      var_spec%itemType = MAPL_STATEITEM_STATE

      tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers')
      tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call var_spec%declare_member('tracers', tracers_member, rc=status)
      @assertEqual(0, status)
   end function make_tracer_callback_export

   ! Builds root -> CHEM -> DU, SS (each exporting a 'tracer_callback'
   ! composite satisfying PassiveTracer) plus root -> DYN (a plain child,
   ! left for the caller to advertise its own 'tracers' import onto) -
   ! mirrors 15-callbacks.md's own DU/SS/... tracer-callback example.
   ! Every component below DYN is already advertised, children before
   ! parents, matching real recursion order.
   subroutine build_tracer_hierarchy(service_name, root_gc, root_meta, chem_meta, du_meta, ss_meta, &
        dyn_meta, iface, interface_id, rc)
      character(*), intent(in) :: service_name
      type(ESMF_GridComp), intent(out) :: root_gc
      type(OuterMetaComponent), pointer, intent(out) :: root_meta
      type(OuterMetaComponent), pointer, intent(out) :: chem_meta
      type(OuterMetaComponent), pointer, intent(out) :: du_meta
      type(OuterMetaComponent), pointer, intent(out) :: ss_meta
      type(OuterMetaComponent), pointer, intent(out) :: dyn_meta
      type(CallbackInterface), intent(out) :: iface
      type(CallbackInterfaceId), intent(out) :: interface_id
      integer, optional, intent(out) :: rc

      integer :: status
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, dyn_driver, du_driver, ss_driver
      type(ESMF_GridComp) :: chem_gc, dyn_gc, du_gc, ss_gc
      type(ComponentSpec), pointer :: du_spec, ss_spec
      type(GraphBuilder) :: gb

      iface = make_passive_tracer_interface(_RC)
      call register_callback_interface(service_name, iface, interface_id, _RC)

      call make_outer_meta('root_' // service_name, root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('DYN', child_spec, _RC)

      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)

      dyn_driver = root_meta%get_child('DYN', _RC)
      dyn_gc = dyn_driver%get_gridcomp()
      dyn_meta => get_outer_meta(dyn_gc, _RC)

      child_spec = ChildSpec()
      call chem_meta%add_child('DU', child_spec, _RC)
      child_spec = ChildSpec()
      call chem_meta%add_child('SS', child_spec, _RC)

      du_driver = chem_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)

      ss_driver = chem_meta%get_child('SS', _RC)
      ss_gc = ss_driver%get_gridcomp()
      ss_meta => get_outer_meta(ss_gc, _RC)

      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_tracer_callback_export('tracer_callback'))

      ss_spec => ss_meta%get_component_spec()
      call ss_spec%add_var_spec(make_tracer_callback_export('tracer_callback'))

      call gb%advertise(du_meta, _RC)
      call gb%advertise(ss_meta, _RC)
      call gb%advertise(chem_meta, _RC)
      call gb%advertise(dyn_meta, _RC)
      call gb%advertise(root_meta, _RC)

      _RETURN(_SUCCESS)
   end subroutine build_tracer_hierarchy

   ! Task 5.3 / spec "The materialized collection contains exactly the
   ! resolved matches" + "Re-resolving does not duplicate collection
   ! members": full pipeline through the public
   ! GraphBuilder%resolve_connections() entry point.
   @test(npes=[0])
   subroutine test_callback_collection_materializes_and_wires_import(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, du_meta, ss_meta, dyn_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: root_spec, dyn_spec
      type(VariableSpec) :: dyn_import
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(ComponentGraph), pointer :: root_graph
      type(ComponentGraph), pointer :: dyn_graph
      type(NodeId), pointer :: import_id
      type(DependencyNetwork), pointer :: net
      type(NodeIdSet), target :: preds
      type(NodeIdSetIterator) :: pred_iter
      type(NodeId) :: collection_id, collection_id_again
      class(GraphNode), pointer :: collection_node
      type(GraphStateItem), pointer :: collection_payload
      type(StateItemMemberMap), pointer :: members
      integer :: status
      type(GraphBuilder) :: gb

      call build_tracer_hierarchy('svc-5-3', root_gc, root_meta, chem_meta, du_meta, ss_meta, &
           dyn_meta, iface, interface_id, _RC)

      dyn_import = make_var(ESMF_STATEINTENT_IMPORT, 'tracers')
      dyn_import%callback_interface_id = interface_id
      dyn_spec => dyn_meta%get_component_spec()
      call dyn_spec%add_var_spec(dyn_import)
      call gb%advertise(dyn_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback')), &
           ConnectionPt('DYN', VirtualConnectionPt(state_intent='import', short_name='tracers')))
      root_spec => root_meta%get_component_spec()
      call root_spec%add_connection(conn)

      call gb%resolve_connections(root_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      root_graph => root_meta%get_component_graph()
      dyn_graph => dyn_meta%get_component_graph()
      ! openspec/changes/hierarchy-wide-component-graph, tasks.md 5.4:
      ! DYN's own real import NodeId, in DYN's own graph - no parent-
      ! local proxy exists anymore.
      import_id => dyn_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'tracers'))
      @assert_that(associated(import_id), is(true()))

      net => root_graph%get_network(root_graph%get_default_network_id())
      preds = net%get_predecessors(import_id)
      @assertEqual(1, preds%size())
      pred_iter = preds%ftn_begin()
      call pred_iter%next()
      collection_id = pred_iter%of()

      collection_node => root_graph%get_node(collection_id)
      select type (collection_node)
      class is (StateItemNode)
         collection_payload => collection_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      members => collection_payload%state_members_ptr()
      @assertEqual(2, members%size())
      @assert_that(associated(members%at('DU/tracer_callback')), is(true()))
      @assert_that(associated(members%at('SS/tracer_callback')), is(true()))

      ! Idempotency: re-resolving does not create a second collection.
      call gb%resolve_connections(root_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      preds = net%get_predecessors(import_id)
      @assertEqual(1, preds%size())
      pred_iter = preds%ftn_begin()
      call pred_iter%next()
      collection_id_again = pred_iter%of()
      @assert_that(collection_id_again == collection_id, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_callback_collection_materializes_and_wires_import

   ! Task 3.2 / spec "A destination with no declared callback interface
   ! is unaffected": ordinary resolution, unchanged, for a var_spec
   ! whose callback_interface_id is left at its default (unset) value.
   @test(npes=[0])
   subroutine test_non_callback_destination_unaffected(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(NodeId), pointer :: t_export_id, t_import_id
      type(DependencyNetwork), pointer :: net
      type(VariableSpec) :: import_var_spec
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_no_callback', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T')
      @assertFalse(import_var_spec%callback_interface_id%is_valid())
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_var_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      net => parent_graph%get_network(parent_graph%get_default_network_id())
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_non_callback_destination_unaffected

   ! openspec/changes/graph-builder-resolution-index, task 4.3 / spec
   ! "A connection naming a multi-level-distant component resolves
   ! correctly": a MatchConnection naming a parent-level child
   ! ('SRC_PARENT') and a sibling child ('DST_PARENT'), where the real
   ! export/import items are advertised on a grandchild beneath each
   ! named endpoint ('SRC_PARENT/SRC_LEAF', 'DST_PARENT/DST_LEAF') - the
   ! shape every real connect_all fixture already has (proposal.md
   ! "Why"). Under the old single-level component_spec_for dispatch,
   ! this would fail to find anything (SRC_PARENT/DST_PARENT's own
   ! var_specs are empty); resolve_qualified_component now walks down to
   ! the leaf that actually owns the item.
   @test(npes=[0])
   subroutine test_ordinary_connection_resolves_through_multi_level_names(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: src_parent_driver, dst_parent_driver
      type(GriddedComponentDriver) :: src_leaf_driver, dst_leaf_driver
      type(ESMF_GridComp) :: src_parent_gc, dst_parent_gc, src_leaf_gc, dst_leaf_gc
      type(OuterMetaComponent), pointer :: src_parent_meta, dst_parent_meta
      type(OuterMetaComponent), pointer :: src_leaf_meta, dst_leaf_meta
      type(ComponentSpec), pointer :: parent_spec, src_leaf_spec, dst_leaf_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_leaf_graph, dst_leaf_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(NodeId), pointer :: t_export_id, t_import_id
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_multilevel_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('SRC_PARENT', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('DST_PARENT', child_spec, _RC)

      src_parent_driver = parent_meta%get_child('SRC_PARENT', _RC)
      dst_parent_driver = parent_meta%get_child('DST_PARENT', _RC)
      src_parent_gc = src_parent_driver%get_gridcomp()
      dst_parent_gc = dst_parent_driver%get_gridcomp()
      src_parent_meta => get_outer_meta(src_parent_gc, _RC)
      dst_parent_meta => get_outer_meta(dst_parent_gc, _RC)

      child_spec = ChildSpec()
      call src_parent_meta%add_child('SRC_LEAF', child_spec, _RC)
      child_spec = ChildSpec()
      call dst_parent_meta%add_child('DST_LEAF', child_spec, _RC)

      src_leaf_driver = src_parent_meta%get_child('SRC_LEAF', _RC)
      dst_leaf_driver = dst_parent_meta%get_child('DST_LEAF', _RC)
      src_leaf_gc = src_leaf_driver%get_gridcomp()
      dst_leaf_gc = dst_leaf_driver%get_gridcomp()
      src_leaf_meta => get_outer_meta(src_leaf_gc, _RC)
      dst_leaf_meta => get_outer_meta(dst_leaf_gc, _RC)

      src_leaf_spec => src_leaf_meta%get_component_spec()
      call src_leaf_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      dst_leaf_spec => dst_leaf_meta%get_component_spec()
      call dst_leaf_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))

      ! Children advertise before parents - deepest-first, mirroring
      ! real recursion order (OuterMetaComponent/initialize_advertise.F90).
      call gb%advertise(src_leaf_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_leaf_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(src_parent_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_parent_meta, status)
      @assert_that(status, is(0))

      ! The connection names SRC_PARENT/DST_PARENT - neither of which
      ! advertises 'T' directly (it lives on their own grandchild,
      ! SRC_LEAF/DST_LEAF).
      conn = MatchConnection( &
           ConnectionPt('SRC_PARENT/SRC_LEAF', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('DST_PARENT/DST_LEAF', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      ! openspec/changes/hierarchy-wide-component-graph, tasks.md 3.4:
      ! the grandchildren's own real NodeIds, each in its own graph -
      ! wired directly, regardless of how many levels down they live.
      parent_graph => parent_meta%get_component_graph()
      src_leaf_graph => src_leaf_meta%get_component_graph()
      dst_leaf_graph => dst_leaf_meta%get_component_graph()
      t_export_id => src_leaf_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_leaf_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      net => parent_graph%get_network(parent_graph%get_default_network_id())
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_ordinary_connection_resolves_through_multi_level_names

   ! Task 6.2 / openspec/changes/graph-builder-stateitem-resolution,
   ! proposal.md Impact "New coverage" + spec scenario "Resolution
   ! succeeds when the originating declaration is no longer reachable":
   ! advertises a matching export/import pair, then OVERWRITES both
   ! sides' ComponentSpec%var_specs with a different, MISMATCHING
   ! VariableSpec declared under the same short name (different units)
   ! before calling resolve_connections - proving resolution's outcome
   ! (exact match, direct wiring, no extension chain) depends only on
   ! each side's own already-advertised StateItemNode/GraphStateItem,
   ! never on re-reading whatever ComponentSpec%var_specs currently
   ! holds. If resolution still re-read var_specs (the pre-this-change
   ! behavior), it would see the mismatching units and delegate to the
   ! extension-reuse capability instead of wiring directly - this test
   ! would then fail by finding an interposed extension chain where a
   ! direct edge is asserted instead.
   @test(npes=[0])
   subroutine test_resolution_succeeds_with_no_live_var_spec_reference(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(GraphResolutionEntryVector) :: unsupported
      type(NodeId), pointer :: t_export_id, t_import_id
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_no_live_varspec_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='K'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='K'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      ! Identity/characteristics are now set on each side's own
      ! StateItemNode (task 2.1/2.2). Overwrite both ComponentSpecs'
      ! own var_specs with a MISMATCHING declaration under the same
      ! short name 'T' (different units) - if resolution still read
      ! var_specs by name, it would see this mismatch and delegate to
      ! an extension chain instead of wiring directly.
      src_spec%var_specs = VariableSpecVector()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='mismatched_units'))
      dst_spec%var_specs = VariableSpecVector()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='mismatched_units'))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      ! Direct wiring (REQ-EXT-003 no-op case), not an extension chain -
      ! the real proof that the (stale, mismatching) var_specs were
      ! never consulted: resolution still sees the two sides as
      ! matching, from each side's own already-established node
      ! characteristics (set once at advertise time, before the
      ! var_specs overwrite above).
      net => parent_graph%get_network(parent_graph%get_default_network_id())
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_resolution_succeeds_with_no_live_var_spec_reference

end module Test_GraphBuilder_ConnectionResolution
