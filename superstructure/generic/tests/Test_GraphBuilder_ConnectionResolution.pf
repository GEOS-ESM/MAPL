      _UNUSED_DUMMY(this)
   end subroutine test_quantity_basis_only_pair_is_unsupported

   ! HorizontalDimsSpec GEOM (export) vs NONE (import) can never connect.
   ! It is reported in connection_conflicts, naming the kind and both
   ! values, not as unsupported; nothing is wired for that import, and the
   ! component's other connection (U) still resolves.
   @test(npes=[0])
   subroutine test_incompatible_dims_is_conflict_others_resolve(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported, conflicts
      type(GraphResolutionEntry), pointer :: entry
      type(VariableSpec) :: import_var_spec
      type(NodeId), pointer :: t_export_id, t_import_id, u_export_id, u_import_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_dims_conflict', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='K'))
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'U', units='K'))

      dst_spec => dst_meta%get_component_spec()
      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T', units='K')
      import_var_spec%horizontal_dims_spec = HORIZONTAL_DIMS_NONE
      call dst_spec%add_var_spec(import_var_spec)
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'U', units='K'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, connection_conflicts=conflicts, rc=status)
      @assert_that(status, is(0))

      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())
      @assertEqual(1, conflicts%size())
      entry => conflicts%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('T', entry%short_name)
      @assertEqual('incompatible HORIZONTAL_DIMS_SPEC: export horizontal_dims_spec=HORIZONTAL_DIMS_GEOM, ' // &
           'import horizontal_dims_spec=HORIZONTAL_DIMS_NONE', entry%reason)

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      u_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'U'))
      u_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'U'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))
      @assert_that(associated(u_export_id), is(true()))
      @assert_that(associated(u_import_id), is(true()))

      net_id = parent_graph%get_forward_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%has_predecessors(t_import_id), is(false()))
      @assert_that(net%contains_dependency(u_export_id, u_import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_incompatible_dims_is_conflict_others_resolve

   ! A kind other than HorizontalDimsSpec reports the same way: an
   ! UngriddedDims mismatch (export none, import one dimension of extent 5)
   ! is one connection_conflicts entry, not unsupported; nothing is wired
   ! for that import, and the component's other connection (U) resolves.
   @test(npes=[0])
   subroutine test_incompatible_ungridded_dims_is_conflict(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported, conflicts
      type(GraphResolutionEntry), pointer :: entry
      type(VariableSpec) :: import_var_spec
      type(NodeId), pointer :: t_export_id, t_import_id, u_export_id, u_import_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_ungridded_conflict', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='K'))
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'U', units='K'))

      dst_spec => dst_meta%get_component_spec()
      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T', units='K')
      import_var_spec%ungridded_dims = UngriddedDims([5])
      call dst_spec%add_var_spec(import_var_spec)
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'U', units='K'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, connection_conflicts=conflicts, rc=status)
      @assert_that(status, is(0))

      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())
      @assertEqual(1, conflicts%size())
      entry => conflicts%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('T', entry%short_name)
      @assertEqual('incompatible UNGRIDDED_DIMS: export ungridded_dims=, ' // &
           'import ungridded_dims=NONE:5', entry%reason)

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      u_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'U'))
      u_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'U'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))
      @assert_that(associated(u_export_id), is(true()))
      @assert_that(associated(u_import_id), is(true()))

      net_id = parent_graph%get_forward_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%has_predecessors(t_import_id), is(false()))
      @assert_that(net%contains_dependency(u_export_id, u_import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_incompatible_ungridded_dims_is_conflict

   ! Expression evaluation succeeds first; incompatibility is reported
   ! between its FIELD result and the consumer.
   @test(npes=[0])
   subroutine test_expression_export_ungridded_dims_conflict(this)
      class(MpiTestMethod), intent(inout) :: this

       type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
       type(ComponentGraph), pointer :: parent_graph, dst_graph
       type(GraphResolutionEntryVector) :: unresolved, unsupported, conflicts
       type(GraphResolutionEntry), pointer :: entry
       type(NodeId), pointer :: import_id
      integer :: status
      type(GraphBuilder) :: gb

       call make_expression_fixture('expr_ungridded', ['I'], ['m'], &
             [ESMF_TYPEKIND_R4], parent_meta, src_meta, dst_meta, rc=status, &
            import_ungridded=.true.)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, &
           connection_conflicts=conflicts, rc=status)
      @assert_that(status, is(0))

      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())
      @assertEqual(1, conflicts%size())
      entry => conflicts%at(1, status)
       @assertEqual('dst', entry%component_name)
       @assertEqual('I', entry%short_name)
      @assertEqual('incompatible UNGRIDDED_DIMS: export ungridded_dims=, ' // &
            'import ungridded_dims=NONE:5', entry%reason)
       parent_graph => parent_meta%get_component_graph()
       dst_graph => dst_meta%get_component_graph()
       import_id => dst_graph%get_resource_index( &
            item_key(ESMF_STATEINTENT_IMPORT, 'I'))
       @assertEqual(1, expression_evaluation_count(parent_graph))
       block
          type(DependencyNetwork), pointer :: net
          net => parent_graph%get_network( &
               parent_graph%get_forward_network_id())
          @assertFalse(net%has_predecessors(import_id))
       end block

      _UNUSED_DUMMY(this)
   end subroutine test_expression_export_ungridded_dims_conflict

   @test(npes=[0])
   subroutine test_expression_connection_builds_evaluation_in_parent(this)
      class(MpiTestMethod), intent(inout) :: this
      type(OuterMetaComponent), pointer :: parent, src, dst
      type(ComponentGraph), pointer :: pg, sg, dg
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: expr_id, import_id
      type(NodeId) :: result_id, transform_id
      type(DependencyNetwork), pointer :: net
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: payload
      integer :: status
      type(GraphBuilder) :: gb

      call make_expression_fixture('expr_one', ['I'], ['m'], &
           [ESMF_TYPEKIND_R4], parent, src, dst, _RC)
      call gb%resolve_connections(parent, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())
      pg => parent%get_component_graph()
      sg => src%get_component_graph()
      dg => dst%get_component_graph()
      @assertEqual(1, expression_evaluation_count(pg))
      @assertEqual(0, expression_evaluation_count(sg))
      import_id => dg%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, &
           'I'))
      expr_id => sg%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, &
           'expr'))
      result_id = sole_predecessor_of(pg, import_id)
      transform_id = sole_predecessor_of(pg, result_id)
      @assertTrue(pg%owns_node(result_id))
      @assertTrue(pg%owns_node(transform_id))
      node => pg%get_node(transform_id)
      select type (node)
      class is (TransformGraphNode)
         @assertTrue(node%is_input_port('A'))
         @assertTrue(node%is_input_port('B'))
      class default
         @assertTrue(.false., 'expression predecessor is not a transform')
      end select
      net => pg%get_network(pg%get_forward_network_id())
      @assertFalse(net%has_predecessors(expr_id))
      @assertFalse(net%has_successors(expr_id))
      node => sg%get_node(expr_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
         @assertTrue(payload%itemType(rc=status) == ESMF_STATEITEM_NOTFOUND)
      end select
      _UNUSED_DUMMY(this)
   end subroutine test_expression_connection_builds_evaluation_in_parent

