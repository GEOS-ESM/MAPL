      call check_accept_transfer_missing_name_is_fatal( &
           '{validation_mode: strict}', this)
   end subroutine test_accept_transfer_missing_name_is_fatal_in_strict_mode

   subroutine check_accept_transfer_missing_name_is_fatal(validation, this)
      character(*), intent(in) :: validation
      class(MpiTestMethod), intent(inout) :: this
      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(VariableSpec) :: var
      type(ESMF_State) :: import_state, export_state
      type(ESMF_Time) :: start_time
      type(ESMF_TimeInterval) :: timestep
      type(ESMF_Clock) :: clock
      integer :: status
      type(GraphBuilder) :: gb

      call use_validation(validation)
      call make_outer_meta('comp_missing_expression_initialize', outer_gc, &
           outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      var = make_var(ESMF_STATEINTENT_EXPORT, 'expr', units='m')
      var%itemType = MAPL_STATEITEM_EXPRESSION
      var%expression = 'MISSING'
      call comp_spec%add_var_spec(var)
      call gb%advertise(outer_meta, status)
      @assertEqual(0, status)

      import_state = ESMF_StateCreate(_RC)
      export_state = ESMF_StateCreate(_RC)
      call ESMF_TimeSet(start_time, yy=2000, _RC)
      call ESMF_TimeIntervalSet(timestep, h=1, _RC)
      clock = ESMF_ClockCreate(timestep=timestep, startTime=start_time, _RC)

      call outer_meta%initialize_accept_transfer(import_state, export_state, &
           clock, rc=status)
      @assertExceptionRaised('GraphBuilder: expression expr references missing item MISSING')
      @assertExceptionRaised('status=1')
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine check_accept_transfer_missing_name_is_fatal

