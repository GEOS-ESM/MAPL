      class is (TransformGraphNode)
         @assertTrue(node%is_input_port('A'))
         @assertTrue(node%is_input_port('B'))
      class default
         @assertTrue(.false., 'result producer is not ExpressionTransform')
      end select
      _UNUSED_DUMMY(this)
   end subroutine test_expression_result_units_chain_starts_at_result

