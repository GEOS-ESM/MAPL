   @test(npes=[0])
   subroutine test_expression_precision_consumers_get_two_evaluations(this)
      class(MpiTestMethod), intent(inout) :: this
      type(OuterMetaComponent), pointer :: parent, src, dst
      type(ComponentGraph), pointer :: pg, dg, sg
      type(DependencyNetwork), pointer :: net
      type(GraphResolutionEntryVector) :: unsupported
      type(NodeId), pointer :: i1, i2
      type(NodeId) :: result1, result2
      integer :: status
      type(GraphBuilder) :: gb

      call make_expression_fixture('expr_split', ['I1', 'I2'], &
           ['m ', 'm '], [ESMF_TYPEKIND_R4, ESMF_TYPEKIND_R8], &
           parent, src, dst, _RC)
      call gb%resolve_connections(parent, &
           unsupported_characteristics=unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, unsupported%size())
      pg => parent%get_component_graph()
      dg => dst%get_component_graph()
      sg => src%get_component_graph()
      i1 => dg%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'I1'))
      i2 => dg%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'I2'))
      net => pg%get_network(pg%get_forward_network_id())
      @assertEqual(2, expression_evaluation_count(pg))
      @assertTrue(net%has_predecessors(i1))
      @assertTrue(net%has_predecessors(i2))
      if (.not. net%has_predecessors(i2)) return
      result1 = sole_predecessor_of(pg, i1)
      result2 = sole_predecessor_of(pg, i2)
      @assertFalse(result1 == result2)
      call assert_expression_input(pg, sg, result1, 'A', 'R4', .false.)
      call assert_expression_input(pg, sg, result1, 'B', 'R4', .false.)
      call assert_expression_input(pg, sg, result2, 'A', 'R8', .true.)
      call assert_expression_input(pg, sg, result2, 'B', 'R8', .true.)
      _UNUSED_DUMMY(this)
   end subroutine test_expression_precision_consumers_get_two_evaluations

   @test(npes=[0])
   subroutine test_expression_resolution_is_idempotent(this)
      class(MpiTestMethod), intent(inout) :: this
      type(OuterMetaComponent), pointer :: parent, src, dst
      type(ComponentGraph), pointer :: pg
      type(ComponentGraph), pointer :: dg
      type(DependencyNetwork), pointer :: net
      type(NodeId), pointer :: import_id
      type(NodeId) :: first_result, second_result
      type(NodeIdSet), target :: first_ids, second_ids, first_edges, second_edges
      integer :: status
      type(GraphBuilder) :: gb

      call make_expression_fixture('expr_idempotent', ['I'], ['m'], &
           [ESMF_TYPEKIND_R4], parent, src, dst, _RC)
      call gb%resolve_connections(parent, rc=status)
      @assertEqual(0, status)
      pg => parent%get_component_graph()
      @assertEqual(1, expression_evaluation_count(pg))
      if (expression_evaluation_count(pg) /= 1) return
      dg => dst%get_component_graph()
      import_id => dg%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, &
           'I'))
      @assertEqual(1, expression_evaluation_count(pg))
      first_result = sole_predecessor_of(pg, import_id)
      @assertTrue(first_result%is_valid())
      first_ids = pg%get_node_ids()
      net => pg%get_network(pg%get_forward_network_id())
      first_edges = net%get_referenced_ids()
      call gb%resolve_connections(parent, rc=status)
      @assertEqual(0, status)
      second_ids = pg%get_node_ids()
      second_edges = net%get_referenced_ids()
      @assertEqual(first_ids%size(), second_ids%size())
      @assertEqual(first_edges%size(), second_edges%size())
      @assertEqual(1, expression_evaluation_count(pg))
      second_result = sole_predecessor_of(pg, import_id)
      @assertTrue(first_result == second_result)
      _UNUSED_DUMMY(this)
   end subroutine test_expression_resolution_is_idempotent

