      type(ComponentGraph), pointer :: pg, dg, sg
      type(NodeId), pointer :: i1, i2
      type(NodeId) :: result1, result2
      type(NodeIdSet), target :: before_ids, after_ids
      type(GraphResolutionEntryVector) :: unsupported
      integer :: status
      type(GraphBuilder) :: gb

      call make_expression_fixture('expr_reuse_inputs', ['I1', 'I2'], &
           ['m', 'm'], [ESMF_TYPEKIND_R8, ESMF_TYPEKIND_R8], &
           parent, src, dst, _RC)
      call gb%resolve_connections(parent, &
           unsupported_characteristics=unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, unsupported%size())
      pg => parent%get_component_graph()
      dg => dst%get_component_graph()
      sg => src%get_component_graph()
      @assertEqual(1, expression_evaluation_count(pg))
      if (expression_evaluation_count(pg) /= 1) return
      i1 => dg%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'I1'))
      i2 => dg%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'I2'))
      result1 = sole_predecessor_of(pg, i1)
      result2 = sole_predecessor_of(pg, i2)
      @assertTrue(result1 == result2)
      call assert_expression_input(pg, sg, result1, 'A', 'R8', .true.)
      call assert_expression_input(pg, sg, result1, 'B', 'R8', .true.)
      before_ids = pg%get_node_ids()
      call gb%resolve_connections(parent, &
           unsupported_characteristics=unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, unsupported%size())
      after_ids = pg%get_node_ids()
      @assertEqual(before_ids%size(), after_ids%size())
      @assertEqual(1, expression_evaluation_count(pg))
      result2 = sole_predecessor_of(pg, i2)
      @assertTrue(result1 == result2)
      _UNUSED_DUMMY(this)
   end subroutine test_expression_converted_inputs_are_reused

   ! The same evaluation needed by a connection declared on another
   ! component (here the source itself, connecting its expression to its
   ! own import) reuses the evaluation the parent built: one expression
   ! transform in the hierarchy.
   @test(npes=[0])
   subroutine test_expression_reused_across_declaring_components(this)
      class(MpiTestMethod), intent(inout) :: this
      type(OuterMetaComponent), pointer :: parent, src, dst
      type(ComponentGraph), pointer :: pg, dg, sg
      type(ComponentSpec), pointer :: src_spec
      type(NodeId), pointer :: i1, i2
      type(NodeId) :: result1, result2
      type(VariableSpec) :: var
      type(SimpleConnection) :: conn
      type(GraphResolutionEntryVector) :: unsupported
      integer :: status
      type(GraphBuilder) :: gb

      call make_expression_fixture('expr_reuse_declarers', ['I1'], &
           ['m'], [ESMF_TYPEKIND_R4], parent, src, dst, _RC)
      src_spec => src%get_component_spec()
      var = make_var(ESMF_STATEINTENT_IMPORT, 'I2', units='m')
      var%typekind = ESMF_TYPEKIND_R4
      call src_spec%add_var_spec(var)
      conn = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt( &
           state_intent='export', short_name='expr')), &
           ConnectionPt('<self>', VirtualConnectionPt( &
           state_intent='import', short_name='I2')))
      call src_spec%add_connection(conn)
      call gb%advertise(src, _RC)

      call gb%resolve_connections(parent, &
           unsupported_characteristics=unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, unsupported%size())
      call gb%resolve_connections(src, &
           unsupported_characteristics=unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, unsupported%size())

      pg => parent%get_component_graph()
      dg => dst%get_component_graph()
      sg => src%get_component_graph()
      @assertEqual(1, expression_evaluation_count(pg))
      @assertEqual(0, expression_evaluation_count(sg))
      i1 => dg%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'I1'))
      i2 => sg%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'I2'))
      result1 = sole_predecessor_of(pg, i1)
      result2 = sole_predecessor_of(sg, i2)
      @assertTrue(result1%is_valid())
      @assertTrue(result1 == result2)
      _UNUSED_DUMMY(this)
   end subroutine test_expression_reused_across_declaring_components

   @test(npes=[0])
   subroutine test_expression_precision_precedes_result_units(this)
      class(MpiTestMethod), intent(inout) :: this
      type(OuterMetaComponent), pointer :: parent, src, dst
      type(ComponentGraph), pointer :: pg, sg, dg
      type(NodeId), pointer :: import_id
      type(NodeId) :: units_result, units_transform, result_id
      type(StateItemDescriptor), pointer :: descriptor
      class(StateItemCharacteristic), allocatable :: value
      type(GraphResolutionEntryVector) :: unsupported
      integer :: status
      type(GraphBuilder) :: gb

      call make_expression_fixture('expr_precision_units', ['I'], ['cm'], &
           [ESMF_TYPEKIND_R8], parent, src, dst, _RC)
      call gb%resolve_connections(parent, &
           unsupported_characteristics=unsupported, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, unsupported%size())
      pg => parent%get_component_graph()
      sg => src%get_component_graph()
      dg => dst%get_component_graph()
      @assertEqual(1, expression_evaluation_count(pg))
      if (expression_evaluation_count(pg) /= 1) return
      import_id => dg%get_resource_index( &
           item_key(ESMF_STATEINTENT_IMPORT, 'I'))
      units_result = sole_predecessor_of(pg, import_id)
      units_transform = sole_predecessor_of(pg, units_result)
      result_id = sole_predecessor_of(pg, units_transform)
      @assertTrue(result_id%is_valid())
      if (.not. result_id%is_valid()) return
      descriptor => node_descriptor(pg, units_result)
      @assertTrue(associated(descriptor))
      if (.not. associated(descriptor)) return
      call descriptor%get_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           value, rc=status)
      @assertEqual(0, status)
      @assertEqual('units=cm', value%get_signature())
      deallocate(value)
      call descriptor%get_characteristic(TYPE_KIND_CHARACTERISTIC_KIND, &
           value, rc=status)
      @assertEqual(0, status)
      @assertEqual('typekind=R8', value%get_signature())
      deallocate(value)
      descriptor => node_descriptor(pg, result_id)
      @assertTrue(associated(descriptor))
      if (.not. associated(descriptor)) return
      call descriptor%get_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           value, rc=status)
      @assertEqual(0, status)
      @assertEqual('units=m', value%get_signature())
      call assert_expression_input(pg, sg, result_id, 'A', 'R8', .true.)
      call assert_expression_input(pg, sg, result_id, 'B', 'R8', .true.)
      _UNUSED_DUMMY(this)
   end subroutine test_expression_precision_precedes_result_units

