#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! Phase 17-5a (docs/graph/spec/20-implementation-roadmap.md sec
! 20.4.17, 17-5): split out of Test_GraphBuilder.pf - holds the
! ConnectionResolution-exclusive buckets identified by 17-2/17-3's
! characterization (buckets 2, 3, 4, 5, 7, 10, 12, 15, 17, 21, 22):
! ordinary (MatchConnection) resolution match/unresolved, inout
! borrowing, the activate-time unsatisfied-import check,
! SimpleConnection resolution, materialize-extensions gating,
! composite connection wiring, vertical-grid composite overlap
! resolution, the non-callback-destination negative control, the
! callback-collection full-pipeline test (exercises ConnectionResolution's
! own resolve_callback_destination, despite its "callback" name - see
! bucket 17's own 17-3 note), multi-level qualified-component
! connection resolution, and node-identity-based resolution with no
! live VariableSpec reference.
!
! Every test here goes through GraphBuilder%resolve_connections (or,
! for bucket 4, %check_unsatisfied_imports) exercising the
! ConnectionResolution submodule, directly or (bucket 17/21) via one
! specific call site into a shared helper - see the roadmap's own
! 17-3 table for the full per-bucket submodule attribution.
!
! Carries along two bucket-local fixture helpers (single_predecessor
! for bucket 7, resolve_vertical_grid_membership_mismatch for bucket
! 12) and bucket 7's own callback-wiring fixture helpers needed by
! bucket 17 (make_passive_tracer_interface, make_tracer_callback_export,
! build_tracer_hierarchy - NOT make_exchanger_interface, which is
! needed only by bucket 18's test_callback_method_binding_builds_get_put_networks,
! staying in Test_GraphBuilder.pf).
!
! Also carries the reset_materialize_extensions_gate/
! restore_materialize_extensions_gate @before/@after pair (bucket 23):
! required because bucket 7 (materialize-extensions gating) moved
! here, and pFUnit's @before/@after typing is NOT disambiguated per
! test (see Test_GraphBuilder.pf's own module header for the full
! explanation, including the exact NAG compile error that confirmed
! this) - every @test below is MpiTestMethod-typed to match.
!
! Test-only OuterMetaComponent instances are built the same way
! Test_GraphBuilder.pf's own fixtures are (bypassing SetServices/DSO
! machinery) - see GraphBuilderTestSupport_mod.
module Test_GraphBuilder_ConnectionResolution
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetwork_mod, only: DependencyNetwork
   use mapl_DependencyNetworkId_mod, only: DependencyNetworkId, operator(==)
   use mapl_DependencyNetworkIdSet_mod, only: DependencyNetworkIdSet, DependencyNetworkIdSetIterator, operator(/=)
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_ChildSpec_mod, only: ChildSpec
   use mapl_ComponentSpec_mod, only: ComponentSpec
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_VariableSpecVector_mod, only: VariableSpecVector
   use mapl_ConnectionPt_mod, only: ConnectionPt
   use mapl_VirtualConnectionPt_mod, only: VirtualConnectionPt
   use mapl_MatchConnection_mod, only: MatchConnection
   use mapl_SimpleConnection_mod, only: SimpleConnection
   use mapl_NodeId_mod, only: NodeId, operator(==)
   use mapl_NodeIdSet_mod, only: NodeIdSet, NodeIdSetIterator, operator(/=)
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_TransformGraphNode_mod, only: TransformGraphNode
   use mapl_StateItemDescriptor_mod, only: StateItemDescriptor
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristic
   use mapl_StateItemCharacteristicKind_mod, only: &
        GEOMETRY_CHARACTERISTIC_KIND, QUANTITY_TYPE_CHARACTERISTIC_KIND, &
        TYPE_KIND_CHARACTERISTIC_KIND, PHYSICAL_UNITS_CHARACTERISTIC_KIND
   use mapl_GeometryCharacteristic_mod, only: GeometryCharacteristic
   use mapl_QuantityTypeCharacteristic_mod, only: QuantityTypeCharacteristic
   use mapl_TypeKindCharacteristic_mod, only: TypeKindCharacteristic
   use mapl_PhysicalUnitsCharacteristic_mod, only: PhysicalUnitsCharacteristic
   use mapl_VerticalStaggerCharacteristic_mod, only: &
        VerticalStaggerCharacteristic
   use mapl_UngriddedDimsCharacteristic_mod, only: UngriddedDimsCharacteristic
   use mapl_StateItemCharacteristicKind_mod, only: &
        VERTICAL_STAGGER_CHARACTERISTIC_KIND, EXPRESSION_CHARACTERISTIC_KIND
   use mapl_CharacteristicStatus_mod, only: &
        CHARACTERISTIC_STATUS_DEFERRED, CHARACTERISTIC_STATUS_MIRRORED
   use mapl_VerticalStaggerLoc_mod, only: VERTICAL_STAGGER_EDGE
   use mapl_VerticalStaggerLoc_mod, only: VERTICAL_STAGGER_INVALID
   use mapl_QuantityType_mod, only: QuantityType, MixingRatioBasis, &
        QUANTITY_MIXING_RATIO, BASIS_WET_MASS, BASIS_DRY_MASS
   use mapl_GraphStateItem_mod, only: GraphStateItem
   use ESMF, only: ESMF_STATEITEM_NOTFOUND
   use mapl_StateItemMemberMap_mod, only: StateItemMemberMap
   use mapl_ExtensionResolution_mod, only: set_materialize_extensions
   use mapl_StateItem_mod, only: MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_STATE, MAPL_STATEITEM_FIELDBUNDLE
   use mapl_StateItem_mod, only: MAPL_STATEITEM_BRACKET
   ! -- openspec/changes/callback-wiring -----------------------------------
   use mapl_CallbackInterfaceId_mod, only: CallbackInterfaceId
   use mapl_CallbackInterface_mod, only: CallbackInterface
   use mapl_CallbackInterfaceRegistry_mod, only: register_callback_interface
   use mapl_AccessSpec_mod, only: MAPL_ACCESS_IN, MAPL_ACCESS_OUT
   use mapl_StateItemFlag_mod, only: MAPL_VARIANT_FIELDBUNDLE => MAPL_STATEITEM_FIELDBUNDLE
   ! -- openspec/changes/vertical-grid-graph-state-item ---------------------
   use mapl_StateItemFlag_mod, only: MAPL_STATEITEM_VERTICALGRID
   use mapl_vertical_grid_api, only: mapl_BasicVerticalGrid
   use mapl_GraphResolutionEntry_mod, only: GraphResolutionEntry
   use mapl_GraphResolutionEntryVector_mod, only: GraphResolutionEntryVector
   use mapl_PortIdNodeIdMap_mod, only: PortIdNodeIdMap, PortIdNodeIdMapIterator, operator(/=)
   use GraphBuilderTestSupport_mod, only: make_outer_meta, make_var
   use mapl_VerticalStaggerLoc_mod, only: VERTICAL_STAGGER_NONE, VERTICAL_STAGGER_CENTER
   use mapl_HorizontalDimsSpec_mod, only: HORIZONTAL_DIMS_NONE
   use mapl_UngriddedDims_mod, only: UngriddedDims
   ! -- openspec/changes/phase-7b-expression-dispatch-wiring ---------------
   use mapl_StateItem_mod, only: MAPL_STATEITEM_EXPRESSION, MAPL_STATEITEM_WILDCARD
   ! -- openspec/changes/phase-7c-wildcard-dispatch-wiring -----------------
   use mapl_StateItem_mod, only: MAPL_STATEITEM_SERVICE
   use mapl_FieldDictionaryConfig_mod, only: FieldDictionaryConfig, set_field_dictionary_config, &
        get_field_dictionary_config
   use gFTL2_StringVector, only: StringVector
   use esmf
   use pfunit
   implicit none(type, external)

   type(FieldDictionaryConfig), save :: saved_fd_config

contains

   subroutine make_expression_fixture(parent_name, import_names, &
        import_units, import_typekinds, parent_meta, src_meta, dst_meta, rc, &
        input_typekind, b_typekind, import_ungridded, expression_units, &
        expression_text)
      character(*), intent(in) :: parent_name
      character(*), intent(in) :: import_names(:), import_units(:)
      type(ESMF_TypeKind_Flag), intent(in) :: import_typekinds(:)
      type(OuterMetaComponent), pointer, intent(out) :: parent_meta
      type(OuterMetaComponent), pointer, intent(out) :: src_meta, dst_meta
      integer, optional, intent(out) :: rc
      type(ESMF_TypeKind_Flag), optional, intent(in) :: input_typekind
      type(ESMF_TypeKind_Flag), optional, intent(in) :: b_typekind
      logical, optional, intent(in) :: import_ungridded
      character(*), optional, intent(in) :: expression_units
      character(*), optional, intent(in) :: expression_text

      type(ESMF_GridComp) :: parent_gc, src_gc, dst_gc
      type(GriddedComponentDriver) :: driver
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(VariableSpec) :: var
      type(SimpleConnection) :: conn
      type(GraphBuilder) :: gb
      integer :: i, status

      call make_outer_meta(parent_name, parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('src', child_spec, _RC)
      call parent_meta%add_child('dst', child_spec, _RC)
      driver = parent_meta%get_child('src', _RC)
      src_gc = driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      driver = parent_meta%get_child('dst', _RC)
      dst_gc = driver%get_gridcomp()
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      var = make_var(ESMF_STATEINTENT_EXPORT, 'A', units='m')
      if (present(input_typekind)) var%typekind = input_typekind
      call src_spec%add_var_spec(var)
      var = make_var(ESMF_STATEINTENT_EXPORT, 'B', units='m')
      if (present(b_typekind)) var%typekind = b_typekind
      call src_spec%add_var_spec(var)
      var = make_var(ESMF_STATEINTENT_EXPORT, 'expr')
      if (present(expression_units)) then
         var%units = expression_units
      else
         var%units = 'm'
      end if
      var%itemType = MAPL_STATEITEM_EXPRESSION
      var%expression = 'A + B'
      if (present(expression_text)) var%expression = expression_text
      call src_spec%add_var_spec(var)

      dst_spec => dst_meta%get_component_spec()
      parent_spec => parent_meta%get_component_spec()
      do i = 1, size(import_names)
         var = make_var(ESMF_STATEINTENT_IMPORT, import_names(i), &
              units=import_units(i))
         var%typekind = import_typekinds(i)
         if (present(import_ungridded)) then
            if (import_ungridded) &
                 var%ungridded_dims = UngriddedDims([5])
         end if
         call dst_spec%add_var_spec(var)
         conn = SimpleConnection( &
              ConnectionPt('src', VirtualConnectionPt( &
              state_intent='export', short_name='expr')), &
              ConnectionPt('dst', VirtualConnectionPt( &
              state_intent='import', short_name=import_names(i))))
         call parent_spec%add_connection(conn)
      end do

      call gb%advertise(src_meta, _RC)
      call gb%advertise(dst_meta, _RC)
      _RETURN(_SUCCESS)
   end subroutine make_expression_fixture

   integer function expression_evaluation_count(graph) result(count)
      type(ComponentGraph), pointer, intent(in) :: graph
      type(NodeIdSet), target :: ids
      type(NodeIdSetIterator) :: iter
      class(GraphNode), pointer :: node

      count = 0
      ids = graph%get_node_ids()
      iter = ids%ftn_begin()
      do while (iter /= ids%ftn_end())
         call iter%next()
         node => graph%get_node(iter%of())
         select type (node)
         class is (TransformGraphNode)
            if (node%is_input_port('A') .and. &
                 node%is_input_port('B') .and. &
                 node%is_output_port('destination_field')) count = count + 1
         end select
      end do
   end function expression_evaluation_count

   function sole_predecessor_of(graph, id) result(pred)
      type(NodeId) :: pred
      type(ComponentGraph), pointer, intent(in) :: graph
      type(NodeId), intent(in) :: id
      type(DependencyNetwork), pointer :: net
      type(NodeIdSet), target :: preds
      type(NodeIdSetIterator) :: iter

      net => graph%get_network(graph%get_forward_network_id())
      preds = net%get_predecessors(id)
      if (preds%size() /= 1) return
      iter = preds%ftn_begin()
      call iter%next()
      pred = iter%of()
   end function sole_predecessor_of

   function node_descriptor(graph, id) result(descriptor)
      type(StateItemDescriptor), pointer :: descriptor
      type(ComponentGraph), pointer, intent(in) :: graph
      type(NodeId), intent(in) :: id
      class(GraphNode), pointer :: node

      descriptor => null()
      node => graph%get_node(id)
      select type (node)
      class is (StateItemNode)
         descriptor => node%get_descriptor()
      end select
   end function node_descriptor

   subroutine set_expression_characteristic(meta, intent, name, value)
      type(OuterMetaComponent), pointer, intent(in) :: meta
      type(ESMF_StateIntent_Flag), intent(in) :: intent
      character(*), intent(in) :: name
      class(StateItemCharacteristic), intent(in) :: value
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: id
      type(StateItemDescriptor), pointer :: descriptor
      integer :: status

      graph => meta%get_component_graph()
      id => graph%get_resource_index(item_key(intent, name))
      descriptor => node_descriptor(graph, id)
      call descriptor%set_characteristic(value%get_kind(), value, rc=status)
      @assertEqual(0, status)
   end subroutine set_expression_characteristic

   subroutine assert_expression_input(graph, source_graph, result_id, &
        name, typekind, converted, expected_units)
      type(ComponentGraph), pointer, intent(in) :: graph, source_graph
      type(NodeId), intent(in) :: result_id
      character(*), intent(in) :: name, typekind
      logical, intent(in) :: converted
      character(*), optional, intent(in) :: expected_units
      type(NodeId) :: transform_id, previous, converter
      type(NodeId), pointer :: bound, source
      type(StateItemDescriptor), pointer :: descriptor
      class(StateItemCharacteristic), allocatable :: value
      class(GraphNode), pointer :: node
      integer :: status

      transform_id = sole_predecessor_of(graph, result_id)
      @assertTrue(transform_id%is_valid())
      if (.not. transform_id%is_valid()) return
      bound => graph%get_port_binding(graph%get_forward_network_id(), &
           transform_id, name)
      @assertTrue(associated(bound))
      if (.not. associated(bound)) return
      source => source_graph%get_resource_index( &
           item_key(ESMF_STATEINTENT_EXPORT, name))
      previous = bound
      if (converted) then
         @assertTrue(graph%owns_node(bound))
         converter = sole_predecessor_of(graph, bound)
         @assertTrue(converter%is_valid())
         if (.not. converter%is_valid()) return
         @assertTrue(graph%owns_node(converter))
         node => graph%get_node(converter)
         select type (node)
         class is (TransformGraphNode)
            @assertTrue(node%is_input_port('source_field'))
            @assertTrue(node%is_output_port('destination_field'))
         class default
            @assertTrue(.false., 'input converter is not a transform')
            return
         end select
         previous = sole_predecessor_of(graph, converter)
      end if
      @assertTrue(previous == source)
      descriptor => node_descriptor(graph, bound)
      @assertTrue(associated(descriptor))
      if (.not. associated(descriptor)) return
      call descriptor%get_characteristic(TYPE_KIND_CHARACTERISTIC_KIND, &
           value, rc=status)
      @assertEqual(0, status)
      @assertEqual('typekind=' // typekind, value%get_signature())
      deallocate(value)
      call descriptor%get_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, &
           value, rc=status)
      @assertEqual(0, status)
      if (present(expected_units)) then
         @assertEqual('units=' // expected_units, value%get_signature())
      else
         @assertEqual('units=m', value%get_signature())
      end if
   end subroutine assert_expression_input

   @before
   subroutine reset_materialize_extensions_gate(this)
      class(MpiTestMethod), intent(inout) :: this

      call set_materialize_extensions(.false.)
      saved_fd_config = get_field_dictionary_config()
      _UNUSED_DUMMY(this)
   end subroutine reset_materialize_extensions_gate

   @after
   subroutine restore_materialize_extensions_gate(this)
      class(MpiTestMethod), intent(inout) :: this

      call set_materialize_extensions(.false.)
      call set_field_dictionary_config(saved_fd_config)
      _UNUSED_DUMMY(this)
   end subroutine restore_materialize_extensions_gate

   subroutine use_validation(content)
      character(*), intent(in) :: content
      type(ESMF_HConfig) :: node

      node = ESMF_HConfigCreate(content=content)
      call set_field_dictionary_config(FieldDictionaryConfig(node))
      call ESMF_HConfigDestroy(node)
   end subroutine use_validation

   ! Parent with children child_src (exporting export_var_spec) and child_dst
   ! (importing import_var_spec), both advertised, and an all-names
   ! MatchConnection between them on the parent.
   subroutine make_pair_fixture(parent_name, export_var_spec, import_var_spec, parent_meta, src_meta, dst_meta, rc)
      character(*), intent(in) :: parent_name
      type(VariableSpec), intent(in) :: export_var_spec, import_var_spec
      type(OuterMetaComponent), pointer, intent(out) :: parent_meta, src_meta, dst_meta
      integer, optional, intent(out) :: rc

      integer :: status
      type(ESMF_GridComp) :: parent_gc, src_gc, dst_gc
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphBuilder) :: gb

      call make_outer_meta(parent_name, parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_var_spec)

      call gb%advertise(src_meta, _RC)
      call gb%advertise(dst_meta, _RC)

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      _RETURN(_SUCCESS)
   end subroutine make_pair_fixture

   ! True when the forward network has an edge from child_src's
   ! export `name` to child_dst's import `name`.
   logical function pair_is_wired(parent_meta, src_meta, dst_meta, name) result(wired)
      type(OuterMetaComponent), pointer, intent(in) :: parent_meta, src_meta, dst_meta
      character(*), intent(in) :: name

      type(ComponentGraph), pointer :: parent_graph, src_graph, dst_graph
      type(NodeId), pointer :: export_id, import_id
      type(DependencyNetwork), pointer :: net

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, name))
      import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, name))
      net => parent_graph%get_network(parent_graph%get_forward_network_id())
      wired = net%contains_dependency(export_id, import_id)
   end function pair_is_wired

   subroutine set_quantity_basis(meta, state_intent, name, quantity_type, &
        basis, rc)
      type(OuterMetaComponent), pointer, intent(inout) :: meta
      type(ESMF_StateIntent_Flag), intent(in) :: state_intent
      character(*), intent(in) :: name
      type(QuantityType), intent(in) :: quantity_type
      type(MixingRatioBasis), intent(in) :: basis
      integer, optional, intent(out) :: rc

      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: node_id
      class(GraphNode), pointer :: node
      type(StateItemDescriptor), pointer :: descriptor
      integer :: status

      graph => meta%get_component_graph()
      node_id => graph%get_resource_index(item_key(state_intent, name))
      node => graph%get_node(node_id)
      select type (node)
      class is (StateItemNode)
         descriptor => node%get_descriptor()
         call descriptor%set_characteristic( &
              QUANTITY_TYPE_CHARACTERISTIC_KIND, &
              QuantityTypeCharacteristic(quantity_type, basis), _RC)
      end select

      _RETURN(_SUCCESS)
   end subroutine set_quantity_basis

   ! Task 6.2 / spec "Matching export and import are wired" + "Import
   ! with no matching export is left unresolved" + task 4.2 "Child's
   ! published port gets a parent-local proxy": a parent declares a
   ! connect_all-style MatchConnection between two children; the parent
   ! ends up with proxy nodes (not the children's own NodeIds) wired in
   ! the hierarchy's forward network, and the one import with no matching export
   ! is reported, not silently dropped.
   @test(npes=[0])
   subroutine test_ordinary_connection_wires_matching_and_reports_unresolved(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph, src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(GraphResolutionEntry), pointer :: entry
      type(NodeId), pointer :: t_export_id, t_import_id, q_import_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'Q')) ! no matching export

      ! Children advertise first - mirrors recursion order in
      ! OuterMetaComponent/initialize_advertise.F90 (children complete
      ! before the parent resolves its own connections).
      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      ! connect_all('child_src', 'child_dst')'s own "magic connect" shape
      ! (superstructure/generic/OuterMetaComponent/connect_all.F90).
      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))

      @assertEqual(1, unresolved%size())
      entry => unresolved%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('Q', entry%short_name)

      ! openspec/changes/hierarchy-wide-component-graph, tasks.md 3.1/3.4:
      ! no parent-local proxy exists anymore - the edge below connects
      ! each child's own real NodeId directly (graph/component-hierarchy
      ! "Cross-component dependency wiring uses real node identities
      ! directly").
      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      q_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'Q'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))
      @assert_that(associated(q_import_id), is(true()))

      ! Each child's own real NodeId is owned by that child's OWN graph,
      ! not the parent's - no proxy, no parent-side ownership record for
      ! either side (graph/component-hierarchy "No proxy node is created
      ! for a cross-component edge").
      @assert_that(src_graph%owns_node(t_export_id), is(true()))
      @assert_that(dst_graph%owns_node(t_import_id), is(true()))
      @assert_that(parent_graph%owns_node(t_export_id), is(false()))
      @assert_that(parent_graph%owns_node(t_import_id), is(false()))

      ! The edge itself lives in the hierarchy's forward network (declared
      ! by the parent), connecting the two children's
      ! own real NodeIds directly.
      net_id = parent_graph%get_forward_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(true()))
      @assert_that(net%has_predecessors(q_import_id), is(false()))
      @assert_that(net%has_successors(t_export_id), is(true()))
      @assert_that(net%has_predecessors(t_export_id), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_ordinary_connection_wires_matching_and_reports_unresolved

   ! openspec/changes/extension-reuse (roadmap sub-change 3c) - REQ-EXT-001/
   ! 002/003 end-to-end through GraphBuilder: a units mismatch between a
   ! matched export/import pair gets a real TransformGraphNode + extension
   ! StateItemNode interposed instead of a direct dependency edge, and the
   ! no-op case (elsewhere, a second, exactly-matching pair) still wires
   ! directly - both handled by the same resolve_connections() call.
   @test(npes=[0])
   subroutine test_ordinary_connection_units_mismatch_creates_chain(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_export_id, t_import_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_units', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='km'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))

      ! REQ-EXT scenario "Mismatched export and import are wired through
      ! an extension chain": not reported as unresolved, not reported as
      ! unsupported (units has a real registered provider).
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      ! openspec/changes/hierarchy-wide-component-graph, tasks.md 3.4:
      ! each child's own real NodeId, in its own graph - no parent-local
      ! proxy exists anymore.
      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      net_id = parent_graph%get_forward_network_id()
      net => parent_graph%get_network(net_id)

      ! Not a direct edge (spec "Mismatched export and import are wired
      ! through an extension chain") - a transform node is interposed.
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(false()))
      @assert_that(net%has_successors(t_export_id), is(true()))
      @assert_that(net%has_predecessors(t_import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_ordinary_connection_units_mismatch_creates_chain

   ! Two different declared standard names, permissive validation mode: the
   ! pair is wired directly (the export's name wins) and reported as a
   ! connection warning, not as unsupported or a conflict.
   @test(npes=[0])
   subroutine test_standard_name_mismatch_wires_with_warning_when_permissive(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GraphResolutionEntryVector) :: unresolved, unsupported, conflicts, warnings
      type(GraphResolutionEntry), pointer :: entry
      type(VariableSpec) :: export_var_spec, import_var_spec
      integer :: status
      type(GraphBuilder) :: gb

      call use_validation('{validation_mode: permissive}')
      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='K')
      export_var_spec%standard_name = 'air_temperature'
      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T', units='K')
      import_var_spec%standard_name = 'surface_temperature'
      call make_pair_fixture('comp_parent_standard_name_permissive', export_var_spec, import_var_spec, &
           parent_meta, src_meta, dst_meta, _RC)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, connection_conflicts=conflicts, &
           connection_warnings=warnings, rc=status)
      @assert_that(status, is(0))

      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())
      @assertEqual(0, conflicts%size())
      @assertEqual(1, warnings%size())
      entry => warnings%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('T', entry%short_name)
      @assertEqual('standard_name convention violation (permissive mode): Export declares standard_name "air_temperature" but connected Import declares "surface_temperature". Connecting anyway; the Export value wins.', entry%reason)

      @assert_that(pair_is_wired(parent_meta, src_meta, dst_meta, 'T'), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_standard_name_mismatch_wires_with_warning_when_permissive

   ! The same pair in strict validation mode can never connect: it is a
   ! connection conflict naming both names, and nothing is wired.
   @test(npes=[0])
   subroutine test_standard_name_mismatch_is_conflict_when_strict(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GraphResolutionEntryVector) :: unresolved, unsupported, conflicts, warnings
      type(GraphResolutionEntry), pointer :: entry
      type(VariableSpec) :: export_var_spec, import_var_spec
      integer :: status
      type(GraphBuilder) :: gb

      call use_validation('{validation_mode: strict}')
      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='K')
      export_var_spec%standard_name = 'air_temperature'
      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T', units='K')
      import_var_spec%standard_name = 'surface_temperature'
      call make_pair_fixture('comp_parent_standard_name_strict', export_var_spec, import_var_spec, &
           parent_meta, src_meta, dst_meta, _RC)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, connection_conflicts=conflicts, &
           connection_warnings=warnings, rc=status)
      @assert_that(status, is(0))

      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())
      @assertEqual(0, warnings%size())
      @assertEqual(1, conflicts%size())
      entry => conflicts%at(1, status)
      @assertEqual('child_dst', entry%component_name)
      @assertEqual('T', entry%short_name)
      @assertEqual('incompatible STANDARD_NAME: export standard_name=air_temperature, import standard_name=surface_temperature', entry%reason)

      @assert_that(pair_is_wired(parent_meta, src_meta, dst_meta, 'T'), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_standard_name_mismatch_is_conflict_when_strict

   ! A pair left unwired as UNSUPPORTED (a vertical-grid mismatch: no
   ! Transform yet) is recorded on the resolving component; the freeze check
   ! passes in permissive mode and fails in strict mode.
   @test(npes=[0])
   subroutine test_unsupported_pair_fails_freeze_check_only_when_strict(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GraphResolutionEntryVector) :: unsupported
      type(VariableSpec) :: export_var_spec, import_var_spec
      type(mapl_BasicVerticalGrid) :: export_vgrid, import_vgrid
      type(StringVector) :: pairs
      integer :: status
      type(GraphBuilder) :: gb

      call export_vgrid%set_id(1)
      call import_vgrid%set_id(2)
      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T')
      export_var_spec%vertical_grid = export_vgrid
      export_var_spec%vertical_stagger = VERTICAL_STAGGER_CENTER
      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T')
      import_var_spec%vertical_grid = import_vgrid
      import_var_spec%vertical_stagger = VERTICAL_STAGGER_CENTER
      call make_pair_fixture('comp_parent_unsupported_freeze', export_var_spec, import_var_spec, &
           parent_meta, src_meta, dst_meta, _RC)

      call gb%resolve_connections(parent_meta, unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(1, unsupported%size())

      pairs = parent_meta%get_unsupported_pairs()
      @assertEqual(1, pairs%size())
      @assertEqual('child_dst:T:VERTICAL_GRID', pairs%of(1))

      call use_validation('{validation_mode: permissive}')
      call gb%check_unsupported_pairs(parent_meta, rc=status)
      @assert_that(status, is(0))

      call use_validation('{validation_mode: strict}')
      call gb%check_unsupported_pairs(parent_meta, rc=status)
      @assertExceptionRaised('GraphBuilder: unsupported pairs remain at freeze (strict validation mode)')
      @assert_that(status == 0, is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_unsupported_pair_fails_freeze_check_only_when_strict

   @test(npes=[0])
   subroutine test_quantity_basis_only_pair_is_unsupported(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GraphResolutionEntryVector) :: unsupported, conflicts
