      call check_accept_transfer_missing_name_is_fatal( &
           '{validation_mode: permissive}', this)
   end subroutine test_accept_transfer_fails_for_missing_expression_name

   @test(npes=[0])
   subroutine test_accept_transfer_missing_name_is_fatal_in_strict_mode(this)
