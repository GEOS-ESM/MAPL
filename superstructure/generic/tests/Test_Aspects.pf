#include "MAPL_TestErr.h"

module Test_Aspects
   use funit
   use mapl_geom_api
   use mapl_StateItemAspect_mod
   use mapl_TypekindAspect_mod
   use mapl_UnitsAspect_mod
   use mapl_AttributesAspect_mod
   use mapl_UngriddedDimsAspect_mod
   use mapl_FieldClassAspect_mod
   use mapl_BracketClassAspect_mod
   use mapl_StandardNameAspect_mod
   use mapl_VectorClassAspect_mod
   use mapl_FieldDictionaryConfig_mod
   use mapl_ValidationMode_mod
   use mapl_enums_api, only: MAPL_VECTOR_BASIS_KIND_NS
   use mapl_AspectId_mod
   use mapl_GeomAspect_mod
   use mapl_UngriddedDims_mod
   use mapl_UngriddedDim_mod
   use mapl_UngriddedDimVector_mod
   use mapl_typekind_mod, only: MAPL_TYPEKIND_MIRROR
   use gftl2_StringVector
   use esmf
   implicit none

   type(ESMF_Geom) :: geom1, geom2

contains


   @before
   subroutine setup()
      type(ESMF_HConfig) :: hconfig
      type(mapl_MaplGeom) :: mapl_geom
      type(mapl_GeomManager), pointer :: geom_mgr
      integer :: status

      geom_mgr => mapl_get_geom_manager()

      hconfig = ESMF_HConfigCreate(content="{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC}", _RC)
      mapl_geom = geom_mgr%get_mapl_geom(hconfig, _RC)
      geom1 = mapl_geom%get_geom()
      call ESMF_HConfigDestroy(hconfig)

      hconfig = ESMF_HConfigCreate(content="{class: latlon, im_world: 12, jm_world: 13, pole: PC, dateline: DC}", _RC)
      mapl_geom = geom_mgr%get_mapl_geom(hconfig, _RC)
      geom2 = mapl_geom%get_geom()
      call ESMF_HConfigDestroy(hconfig)
   end subroutine setup


   @test
   subroutine test_can_connect_typekind()
      type(TypekindAspect) :: tk_r4, tk_r8, tk_mirror

      tk_r4 = TypeKindAspect(ESMF_TYPEKIND_R4)
      tk_r8 = TypeKindAspect(ESMF_TYPEKIND_R8)
      tk_mirror = TypeKindAspect()

      @assert_that(tk_r4%can_connect_to(tk_r4), is(true()))
      @assert_that(tk_r4%can_connect_to(tk_r8), is(true()))
      @assert_that(tk_r8%can_connect_to(tk_r4), is(true()))
      @assert_that(tk_r8%can_connect_to(tk_r8), is(true()))

      @assert_that(tk_mirror%can_connect_to(tk_r4), is(true()))
      @assert_that(tk_mirror%can_connect_to(tk_r8), is(true()))

      @assert_that(tk_mirror%can_connect_to(tk_mirror), is(false()))

   end subroutine test_can_connect_typekind


   @test
   ! Verify that framework detects when an export spec does not
   ! provide mandatory attributes specified by import spec.
   subroutine test_mismatched_attribute()
      type(AttributesAspect) :: export, import
      type(StringVector) :: export_attributes, import_attributes

      call import_attributes%push_back('A')
      call import_attributes%push_back('B')

      call export_attributes%push_back('A') ! missing 'B'


      export = AttributesAspect(export_attributes)
      import = AttributesAspect(import_attributes)

      @assert_that(export%can_connect_to(import), is(false()))

   end subroutine test_mismatched_attribute

   @test
   ! Verify that it is fine to have extra export attributes
   ! provide mandatory attributes specified by import spec.
   subroutine test_extra_attribute()
      type(AttributesAspect) :: export, import
      type(StringVector) :: export_attributes, import_attributes

      call import_attributes%push_back('A')
      call import_attributes%push_back('B')

      call export_attributes%push_back('A')
      call export_attributes%push_back('B')
      call export_attributes%push_back('C')


      export = AttributesAspect(export_attributes)
      import = AttributesAspect(import_attributes)

      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_extra_attribute

   @test
   subroutine test_mismatched_units()
      type(UnitsAspect) :: import
      type(UnitsAspect) :: export

      import = UnitsAspect('s') ! seconds
      export = UnitsAspect('m') ! meters

      @assert_that(export%can_connect_to(import), is(false()))

   end subroutine test_mismatched_units

   @test
   subroutine test_convertible_units()
      type(UnitsAspect) :: import
      type(UnitsAspect) :: export

      import = UnitsAspect('cm') ! centimeters
      export = UnitsAspect('m') ! meters

      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_convertible_units

   @test
   subroutine test_same_but_unknown_units()
      type(UnitsAspect) :: import
      type(UnitsAspect) :: export

      import = UnitsAspect('barn') ! centimeters
      export = UnitsAspect('barn') ! meters

      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_same_but_unknown_units

   @test
   subroutine test_mirror_units_1()
      type(UnitsAspect) :: import
      type(UnitsAspect) :: export

      import = UnitsAspect() ! mirror
      export = UnitsAspect('m') ! meters

      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_mirror_units_1

   @test
   subroutine test_mirror_units_2()
      type(UnitsAspect) :: import
      type(UnitsAspect) :: export

      import = UnitsAspect() ! mirror
      export = UnitsAspect('barn') ! unknown

      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_mirror_units_2

   @test
   subroutine test_double_unchecked_units_match()
      type(UnitsAspect) :: import
      type(UnitsAspect) :: export

       import = UnitsAspect() ! unchecked
       export = UnitsAspect() ! unchecked

       @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_double_unchecked_units_match

   @test
   subroutine test_connect_geoms()
      type(GeomAspect) :: import, export

      import = GeomAspect(geom2)
      export = GeomAspect(geom1)

      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_connect_geoms

   @test
   subroutine test_mirror_geom()
      type(GeomAspect) :: import, export

      import = GeomAspect()
      export = GeomAspect(geom1)

      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_mirror_geom

   @test
   subroutine test_double_mirror_geom_fail()
      type(GeomAspect) :: import, export

      import = GeomAspect()
      export = GeomAspect()

      @assert_that(export%can_connect_to(import), is(false()))

   end subroutine test_double_mirror_geom_fail

   @test
   subroutine test_matching_ungridded_dims()
      type(UngriddedDimsAspect) :: import, export
      type(UngriddedDims) :: ungridded_dims1, ungridded_dims2

      call ungridded_dims1%add_dim(UngriddedDim(2))
      call ungridded_dims1%add_dim(UngriddedDim(3))

      call ungridded_dims2%add_dim(UngriddedDim(2))
      call ungridded_dims2%add_dim(UngriddedDim(3))

      import = UngriddedDimsAspect(ungridded_dims1)
      export = UngriddedDimsAspect(ungridded_dims2)

      @assert_that(export%can_connect_to(import), is(true()))
   end subroutine test_matching_ungridded_dims

   @test
   subroutine test_mismatched_ungridded_dims_fail()
      type(UngriddedDimsAspect) :: import, export
      type(UngriddedDims) :: ungridded_dims1, ungridded_dims2

      call ungridded_dims1%add_dim(UngriddedDim(2))
      call ungridded_dims1%add_dim(UngriddedDim(3))

      call ungridded_dims2%add_dim(UngriddedDim(2))
      call ungridded_dims2%add_dim(UngriddedDim(1)) ! different

      import = UngriddedDimsAspect(ungridded_dims1)
      export = UngriddedDimsAspect(ungridded_dims2)

      @assert_that(export%can_connect_to(import), is(false()))

   end subroutine test_mismatched_ungridded_dims_fail

   @test
   subroutine test_mirror_ungridded_dims()
      type(UngriddedDimsAspect) :: import, export
      type(UngriddedDims) :: ungridded_dims

      import = UngriddedDimsAspect()
      export = UngriddedDimsAspect(ungridded_dims)

      @assert_that(export%can_connect_to(import), is(true()))
   end subroutine test_mirror_ungridded_dims


   @test
   subroutine test_can_connect_bracket_to_field()
      type(BracketClassAspect) :: export
      type(FieldClassAspect) :: import

      export = BracketClassAspect(2, 'Abc')
      import = FieldClassASpect('Efg')

      ! cannot connect to another bracket
      @assert_that(export%can_connect_to(export), is(false()))
      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_can_connect_bracket_to_field

   ! ---------------------------------------------------------------
   ! StandardNameAspect (generic/standard-name-enforcement,
   ! GEOS-ESM/MAPL#5413) - modeled on the UnitsAspect tests above.
   ! ---------------------------------------------------------------

   @test
   subroutine test_standardname_matching()
      type(StandardNameAspect) :: import, export

      import = StandardNameAspect('surface_temperature')
      export = StandardNameAspect('surface_temperature')

      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_standardname_matching

   @test
   ! Default ValidationMode is permissive: a disagreement is still allowed
   ! to connect (a warning is logged, not asserted here).
   subroutine test_standardname_mismatch_permissive()
      type(StandardNameAspect) :: import, export

      call set_field_dictionary_config(FieldDictionaryConfig()) ! explicit permissive

      import = StandardNameAspect('air_temperature')
      export = StandardNameAspect('surface_temperature')

      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_standardname_mismatch_permissive

   @test
   ! In strict mode, a standard_name disagreement is rejected outright.
   subroutine test_standardname_mismatch_strict()
      type(StandardNameAspect) :: import, export
      type(ESMF_HConfig) :: node

      node = ESMF_HConfigCreate(content='{validation_mode: strict}')
      call set_field_dictionary_config(FieldDictionaryConfig(node))

      import = StandardNameAspect('air_temperature')
      export = StandardNameAspect('surface_temperature')

      @assert_that(export%can_connect_to(import), is(false()))

      ! Reset to the default (permissive) so later tests in this process
      ! are unaffected by this test's global singleton mutation.
      call set_field_dictionary_config(FieldDictionaryConfig())

   end subroutine test_standardname_mismatch_strict

   @test
   ! An Import declaring no standard_name (unchecked/"wildcard") accepts any
   ! Export, in either ValidationMode.
   subroutine test_standardname_wildcard_import()
      type(StandardNameAspect) :: import, export
      type(ESMF_HConfig) :: node

      import = StandardNameAspect() ! unchecked/wildcard
      export = StandardNameAspect('surface_temperature')
      @assert_that(export%can_connect_to(import), is(true()))

      node = ESMF_HConfigCreate(content='{validation_mode: strict}')
      call set_field_dictionary_config(FieldDictionaryConfig(node))
      @assert_that(export%can_connect_to(import), is(true()))

      call set_field_dictionary_config(FieldDictionaryConfig())

   end subroutine test_standardname_wildcard_import

   @test
   ! An Export declaring no standard_name still connects to an Import that
   ! declares one (a warning is logged, not asserted here) - never a fatal
   ! error, independent of ValidationMode.
   subroutine test_standardname_export_unset()
      type(StandardNameAspect) :: import, export
      type(ESMF_HConfig) :: node

      import = StandardNameAspect('surface_temperature')
      export = StandardNameAspect() ! unchecked
      @assert_that(export%can_connect_to(import), is(true()))

      node = ESMF_HConfigCreate(content='{validation_mode: strict}')
      call set_field_dictionary_config(FieldDictionaryConfig(node))
      @assert_that(export%can_connect_to(import), is(true()))

      call set_field_dictionary_config(FieldDictionaryConfig())

   end subroutine test_standardname_export_unset

   @test
   ! Vector standard_name agreement is checked per-component (design.md
   ! Decision 6): component 1 agrees, component 2 disagrees - the whole
   ! Vector fails to match in strict mode.
   subroutine test_vector_standardname_partial_mismatch_strict()
      type(VectorClassAspect) :: import, export
      type(FieldClassAspect) :: components(2)
      type(ESMF_HConfig) :: node

      node = ESMF_HConfigCreate(content='{validation_mode: strict}')
      call set_field_dictionary_config(FieldDictionaryConfig(node))

      components = [FieldClassAspect(), FieldClassAspect()]
      export = VectorClassAspect(components, MAPL_VECTOR_BASIS_KIND_NS, &
           standard_name_1='eastward_wind', standard_name_2='northward_wind')
      import = VectorClassAspect(components, MAPL_VECTOR_BASIS_KIND_NS, &
           standard_name_1='eastward_wind', standard_name_2='DISAGREES')

      @assert_that(export%can_connect_to(import), is(false()))

      call set_field_dictionary_config(FieldDictionaryConfig())

   end subroutine test_vector_standardname_partial_mismatch_strict

   @test
   ! Same as above, but fully agreeing components connect cleanly.
   subroutine test_vector_standardname_full_match()
      type(VectorClassAspect) :: import, export
      type(FieldClassAspect) :: components(2)

      components = [FieldClassAspect(), FieldClassAspect()]
      export = VectorClassAspect(components, MAPL_VECTOR_BASIS_KIND_NS, &
           standard_name_1='eastward_wind', standard_name_2='northward_wind')
      import = VectorClassAspect(components, MAPL_VECTOR_BASIS_KIND_NS, &
           standard_name_1='eastward_wind', standard_name_2='northward_wind')

      @assert_that(export%can_connect_to(import), is(true()))

   end subroutine test_vector_standardname_full_match

end module Test_ASpects
