#include "MAPL_TestErr.h"

! All scenarios run under STRICT field-dictionary ValidationMode (see
! openspec change use-field-dictionary-in-scenario-tests). Built via the
! Initialize_strict() EXTRA_INITIALIZE hook (pfunit/MAPL_Initialize.F90).
! Every other pFUnit binary in this directory still uses plain Initialize()
! (default PERMISSIVE) and is unaffected.
module Test_Scenarios

   use mapl_Generic_mod
   use mapl_GenericPhases_mod
   use mapl_MultiState_mod
   use mapl_OuterMetaComponent_mod
   use mapl_GraphScenarioBootstrap_mod, only: build_scenario_tree
   use mapl_GraphMode_mod, only: set_graph_mode, GRAPH_MODE_REGISTRY, GRAPH_MODE_GRAPH, GRAPH_MODE_BOTH
   use mapl_ExtensionResolution_mod, only: set_materialize_extensions
   use mapl_GriddedComponentDriver_mod
   use mapl_FieldDictionaryConfig_mod, only: FieldDictionaryConfig, &
        set_field_dictionary_config, get_field_dictionary_config
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetwork_mod, only: DependencyNetwork
   use mapl_NodeIdSet_mod, only: NodeIdSet, NodeIdSetIterator
   use mapl_NodeId_mod, only: NodeId, operator(==)
   use mapl_GraphBuilder_mod, only: item_key
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_TransformGraphNode_mod, only: TransformGraphNode
   use mapl_PortSpecMap_mod, only: PortSpecMap
   use mapl_GraphStateItem_mod, only: GraphStateItem
   use mapl_FieldGet_mod, only: FieldGet
   use mapl_Generic_api, only: mapl_GridCompCreate, &
                               mapl_GenericSetServices !, &
                               !mapl_GridCompSetEntryPoint, &
                               !mapl_GridCompGeta, &
                               !mapl_GridcompGetResource
   use mapl_ESMF_Utilities_mod
   use mapl_geom_api, only: mapl_GeomGet
   use mapl_field_api, only: MAPL_FieldGet
   use mapl_field_bundle_api, only: MAPL_FieldBundleGet
   use esmf
   use nuopc
   ! testing framework
   use ESMF_TestCase_mod
   use ESMF_TestParameter_mod
   use funit

   implicit none

   abstract interface
      subroutine I_check_stateitem(expectations, state, short_name, description, rc)
         import ESMF_HConfig, ESMF_State
         type(ESMF_HConfig), intent(in) :: expectations
         type(ESMF_State), intent(inout) :: state
         character(*), intent(in) :: short_name
         character(*), intent(in) :: description
         integer, intent(out) :: rc
      end subroutine I_check_stateitem
   end interface

   ! One row per scenario directory.  graph_ready is the gate for running
   ! the scenario under GRAPH_MODE_GRAPH / GRAPH_MODE_BOTH in the ESSENTIAL
   ! suite; see docs/graph/scenario-parity.md.
   type :: ScenarioEntry
      character(:), allocatable :: name
      character(:), allocatable :: root
      logical :: graph_ready
      ! permissive: run with a PERMISSIVE field dictionary (the fixture
      ! deliberately mismatches standard names, which STRICT rejects in the
      ! legacy path before the graph sees it).
      logical :: permissive = .false.
      ! Exception text the graph path raises during initialization. Such a
      ! scenario runs in graph and both modes only.
      character(:), allocatable :: expected_exception
      ! Legacy import couplers can block graph-only capabilities.
      logical :: graph_only = .false.
   end type ScenarioEntry

   @testParameter
   type, extends(ESMF_TestParameter) :: ScenarioDescription
      character(:), allocatable :: name
      character(:), allocatable :: root
      character(:), allocatable :: graph_mode
      character(:), allocatable :: check_name
      logical :: permissive = .false.
      character(:), allocatable :: expected_exception
      procedure(I_check_stateitem), nopass, pointer :: check_stateitem
   contains
      procedure :: tostring => tostring_description
   end type ScenarioDescription

   @testCase(constructor=Scenario, testParameters={get_parameters()})
   type, extends(ESMF_TestCase) :: Scenario
      character(:), allocatable :: scenario_name
      character(:), allocatable :: scenario_root
      character(:), allocatable :: graph_mode
      character(:), allocatable :: check_name
      logical :: permissive = .false.
      character(:), allocatable :: expected_exception
      type(FieldDictionaryConfig) :: saved_fd_config
      procedure(I_check_stateitem), nopass, pointer :: check_stateitem

      type(ESMF_HConfig), allocatable :: expectations
      type(ESMF_GridComp) :: outer_gc
      type(MultiState) :: outer_states
      type(ESMF_Grid) :: grid
   contains
      procedure :: setup
      procedure :: tearDown
   end type Scenario

   interface Scenario
      procedure :: new_Scenario
   end interface Scenario

   interface ScenarioDescription
      procedure :: new_ScenarioDescription
   end interface ScenarioDescription

contains

   function new_Scenario(desc) result(s)
      type(ScenarioDescription), intent(in) :: desc
      type(Scenario) :: s
      s%scenario_name = desc%name
      s%scenario_root = desc%root
      s%graph_mode = desc%graph_mode
      s%check_name = desc%check_name
      s%permissive = desc%permissive
      if (allocated(desc%expected_exception)) s%expected_exception = desc%expected_exception
      s%check_stateitem => desc%check_stateitem
   end function new_Scenario

   function new_ScenarioDescription(name, root, graph_mode, check_name, check_stateitem, &
        permissive, expected_exception) result(s)
      type(ScenarioDescription) :: s
      character(*), intent(in) :: name
      character(*), intent(in) :: root
      character(*), intent(in) :: graph_mode
      character(*), intent(in) :: check_name
      procedure(I_check_stateitem) :: check_stateitem
      logical, optional, intent(in) :: permissive
      character(*), optional, intent(in) :: expected_exception
      s%name = name
      s%root = root
      s%graph_mode = graph_mode
      s%check_name = check_name
      s%check_stateitem => check_stateitem
      if (present(permissive)) s%permissive = permissive
      if (present(expected_exception)) s%expected_exception = expected_exception

      call s%setNumPETsRequested(1)
   end function new_ScenarioDescription

   function scenario_table() result(table)
      type(ScenarioEntry), allocatable :: table(:)

      table = [ &
           ScenarioEntry('scenario_1',              'parent.yaml',      .true.), &
           ScenarioEntry('scenario_2',              'parent.yaml',      .true.), &
           ScenarioEntry('scenario_reexport_twice', 'grandparent.yaml', .true.), &
           ScenarioEntry('propagate_geom',          'parent.yaml',      .false.), &
           ScenarioEntry('vertical_regridding_2',   'parent.yaml',      .false.), &
           ScenarioEntry('vertical_regridding_3',   'AGCM.yaml',        .false.), &
           ScenarioEntry('statistics',              'cap.yaml',         .false.), &
           ScenarioEntry('statistics_real',         'cap.yaml',         .false.), &
           ScenarioEntry('scenario_0',              'parent.yaml',      .true.), &
           ScenarioEntry('precision_extension',     'parent.yaml',      .true.), &
           ScenarioEntry('precision_extension_3d',  'parent.yaml',      .true.), &
           ScenarioEntry('3d_specs',                'parent.yaml',      .true.), &
           ScenarioEntry('ungridded_dims',          'parent.yaml',      .true.), &
           ScenarioEntry('service_service',         'parent.yaml',      .false.), &
           ScenarioEntry('service_with_options',    'parent.yaml',      .false.), &
           ScenarioEntry('export_dependency',       'parent.yaml',      .true.), &
           ScenarioEntry('regrid',                  'cap.yaml',         .false.), &
           ScenarioEntry('regrid_r8',               'cap.yaml',         .false.), &
           ScenarioEntry('vector_1',                'parent.yaml',      .false.), &
           ScenarioEntry('vertical_regridding',     'parent.yaml',      .false.), &
           ScenarioEntry('vertical_alignment_same_grid', 'parent.yaml', .true.), &
           ScenarioEntry('vertical_alignment_regrid',    'parent.yaml', .false.), &
           ScenarioEntry('vertical_alignment_with_grid', 'parent.yaml', .false.), &
           ScenarioEntry('expression_match',        'parent.yaml',      .true.), &
           ScenarioEntry('expression_defer_geom',   'parent.yaml',      .false.), &
           ScenarioEntry('invalidate',              'cap.yaml',         .true.), &
           ScenarioEntry('history_1',               'cap.yaml',         .false.), &
           ScenarioEntry('history_wildcard',        'cap.yaml',         .true.), &
           ScenarioEntry('extdata_1',               'cap.yaml',         .true.), &
           ScenarioEntry('names_1',                 'parent.yaml',      .true.), &
           ScenarioEntry('expression',              'parent.yaml',      .true.), &
           ScenarioEntry('expression_per_consumer', 'parent.yaml',      .true.), &
           ScenarioEntry('expression_per_consumer_r8', 'parent.yaml', &
                .false., graph_only=.true.), &
           ScenarioEntry('../graph-scenarios/plain_field',                  'cap.yaml', .true.), &
           ScenarioEntry('../graph-scenarios/vertical_field',               'cap.yaml', .true.), &
           ScenarioEntry('../graph-scenarios/ungridded_dims',               'cap.yaml', .true.), &
           ScenarioEntry('../graph-scenarios/dims_z_field',                 'cap.yaml', .true.), &
           ScenarioEntry('../graph-scenarios/units_mismatch_run_phase',     'cap.yaml', .true.), &
           ScenarioEntry('../graph-scenarios/units_and_typekind_mismatch',  'cap.yaml', .true.), &
           ScenarioEntry('../graph-scenarios/graphbuilder_propagation',     'cap.yaml', .true.), &
           ScenarioEntry('../graph-scenarios/standard_name_and_ungridded_dims_mismatch', 'cap.yaml', .true., &
                permissive=.true.) &
           ]
   end function scenario_table

   function env_is_set(name) result(is_set)
      character(*), intent(in) :: name
      logical :: is_set
      integer :: length, status

      call get_environment_variable(name, length=length, status=status)
      is_set = (status == 0 .and. length > 0)
   end function env_is_set

   function env_value(name) result(value)
      character(*), intent(in) :: name
      character(:), allocatable :: value
      integer :: length, status

      call get_environment_variable(name, length=length, status=status)
      if (status /= 0) length = 0
      allocate(character(length) :: value)
      if (length > 0) call get_environment_variable(name, value=value, status=status)
   end function env_value

   function modes_for(entry, pending_only) result(modes)
      character(:), allocatable :: modes(:)
      type(ScenarioEntry), intent(in) :: entry
      logical, intent(in) :: pending_only

      if (pending_only) then
         if (entry%graph_ready) then
            allocate(character(len=8) :: modes(0))
         else if (entry%graph_only) then
            modes = [character(len=8) :: GRAPH_MODE_GRAPH]
         else
            modes = [character(len=8) :: GRAPH_MODE_GRAPH, GRAPH_MODE_BOTH]
         end if
      else
         if (entry%graph_only) then
            if (entry%graph_ready) then
               modes = [character(len=8) :: GRAPH_MODE_GRAPH]
            else
               allocate(character(len=8) :: modes(0))
            end if
         else if (entry%graph_ready .and. &
              allocated(entry%expected_exception)) then
            modes = [character(len=8) :: GRAPH_MODE_GRAPH, GRAPH_MODE_BOTH]
         else if (entry%graph_ready) then
            modes = [character(len=8) :: GRAPH_MODE_REGISTRY, GRAPH_MODE_GRAPH, GRAPH_MODE_BOTH]
         else
            modes = [character(len=8) :: GRAPH_MODE_REGISTRY]
         end if
      end if
   end function modes_for

   ! Environment switches (both optional):
   !   MAPL_SCENARIO_PENDING  set: run only the not-yet-graph_ready scenarios,
   !                          under graph and both modes (non-ESSENTIAL target).
   !   MAPL_SCENARIO_ONLY     scenario name: restrict to that scenario.
   !   MAPL_SCENARIO_SHARD    "k/N" (0 <= k < N): keep every N-th parameter,
   !                          starting at k, of the list left after the
   !                          filters above. Each ctest shard thereby stays
   !                          below the MPI communicator limit, because
   !                          ESMF_TestCase leaks one VM per test.
   function get_parameters() result(params)

      type(ScenarioDescription), allocatable :: params(:)
      type(ScenarioEntry), allocatable :: table(:)
      logical :: pending_only
      character(:), allocatable :: only_name

      table = scenario_table()
      pending_only = env_is_set('MAPL_SCENARIO_PENDING')
      only_name = env_value('MAPL_SCENARIO_ONLY')

      params = [ScenarioDescription:: ]

      ! Field oriented tests
      params = [params, add_params('item type', check_item_type)]
      params = [params, add_params('exists', check_field_exists)]
      params = [params, add_params('status', check_field_status)]
      params = [params, add_params('typekind', check_field_typekind)]
      params = [params, add_params('units', check_field_units)]
      params = [params, add_params('rank', check_field_rank)]
      params = [params, add_params('geom_name', check_field_geom_name)]
      params = [params, add_params('standard_name', check_field_standard_name)]
      params = [params, add_params('long_name', check_field_long_name)]
      params = [params, add_params('value', check_field_value)]
      params = [params, add_params('vertical_profile', check_field_vertical_profile)]

      ! Service oriented tests
      params = [params, add_params('fieldcount', check_fieldcount, &
           only=['service_service     ', 'service_with_options'])]

      call apply_shard(params, env_value('MAPL_SCENARIO_SHARD'))

   contains

      subroutine apply_shard(params, shard)
         type(ScenarioDescription), allocatable, intent(inout) :: params(:)
         character(*), intent(in) :: shard

         integer :: slash, k, n, i
         logical :: ok

         if (len(shard) == 0) return

         k = -1
         n = -1
         slash = index(shard, '/')
         ok = (slash > 1 .and. slash < len(shard))
         if (ok) ok = (index(shard(slash+1:), '/') == 0)
         if (ok) ok = all_digits(shard(:slash-1)) .and. &
              all_digits(shard(slash+1:))
         if (ok) then
            read(shard(:slash-1), '(i10)', iostat=i) k
            ok = (i == 0)
         end if
         if (ok) then
            read(shard(slash+1:), '(i10)', iostat=i) n
            ok = (i == 0)
         end if
         if (ok) ok = (n >= 1 .and. k >= 0 .and. k < n)
         if (.not. ok) then
            error stop 'MAPL_SCENARIO_SHARD must be k/N with 0 <= k < N: ' &
                 // shard
         end if

         params = pack(params, [(mod(i - 1, n) == k, i = 1, size(params))])
      end subroutine apply_shard

      logical function all_digits(str)
         character(*), intent(in) :: str

         ! At most 9 digits, so the (i10) read cannot overflow.
         all_digits = (len(str) <= 9 .and. verify(str, '0123456789') == 0)
      end function all_digits

      function add_params(check_name, check_stateitem, only) result(params)
         type(ScenarioDescription), allocatable :: params(:)
         character(*), intent(in) :: check_name
         procedure(I_check_stateitem) :: check_stateitem
         character(*), optional, intent(in) :: only(:)

         integer :: i, j
         character(:), allocatable :: modes(:)

         params = [ScenarioDescription:: ]
         do i = 1, size(table)
            if (len(only_name) > 0) then
               if (table(i)%name /= only_name) cycle
            end if
            if (present(only)) then
               if (.not. any([(trim(only(j)) == table(i)%name, j=1, size(only))])) cycle
            end if
            modes = modes_for(table(i), pending_only)
            do j = 1, size(modes)
               if (allocated(table(i)%expected_exception)) then
                  params = [params, ScenarioDescription(table(i)%name, table(i)%root, trim(modes(j)), &
                       check_name, check_stateitem, table(i)%permissive, table(i)%expected_exception)]
               else
                  params = [params, ScenarioDescription(table(i)%name, table(i)%root, trim(modes(j)), &
                       check_name, check_stateitem, table(i)%permissive)]
               end if
            end do
         end do
      end function add_params

   end function get_parameters

   subroutine setup(this)
      class(Scenario), intent(inout) :: this

      type(ESMF_HConfig) :: config
      integer :: status, user_status
      type(ESMF_State) :: importState, exportState
      character(:), allocatable :: file_name
      type(ESMF_Clock) :: clock
      type(OuterMetaComponent), pointer :: outer_meta
      integer :: n, numsteps
      logical :: has_numsteps

      call set_graph_mode(this%graph_mode, _RC)
      call set_materialize_extensions(this%graph_mode /= GRAPH_MODE_REGISTRY)

      this%saved_fd_config = get_field_dictionary_config()
      if (this%permissive) call set_field_dictionary_config(FieldDictionaryConfig())

      file_name = './scenarios/' // this%scenario_name // '/' // this%scenario_root
      config = ESMF_HConfigCreate(filename=file_name, _RC)

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      associate (outer_gc => this%outer_gc, outer_states => this%outer_states, grid => this%grid)

        ! docs/graph/spec/20-implementation-roadmap.md sec 20.4.21,
        ! sub-step 21-1: this test's own bootstrap sequence (ESMF_Config
        ! -> ESMF_GridCompCreate -> SetServices ->
        ! GENERIC_INIT_PHASE_SEQUENCE) has been factored into
        ! build_scenario_tree, shared with the new standalone graph
        ! diagnostic driver (apps/graph_diagnostic/). This test is the
        ! regression check for that extraction: everything below this
        ! call (the run-phase loop, expectations loading) is unchanged.
        call build_scenario_tree(file_name, outer_gc, outer_meta, &
             clock=clock, importState=importState, exportState=exportState, _RC)

        outer_states = MultiState(importState=importState, exportState=exportState)

        if (allocated(this%expected_exception)) then
           @assertExceptionRaised(this%expected_exception)
        end if

        numsteps = 1
        has_numsteps = esmf_HConfigIsDefined(config, keystring='numsteps', _RC)
        if (has_numsteps) then
           numSteps = esmf_HConfigAsI4(config, keystring='numsteps', _RC)
        end if

        do n = 1, numSteps
           call ESMF_GridCompRun(outer_gc, &
                importState=importState, exportState=exportState, clock=clock, &
                userRC=user_status, phase=GENERIC_RUN_USER, _RC)
           _VERIFY(user_status)
           call esmf_ClockAdvance(clock, _RC)
           call ESMF_GridCompRun(outer_gc, &
                importState=importState, exportState=exportState, clock=clock, &
                userRC=user_status, phase=GENERIC_RUN_CLOCK_ADVANCE, _RC)
        end do


      end associate

      call set_materialize_extensions(.false.)
      call set_graph_mode(GRAPH_MODE_REGISTRY, _RC)

      file_name = './scenarios/' // this%scenario_name // '/expectations.yaml'
      this%expectations = ESMF_HConfigCreate(filename=file_name, _RC)
   end subroutine setup

   ! In theory we want to call finalize here and then destroy ESMF objects in this
   subroutine teardown(this)
      class(Scenario), intent(inout) :: this

      integer :: status

      call set_materialize_extensions(.false.)
      call set_graph_mode(GRAPH_MODE_REGISTRY, _RC)
      call set_field_dictionary_config(this%saved_fd_config)

      !# call ESMF_GridCompDestroy(this%outer_gc, _RC)

      !# call ESMF_StateDestroy(this%outer_states%importState,_RC)
      !# call ESMF_StateDestroy(this%outer_states%exportState, _RC)
   end subroutine teardown

   @test
   subroutine check(this)

      class(Scenario), intent(inout) :: this

      integer :: status
      integer :: i
      character(:), allocatable :: comp_path, item_name
      type(ESMF_HConfig) :: comp_expectations, expected_properties
      type(MultiState) :: comp_states
      type(ESMF_HConfig) :: state_items
      integer :: item_count, expected_item_count
      type(ESMF_Field) :: field
      type(ESMF_FieldStatus_Flag) :: expected_field_status, field_status
      character(:), allocatable :: expected_status

      components: do i = 1, ESMF_HConfigGetSize(this%expectations)
         comp_expectations = ESMF_HConfigCreateAt(this%expectations,index=i,_RC)
         comp_path = ESMF_HConfigAsString(comp_expectations,keyString='component',_RC)
         call get_substates(this%outer_gc, this%outer_states, comp_path, substates=comp_states, _RC)

         call check_items_in_state('import', _RC)
         call check_items_in_state('export', _RC)
         call check_items_in_state('internal', _RC)
      end do components

      call check_graph(this, _RC)

   contains

      subroutine check_items_in_state(state_intent, rc)
         character(*), intent(in) :: state_intent
         integer, intent(out) :: rc

         integer :: status
         type(ESMF_HConfig) :: state_items
         type(ESMF_State) :: state
         character(:), allocatable :: msg
         type(ESMF_HConfigIter) :: hconfigIter,hconfigIterBegin,hconfigIterEnd

         rc = -1

         if (.not. ESMF_HConfigIsDefined(comp_expectations,keyString=state_intent)) then
            rc = 0 ! that's ok
            return
         end if

         call comp_states%get_state(state, state_intent, _RC)

         msg = comp_path // '::' // state_intent

         state_items = ESMF_HConfigCreateAt(comp_expectations, keyString=state_intent,_RC)
         @assertTrue(ESMF_HConfigIsMap(state_items), msg)

         hconfigIter = ESMF_HConfigIterBegin(state_items)
         hconfigIterBegin = ESMF_HConfigIterBegin(state_items)
         hconfigIterEnd = ESMF_HConfigIterEnd(state_items)
         do while (ESMF_HConfigIterLoop(hconfigIter,hconfigIterBegin,hconfigIterEnd))
            item_name = ESMF_HConfigAsStringMapKey(hconfigIter,_RC)
            expected_properties = ESMF_HConfigCreateAtMapVal(hconfigIter,_RC)

            msg = comp_path // '::' // state_intent // '::' // item_name

            associate (test_description => msg // '::' // this%check_name)
              call this%check_stateitem(expected_properties, state, item_name, test_description, _RC)
            end associate
         end do
         rc = 0
      end subroutine check_items_in_state

   end subroutine check

   ! Graph-structure checks, driven by an optional `graph:` key on the
   ! <root> entry of expectations.yaml:
   !   graph:
   !     nodes: 5          (optional: nodes owned by the root's own graph)
   !     connections:
   !       - {export: comp_src/T, import: comp_dst/T, chain: [units, typekind]}
   !       - {export: comp_src/T, import: comp_dst/T, wired: false}
   ! `chain` lists the extension steps in order from export to import; an empty
   ! list means a direct edge. Step kinds are inferred from the units and
   ! typekind of the items either side of each transform. Paths are relative
   ! to the root component, and each connection is one the root declared
   ! (chains live in the root's graph). Registry mode has no graph, so it is skipped; the
   ! checks run once per scenario and mode, under the 'item type' parameter.
   subroutine check_graph(this, rc)
      class(Scenario), intent(inout) :: this
      integer, intent(out) :: rc

      integer :: status, i, j, expected_nodes
      type(NodeIdSet), target :: node_ids
      type(OuterMetaComponent), pointer :: root_meta
      type(ComponentGraph), pointer :: root_graph
      type(DependencyNetwork), pointer :: net
      type(ESMF_HConfig) :: comp_expectations, graph_expectations, connections, connection
      character(:), allocatable :: comp_path

      rc = 0
      if (this%graph_mode == GRAPH_MODE_REGISTRY) return
      if (this%check_name /= 'item type') return

      root_meta => get_outer_meta(this%outer_gc, _RC)
      root_graph => root_meta%get_component_graph()
      net => root_graph%get_network(root_graph%get_default_network_id())

      do i = 1, ESMF_HConfigGetSize(this%expectations)
         comp_expectations = ESMF_HConfigCreateAt(this%expectations, index=i, _RC)
         if (.not. ESMF_HConfigIsDefined(comp_expectations, keyString='graph')) cycle
         comp_path = ESMF_HConfigAsString(comp_expectations, keyString='component', _RC)
         @assertEqual('<root>', comp_path, 'graph expectations belong on the <root> entry')

         graph_expectations = ESMF_HConfigCreateAt(comp_expectations, keyString='graph', _RC)
         if (ESMF_HConfigIsDefined(graph_expectations, keyString='nodes')) then
            expected_nodes = ESMF_HConfigAsI4(graph_expectations, keyString='nodes', _RC)
            node_ids = root_graph%get_node_ids()
            @assertEqual(expected_nodes, node_ids%size(), 'graph :: node count owned by the root graph')
         end if
         connections = ESMF_HConfigCreateAt(graph_expectations, keyString='connections', _RC)
         do j = 1, ESMF_HConfigGetSize(connections)
            connection = ESMF_HConfigCreateAt(connections, index=j, _RC)
            call check_connection(connection, _RC)
         end do
      end do
      rc = 0

   contains

      subroutine check_connection(connection, rc)
         type(ESMF_HConfig), intent(in) :: connection
         integer, intent(out) :: rc

         integer :: status, k
         character(:), allocatable :: export_path, import_path, msg
         type(NodeId), pointer :: export_id, import_id
         type(NodeId) :: cur, prev, transform_id
         character(len=16), allocatable :: found(:), expected(:)
         type(ESMF_HConfig) :: chain, step
         character(len=16) :: kind
         logical :: wired, ok, is_expression
         integer, parameter :: MAX_CHAIN = 16

         rc = 0
         export_path = ESMF_HConfigAsString(connection, keyString='export', _RC)
         import_path = ESMF_HConfigAsString(connection, keyString='import', _RC)
         msg = 'graph :: ' // export_path // ' -> ' // import_path

         export_id => resolve(export_path, ESMF_STATEINTENT_EXPORT, _RC)
         import_id => resolve(import_path, ESMF_STATEINTENT_IMPORT, _RC)
         @assert_that(msg // ' :: export resolved', associated(export_id), is(true()))
         @assert_that(msg // ' :: import resolved', associated(import_id), is(true()))
         if (.not. (associated(export_id) .and. associated(import_id))) then
            rc = 0
            return
         end if

         wired = .true.
         if (ESMF_HConfigIsDefined(connection, keyString='wired')) then
            wired = ESMF_HConfigAsLogical(connection, keyString='wired', _RC)
         end if

         is_expression = .false.
         if (ESMF_HConfigIsDefined(connection, keyString='expression')) then
            is_expression = ESMF_HConfigAsLogical(connection, &
                 keyString='expression', _RC)
         end if

         if (.not. wired) then
            @assert_that(msg // ' :: no edge', net%contains_dependency(export_id, import_id), is(false()))
            @assert_that(msg // ' :: import has no predecessor', net%has_predecessors(import_id), is(false()))
            rc = 0
            return
         end if

         allocate(expected(0))
         if (ESMF_HConfigIsDefined(connection, keyString='chain')) then
            chain = ESMF_HConfigCreateAt(connection, keyString='chain', _RC)
            deallocate(expected)
            allocate(expected(ESMF_HConfigGetSize(chain)))
            do k = 1, size(expected)
               step = ESMF_HConfigCreateAt(chain, index=k, _RC)
               expected(k) = ESMF_HConfigAsString(step, _RC)
            end do
         end if

         allocate(found(0))
         if (is_expression) then
            call check_expression_connection(connection, export_id, &
                 import_id, msg, _RC)
            return
         end if
         if (.not. net%contains_dependency(export_id, import_id)) then
            ! import <- final item <- transform <- item ... <- export
            cur = import_id
            prev = sole_predecessor(cur, ok)
            @assert_that(msg // ' :: import has exactly one predecessor', ok, is(true()))
            if (.not. ok) then
               rc = 0
               return
            end if
            cur = prev
            do while (.not. cur == export_id)
               transform_id = sole_predecessor(cur, ok)
               @assert_that(msg // ' :: chain item has exactly one predecessor', ok, is(true()))
               if (.not. ok) exit
               @assert_that(msg // ' :: predecessor is a transform', is_transform(transform_id), is(true()))
               if (.not. is_transform(transform_id)) exit
               prev = sole_predecessor(transform_id, ok)
               @assert_that(msg // ' :: transform has exactly one input', ok, is(true()))
               if (.not. ok) exit
               kind = step_kind(prev, cur, _RC)
               found = [kind, found]
               cur = prev
               @assert_that(msg // ' :: chain longer than MAX_CHAIN (cycle?)', size(found) <= MAX_CHAIN, is(true()))
               if (size(found) > MAX_CHAIN) exit
            end do
            @assert_that(msg // ' :: chain reaches the export', cur == export_id, is(true()))
         end if

         @assertEqual(size(expected), size(found), msg // ' :: chain length')
         if (size(expected) == size(found)) then
            do k = 1, size(expected)
               @assertEqual(trim(expected(k)), trim(found(k)), msg // ' :: chain step ' // int_to_string(k))
            end do
         end if
         rc = 0
      end subroutine check_connection

      subroutine check_expression_connection(connection, export_id, &
           import_id, msg, rc)
          type(ESMF_HConfig), intent(in) :: connection
          type(NodeId), intent(in) :: export_id, import_id
          character(*), intent(in) :: msg
          integer, intent(out) :: rc

          type(NodeId) :: result_id, expression_transform_id, bound_id
          type(NodeId) :: transform_id, previous
          type(NodeId), pointer :: binding
          type(NodeIdSet), target :: preds
          type(NodeIdSetIterator) :: pred_iter
          type(ESMF_HConfig) :: inputs, input_steps, step
          type(ESMF_HConfigIter) :: iter, begin_iter, end_iter
          character(:), allocatable :: input_name, export_path, source_comp
          character(:), allocatable :: expected_kind
          character(len=16) :: actual_kind
          class(GraphNode), pointer :: node
          logical :: ok
          integer :: slash, n, status
          type(PortSpecMap) :: input_ports

          rc = 0
          result_id = sole_predecessor(import_id, ok)
          @assertTrue(ok, msg // ' :: import has exactly one predecessor')
          if (.not. ok) return
          if (ESMF_HConfigIsDefined(connection, keyString='chain')) then
             input_steps = ESMF_HConfigCreateAt(connection, &
                  keyString='chain', _RC)
             do n = ESMF_HConfigGetSize(input_steps), 1, -1
                transform_id = sole_predecessor(result_id, ok)
                @assertTrue(ok, msg // ' :: result chain predecessor')
                if (.not. ok) return
                @assertTrue(is_transform(transform_id), msg // &
                     ' :: result chain predecessor is transform')
                if (.not. is_transform(transform_id)) return
                previous = sole_predecessor(transform_id, ok)
                @assertTrue(ok, msg // ' :: result transform has one input')
                if (.not. ok) return
                step = ESMF_HConfigCreateAt(input_steps, index=n, _RC)
                expected_kind = ESMF_HConfigAsString(step, _RC)
                actual_kind = step_kind(previous, result_id, _RC)
                @assertEqual(expected_kind, trim(actual_kind))
                result_id = previous
             end do
          end if

          @assertFalse(result_id == export_id, &
               msg // ' :: evaluation result is not expression placeholder')
          preds = net%get_predecessors(result_id)
          @assertEqual(1, preds%size(), &
               msg // ' :: result has exactly one producer')
          if (preds%size() /= 1) return
          pred_iter = preds%ftn_begin()
          call pred_iter%next()
          expression_transform_id = pred_iter%of()
          node => root_graph%get_node(expression_transform_id)
          select type (transform_node => node)
          class is (TransformGraphNode)
             @assertTrue(transform_node%is_output_port( &
                  'destination_field'), msg // ' :: expression output port')
             inputs = ESMF_HConfigCreateAt(connection, &
                  keyString='inputs', _RC)
             input_ports = transform_node%get_input_ports()
             @assertEqual(ESMF_HConfigGetSize(inputs), input_ports%size(), &
                  msg // ' :: exact expression input count')
             begin_iter = ESMF_HConfigIterBegin(inputs, _RC)
             end_iter = ESMF_HConfigIterEnd(inputs, _RC)
             iter = begin_iter
             export_path = ESMF_HConfigAsString(connection, &
                  keyString='export', _RC)
             slash = index(export_path, '/', back=.true.)
             source_comp = export_path(:slash-1)
             do while (ESMF_HConfigIterLoop(iter, begin_iter, end_iter))
                input_name = ESMF_HConfigAsStringMapKey(iter, _RC)
                @assertTrue(transform_node%is_input_port(input_name), &
                     msg // ' :: expression input ' // input_name)
                binding => root_graph%get_port_binding( &
                     root_graph%get_default_network_id(), &
                     expression_transform_id, input_name)
                @assertTrue(associated(binding), msg // &
                     ' :: expression input is bound: ' // input_name)
                if (.not. associated(binding)) cycle
                bound_id = binding
                input_steps = ESMF_HConfigCreateAtMapVal(iter, _RC)
                do n = ESMF_HConfigGetSize(input_steps), 1, -1
                   transform_id = sole_predecessor(bound_id, ok)
                   @assertTrue(ok, msg // ' :: input chain predecessor')
                   if (.not. ok) return
                   @assertTrue(is_transform(transform_id), msg // &
                        ' :: input chain predecessor is transform')
                   if (.not. is_transform(transform_id)) return
                   previous = sole_predecessor(transform_id, ok)
                   @assertTrue(ok, msg // &
                        ' :: input transform has one input')
                   if (.not. ok) return
                   step = ESMF_HConfigCreateAt(input_steps, index=n, _RC)
                   expected_kind = ESMF_HConfigAsString(step, _RC)
                   actual_kind = step_kind(previous, bound_id, _RC)
                   @assertEqual(expected_kind, trim(actual_kind))
                   bound_id = previous
                end do
                binding => resolve(source_comp // '/' // input_name, &
                     ESMF_STATEINTENT_EXPORT, _RC)
                @assertTrue(associated(binding), msg // &
                     ' :: expression source resolved: ' // input_name)
                if (associated(binding)) then
                   @assertTrue(bound_id == binding, msg // &
                        ' :: input chain reaches ' // input_name)
                end if
             end do
          class default
             @assertTrue(.false., msg // &
                  ' :: result producer is an ExpressionTransform')
             return
          end select

          @assertFalse(net%has_predecessors(export_id), &
               msg // ' :: expression placeholder has no predecessor')
          @assertFalse(net%has_successors(export_id), &
               msg // ' :: expression placeholder has no successor')
          rc = 0

      end subroutine check_expression_connection

      function resolve(path, intent, rc) result(id)
         type(NodeId), pointer :: id
         character(*), intent(in) :: path
         type(ESMF_StateIntent_Flag), intent(in) :: intent
         integer, intent(out) :: rc

         integer :: status, idx
         type(OuterMetaComponent), pointer :: meta
         type(ComponentGraph), pointer :: graph
         character(:), allocatable :: rest, child_name

         rc = 0
         id => null()
         idx = index(path, '/', back=.true.)
         @assertTrue(idx > 1, 'graph expectation path needs a component and an item: ' // path)
         if (idx <= 1) then
            rc = 0
            return
         end if
         meta => root_meta
         rest = path(:idx-1)
         do while (len(rest) > 0)
            idx = index(rest, '/')
            if (idx == 0) then
               child_name = rest
               rest = ''
            else
               child_name = rest(:idx-1)
               rest = rest(idx+1:)
            end if
            meta => meta%get_child_outer_meta(child_name, _RC)
         end do
         graph => meta%get_component_graph()
         idx = index(path, '/', back=.true.)
         id => graph%get_resource_index(item_key(intent, path(idx+1:)))
         rc = 0
      end function resolve

      function sole_predecessor(id, ok) result(pred)
         type(NodeId) :: pred
         type(NodeId), intent(in) :: id
         logical, intent(out) :: ok

         type(NodeIdSet), target :: preds
         type(NodeIdSetIterator) :: iter

         preds = net%get_predecessors(id)
         ok = (preds%size() == 1)
         if (.not. ok) return
         iter = preds%ftn_begin()
         call iter%next()
         pred = iter%of()
      end function sole_predecessor

      logical function is_transform(id)
         type(NodeId), intent(in) :: id
         class(GraphNode), pointer :: node

         node => root_graph%get_node(id)
         is_transform = .false.
         if (.not. associated(node)) return
         select type (node)
         class is (TransformGraphNode)
            is_transform = .true.
         end select
      end function is_transform

      function step_kind(in_id, out_id, rc) result(kind)
         character(len=16) :: kind
         type(NodeId), intent(in) :: in_id, out_id
         integer, intent(out) :: rc

         integer :: status
         character(:), allocatable :: in_units, out_units
         type(ESMF_TypeKind_Flag) :: in_tk, out_tk
         type(ESMF_Field) :: in_field, out_field

         rc = 0
         kind = 'unknown'
         in_field = item_field(in_id, _RC)
         out_field = item_field(out_id, _RC)
         call FieldGet(in_field, units=in_units, typekind=in_tk, _RC)
         call FieldGet(out_field, units=out_units, typekind=out_tk, _RC)

         if (in_units /= out_units .and. in_tk == out_tk) kind = 'units'
         if (in_units == out_units .and. in_tk /= out_tk) kind = 'typekind'
         rc = 0
      end function step_kind

      function item_field(id, rc) result(field)
         type(ESMF_Field) :: field
         type(NodeId), intent(in) :: id
         integer, intent(out) :: rc

         integer :: status
         class(GraphNode), pointer :: node
         type(GraphStateItem), pointer :: payload

         rc = 0
         node => root_graph%get_node(id)
         select type (node)
         class is (StateItemNode)
            payload => node%get_payload_ptr()
         class default
            @assertTrue(.false., 'graph chain item is not a StateItemNode')
            return
         end select
         field = payload%get_field(_RC)
         @assertTrue(ESMF_FieldIsCreated(field), 'graph chain item has a real, created field')
      end function item_field

      function int_to_string(n) result(str)
         character(:), allocatable :: str
         integer, intent(in) :: n
         character(len=12) :: buffer

         write(buffer, '(i0)') n
         str = trim(buffer)
      end function int_to_string

   end subroutine check_graph

   function get_itemtype(state, short_name, rc) result(itemtype)
      type(ESMF_StateItem_Flag) :: itemtype
      type(ESMF_State) :: state
      character(*), intent(in) :: short_name
      integer, intent(out) :: rc

      integer :: status
      integer :: idx
      type(ESMF_State) :: substate, tmp_state
      character(:), allocatable :: name

      integer :: itemcount

      rc = 0
      name = short_name
      substate = state

      do
         idx = index(name, '/')
         if (idx == 0) then
            call ESMF_StateGet(substate, name, itemtype=itemtype, _RC)
            return
         end if
         call ESMF_StateGet(substate, name(:idx-1), tmp_state, rc=status)
         @assert_that(short_name, status, is(0))
         name = name(idx+1:)
         substate = tmp_state
      end do

      rc = 0
   end function get_itemtype

   subroutine check_item_type(expectations, state, short_name, description, rc)

      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      type(ESMF_StateItem_Flag) :: expected_itemtype, itemtype
      character(len=:), allocatable :: msg
      integer :: status
      integer :: idx

      msg = description
      expected_itemtype = get_expected_itemtype(expectations, _RC)

      itemtype = get_itemtype(state, short_name, _RC)
      msg = msg // ' :: expected=' // itemtype_to_string(expected_itemtype) // &
           ', found=' // itemtype_to_string(itemtype)
      @assert_that(msg, expected_itemtype == itemtype, is(true()))

      rc = 0

   contains

      function itemtype_to_string(itemtype) result(s)
         character(:), allocatable :: s
         type(ESMF_StateItem_Flag), intent(in) :: itemtype

         if (itemtype == ESMF_STATEITEM_FIELD) then
            s = 'field'
         else if (itemtype == ESMF_STATEITEM_FIELDBUNDLE) then
            s = 'bundle'
         else if (itemtype == ESMF_STATEITEM_STATE) then
            s = 'state'
         else
            s = 'unknown'
         end if
      end function itemtype_to_string

      function get_expected_itemtype(expectations, rc) result(expected_itemtype)
         type(ESMF_StateItem_Flag) :: expected_itemtype
         type(ESMF_HConfig), intent(in) :: expectations
         integer, intent(out) :: rc

         character(:), allocatable :: itemtype_str
         integer :: status

         if (.not. ESMF_HConfigIsDefined(expectations,keyString='class')) then
            expected_itemtype = ESMF_STATEITEM_FIELD
            rc=0
            return
         end if

         itemtype_str= ESMF_HConfigAsString(expectations,keyString='class',_RC)

         select case (itemtype_str)
         case ('field')
            expected_itemtype = ESMF_STATEITEM_FIELD
         case ('bundle')
            expected_itemtype = ESMF_STATEITEM_FIELDBUNDLE
         case default
            expected_itemtype = ESMF_STATEITEM_UNKNOWN
         end select

         rc = 0
      end function get_expected_itemtype

   end subroutine check_item_type

   subroutine check_field_status(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      character(len=:), allocatable :: expected_field_status_str
      type(ESMF_FieldStatus_Flag) :: expected_field_status
      type(ESMF_FieldStatus_Flag) :: found_field_status
      type(ESMF_StateItem_Flag) :: itemtype
      type(ESMF_Field) :: field
      type(ESMF_FieldBundle) :: bundle
      type(ESMF_Field), allocatable :: field_list(:)
      integer :: status, j
      character(len=:), allocatable :: msg

      msg = short_name // ':: '// description

      itemtype = get_itemtype(state, short_name, _RC)
      if (itemtype /= ESMF_STATEITEM_FIELD .and. itemtype /= ESMF_STATEITEM_FIELDBUNDLE) then ! that's ok
         rc = 0
         return
      end if

      if (.not. ESMF_HConfigIsDefined(expectations,keyString='status')) then
         rc = 0
         return
      end if

      expected_field_status_str = ESMF_HConfigAsString(expectations,keyString='status',_RC)
      expected_field_status = ESMF_FIELDSTATUS_GRIDSET
      select case (expected_field_status_str)
      case ('complete')
         expected_field_status = ESMF_FIELDSTATUS_COMPLETE
      case ('gridset')
         expected_field_status = ESMF_FIELDSTATUS_GRIDSET
      case ('empty')
         expected_field_status = ESMF_FIELDSTATUS_EMPTY
      case default
         _VERIFY(-1)
      end select

      if (itemtype == ESMF_STATEITEM_FIELD) then
         call ESMF_StateGet(state, short_name, field, _RC)
         call ESMF_FieldGet(field, status=found_field_status, _RC)
         msg = msg // ' :: expected=' // expected_field_status_str // ', found=' // &
              fieldstatus_to_string(found_field_status)
         @assert_that(msg, expected_field_status == found_field_status, is(true()))
      else ! ESMF_STATEITEM_FIELDBUNDLE
         call ESMF_StateGet(state, short_name, bundle, _RC)
         call MAPL_FieldBundleGet(bundle, fieldList=field_list, _RC)
         do j = 1, size(field_list)
            call ESMF_FieldGet(field_list(j), status=found_field_status, _RC)
            msg = short_name // ':: '// description // ' :: member=' // trim(int_to_string(j)) // &
                 ' :: expected=' // expected_field_status_str // ', found=' // &
                 fieldstatus_to_string(found_field_status)
            @assert_that(msg, expected_field_status == found_field_status, is(true()))
         end do
      end if

      rc = 0

   contains
      function fieldstatus_to_string(fstatus) result(s)
         character(:), allocatable :: s
         type(ESMF_FieldStatus_Flag), intent(in) :: fstatus
         if (fstatus == ESMF_FIELDSTATUS_COMPLETE) then
            s = 'complete'
         else if (fstatus == ESMF_FIELDSTATUS_GRIDSET) then
            s = 'gridset'
         else if (fstatus == ESMF_FIELDSTATUS_EMPTY) then
            s = 'empty'
         else
            s = 'unknown'
         end if
      end function fieldstatus_to_string

      function int_to_string(i) result(s)
         integer, intent(in) :: i
         character(:), allocatable :: s
         character(len=12) :: buffer
         write(buffer, '(i0)') i
         s = trim(buffer)
      end function int_to_string
   end subroutine check_field_status

   subroutine check_field_typekind(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      character(len=:), allocatable :: expected_field_typekind_str
      type(ESMF_TypeKind_Flag) :: expected_field_typekind
      type(ESMF_TypeKind_Flag) :: found_field_typekind
      type(ESMF_StateItem_Flag) :: itemtype
      integer :: status
      character(len=:), allocatable :: msg
      type(ESMF_Field) :: field

      msg = description

      itemtype = get_itemtype(state, short_name, _RC)
      if (itemtype /= ESMF_STATEITEM_FIELD) then ! that's ok
         rc = 0
         return
      end if

      if (.not. ESMF_HConfigIsDefined(expectations,keyString='typekind')) then
         rc = 0
         return
      end if

      expected_field_typekind_str = ESMF_HConfigAsString(expectations,keyString='typekind',_RC)
      select case (expected_field_typekind_str)
      case ('R4')
         expected_field_typekind = ESMF_TYPEKIND_R4
      case ('R8')
         expected_field_typekind = ESMF_TYPEKIND_R8
      case default
         _VERIFY(-1)
      end select

      call ESMF_StateGet(state, short_name, field, _RC)
      call ESMF_FieldGet(field, typekind=found_field_typekind, _RC)
      msg = msg // ' :: expected=' // expected_field_typekind_str // ', found=' // &
           typekind_to_string(found_field_typekind)
      @assert_that(msg, expected_field_typekind == found_field_typekind, is(true()))

      rc = 0

   contains
      function typekind_to_string(tk) result(s)
         character(:), allocatable :: s
         type(ESMF_TypeKind_Flag), intent(in) :: tk
         if (tk == ESMF_TYPEKIND_R4) then
            s = 'R4'
         else if (tk == ESMF_TYPEKIND_R8) then
            s = 'R8'
         else if (tk == ESMF_TYPEKIND_I4) then
            s = 'I4'
         else if (tk == ESMF_TYPEKIND_I8) then
            s = 'I8'
         else
            s = 'unknown'
         end if
      end function typekind_to_string
   end subroutine check_field_typekind

   subroutine check_field_units(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      character(len=:), allocatable :: expected_units, found_units
      type(ESMF_StateItem_Flag) :: itemtype
      type(ESMF_Field) :: field
      integer :: status

      itemtype = get_itemtype(state, short_name, _RC)
      if (itemtype /= ESMF_STATEITEM_FIELD) then ! that's ok
         rc = 0
         return
      end if

      if (.not. ESMF_HConfigIsDefined(expectations,keyString='units')) then
         rc = 0
         return
      end if

      expected_units = ESMF_HConfigAsString(expectations,keyString='units',_RC)
      call ESMF_StateGet(state, short_name, field, _RC)
      call FieldGet(field, units=found_units, _RC)
      @assert_that(description // ' :: expected=' // expected_units // ', found=' // found_units, &
           found_units == expected_units, is(true()))

      rc = 0
   end subroutine check_field_units

   subroutine check_field_value(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      real, allocatable :: expected_field_values(:)
      real :: tolerance
      integer :: status, j
      character(len=:), allocatable :: msg
      type(ESMF_Field) :: field
      type(ESMF_FieldBundle) :: bundle
      type(ESMF_Field), allocatable :: field_list(:)
      type(ESMF_StateItem_Flag) :: itemtype
      logical :: is_sequence

      msg = description

      itemtype = get_itemtype(state, short_name, _RC)
      if (itemtype /= ESMF_STATEITEM_FIELD .and. itemtype /= ESMF_STATEITEM_FIELDBUNDLE) then ! that's ok
         rc = 0
         return
      end if

      if (.not. ESMF_HConfigIsDefined(expectations,keyString='value')) then
         rc = 0
         return
      end if

      tolerance = 0.
      if (ESMF_HConfigIsDefined(expectations, keyString='tolerance')) then
         tolerance = ESMF_HConfigAsR4(expectations,keyString='tolerance',_RC)
      end if

      if (itemtype == ESMF_STATEITEM_FIELD) then
         allocate(expected_field_values(1))
         expected_field_values(1) = ESMF_HConfigAsR4(expectations,keyString='value',_RC)

         call ESMF_StateGet(state, short_name, field, _RC)
         call check_one_field_value(field, expected_field_values(1), tolerance, &
              msg // ' :: ' // trim(short_name), _RC)
      else ! ESMF_STATEITEM_FIELDBUNDLE
         call ESMF_StateGet(state, short_name, bundle, _RC)
         call MAPL_FieldBundleGet(bundle, fieldList=field_list, _RC)

         is_sequence = ESMF_HConfigIsSequence(expectations, keyString='value', _RC)
         if (is_sequence) then
            expected_field_values = ESMF_HConfigAsR4Seq(expectations, keyString='value', _RC)
            @assert_that('value list size must match bundle member count for ' // short_name, &
                 size(expected_field_values), is(equal_to(size(field_list))))
         else
            allocate(expected_field_values(size(field_list)))
            expected_field_values = ESMF_HConfigAsR4(expectations,keyString='value',_RC)
         end if

         do j = 1, size(field_list)
            call check_one_field_value(field_list(j), expected_field_values(j), tolerance, &
                 msg // ' :: ' // trim(short_name) // ' member ' // trim(int_to_string(j)), _RC)
         end do
      end if

      rc = 0

   contains

      function int_to_string(i) result(s)
         integer, intent(in) :: i
         character(:), allocatable :: s
         character(len=12) :: buffer
         write(buffer, '(i0)') i
         s = trim(buffer)
      end function int_to_string

      subroutine check_one_field_value(field, expected_field_value, tolerance, msg, rc)
         type(ESMF_Field), intent(inout) :: field
         real, intent(in) :: expected_field_value
         real, intent(in) :: tolerance
         character(*), intent(in) :: msg
         integer, intent(out) :: rc

         integer :: rank, status
         type(ESMF_TypeKind_Flag) :: typekind

         call ESMF_FieldGet(field, typekind=typekind, rank=rank, rc=status)
         @assert_that('field get failed :: '//msg,  status, is(0))

         if (typekind == ESMF_TYPEKIND_R4) then
            block
               real(kind=ESMF_KIND_R4), pointer :: x2(:,:),x3(:,:,:),x4(:,:,:,:)
               character(len=512) :: buffer
               select case(rank)
               case(2)
                  call ESMF_FieldGet(field, farrayPtr=x2, _RC)
                  if (.not. all(abs(x2 - expected_field_value) <= tolerance)) then
                     write(buffer, '(a,f12.5,a,f12.5,a,f12.5,a,f12.5,a)') 'expected=', expected_field_value, &
                          ', tol=', tolerance, ', range=[', minval(x2), ',', maxval(x2), ']'
                     @assert_that(msg // ' :: ' // trim(buffer), .false., is(true()))
                  end if
               case(3)
                  call ESMF_FieldGet(field, farrayPtr=x3, _RC)
                  if (.not. all(abs(x3 - expected_field_value) <= tolerance)) then
                     write(buffer, '(a,f12.5,a,f12.5,a,f12.5,a,f12.5,a)') 'expected=', expected_field_value, &
                          ', tol=', tolerance, ', range=[', minval(x3), ',', maxval(x3), ']'
                     @assert_that(msg // ' :: ' // trim(buffer), .false., is(true()))
                  end if
               case(4)
                  call ESMF_FieldGet(field, farrayPtr=x4, _RC)
                  if (.not. all(abs(x4 - expected_field_value) <= tolerance)) then
                     write(buffer, '(a,f12.5,a,f12.5,a,f12.5,a,f12.5,a)') 'expected=', expected_field_value, &
                          ', tol=', tolerance, ', range=[', minval(x4), ',', maxval(x4), ']'
                     @assert_that(msg // ' :: ' // trim(buffer), .false., is(true()))
                  end if
               end select
            end block
         elseif (typekind == ESMF_TYPEKIND_R8) then
            block
               real(kind=ESMF_KIND_R8), pointer :: x2(:,:),x3(:,:,:),x4(:,:,:,:)
               character(len=512) :: buffer
               select case(rank)
               case(2)
                  call ESMF_FieldGet(field, farrayPtr=x2, _RC)
                  if (.not. all(abs(x2 - expected_field_value) <= tolerance)) then
                     write(buffer, '(a,f12.5,a,f12.5,a,f12.5,a,f12.5,a)') 'expected=', expected_field_value, &
                          ', tol=', tolerance, ', range=[', minval(x2), ',', maxval(x2), ']'
                     @assert_that(msg // ' :: ' // trim(buffer), .false., is(true()))
                  end if
               case(3)
                  call ESMF_FieldGet(field, farrayPtr=x3, _RC)
                  if (.not. all(abs(x3 - expected_field_value) <= tolerance)) then
                     write(buffer, '(a,f12.5,a,f12.5,a,f12.5,a,f12.5,a)') 'expected=', expected_field_value, &
                          ', tol=', tolerance, ', range=[', minval(x3), ',', maxval(x3), ']'
                     @assert_that(msg // ' :: ' // trim(buffer), .false., is(true()))
                  end if
               case(4)
                  call ESMF_FieldGet(field, farrayPtr=x4, _RC)
                  if (.not. all(abs(x4 - expected_field_value) <= tolerance)) then
                     write(buffer, '(a,f12.5,a,f12.5,a,f12.5,a,f12.5,a)') 'expected=', expected_field_value, &
                          ', tol=', tolerance, ', range=[', minval(x4), ',', maxval(x4), ']'
                     @assert_that(msg // ' :: ' // trim(buffer), .false., is(true()))
                  end if
               end select
            end block
         else
            _VERIFY(-1)
         end if

         rc = 0
      end subroutine check_one_field_value

   end subroutine check_field_value

   subroutine check_field_vertical_profile(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      real, allocatable :: expected_vertical_profile(:)
      integer :: rank
      type(ESMF_TypeKind_Flag) :: typekind
      integer :: status
      character(len=:), allocatable :: msg
      type(ESMF_Field) :: field
      type(ESMF_StateItem_Flag) :: itemtype
      integer :: i, j, l, shape3(3), shape4(4)

      msg = description

      itemtype = get_itemtype(state, short_name, _RC)
      if (itemtype /= ESMF_STATEITEM_FIELD) then ! that's ok
         rc = 0
         return
      end if

      if (.not. ESMF_HConfigIsDefined(expectations,keyString='vertical_profile')) then
         rc = 0
         return
      end if

      expected_vertical_profile = ESMF_HConfigAsR4Seq(expectations,keyString='vertical_profile',_RC)

      call ESMF_StateGet(state, short_name, field, _RC)
      call ESMF_FieldGet(field, typekind=typekind, rank=rank, rc=status)
      @assert_that('field get failed '//short_name,  status, is(0))

      if (typekind == ESMF_TYPEKIND_R4) then
         block
            real(kind=ESMF_KIND_R4), pointer :: x3(:, :, :), x4(:, :, :, :)
            select case(rank)
            case(3)
               call ESMF_FieldGet(field, farrayPtr=x3, _RC)
               shape3 = shape(x3)
               do i = 1, shape3(1)
                  do j = 1, shape3(2)
                     @assert_that("value of "//short_name, x3(i, j, :), is(equal_to(expected_vertical_profile)))
                  end do
               end do
            case(4)
               call ESMF_FieldGet(field, farrayPtr=x4, _RC)
               shape4 = shape(x4)
               do i = 1, shape4(1)
                  do j = 1, shape4(2)
                     do l = 1, shape4(4)
                        @assert_that("value of "//short_name, x4(i, j, :, l), is(equal_to(expected_vertical_profile)))
                     end do
                  end do
               end do
            case default
               error stop "invalid rank"
            end select
         end block
      elseif (typekind == ESMF_TYPEKIND_R8) then
         block
            real(kind=ESMF_KIND_R8), pointer :: x3(:, :, :), x4(:, :, :, :)
            select case(rank)
            case(3)
               call ESMF_FieldGet(field, farrayPtr=x3, _RC)
               shape3 = shape(x3)
               do i = 1, shape3(1)
                  do j = 1, shape3(2)
                     @assert_that("value of "//short_name, x3(i, j, :), is(equal_to(expected_vertical_profile)))
                  end do
               end do
            case(4)
               call ESMF_FieldGet(field, farrayPtr=x4, _RC)
               shape4 = shape(x4)
               do i = 1, shape4(1)
                  do j = 1, shape4(2)
                     do l = 1, shape4(4)
                        @assert_that("value of "//short_name, x4(i, j, :, l), is(equal_to(expected_vertical_profile)))
                     end do
                  end do
               end do
            case default
               error stop "invalid rank"
            end select
         end block
      else
         _VERIFY(-1)
      end if

      rc = 0
   end subroutine check_field_vertical_profile

   subroutine check_field_exists(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      type(ESMF_Field) :: field
      integer :: status
      type(ESMF_StateItem_Flag) :: itemtype
      character(len=:), allocatable :: msg

      msg = description

      itemtype = get_itemtype(state, short_name, _RC)
      if (itemtype /= ESMF_STATEITEM_FIELD) then
         rc = 0
         return
      end if

      ! Simply verify we can retrieve the field
      call ESMF_StateGet(state, short_name, field, _RC)
      @assert_that(msg // ' :: exists', ESMF_FieldIsCreated(field), is(true()))

      rc = 0
   end subroutine check_field_exists

   subroutine check_field_rank(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      type(ESMF_Field) :: field
      integer :: expected_field_rank
      integer :: rank
      integer :: status
      type(ESMF_StateItem_Flag) :: itemtype
      character(len=:), allocatable :: msg

      msg = description

      if (.not. ESMF_HConfigIsDefined(expectations,keyString='rank')) then
         rc = 0
         return
      end if

      call ESMF_StateGet(state, short_name, itemtype=itemtype)
      if (itemtype /= ESMF_STATEITEM_FIELD) then ! that's ok
         rc = 0
         return
      end if

      call ESMF_StateGet(state, short_name, field, _RC)
      call ESMF_FieldGet(field, rank=rank, _RC)

      expected_field_rank = ESMF_HConfigAsI4(expectations,keyString='rank',_RC)
      @assert_that(msg // ' :: rank', rank, is(expected_field_rank))

      rc = 0
   end subroutine check_field_rank

   subroutine check_field_geom_name(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      type(ESMF_Field) :: field
      type(ESMF_Geom) :: geom
      character(:), allocatable :: expected_geom_name
      character(:), allocatable :: geom_name
      integer :: status
      type(ESMF_StateItem_Flag) :: itemtype
      character(len=:), allocatable :: msg

      msg = description

      if (.not. ESMF_HConfigIsDefined(expectations,keyString='geom_name')) then
         rc = 0
         return
      end if

      call ESMF_StateGet(state, short_name, itemtype=itemtype)
      if (itemtype /= ESMF_STATEITEM_FIELD) then ! that's ok
         rc = 0
         return
      end if

      call ESMF_StateGet(state, short_name, field, _RC)
      call ESMF_FieldGet(field, geom=geom, _RC)
      call mapl_GeomGet(geom, name=geom_name, _RC)

      expected_geom_name = ESMF_HConfigAsString(expectations,keyString='geom_name',_RC)
      @assert_that(msg // ' :: geom_name', geom_name, is(expected_geom_name))

      rc = 0
   end subroutine check_field_geom_name

   subroutine check_field_standard_name(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      type(ESMF_Field) :: field
      type(ESMF_FieldBundle) :: bundle
      type(ESMF_Field), allocatable :: field_list(:)
      character(:), allocatable :: expected_standard_name
      character(len=:), allocatable :: expected_standard_names(:)
      integer :: status, j
      type(ESMF_StateItem_Flag) :: itemtype
      logical :: is_sequence
      character(len=:), allocatable :: msg

      msg = description

      if (.not. ESMF_HConfigIsDefined(expectations,keyString='standard_name')) then
         rc = 0
         return
      end if

      itemtype = get_itemtype(state, short_name, _RC)
      if (itemtype /= ESMF_STATEITEM_FIELD .and. itemtype /= ESMF_STATEITEM_FIELDBUNDLE) then ! that's ok
         rc = 0
         return
      end if

      if (itemtype == ESMF_STATEITEM_FIELD) then
         call ESMF_StateGet(state, short_name, field, _RC)
         expected_standard_name = ESMF_HConfigAsString(expectations,keyString='standard_name',_RC)
         call check_one_field_standard_name(field, expected_standard_name, &
              msg // ' :: ' // trim(short_name), _RC)
      else ! ESMF_STATEITEM_FIELDBUNDLE
         call ESMF_StateGet(state, short_name, bundle, _RC)
         call MAPL_FieldBundleGet(bundle, fieldList=field_list, _RC)

         is_sequence = ESMF_HConfigIsSequence(expectations, keyString='standard_name', _RC)
         if (is_sequence) then
            expected_standard_names = ESMF_HConfigAsStringSeq(expectations, stringLen=ESMF_MAXSTR, &
                 keyString='standard_name', _RC)
            @assert_that('standard_name list size must match bundle member count for ' // short_name, &
                 size(expected_standard_names), is(equal_to(size(field_list))))
         else
            expected_standard_name = ESMF_HConfigAsString(expectations,keyString='standard_name',_RC)
         end if

         do j = 1, size(field_list)
            if (is_sequence) then
               call check_one_field_standard_name(field_list(j), trim(expected_standard_names(j)), &
                    msg // ' :: ' // trim(short_name) // ' member ' // trim(int_to_string(j)), _RC)
            else
               call check_one_field_standard_name(field_list(j), expected_standard_name, &
                    msg // ' :: ' // trim(short_name) // ' member ' // trim(int_to_string(j)), _RC)
            end if
         end do
      end if

      rc = 0

   contains

      function int_to_string(i) result(s)
         integer, intent(in) :: i
         character(:), allocatable :: s
         character(len=12) :: buffer
         write(buffer, '(i0)') i
         s = trim(buffer)
      end function int_to_string

      subroutine check_one_field_standard_name(field, expected_standard_name, msg, rc)
         type(ESMF_Field), intent(inout) :: field
         character(*), intent(in) :: expected_standard_name
         character(*), intent(in) :: msg
         integer, intent(out) :: rc

         type(ESMF_FieldStatus_Flag) :: field_status
         character(:), allocatable :: found_standard_name
         integer :: status

         ! standard_name/long_name are only attached to a field once it has
         ! been fully allocated (status: complete).  A merely 'gridset' field
         ! (e.g. an unconnected import, or an export with no consumer) has not
         ! had this metadata applied yet, so there is nothing meaningful to
         ! check.  (Use the 'status' check to verify completeness separately.)
         call ESMF_FieldGet(field, status=field_status, _RC)
         if (field_status /= ESMF_FIELDSTATUS_COMPLETE) then
            rc = 0
            return
         end if

         call MAPL_FieldGet(field, standard_name=found_standard_name, _RC)
         @assert_that(msg // ' :: standard_name', found_standard_name, is(expected_standard_name))

         rc = 0
      end subroutine check_one_field_standard_name

   end subroutine check_field_standard_name

   subroutine check_field_long_name(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      type(ESMF_Field) :: field
      type(ESMF_FieldBundle) :: bundle
      type(ESMF_Field), allocatable :: field_list(:)
      character(:), allocatable :: expected_long_name
      character(len=:), allocatable :: expected_long_names(:)
      integer :: status, j
      type(ESMF_StateItem_Flag) :: itemtype
      logical :: is_sequence
      character(len=:), allocatable :: msg

      msg = description

      if (.not. ESMF_HConfigIsDefined(expectations,keyString='long_name')) then
         rc = 0
         return
      end if

      itemtype = get_itemtype(state, short_name, _RC)
      if (itemtype /= ESMF_STATEITEM_FIELD .and. itemtype /= ESMF_STATEITEM_FIELDBUNDLE) then ! that's ok
         rc = 0
         return
      end if

      if (itemtype == ESMF_STATEITEM_FIELD) then
         call ESMF_StateGet(state, short_name, field, _RC)
         expected_long_name = ESMF_HConfigAsString(expectations,keyString='long_name',_RC)
         call check_one_field_long_name(field, expected_long_name, &
              msg // ' :: ' // trim(short_name), _RC)
      else ! ESMF_STATEITEM_FIELDBUNDLE
         call ESMF_StateGet(state, short_name, bundle, _RC)
         call MAPL_FieldBundleGet(bundle, fieldList=field_list, _RC)

         is_sequence = ESMF_HConfigIsSequence(expectations, keyString='long_name', _RC)
         if (is_sequence) then
            expected_long_names = ESMF_HConfigAsStringSeq(expectations, stringLen=ESMF_MAXSTR, &
                 keyString='long_name', _RC)
            @assert_that('long_name list size must match bundle member count for ' // short_name, &
                 size(expected_long_names), is(equal_to(size(field_list))))
         else
            expected_long_name = ESMF_HConfigAsString(expectations,keyString='long_name',_RC)
         end if

         do j = 1, size(field_list)
            if (is_sequence) then
               call check_one_field_long_name(field_list(j), trim(expected_long_names(j)), &
                    msg // ' :: ' // trim(short_name) // ' member ' // trim(int_to_string(j)), _RC)
            else
               call check_one_field_long_name(field_list(j), expected_long_name, &
                    msg // ' :: ' // trim(short_name) // ' member ' // trim(int_to_string(j)), _RC)
            end if
         end do
      end if

      rc = 0

   contains

      function int_to_string(i) result(s)
         integer, intent(in) :: i
         character(:), allocatable :: s
         character(len=12) :: buffer
         write(buffer, '(i0)') i
         s = trim(buffer)
      end function int_to_string

      subroutine check_one_field_long_name(field, expected_long_name, msg, rc)
         type(ESMF_Field), intent(inout) :: field
         character(*), intent(in) :: expected_long_name
         character(*), intent(in) :: msg
         integer, intent(out) :: rc

         type(ESMF_FieldStatus_Flag) :: field_status
         character(:), allocatable :: found_long_name
         integer :: status

         ! See check_field_standard_name for rationale.
         call ESMF_FieldGet(field, status=field_status, _RC)
         if (field_status /= ESMF_FIELDSTATUS_COMPLETE) then
            rc = 0
            return
         end if

         call MAPL_FieldGet(field, long_name=found_long_name, _RC)
         @assert_that(msg // ' :: long_name', found_long_name, is(expected_long_name))

         rc = 0
      end subroutine check_one_field_long_name

   end subroutine check_field_long_name

   subroutine check_fieldCount(expectations, state, short_name, description, rc)
      type(ESMF_HConfig), intent(in) :: expectations
      type(ESMF_State), intent(inout) :: state
      character(*), intent(in) :: short_name
      character(*), intent(in) :: description
      integer, intent(out) :: rc

      integer :: status
      character(len=:), allocatable :: msg
      integer :: found_fieldCount, expected_fieldCount
      type(ESMF_FieldBundle) :: bundle
      type(ESMF_StateItem_Flag) :: itemtype

      msg = description

      rc = 0

      call ESMF_StateGet(state, short_name, itemtype=itemtype)
      if (itemtype /= ESMF_STATEITEM_FIELDBUNDLE) return ! that's ok

      if (.not. ESMF_HConfigIsDefined(expectations,keyString='fieldcount')) return

      expected_fieldCount = ESMF_HConfigAsI4(expectations,keyString='fieldcount',_RC)
      call ESMF_StateGet(state, short_name, bundle, _RC)
      call ESMF_FieldBundleGet(bundle, fieldCount=found_fieldCount, _RC)

      @assert_that(found_fieldCount, is(expected_fieldCount))
   end subroutine check_fieldCount

   recursive subroutine get_substates(gc, states, component_path, substates, rc)
      use mapl_GriddedComponentDriver_mod
      type(ESMF_GridComp), target, intent(inout) :: gc
      type(MultiState), intent(in) :: states
      character(*), intent(in) :: component_path
      type(MultiState), intent(out) :: substates
      integer, intent(out) :: rc

      integer :: status
      character(:), allocatable :: child_name, new_path
      type(GriddedComponentDriver) :: child
      type(ESMF_GridComp) :: child_gc
      type(OuterMetaComponent), pointer :: outer_meta
      integer :: idx
      type(GriddedComponentDriver), pointer :: user_component


      rc = 0

      if (component_path == '<root>' .or. component_path == '') then
         substates = states
         return
      end if
      outer_meta => get_outer_meta(gc, _RC)

      ! Parse path
      idx = index(component_path, '/')
      if (idx == 0) idx = len(component_path) + 1
      child_name = component_path(:idx-1)

      if (child_name == '<user>') then
         user_component => outer_meta%get_user_gc_driver()
         substates = user_component%get_states()
         return
      end if

      ! Otherwise drill down 1 level.
      child = outer_meta%get_child(child_name, _RC)

      child_gc = child%get_gridcomp()
      new_path = component_path(idx+1:)

      call get_substates(child_gc, child%get_states(), new_path, substates, _RC)

      return
   end subroutine get_substates

   function tostring_description(this) result(s)
      character(:), allocatable :: s
      class(ScenarioDescription), intent(in) :: this

      s = this%name // ' [' // this%check_name // '] mode=' // this%graph_mode
   end function tostring_description

   recursive function num_fields(state, rc) result(n)
      integer :: n
      type(ESMF_State), intent(inout) :: state
      integer, optional, intent(out) :: rc

      integer :: status
      integer :: itemCount, i
      character(ESMF_MAXSTR), allocatable :: itemNameList(:)
      type(ESMF_StateItem_Flag) :: itemType
      type(ESMF_State) :: substate

      n = 0 ! default

      call ESMF_StateGet(state, itemCount=itemCount, _RC)
      allocate(itemNameList(itemCount))
      call ESMF_StateGet(state, itemNameList=itemNameList, _RC)

      do i = 1, itemCount
         call ESMF_StateGet(state, itemName=trim(itemNameList(i)), itemType=itemType, _RC)
         if (itemType == ESMF_STATEITEM_FIELD) then
            n = n + 1
         elseif (itemType == ESMF_STATEITEM_STATE) then
            call ESMF_StateGet(state, trim(itemNameList(i)), substate, _RC)
            n = n + num_fields(substate, _RC)
         end if
      end do

      return
   end function num_fields

end module Test_Scenarios
