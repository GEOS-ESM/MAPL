   ! "vertical_grid_mirror" (the top-level mirror-request key) is not in a
   ! member's known-key list, so it is rejected by the same generic
   ! unsupported-key error as any other unrecognized key.
   @test
   subroutine test_parse_var_specs_rejects_member_vertical_grid_mirror_key()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      integer :: rc, status
      character(*), parameter :: expected = &
           '"members" entry "arg1" has unsupported key "vertical_grid_mirror": a YAML member ' // &
           'supports only "alias", "units", "dims", "vertical_dim_spec", and "vertical_grid"'

      call reset_callback_registry_for_testing()
      call register_callback_interface('toy_members_vgrid_mirror_key', iface, expected_id, _RC)

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {typekind: R4, callback_interface: toy_members_vgrid_mirror_key, ' // &
           'members: {arg1: {vertical_grid_mirror: true}}}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_callback_members's own call site and parse_var_specs's own
      ! call site each pass the failure up (two more _RC levels).
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_rejects_member_vertical_grid_mirror_key

   ! "vertical_dim_spec: none" together with "vertical_grid:" on one
   ! member entry is a hard parse error: the realized field would stay 2D
   ! (make_vertical_grid_characteristic drops a vertical_grid whenever the
   ! stagger is NONE) while the conformance-check dims helper would still
   ! report the member as 'xyz' (it checks vertical_grid before stagger).
   @test
   subroutine test_parse_var_specs_rejects_member_none_with_vertical_grid()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      integer :: rc, status
      character(*), parameter :: expected = &
           '"members" entry "arg1" cannot combine "vertical_dim_spec: none" with ' // &
           '"vertical_grid": a 2D field cannot also carry a vertical grid'

      call reset_callback_registry_for_testing()
      call register_callback_interface('toy_members_none_with_vgrid', iface, expected_id, _RC)

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {typekind: R4, callback_interface: toy_members_none_with_vgrid, ' // &
           'members: {arg1: {vertical_dim_spec: none, vertical_grid: {num_levels: 5}}}}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_callback_members's own call site and parse_var_specs's own
      ! call site each pass the failure up (two more _RC levels).
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_rejects_member_none_with_vertical_grid

   ! A `members:` entry whose name matches a declared interface argument
   ! must answer a FIELD-kind argument; a FieldBundle-kind argument is a
   ! hard parse error, not deferred to conformance-check.
   @test
   subroutine test_parse_var_specs_rejects_member_for_fieldbundle_argument()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      integer :: rc, status
      character(*), parameter :: expected = &
           '"members" entry "bundle_arg" answers a non-FIELD-kind interface ' // &
           'argument; a YAML member can only answer a FIELD-kind argument: cb'

      call reset_callback_registry_for_testing()
      call iface%declare_argument('bundle_arg', MAPL_VARIANT_FIELDBUNDLE, _RC)
      call register_callback_interface('toy_members_fieldbundle', iface, expected_id, _RC)

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {typekind: R4, callback_interface: toy_members_fieldbundle, ' // &
           'members: {bundle_arg: {}}}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_callback_members's own call site and parse_var_specs's own
      ! call site each pass the failure up (two more _RC levels).
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_rejects_member_for_fieldbundle_argument

   ! `members:` cannot be combined with `expression:` or with `class:` on
   ! the same item (to_itemtype.F90).
   @test
   subroutine test_parse_var_specs_rejects_members_plus_expression_or_class()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      integer :: rc, status

      call reset_callback_registry_for_testing()
      call register_callback_interface('toy_members_combo', iface, expected_id, _RC)

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {typekind: R4, callback_interface: toy_members_combo, ' // &
           "members: {arg1: {}}, expression: 'A+B'}" // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised('"members:" cannot be combined with "expression:" on the same item')
      ! to_itemtype's own call site and parse_var_specs's own call site
      ! each pass the failure up (two more _RC levels).
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
      call ESMF_HConfigDestroy(config, _RC)

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {typekind: R4, callback_interface: toy_members_combo, ' // &
           'members: {arg1: {}}, class: field}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised('"members:" cannot be combined with "class:" on the same item')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
      call ESMF_HConfigDestroy(config, _RC)

      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_rejects_members_plus_expression_or_class

   ! `provides:`/`receives:` on an Invoker
   ! callback IMPORT: each resolves to a VariableSpec%callback_provides/
   ! callback_receives entry (argument name -> this Invoker's own item
   ! short name), readable back via StringStringMap%at. Item-name
   ! validity against the Invoker's own items is GraphBuilder's job, not
   ! the parser's - only the argument name is checked here, against the
   ! declared interface.
   @test
   subroutine test_parse_var_specs_accepts_provides_and_receives()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: var_spec
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      character(:), pointer :: item_name
      integer :: rc, status

      call reset_callback_registry_for_testing()
      call iface%declare_argument('quantity', MAPL_VARIANT_FIELD, dims='xy', _RC)
      call register_callback_interface('toy_provides_receives', iface, expected_id, _RC)

      config = ESMF_HConfigCreate(content='{states: {import: {' // &
           'cb: {callback_interface: toy_provides_receives, ' // &
           'provides: {quantity: provide_item}, receives: {quantity: receive_item}}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, var_specs%size())

      iter = var_specs%ftn_begin()
      call iter%next()
      var_spec => iter%of()
      @assertEqual(1, var_spec%callback_provides%size())
      item_name => var_spec%callback_provides%at('quantity')
      @assertTrue(associated(item_name))
      @assertEqual('provide_item', item_name)
      @assertEqual(1, var_spec%callback_receives%size())
      item_name => var_spec%callback_receives%at('quantity')
      @assertTrue(associated(item_name))
      @assertEqual('receive_item', item_name)

      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_accepts_provides_and_receives

   ! `provides:` on an EXPORT (even one declaring `callback_interface:`,
   ! the Handler role) is rejected: `provides:`/`receives:` are restricted
   ! to an Invoker callback IMPORT.
   @test
   subroutine test_parse_var_specs_rejects_provides_not_on_import()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      integer :: rc, status
      character(*), parameter :: expected = &
           '"provides" is only valid on an Invoker callback IMPORT ' // &
           'declaring "callback_interface": cb'

      call reset_callback_registry_for_testing()
      call iface%declare_argument('quantity', MAPL_VARIANT_FIELD, dims='xy', _RC)
      call register_callback_interface('toy_provides_export', iface, expected_id, _RC)

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {typekind: R4, callback_interface: toy_provides_export, ' // &
           'provides: {quantity: provide_item}}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_var_specs's own _RC propagates parse_state_specs's failure.
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_rejects_provides_not_on_import

   ! `receives:` on a plain IMPORT with no `callback_interface:` is the
   ! same is_callback_import gate, hit from the other missing condition.
   @test
   subroutine test_parse_var_specs_rejects_receives_no_callback_interface()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      integer :: rc, status
      character(*), parameter :: expected = &
           '"receives" is only valid on an Invoker callback IMPORT ' // &
           'declaring "callback_interface": cb'

      config = ESMF_HConfigCreate(content='{states: {import: {' // &
           'cb: {typekind: R4, receives: {quantity: receive_item}}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_var_specs's own _RC propagates parse_state_specs's failure.
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_rejects_receives_no_callback_interface

   ! An argument name `provides:`/`receives:` does not declare on the
   ! interface is rejected by parse_callback_provider_map, not silently
   ! accepted (the item-name side, by contrast, is left to GraphBuilder).
   @test
   subroutine test_parse_var_specs_rejects_provides_unknown_argument()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      integer :: rc, status
      character(*), parameter :: expected = &
           '"receives" entry names argument "bogus" ' // &
           'not declared on interface "toy_provides_unknown_arg": cb'

      call reset_callback_registry_for_testing()
      call iface%declare_argument('quantity', MAPL_VARIANT_FIELD, dims='xy', _RC)
      call register_callback_interface('toy_provides_unknown_arg', iface, expected_id, _RC)

      config = ESMF_HConfigCreate(content='{states: {import: {' // &
           'cb: {callback_interface: toy_provides_unknown_arg, ' // &
           'receives: {bogus: receive_item}}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_state_specs's own call site, then parse_var_specs's own call
      ! site, each pass the failure up (two more _RC levels).
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_rejects_provides_unknown_argument

   ! vertical_alignment reaches the VariableSpec as written; omitted stays unallocated.
   @test
   subroutine test_parse_var_specs_vertical_alignment()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: var_spec
      type(VariableSpecVectorIterator) :: iter
      integer :: rc, status, n_up, n_plain

      config = ESMF_HConfigCreate(content='{states: {import: {' // &
           'A: {typekind: R4, vertical_alignment: upward},' // &
           'B: {typekind: R4}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, _RC)
      @assertEqual(2, var_specs%size())

      n_up = 0
      n_plain = 0
      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         do while (iter /= e)
            call iter%next()
            var_spec => iter%of()
            if (var_spec%short_name == 'A') then
               @assertTrue(allocated(var_spec%vertical_alignment))
               @assertEqual('upward', var_spec%vertical_alignment)
               n_up = n_up + 1
            else
               @assertFalse(allocated(var_spec%vertical_alignment))
               n_plain = n_plain + 1
            end if
         end do
      end associate
      @assertEqual(1, n_up)
      @assertEqual(1, n_plain)

      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_vertical_alignment

   @test
   subroutine test_equal_child_spec_ss_differs()
      class(UserSetServices), allocatable :: ss_A
      class(UserSetServices), allocatable :: ss_B

      type(ChildSpec) :: cs_a, cs_b
      ss_A = DsoSetServices('libA', 'setservices_')
      ss_B = ProcSetServices(gamma)

      cs_a = ChildSpec(ss_A)
      cs_b = ChildSpec(ss_B)

      @assert_that('OPERATOR(==)', cs_a == cs_b, is(false()))

   contains
      subroutine gamma(gc, rc)
         use esmf
         type(ESMF_GridComp) :: gc
         integer, intent(out) :: rc
      end subroutine gamma
      
   end subroutine test_equal_child_spec_ss_differs

   @test
   subroutine test_equal_child_spec_cfg_differs()
      class(UserSetServices), allocatable :: ss

      type(ChildSpec) :: a, b
      
      ss = DsoSetServices('libA', 'setservices_')

      a = ChildSpec(ss, hconfig=ESMF_HConfigCreate(content='{a: 5}'))

      b = ChildSpec(ss)
      @assert_that(a == b, is(false()))

      b = ChildSpec(ss, hconfig=ESMF_HConfigCreate(content='{b: 7}'))
      @assert_that(a == b, is(false()))

      b = ChildSpec(ss)
      @assert_that(a == b, is(false()))

      b = ChildSpec(ss, hconfig=ESMF_HConfigCreate(content='{b: 7}'))
      @assert_that(a == b, is(false()))
          

   contains
      subroutine gamma(gc, rc)
         use esmf
         type(ESMF_GridComp) :: gc
         integer, intent(out) :: rc
      end subroutine gamma
      
   end subroutine test_equal_child_spec_cfg_differs

   @test
