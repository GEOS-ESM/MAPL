#if defined(MAKE_MESSAGE)
#  undef MAKE_MESSAGE
#endif
#define MAKE_MESSAGE(V) 'Actual ' // V // ' does not match ' // V // '.'

#include "MAPL_ErrLog.h"
module Test_ComponentSpecParser
   use funit
   use mapl_ComponentSpec_mod
   use mapl_StateItem_mod
   use mapl_StateRegistry_mod
   use mapl_UserSetServices_mod
   use mapl_ComponentSpecParser_mod
   use mapl_ChildSpec_mod
   use mapl_ChildSpecMap_mod
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_QuantityType_mod, only: QUANTITY_UNKNOWN, QUANTITY_TEMPERATURE, &
        QUANTITY_MIXING_RATIO, operator(==)
   use mapl_VariableSpecVector_mod, only: VariableSpecVector, VariableSpecVectorIterator, operator(/=)
   use mapl_CallbackInterfaceId_mod, only: CallbackInterfaceId, operator(==)
   use mapl_CallbackInterface_mod, only: CallbackInterface
   use mapl_CallbackInterfaceRegistry_mod, only: register_callback_interface, &
        reset_callback_registry_for_testing
   ! Renamed on import: mapl_StateItem_mod's own MAPL_STATEITEM_FIELDBUNDLE
   ! (an ESMF_StateItem_Flag) already in scope is a different type than
   ! CallbackInterface%declare_argument's expected_kind argument.
   use mapl_StateItemFlag_mod, only: MAPL_VARIANT_FIELDBUNDLE => MAPL_STATEITEM_FIELDBUNDLE, &
        MAPL_VARIANT_FIELD => MAPL_STATEITEM_FIELD
   use gFTL2_StringVector, only: StringVector
   use mapl_ErrorHandling_mod
   use mapl_Connection_mod
   use mapl_ConnectionPt_mod
   use mapl_ConnectionVector_mod
   use mapl_SimpleConnection_mod
   use mapl_MatchConnection_mod
   use mapl_ReexportConnection_mod
   use esmf
   implicit none(type,external)

contains


   ! setServices:
   !      sharedObj: <dso_name>
   !      userRoutine: <user_routine>  
   @test
   subroutine test_parse_setServices()
      type(ESMF_HConfig) :: config
      class(DsoSetServices), allocatable :: ss_expected

      config = ESMF_HConfigCreate(content='{sharedObj: libA, userRoutine: procB}')

      ss_expected = DsoSetServices('libA', 'procB')
      @assert_that(parse_setservices(config) == ss_expected, is(true()))
      
   end subroutine test_parse_setServices

   @test
   subroutine test_parse_setServices_default()
      type(ESMF_HConfig) :: config
      class(DsoSetServices), allocatable :: ss_expected

      config = ESMF_HConfigCreate(content='{sharedObj: libA}')

      ss_expected = DsoSetServices('libA', 'setservices_')
      @assert_that(parse_setservices(config) == ss_expected, is(true()))
      
   end subroutine test_parse_setServices_default

   @test
   subroutine test_parse_component_spec_setServices()
      type(ESMF_HConfig) :: config
      type(ComponentSpec) :: spec
      type(StateRegistry) :: registry
      class(DsoSetServices), allocatable :: ss_expected
      integer :: rc, status

      config = ESMF_HConfigCreate(content='{mapl: {setServices: {sharedObj: libA}}}')

      ss_expected = DsoSetServices('libA', 'setservices_')
      call parse_component_spec(config, registry, 'TEST', spec, _RC)
      @assert_that(allocated(spec%setservices), is(true()))
      @assert_that(spec%setservices == ss_expected, is(true()))

   end subroutine test_parse_component_spec_setServices

   ! Iterates %members because only iteration follows the parent
   ! pointers a shallow vector copy leaves dangling; reliable detection
   ! needs an allocator checker such as Guard Malloc.
   @test
   subroutine test_parse_component_spec_multi_member_members_intact()
      type(ESMF_HConfig) :: config
      type(ComponentSpec) :: spec
      type(StateRegistry) :: registry
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      type(VariableSpec), pointer :: var_spec
      type(VariableSpecVectorIterator) :: iter
      type(StringVector) :: member_names
      integer :: rc, status
      logical :: has_alpha, has_beta

      call reset_callback_registry_for_testing()
      call register_callback_interface('toy_multi_member_regress', iface, &
           expected_id, _RC)

      config = ESMF_HConfigCreate(content='{mapl: {states: {export: {' // &
           'cb: {typekind: R4, ' // &
           'callback_interface: toy_multi_member_regress, ' // &
           'members: {alpha: {}, beta: {}}}' // &
           '}}}}', _RC)
      call parse_component_spec(config, registry, 'TEST', spec, _RC)
      @assertEqual(1, spec%var_specs%size())

      iter = spec%var_specs%ftn_begin()
      call iter%next()
      var_spec => iter%of()

      member_names = var_spec%get_member_names()
      @assertEqual(2, member_names%size())
      has_alpha = .false.
      has_beta = .false.
      if (member_names%size() >= 1) has_alpha = (member_names%of(1) == 'alpha')
      if (member_names%size() >= 2) has_beta = (member_names%of(2) == 'beta')
      @assertTrue(has_alpha)
      @assertTrue(has_beta)

      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_component_spec_multi_member_members_intact

   ! geometry_mirror: true marks an import to adopt the connected export's
   ! geometry; an item that omits it does not.
   @test
   subroutine test_parse_var_specs_geometry_mirror()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: var_spec
      type(VariableSpecVectorIterator) :: iter
      integer :: rc, status, n_mirror, n_plain

      config = ESMF_HConfigCreate(content='{states: {import: {' // &
           'A: {typekind: R4, geometry_mirror: true},' // &
           'B: {typekind: R4}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, _RC)
      @assertEqual(2, var_specs%size())

      n_mirror = 0
      n_plain = 0
      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         do while (iter /= e)
            call iter%next()
            var_spec => iter%of()
            if (var_spec%short_name == 'A') then
               @assertTrue(var_spec%mirror_geom)
               n_mirror = n_mirror + 1
            else
               @assertFalse(var_spec%mirror_geom)
               n_plain = n_plain + 1
            end if
         end do
      end associate
      @assertEqual(1, n_mirror)
      @assertEqual(1, n_plain)

      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_geometry_mirror

   ! non_negative: {fill: column} sets the fill method; an item that omits it
   ! has none.
   @test
   subroutine test_parse_var_specs_non_negative()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: var_spec
      type(VariableSpecVectorIterator) :: iter
      integer :: rc, status

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'A: {typekind: R4, non_negative: {fill: column}},' // &
           'B: {typekind: R4}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, _RC)
      @assertEqual(2, var_specs%size())

      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         do while (iter /= e)
            call iter%next()
            var_spec => iter%of()
            if (var_spec%short_name == 'A') then
               @assertTrue(allocated(var_spec%non_negative))
               @assertEqual('column', var_spec%non_negative)
            else
               @assertFalse(allocated(var_spec%non_negative))
            end if
         end do
      end associate

      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_non_negative

   ! A non_negative value that is not a map with only a scalar fill key is
   ! rejected: no map, a sequence fill, or an extra key.
   @test
   subroutine test_parse_var_specs_non_negative_needs_fill()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      character(64) :: values(3)
      integer :: rc, status, i

      values(1) = 'true'
      values(2) = '{fill: [column]}'
      values(3) = '{fill: column, extra: 1}'
      do i = 1, size(values)
         config = ESMF_HConfigCreate(content='{states: {export: {' // &
              'A: {typekind: R4, non_negative: ' // trim(values(i)) // '}}}}', _RC)
         call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
         @assertExceptionRaised('non_negative must be a map with only a scalar fill key, e.g. {fill: column}')
         @assertExceptionRaised('status=1')
         @assertExceptionRaised('status=1')
         @assertEqual(1, status)
         call ESMF_HConfigDestroy(config, _RC)
      end do
   end subroutine test_parse_var_specs_non_negative_needs_fill

   ! A mirror request on an internal is rejected by make_VariableSpec, which
   ! the parser calls; an import with the same request is accepted.
   @test
   subroutine test_parse_var_specs_rejects_mirror_on_internal()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      integer :: rc, status

      config = ESMF_HConfigCreate(content='{states: {internal: {' // &
           'A: {typekind: mirror}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: A')
      ! parse_state_specs and parse_var_specs each pass the failure up
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
      call ESMF_HConfigDestroy(config, _RC)

      config = ESMF_HConfigCreate(content='{states: {import: {' // &
           'A: {typekind: mirror}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, _RC)
      @assertEqual(1, var_specs%size())
      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_rejects_mirror_on_internal

   ! An `expression` key makes the item an EXPRESSION whatever the block, so
   ! the parser itself does not stop one under import or internal; the intent
   ! rule in make_VariableSpec does.
   @test
   subroutine test_parse_var_specs_rejects_expression_on_import_and_internal()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      integer :: rc, status

      config = ESMF_HConfigCreate(content='{states: {import: {' // &
           'E: {expression: "A + B"}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised('an expression is only valid on an export: E')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
      call ESMF_HConfigDestroy(config, _RC)

      config = ESMF_HConfigCreate(content='{states: {internal: {' // &
           'E: {expression: "A + B"}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised('an expression is only valid on an export: E')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
      call ESMF_HConfigDestroy(config, _RC)

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'E: {expression: "A + B"}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, _RC)
      @assertEqual(1, var_specs%size())
      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_rejects_expression_on_import_and_internal

   ! vertical_grid_mirror: true marks an import to adopt the connected
   ! export's vertical grid; an item that omits it does not.
   @test
   subroutine test_parse_var_specs_vertical_grid_mirror()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: var_spec
      type(VariableSpecVectorIterator) :: iter
      integer :: rc, status, n_mirror, n_plain

      config = ESMF_HConfigCreate(content='{states: {import: {' // &
           'A: {typekind: R4, vertical_grid_mirror: true},' // &
           'B: {typekind: R4}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, _RC)
      @assertEqual(2, var_specs%size())

      n_mirror = 0
      n_plain = 0
      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         do while (iter /= e)
            call iter%next()
            var_spec => iter%of()
            if (var_spec%short_name == 'A') then
               @assertTrue(var_spec%mirror_vgrid)
               n_mirror = n_mirror + 1
            else
               @assertFalse(var_spec%mirror_vgrid)
               n_plain = n_plain + 1
            end if
         end do
      end associate
      @assertEqual(1, n_mirror)
      @assertEqual(1, n_plain)

      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_vertical_grid_mirror

   ! "<mirror>" for standard_name or long_name sets the mirror flag and is not
   ! stored; an item that omits it keeps its declared values.
   @test
   subroutine test_parse_var_specs_string_mirror()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: var_spec
      type(VariableSpecVectorIterator) :: iter
      integer :: rc, status, n_seen

      config = ESMF_HConfigCreate(content='{states: {import: {' // &
           'A: {typekind: R4, standard_name: "<mirror>", ' // &
           'long_name: "<mirror>"},' // &
           'B: {typekind: R4, standard_name: foo, long_name: Bar}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, _RC)
      @assertEqual(2, var_specs%size())

      n_seen = 0
      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         do while (iter /= e)
            call iter%next()
            var_spec => iter%of()
            n_seen = n_seen + 1
            if (var_spec%short_name == 'A') then
               @assertTrue(var_spec%standard_name_mirror)
               @assertTrue(var_spec%long_name_mirror)
               @assertFalse(allocated(var_spec%standard_name))
               @assertFalse(allocated(var_spec%long_name))
            else
               @assertFalse(var_spec%standard_name_mirror)
               @assertFalse(var_spec%long_name_mirror)
               @assertEqual('foo', var_spec%standard_name)
               @assertEqual('Bar', var_spec%long_name)
            end if
         end do
      end associate
      @assertEqual(2, n_seen)

      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_string_mirror

   ! quantity_type takes the full QuantityType name, case-folded; omitted
   ! stays QUANTITY_UNKNOWN.
   @test
   subroutine test_parse_var_specs_quantity_type()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: var_spec
      type(VariableSpecVectorIterator) :: iter
      integer :: rc, status, n_seen

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'A: {quantity_type: QUANTITY_TEMPERATURE},' // &
           'B: {quantity_type: Quantity_Mixing_Ratio},' // &
           'C: {quantity_type: quantity_unknown},' // &
           'D: {typekind: R4}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, _RC)
      @assertEqual(4, var_specs%size())

      n_seen = 0
      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         do while (iter /= e)
            call iter%next()
            var_spec => iter%of()
            n_seen = n_seen + 1
            select case (var_spec%short_name)
            case ('A')
               @assertTrue(var_spec%quantity_type == QUANTITY_TEMPERATURE)
            case ('B')
               @assertTrue(var_spec%quantity_type == QUANTITY_MIXING_RATIO)
            case default
               @assertTrue(var_spec%quantity_type == QUANTITY_UNKNOWN)
            end select
         end do
      end associate
      @assertEqual(4, n_seen)

      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_quantity_type

   ! An unknown value, including a short spelling, is an error.
   @test
   subroutine test_parse_var_specs_rejects_unknown_quantity_type()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      integer :: rc, status

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'A: {quantity_type: temperature}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised('Unsupported quantity_type: <temperature>')
      ! parse_state_specs and parse_var_specs each pass it up
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_rejects_unknown_quantity_type

   ! callback_interface: <name> resolves through CallbackInterfaceRegistry to
   ! the registered CallbackInterfaceId, on both an import (callback
   ! consumer role) and an export (Handler role; this uses an ordinary
   ! FIELD export, not a `members:`-bearing composite, since the key's own
   ! resolution does not depend on itemType); an item that omits the key
   ! keeps an invalid (unset) callback_interface_id.
   @test
   subroutine test_parse_var_specs_callback_interface()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: var_spec
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      integer :: rc, status, n_seen

      call reset_callback_registry_for_testing()
      call register_callback_interface('toy_scaling', iface, expected_id, _RC)

      config = ESMF_HConfigCreate(content='{states: {' // &
           'import: {A: {callback_interface: toy_scaling}, B: {typekind: R4}}, ' // &
           'export: {C: {typekind: R4, callback_interface: toy_scaling}}' // &
           '}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, _RC)
      @assertEqual(3, var_specs%size())

      n_seen = 0
      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         do while (iter /= e)
            call iter%next()
            var_spec => iter%of()
            n_seen = n_seen + 1
            select case (var_spec%short_name)
            case ('A', 'C')
               @assertTrue(var_spec%callback_interface_id%is_valid())
               @assertTrue(var_spec%callback_interface_id == expected_id)
            case default
               @assertFalse(var_spec%callback_interface_id%is_valid())
            end select
         end do
      end associate
      @assertEqual(3, n_seen)

      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_callback_interface

   ! A callback_interface name that CallbackInterfaceRegistry does not
   ! recognize is the registry's own unregistered-name error.
   @test
   subroutine test_parse_var_specs_rejects_unregistered_callback_interface()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      integer :: rc, status
      character(*), parameter :: expected = &
           'CallbackInterfaceRegistry: lookup_callback_interface_id - ' // &
           "service name 'no_such_interface' not registered; registered: (none)"

      call reset_callback_registry_for_testing()

      config = ESMF_HConfigCreate(content='{states: {import: {' // &
           'A: {callback_interface: no_such_interface}}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! make_VariableSpec, parse_state_specs and parse_var_specs each pass it up
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_rejects_unregistered_callback_interface

   ! `alias: <name>` is only valid inside a `members:` entry (parsed by
   ! parse_var_specs's own parse_callback_members, not at this top level);
   ! a top-level state item using it is a hard error.
   @test
   subroutine test_parse_var_specs_rejects_top_level_callback_member_alias()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      integer :: rc, status
      character(*), parameter :: expected = &
           '"alias" is only valid inside a "members" ' // &
           'entry, not a top-level state item: tracer'

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'tracer: {typekind: R4, alias: TR1}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_var_specs's own _RC propagates parse_state_specs's failure.
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_rejects_top_level_callback_member_alias

   ! A one-entry map value for `units:` (`units: {U: 'kg kg-1'}`) is a
   ! unit placeholder binding, only valid inside a `members:` entry; a
   ! top-level state item using it is a hard error.
   @test
   subroutine test_parse_var_specs_rejects_top_level_unit_placeholder_binding()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      integer :: rc, status
      character(*), parameter :: expected = &
           'a unit-placeholder binding ({Placeholder: ConcreteUnit}) is only ' // &
           'valid inside a "members" entry, not a top-level state item: bound'

      config = ESMF_HConfigCreate(content="{states: {export: {" // &
           "bound: {typekind: R4, units: {U: 'kg kg-1'}}" // &
           "}}}", _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_var_specs's own _RC propagates parse_state_specs's failure.
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_rejects_top_level_unit_placeholder_binding

   ! `members:` is only valid on a Handler callback-State EXPORT (one
   ! declaring `callback_interface:`); on a plain export with no
   ! `callback_interface:` it is the same hard error as a bare top-level
   ! `alias:`/unit-placeholder `units:`.
   @test
   subroutine test_parse_var_specs_rejects_members_without_callback_interface()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      integer :: rc, status
      character(*), parameter :: expected = &
           '"members" is only valid on a Handler callback-State EXPORT ' // &
           'declaring "callback_interface": cb'

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {typekind: R4, members: {arg1: {}}}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_var_specs's own _RC propagates parse_state_specs's failure.
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
   end subroutine test_parse_var_specs_rejects_members_without_callback_interface

   ! A `members:` entry carries only `alias`/`units`/`dims`/
   ! `vertical_dim_spec`/`vertical_grid` (parse_var_specs.F90's
   ! parse_callback_members); any other key is a hard parse error.
   @test
   subroutine test_parse_var_specs_rejects_unsupported_member_key()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      integer :: rc, status
      character(*), parameter :: expected = &
           '"members" entry "arg1" has unsupported key "typekind": a YAML member ' // &
           'supports only "alias", "units", "dims", "vertical_dim_spec", and "vertical_grid"'

      call reset_callback_registry_for_testing()
      call register_callback_interface('toy_members_unsupported_key', iface, expected_id, _RC)

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {typekind: R4, callback_interface: toy_members_unsupported_key, ' // &
           'members: {arg1: {typekind: R8}}}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_callback_members's own call site and parse_var_specs's own
      ! call site each pass the failure up (two more _RC levels).
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_rejects_unsupported_member_key

   ! A `members:` entry is never part of the IMPORT/EXPORT
   ! connection-resolution graph a flat top-level item can be, so
   ! "vertical_dim_spec: mirror" has no partner to mirror from and is a
   ! hard parse error (parse_var_specs.F90's parse_callback_members).
   @test
   subroutine test_parse_var_specs_rejects_member_vertical_stagger_mirror()
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: expected_id
      integer :: rc, status
      character(*), parameter :: expected = &
           '"members" entry "arg1" cannot use "vertical_dim_spec: mirror": a member ' // &
           'is never part of the IMPORT/EXPORT connection-resolution graph, so there is no partner ' // &
           'to mirror from'

      call reset_callback_registry_for_testing()
      call register_callback_interface('toy_members_vertical_mirror', iface, expected_id, _RC)

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {typekind: R4, callback_interface: toy_members_vertical_mirror, ' // &
           'members: {arg1: {vertical_dim_spec: mirror}}}' // &
           '}}}', _RC)
      call parse_var_specs(config, registry, 'TEST', var_specs, rc=status)
      @assertExceptionRaised(expected)
      ! parse_callback_members's own call site and parse_var_specs's own
      ! call site each pass the failure up (two more _RC levels).
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)

      call ESMF_HConfigDestroy(config, _RC)
      call reset_callback_registry_for_testing()
   end subroutine test_parse_var_specs_rejects_member_vertical_stagger_mirror

   ! Same reasoning as the vertical_dim_spec case, for "dims: mirror" on
