#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! Side-by-side equivalence check between the existing imperative coupler and
! GraphBuilder's ordinary connection resolution, on a real (non-synthetic,
! DSO-backed, full ESMF Initialize lifecycle) MAPL configuration -
! scenarios/graphbuilder_equivalence/.
!
! Scope note: GraphBuilder reads each component's own ComponentSpec%var_specs
! directly, not StateRegistry's cross-level
! propagate_exports/propagate_unsatisfied_imports view. Every existing
! connect_all-based scenario fixture under scenarios/ (statistics,
! statistics_real, history_1, history_wildcard, extdata_1) connects two
! components whose real items actually live on a *grandchild* and only become
! visible on the connected components via that propagation machinery, which
! ordinary connection resolution does not see. This fixture is therefore
! deliberately flat:
! comp_src/comp_dst are direct children of cap and declare their own
! export/import directly, with no further nesting - the case GraphBuilder's
! ordinary resolution is actually scoped to handle.
module Test_GraphBuilderEquivalence

   use mapl_Generic_mod
   use mapl_GenericPhases_mod
   use mapl_MultiState_mod
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod, only: item_key
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetwork_mod, only: DependencyNetwork
   use mapl_NodeId_mod, only: NodeId
   use mapl_NodeIdSet_mod, only: NodeIdSet, NodeIdSetIterator, operator(/=)
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem, operator(==)
   use mapl_StateItemMemberMap_mod, only: StateItemMemberMap
   use mapl_ExtensionResolution_mod, only: set_materialize_extensions
   use mapl_GraphMode_mod, only: set_graph_mode, GRAPH_MODE_BOTH, GRAPH_MODE_REGISTRY
   use mapl_FieldGet_mod, only: FieldGet
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_Generic_api, only: mapl_GridCompCreate, mapl_GenericSetServices
   use mapl_GraphScenarioBootstrap_mod, only: build_scenario_tree
   use esmf
   use nuopc
   use pfunit
   implicit none(type, external)

contains

   ! Test-only helper (mirrors Test_GraphBuilder.pf's own private copy):
   ! the extension chain's final item is the sole predecessor of the
   ! import proxy (GraphBuilder.F90's own resolve_one, its last
   ! add_dependency call).
   function single_predecessor(net, node) result(pred_id)
      type(DependencyNetwork), intent(in) :: net
      type(NodeId), intent(in) :: node
      type(NodeId) :: pred_id

      type(NodeIdSet), target :: preds
      type(NodeIdSetIterator) :: iter

      preds = net%get_predecessors(node)
      iter = preds%ftn_begin()
      call iter%next()
      pred_id = iter%of()
   end function single_predecessor

   ! Real (DSO-backed) end-to-end run of scenarios/graphbuilder_equivalence,
   ! mirroring Test_Scenarios.pf's own Scenario%setup for the
   ! advertise/modify_advertised/realize init-phase sequence (no run
   ! phases needed - this only checks wiring, not run-time values).
   @test(npes=[0])
   subroutine test_ordinary_resolution_matches_legacy_coupler(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_HConfig) :: config
      type(ESMF_Config) :: config_cf
      type(ESMF_GridComp) :: cap_gc
      type(ESMF_State) :: importState, exportState
      type(ESMF_Clock) :: clock
      type(ESMF_Time) :: t0, t1
      type(ESMF_TimeInterval) :: dt
      integer :: status, user_status, i

      type(OuterMetaComponent), pointer :: cap_meta, src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(GriddedComponentDriver) :: dst_user_driver
      type(MultiState) :: dst_user_states
      type(ESMF_State) :: dst_import_state
      type(ESMF_Field) :: field

      type(ComponentGraph), pointer :: cap_graph, src_graph, dst_graph
      type(NodeId), pointer :: t_export_id, t_import_id
      type(DependencyNetwork), pointer :: net

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      config = ESMF_HConfigCreate(filename='./scenarios/graphbuilder_equivalence/cap.yaml', _RC)
      config_cf = ESMF_ConfigCreate(hconfig=config, _RC)
      cap_gc = ESMF_GridCompCreate(name='CAP', config=config_cf, _RC)
      call ESMF_GridCompSetServices(cap_gc, mapl_GenericSetservices, userRC=user_status, _RC)
      @assert_that(user_status, is(0))

      call ESMF_TimeSet(t0, timeString="2000-04-03T21:00:00", _RC)
      call ESMF_TimeSet(t1, timeString="2000-04-03T22:00:00", _RC)
      call ESMF_TimeIntervalSet(dt, h=1)
      clock = ESMF_ClockCreate(timestep=dt, startTime=t0, stoptime=t1, refTime=t0, _RC)

      importState = ESMF_StateCreate(_RC)
      exportState = ESMF_StateCreate(_RC)

      do i = 1, size(GENERIC_INIT_PHASE_SEQUENCE)
         associate (phase => GENERIC_INIT_PHASE_SEQUENCE(i))
            call ESMF_GridCompInitialize(cap_gc, &
                 importState=importState, exportState=exportState, clock=clock, &
                 phase=phase, userRC=user_status, _RC)
            @assert_that(user_status, is(0))
         end associate
      end do

      ! --- Legacy-coupler oracle: the real ESMF import state on comp_dst
      ! actually contains field "T", proving the existing imperative
      ! coupler (connect_all/MatchConnection/StateRegistry_Actions_smod)
      ! resolved this connection. ---
      cap_meta => get_outer_meta(cap_gc, _RC)
      dst_driver = cap_meta%get_child('comp_dst', _RC)
      dst_gc = dst_driver%get_gridcomp()
      dst_meta => get_outer_meta(dst_gc, _RC)
      dst_user_driver = dst_meta%get_user_gc_driver()
      dst_user_states = dst_user_driver%get_states()
      call dst_user_states%get_state(dst_import_state, 'import', _RC)
      call ESMF_StateGet(dst_import_state, 'T', field, _RC)
      @assert_that(ESMF_FieldIsCreated(field), is(true()))

      ! --- GraphBuilder's own resolution reaches the same conclusion:
      ! a dependency edge exists, in the forward network,
      ! directly between comp_src's own real export NodeId and
      ! comp_dst's own real import NodeId (no parent-local
      ! proxy exists anymore). ---
      src_driver = cap_meta%get_child('comp_src', _RC)
      src_gc = src_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)

      cap_graph => cap_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      net => cap_graph%get_network(cap_graph%get_forward_network_id())
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(true()))

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(src_meta)
   end subroutine test_ordinary_resolution_matches_legacy_coupler


   ! Side-by-side equivalence check on a real (DSO-backed) mismatched
   ! configuration - scenarios/graphbuilder_equivalence_units/ is identical to
   ! graphbuilder_equivalence/ except comp_src exports T in 'm' and comp_dst
   ! imports T in 'km' (a genuine, convertible units mismatch, resolved by the
   ! units characteristic, which has a real, executing provider). Legacy
   ! oracle: the existing imperative coupler (SimpleConnection%connect_sibling
   ! -> StateRegistry%extend -> ExtensionFamily/ConvertUnitsTransform) still
   ! resolves this into a real ESMF field on comp_dst's import, same as the
   ! exact-match fixture. GraphBuilder's own resolution must NOT reduce to the
   ! same direct edge the exact-match case produces - it must interpose a real
   ! TransformGraphNode (an extension chain) instead.
   @test(npes=[0])
   subroutine test_units_mismatch_resolution_matches_legacy_coupler(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_HConfig) :: config
      type(ESMF_Config) :: config_cf
      type(ESMF_GridComp) :: cap_gc
      type(ESMF_State) :: importState, exportState
      type(ESMF_Clock) :: clock
      type(ESMF_Time) :: t0, t1
      type(ESMF_TimeInterval) :: dt
      integer :: status, user_status, i

      type(OuterMetaComponent), pointer :: cap_meta, src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(GriddedComponentDriver) :: dst_user_driver
      type(MultiState) :: dst_user_states
      type(ESMF_State) :: dst_import_state
      type(ESMF_Field) :: field

      type(ComponentGraph), pointer :: cap_graph, src_graph, dst_graph
      type(NodeId), pointer :: t_export_id, t_import_id
      type(NodeId) :: extension_id
      type(DependencyNetwork), pointer :: net
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: extension_payload
      type(ESMF_Field) :: extension_field
      type(ESMF_TypeKind_Flag) :: got_typekind
      character(:), allocatable :: got_units

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      config = ESMF_HConfigCreate(filename='./scenarios/graphbuilder_equivalence_units/cap.yaml', _RC)
      config_cf = ESMF_ConfigCreate(hconfig=config, _RC)
      cap_gc = ESMF_GridCompCreate(name='CAP', config=config_cf, _RC)
      call ESMF_GridCompSetServices(cap_gc, mapl_GenericSetservices, userRC=user_status, _RC)
      @assert_that(user_status, is(0))

      call ESMF_TimeSet(t0, timeString="2000-04-03T21:00:00", _RC)
      call ESMF_TimeSet(t1, timeString="2000-04-03T22:00:00", _RC)
      call ESMF_TimeIntervalSet(dt, h=1)
      clock = ESMF_ClockCreate(timestep=dt, startTime=t0, stoptime=t1, refTime=t0, _RC)

      importState = ESMF_StateCreate(_RC)
      exportState = ESMF_StateCreate(_RC)

      ! Gate enabled for this fixture's own real (DSO-backed) init sequence:
      ! GraphBuilder's own extension chain (built during
      ! GENERIC_INIT_ACCEPT_TRANSFER, inside this phase loop) should also get a
      ! real, correctly-shaped field, decision parity with the legacy oracle
      ! above. comp_src geom/vertical_grid here come from the real geometry
      ! section of cap, propagated down via propagate_geom_to_children, not an
      ! explicit per-VariableSpec override - the common-case path, exercised
      ! end-to-end by this fixture.
      call set_materialize_extensions(.true.)

      do i = 1, size(GENERIC_INIT_PHASE_SEQUENCE)
         associate (phase => GENERIC_INIT_PHASE_SEQUENCE(i))
            call ESMF_GridCompInitialize(cap_gc, &
                 importState=importState, exportState=exportState, clock=clock, &
                 phase=phase, userRC=user_status, _RC)
            @assert_that(user_status, is(0))
         end associate
      end do

      call set_materialize_extensions(.false.)

      ! --- Legacy-coupler oracle: still resolves the mismatched
      ! connection to a real ESMF field on comp_dst's import, via the
      ! ExtensionFamily/ConvertUnitsTransform coupler path (not a direct
      ! alias - the two declared units differ). ---
      cap_meta => get_outer_meta(cap_gc, _RC)
      dst_driver = cap_meta%get_child('comp_dst', _RC)
      dst_gc = dst_driver%get_gridcomp()
      dst_meta => get_outer_meta(dst_gc, _RC)
      dst_user_driver = dst_meta%get_user_gc_driver()
      dst_user_states = dst_user_driver%get_states()
      call dst_user_states%get_state(dst_import_state, 'import', _RC)
      call ESMF_StateGet(dst_import_state, 'T', field, _RC)
      @assert_that(ESMF_FieldIsCreated(field), is(true()))

      ! --- GraphBuilder's own resolution: NOT a direct edge between
      ! comp_src's own real export NodeId and comp_dst's own real
      ! import NodeId (spec "Mismatched export and import are wired
      ! through an extension chain") - an extension chain is interposed
      ! instead. (No parent-local proxy exists anymore.) ---
      src_driver = cap_meta%get_child('comp_src', _RC)
      src_gc = src_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)

      cap_graph => cap_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      net => cap_graph%get_network(cap_graph%get_forward_network_id())
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(false()))
      @assert_that(net%has_successors(t_export_id), is(true()))
      @assert_that(net%has_predecessors(t_import_id), is(true()))

      ! The graph-side extension item is real and correctly-shaped (units = the
      ! import's own required 'km') when the gate is enabled - decision parity
      ! with the legacy oracle above, not byte-for-byte field identity with it.
      extension_id = single_predecessor(net, t_import_id)
      node => cap_graph%get_node(extension_id)
      select type (node)
      class is (StateItemNode)
         extension_payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(extension_payload%itemType(rc=status) == ESMF_STATEITEM_FIELD)
      @assertEqual(0, status)

      extension_field = extension_payload%get_field(rc=status)
      @assertEqual(0, status)
      call FieldGet(extension_field, typekind=got_typekind, units=got_units, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R4)
      @assertEqual('km', got_units)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(src_meta)
   end subroutine test_units_mismatch_resolution_matches_legacy_coupler

   ! The same real (DSO-backed) exact-match fixture as
   ! test_ordinary_resolution_matches_legacy_coupler above, run with the
   ! graph mode selected as GRAPH_MODE_BOTH instead of the default
   ! GRAPH_MODE_REGISTRY. Two things must both be true (spec "Both
   ! producers can be compared without a name collision" / "Graph-
   ! materialized value is readable out of band"):
   ! (a) legacy's own real ESMF_State still contains exactly the entries
   !     it would in GRAPH_MODE_REGISTRY - no additional or duplicate
   !     entry leaks in from graph-native materialization;
   ! (b) the export's own proxy node now reports a real, correctly-
   !     shaped field (decision parity with the legacy oracle), readable
   !     directly from the node's own payload, independent of the
   !     shared ESMF_State.
   @test(npes=[0])
   subroutine test_both_mode_materializes_without_legacy_collision(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_HConfig) :: config
      type(ESMF_Config) :: config_cf
      type(ESMF_GridComp) :: cap_gc
      type(ESMF_State) :: importState, exportState
      type(ESMF_Clock) :: clock
      type(ESMF_Time) :: t0, t1
      type(ESMF_TimeInterval) :: dt
      integer :: status, user_status, i

      type(OuterMetaComponent), pointer :: cap_meta, src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(GriddedComponentDriver) :: dst_user_driver
      type(MultiState) :: dst_user_states
      type(ESMF_State) :: dst_import_state
      type(ESMF_Field) :: field
      integer :: item_count

      type(ComponentGraph), pointer :: cap_graph, src_graph, dst_graph
      type(NodeId), pointer :: t_export_id, t_import_id
      type(DependencyNetwork), pointer :: net
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: export_payload
      type(ESMF_Field) :: export_field
      type(ESMF_TypeKind_Flag) :: got_typekind
      character(:), allocatable :: got_units

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      config = ESMF_HConfigCreate(filename='./scenarios/graphbuilder_equivalence/cap.yaml', _RC)
      config_cf = ESMF_ConfigCreate(hconfig=config, _RC)
      cap_gc = ESMF_GridCompCreate(name='CAP_BOTH_MODE', config=config_cf, _RC)
      call ESMF_GridCompSetServices(cap_gc, mapl_GenericSetservices, userRC=user_status, _RC)
      @assert_that(user_status, is(0))

      call ESMF_TimeSet(t0, timeString="2000-04-03T21:00:00", _RC)
      call ESMF_TimeSet(t1, timeString="2000-04-03T22:00:00", _RC)
      call ESMF_TimeIntervalSet(dt, h=1)
      clock = ESMF_ClockCreate(timestep=dt, startTime=t0, stoptime=t1, refTime=t0, _RC)

      importState = ESMF_StateCreate(_RC)
      exportState = ESMF_StateCreate(_RC)

      call set_graph_mode(GRAPH_MODE_BOTH)
      do i = 1, size(GENERIC_INIT_PHASE_SEQUENCE)
         associate (phase => GENERIC_INIT_PHASE_SEQUENCE(i))
            call ESMF_GridCompInitialize(cap_gc, &
                 importState=importState, exportState=exportState, clock=clock, &
                 phase=phase, userRC=user_status, _RC)
            @assert_that(user_status, is(0))
         end associate
      end do
      call set_graph_mode(GRAPH_MODE_REGISTRY)

      ! --- (a) Legacy-coupler oracle, unaffected: same single real
      ! entry on comp_dst's own import state as GRAPH_MODE_REGISTRY
      ! would produce - no graph-native leak into the shared state. ---
      cap_meta => get_outer_meta(cap_gc, _RC)
      dst_driver = cap_meta%get_child('comp_dst', _RC)
      dst_gc = dst_driver%get_gridcomp()
      dst_meta => get_outer_meta(dst_gc, _RC)
      dst_user_driver = dst_meta%get_user_gc_driver()
      dst_user_states = dst_user_driver%get_states()
      call dst_user_states%get_state(dst_import_state, 'import', _RC)
      call ESMF_StateGet(dst_import_state, 'T', field, _RC)
      @assert_that(ESMF_FieldIsCreated(field), is(true()))
      call ESMF_StateGet(dst_import_state, itemCount=item_count, _RC)
      @assertEqual(1, item_count)

      ! --- (b) Graph-native materialization, readable out of band: the
      ! export's own real node (comp_src's own graph - no parent-local
      ! proxy exists anymore) has a real, correctly-shaped
      ! field. ---
      src_driver = cap_meta%get_child('comp_src', _RC)
      src_gc = src_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)

      cap_graph => cap_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      net => cap_graph%get_network(cap_graph%get_forward_network_id())
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(true()))

      node => src_graph%get_node(t_export_id)
      select type (node)
      class is (StateItemNode)
         export_payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(export_payload%itemType(rc=status) == ESMF_STATEITEM_FIELD)

      export_field = export_payload%get_field(rc=status)
      @assertEqual(0, status)
      call FieldGet(export_field, typekind=got_typekind, units=got_units, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R4)
      @assertEqual('barn', got_units)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(src_meta)
   end subroutine test_both_mode_materializes_without_legacy_collision

   ! The real scenarios/statistics_real/ fixture. The module header notes that
   ! GraphBuilder does not see items living on a grandchild behind a
   ! propagation connection; that applies to the CAP-LEVEL connection only
   ! (root -> history, all_unsatisfied: true, a cross-level MatchConnection
   ! whose real items live on a grandchild). The HISTORY-LEVEL connections
   ! (stat -> collection_1, history.yaml has 16 SimpleConnections, each with
   ! src_name /= dst_name, e.g. 'A/TS' -> 'TS_avg') are flat, direct-sibling
   ! SimpleConnections, which GraphBuilder resolves. This test checks the
   ! history local graph, not cap, for that reason.
   @test(npes=[0])
   subroutine test_statistics_real_simple_connections_match_legacy_coupler(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: cap_gc
      type(OuterMetaComponent), pointer :: cap_meta, history_meta, stat_meta, collection_meta
      type(GriddedComponentDriver) :: history_driver, stat_driver, collection_driver
      type(ESMF_GridComp) :: history_gc, stat_gc, collection_gc
      type(GriddedComponentDriver) :: collection_user_driver
      type(MultiState) :: collection_user_states
      type(ESMF_State) :: collection_import_state
      type(ESMF_Field) :: field

      type(ComponentGraph), pointer :: history_graph, stat_graph, collection_graph
      type(NodeId), pointer :: export_id, import_id
      type(DependencyNetwork), pointer :: net
      integer :: status

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      ! GRAPH_MODE_BOTH is deliberately not used here: it triggers an
      ! unrelated crash. The collection_1.yaml imports (e.g. TS_avg) declare
      ! no `units:` at all - legacy tolerates this (its coupler does not
      ! require declared units up front), but the additional materialization
      ! step of GRAPH_MODE_BOTH (try_materialize_field_extension) hard-_ASSERTs
      ! non-empty import units - an internal-consistency check that is CORRECT
      ! for a config declaring units, but wrong to apply to one that never
      ! declared any ("no import units" is a legitimate, legacy-tolerated case
      ! here, not a real inconsistency). This is a materialization-layer gap,
      ! unrelated to connection-type dispatch (it would hit ANY connection type
      ! wiring into a units-less import under GRAPH_MODE_BOTH) - a separate known
      ! gap. This test uses the default GRAPH_MODE_REGISTRY instead, matching
      ! test_ordinary_resolution_matches_legacy_coupler above:
      ! add_dependency (the claim this test actually needs to prove) happens
      ! unconditionally in resolve_one, regardless of graph mode - only the
      ! materialization calls are gated behind graph_mode /=
      ! GRAPH_MODE_REGISTRY, so this test needs no mode change at all to prove
      ! SimpleConnection wiring parity.
      call build_scenario_tree('./scenarios/statistics_real/cap.yaml', cap_gc, cap_meta, _RC)

      ! --- Legacy-coupler oracle: collection_1's own real ESMF import
      ! state actually contains field "TS_avg", proving the existing
      ! imperative coupler (SimpleConnection%connect_sibling ->
      ! StateRegistry%extend) resolved history.yaml's own
      ! 'A/TS'->'TS_avg' SimpleConnection. ---
      history_driver = cap_meta%get_child('history', _RC)
      history_gc = history_driver%get_gridcomp()
      history_meta => get_outer_meta(history_gc, _RC)

      collection_driver = history_meta%get_child('collection_1', _RC)
      collection_gc = collection_driver%get_gridcomp()
      collection_meta => get_outer_meta(collection_gc, _RC)
      collection_user_driver = collection_meta%get_user_gc_driver()
      collection_user_states = collection_user_driver%get_states()
      call collection_user_states%get_state(collection_import_state, 'import', _RC)
      call ESMF_StateGet(collection_import_state, 'TS_avg', field, _RC)
      @assert_that(ESMF_FieldIsCreated(field), is(true()))

      ! --- GraphBuilder's own resolution reaches the same conclusion:
      ! a dependency edge exists, in the forward network,
      ! directly between stat's own real export NodeId ('A/TS') and
      ! collection_1's own real import NodeId ('TS_avg') - no proxy,
      ! src_name /= dst_name resolved correctly (the bug
      ! this exact fixture caught during implementation). ---
      stat_driver = history_meta%get_child('stat', _RC)
      stat_gc = stat_driver%get_gridcomp()
      stat_meta => get_outer_meta(stat_gc, _RC)

      history_graph => history_meta%get_component_graph()
      stat_graph => stat_meta%get_component_graph()
      collection_graph => collection_meta%get_component_graph()
      export_id => stat_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'A/TS'))
      import_id => collection_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'TS_avg'))
      @assert_that(associated(export_id), is(true()))
      @assert_that(associated(import_id), is(true()))

      net => history_graph%get_network(history_graph%get_forward_network_id())
      @assert_that(net%contains_dependency(export_id, import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_statistics_real_simple_connections_match_legacy_coupler

   ! history_wildcard, unlike the other grandchild-nested fixtures of this
   ! module (statistics_real above), IS reachable under GRAPH_MODE_BOTH: the
   ! cap all_unsatisfied connection names root/history directly (not a
   ! grandchild of either), and the single child collection_1 of history is
   ! where the WILDCARD import is advertised - one level of nesting, the shape
   ! that the cross-level mirroring of graphbuilder_run_propagate_hook handles.
   ! The WILDCARD branch of resolve_one reaches it correctly even when the
   ! governing connection is declared on 'cap', two levels above the
   ! advertised import of collection_1.
   ! Unlike test_statistics_real_simple_connections_match_legacy_coupler
   ! above, no units-less-import crash applies here (the 'A/E_A.*' of
   ! collection_1.yaml declares no units either, but the WILDCARD resolution
   ! path, which adds no dependency, never calls
   ! try_materialize_field_extension at all: composite-member fan-in, not a
   ! DependencyNetwork problem) - so GRAPH_MODE_BOTH is safe to use directly
   ! here.
   @test(npes=[0])
   subroutine test_history_wildcard_composite_matches_legacy_coupler(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: cap_gc
      type(OuterMetaComponent), pointer :: cap_meta, history_meta, collection_meta
      type(GriddedComponentDriver) :: history_driver, collection_driver
      type(ESMF_GridComp) :: history_gc, collection_gc
      type(GriddedComponentDriver) :: collection_user_driver
      type(MultiState) :: collection_user_states
      type(ESMF_State) :: collection_import_state
      type(ESMF_Field) :: field

      type(ComponentGraph), pointer :: collection_graph
      type(NodeId), pointer :: import_id
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: payload
      type(StateItemMemberMap), pointer :: members
      type(NodeId), pointer :: member_id
      integer :: status

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      ! GRAPH_MODE_BOTH builds this fixture cleanly end-to-end (no analog of
      ! the units-less-import crash in
      ! test_statistics_real_simple_connections_match_legacy_coupler; the
      ! WILDCARD resolution path never calls try_materialize_field_extension).
      call set_graph_mode(GRAPH_MODE_BOTH)
      call build_scenario_tree('./scenarios/history_wildcard/cap.yaml', cap_gc, cap_meta, _RC)
      call set_graph_mode(GRAPH_MODE_REGISTRY)

      ! --- Legacy-coupler oracle: collection_1's own real ESMF import
      ! state actually contains fields "A/E_A1" and "A/E_A2" (the
      ! WildcardClassAspect's own add_to_state, matched_items populated
      ! by connect_all's own legacy WILDCARD dispatch), alongside the
      ! ordinary "B/E_B2" import - expectations.yaml's own documented
      ! complete/gridset shape. ---
      history_driver = cap_meta%get_child('history', _RC)
      history_gc = history_driver%get_gridcomp()
      history_meta => get_outer_meta(history_gc, _RC)

      collection_driver = history_meta%get_child('collection_1', _RC)
      collection_gc = collection_driver%get_gridcomp()
      collection_meta => get_outer_meta(collection_gc, _RC)
      collection_user_driver = collection_meta%get_user_gc_driver()
      collection_user_states = collection_user_driver%get_states()
      call collection_user_states%get_state(collection_import_state, 'import', _RC)

      call ESMF_StateGet(collection_import_state, 'A/E_A1', field, _RC)
      @assert_that(ESMF_FieldIsCreated(field), is(true()))
      call ESMF_StateGet(collection_import_state, 'A/E_A2', field, _RC)
      @assert_that(ESMF_FieldIsCreated(field), is(true()))
      call ESMF_StateGet(collection_import_state, 'B/E_B2', field, _RC)
      @assert_that(ESMF_FieldIsCreated(field), is(true()))

      ! --- GraphBuilder's own resolution reaches the same conclusion:
      ! the WILDCARD import's own already-advertised NodeId now reports
      ! itemType() == ESMF_STATEITEM_STATE, with exactly one composite
      ! member per legacy-coupler-matched export, bound to that
      ! export's own real NodeId (resolve_wildcard_destination) - one-for-one
      ! with the two matched-wildcard fields of the legacy oracle above
      ! (B/E_B2 is an ordinary import, not part of the wildcard's own
      ! composite membership - not asserted here). ---
      collection_graph => collection_meta%get_component_graph()
      import_id => collection_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'A/E_A.*'))
      @assert_that(associated(import_id), is(true()))

      node => collection_graph%get_node(import_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select

      @assertTrue(payload%itemType(rc=status) == ESMF_STATEITEM_STATE)
      @assert_that(status, is(0))

      members => payload%state_members_ptr()
      @assertEqual(2, members%size())

      member_id => members%at('A/E_A1')
      @assert_that(associated(member_id), is(true()))
      member_id => members%at('A/E_A2')
      @assert_that(associated(member_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_history_wildcard_composite_matches_legacy_coupler

end module Test_GraphBuilderEquivalence
