#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! openspec/changes/graph-child-state-population, tasks.md 5.1-5.3:
! demonstration that GRAPH_MODE_GRAPH, after this change's own fix to
! graphbuilder_populate_state's cross-component loop, can be the SOLE
! real producer of a sibling-to-sibling connection's real ESMF_State -
! with a real extension-chain transform (UnitsConverterTransform)
! actually firing, and StateRegistry's own add_to_states never called
! for either child (initialize_accept_transfer.F90's own existing
! `if (graph_mode() /= GRAPH_MODE_GRAPH)` guard, confirmed by direct
! reading, not new production code).
!
! Scope narrowed during implementation (design.md D8). Attempting a
! real GENERIC_RUN_USER phase under GRAPH_MODE_GRAPH, to show a
! changed value actually propagating through the chain end-to-end,
! surfaced THREE separate, previously-undiscovered gaps - each real,
! each confirmed by direct code reading, none specific to this
! change's own D1-D6 fix:
!
!   1. units_and_typekind_mismatch's own chain has an INTERMEDIATE node
!      (between UnitsConverterTransform and TypeKindConverterTransform)
!      that try_materialize_field_extension never materializes (it only
!      ever targets the chain's FINAL node) - fixed here by switching to
!      a single-characteristic fixture (units_mismatch_run_phase, below),
!      whose one-hop chain has no distinct intermediate node to expose
!      this on; the general N-hop case remains open (ExtensionResolution.F90
!      would need to expose every intermediate NodeId, not just the
!      final one - real, separate work).
!   2. resolve_one's own mismatch branch never materialized the chain's
!      own INPUT node (export_node_id) at all - only the exact-match
!      branch and the chain's final node were ever materialized. FIXED
!      in this change (GraphBuilder.F90, resolve_one): the mismatch
!      branch now also calls try_materialize_field_extension on
!      export_node_id, using the EXPORT's own typekind/units (not the
!      import's).
!   3. CLOSED by openspec/changes/phase-11a-export-field-aliasing: the
!      export proxy's own materialized field used to be an INDEPENDENT
!      FieldCreate - never aliased to comp_src's own real export field
!      (the one ConfigurableGridComp%run() actually writes the
!      YAML-configured run-phase value into). A real run phase's
!      changed value therefore never reached the proxy, let alone the
!      chain - confirmed by the resulting NaN, not a crash. Fixed by
!      making the export proxy's own field a MAPL_NamedAlias of
!      comp_src's own real export field (try_alias_export_field,
!      GraphBuilder.F90, mirroring D1-D6's own "always alias, never
!      duplicate" fix for the sibling-import side) - this test now
!      asserts the real, converted value below.
!
! Gaps (1)/(2) are still tracked as roadmap work items
! (docs/graph/spec/20-implementation-roadmap.md §20.4.8's own "work
! items" list). This test demonstrates structural, init-time population
! of a sibling's own real state through a real (statically-correct)
! extension-chain transform, entirely without StateRegistry, AND (gap
! (3) now closed) a real GENERIC_RUN_USER phase's changed value
! actually propagating through that chain end-to-end to comp_dst's own
! real import state; design.md D7's own pull hook
! (graphbuilder_run_pull_hook/graph%update(), called from run_user.F90)
! is exercised by this test and its observable effect (the converted
! numeric value) is now asserted.
module Test_GraphModeDemonstration

   use mapl_Generic_mod
   use mapl_GenericPhases_mod
   use mapl_MultiState_mod
   use mapl_OuterMetaComponent_mod
   use mapl_GraphMode_mod, only: set_graph_mode, GRAPH_MODE_GRAPH, GRAPH_MODE_REGISTRY
   use mapl_ExtensionResolution_mod, only: set_materialize_extensions
   use mapl_FieldDictionaryConfig_mod, only: FieldDictionaryConfig, &
        set_field_dictionary_config, get_field_dictionary_config
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetwork_mod, only: DependencyNetwork
   use mapl_NodeIdSet_mod, only: NodeIdSet, NodeIdSetIterator
   use mapl_GraphBuilder_mod, only: item_key
   use mapl_NodeId_mod, only: NodeId, operator(==)
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem
   use mapl_Generic_api, only: mapl_GenericSetServices
   use mapl_FieldGet_mod, only: FieldGet
   use mapl_PortIdNodeIdMap_mod, only: PortIdNodeIdMap, PortIdNodeIdMapIterator, operator(/=)
   use mapl_RestartHandler_mod, only: get_restart_bundle
   use esmf
   use nuopc
   use pfunit
   implicit none(type, external)

contains

   @test(npes=[0])
   subroutine test_graph_mode_populates_sibling_states(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_HConfig) :: config
      type(ESMF_Config) :: config_cf
      type(ESMF_GridComp) :: cap_gc
      type(OuterMetaComponent), pointer :: cap_meta, dst_meta, src_meta
      type(GriddedComponentDriver) :: dst_driver
      type(GriddedComponentDriver), pointer :: dst_own_driver
      type(ESMF_GridComp) :: dst_gc
      type(MultiState) :: dst_states
      type(ESMF_State) :: importState, exportState
      type(ESMF_State) :: dst_own_import_state
      type(ESMF_Clock) :: clock
      type(ESMF_Time) :: t0, t1
      type(ESMF_TimeInterval) :: dt
      integer :: status, user_status, i
      integer :: item_count
      type(ESMF_Field) :: result_field, chain_input_field
      type(ESMF_TypeKind_Flag) :: result_typekind
      character(:), allocatable :: result_units
      real(ESMF_KIND_R4), pointer :: result_data(:,:)
      type(ComponentGraph), pointer :: src_graph
      type(NodeId), pointer :: export_proxy_id
      class(GraphNode), pointer :: export_proxy_node
      type(GraphStateItem) :: export_proxy_payload

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      config = ESMF_HConfigCreate( &
           filename='./graph-scenarios/units_mismatch_run_phase/cap.yaml', _RC)
      config_cf = ESMF_ConfigCreate(hconfig=config, _RC)
      cap_gc = ESMF_GridCompCreate(name='CAP_GRAPH_MODE_DEMO', config=config_cf, _RC)
      call ESMF_GridCompSetServices(cap_gc, mapl_GenericSetservices, userRC=user_status, _RC)
      _VERIFY(user_status)

      call ESMF_TimeSet(t0, timeString="2000-04-03T21:00:00", _RC)
      call ESMF_TimeSet(t1, timeString="2000-04-03T22:00:00", _RC)
      call ESMF_TimeIntervalSet(dt, h=1)
      clock = ESMF_ClockCreate(timestep=dt, startTime=t0, stoptime=t1, refTime=t0, _RC)

      importState = ESMF_StateCreate(_RC)
      exportState = ESMF_StateCreate(_RC)

      ! GRAPH_MODE_GRAPH, not BOTH - graph-native population is the
      ! SOLE real producer; legacy StateRegistry%add_to_states is
      ! unconditionally skipped (initialize_accept_transfer.F90's own
      ! existing graph_mode()-gated branch).
      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_materialize_extensions(.true.)
      do i = 1, size(GENERIC_INIT_PHASE_SEQUENCE)
         associate (phase => GENERIC_INIT_PHASE_SEQUENCE(i))
            call ESMF_GridCompInitialize(cap_gc, &
                 importState=importState, exportState=exportState, clock=clock, &
                 phase=phase, userRC=user_status, _RC)
            _VERIFY(user_status)
         end associate
      end do
      call set_materialize_extensions(.false.)
      call set_graph_mode(GRAPH_MODE_REGISTRY)

      ! openspec/changes/phase-11a-export-field-aliasing, design.md D6:
      ! a real GENERIC_RUN_USER phase invocation - mirroring
      ! Test_GraphEquivalenceHarness.pf's own equivalence_fixture_setup
      ! precedent for the identical call shape (same ordering: run AFTER
      ! graph_mode is reset to GRAPH_MODE_REGISTRY, since the real alias
      ! established at GENERIC_INIT_ACCEPT_TRANSFER time, not graph_mode
      ! at run time, is what makes comp_dst's own import field see
      ! comp_src's own real run()-written value - the two ESMF_Field
      ! handles are shallow aliases of the SAME underlying field by
      ! this point). comp_src's own 'run:' section (comp_src.yaml,
      ! units_mismatch_run_phase/description.md) sets T to 10. hPa;
      ! run_children_phases_ (ConfigurableGridComp) propagates
      ! GENERIC_RUN_USER down to comp_dst as well, so comp_dst's own
      ! driver%run() also executes (D7's own pull hook,
      ! graphbuilder_run_pull_hook/graph%update(), fires there - no
      ! crash, and now also has an observable numeric effect, asserted
      ! below).
      call ESMF_GridCompRun(cap_gc, &
           importState=importState, exportState=exportState, clock=clock, &
           phase=GENERIC_RUN_USER, userRC=user_status, _RC)
      _VERIFY(user_status)

      cap_meta => get_outer_meta(cap_gc, _RC)

      ! comp_dst's own real import ESMF_State - reached the same way
      ! Test_GraphEquivalenceHarness.pf's own check() already does.
      dst_driver = cap_meta%get_child('comp_dst', _RC)
      dst_gc = dst_driver%get_gridcomp()
      dst_meta => get_outer_meta(dst_gc, _RC)
      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_states = dst_own_driver%get_states()
      dst_own_import_state = dst_states%importState

      ! Exactly one entry - the real producer here is graph-native
      ! population alone; legacy never ran for this component.
      call ESMF_StateGet(dst_own_import_state, itemCount=item_count, _RC)
      @assertEqual(1, item_count, 'comp_dst own import state has exactly one entry under GRAPH_MODE_GRAPH')

      call ESMF_StateGet(dst_own_import_state, 'T', result_field, _RC)
      call FieldGet(result_field, typekind=result_typekind, units=result_units, _RC)
      @assertTrue(result_typekind == ESMF_TYPEKIND_R4, 'chain final item has the import''s own typekind (R4, no typekind mismatch in this fixture)')
      @assertEqual('Pa', result_units, 'chain final item has the import''s own units (Pa)')

      ! Export's own real field (openspec/changes/hierarchy-wide-
      ! component-graph, tasks.md 3.4: no parent-local proxy exists
      ! anymore - the chain's own input is comp_src's own real NodeId
      ! directly, in comp_src's own graph) has the EXPORT's own
      ! typekind/units - confirms gap (2) above is fixed: the chain's
      ! own input is now real, not unallocated.
      dst_driver = cap_meta%get_child('comp_src', _RC)
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(dst_gc, _RC)
      src_graph => src_meta%get_component_graph()
      export_proxy_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      @assert_that('export item resolved', associated(export_proxy_id), is(true()))
      export_proxy_node => src_graph%get_node(export_proxy_id)
      select type (export_proxy_node)
      class is (StateItemNode)
         export_proxy_payload = export_proxy_node%get_payload()
      class default
         @assert_that('export node is a StateItemNode', .false., is(true()))
      end select
      chain_input_field = export_proxy_payload%get_field(rc=status)
      @assertEqual(0, status, 'export item has a real, allocated field (gap 2 fix)')
      @assert_that('export field is a real ESMF_Field', ESMF_FieldIsCreated(chain_input_field), is(true()))

      ! openspec/changes/phase-11a-export-field-aliasing, design.md D6
      ! (closes gap 3 above): the export's own field is now a
      ! real MAPL_NamedAlias of comp_src's own real export field (not
      ! an independent FieldCreate), so comp_src's own real run()
      ! (comp_src.yaml's 'run: {T: [10]}') writing 10. hPa into its own
      ! real export field is observed here, through this same resolved
      ! structure, converted by the chain's own UnitsConverterTransform
      ! (hPa -> Pa, factor 100) into 1000. Pa - the fixture's own
      ! hand-checked value (units_mismatch_run_phase/description.md).
      ! result_field is 2D (vertical_dim_spec: NONE, no ungridded dims)
      ! R4 (already asserted above) - farrayPtr accessor matches
      ! Test_3DConservativeMixingRatio.pf/Test_CopyTransform.pf's own
      ! real-numeric-assertion precedent.
      call ESMF_FieldGet(result_field, farrayPtr=result_data, _RC)
      @assertEqual(1000._ESMF_KIND_R4, result_data, tolerance=1.0e-4_ESMF_KIND_R4, &
           message='comp_dst own import field reflects comp_src''s own run-phase value, converted hPa->Pa (gap 3 fix)')

      _UNUSED_DUMMY(this)
   end subroutine test_graph_mode_populates_sibling_states

   ! openspec/changes/phase-11b-chain-intermediate-materialization,
   ! design.md D5/tasks.md 4.2/4.3: real two-characteristic
   ! (units + typekind) run-phase demonstration - the goal §20.4.9/
   ! §20.4.10 named as unmet before this change (a chain of two or more
   ! links executing compute() end to end, with a real propagated
   ! value). Mirrors test_graph_mode_populates_sibling_states above
   ! exactly in shape, substituting units_and_typekind_mismatch for
   ! units_mismatch_run_phase - that fixture's own comp_src.yaml already
   ! declares a real `run: {T: [10]}` section (unlike
   ! Test_GraphEquivalenceHarness.pf's own has_run_phase=.false. use of
   ! this same fixture, which never executes a run phase or compute()).
   @test(npes=[0])
   subroutine test_graph_mode_propagates_through_two_characteristic_chain(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_HConfig) :: config
      type(ESMF_Config) :: config_cf
      type(ESMF_GridComp) :: cap_gc
      type(OuterMetaComponent), pointer :: cap_meta, dst_meta, src_meta
      type(GriddedComponentDriver) :: dst_driver
      type(GriddedComponentDriver), pointer :: dst_own_driver
      type(ESMF_GridComp) :: dst_gc
      type(MultiState) :: dst_states
      type(ESMF_State) :: importState, exportState
      type(ESMF_State) :: dst_own_import_state
      type(ESMF_Clock) :: clock
      type(ESMF_Time) :: t0, t1
      type(ESMF_TimeInterval) :: dt
      integer :: status, user_status, i
      integer :: item_count
      type(ESMF_Field) :: result_field, chain_input_field, chain_intermediate_field
      type(ESMF_TypeKind_Flag) :: result_typekind
      character(:), allocatable :: result_units
      real(ESMF_KIND_R8), pointer :: result_data(:,:)
      type(ComponentGraph), pointer :: cap_graph, src_graph, dst_graph
      type(DependencyNetwork), pointer :: net
      type(NodeId), pointer :: export_proxy_id
      type(NodeId), pointer :: import_proxy_id
      type(NodeIdSet), target :: preds
      type(NodeIdSetIterator) :: pred_iter
      type(NodeId) :: chain_intermediate_id
      class(GraphNode), pointer :: export_proxy_node
      class(GraphNode), pointer :: chain_intermediate_node
      type(GraphStateItem) :: export_proxy_payload
      type(GraphStateItem) :: chain_intermediate_payload

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      config = ESMF_HConfigCreate( &
           filename='./graph-scenarios/units_and_typekind_mismatch/cap.yaml', _RC)
      config_cf = ESMF_ConfigCreate(hconfig=config, _RC)
      cap_gc = ESMF_GridCompCreate(name='CAP_GRAPH_MODE_DEMO_2CHAR', config=config_cf, _RC)
      call ESMF_GridCompSetServices(cap_gc, mapl_GenericSetservices, userRC=user_status, _RC)
      _VERIFY(user_status)

      call ESMF_TimeSet(t0, timeString="2000-04-03T21:00:00", _RC)
      call ESMF_TimeSet(t1, timeString="2000-04-03T22:00:00", _RC)
      call ESMF_TimeIntervalSet(dt, h=1)
      clock = ESMF_ClockCreate(timestep=dt, startTime=t0, stoptime=t1, refTime=t0, _RC)

      importState = ESMF_StateCreate(_RC)
      exportState = ESMF_StateCreate(_RC)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_materialize_extensions(.true.)
      do i = 1, size(GENERIC_INIT_PHASE_SEQUENCE)
         associate (phase => GENERIC_INIT_PHASE_SEQUENCE(i))
            call ESMF_GridCompInitialize(cap_gc, &
                 importState=importState, exportState=exportState, clock=clock, &
                 phase=phase, userRC=user_status, _RC)
            _VERIFY(user_status)
         end associate
      end do
      call set_materialize_extensions(.false.)
      call set_graph_mode(GRAPH_MODE_REGISTRY)

      cap_meta => get_outer_meta(cap_gc, _RC)
      cap_graph => cap_meta%get_component_graph()

      ! openspec/changes/phase-11b-chain-intermediate-materialization:
      ! BEFORE any run phase executes, confirm every link of this
      ! two-characteristic chain already has a real, allocated payload -
      ! the chain's own INPUT (comp_src's own real export NodeId, in
      ! comp_src's own graph - openspec/changes/hierarchy-wide-
      ! component-graph tasks.md 3.4: no parent-local proxy exists
      ! anymore) and its own INTERMEDIATE node (between
      ! UnitsConverterTransform and TypeKindConverterTransform - this
      ! change's own scope, closing §20.4.9's first gap). The
      ! TransformGraphNodes and intermediate StateItemNode are still
      ! registered in cap's own graph (find_or_build_extension_chain is
      ! called with cap's own ComponentGraph/default network, since cap
      ! is the component that declared the connection) - only the
      ! chain's two real endpoints (export/import) now live in each
      ! child's own graph. The chain's own structure alternates
      ! StateItemNode -> TransformGraphNode -> StateItemNode -> ...
      ! (build_chain, ExtensionResolution.F90): walking back from the
      ! import's sole predecessor (the chain's FINAL StateItemNode)
      ! needs TWO more predecessor hops (through
      ! TypeKindConverterTransform's own TransformGraphNode) to reach
      ! the chain's INTERMEDIATE StateItemNode, not one.
      dst_driver = cap_meta%get_child('comp_src', _RC)
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(dst_gc, _RC)
      src_graph => src_meta%get_component_graph()
      export_proxy_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      @assert_that('export item resolved', associated(export_proxy_id), is(true()))
      export_proxy_node => src_graph%get_node(export_proxy_id)
      select type (export_proxy_node)
      class is (StateItemNode)
         export_proxy_payload = export_proxy_node%get_payload()
      class default
         @assert_that('export node is a StateItemNode', .false., is(true()))
      end select
      chain_input_field = export_proxy_payload%get_field(rc=status)
      @assertEqual(0, status, 'export item (chain input) has a real, allocated field')
      @assert_that('export field is a real ESMF_Field', ESMF_FieldIsCreated(chain_input_field), is(true()))

      dst_driver = cap_meta%get_child('comp_dst', _RC)
      dst_gc = dst_driver%get_gridcomp()
      dst_meta => get_outer_meta(dst_gc, _RC)
      dst_graph => dst_meta%get_component_graph()
      import_proxy_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that('import item resolved', associated(import_proxy_id), is(true()))
      net => cap_graph%get_network(cap_graph%get_default_network_id())
      preds = net%get_predecessors(import_proxy_id)
      @assertEqual(1, preds%size(), 'import has exactly one predecessor (the chain''s final item)')
      pred_iter = preds%ftn_begin()
      call pred_iter%next()
      ! pred_iter%of() is the chain's FINAL StateItemNode
      ! (TypeKindConverterTransform's own output - wired directly to
      ! the import via add_dependency, resolve_one's own final step).
      ! That node's own predecessor is TypeKindConverterTransform's own
      ! TransformGraphNode (build_chain wires
      ! transform_node_id -> extension_node_id), not another
      ! StateItemNode - walk one more hop past that TransformGraphNode
      ! to reach its own predecessor, the chain's INTERMEDIATE
      ! StateItemNode (UnitsConverterTransform's own output,
      ! TypeKindConverterTransform's own input).
      preds = net%get_predecessors(pred_iter%of())
      @assertEqual(1, preds%size(), 'chain final item has exactly one predecessor (TypeKindConverterTransform''s own TransformGraphNode)')
      pred_iter = preds%ftn_begin()
      call pred_iter%next()
      preds = net%get_predecessors(pred_iter%of())
      @assertEqual(1, preds%size(), 'TypeKindConverterTransform''s own TransformGraphNode has exactly one predecessor (the chain''s intermediate item)')
      pred_iter = preds%ftn_begin()
      call pred_iter%next()
      chain_intermediate_id = pred_iter%of()

      chain_intermediate_node => cap_graph%get_node(chain_intermediate_id)
      select type (chain_intermediate_node)
      class is (StateItemNode)
         chain_intermediate_payload = chain_intermediate_node%get_payload()
      class default
         @assert_that('chain intermediate node is a StateItemNode', .false., is(true()))
      end select
      chain_intermediate_field = chain_intermediate_payload%get_field(rc=status)
      @assertEqual(0, status, 'chain intermediate item has a real, allocated field (this change''s own scope)')
      @assert_that('chain intermediate field is a real ESMF_Field', ESMF_FieldIsCreated(chain_intermediate_field), is(true()))

      ! A real GENERIC_RUN_USER phase - mirroring
      ! test_graph_mode_populates_sibling_states above exactly.
      ! comp_src.yaml's own `run: {T: [10]}` sets T to 10. hPa/R4;
      ! run_children_phases_ propagates GENERIC_RUN_USER down to
      ! comp_dst, whose own driver%run() triggers D7's own pull hook
      ! (graphbuilder_run_pull_hook/graph%update()) - which, for this
      ! fixture, now pulls through BOTH chain links (units, then
      ! typekind), each with a real payload to read from and write to
      ! (confirmed above), rather than failing on the intermediate
      ! link's own previously-unallocated payload.
      call ESMF_GridCompRun(cap_gc, &
           importState=importState, exportState=exportState, clock=clock, &
           phase=GENERIC_RUN_USER, userRC=user_status, _RC)
      _VERIFY(user_status)

      ! comp_dst's own real import ESMF_State.
      dst_driver = cap_meta%get_child('comp_dst', _RC)
      dst_gc = dst_driver%get_gridcomp()
      dst_meta => get_outer_meta(dst_gc, _RC)
      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_states = dst_own_driver%get_states()
      dst_own_import_state = dst_states%importState

      call ESMF_StateGet(dst_own_import_state, itemCount=item_count, _RC)
      @assertEqual(1, item_count, 'comp_dst own import state has exactly one entry under GRAPH_MODE_GRAPH')

      call ESMF_StateGet(dst_own_import_state, 'T', result_field, _RC)
      call FieldGet(result_field, typekind=result_typekind, units=result_units, _RC)
      @assertTrue(result_typekind == ESMF_TYPEKIND_R8, 'chain final item has the import''s own typekind (R8)')
      @assertEqual('Pa', result_units, 'chain final item has the import''s own units (Pa)')

      ! Hand-checked value (units_and_typekind_mismatch/description.md):
      ! 10. hPa -(units, factor 100)-> 1000. Pa -(typekind, R4->R8)->
      ! 1000.d0 Pa. Both conversions composed correctly end to end -
      ! the real goal this change (11b) and 11a together unlock, per
      ! §20.4.10's own "Both landing is what unlocks a real
      ! units_and_typekind_mismatch-style two-characteristic run-phase
      ! demonstration."
      call ESMF_FieldGet(result_field, farrayPtr=result_data, _RC)
      @assertEqual(1000._ESMF_KIND_R8, result_data, tolerance=1.0e-4_ESMF_KIND_R8, &
           message='comp_dst own import field reflects comp_src''s own run-phase value, converted hPa->Pa and R4->R8')

      _UNUSED_DUMMY(this)
   end subroutine test_graph_mode_propagates_through_two_characteristic_chain

   ! openspec/changes/hierarchy-wide-component-graph, tasks.md 6.5,
   ! design.md D3: resurrects the abandoned
   ! `scenarios/graphbuilder_propagation/` fixture (cap -> comp_mid ->
   ! comp_dst, comp_mid declares no connection of its own) as a real
   ! pFUnit scenario exercising the corrected recursive mirroring
   ! end-to-end, through a real GENERIC_INIT_PHASE_SEQUENCE run (not
   ! Test_GraphBuilderPropagation.pf's own direct, synthetic
   ! gb%run_propagate_hook/gb%advertise unit-level calls).
   !
   ! cap's own connection names comp_mid - NOT comp_dst - as its
   ! destination (graph-scenarios/graphbuilder_propagation/cap.yaml):
   ! exactly the shape design.md D3's own postmortem says a rejected
   ! "search the subtree" alternative could not reproduce (nothing at
   ! cap's level names comp_dst specifically). For this connection to
   ! resolve at all, comp_mid's own GENERIC_INIT_ADVERTISE-phase
   ! run_propagate_hook call must already have mirrored comp_dst's own
   ! unresolved import 'T' into comp_mid's own import-port table,
   ! before cap's own advertise-phase work (and its own
   ! run_propagate_hook/run_activate_hook pass over comp_mid) resumes -
   ! the real lifecycle ordering confirmed by direct reading
   ! (initialize_advertise.F90), not re-derived here.
   @test(npes=[0])
   subroutine test_graph_mode_mirrors_grandchild_import_recursively(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_HConfig) :: config
      type(ESMF_Config) :: config_cf
      type(ESMF_GridComp) :: cap_gc
      type(OuterMetaComponent), pointer :: cap_meta, mid_meta, src_meta, dst_meta
      type(GriddedComponentDriver) :: child_driver
      type(ESMF_GridComp) :: child_gc
      type(ESMF_State) :: importState, exportState
      type(ESMF_Clock) :: clock
      type(ESMF_Time) :: t0, t1
      type(ESMF_TimeInterval) :: dt
      integer :: status, user_status, i
      type(ComponentGraph), pointer :: cap_graph, mid_graph, src_graph, dst_graph
      type(DependencyNetwork), pointer :: cap_net
      type(NodeId), pointer :: src_export_id, dst_import_id
      type(PortIdNodeIdMap) :: mid_import_ports
      logical :: mirrored_into_mid

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      config = ESMF_HConfigCreate( &
           filename='./graph-scenarios/graphbuilder_propagation/cap.yaml', _RC)
      config_cf = ESMF_ConfigCreate(hconfig=config, _RC)
      cap_gc = ESMF_GridCompCreate(name='CAP_GRAPH_MODE_PROPAGATION_DEMO', config=config_cf, _RC)
      call ESMF_GridCompSetServices(cap_gc, mapl_GenericSetservices, userRC=user_status, _RC)
      _VERIFY(user_status)

      call ESMF_TimeSet(t0, timeString="2000-04-03T21:00:00", _RC)
      call ESMF_TimeSet(t1, timeString="2000-04-03T22:00:00", _RC)
      call ESMF_TimeIntervalSet(dt, h=1)
      clock = ESMF_ClockCreate(timestep=dt, startTime=t0, stoptime=t1, refTime=t0, _RC)

      importState = ESMF_StateCreate(_RC)
      exportState = ESMF_StateCreate(_RC)

      ! GRAPH_MODE_GRAPH: run_propagate_hook/run_activate_hook/
      ! run_advertise_hook are unconditional hooks (always run,
      ! regardless of graph_mode - see initialize_advertise.F90), but
      ! GRAPH_MODE_GRAPH is used here for consistency with this file's
      ! other real-lifecycle tests above; this test's own assertions
      ! are purely graph-side (resource index, import ports, dependency
      ! edges), never touching a real ESMF_State value - task 6.7's own
      ! "no backing var_spec" gap means a mirrored import is not yet
      ! inserted into any real ESMF_State under a child-qualified name,
      ! so GRAPH_MODE_REGISTRY vs GRAPH_MODE_GRAPH makes no observable
      ! difference to what this test checks.
      call set_graph_mode(GRAPH_MODE_GRAPH)
      do i = 1, size(GENERIC_INIT_PHASE_SEQUENCE)
         associate (phase => GENERIC_INIT_PHASE_SEQUENCE(i))
            call ESMF_GridCompInitialize(cap_gc, &
                 importState=importState, exportState=exportState, clock=clock, &
                 phase=phase, userRC=user_status, _RC)
            _VERIFY(user_status)
         end associate
      end do
      call set_graph_mode(GRAPH_MODE_REGISTRY)

      cap_meta => get_outer_meta(cap_gc, _RC)
      cap_graph => cap_meta%get_component_graph()

      child_driver = cap_meta%get_child('comp_src', _RC)
      child_gc = child_driver%get_gridcomp()
      src_meta => get_outer_meta(child_gc, _RC)
      src_graph => src_meta%get_component_graph()

      child_driver = cap_meta%get_child('comp_mid', _RC)
      child_gc = child_driver%get_gridcomp()
      mid_meta => get_outer_meta(child_gc, _RC)
      mid_graph => mid_meta%get_component_graph()

      child_driver = mid_meta%get_child('comp_dst', _RC)
      child_gc = child_driver%get_gridcomp()
      dst_meta => get_outer_meta(child_gc, _RC)
      dst_graph => dst_meta%get_component_graph()

      ! comp_dst's own import 'T' is a real resource-index entry in
      ! comp_dst's own graph (it advertised it directly) - comp_mid
      ! never advertises 'T' itself, so comp_mid's own resource index
      ! has no entry for it (mirroring populates the import-PORT table
      ! only, never the resource index - §2.3/design.md D3).
      dst_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that('comp_dst own resource index has T', associated(dst_import_id), is(true()))
      @assert_that('comp_mid own resource index has NO entry for T (never advertised directly)', &
           .not. associated(mid_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))), is(true()))

      ! comp_mid's own run_propagate_hook call (GENERIC_INIT_ADVERTISE,
      ! comp_mid's own level) mirrored comp_dst's own unresolved import
      ! into comp_mid's own IMPORT-PORT table - the same real NodeId,
      ! additionally reachable through comp_mid, with no new node.
      mid_import_ports = mid_graph%get_import_ports()
      mirrored_into_mid = port_map_contains_value(mid_import_ports, dst_import_id)
      @assert_that('comp_dst own import T is mirrored into comp_mid own import-port table', &
           mirrored_into_mid, is(true()))

      ! cap's own connection (src_comp: comp_src, dst_comp: comp_mid)
      ! resolved against the MIRRORED port exactly as it would an item
      ! comp_mid advertised directly - the dependency edge connects the
      ! two REAL endpoints (comp_src's own export NodeId, comp_dst's
      ! own import NodeId) directly, with no proxy at any level, living
      ! in cap's own default network (the component that declared this
      ! connection).
      src_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      @assert_that('comp_src own export T resolved', associated(src_export_id), is(true()))

      cap_net => cap_graph%get_network(cap_graph%get_default_network_id())
      @assert_that('cap own default network wires comp_src export directly to comp_dst import, no proxy', &
           cap_net%contains_dependency(src_export_id, dst_import_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_graph_mode_mirrors_grandchild_import_recursively

   ! openspec/changes/phase-12-characteristic-dispatch-wiring, design.md
   ! D4/tasks.md 7.4: the new standard_name_and_ungridded_dims_mismatch
   ! fixture (graph-scenarios/standard_name_and_ungridded_dims_mismatch/
   ! description.md), exercised through the real YAML/init-phase
   ! pipeline rather than the synthetic-node unit test in
   ! Test_GraphBuilder_ConnectionResolution.pf. Confirms the explicit-
   ! failure path fires exactly as that synthetic test already confirms
   ! (same reason string), end to end from a real config file - not a
   ! second, independent assertion of different behavior.
   @test(npes=[0])
   subroutine test_graph_mode_leaves_newly_wired_axis_mismatch_unwired(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_HConfig) :: config
      type(ESMF_Config) :: config_cf
      type(ESMF_GridComp) :: cap_gc
      type(OuterMetaComponent), pointer :: cap_meta, src_meta, dst_meta
      type(GriddedComponentDriver) :: child_driver
      type(ESMF_GridComp) :: child_gc
      type(ESMF_State) :: importState, exportState
      type(ESMF_Clock) :: clock
      type(ESMF_Time) :: t0, t1
      type(ESMF_TimeInterval) :: dt
      integer :: status, user_status, i
      type(ComponentGraph), pointer :: cap_graph, src_graph, dst_graph
      type(DependencyNetwork), pointer :: cap_net
      type(NodeId), pointer :: src_export_id, dst_import_id
      type(FieldDictionaryConfig) :: saved_fd_config

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      ! This suite's own EXTRA_INITIALIZE (Initialize_strict) forces
      ! strict field-dictionary ValidationMode for the whole process -
      ! which would make the LEGACY StandardNameAspect%matches() (run by
      ! process_connections()/Connection%connect(), unconditionally, even
      ! under GRAPH_MODE_GRAPH - initialize_accept_transfer.F90's own
      ! header comment) reject this fixture's standard_name mismatch
      ! itself, before GraphBuilder's own newly-wired detection ever
      ! gets a chance to run. Force permissive for this one test only,
      ! mirroring Test_Aspects.pf's own save/override/restore
      ! convention - the real thing under test here is GraphBuilder's
      ! own characteristic-mismatch detection, not legacy's independent
      ! standard_name enforcement.
      saved_fd_config = get_field_dictionary_config()
      call set_field_dictionary_config(FieldDictionaryConfig())

      config = ESMF_HConfigCreate( &
           filename='./graph-scenarios/standard_name_and_ungridded_dims_mismatch/cap.yaml', _RC)
      config_cf = ESMF_ConfigCreate(hconfig=config, _RC)
      cap_gc = ESMF_GridCompCreate(name='CAP_GRAPH_MODE_DEMO_UNSUPPORTED', config=config_cf, _RC)
      call ESMF_GridCompSetServices(cap_gc, mapl_GenericSetservices, userRC=user_status, _RC)
      _VERIFY(user_status)

      call ESMF_TimeSet(t0, timeString="2000-04-03T21:00:00", _RC)
      call ESMF_TimeSet(t1, timeString="2000-04-03T22:00:00", _RC)
      call ESMF_TimeIntervalSet(dt, h=1)
      clock = ESMF_ClockCreate(timestep=dt, startTime=t0, stoptime=t1, refTime=t0, _RC)

      importState = ESMF_StateCreate(_RC)
      exportState = ESMF_StateCreate(_RC)

      ! graphbuilder_run_connect_hook (GraphBuilder_LifecycleHooks_smod.F90)
      ! catches the STANDARD_NAME build_transform failure itself -
      ! surfaced as a logged warning (report_if_failed/the
      ! unsupported%of(i) loop), never propagated as a userRC failure -
      ! so this init sequence completes normally; the real assertion is
      ! that no dependency edge was ever wired between the two real
      ! endpoints below.
      call set_graph_mode(GRAPH_MODE_GRAPH)
      do i = 1, size(GENERIC_INIT_PHASE_SEQUENCE)
         associate (phase => GENERIC_INIT_PHASE_SEQUENCE(i))
            call ESMF_GridCompInitialize(cap_gc, &
                 importState=importState, exportState=exportState, clock=clock, &
                 phase=phase, userRC=user_status, _RC)
            _VERIFY(user_status)
         end associate
      end do
      call set_graph_mode(GRAPH_MODE_REGISTRY)

      ! StandardNameCharacteristic%build_transform _FAILs explicitly (no
      ! real provider exists for this axis), exactly like
      ! test_standard_name_mismatch_fails_explicitly's own synthetic-node
      ! unit test - consume the pFUnit exception it raises so the real
      ! assertions below (not this already-confirmed detection detail)
      ! drive this test's own pass/fail outcome.
      @assertExceptionRaised('StandardNameCharacteristic: build_transform - no real provider exists for this axis')

      cap_meta => get_outer_meta(cap_gc, _RC)
      cap_graph => cap_meta%get_component_graph()

      child_driver = cap_meta%get_child('comp_src', _RC)
      child_gc = child_driver%get_gridcomp()
      src_meta => get_outer_meta(child_gc, _RC)
      src_graph => src_meta%get_component_graph()

      child_driver = cap_meta%get_child('comp_dst', _RC)
      child_gc = child_driver%get_gridcomp()
      dst_meta => get_outer_meta(child_gc, _RC)
      dst_graph => dst_meta%get_component_graph()

      src_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      dst_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that('comp_src own export T resolved', associated(src_export_id), is(true()))
      @assert_that('comp_dst own import T resolved', associated(dst_import_id), is(true()))

      ! design.md D3/D4: no real build_transform exists for either
      ! mismatched axis (standard_name, ungridded_dims) - the connection
      ! is reported through unsupported_characteristics, never wired.
      cap_net => cap_graph%get_network(cap_graph%get_default_network_id())
      @assert_that('cap own default network has NO edge between the mismatched export and import', &
           cap_net%contains_dependency(src_export_id, dst_import_id), is(false()))
      @assert_that('comp_dst own import T has no predecessor', &
           cap_net%has_predecessors(dst_import_id), is(false()))

      call set_field_dictionary_config(saved_fd_config)

      _UNUSED_DUMMY(this)
   end subroutine test_graph_mode_leaves_newly_wired_axis_mismatch_unwired

   ! openspec/changes/phase-13-restart-compatibility (docs/graph/spec/
   ! 20-implementation-roadmap.md sec 20.4.13): verify that populate_one
   ! (GraphBuilder_StatePopulation_smod.F90) correctly sets RestartMode
   ! metadata on a graph-materialized alias so RestartHandler's
   ! get_restart_bundle (predicate_skip_restart_) sees the right value
   ! under GRAPH_MODE_GRAPH.
   !
   ! Uses the plain_field fixture (T export/import, no restart_mode in
   ! YAML -> allocatable not set -> FieldInfoSetInternal never called ->
   ! FieldInfoGetInternal returns the default RESTART_REQUIRED). Under
   ! GRAPH_MODE_GRAPH the field is graph-materialized (not by legacy
   ! FieldClassAspect%add_to_state), so this test confirms the default
   ! path works without regression. Exit criterion per roadmap: a real
   ! round-trip - get_restart_bundle on the import state succeeds and
   ! returns the expected bundle count (1: T is not skipped).
   @test(npes=[0])
   subroutine test_graph_mode_sets_restart_metadata_on_materialized_field(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_HConfig) :: config
      type(ESMF_Config) :: config_cf
      type(ESMF_GridComp) :: cap_gc
      type(OuterMetaComponent), pointer :: cap_meta
      type(GriddedComponentDriver) :: dst_driver
      type(GriddedComponentDriver), pointer :: dst_own_driver
      type(ESMF_GridComp) :: dst_gc
      type(OuterMetaComponent), pointer :: dst_meta
      type(MultiState) :: dst_states
      type(ESMF_State) :: dst_own_import_state
      type(ESMF_State) :: importState, exportState
      type(ESMF_FieldBundle) :: restart_bundle
      type(ESMF_Clock) :: clock
      type(ESMF_Time) :: t0, t1
      type(ESMF_TimeInterval) :: dt
      integer :: status, user_status, i
      integer :: bundle_count

      call NUOPC_FieldDictionarySetup(filename='./scenarios/FieldDictionary.yml', _RC)

      config = ESMF_HConfigCreate( &
           filename='./graph-scenarios/plain_field/cap.yaml', _RC)
      config_cf = ESMF_ConfigCreate(hconfig=config, _RC)
      cap_gc = ESMF_GridCompCreate(name='CAP_RESTART_META_TEST', config=config_cf, _RC)
      call ESMF_GridCompSetServices(cap_gc, mapl_GenericSetservices, userRC=user_status, _RC)
      _VERIFY(user_status)

      call ESMF_TimeSet(t0, timeString='2000-04-03T21:00:00', _RC)
      call ESMF_TimeSet(t1, timeString='2000-04-03T22:00:00', _RC)
      call ESMF_TimeIntervalSet(dt, h=1)
      clock = ESMF_ClockCreate(timestep=dt, startTime=t0, stoptime=t1, refTime=t0, _RC)

      ! GRAPH_MODE_GRAPH: graph-native materialization is the sole real
      ! producer; legacy FieldClassAspect%add_to_state (which sets
      ! RestartMode metadata in the legacy path) is skipped entirely.
      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_materialize_extensions(.true.)
      importState = ESMF_StateCreate(_RC)
      exportState = ESMF_StateCreate(_RC)
      do i = 1, size(GENERIC_INIT_PHASE_SEQUENCE)
         associate (phase => GENERIC_INIT_PHASE_SEQUENCE(i))
            call ESMF_GridCompInitialize(cap_gc, &
                 importState=importState, exportState=exportState, &
                 clock=clock, phase=phase, userRC=user_status, _RC)
            _VERIFY(user_status)
         end associate
      end do
      call set_materialize_extensions(.false.)
      call set_graph_mode(GRAPH_MODE_REGISTRY)

      cap_meta => get_outer_meta(cap_gc, _RC)
      dst_driver = cap_meta%get_child('comp_dst', _RC)
      dst_gc = dst_driver%get_gridcomp()
      dst_meta => get_outer_meta(dst_gc, _RC)
      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_states = dst_own_driver%get_states()
      dst_own_import_state = dst_states%importState

      ! get_restart_bundle with is_write=.false. applies
      ! predicate_skip_restart_ which reads RestartMode metadata via
      ! FieldInfoGetInternal. T has no restart_mode declared in YAML so
      ! declared_restart_mode is not allocated, FieldInfoSetInternal is
      ! never called, and FieldInfoGetInternal returns the default
      ! RESTART_REQUIRED - so T is NOT filtered out. Bundle count must
      ! be 1 (T present, not skipped).
      call get_restart_bundle(dst_own_import_state, is_write=.false., &
           bundle=restart_bundle, _RC)
      call ESMF_FieldBundleGet(restart_bundle, fieldCount=bundle_count, _RC)
      @assertEqual(1, bundle_count, &
           'graph-materialized T field (RESTART_REQUIRED default) is present in restart bundle')

      _UNUSED_DUMMY(this)
   end subroutine test_graph_mode_sets_restart_metadata_on_materialized_field

   ! Local helper: does a PortIdNodeIdMap contain `target` as a VALUE
   ! (not a key)? Shared pattern with
   ! Test_GraphBuilderPropagation.pf's own identical helper - this
   ! file's own @testCase precludes importing that one directly
   ! (separate pFUnit-generated driver per module).
   logical function port_map_contains_value(ports, target) result(found)
      type(PortIdNodeIdMap), target, intent(in) :: ports
      type(NodeId), pointer, intent(in) :: target
      type(PortIdNodeIdMapIterator) :: iter
      type(NodeId) :: candidate

      found = .false.
      associate (e => ports%ftn_end())
         iter = ports%ftn_begin()
         do while (iter /= e)
            call iter%next()
            candidate = iter%second()
            if (candidate == target) then
               found = .true.
               return
            end if
         end do
      end associate
   end function port_map_contains_value

end module Test_GraphModeDemonstration
