   ! Spec scenario-adjacent: a declared export whose 'weight' member has
   ! the wrong kind (FIELDBUNDLE where the interface expects FIELD) is a
   ! hard wiring error, same as a missing member or a dims mismatch - the
   ! declared-missing-member and declared-dims-mismatch tests above have
   ! no kind-mismatch counterpart until this one.
   @test(npes=[0])
   subroutine test_resolve_callback_import_declared_kind_mismatch_fails(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, bad_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: bad_spec
      type(VariableSpec) :: bad_export, tracers_member, weight_member
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(CallbackContractViolation) :: expected_violations(1)
      character(:), allocatable :: handler_name
      character(:), allocatable :: expected_message
      logical :: matched
      integer :: status
      type(GraphBuilder) :: gb

      call build_handler_hierarchy('decl-kind', root_gc, root_meta, chem_meta, bad_meta, _RC)

      iface = make_surface_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-decl-kind', iface, interface_id, status)
      @assert_that(status, is(0))

      bad_export = make_var(ESMF_STATEINTENT_EXPORT, 'tracer_callback')
      bad_export%itemType = MAPL_STATEITEM_STATE

      tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers')
      tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call bad_export%declare_member('tracers', tracers_member, rc=status)
      @assert_that(status, is(0))

      ! Wrong kind: the interface expects a FIELD, this declares a FIELDBUNDLE.
      weight_member = make_var(ESMF_STATEINTENT_EXPORT, 'weight')
      weight_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call bad_export%declare_member('weight', weight_member, rc=status)
      @assert_that(status, is(0))

      bad_export%callback_interface_id = interface_id
      bad_spec => bad_meta%get_component_spec()
      call bad_spec%add_var_spec(bad_export)

      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      handler_name = bad_meta%get_name(status)
      @assert_that(status, is(0))
      expected_violations(1) = kind_mismatch_violation('weight', 'FIELDBUNDLE', 'FIELD')
      expected_message = format_callback_contract_report('svc-decl-kind', iface%get_version(), &
           handler_name, 'tracer_callback', expected_violations)

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)

      matched = catch(expected_message)
      do while (catch('status=1'))
      end do
      @assertTrue(matched)
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_declared_kind_mismatch_fails

   ! Declared Handler, otherwise-conforming, whose 'weight' member's
   ! vertical_stagger cannot settle the dims question one way or the
   ! other: VERTICAL_STAGGER_MIRROR defers the real vertical grid to
   ! another item, and an omitted weight_stagger models a member whose
   ! YAML never gave vertical_dim_spec at all. In both cases member_dims
   ! reports the comparison as undeterminable, and
   ! export_conforms_to_interface skips the dims check entirely rather
   ! than claiming a pass or a fail about dims it cannot know - the
   ! export still conforms overall only because every other member
   ! checks out, not because the dims comparison itself succeeded.
   !
   ! Uses make_profile_tracer_interface (expects 'weight' dims='xyz'),
   ! not make_surface_tracer_interface (expects 'xy'): against an 'xy'
   ! expectation, the old bug (reading unallocated vertical_grid as
   ! dims='xy') and a mistaken vertical_stagger == VERTICAL_STAGGER_NONE
   ! check (true for MIRROR as well as NONE) would both also report zero
   ! violations here, by accident. Expecting 'xyz' means zero violations
   ! only happens if the dims check is genuinely skipped.
   !
   ! Calls export_conforms_to_interface directly rather than through
   ! resolve_callback_import/advertise: VariableSpec's own intent rules
   ! (VariableSpec_private.F90's intent_rule_violation, enforced at
   ! advertise time by make_characteristics's check_intent_rules) reject
   ! VERTICAL_STAGGER_MIRROR on a plain export FIELD member outright -
   ! "mirror is only valid on an import or an expression export" - so a
   ! Handler could never actually advertise this shape. The declaration-
   ! level dims check in member_dims runs before any such validation (no
   ! graph node or descriptor exists for the member yet), and must not
   ! assume its input already passed those rules.
   @test(npes=[0])
   subroutine test_export_conforms_to_interface_mirror_or_unset(this)
      class(MpiTestMethod), intent(inout) :: this

      type(CallbackInterface) :: iface
      type(VariableSpec) :: mirror_export, unset_export
      type(CallbackContractViolation), allocatable :: violations(:)
      logical :: conforms
      integer :: status

      iface = make_profile_tracer_interface(status)
      @assert_that(status, is(0))

      mirror_export = make_surface_tracer_export('tracer_callback', include_tracers=.true., &
           include_weight=.true., weight_stagger=VERTICAL_STAGGER_MIRROR)
      conforms = export_conforms_to_interface(mirror_export, iface, violations)
      @assertTrue(conforms)
      @assertEqual(0, size(violations))

      ! weight_stagger omitted entirely: make_surface_tracer_export sets
      ! VERTICAL_STAGGER_INVALID in that case, the same value
      ! parse_var_specs leaves on a member whose YAML never gave
      ! vertical_dim_spec.
      unset_export = make_surface_tracer_export('tracer_callback', include_tracers=.true., &
           include_weight=.true.)
      conforms = export_conforms_to_interface(unset_export, iface, violations)
      @assertTrue(conforms)
      @assertEqual(0, size(violations))

      _UNUSED_DUMMY(this)
   end subroutine test_export_conforms_to_interface_mirror_or_unset

   ! An export that does not declare expected_interface_id as its own
   ! callback_interface_id keeps today's skip-and-report behavior even
   ! when it is missing every required member: rejected, not failed.
   ! CallbackArgumentSpecMap is a gFTL ordered map keyed by argument name,
   ! so the joined reason lists violations in alphabetical-by-name order
   ! ('tracers' before 'weight'), asserted exactly below rather than by
   ! substring, so a reordering bug would be caught.
   @test(npes=[0])
   subroutine test_resolve_callback_import_undeclared_missing_rejected(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, bad_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: bad_spec
      type(VariableSpec) :: bad_export
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(StringVector) :: rejected
      integer :: status
      type(GraphBuilder) :: gb

      call build_handler_hierarchy('undecl-missing', root_gc, root_meta, chem_meta, bad_meta, _RC)

      iface = make_surface_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-undecl-missing', iface, interface_id, status)
      @assert_that(status, is(0))

      ! Neither 'tracers' nor 'weight' declared, and callback_interface_id
      ! is left at its default (invalid) - never declares the interface.
      bad_export = make_surface_tracer_export('tracer_callback', include_tracers=.false., &
           include_weight=.false.)
      bad_spec => bad_meta%get_component_spec()
      call bad_spec%add_var_spec(bad_export)

      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rejected=rejected, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, size(matches))
      @assertEqual(1, rejected%size())
      @assertEqual('BAD/tracer_callback:missing_member:tracers; missing_member:weight', rejected%of(1))

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_undeclared_missing_rejected

   ! Spec scenario-adjacent: a declared Handler that fails more than one
   ! check gets every violation in one report, not just the first found.
   ! CallbackArgumentSpecMap is a gFTL ordered map keyed by argument name
   ! (gFTL2's map/template.inc), so the two violations' relative order in
   ! the report is deterministic, alphabetical by argument name
   ! ('tracers' before 'weight') - asserted exactly, not tolerated either
   ! way.
   @test(npes=[0])
   subroutine test_resolve_callback_import_declared_multi_violation_fail(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, bad_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: bad_spec
      type(VariableSpec) :: bad_export
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(CallbackContractViolation) :: expected_violations(2)
      character(:), allocatable :: handler_name
      character(:), allocatable :: expected_message
      logical :: matched
      integer :: status
      type(GraphBuilder) :: gb

      call build_handler_hierarchy('decl-multi', root_gc, root_meta, chem_meta, bad_meta, _RC)

      iface = make_surface_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-decl-multi', iface, interface_id, status)
      @assert_that(status, is(0))

      bad_export = make_surface_tracer_export('tracer_callback', include_tracers=.false., &
           include_weight=.false.)
      bad_export%callback_interface_id = interface_id
      bad_spec => bad_meta%get_component_spec()
      call bad_spec%add_var_spec(bad_export)

      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      handler_name = bad_meta%get_name(status)
      @assert_that(status, is(0))

      expected_violations(1) = missing_argument_violation('tracers')
      expected_violations(2) = missing_argument_violation('weight')
      expected_message = format_callback_contract_report('svc-decl-multi', iface%get_version(), &
           handler_name, 'tracer_callback', expected_violations)

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)

      ! The pending exception must be drained here, before any plain
      ! @assertTrue/@assert_that: those expand to code that returns
      ! early whenever an exception is still queued, which would skip
      ! anything after it.
      matched = catch(expected_message)
      do while (catch('status=1'))
      end do
      @assertTrue(matched)
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_declared_multi_violation_fail

   ! An export that self-declares a *different* callback interface than
   ! the one being resolved must not be silently collected just because
   ! its shape happens to fit -
   ! resolve_callback_import skips it before even calling
   ! export_conforms_to_interface against the expected interface, with a
   ! distinct 'declares_other_interface:<name>' rejection reason (not a
   ! hard failure; connect keeps looking for other candidates). Here the
   ! export's shape (a bare 'tracers' member) happens to be a structural
   ! subset of the expected interface's own shape, which must not matter.
   @test(npes=[0])
   subroutine test_resolve_callback_import_declares_other_iface_skip(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, bad_meta
      type(CallbackInterface) :: other_iface, expected_iface
      type(CallbackInterfaceId) :: other_id, expected_id
      type(ComponentSpec), pointer :: bad_spec
      type(VariableSpec) :: bad_export
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(StringVector) :: rejected
      integer :: status
      type(GraphBuilder) :: gb

      call build_handler_hierarchy('decl-other', root_gc, root_meta, chem_meta, bad_meta, _RC)

      other_iface = make_passive_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-other-decl', other_iface, other_id, status)
      @assert_that(status, is(0))

      expected_iface = make_surface_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-expected-decl', expected_iface, expected_id, status)
      @assert_that(status, is(0))

      ! Shaped for PassiveTracer (other_id): one 'tracers' member, no
      ! 'weight' - a structural subset of the surface-tracer interface's
      ! own shape too, so a shape-only check would wrongly let it through.
      bad_export = make_tracer_callback_export('tracer_callback')
      bad_export%callback_interface_id = other_id
      bad_spec => bad_meta%get_component_spec()
      call bad_spec%add_var_spec(bad_export)

      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      matches = resolve_callback_import(root_meta, src_pt, expected_id, rejected=rejected, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, size(matches))
      @assertEqual(1, rejected%size())
      @assertEqual('BAD/tracer_callback:declares_other_interface:svc-other-decl', rejected%of(1))

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_declares_other_iface_skip

   ! One undeclared, non-conforming export (skip-and-report, as before)
   ! alongside one declared, conforming export resolved in the same
   ! call: only a declared-and-nonconforming candidate is fatal - neither
   ! an undeclared mismatch nor a declared match affects the other.
   @test(npes=[0])
   subroutine test_resolve_callback_import_mixed_candidates(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, h1_meta, h2_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: h1_spec, h2_spec
      type(VariableSpec) :: h1_export, h2_export
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(StringVector) :: rejected
      integer :: status
      type(GraphBuilder) :: gb

      call build_two_handler_hierarchy('mixed', root_gc, root_meta, chem_meta, h1_meta, h2_meta, _RC)

      iface = make_surface_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-mixed', iface, interface_id, status)
      @assert_that(status, is(0))

      ! H1: undeclared, missing both required members.
      h1_export = make_surface_tracer_export('tracer_callback', include_tracers=.false., &
           include_weight=.false.)
      h1_spec => h1_meta%get_component_spec()
      call h1_spec%add_var_spec(h1_export)

      ! H2: declares the interface and conforms.
      h2_export = make_surface_tracer_export('tracer_callback', include_tracers=.true., &
           include_weight=.true., weight_stagger=VERTICAL_STAGGER_NONE)
      h2_export%callback_interface_id = interface_id
      h2_spec => h2_meta%get_component_spec()
      call h2_spec%add_var_spec(h2_export)

      call gb%advertise(h1_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(h2_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rejected=rejected, rc=status)
      @assert_that(status, is(0))
      @assertEqual(1, size(matches))
      @assertEqual('H2/tracer_callback', matches(1)%qualified_name)
      @assertEqual(1, rejected%size())
      @assertEqual('H1/tracer_callback:missing_member:tracers; missing_member:weight', rejected%of(1))

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_mixed_candidates

   ! Regression coverage for the member_dims bug where dims were read
   ! from a member's vertical_grid, a field parse_var_specs never sets on
   ! a plain member: the 'weight' member here is built through
   ! parse_var_specs itself (YAML 'vertical_dim_spec: center'), the way a
   ! real Handler's composite member would be, rather than hand-set.
   @test(npes=[0])
   subroutine test_resolve_callback_import_parsed_member_conforms(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, bad_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: bad_spec
      type(VariableSpec) :: bad_export, tracers_member, weight_member
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      integer :: status
      type(GraphBuilder) :: gb

      call build_handler_hierarchy('decl-parsed', root_gc, root_meta, chem_meta, bad_meta, _RC)

      ! make_profile_tracer_interface expects 'weight' dims='xyz'.
      iface = make_profile_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-decl-parsed', iface, interface_id, status)
      @assert_that(status, is(0))

      bad_export = make_var(ESMF_STATEINTENT_EXPORT, 'tracer_callback')
      bad_export%itemType = MAPL_STATEITEM_STATE

      tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers')
      tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call bad_export%declare_member('tracers', tracers_member, rc=status)
      @assert_that(status, is(0))

      weight_member = make_parsed_field_member('weight', 'center', status)
      @assert_that(status, is(0))
      call bad_export%declare_member('weight', weight_member, rc=status)
      @assert_that(status, is(0))

      bad_export%callback_interface_id = interface_id
      bad_spec => bad_meta%get_component_spec()
      call bad_spec%add_var_spec(bad_export)

      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)
      @assert_that(status, is(0))
      @assertEqual(1, size(matches))
      @assertEqual('BAD/tracer_callback', matches(1)%qualified_name)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_parsed_member_conforms

   ! Spec "Descendant exports are visible under a
   ! hierarchically-qualified name": own export under own name,
   ! descendant exports qualified and distinguishable, re-querying does
   ! not duplicate.
   @test(npes=[0])
   subroutine test_build_qualified_export_namespace_multilevel(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, du_driver, ss_driver
      type(ESMF_GridComp) :: chem_gc, du_gc, ss_gc
      type(OuterMetaComponent), pointer :: chem_meta, du_meta, ss_meta
      type(ComponentSpec), pointer :: chem_spec, du_spec, ss_spec
      type(QualifiedExportEntry), allocatable :: entries(:), entries_again(:)
      integer :: status
      type(GraphBuilder) :: gb
      logical :: found_own, found_du, found_ss
      integer :: i

      call make_outer_meta('ns_root', root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)
      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)

      chem_spec => chem_meta%get_component_spec()
      call chem_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'Y'))

      child_spec = ChildSpec()
      call chem_meta%add_child('DU', child_spec, _RC)
      child_spec = ChildSpec()
      call chem_meta%add_child('SS', child_spec, _RC)

      du_driver = chem_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)
      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'X'))

      ss_driver = chem_meta%get_child('SS', _RC)
      ss_gc = ss_driver%get_gridcomp()
      ss_meta => get_outer_meta(ss_gc, _RC)
      ss_spec => ss_meta%get_component_spec()
      call ss_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'X'))

      call gb%advertise(du_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(ss_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))

      entries = build_qualified_export_namespace(chem_meta, status)
      @assert_that(status, is(0))
      @assertEqual(3, size(entries))

      found_own = .false.
      found_du = .false.
      found_ss = .false.
      do i = 1, size(entries)
         if (entries(i)%qualified_name == 'Y' .and. len(entries(i)%comp_path) == 0) found_own = .true.
         if (entries(i)%qualified_name == 'DU/X') found_du = .true.
         if (entries(i)%qualified_name == 'SS/X') found_ss = .true.
      end do
      @assert_that(found_own, is(true()))
      @assert_that(found_du, is(true()))
      @assert_that(found_ss, is(true()))

      entries_again = build_qualified_export_namespace(chem_meta, status)
      @assert_that(status, is(0))
      @assertEqual(size(entries), size(entries_again))

      _UNUSED_DUMMY(this)
   end subroutine test_build_qualified_export_namespace_multilevel

   ! Cross-check: the graph-native qualified
   ! name for a descendant export matches what
   ! VirtualConnectionPt%get_full_name() would produce for the same
   ! single-level case.
   @test(npes=[0])
   subroutine test_qualified_name_matches_virtualconnectionpt_convention(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: du_driver
      type(ESMF_GridComp) :: du_gc
      type(OuterMetaComponent), pointer :: du_meta
      type(ComponentSpec), pointer :: du_spec
      type(QualifiedExportEntry), allocatable :: entries(:)
      type(VirtualConnectionPt) :: expected_v_pt
      integer :: status
      type(GraphBuilder) :: gb
      integer :: i
      logical :: found

      call make_outer_meta('ns_crosscheck_root', root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('DU', child_spec, _RC)
      du_driver = root_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)
      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'tracers'))

      call gb%advertise(du_meta, status)
      @assert_that(status, is(0))

      entries = build_qualified_export_namespace(root_meta, status)
      @assert_that(status, is(0))

      expected_v_pt = VirtualConnectionPt(state_intent='export', short_name='tracers')
      expected_v_pt = expected_v_pt%add_comp_name('DU')

      found = .false.
      do i = 1, size(entries)
         if (entries(i)%comp_path == 'DU') then
            @assertEqual(expected_v_pt%get_full_name(), entries(i)%qualified_name)
            found = .true.
         end if
      end do
      @assert_that(found, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_qualified_name_matches_virtualconnectionpt_convention

   ! The argument NodeIds bound by build_callback_state_binding match the
   ! real, already-materialized member NodeIds in the DU graph - not
   ! caller-supplied stand-ins.
   @test(npes=[0])
   subroutine test_build_callback_state_binding_uses_real_member_nodeids(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, du_meta, ss_meta, dyn_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(CallbackStateBinding) :: binding
      type(ComponentGraph), pointer :: du_graph
      class(GraphNode), pointer :: du_node
      type(GraphStateItem), pointer :: du_payload
      type(StateItemMemberMap), pointer :: du_members
      type(NodeId), pointer :: expected_member_id
      type(NodeId), pointer :: bound_member_id
      type(NodeId), pointer :: du_state_id
      integer :: status
      integer :: i
      integer :: du_index

      call build_tracer_hierarchy('svc-6-2', root_gc, root_meta, chem_meta, du_meta, ss_meta, &
           dyn_meta, iface, interface_id, _RC)

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)
      @assert_that(status, is(0))

      du_index = 0
      do i = 1, size(matches)
         if (matches(i)%qualified_name == 'DU/tracer_callback') du_index = i
      end do
      @assert_that(du_index > 0, is(true()))

      binding = build_callback_state_binding(root_meta, 'CHEM', matches(du_index), interface_id, iface, status)
      @assert_that(status, is(0))

      du_graph => du_meta%get_component_graph()
      du_state_id => du_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'tracer_callback'))
      @assert_that(associated(du_state_id), is(true()))
      du_node => du_graph%get_node(du_state_id)
      select type (du_node)
      class is (StateItemNode)
         du_payload => du_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      du_members => du_payload%state_members_ptr()
      expected_member_id => du_members%at('tracers')
      @assert_that(associated(expected_member_id), is(true()))

      bound_member_id => binding%get_argument_binding('tracers')
      @assert_that(associated(bound_member_id), is(true()))
      @assert_that(bound_member_id == expected_member_id, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_build_callback_state_binding_uses_real_member_nodeids

   ! Spec "Get and put networks are independently
   ! constructed" + "Each network is acyclic on its own even if their
   ! union is not": a single shared provider item feeds "get" and
   ! receives "put" - provider->value->provider would be a 2-cycle if
   ! the two networks were merged, but each network alone has only one
   ! edge.
   @test(npes=[0])
   subroutine test_callback_method_binding_builds_get_put_networks(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: exchanger_export, exchanger_member, provider_var
      type(NodeId) :: state_node_id
      type(NodeId), pointer :: member_node_id
      type(NodeId) :: provider_id
      type(GraphStateItem), pointer :: payload
      class(GraphNode), pointer :: node
      type(StateItemMemberMap), pointer :: members
      type(StateItemMemberMap) :: provider_get_ids, provider_put_ids
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(CallbackStateBinding) :: state_binding
      type(CallbackMethodBinding) :: method_binding
      type(DependencyNetwork), pointer :: get_net, put_net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_exchanger', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      exchanger_export = make_var(ESMF_STATEINTENT_EXPORT, 'exchanger')
      exchanger_export%itemType = MAPL_STATEITEM_STATE
      exchanger_member = make_var(ESMF_STATEINTENT_EXPORT, 'value')
      exchanger_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      ! Same quantity type on both sides (an unset one is DEFERRED on an
      ! EXPORT, and wire_callback_argument fails loudly on a DEFERRED pair
      ! rather than waiting for it to resolve), so this test exercises an
      ! exact-match wire, not a mismatch.
      exchanger_member%quantity_type = QUANTITY_TEMPERATURE
      call exchanger_export%declare_member('value', exchanger_member, rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(exchanger_export)

      provider_var = make_var(ESMF_STATEINTENT_EXPORT, 'provider_shared')
      ! Same item class as exchanger_member (FIELDBUNDLE): a member's
      ! descriptor carries its real item class, so a FIELD-vs-FIELDBUNDLE
      ! pair here is a genuine ITEM_SHAPE mismatch with no build_transform
      ! (ItemShapeCharacteristic's shape matrix reports it SHAPE_INCOMPATIBLE),
      ! not something wire_callback_argument should paper over; match classes
      ! so this test keeps exercising exact-match wiring, as it always
      ! intended.
      provider_var%itemType = MAPL_STATEITEM_FIELDBUNDLE
      provider_var%quantity_type = QUANTITY_TEMPERATURE
      call comp_spec%add_var_spec(provider_var)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      state_node_id = graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'exchanger'))
      node => graph%get_node(state_node_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      members => payload%state_members_ptr()
      member_node_id => members%at('value')
      @assert_that(associated(member_node_id), is(true()))

      iface = make_exchanger_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-7-3', iface, interface_id, status)
      @assert_that(status, is(0))

      state_binding = CallbackStateBinding(interface_id, iface, state_node_id)
      call state_binding%bind_argument('value', member_node_id, status)
      @assert_that(status, is(0))
      call state_binding%bind_method('exchange', status)
      @assert_that(status, is(0))

      provider_id = graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'provider_shared'))
      call provider_get_ids%insert('value', provider_id)
      call provider_put_ids%insert('value', provider_id)

      method_binding = build_callback_method_binding(outer_meta, 'cb', iface, 'exchange', state_binding, &
           provider_get_ids, provider_put_ids, status)
      @assert_that(status, is(0))

      get_net => graph%get_network(graph%get_forward_network_id())
      put_net => graph%get_network(method_binding%get_put_network_id())
      @assert_that(associated(get_net), is(true()))
      @assert_that(associated(put_net), is(true()))

      ! Get edge in the forward network, put edge only in the put network.
      @assert_that(get_net%contains_dependency(provider_id, member_node_id), is(true()))
      @assert_that(get_net%contains_dependency(member_node_id, provider_id), is(false()))
      @assert_that(put_net%contains_dependency(member_node_id, provider_id), is(true()))

      ! Each network individually acyclic: the graph freeze validates the
      ! put network, the forward freeze validates the forward network.
      call graph%freeze(status)
      @assert_that(status, is(0))
      call graph%freeze_forward_network(status)
      @assert_that(status, is(0))

      _UNUSED_DUMMY(this)
   end subroutine test_callback_method_binding_builds_get_put_networks

   ! A DEFERRED characteristic (here the provider's unset quantity_type) is
   ! not a mismatch to extend or silently skip; it is a caller-ordering bug,
   ! and wire_callback_argument fails loudly instead of waiting, since it
   ! has no later-connect-pass retry.
   @test(npes=[0])
   subroutine test_callback_method_binding_fails_on_deferred_characteristic(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: exchanger_export, exchanger_member
      type(NodeId) :: state_node_id
      type(NodeId), pointer :: member_node_id
      type(NodeId) :: provider_id
      type(GraphStateItem), pointer :: payload
      class(GraphNode), pointer :: node
      type(StateItemMemberMap), pointer :: members
      type(StateItemMemberMap) :: provider_get_ids, provider_put_ids
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(CallbackStateBinding) :: state_binding
      type(CallbackMethodBinding) :: method_binding
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_exchanger_deferred', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      exchanger_export = make_var(ESMF_STATEINTENT_EXPORT, 'exchanger')
      exchanger_export%itemType = MAPL_STATEITEM_STATE
      exchanger_member = make_var(ESMF_STATEINTENT_EXPORT, 'value')
      exchanger_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      exchanger_member%quantity_type = QUANTITY_TEMPERATURE
      call exchanger_export%declare_member('value', exchanger_member, rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(exchanger_export)

      ! provider_shared's quantity_type stays unset (DEFERRED on an
      ! EXPORT), unlike the member's - an asymmetric DEFERRED pair, not a
      ! real mismatch between two declared values.
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'provider_shared'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      state_node_id = graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'exchanger'))
      node => graph%get_node(state_node_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      members => payload%state_members_ptr()
      member_node_id => members%at('value')
      @assert_that(associated(member_node_id), is(true()))

      iface = make_exchanger_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-6-1-deferred', iface, interface_id, status)
      @assert_that(status, is(0))

      state_binding = CallbackStateBinding(interface_id, iface, state_node_id)
      call state_binding%bind_argument('value', member_node_id, status)
      @assert_that(status, is(0))
      call state_binding%bind_method('exchange', status)
      @assert_that(status, is(0))

      provider_id = graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'provider_shared'))
      call provider_get_ids%insert('value', provider_id)
      call provider_put_ids%insert('value', provider_id)

      method_binding = build_callback_method_binding(outer_meta, 'cb', iface, 'exchange', state_binding, &
           provider_get_ids, provider_put_ids, status)
      @assertExceptionRaised('GraphBuilder: wire_callback_argument - a characteristic is still unresolved ' // &
           '(DEFERRED); callback binding must run after ordinary connections resolve')
      @assertExceptionRaised('status=1')
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_callback_method_binding_fails_on_deferred_characteristic

   ! The sole predecessor of `id` in `net`, or an invalid NodeId if there
   ! is not exactly one (mirrors Test_GraphBuilder_ConnectionResolution.pf's
   ! own sole_predecessor_of/single_predecessor helpers, duplicated here
   ! rather than shared since neither file factors test helpers out).
   function callback_regrid_predecessor(net, id) result(pred_id)
      type(DependencyNetwork), intent(in) :: net
      type(NodeId), intent(in) :: id
      type(NodeId) :: pred_id

      type(NodeIdSet), target :: preds
      type(NodeIdSetIterator) :: iter

      preds = net%get_predecessors(id)
      if (preds%size() /= 1) return
      iter = preds%ftn_begin()
      call iter%next()
      pred_id = iter%of()
   end function callback_regrid_predecessor

   ! wire_callback_argument compares real member/provider descriptors: the
   ! 'value' member (Handler side) and 'provider_shared' (modeling the
   ! Invoker-side copy) sit on different grids and the provider declares the
   ! default first-order-conservative regrid param, the way an ordinary
   ! connection's VariableSpec%regrid_param would. Both the get edge
   ! (forward network) and the put edge (put network) get a real
   ! HorizontalRegridTransform, not a direct dependency, and the transform
   ! carries the conservative param.
   @test(npes=[0])
   subroutine test_callback_method_binding_wires_cross_grid_regrid(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: exchanger_export, exchanger_member, provider_var
      type(NodeId) :: state_node_id
      type(NodeId), pointer :: member_node_id
      type(NodeId) :: provider_id
      type(GraphStateItem), pointer :: payload
      class(GraphNode), pointer :: node
      type(StateItemMemberMap), pointer :: members
      type(StateItemMemberMap) :: provider_get_ids, provider_put_ids
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(CallbackStateBinding) :: state_binding
      type(CallbackMethodBinding) :: method_binding
      type(DependencyNetwork), pointer :: get_net, put_net
      type(ESMF_Grid) :: grid_member, grid_provider
      type(ESMF_Geom) :: geom_member, geom_provider
      type(NodeId) :: get_result_id, put_result_id
      type(NodeId) :: get_transform_id, put_transform_id
      class(Transform), pointer :: transformer
      type(EsmfRegridderParam) :: regridder_param
      integer :: status
      type(GraphBuilder) :: gb

      grid_member = ESMF_GridCreateNoPeriDim(maxIndex=[2, 2], rc=status)
      @assert_that(status, is(0))
      geom_member = ESMF_GeomCreate(grid_member, rc=status)
      @assert_that(status, is(0))
      call GeomSetId(geom_member, 601, rc=status)
      @assert_that(status, is(0))

      grid_provider = ESMF_GridCreateNoPeriDim(maxIndex=[3, 3], rc=status)
      @assert_that(status, is(0))
      geom_provider = ESMF_GeomCreate(grid_provider, rc=status)
      @assert_that(status, is(0))
      call GeomSetId(geom_provider, 602, rc=status)
      @assert_that(status, is(0))

      call make_outer_meta('comp_exchanger_regrid', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      exchanger_export = make_var(ESMF_STATEINTENT_EXPORT, 'exchanger')
      exchanger_export%itemType = MAPL_STATEITEM_STATE
      exchanger_member = make_var(ESMF_STATEINTENT_EXPORT, 'value')
      exchanger_member%geom = geom_member
      exchanger_member%geom_id = mapl_new_GeomId(601)
      ! Same quantity type on both sides so only GEOMETRY_CHARACTERISTIC_KIND
      ! mismatches below; an unset quantity type is DEFERRED on an EXPORT,
      ! and wire_callback_argument fails loudly on any DEFERRED
      ! characteristic rather than reporting a mismatch for it.
      exchanger_member%quantity_type = QUANTITY_TEMPERATURE
      call exchanger_export%declare_member('value', exchanger_member, rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(exchanger_export)

      ! Models the future Invoker-side copy (that creator does not exist
      ! yet): a plain export holding its own geom and the conservative
      ! default regrid param.
      provider_var = make_var(ESMF_STATEINTENT_EXPORT, 'provider_shared')
      provider_var%geom = geom_provider
      provider_var%geom_id = mapl_new_GeomId(602)
      provider_var%quantity_type = QUANTITY_TEMPERATURE
      provider_var%regrid_param = EsmfRegridderParam(regridmethod=ESMF_REGRIDMETHOD_CONSERVE)
      call comp_spec%add_var_spec(provider_var)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      state_node_id = graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'exchanger'))
      node => graph%get_node(state_node_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      members => payload%state_members_ptr()
      member_node_id => members%at('value')
      @assert_that(associated(member_node_id), is(true()))

      iface = make_exchanger_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-6-1-regrid', iface, interface_id, status)
      @assert_that(status, is(0))

      state_binding = CallbackStateBinding(interface_id, iface, state_node_id)
      call state_binding%bind_argument('value', member_node_id, status)
      @assert_that(status, is(0))
      call state_binding%bind_method('exchange', status)
      @assert_that(status, is(0))

      provider_id = graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'provider_shared'))
      call provider_get_ids%insert('value', provider_id)
      call provider_put_ids%insert('value', provider_id)

      method_binding = build_callback_method_binding(outer_meta, 'cb', iface, 'exchange', state_binding, &
           provider_get_ids, provider_put_ids, status)
      @assert_that(status, is(0))

      get_net => graph%get_network(graph%get_forward_network_id())
      put_net => graph%get_network(method_binding%get_put_network_id())
      @assert_that(associated(get_net), is(true()))
      @assert_that(associated(put_net), is(true()))

      ! No direct edge either direction: a regrid transform sits between
      ! the provider (Invoker-side copy) and the member (Handler argument).
      @assert_that(get_net%contains_dependency(provider_id, member_node_id), is(false()))
      @assert_that(put_net%contains_dependency(member_node_id, provider_id), is(false()))

      ! Get direction: provider -> transform -> result (a new StateItemNode
      ! carrying the member's goal geometry, ExtensionResolution.F90's
      ! build_chain) -> member. Same two-hop shape as an ordinary connection's
      ! extension chain (Test_GraphBuilder_ConnectionResolution.pf's
      ! sole_predecessor_of(sole_predecessor_of(...))).
      get_result_id = callback_regrid_predecessor(get_net, member_node_id)
      @assert_that(get_result_id%is_valid(), is(true()))
      get_transform_id = callback_regrid_predecessor(get_net, get_result_id)
      @assert_that(get_transform_id%is_valid(), is(true()))
      @assert_that(get_net%contains_dependency(provider_id, get_transform_id), is(true()))
      node => graph%get_node(get_transform_id)
      select type (node)
      class is (TransformGraphNode)
         transformer => node%get_transformer()
      class default
         @assert_that(.false., is(true()))
      end select
      select type (transformer)
      class is (HorizontalRegridTransform)
         regridder_param = transformer%get_regridder_param()
         @assert_that(regridder_param%is_conservative(), is(true()))
      class default
         @assert_that(.false., is(true()))
      end select

      ! Put direction: member -> transform -> result -> provider.
      put_result_id = callback_regrid_predecessor(put_net, provider_id)
      @assert_that(put_result_id%is_valid(), is(true()))
      put_transform_id = callback_regrid_predecessor(put_net, put_result_id)
      @assert_that(put_transform_id%is_valid(), is(true()))
      @assert_that(put_net%contains_dependency(member_node_id, put_transform_id), is(true()))
      node => graph%get_node(put_transform_id)
      select type (node)
      class is (TransformGraphNode)
         transformer => node%get_transformer()
      class default
         @assert_that(.false., is(true()))
      end select
      select type (transformer)
      class is (HorizontalRegridTransform)
         regridder_param = transformer%get_regridder_param()
         @assert_that(regridder_param%is_conservative(), is(true()))
      class default
         @assert_that(.false., is(true()))
      end select

      ! Each network individually acyclic, same freeze checks as the
      ! same-grid counterpart above.
      call graph%freeze(status)
      @assert_that(status, is(0))
      call graph%freeze_forward_network(status)
      @assert_that(status, is(0))

      _UNUSED_DUMMY(this)
   end subroutine test_callback_method_binding_wires_cross_grid_regrid

   ! -- Same-named Handlers merge through re-export, not a subtree search --
   !
   ! Builds root -> CHEM -> {H1, H2} (build_two_handler_hierarchy), gives
   ! H1 and H2 each an export named short_name declaring interface_id, and
   ! advertises H1 and H2 (not CHEM or root - matching
   ! test_reexport_child_export_and_chain's precedent: the caller adds its
   ! own ReexportConnections to chem_meta's/root_meta's ComponentSpec and
   ! calls gb%run_reexport_hook() explicitly, since advertise() alone does
   ! not run a component's own reexport hook for a meta that is never
   ! itself advertised).
   subroutine build_reexport_merge_hierarchy(label, short_name, root_gc, root_meta, chem_meta, h1_meta, h2_meta, &
        iface, interface_id, rc)
      character(*), intent(in) :: label
      character(*), intent(in) :: short_name
      type(ESMF_GridComp), intent(out) :: root_gc
      type(OuterMetaComponent), pointer, intent(out) :: root_meta
      type(OuterMetaComponent), pointer, intent(out) :: chem_meta
      type(OuterMetaComponent), pointer, intent(out) :: h1_meta
      type(OuterMetaComponent), pointer, intent(out) :: h2_meta
      type(CallbackInterface), intent(out) :: iface
      type(CallbackInterfaceId), intent(out) :: interface_id
      integer, optional, intent(out) :: rc

      integer :: status
      type(ComponentSpec), pointer :: h1_spec, h2_spec
      type(VariableSpec) :: h1_export, h2_export
      type(GraphBuilder) :: gb

      call build_two_handler_hierarchy(label, root_gc, root_meta, chem_meta, h1_meta, h2_meta, _RC)

      iface = make_passive_tracer_interface(_RC)
      call register_callback_interface(label, iface, interface_id, _RC)

      h1_export = make_tracer_callback_export(short_name)
      h1_export%callback_interface_id = interface_id
      h1_spec => h1_meta%get_component_spec()
      call h1_spec%add_var_spec(h1_export)

      h2_export = make_tracer_callback_export(short_name)
      h2_export%callback_interface_id = interface_id
      h2_spec => h2_meta%get_component_spec()
      call h2_spec%add_var_spec(h2_export)

      call gb%advertise(h1_meta, _RC)
      call gb%advertise(h2_meta, _RC)

      _RETURN(_SUCCESS)
   end subroutine build_reexport_merge_hierarchy

   ! Adds a ReexportConnection (src_comp/src_name export -> <self>/dst_name
   ! export) to owner_meta's own ComponentSpec - the YAML shape is
   ! `{src_name: X, src_intent: export, src_comp: child, dst_name: X,
   ! dst_comp: <self>, dst_intent: export}` (scenario_reexport_twice).
   subroutine add_reexport(owner_meta, src_comp, src_name, dst_name)
      type(OuterMetaComponent), pointer, intent(in) :: owner_meta
      character(*), intent(in) :: src_comp
      character(*), intent(in) :: src_name
      character(*), intent(in) :: dst_name

      type(ComponentSpec), pointer :: owner_spec
      type(ReexportConnection) :: conn

      conn = ReexportConnection( &
           ConnectionPt(src_comp, VirtualConnectionPt(state_intent='export', short_name=src_name)), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name=dst_name)))
      owner_spec => owner_meta%get_component_spec()
      call owner_spec%add_connection(conn)
   end subroutine add_reexport

   ! H1 and H2 each re-export their own 'MIXING_CB' up to CHEM's own
   ! export 'MIXING_CB': both declare interface_id, so reexport_add_or_merge
   ! merges the second under the name already taken by the first instead
   ! of failing. A plain-name callback import rooted at CHEM then collects
   ! both.
   @test(npes=[0])
   subroutine test_reexport_merge_collects_both_sources(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, h1_meta, h2_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      logical :: found_h1, found_h2
      integer :: status
      integer :: i
      type(GraphBuilder) :: gb

      call build_reexport_merge_hierarchy('svc-5-1d-merge', 'MIXING_CB', root_gc, root_meta, chem_meta, &
           h1_meta, h2_meta, iface, interface_id, _RC)

      call add_reexport(chem_meta, 'H1', 'MIXING_CB', 'MIXING_CB')
      call add_reexport(chem_meta, 'H2', 'MIXING_CB', 'MIXING_CB')
      call gb%run_reexport_hook(chem_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='MIXING_CB'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)
      @assert_that(status, is(0))
      @assertEqual(2, size(matches))

      found_h1 = .false.
      found_h2 = .false.
      do i = 1, size(matches)
         if (matches(i)%qualified_name == 'H1/MIXING_CB') found_h1 = .true.
         if (matches(i)%qualified_name == 'H2/MIXING_CB') found_h2 = .true.
      end do
      @assert_that(found_h1, is(true()))
      @assert_that(found_h2, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_reexport_merge_collects_both_sources

   ! Same hierarchy as test_reexport_merge_collects_both_sources but
   ! without the re-exports: the plain-name callback import at CHEM finds
   ! nothing, proving resolve_callback_import does not search CHEM's
   ! descendants by bare name - only exports CHEM itself carries (directly
   ! or via re-export) are candidates.
   @test(npes=[0])
   subroutine test_reexport_merge_without_reexport_finds_nothing(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, h1_meta, h2_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      integer :: status

      call build_reexport_merge_hierarchy('svc-5-1d-nomerge', 'MIXING_CB', root_gc, root_meta, chem_meta, &
           h1_meta, h2_meta, iface, interface_id, _RC)

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='MIXING_CB'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, size(matches))

      _UNUSED_DUMMY(this)
   end subroutine test_reexport_merge_without_reexport_finds_nothing

   ! H1 and H2 declare DIFFERENT callback interfaces under the same
   ! 'MIXING_CB' export name: CHEM's second re-export is not mergeable
   ! (callback_exports_mergeable requires the SAME callback_interface_id),
   ! so it fails with the 'Re-export destination already exists' message.
   @test(npes=[0])
   subroutine test_reexport_merge_different_interfaces_fails(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, h1_meta, h2_meta
      type(CallbackInterface) :: iface1, iface2
      type(CallbackInterfaceId) :: interface_id1, interface_id2
      type(ComponentSpec), pointer :: h2_spec
      type(VariableSpec) :: h2_export
      integer :: status
      type(GraphBuilder) :: gb

      call build_two_handler_hierarchy('svc-5-1d-diff-iface', root_gc, root_meta, chem_meta, h1_meta, h2_meta, _RC)

      iface1 = make_passive_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-5-1d-diff-iface-1', iface1, interface_id1, status)
      @assert_that(status, is(0))

      iface2 = make_surface_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-5-1d-diff-iface-2', iface2, interface_id2, status)
      @assert_that(status, is(0))

      call h1_spec_add_export(h1_meta, 'MIXING_CB', interface_id1)

      h2_export = make_tracer_callback_export('MIXING_CB')
      h2_export%callback_interface_id = interface_id2
      h2_spec => h2_meta%get_component_spec()
      call h2_spec%add_var_spec(h2_export)

      call gb%advertise(h1_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(h2_meta, status)
      @assert_that(status, is(0))

      call add_reexport(chem_meta, 'H1', 'MIXING_CB', 'MIXING_CB')
      call add_reexport(chem_meta, 'H2', 'MIXING_CB', 'MIXING_CB')
      call gb%run_reexport_hook(chem_meta, status)
      @assertExceptionRaised('Re-export destination already exists: MIXING_CB')
      @assertExceptionRaised('status=1')

      _UNUSED_DUMMY(this)
   end subroutine test_reexport_merge_different_interfaces_fails

   ! H1 declares interface_id; H2's export of the same name is a plain
   ! (non-callback) export with no callback_interface_id. Merging a
   ! callback export with a non-callback export under the same name still
   ! fails: callback_exports_mergeable requires both sides to declare a
   ! VALID callback_interface_id.
   @test(npes=[0])
   subroutine test_reexport_merge_non_callback_export_fails(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, h1_meta, h2_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: h2_spec
      integer :: status
      type(GraphBuilder) :: gb

      call build_two_handler_hierarchy('svc-5-1d-non-cb', root_gc, root_meta, chem_meta, h1_meta, h2_meta, _RC)

      iface = make_passive_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-5-1d-non-cb', iface, interface_id, status)
      @assert_that(status, is(0))

      call h1_spec_add_export(h1_meta, 'MIXING_CB', interface_id)

      h2_spec => h2_meta%get_component_spec()
      call h2_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'MIXING_CB'))

      call gb%advertise(h1_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(h2_meta, status)
      @assert_that(status, is(0))

      call add_reexport(chem_meta, 'H1', 'MIXING_CB', 'MIXING_CB')
      call add_reexport(chem_meta, 'H2', 'MIXING_CB', 'MIXING_CB')
      call gb%run_reexport_hook(chem_meta, status)
      @assertExceptionRaised('Re-export destination already exists: MIXING_CB')
      @assertExceptionRaised('status=1')

      _UNUSED_DUMMY(this)
   end subroutine test_reexport_merge_non_callback_export_fails

   ! CHEM merges H1's and H2's 'MIXING_CB' (as in
   ! test_reexport_merge_collects_both_sources), then root re-exports
   ! CHEM's already-merged 'MIXING_CB' one level further, to root's own
   ! export under the same name. A plain-name callback import rooted at
   ! root collects both original sources, not just the first re-export
   ! found - reexport_one's find_export_port_node_ids(src_graph, src_name)
   ! on CHEM's graph returns both, and reexport_add_or_merge carries each
   ! one up individually.
   @test(npes=[0])
   subroutine test_reexport_merge_carries_both_sources_one_level_up(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, h1_meta, h2_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      logical :: found_h1, found_h2
      integer :: status
      integer :: i
      type(GraphBuilder) :: gb

      call build_reexport_merge_hierarchy('svc-5-1d-up', 'MIXING_CB', root_gc, root_meta, chem_meta, &
           h1_meta, h2_meta, iface, interface_id, _RC)

      call add_reexport(chem_meta, 'H1', 'MIXING_CB', 'MIXING_CB')
      call add_reexport(chem_meta, 'H2', 'MIXING_CB', 'MIXING_CB')
      call gb%run_reexport_hook(chem_meta, status)
      @assert_that(status, is(0))

      call add_reexport(root_meta, 'CHEM', 'MIXING_CB', 'MIXING_CB')
      call gb%run_reexport_hook(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='MIXING_CB'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)
      @assert_that(status, is(0))
      @assertEqual(2, size(matches))

      found_h1 = .false.
      found_h2 = .false.
      do i = 1, size(matches)
         if (matches(i)%qualified_name == 'CHEM/H1/MIXING_CB') found_h1 = .true.
         if (matches(i)%qualified_name == 'CHEM/H2/MIXING_CB') found_h2 = .true.
      end do
      @assert_that(found_h1, is(true()))
      @assert_that(found_h2, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_reexport_merge_carries_both_sources_one_level_up

   ! Adds a declared tracer-callback export named short_name, declaring
   ! interface_id, to meta's ComponentSpec - factored out of the
   ! "different interface"/"non-callback" merge-failure tests above, which
   ! each need exactly one declared Handler plus one differently-shaped
   ! second export under the same name.
   subroutine h1_spec_add_export(meta, short_name, interface_id)
      type(OuterMetaComponent), pointer, intent(in) :: meta
      character(*), intent(in) :: short_name
      type(CallbackInterfaceId), intent(in) :: interface_id

      type(ComponentSpec), pointer :: spec
      type(VariableSpec) :: export

      export = make_tracer_callback_export(short_name)
      export%callback_interface_id = interface_id
      spec => meta%get_component_spec()
      call spec%add_var_spec(export)
   end subroutine h1_spec_add_export

   ! A regex src_name is unaffected by the merge rule: is_literal() is
   ! false for '^MIXING_CB$' (it contains ERE metacharacters), so only the
   ! anchored-regex match against the full qualified name applies - it
   ! never matches a descendant's qualified name (always comp-prefixed),
   ! merged or not, regardless of the re-exports below CHEM.
   @test(npes=[0])
   subroutine test_resolve_callback_import_regex_unaffected_by_merge(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, h1_meta, h2_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      integer :: status
      type(GraphBuilder) :: gb

      call build_reexport_merge_hierarchy('svc-5-1d-regex', 'MIXING_CB', root_gc, root_meta, chem_meta, &
           h1_meta, h2_meta, iface, interface_id, _RC)

      call add_reexport(chem_meta, 'H1', 'MIXING_CB', 'MIXING_CB')
      call add_reexport(chem_meta, 'H2', 'MIXING_CB', 'MIXING_CB')
      call gb%run_reexport_hook(chem_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='^MIXING_CB$'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, size(matches))

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_regex_unaffected_by_merge

   ! CHEM's own direct export has short_name 'MIXING_CB__DU' but declares
   ! 'MIXING_CB' as its callback_declared_name: a literal src_name of
   ! 'MIXING_CB' matches it by declared name, even though no export's
   ! qualified name equals 'MIXING_CB' and there is no re-export.
   @test(npes=[0])
   subroutine test_resolve_callback_import_matches_own_declared_name(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, bad_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: chem_spec
      type(VariableSpec) :: chem_export
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      integer :: status
      type(GraphBuilder) :: gb

      call build_handler_hierarchy('decl-name', root_gc, root_meta, chem_meta, bad_meta, _RC)

      iface = make_passive_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-decl-name', iface, interface_id, status)
      @assert_that(status, is(0))

      chem_export = make_tracer_callback_export('MIXING_CB__DU')
      chem_export%callback_interface_id = interface_id
      chem_export%callback_declared_name = 'MIXING_CB'
      chem_spec => chem_meta%get_component_spec()
      call chem_spec%add_var_spec(chem_export)

      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='MIXING_CB'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)
      @assert_that(status, is(0))
      @assertEqual(1, size(matches))
      @assertEqual('MIXING_CB__DU', matches(1)%qualified_name)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_matches_own_declared_name

   ! Same shape as test_resolve_callback_import_matches_own_declared_name,
   ! but CHEM's export declares a DIFFERENT interface than the one being
   ! searched for: the declared-name match is not gated on the interface
   ! agreeing, so it still reaches the declares_other_interface rejection
   ! (is_own_declared_name_match must not require declares_expected).
   @test(npes=[0])
   subroutine test_resolve_callback_import_declared_name_other_iface_skip(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, bad_meta
      type(CallbackInterface) :: other_iface, expected_iface
      type(CallbackInterfaceId) :: other_id, expected_id
      type(ComponentSpec), pointer :: chem_spec
      type(VariableSpec) :: chem_export
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(StringVector) :: rejected
      integer :: status
      type(GraphBuilder) :: gb

      call build_handler_hierarchy('decl-name-other', root_gc, root_meta, chem_meta, bad_meta, _RC)

      other_iface = make_passive_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-decl-name-other', other_iface, other_id, status)
      @assert_that(status, is(0))

      expected_iface = make_surface_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-decl-name-expected', expected_iface, expected_id, status)
      @assert_that(status, is(0))

      chem_export = make_tracer_callback_export('MIXING_CB__DU')
      chem_export%callback_interface_id = other_id
      chem_export%callback_declared_name = 'MIXING_CB'
      chem_spec => chem_meta%get_component_spec()
      call chem_spec%add_var_spec(chem_export)

      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='MIXING_CB'))

      matches = resolve_callback_import(root_meta, src_pt, expected_id, rejected=rejected, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, size(matches))
      @assertEqual(1, rejected%size())
      @assertEqual('MIXING_CB__DU:declares_other_interface:svc-decl-name-other', rejected%of(1))

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_declared_name_other_iface_skip

   ! A plain src_name whose only candidate at src_comp declares a
   ! DIFFERENT callback interface than the destination expects stays
   ! unresolved through check_unsatisfied_imports (check_one): a rejected
   ! candidate is not the same as "no Handler of src_comp itself under that
   ! plain name", so it must not resolve to an empty collection.
   @test(npes=[0])
   subroutine test_check_one_literal_rejected_stays_unresolved(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: src_driver, invoker_driver
      type(ESMF_GridComp) :: src_gc, invoker_gc
      type(OuterMetaComponent), pointer :: parent_meta, src_meta, invoker_meta
      type(ComponentSpec), pointer :: src_spec, invoker_spec, parent_spec
      type(VariableSpec) :: src_export, cb_import
      type(CallbackInterface) :: expected_iface, other_iface
      type(CallbackInterfaceId) :: expected_id, other_id
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(GraphResolutionEntry), pointer :: entry
      integer :: status
      type(GraphBuilder) :: gb

      expected_iface = make_passive_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-check-one-expected', expected_iface, expected_id, status)
      @assert_that(status, is(0))

      other_iface = make_surface_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-check-one-other', other_iface, other_id, status)
      @assert_that(status, is(0))

      call make_outer_meta('parent_check_one_reject', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('SRC', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('INVOKER', child_spec, _RC)

      src_driver = parent_meta%get_child('SRC', _RC)
      src_gc = src_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)

      invoker_driver = parent_meta%get_child('INVOKER', _RC)
      invoker_gc = invoker_driver%get_gridcomp()
      invoker_meta => get_outer_meta(invoker_gc, _RC)

      src_export = make_tracer_callback_export('MIXING_CB')
      src_export%callback_interface_id = other_id
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(src_export)

      cb_import = make_var(ESMF_STATEINTENT_IMPORT, 'MIXING_CB')
      cb_import%callback_interface_id = expected_id
      invoker_spec => invoker_meta%get_component_spec()
      call invoker_spec%add_var_spec(cb_import)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(invoker_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('SRC', VirtualConnectionPt(state_intent='export', short_name='MIXING_CB')), &
           ConnectionPt('INVOKER', VirtualConnectionPt(state_intent='import', short_name='MIXING_CB')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%check_unsatisfied_imports(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))

      @assertEqual(1, unresolved%size())
      entry => unresolved%at(1, status)
      @assert_that(status, is(0))
      @assertEqual('INVOKER', entry%component_name)
      @assertEqual('MIXING_CB', entry%short_name)

      _UNUSED_DUMMY(this)
   end subroutine test_check_one_literal_rejected_stays_unresolved

