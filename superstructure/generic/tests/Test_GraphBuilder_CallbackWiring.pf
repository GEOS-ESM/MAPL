#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! Tests for the CallbackWiring part of GraphBuilder: qualified-export
! namespace building (build_qualified_export_namespace/
! collect_qualified_exports), and callback state/method binding
! construction (build_callback_state_binding/
! build_callback_method_binding, both called directly, not through gb%).
!
! Carries make_exchanger_interface (used only by
! test_callback_method_binding_builds_get_put_networks). The tracer
! hierarchy fixtures (make_passive_tracer_interface,
! make_tracer_callback_export, build_tracer_hierarchy) are duplicated in
! Test_GraphBuilder.pf and Test_GraphBuilder_ConnectionResolution.pf, and
! here for test_build_callback_state_binding_uses_real_member_nodeids,
! rather than factored into GraphBuilderTestSupport_mod.
!
! Test-only OuterMetaComponent instances are built the same way
! Test_GraphBuilder.pf's own fixtures are (bypassing SetServices/DSO
! machinery) - see GraphBuilderTestSupport_mod.
module Test_GraphBuilder_CallbackWiring
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetwork_mod, only: DependencyNetwork
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_ChildSpec_mod, only: ChildSpec
   use mapl_ComponentSpec_mod, only: ComponentSpec
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_ConnectionPt_mod, only: ConnectionPt
   use mapl_VirtualConnectionPt_mod, only: VirtualConnectionPt
   use mapl_NodeId_mod, only: NodeId, operator(==)
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem
   use mapl_StateItemMemberMap_mod, only: StateItemMemberMap
   use mapl_StateItem_mod, only: MAPL_STATEITEM_STATE, MAPL_STATEITEM_FIELDBUNDLE, MAPL_STATEITEM_FIELD
   use mapl_CallbackInterfaceId_mod, only: CallbackInterfaceId
   use mapl_CallbackInterface_mod, only: CallbackInterface
   use mapl_CallbackInterfaceRegistry_mod, only: register_callback_interface
   use mapl_CallbackStateBinding_mod, only: CallbackStateBinding
   use mapl_CallbackMethodBinding_mod, only: CallbackMethodBinding
   use mapl_CallbackContractReport_mod, only: format_callback_contract_report
   use mapl_CallbackContractViolation_mod, only: CallbackContractViolation, &
        missing_argument_violation, kind_mismatch_violation, dims_mismatch_violation
   use mapl_AccessSpec_mod, only: MAPL_ACCESS_IN, MAPL_ACCESS_OUT, MAPL_ACCESS_INOUT
   use mapl_StateItemFlag_mod, only: MAPL_VARIANT_FIELDBUNDLE => MAPL_STATEITEM_FIELDBUNDLE, &
        MAPL_VARIANT_FIELD => MAPL_STATEITEM_FIELD
   use mapl_VerticalStaggerLoc_mod, only: VerticalStaggerLoc, VERTICAL_STAGGER_NONE, &
        VERTICAL_STAGGER_CENTER, VERTICAL_STAGGER_MIRROR, VERTICAL_STAGGER_INVALID
   use mapl_GeomUtilities_mod, only: GeomSetId
   use mapl_geom_api, only: mapl_new_GeomId
   use mapl_EsmfRegridder_mod, only: EsmfRegridderParam
   use mapl_TransformGraphNode_mod, only: TransformGraphNode
   use mapl_Transform_mod, only: Transform
   use mapl_HorizontalRegridTransform_mod, only: HorizontalRegridTransform
   use mapl_NodeIdSet_mod, only: NodeIdSet, NodeIdSetIterator
   use mapl_QuantityType_mod, only: QUANTITY_TEMPERATURE
   use mapl_StateRegistry_mod, only: StateRegistry
   use mapl_ComponentSpecParser_mod, only: parse_var_specs
   use mapl_VariableSpecVector_mod, only: VariableSpecVector, VariableSpecVectorIterator, operator(/=)
   use gFTL2_StringVector, only: StringVector
   use mapl_ReexportConnection_mod, only: ReexportConnection
   use mapl_MatchConnection_mod, only: MatchConnection
   use mapl_GraphResolutionEntryVector_mod, only: GraphResolutionEntryVector
   use mapl_GraphResolutionEntry_mod, only: GraphResolutionEntry
   use GraphBuilderTestSupport_mod, only: make_outer_meta, make_var
   use esmf
   use pfunit
   implicit none(type, external)

contains

   ! Builds the PassiveTracer CallbackInterface (15-callbacks.md sec
   ! 15.3): one "tracers" FieldBundle argument, "get" (OUT) / "put" (IN)
   ! methods - same fixture shape as
   ! graph/tests/Test_CallbackStateBinding.pf's own
   ! make_passive_tracer_interface.
   function make_passive_tracer_interface(rc) result(iface)
      integer, optional, intent(out) :: rc
      type(CallbackInterface) :: iface

      integer :: status

      call iface%declare_argument('tracers', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call iface%declare_method('get', rc=status)
      @assertEqual(0, status)
      call iface%declare_method('put', rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('get', 'tracers', MAPL_ACCESS_OUT, rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('put', 'tracers', MAPL_ACCESS_IN, rc=status)
      @assertEqual(0, status)

      _RETURN(_SUCCESS)
   end function make_passive_tracer_interface

   ! An interface with a single INOUT argument, exercising the
   ! get+put-both-directions case - distinct from
   ! PassiveTracer's own two-method get/put split.
   function make_exchanger_interface(rc) result(iface)
      integer, optional, intent(out) :: rc
      type(CallbackInterface) :: iface

      integer :: status

      call iface%declare_argument('value', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call iface%declare_method('exchange', rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('exchange', 'value', MAPL_ACCESS_INOUT, rc=status)
      @assertEqual(0, status)

      _RETURN(_SUCCESS)
   end function make_exchanger_interface

   ! One composite export satisfying PassiveTracer: itemType STATE, one
   ! declared 'tracers' FieldBundle member.
   function make_tracer_callback_export(short_name) result(var_spec)
      character(*), intent(in) :: short_name
      type(VariableSpec) :: var_spec

      type(VariableSpec) :: tracers_member
      integer :: status

      var_spec = make_var(ESMF_STATEINTENT_EXPORT, short_name)
      var_spec%itemType = MAPL_STATEITEM_STATE

      tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers')
      tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call var_spec%declare_member('tracers', tracers_member, rc=status)
      @assertEqual(0, status)
   end function make_tracer_callback_export

   ! Builds root -> CHEM -> DU, SS (each exporting a 'tracer_callback'
   ! composite satisfying PassiveTracer) plus root -> DYN (a plain child,
   ! left for the caller to advertise its own 'tracers' import onto) -
   ! mirrors 15-callbacks.md's own DU/SS/... tracer-callback example.
   ! Every component below DYN is already advertised, children before
   ! parents, matching real recursion order.
   subroutine build_tracer_hierarchy(service_name, root_gc, root_meta, chem_meta, du_meta, ss_meta, &
        dyn_meta, iface, interface_id, rc)
      character(*), intent(in) :: service_name
      type(ESMF_GridComp), intent(out) :: root_gc
      type(OuterMetaComponent), pointer, intent(out) :: root_meta
      type(OuterMetaComponent), pointer, intent(out) :: chem_meta
      type(OuterMetaComponent), pointer, intent(out) :: du_meta
      type(OuterMetaComponent), pointer, intent(out) :: ss_meta
      type(OuterMetaComponent), pointer, intent(out) :: dyn_meta
      type(CallbackInterface), intent(out) :: iface
      type(CallbackInterfaceId), intent(out) :: interface_id
      integer, optional, intent(out) :: rc

      integer :: status
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, dyn_driver, du_driver, ss_driver
      type(ESMF_GridComp) :: chem_gc, dyn_gc, du_gc, ss_gc
      type(ComponentSpec), pointer :: du_spec, ss_spec
      type(GraphBuilder) :: gb

      iface = make_passive_tracer_interface(_RC)
      call register_callback_interface(service_name, iface, interface_id, _RC)

      call make_outer_meta('root_' // service_name, root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('DYN', child_spec, _RC)

      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)

      dyn_driver = root_meta%get_child('DYN', _RC)
      dyn_gc = dyn_driver%get_gridcomp()
      dyn_meta => get_outer_meta(dyn_gc, _RC)

      child_spec = ChildSpec()
      call chem_meta%add_child('DU', child_spec, _RC)
      child_spec = ChildSpec()
      call chem_meta%add_child('SS', child_spec, _RC)

      du_driver = chem_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)

      ss_driver = chem_meta%get_child('SS', _RC)
      ss_gc = ss_driver%get_gridcomp()
      ss_meta => get_outer_meta(ss_gc, _RC)

      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_tracer_callback_export('tracer_callback'))

      ss_spec => ss_meta%get_component_spec()
      call ss_spec%add_var_spec(make_tracer_callback_export('tracer_callback'))

      call gb%advertise(du_meta, _RC)
      call gb%advertise(ss_meta, _RC)
      call gb%advertise(chem_meta, _RC)
      call gb%advertise(dyn_meta, _RC)
      call gb%advertise(root_meta, _RC)

      _RETURN(_SUCCESS)
   end subroutine build_tracer_hierarchy

   ! Builds root -> CHEM -> BAD, structurally only (no var_specs, no
   ! advertise calls): a smaller hierarchy than build_tracer_hierarchy for
   ! the declaration-level hard-error tests, which need only one Handler
   ! candidate. The caller adds BAD's export, then advertises bad_meta,
   ! chem_meta, root_meta in that order.
   subroutine build_handler_hierarchy(label, root_gc, root_meta, chem_meta, bad_meta, rc)
      character(*), intent(in) :: label
      type(ESMF_GridComp), intent(out) :: root_gc
      type(OuterMetaComponent), pointer, intent(out) :: root_meta
      type(OuterMetaComponent), pointer, intent(out) :: chem_meta
      type(OuterMetaComponent), pointer, intent(out) :: bad_meta
      integer, optional, intent(out) :: rc

      integer :: status
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, bad_driver
      type(ESMF_GridComp) :: chem_gc, bad_gc

      call make_outer_meta('root_' // label, root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)

      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)

      child_spec = ChildSpec()
      call chem_meta%add_child('BAD', child_spec, _RC)
      bad_driver = chem_meta%get_child('BAD', _RC)
      bad_gc = bad_driver%get_gridcomp()
      bad_meta => get_outer_meta(bad_gc, _RC)

      _RETURN(_SUCCESS)
   end subroutine build_handler_hierarchy

   ! Builds root -> CHEM -> {H1, H2}, structurally only (no var_specs, no
   ! advertise calls) - a two-candidate counterpart to
   ! build_handler_hierarchy, for tests resolving two Handler candidates
   ! in the same call. The caller adds H1's and H2's exports, then
   ! advertises h1_meta, h2_meta, chem_meta, root_meta in that order.
   subroutine build_two_handler_hierarchy(label, root_gc, root_meta, chem_meta, h1_meta, h2_meta, rc)
      character(*), intent(in) :: label
      type(ESMF_GridComp), intent(out) :: root_gc
      type(OuterMetaComponent), pointer, intent(out) :: root_meta
      type(OuterMetaComponent), pointer, intent(out) :: chem_meta
      type(OuterMetaComponent), pointer, intent(out) :: h1_meta
      type(OuterMetaComponent), pointer, intent(out) :: h2_meta
      integer, optional, intent(out) :: rc

      integer :: status
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, h1_driver, h2_driver
      type(ESMF_GridComp) :: chem_gc, h1_gc, h2_gc

      call make_outer_meta('root_' // label, root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)

      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)

      child_spec = ChildSpec()
      call chem_meta%add_child('H1', child_spec, _RC)
      h1_driver = chem_meta%get_child('H1', _RC)
      h1_gc = h1_driver%get_gridcomp()
      h1_meta => get_outer_meta(h1_gc, _RC)

      child_spec = ChildSpec()
      call chem_meta%add_child('H2', child_spec, _RC)
      h2_driver = chem_meta%get_child('H2', _RC)
      h2_gc = h2_driver%get_gridcomp()
      h2_meta => get_outer_meta(h2_gc, _RC)

      _RETURN(_SUCCESS)
   end subroutine build_two_handler_hierarchy

   ! A richer interface than PassiveTracer: required 'tracers'
   ! FieldBundle, required 'weight' Field with dims='xy', optional 'area'
   ! Field with dims='xy' - covers the optional-argument-absent and
   ! dims-mismatch cases PassiveTracer's single FieldBundle argument
   ! cannot exercise. export_conforms_to_interface never checks method
   ! presence, so no method is declared.
   function make_surface_tracer_interface(rc) result(iface)
      integer, optional, intent(out) :: rc
      type(CallbackInterface) :: iface

      integer :: status

      call iface%declare_argument('tracers', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call iface%declare_argument('weight', MAPL_VARIANT_FIELD, dims='xy', rc=status)
      @assertEqual(0, status)
      call iface%declare_argument('area', MAPL_VARIANT_FIELD, dims='xy', optional=.true., rc=status)
      @assertEqual(0, status)

      _RETURN(_SUCCESS)
   end function make_surface_tracer_interface

   ! Same shape as make_surface_tracer_interface's 'tracers'/'weight'
   ! pair, but 'weight' declares dims='xyz' instead of 'xy' - exercises a
   ! declaration-level dims mismatch in the opposite direction (found
   ! 'xy', expected 'xyz').
   function make_profile_tracer_interface(rc) result(iface)
      integer, optional, intent(out) :: rc
      type(CallbackInterface) :: iface

      integer :: status

      call iface%declare_argument('tracers', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call iface%declare_argument('weight', MAPL_VARIANT_FIELD, dims='xyz', rc=status)
      @assertEqual(0, status)

      _RETURN(_SUCCESS)
   end function make_profile_tracer_interface

   ! A small interface with one weighted argument: 'tracers' (not
   ! extensive, required) and 'tracer_weight' (extensive, weight_for=
   ! 'tracers', required because 'tracers' is required). Lets a missing-
   ! weight violation's message carry the "(the weight of '...')"
   ! wording CallbackContractReport.F90/CallbackStateConformance.F90 use
   ! for a realized-state weight violation, confirming the declaration-
   ! level missing_argument_violation call site passes weight_of too.
   function make_weighted_tracer_interface(rc) result(iface)
      integer, optional, intent(out) :: rc
      type(CallbackInterface) :: iface

      integer :: status

      call iface%declare_argument('tracers', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call iface%declare_argument('tracer_weight', MAPL_VARIANT_FIELD, dims='xy', &
           extensive=.true., weight_for='tracers', rc=status)
      @assertEqual(0, status)

      _RETURN(_SUCCESS)
   end function make_weighted_tracer_interface

   ! A composite export shaped for make_surface_tracer_interface (or
   ! make_profile_tracer_interface), with controllable member presence/
   ! mismatch: include_tracers/include_weight .false. omits that member
   ! entirely (a missing_member violation). weight_stagger sets the
   ! weight member's declaration-level dims source of truth the way a
   ! real YAML-declared member would (vertical_stagger, not
   ! vertical_grid - parse_var_specs never sets vertical_grid on a plain
   ! member): VERTICAL_STAGGER_CENTER/EDGE reads as 'xyz',
   ! VERTICAL_STAGGER_NONE as 'xy'; VERTICAL_STAGGER_MIRROR, or omitting
   ! weight_stagger entirely, makes dims undeterminable
   ! (member_dims/GraphBuilder_CallbackWiring_smod.F90) - no violation
   ! either way. make_var defaults a plain member's vertical_stagger to
   ! VERTICAL_STAGGER_NONE (a convenience for fixtures that do not care
   ! about dims at all), so omitting weight_stagger here explicitly
   ! overrides that default to VERTICAL_STAGGER_INVALID - the value
   ! parse_var_specs's to_VerticalStaggerLoc leaves a member whose YAML
   ! never gave vertical_dim_spec - rather than silently landing on
   ! VERTICAL_STAGGER_NONE, which would make dims determinable and
   ! defeat the "omitted" case entirely. Irrelevant when include_weight
   ! is .false.
   function make_surface_tracer_export(short_name, include_tracers, include_weight, &
        weight_stagger) result(var_spec)
      character(*), intent(in) :: short_name
      logical, intent(in) :: include_tracers
      logical, intent(in) :: include_weight
      type(VerticalStaggerLoc), optional, intent(in) :: weight_stagger
      type(VariableSpec) :: var_spec

      type(VariableSpec) :: tracers_member, weight_member
      integer :: status

      var_spec = make_var(ESMF_STATEINTENT_EXPORT, short_name)
      var_spec%itemType = MAPL_STATEITEM_STATE

      if (include_tracers) then
         tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers')
         tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
         call var_spec%declare_member('tracers', tracers_member, rc=status)
         @assertEqual(0, status)
      end if

      if (include_weight) then
         weight_member = make_var(ESMF_STATEINTENT_EXPORT, 'weight')
         weight_member%itemType = MAPL_STATEITEM_FIELD
         if (present(weight_stagger)) then
            weight_member%vertical_stagger = weight_stagger
         else
            weight_member%vertical_stagger = VERTICAL_STAGGER_INVALID
         end if
         call var_spec%declare_member('weight', weight_member, rc=status)
         @assertEqual(0, status)
      end if
   end function make_surface_tracer_export

   ! Builds a single FIELD member the way parse_var_specs really would
   ! from YAML (typekind + vertical_dim_spec), rather than hand-setting
   ! vertical_stagger/vertical_grid directly - regression coverage for
   ! the bug class where member_dims once read vertical_grid, a field a
   ! real YAML-declared member never sets (only vertical_stagger, via
   ! the 'vertical_dim_spec' key - see parse_var_specs.F90's
   ! to_VerticalStaggerLoc). vertical_dim_spec is the YAML value ('none',
   ! 'center', 'edge', 'mirror'), or '' to omit the key entirely.
   function make_parsed_field_member(short_name, vertical_dim_spec, rc) result(member)
      character(*), intent(in) :: short_name
      character(*), intent(in) :: vertical_dim_spec
      integer, optional, intent(out) :: rc
      type(VariableSpec) :: member

      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: parsed
      type(VariableSpecVectorIterator) :: iter
      character(:), allocatable :: attrs
      integer :: status

      attrs = 'typekind: R4'
      if (len(vertical_dim_spec) > 0) attrs = attrs // ', vertical_dim_spec: ' // vertical_dim_spec

      config = ESMF_HConfigCreate(content='{states: {export: {' // short_name // ': {' // attrs // '}}}}', _RC)
      var_specs = parse_var_specs(config, registry, 'TEST', _RC)
      @assertEqual(1, var_specs%size())
      iter = var_specs%ftn_begin()
      call iter%next()
      parsed => iter%of()
      member = parsed

      call ESMF_HConfigDestroy(config, _RC)

      _RETURN(_SUCCESS)
   end function make_parsed_field_member

   ! Spec "Declaration-level checks run at connect", scenario "Declared
   ! Handler with a missing member": a Handler export that declares
   ! expected_interface_id as its own callback_interface_id but is
   ! missing a required member ('weight') is a hard wiring error, not a
   ! rejected-and-skipped candidate.
   @test(npes=[0])
   subroutine test_resolve_callback_import_declared_missing_member_fails(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, bad_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: bad_spec
      type(VariableSpec) :: bad_export
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(CallbackContractViolation) :: expected_violations(1)
      character(:), allocatable :: handler_name
      character(:), allocatable :: expected_message
      logical :: matched
      integer :: status
      type(GraphBuilder) :: gb

      call build_handler_hierarchy('decl-missing', root_gc, root_meta, chem_meta, bad_meta, _RC)

      iface = make_surface_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-decl-missing', iface, interface_id, status)
      @assert_that(status, is(0))

      bad_export = make_surface_tracer_export('tracer_callback', include_tracers=.true., &
           include_weight=.false.)
      bad_export%callback_interface_id = interface_id
      bad_spec => bad_meta%get_component_spec()
      call bad_spec%add_var_spec(bad_export)

      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      handler_name = bad_meta%get_name(status)
      @assert_that(status, is(0))
      expected_violations(1) = missing_argument_violation('weight')
      expected_message = format_callback_contract_report('svc-decl-missing', iface%get_version(), &
           handler_name, 'tracer_callback', expected_violations)

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)

      ! The pending exception must be drained here, before any plain
      ! @assertTrue/@assert_that: those expand to code that returns
      ! early whenever an exception is still queued, which would skip
      ! anything after it.
      matched = catch(expected_message)
      do while (catch('status=1'))
      end do
      @assertTrue(matched)
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_declared_missing_member_fails

   ! A declared Handler missing a required weight argument gets the
   ! "(the weight of '...')" wording in its violation message, the same
   ! wording a realized-state weight violation carries - the missing-
   ! member test above exercises an unweighted argument, this exercises
   ! the weight_of branch of missing_argument_violation specifically.
   @test(npes=[0])
   subroutine test_resolve_callback_import_declared_missing_weight_fails(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, bad_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: bad_spec
      type(VariableSpec) :: bad_export, tracers_member
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(CallbackContractViolation) :: expected_violations(1)
      character(:), allocatable :: handler_name
      character(:), allocatable :: expected_message
      logical :: matched
      integer :: status
      type(GraphBuilder) :: gb

      call build_handler_hierarchy('decl-weight', root_gc, root_meta, chem_meta, bad_meta, _RC)

      iface = make_weighted_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-decl-weight', iface, interface_id, status)
      @assert_that(status, is(0))

      bad_export = make_var(ESMF_STATEINTENT_EXPORT, 'tracer_callback')
      bad_export%itemType = MAPL_STATEITEM_STATE

      tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers')
      tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call bad_export%declare_member('tracers', tracers_member, rc=status)
      @assert_that(status, is(0))
      ! 'tracer_weight' never declared.

      bad_export%callback_interface_id = interface_id
      bad_spec => bad_meta%get_component_spec()
      call bad_spec%add_var_spec(bad_export)

      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      handler_name = bad_meta%get_name(status)
      @assert_that(status, is(0))
      expected_violations(1) = missing_argument_violation('tracer_weight', weight_of='tracers')
      expected_message = format_callback_contract_report('svc-decl-weight', iface%get_version(), &
           handler_name, 'tracer_callback', expected_violations)
      @assertTrue(index(expected_message, "(the weight of 'tracers')") > 0)

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)

      matched = catch(expected_message)
      do while (catch('status=1'))
      end do
      @assertTrue(matched)
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_declared_missing_weight_fails

   ! Spec scenario-adjacent: a missing *optional* argument (CallbackArgumentSpec%
   ! is_optional) is not a violation at all - the export still conforms and
   ! is selected as a match, declared interface or not.
   @test(npes=[0])
   subroutine test_resolve_callback_import_optional_arg_absent_conforms(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
