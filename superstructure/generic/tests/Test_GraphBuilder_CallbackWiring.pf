   ! Builds root -> CHEM -> LOOKALIKE: CHEM's own export 'MIXING_CB' is
   ! undeclared but conforms to iface's shape (the exact-top-level-match
   ! case); LOOKALIKE's export, same short name, same conforming shape, is
   ! also undeclared. Children advertised before parents.
   subroutine build_undeclared_lookalike_hierarchy(service_name, root_gc, root_meta, chem_meta, &
        iface, interface_id, rc)
      character(*), intent(in) :: service_name
      type(ESMF_GridComp), intent(out) :: root_gc
      type(OuterMetaComponent), pointer, intent(out) :: root_meta
      type(OuterMetaComponent), pointer, intent(out) :: chem_meta
      type(CallbackInterface), intent(out) :: iface
      type(CallbackInterfaceId), intent(out) :: interface_id
      integer, optional, intent(out) :: rc

      integer :: status
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, lookalike_driver
      type(ESMF_GridComp) :: chem_gc, lookalike_gc
      type(OuterMetaComponent), pointer :: lookalike_meta
      type(ComponentSpec), pointer :: chem_spec, lookalike_spec
      type(GraphBuilder) :: gb

      iface = make_passive_tracer_interface(_RC)
      call register_callback_interface(service_name, iface, interface_id, _RC)

      call make_outer_meta('root_' // service_name, root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)

      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)
      chem_spec => chem_meta%get_component_spec()
      call chem_spec%add_var_spec(make_tracer_callback_export('MIXING_CB'))

      child_spec = ChildSpec()
      call chem_meta%add_child('LOOKALIKE', child_spec, _RC)
      lookalike_driver = chem_meta%get_child('LOOKALIKE', _RC)
      lookalike_gc = lookalike_driver%get_gridcomp()
      lookalike_meta => get_outer_meta(lookalike_gc, _RC)
      lookalike_spec => lookalike_meta%get_component_spec()
      call lookalike_spec%add_var_spec(make_tracer_callback_export('MIXING_CB'))

      call gb%advertise(lookalike_meta, _RC)
      call gb%advertise(chem_meta, _RC)
      call gb%advertise(root_meta, _RC)

      _RETURN(_SUCCESS)
   end subroutine build_undeclared_lookalike_hierarchy

   ! A literal src_name never searches src_comp's descendants by bare
   ! name, declared or not: LOOKALIKE's undeclared 'MIXING_CB' export is
   ! not collected merely for matching CHEM's own export's name. The
   ! exact-top-level match (CHEM's own undeclared export) is unaffected.
   @test(npes=[0])
   subroutine test_resolve_callback_import_undeclared_lookalike_not_collected(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      integer :: status

      call build_undeclared_lookalike_hierarchy('svc-5-1d-lookalike', root_gc, root_meta, chem_meta, &
           iface, interface_id, _RC)

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='MIXING_CB'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)
      @assert_that(status, is(0))
      @assertEqual(1, size(matches))
      @assertEqual('MIXING_CB', matches(1)%qualified_name)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_undeclared_lookalike_not_collected

   ! A literal src_name that is an explicit path (not a plain name) to a
   ! Handler declaring a *different* callback interface is rejected: an
   ! explicit path matches exactly one export, and that export's declared
   ! interface still has to equal the one the destination expects.
   @test(npes=[0])
   subroutine test_resolve_callback_import_literal_path_other_iface_skip(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, bad_meta
      type(CallbackInterface) :: other_iface, expected_iface
      type(CallbackInterfaceId) :: other_id, expected_id
      type(ComponentSpec), pointer :: bad_spec
      type(VariableSpec) :: bad_export
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(StringVector) :: rejected
      integer :: status
      type(GraphBuilder) :: gb

      call build_handler_hierarchy('decl-other-literal', root_gc, root_meta, chem_meta, bad_meta, _RC)

      other_iface = make_passive_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-5-1d-other-literal', other_iface, other_id, status)
      @assert_that(status, is(0))

      expected_iface = make_surface_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-5-1d-expected-literal', expected_iface, expected_id, status)
      @assert_that(status, is(0))

      bad_export = make_tracer_callback_export('tracer_callback')
      bad_export%callback_interface_id = other_id
      bad_spec => bad_meta%get_component_spec()
      call bad_spec%add_var_spec(bad_export)

      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))

      ! An explicit path, not a plain name, but still literal (no regex
      ! metacharacters): matches by exact qualified name.
      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='BAD/tracer_callback'))

      matches = resolve_callback_import(root_meta, src_pt, expected_id, rejected=rejected, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, size(matches))
      @assertEqual(1, rejected%size())
      @assertEqual('BAD/tracer_callback:declares_other_interface:svc-5-1d-other-literal', rejected%of(1))

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_literal_path_other_iface_skip

end module Test_GraphBuilder_CallbackWiring
