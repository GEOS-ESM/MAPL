      type(CallbackInterfaceId) :: expected_id
      type(MatchConnection) :: conn
      type(UnresolvedImportEntry), allocatable :: unresolved_ids(:)
      integer :: status
      integer :: i
      logical :: found
      type(GraphBuilder) :: gb

      expected_iface = make_passive_tracer_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-node-ids-no-candidate', expected_iface, expected_id, status)
      @assert_that(status, is(0))

      call make_outer_meta('parent_node_ids_no_candidate', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('SRC', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('INVOKER', child_spec, _RC)

      src_driver = parent_meta%get_child('SRC', _RC)
      src_gc = src_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)

      invoker_driver = parent_meta%get_child('INVOKER', _RC)
      invoker_gc = invoker_driver%get_gridcomp()
      invoker_meta => get_outer_meta(invoker_gc, _RC)

      ! SRC has no export named 'MIXING_CB' at all.

      cb_import = make_var(ESMF_STATEINTENT_IMPORT, 'MIXING_CB')
      cb_import%callback_interface_id = expected_id
      invoker_spec => invoker_meta%get_component_spec()
      call invoker_spec%add_var_spec(cb_import)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(invoker_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('SRC', VirtualConnectionPt(state_intent='export', short_name='MIXING_CB')), &
           ConnectionPt('INVOKER', VirtualConnectionPt(state_intent='import', short_name='MIXING_CB')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      unresolved_ids = graphbuilder_unresolved_import_node_ids(parent_meta, invoker_meta, status)
      @assert_that(status, is(0))

      found = .false.
      do i = 1, size(unresolved_ids)
         if (unresolved_ids(i)%short_name == 'MIXING_CB') found = .true.
      end do
      @assert_that(found, is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_node_ids_literal_no_candidate_not_mirrored

