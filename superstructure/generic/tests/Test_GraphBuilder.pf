#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! Phase 3b (docs/graph/spec/20-implementation-roadmap.md sec 20.4.1,
! openspec/changes/graphbuilder-advertising-connections): GraphBuilder
! advertising, public-port/child-proxy population, validate/freeze,
! composite advertise/readvertise, vertical-grid composite tagging,
! visualization label map, callback state/method binding, run-phase-
! node construction, and the parent-shared resolve_qualified_component/
! query_component_exports helpers.
!
! Phase 17-5a (docs/graph/spec/20-implementation-roadmap.md sec
! 20.4.17, 17-5): the ConnectionResolution-exclusive buckets (ordinary/
! inout/SimpleConnection resolution, materialize-extensions gating,
! composite connection wiring, vertical-grid overlap resolution, the
! non-callback-destination control, the callback-collection pipeline
! test, multi-level qualified-component resolution, and the no-live-
! var-spec-reference test) moved to
! Test_GraphBuilder_ConnectionResolution.pf, along with the
! reset_materialize_extensions_gate/restore_materialize_extensions_gate
! @before/@after pair those tests needed - this file has no remaining
! use of mapl_ExtensionResolution_mod's materialize-extensions gate, so
! that pair and its explanatory header comment moved there too (see
! that file's own module header for the pFUnit @before/@after typing
! constraint that made the pair load-bearing). resolve_callback_import
! (bucket 16) stays here for now, pending a future decision on where
! that helper itself lives (its own callback-wiring fixture helpers -
! make_passive_tracer_interface, make_tracer_callback_export,
! build_tracer_hierarchy - are therefore also still defined here,
! duplicated in Test_GraphBuilder_ConnectionResolution.pf for its own
! bucket 17 test).
!
! Test-only OuterMetaComponent instances are built the same way
! Test_ComponentHierarchyGraph.pf does (bypassing SetServices/DSO
! machinery), with ComponentSpec%var_specs/connections populated
! directly rather than through the ComponentSpecParser/DSL - only the
! two fields GraphBuilder actually reads (short_name, state_intent) are
! exercised.
module Test_GraphBuilder
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetwork_mod, only: DependencyNetwork
   use mapl_DependencyNetworkId_mod, only: DependencyNetworkId, operator(==)
   use mapl_DependencyNetworkIdSet_mod, only: DependencyNetworkIdSet, DependencyNetworkIdSetIterator, operator(/=)
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_ChildSpec_mod, only: ChildSpec
   use mapl_ComponentSpec_mod, only: ComponentSpec
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_VariableSpecVector_mod, only: VariableSpecVector
   use mapl_ConnectionPt_mod, only: ConnectionPt
   use mapl_VirtualConnectionPt_mod, only: VirtualConnectionPt
   use mapl_MatchConnection_mod, only: MatchConnection
   use mapl_SimpleConnection_mod, only: SimpleConnection
   use mapl_NodeId_mod, only: NodeId, operator(==)
   use mapl_NodeIdSet_mod, only: NodeIdSet, NodeIdSetIterator, operator(/=)
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem, operator(==)
   use mapl_StateItemMemberMap_mod, only: StateItemMemberMap
   ! -- openspec/changes/phase-10a-state-materialization -------------------
   use mapl_GraphMode_mod, only: set_graph_mode, GRAPH_MODE_REGISTRY, GRAPH_MODE_GRAPH, GRAPH_MODE_BOTH
   ! ------------------------------------------------------------------------
   use mapl_StateItem_mod, only: MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_STATE, MAPL_STATEITEM_FIELDBUNDLE
   use mapl_NodeIdLabelMap_mod, only: NodeIdLabelMap
   ! -- openspec/changes/callback-wiring -----------------------------------
   use mapl_CallbackInterfaceId_mod, only: CallbackInterfaceId
   use mapl_CallbackInterface_mod, only: CallbackInterface
   use mapl_CallbackInterfaceRegistry_mod, only: register_callback_interface
   use mapl_CallbackStateBinding_mod, only: CallbackStateBinding
   use mapl_CallbackMethodBinding_mod, only: CallbackMethodBinding
   use mapl_AccessSpec_mod, only: MAPL_ACCESS_IN, MAPL_ACCESS_OUT, MAPL_ACCESS_INOUT
   use mapl_StateItemFlag_mod, only: MAPL_VARIANT_FIELDBUNDLE => MAPL_STATEITEM_FIELDBUNDLE
   ! -- openspec/changes/vertical-grid-graph-state-item ---------------------
   use mapl_StateItemFlag_mod, only: MAPL_STATEITEM_VERTICALGRID
   ! -- openspec/changes/phase-10d-ordinary-phase-method-node ---------------
   use mapl_AccessSpec_mod, only: AccessSpec, operator(==)
   use mapl_ArgumentSpec_mod, only: ArgumentSpec
   use mapl_MethodGraphNode_mod, only: MethodGraphNode
   ! ------------------------------------------------------------------------
   ! ------------------------------------------------------------------------
   use mapl_NodeLabel_mod, only: NodeLabel
   use mapl_GraphExport_mod, only: export_graph_dot, export_graph_json
   use mapl_FieldGet_mod, only: FieldGet
   use mapl_vertical_grid_api, only: mapl_BasicVerticalGrid
   use gFTL2_StringVector, only: StringVector
   use mapl_GraphResolutionEntry_mod, only: GraphResolutionEntry
   use mapl_GraphResolutionEntryVector_mod, only: GraphResolutionEntryVector
   use mapl_PortIdNodeIdMap_mod, only: PortIdNodeIdMap, PortIdNodeIdMapIterator, operator(/=)
   use GraphBuilderTestSupport_mod, only: make_outer_meta, make_var
   use esmf
   use pfunit
   implicit none(type, external)

contains

   ! Directly builds a top-level OuterMetaComponent, bypassing
   ! SetServices/DSO machinery, and builds a VariableSpec - shared
   ! helpers, see GraphBuilderTestSupport_mod (docs/graph/spec/
   ! 20-implementation-roadmap.md sec 20.4.17, sub-step 17-1).

   ! Task 6.1 / spec "Advertising creates graph state-item nodes":
   ! advertised import/export/internal each produce exactly one
   ! StateItemNode, queryable by identity; re-advertising does not
   ! duplicate it.
   @test(npes=[0])
   subroutine test_advertise_creates_state_item_nodes(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: import_id, export_id, internal_id
      type(NodeIdSet) :: ids
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_advertise', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'Q'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_INTERNAL, 'INTERN'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()

      import_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      export_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'Q'))
      internal_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_INTERNAL, 'INTERN'))
      @assert_that(associated(import_id), is(true()))
      @assert_that(associated(export_id), is(true()))
      @assert_that(associated(internal_id), is(true()))
      @assert_that(graph%owns_node(import_id), is(true()))
      @assert_that(graph%owns_node(export_id), is(true()))
      @assert_that(graph%owns_node(internal_id), is(true()))

      ids = graph%get_node_ids()
      @assertEqual(3, ids%size())

      ! Re-advertising (e.g. a second init pass) does not duplicate.
      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))
      ids = graph%get_node_ids()
      @assertEqual(3, ids%size())

      _UNUSED_DUMMY(this)
   end subroutine test_advertise_creates_state_item_nodes

   ! Task 6.4 (public-port half) / spec "Declared public port is
   ! recorded": an advertised import/export item's identity is
   ! retrievable by name (resource index), and graphbuilder_advertise()
   ! reports success - which it would not if the internal
   ! add_import_port/add_export_port calls (REQ-HIER-002 "public ports")
   ! had failed, since those are guarded by ordinary rc/status checks.
   ! An internal item gets neither port kind.
   @test(npes=[0])
   subroutine test_public_port_recorded_and_reachable_by_name(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: import_id, export_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_ports', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'Q'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      import_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      export_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'Q'))
      @assert_that(associated(import_id), is(true()))
      @assert_that(associated(export_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_public_port_recorded_and_reachable_by_name

   ! Task 6.5 / spec "Successful resolution is followed by freeze" and
   ! "Validation failure prevents freeze".
   @test(npes=[0])
   subroutine test_freeze_succeeds_when_valid(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_freeze_ok', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      call gb%freeze(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      @assert_that(graph%is_frozen(), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_freeze_succeeds_when_valid

   @test(npes=[0])
   subroutine test_freeze_fails_and_leaves_graph_unfrozen_on_conflict(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: a_id, b_id, t_id
      type(DependencyNetworkId) :: default_net_id, second_net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_freeze_conflict', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'A'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'B'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      a_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'A'))
      b_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'B'))
      t_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))

      default_net_id = graph%get_default_network_id()
      second_net_id = graph%create_network(_RC)

      ! REQ-DEP-008a: T written (has a predecessor) in two different
      ! networks within what would be one update pass - construction-time
      ! validation must reject this, not just at runtime.
      call graph%add_dependency(default_net_id, a_id, t_id, _RC)
      call graph%add_dependency(second_net_id, b_id, t_id, _RC)

      call gb%freeze(outer_meta, status)
      ! Four propagated frames to unwind, innermost first: the
      ! descriptive message from validate_cross_network_writes()
      ! (ComponentGraph.F90), then three bare "status=1" propagation
      ! frames (graph_validate -> graph_freeze -> graphbuilder_freeze) -
      ! same pattern as Test_MemoryCheckpoint.pf's multi-frame unwind.
      @assertExceptionRaised( &
           'ComponentGraph: validate found a state item written in more than one network within the same update pass')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assert_that(status, is(not(equal_to(0))))
      @assert_that(graph%is_frozen(), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_freeze_fails_and_leaves_graph_unfrozen_on_conflict

   ! openspec/changes/graph-builder-stateitem-resolution: four more
   ! ESMF_TestMethod tests (test_exact_match_materializes_field_in_graph_mode,
   ! test_populate_state_aliases_export_and_skips_unresolved,
   ! test_populate_state_reaches_each_childs_own_state,
   ! test_populate_state_no_insert_in_registry_or_both_mode) moved to
   ! Test_GraphBuilderMaterializeGate.pf, alongside the fifth
   ! (test_materialize_extensions_enabled_creates_real_field) already
   ! there - see that file's own module header: pFUnit's @before/@after
   ! is NOT disambiguated by the @test subroutine's own dummy-argument
   ! type (confirmed via NAG's own compile error, clearer than
   ! gfortran's) - a @before/@after pair declared anywhere in a .pf file
   ! is applied to EVERY @test in that file regardless of declared type,
   ! so this file's own MpiTestMethod-typed
   ! reset_materialize_extensions_gate/restore_materialize_extensions_gate
   ! pair (added to fix the materialize-extensions-gate leak) would
   ! otherwise be force-fed to every ESMF_TestMethod test here too - a
   ! real type mismatch, not merely a style issue. A .pf file using
   ! @before/@after must therefore contain only ONE @test dummy-argument
   ! type throughout; these four tests never touched the leaking flag
   ! themselves but had to move anyway to keep this file single-typed.

   ! visualization-enrichment-layer change, task 3.1/3.2/4.1: a
   ! component's own advertised import/export/internal items are
   ! labeled by their own declared short_name when build_label_map's
   ! result is handed to the exporter (spec.md "Advertised item is
   ! labeled by its own name").
   @test(npes=[0])
   subroutine test_build_label_map_labels_own_advertised_items(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(NodeIdLabelMap) :: label_map
      character(:), allocatable :: dot_text, json_text
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_label_own', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'Q'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_INTERNAL, 'INTERN'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      label_map = gb%build_label_map(outer_meta, status)
      @assert_that(status, is(0))

      dot_text = export_graph_dot(outer_meta%get_component_graph(), rc=status, label_map=label_map)
      @assert_that(status, is(0))
      @assertTrue(index(dot_text, 'label="T"') > 0)
      @assertTrue(index(dot_text, 'label="Q"') > 0)
      @assertTrue(index(dot_text, 'label="INTERN"') > 0)
      ! None of these three carries the proxy marking.
      @assertFalse(index(dot_text, 'shape="doublecircle"') > 0)

      json_text = export_graph_json(outer_meta%get_component_graph(), rc=status, label_map=label_map)
      @assert_that(status, is(0))
      @assertTrue(index(json_text, '"label": "T"') > 0)
      @assertTrue(index(json_text, '"label": "Q"') > 0)
      @assertTrue(index(json_text, '"label": "INTERN"') > 0)
      @assertFalse(index(json_text, '"proxy"') > 0)

      _UNUSED_DUMMY(this)
   end subroutine test_build_label_map_labels_own_advertised_items

   ! openspec/changes/hierarchy-wide-component-graph, tasks.md 3.4:
   ! retires the former "a cached child-proxy node is labeled
   ! <child_name>:<short_name> and marked as a proxy" coverage -
   ! build_label_map no longer labels any child-proxy node (removed
   ! along with proxy_key/get_or_make_local_node_id; a cross-component
   ! edge now references the child's own real NodeId directly, in the
   ! child's own graph, never a stand-in in this component's own graph).
   ! test_build_label_map_labels_own_advertised_items above already
   ! covers this function's remaining (own-advertised-item) behavior.

   ! -- openspec/changes/composite-state-spec ------------------------------

   ! Task 4.2 / spec "Composite top-level item is represented like an
   ! ordinary advertised item" + "Leaf member of a composite is
   ! represented in the graph": advertising a VariableSpec with declared
   ! members builds a top-level node plus one node per member, each
   ! reachable via the top-level node's own GraphStateItem%state_members
   ! map.
   @test(npes=[0])
   subroutine test_composite_advertise_creates_node_tree(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: composite
      type(NodeId), pointer :: top_id
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: payload
      type(StateItemMemberMap), pointer :: members
      type(NodeId), pointer :: tracer_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_composite_advertise', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      composite = make_var(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE')
      composite%itemType = MAPL_STATEITEM_STATE
      call composite%declare_member('tracers', make_var(ESMF_STATEINTENT_EXPORT, 'tracers'), rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(composite)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      top_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE'))
      @assert_that(associated(top_id), is(true()))

      node => graph%get_node(top_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(payload%itemType(rc=status) == ESMF_STATEITEM_STATE)

      members => payload%state_members_ptr()
      tracer_id => members%at('tracers')
      @assert_that(associated(tracer_id), is(true()))
      @assert_that(graph%owns_node(tracer_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_composite_advertise_creates_node_tree

   ! Task 4.2 / spec "Nested member of a composite is represented in the
   ! graph": a two-level-deep composite produces the full tree.
   @test(npes=[0])
   subroutine test_composite_advertise_multi_level(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: composite, inner
      type(NodeId), pointer :: top_id, inner_id, leaf_id
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: top_payload, inner_payload
      type(StateItemMemberMap), pointer :: top_members, inner_members
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_composite_multilevel', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      inner = make_var(ESMF_STATEINTENT_EXPORT, 'inner_ignored')
      inner%itemType = MAPL_STATEITEM_STATE
      call inner%declare_member('leaf', make_var(ESMF_STATEINTENT_EXPORT, 'leaf'), rc=status)
      @assert_that(status, is(0))

      composite = make_var(ESMF_STATEINTENT_EXPORT, 'TOP')
      composite%itemType = MAPL_STATEITEM_STATE
      call composite%declare_member('inner_state', inner, rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(composite)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      top_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'TOP'))
      @assert_that(associated(top_id), is(true()))

      node => graph%get_node(top_id)
      select type (node)
      class is (StateItemNode)
         top_payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      top_members => top_payload%state_members_ptr()
      inner_id => top_members%at('inner_state')
      @assert_that(associated(inner_id), is(true()))

      node => graph%get_node(inner_id)
      select type (node)
      class is (StateItemNode)
         inner_payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(inner_payload%itemType(rc=status) == ESMF_STATEITEM_STATE)
      inner_members => inner_payload%state_members_ptr()
      leaf_id => inner_members%at('leaf')
      @assert_that(associated(leaf_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_composite_advertise_multi_level

   ! Task 4.2 / spec "Re-advertising the same composite declaration does
   ! not duplicate its node tree".
   @test(npes=[0])
   subroutine test_composite_readvertise_does_not_duplicate(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: composite
      type(NodeIdSet) :: ids
      integer :: status
      integer :: count_after_first
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_composite_readvertise', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      composite = make_var(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE')
      composite%itemType = MAPL_STATEITEM_STATE
      call composite%declare_member('tracers', make_var(ESMF_STATEINTENT_EXPORT, 'tracers'), rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(composite)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      ids = graph%get_node_ids()
      count_after_first = ids%size()

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      ids = graph%get_node_ids()
      @assertEqual(count_after_first, ids%size())

      _UNUSED_DUMMY(this)
   end subroutine test_composite_readvertise_does_not_duplicate

   ! -- openspec/changes/vertical-grid-graph-state-item ---------------------

   ! Task 1.3 / spec "A vertical grid is carried as a nested-state item
   ! with per-dimension coordinate-set members": a composite VariableSpec
   ! tagged state_item_variant = MAPL_STATEITEM_VERTICALGRID materializes
   ! (via the EXISTING, unmodified composite-state-spec path) as a
   ! StateItemNode whose GraphStateItem%variant() reports VERTICALGRID
   ! (design.md D2), with each declared physical dimension retrievable as
   ! an independently node-identified member.
   @test(npes=[0])
   subroutine test_vertical_grid_composite_tags_variant(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: vgrid
      type(NodeId), pointer :: top_id
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: payload
      type(StateItemMemberMap), pointer :: members
      type(NodeId), pointer :: pressure_id, height_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_vgrid_variant', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      vgrid = make_var(ESMF_STATEINTENT_EXPORT, 'MY_VGRID')
      vgrid%itemType = MAPL_STATEITEM_STATE
      vgrid%state_item_variant = MAPL_STATEITEM_VERTICALGRID
      call vgrid%declare_member('pressure', make_var(ESMF_STATEINTENT_EXPORT, 'PLE', units='Pa'), rc=status)
      @assert_that(status, is(0))
      call vgrid%declare_member('height', make_var(ESMF_STATEINTENT_EXPORT, 'ZLE', units='m'), rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(vgrid)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      top_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'MY_VGRID'))
      @assert_that(associated(top_id), is(true()))

      node => graph%get_node(top_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(payload%variant(rc=status) == MAPL_STATEITEM_VERTICALGRID)
      @assert_that(status, is(0))

      members => payload%state_members_ptr()
      pressure_id => members%at('pressure')
      height_id => members%at('height')
      @assert_that(associated(pressure_id), is(true()))
      @assert_that(associated(height_id), is(true()))
      @assert_that(graph%owns_node(pressure_id), is(true()))
      @assert_that(graph%owns_node(height_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_vertical_grid_composite_tags_variant

   ! Regression companion to the test above: an ordinary composite that
   ! does NOT set state_item_variant (every composite declared before
   ! this change, and any future one that is not a vertical grid) keeps
   ! reporting the plain STATE variant - materialize_composite's new
   ! tagging step (design.md D2) is additive, gated on
   ! allocated(var_spec%state_item_variant).
   @test(npes=[0])
   subroutine test_untagged_composite_keeps_plain_state_variant(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: composite
      type(NodeId), pointer :: top_id
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: payload
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_untagged_composite', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      composite = make_var(ESMF_STATEINTENT_EXPORT, 'ORDINARY_STATE')
      composite%itemType = MAPL_STATEITEM_STATE
      ! state_item_variant deliberately left unallocated.
      call composite%declare_member('member', make_var(ESMF_STATEINTENT_EXPORT, 'member'), rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(composite)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      top_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'ORDINARY_STATE'))
      node => graph%get_node(top_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertFalse(payload%variant(rc=status) == MAPL_STATEITEM_VERTICALGRID)
      @assert_that(status, is(0))

      _UNUSED_DUMMY(this)
   end subroutine test_untagged_composite_keeps_plain_state_variant

   ! -- openspec/changes/callback-wiring ------------------------------------

   ! Builds the PassiveTracer CallbackInterface (15-callbacks.md sec
   ! 15.3): one "tracers" FieldBundle argument, "get" (OUT) / "put" (IN)
   ! methods - same fixture shape as
   ! graph/tests/Test_CallbackStateBinding.pf's own
   ! make_passive_tracer_interface.
   function make_passive_tracer_interface(rc) result(iface)
      integer, optional, intent(out) :: rc
      type(CallbackInterface) :: iface

      integer :: status

      call iface%declare_argument('tracers', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call iface%declare_method('get', rc=status)
      @assertEqual(0, status)
      call iface%declare_method('put', rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('get', 'tracers', MAPL_ACCESS_OUT, rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('put', 'tracers', MAPL_ACCESS_IN, rc=status)
      @assertEqual(0, status)

      _RETURN(_SUCCESS)
   end function make_passive_tracer_interface

   ! An interface with a single INOUT argument, exercising REQ-CB-018's
   ! get+put-both-directions case (task 7.3) - distinct from
   ! PassiveTracer's own two-method get/put split.
   function make_exchanger_interface(rc) result(iface)
      integer, optional, intent(out) :: rc
      type(CallbackInterface) :: iface

      integer :: status

      call iface%declare_argument('value', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call iface%declare_method('exchange', rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('exchange', 'value', MAPL_ACCESS_INOUT, rc=status)
      @assertEqual(0, status)

      _RETURN(_SUCCESS)
   end function make_exchanger_interface

   ! One composite export satisfying PassiveTracer: itemType STATE, one
   ! declared 'tracers' FieldBundle member.
   function make_tracer_callback_export(short_name) result(var_spec)
      character(*), intent(in) :: short_name
      type(VariableSpec) :: var_spec

      type(VariableSpec) :: tracers_member
      integer :: status

      var_spec = make_var(ESMF_STATEINTENT_EXPORT, short_name)
      var_spec%itemType = MAPL_STATEITEM_STATE

      tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers')
      tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call var_spec%declare_member('tracers', tracers_member, rc=status)
      @assertEqual(0, status)
   end function make_tracer_callback_export

   ! Builds root -> CHEM -> DU, SS (each exporting a 'tracer_callback'
   ! composite satisfying PassiveTracer) plus root -> DYN (a plain child,
   ! left for the caller to advertise its own 'tracers' import onto) -
   ! mirrors 15-callbacks.md's own DU/SS/... tracer-callback example.
   ! Every component below DYN is already advertised, children before
   ! parents, matching real recursion order.
   subroutine build_tracer_hierarchy(service_name, root_gc, root_meta, chem_meta, du_meta, ss_meta, &
        dyn_meta, iface, interface_id, rc)
      character(*), intent(in) :: service_name
      type(ESMF_GridComp), intent(out) :: root_gc
      type(OuterMetaComponent), pointer, intent(out) :: root_meta
      type(OuterMetaComponent), pointer, intent(out) :: chem_meta
      type(OuterMetaComponent), pointer, intent(out) :: du_meta
      type(OuterMetaComponent), pointer, intent(out) :: ss_meta
      type(OuterMetaComponent), pointer, intent(out) :: dyn_meta
      type(CallbackInterface), intent(out) :: iface
      type(CallbackInterfaceId), intent(out) :: interface_id
      integer, optional, intent(out) :: rc

      integer :: status
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, dyn_driver, du_driver, ss_driver
      type(ESMF_GridComp) :: chem_gc, dyn_gc, du_gc, ss_gc
      type(ComponentSpec), pointer :: du_spec, ss_spec
      type(GraphBuilder) :: gb

      iface = make_passive_tracer_interface(_RC)
      call register_callback_interface(service_name, iface, interface_id, _RC)

      call make_outer_meta('root_' // service_name, root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('DYN', child_spec, _RC)

      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)

      dyn_driver = root_meta%get_child('DYN', _RC)
      dyn_gc = dyn_driver%get_gridcomp()
      dyn_meta => get_outer_meta(dyn_gc, _RC)

      child_spec = ChildSpec()
      call chem_meta%add_child('DU', child_spec, _RC)
      child_spec = ChildSpec()
      call chem_meta%add_child('SS', child_spec, _RC)

      du_driver = chem_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)

      ss_driver = chem_meta%get_child('SS', _RC)
      ss_gc = ss_driver%get_gridcomp()
      ss_meta => get_outer_meta(ss_gc, _RC)

      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_tracer_callback_export('tracer_callback'))

      ss_spec => ss_meta%get_component_spec()
      call ss_spec%add_var_spec(make_tracer_callback_export('tracer_callback'))

      call gb%advertise(du_meta, _RC)
      call gb%advertise(ss_meta, _RC)
      call gb%advertise(chem_meta, _RC)
      call gb%advertise(dyn_meta, _RC)
      call gb%advertise(root_meta, _RC)

      _RETURN(_SUCCESS)
   end subroutine build_tracer_hierarchy

   ! Task 2.2 / spec "Descendant exports are visible under a
   ! hierarchically-qualified name": own export under own name,
   ! descendant exports qualified and distinguishable, re-querying does
   ! not duplicate.
   @test(npes=[0])
   subroutine test_build_qualified_export_namespace_multilevel(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, du_driver, ss_driver
      type(ESMF_GridComp) :: chem_gc, du_gc, ss_gc
      type(OuterMetaComponent), pointer :: chem_meta, du_meta, ss_meta
      type(ComponentSpec), pointer :: chem_spec, du_spec, ss_spec
      type(QualifiedExportEntry), allocatable :: entries(:), entries_again(:)
      integer :: status
      type(GraphBuilder) :: gb
      logical :: found_own, found_du, found_ss
      integer :: i

      call make_outer_meta('ns_root', root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)
      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)

      chem_spec => chem_meta%get_component_spec()
      call chem_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'Y'))

      child_spec = ChildSpec()
      call chem_meta%add_child('DU', child_spec, _RC)
      child_spec = ChildSpec()
      call chem_meta%add_child('SS', child_spec, _RC)

      du_driver = chem_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)
      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'X'))

      ss_driver = chem_meta%get_child('SS', _RC)
      ss_gc = ss_driver%get_gridcomp()
      ss_meta => get_outer_meta(ss_gc, _RC)
      ss_spec => ss_meta%get_component_spec()
      call ss_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'X'))

      call gb%advertise(du_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(ss_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))

      entries = build_qualified_export_namespace(chem_meta, status)
      @assert_that(status, is(0))
      @assertEqual(3, size(entries))

      found_own = .false.
      found_du = .false.
      found_ss = .false.
      do i = 1, size(entries)
         if (entries(i)%qualified_name == 'Y' .and. len(entries(i)%comp_path) == 0) found_own = .true.
         if (entries(i)%qualified_name == 'DU/X') found_du = .true.
         if (entries(i)%qualified_name == 'SS/X') found_ss = .true.
      end do
      @assert_that(found_own, is(true()))
      @assert_that(found_du, is(true()))
      @assert_that(found_ss, is(true()))

      entries_again = build_qualified_export_namespace(chem_meta, status)
      @assert_that(status, is(0))
      @assertEqual(size(entries), size(entries_again))

      _UNUSED_DUMMY(this)
   end subroutine test_build_qualified_export_namespace_multilevel

   ! Task 2.3 / design.md Risks cross-check: the graph-native qualified
   ! name for a descendant export matches what
   ! VirtualConnectionPt%get_full_name() would produce for the same
   ! single-level case.
   @test(npes=[0])
   subroutine test_qualified_name_matches_virtualconnectionpt_convention(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: du_driver
      type(ESMF_GridComp) :: du_gc
      type(OuterMetaComponent), pointer :: du_meta
      type(ComponentSpec), pointer :: du_spec
      type(QualifiedExportEntry), allocatable :: entries(:)
      type(VirtualConnectionPt) :: expected_v_pt
      integer :: status
      type(GraphBuilder) :: gb
      integer :: i
      logical :: found

      call make_outer_meta('ns_crosscheck_root', root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('DU', child_spec, _RC)
      du_driver = root_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)
      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'tracers'))

      call gb%advertise(du_meta, status)
      @assert_that(status, is(0))

      entries = build_qualified_export_namespace(root_meta, status)
      @assert_that(status, is(0))

      expected_v_pt = VirtualConnectionPt(state_intent='export', short_name='tracers')
      expected_v_pt = expected_v_pt%add_comp_name('DU')

      found = .false.
      do i = 1, size(entries)
         if (entries(i)%comp_path == 'DU') then
            @assertEqual(expected_v_pt%get_full_name(), entries(i)%qualified_name)
            found = .true.
         end if
      end do
      @assert_that(found, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_qualified_name_matches_virtualconnectionpt_convention

   ! openspec/changes/hierarchy-wide-component-graph, tasks.md 7.1,
   ! design.md D4: query_component_exports(root, path) returns ONLY the
   ! path-resolved component's own resolved exports - no recursion into
   ! its children (unlike enumerate_qualified_exports/
   ! build_qualified_export_namespace, which flatten a whole subtree).
   @test(npes=[0])
   subroutine test_query_component_exports_scoped_to_resolved_component(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, du_driver
      type(ESMF_GridComp) :: chem_gc, du_gc
      type(OuterMetaComponent), pointer :: chem_meta, du_meta
      type(ComponentSpec), pointer :: chem_spec, du_spec
      type(QualifiedExportIndexEntry), allocatable :: entries(:)
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('qce_root', root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)
      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)
      chem_spec => chem_meta%get_component_spec()
      call chem_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'Y'))

      child_spec = ChildSpec()
      call chem_meta%add_child('DU', child_spec, _RC)
      du_driver = chem_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)
      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'X'))

      call gb%advertise(du_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))

      ! Querying CHEM returns only CHEM's own 'Y' - DU's own 'X' is NOT
      ! included, because this query does not recurse into children
      ! (contrast with build_qualified_export_namespace, which would
      ! return both under 'Y' and 'DU/X').
      entries = query_component_exports(root_meta, 'CHEM', status)
      @assert_that(status, is(0))
      @assertEqual(1, size(entries))
      @assertEqual('Y', entries(1)%qualified_path)
      @assert_that(associated(entries(1)%owner, chem_meta), is(true()))

      ! Querying DU directly (two-segment path through CHEM) returns
      ! DU's own 'X' alone.
      entries = query_component_exports(root_meta, 'CHEM/DU', status)
      @assert_that(status, is(0))
      @assertEqual(1, size(entries))
      @assertEqual('X', entries(1)%qualified_path)
      @assert_that(associated(entries(1)%owner, du_meta), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_query_component_exports_scoped_to_resolved_component

   ! openspec/changes/hierarchy-wide-component-graph, tasks.md 7.2,
   ! design.md D4: History-style deep-hierarchy export visibility - a
   ! 3+-level nested fixture (root -> MID -> LEAF), resolved correctly
   ! through query_component_exports's path-resolution + local-index
   ! read, with NO propagation/mirroring step involved at any level
   ! (LEAF's own export is never mirrored into MID or root's own
   ! import/export-port tables; it is found purely by resolving the
   ! qualified path and reading LEAF's own resource index directly).
   @test(npes=[0])
   subroutine test_query_component_exports_deep_hierarchy_no_propagation(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: mid_driver, leaf_driver
      type(ESMF_GridComp) :: mid_gc, leaf_gc
      type(OuterMetaComponent), pointer :: mid_meta, leaf_meta
      type(ComponentSpec), pointer :: leaf_spec
      type(QualifiedExportIndexEntry), allocatable :: entries(:)
      type(NodeId), pointer :: leaf_own_node_id
      type(ComponentGraph), pointer :: leaf_graph
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('qce_deep_root', root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('MID', child_spec, _RC)
      mid_driver = root_meta%get_child('MID', _RC)
      mid_gc = mid_driver%get_gridcomp()
      mid_meta => get_outer_meta(mid_gc, _RC)

      child_spec = ChildSpec()
      call mid_meta%add_child('LEAF', child_spec, _RC)
      leaf_driver = mid_meta%get_child('LEAF', _RC)
      leaf_gc = leaf_driver%get_gridcomp()
      leaf_meta => get_outer_meta(leaf_gc, _RC)
      leaf_spec => leaf_meta%get_component_spec()
      call leaf_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'DEEP'))

      call gb%advertise(leaf_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(mid_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(root_meta, status)
      @assert_that(status, is(0))
      ! Deliberately no run_propagate_hook/run_export_propagate_hook
      ! call anywhere in this test - the whole point of D4 is that this
      ! query needs none of that machinery.

      entries = query_component_exports(root_meta, 'MID/LEAF', status)
      @assert_that(status, is(0))
      @assertEqual(1, size(entries))
      @assertEqual('DEEP', entries(1)%qualified_path)
      @assert_that(associated(entries(1)%owner, leaf_meta), is(true()))

      leaf_graph => leaf_meta%get_component_graph()
      leaf_own_node_id => leaf_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'DEEP'))
      @assert_that(associated(leaf_own_node_id), is(true()))
      @assert_that(entries(1)%node_id == leaf_own_node_id, is(true()))

      ! root's own query (path '<self>') has no entries of its own at
      ! all - root never declared any export, and this query performs
      ! no recursion that could otherwise surface LEAF's export under
      ! root.
      entries = query_component_exports(root_meta, '<self>', status)
      @assert_that(status, is(0))
      @assertEqual(0, size(entries))

      _UNUSED_DUMMY(this)
   end subroutine test_query_component_exports_deep_hierarchy_no_propagation

   ! Task 4.2 / spec "A pattern matching multiple qualified exports
   ! selects all of them" + "A matching export that does not implement
   ! the expected interface is rejected": DU/SS conform, BAD (no
   ! declared 'tracers' member) does not.
   @test(npes=[0])
   subroutine test_resolve_callback_import_matches_and_rejects(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, du_meta, ss_meta, dyn_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: bad_driver
      type(ESMF_GridComp) :: bad_gc
      type(OuterMetaComponent), pointer :: bad_meta
      type(ComponentSpec), pointer :: bad_spec
      type(VariableSpec) :: bad_export
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(StringVector) :: rejected
      integer :: status
      type(GraphBuilder) :: gb
      logical :: found_du, found_ss
      integer :: i

      call build_tracer_hierarchy('svc-4-2', root_gc, root_meta, chem_meta, du_meta, ss_meta, &
           dyn_meta, iface, interface_id, _RC)

      child_spec = ChildSpec()
      call chem_meta%add_child('BAD', child_spec, _RC)
      bad_driver = chem_meta%get_child('BAD', _RC)
      bad_gc = bad_driver%get_gridcomp()
      bad_meta => get_outer_meta(bad_gc, _RC)
      bad_export = make_var(ESMF_STATEINTENT_EXPORT, 'tracer_callback')
      bad_export%itemType = MAPL_STATEITEM_STATE
      bad_spec => bad_meta%get_component_spec()
      call bad_spec%add_var_spec(bad_export)
      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rejected=rejected, rc=status)
      @assert_that(status, is(0))

      @assertEqual(2, size(matches))
      found_du = .false.
      found_ss = .false.
      do i = 1, size(matches)
         if (matches(i)%qualified_name == 'DU/tracer_callback') found_du = .true.
         if (matches(i)%qualified_name == 'SS/tracer_callback') found_ss = .true.
      end do
      @assert_that(found_du, is(true()))
      @assert_that(found_ss, is(true()))

      @assertEqual(1, rejected%size())
      @assertTrue(index(rejected%of(1), 'BAD/tracer_callback') > 0)
      @assertTrue(index(rejected%of(1), 'missing_member:tracers') > 0)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_matches_and_rejects

   ! Task 4.2 (empty-match case) / spec "A pattern matching no export
   ! resolves to an empty, valid selection".
   @test(npes=[0])
   subroutine test_resolve_callback_import_no_match_is_empty(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, du_meta, ss_meta, dyn_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      integer :: status

      call build_tracer_hierarchy('svc-4-2-empty', root_gc, root_meta, chem_meta, du_meta, ss_meta, &
           dyn_meta, iface, interface_id, _RC)

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='no_such_thing'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, size(matches))

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_no_match_is_empty

   ! Task 6.2 / design.md Context: build_callback_state_binding's bound
   ! argument NodeIds match the real, already-materialized member
   ! NodeIds in DU's own graph - not caller-supplied stand-ins.
   @test(npes=[0])
   subroutine test_build_callback_state_binding_uses_real_member_nodeids(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, du_meta, ss_meta, dyn_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(CallbackStateBinding) :: binding
      type(ComponentGraph), pointer :: du_graph
      class(GraphNode), pointer :: du_node
      type(GraphStateItem), pointer :: du_payload
      type(StateItemMemberMap), pointer :: du_members
      type(NodeId), pointer :: expected_member_id
      type(NodeId), pointer :: bound_member_id
      type(NodeId), pointer :: du_state_id
      integer :: status
      integer :: i
      integer :: du_index

      call build_tracer_hierarchy('svc-6-2', root_gc, root_meta, chem_meta, du_meta, ss_meta, &
           dyn_meta, iface, interface_id, _RC)

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      matches = resolve_callback_import(root_meta, src_pt, interface_id, rc=status)
      @assert_that(status, is(0))

      du_index = 0
      do i = 1, size(matches)
         if (matches(i)%qualified_name == 'DU/tracer_callback') du_index = i
      end do
      @assert_that(du_index > 0, is(true()))

      binding = build_callback_state_binding(root_meta, 'CHEM', matches(du_index), interface_id, iface, status)
      @assert_that(status, is(0))

      du_graph => du_meta%get_component_graph()
      du_state_id => du_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'tracer_callback'))
      @assert_that(associated(du_state_id), is(true()))
      du_node => du_graph%get_node(du_state_id)
      select type (du_node)
      class is (StateItemNode)
         du_payload => du_node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      du_members => du_payload%state_members_ptr()
      expected_member_id => du_members%at('tracers')
      @assert_that(associated(expected_member_id), is(true()))

      bound_member_id => binding%get_argument_binding('tracers')
      @assert_that(associated(bound_member_id), is(true()))
      @assert_that(bound_member_id == expected_member_id, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_build_callback_state_binding_uses_real_member_nodeids

   ! Task 7.3 / spec "Get and put networks are independently
   ! constructed" + "Each network is acyclic on its own even if their
   ! union is not": a single shared provider item feeds "get" and
   ! receives "put" - provider->value->provider would be a 2-cycle if
   ! the two networks were merged, but each network alone has only one
   ! edge.
   @test(npes=[0])
   subroutine test_callback_method_binding_builds_get_put_networks(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: exchanger_export, exchanger_member
      type(NodeId) :: state_node_id
      type(NodeId), pointer :: member_node_id
      type(NodeId) :: provider_id
      type(GraphStateItem), pointer :: payload
      class(GraphNode), pointer :: node
      type(StateItemMemberMap), pointer :: members
      type(StateItemMemberMap) :: provider_get_ids, provider_put_ids
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(CallbackStateBinding) :: state_binding
      type(CallbackMethodBinding) :: method_binding
      type(DependencyNetwork), pointer :: get_net, put_net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_exchanger', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      exchanger_export = make_var(ESMF_STATEINTENT_EXPORT, 'exchanger')
      exchanger_export%itemType = MAPL_STATEITEM_STATE
      exchanger_member = make_var(ESMF_STATEINTENT_EXPORT, 'value')
      exchanger_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call exchanger_export%declare_member('value', exchanger_member, rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(exchanger_export)

      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'provider_shared'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      state_node_id = graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'exchanger'))
      node => graph%get_node(state_node_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      members => payload%state_members_ptr()
      member_node_id => members%at('value')
      @assert_that(associated(member_node_id), is(true()))

      iface = make_exchanger_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-7-3', iface, interface_id, status)
      @assert_that(status, is(0))

      state_binding = CallbackStateBinding(interface_id, iface, state_node_id)
      call state_binding%bind_argument('value', member_node_id, status)
      @assert_that(status, is(0))
      call state_binding%bind_method('exchange', status)
      @assert_that(status, is(0))

      provider_id = graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'provider_shared'))
      call provider_get_ids%insert('value', provider_id)
      call provider_put_ids%insert('value', provider_id)

      method_binding = build_callback_method_binding(outer_meta, iface, 'exchange', state_binding, &
           provider_get_ids, provider_put_ids, status)
      @assert_that(status, is(0))

      get_net => graph%get_network(method_binding%get_get_network_id())
      put_net => graph%get_network(method_binding%get_put_network_id())
      @assert_that(associated(get_net), is(true()))
      @assert_that(associated(put_net), is(true()))

      @assert_that(get_net%contains_dependency(provider_id, member_node_id), is(true()))
      @assert_that(put_net%contains_dependency(member_node_id, provider_id), is(true()))

      ! Each network individually acyclic - freeze runs
      ! ComponentGraph%validate() over every owned network, including
      ! these two, and would fail if either one contained a cycle.
      call graph%freeze(status)
      @assert_that(status, is(0))

      _UNUSED_DUMMY(this)
   end subroutine test_callback_method_binding_builds_get_put_networks

   ! openspec/changes/phase-10d-ordinary-phase-method-node, tasks.md
   ! 3.1: graphbuilder_build_run_phase_node constructs exactly one
   ! MethodGraphNode for a component's own run phase, keyed to its own
   ! advertised import/export VariableSpecs - no real driver run
   ! anywhere in this test (construction only, mirroring every other
   ! synthetic-graph construction test in this file).
   @test(npes=[0])
   subroutine test_build_run_phase_node_constructs_node_from_ports(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(NodeId) :: method_node_id
      type(NodeId), pointer :: expected_import_id, expected_export_id
      class(GraphNode), pointer :: generic_node
      type(ArgumentSpec) :: in_arg, out_arg
      type(AccessSpec) :: access
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_run_phase_node', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'A'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'B'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call gb%build_run_phase_node(outer_meta, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      @assert_that(status, is(0))

      method_node_id = outer_meta%get_run_phase_method_node_id()
      @assert_that(method_node_id%is_valid(), is(true()))

      graph => outer_meta%get_component_graph()
      generic_node => graph%get_node(method_node_id)
      @assert_that(associated(generic_node), is(true()))
      select type (generic_node)
      class is (MethodGraphNode)
         in_arg = generic_node%get_argument('A', _RC)
         @assertEqual(0, status)
         access = in_arg%get_access()
         @assert_that(access == MAPL_ACCESS_IN, is(true()))

         out_arg = generic_node%get_argument('B', _RC)
         @assertEqual(0, status)
         access = out_arg%get_access()
         @assert_that(access == MAPL_ACCESS_OUT, is(true()))

         expected_import_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'A'))
         expected_export_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'B'))
         @assert_that(associated(expected_import_id), is(true()))
         @assert_that(associated(expected_export_id), is(true()))
         @assert_that(generic_node%get_argument_binding('A') == expected_import_id, is(true()))
         @assert_that(generic_node%get_argument_binding('B') == expected_export_id, is(true()))
      class default
         @assert_that('node is a MethodGraphNode', .false., is(true()))
      end select

      _UNUSED_DUMMY(this)
   end subroutine test_build_run_phase_node_constructs_node_from_ports

   ! openspec/changes/phase-10d-ordinary-phase-method-node, tasks.md
   ! 3.2: construction is a no-op under the default (registry) graph
   ! mode - no node is built, no NodeId is stored.
   @test(npes=[0])
   subroutine test_build_run_phase_node_is_noop_in_registry_mode(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(NodeId) :: method_node_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_run_phase_node_registry', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'A'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      ! Default graph mode is already GRAPH_MODE_REGISTRY - no
      ! set_graph_mode call needed (and none left behind for later
      ! tests to trip over).
      call gb%build_run_phase_node(outer_meta, status)
      @assert_that(status, is(0))

      method_node_id = outer_meta%get_run_phase_method_node_id()
      @assert_that(method_node_id%is_valid(), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_build_run_phase_node_is_noop_in_registry_mode

   ! openspec/changes/phase-10d-ordinary-phase-method-node, tasks.md
   ! 3.3: a second construction call under a non-registry graph mode is
   ! idempotent - the already-stored NodeId is left unchanged, and the
   ! call does not fail.
   @test(npes=[0])
   subroutine test_build_run_phase_node_is_idempotent(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(NodeId) :: first_node_id, second_node_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_run_phase_node_idempotent', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'A'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call gb%build_run_phase_node(outer_meta, status)
      @assert_that(status, is(0))
      first_node_id = outer_meta%get_run_phase_method_node_id()
      @assert_that(first_node_id%is_valid(), is(true()))

      call gb%build_run_phase_node(outer_meta, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      @assert_that(status, is(0))
      second_node_id = outer_meta%get_run_phase_method_node_id()
      @assert_that(second_node_id == first_node_id, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_build_run_phase_node_is_idempotent

   ! openspec/changes/graph-builder-resolution-index, task 4.1 /
   ! design.md Risks "the fixed gap": a single-segment path equal to
   ! the calling component's own name resolves to that component
   ! itself, not a child lookup attempt - resolve_descendant's own
   ! prior behavior (before this change relocated it as
   ! resolve_qualified_component) always called get_child_outer_meta
   ! unconditionally on the first segment, so this regresses without
   ! the is_self short-circuit this change adds.
   @test(npes=[0])
   subroutine test_resolve_qualified_component_single_segment_self(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(OuterMetaComponent), pointer :: resolved
      character(:), allocatable :: own_name
      integer :: status

      call make_outer_meta('comp_resolve_self', root_gc, root_meta, _RC)
      own_name = root_meta%get_name(_RC)

      resolved => resolve_qualified_component(root_meta, own_name, status)
      @assert_that(status, is(0))
      @assert_that(associated(resolved, root_meta), is(true()))

      resolved => resolve_qualified_component(root_meta, '<self>', status)
      @assert_that(status, is(0))
      @assert_that(associated(resolved, root_meta), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_qualified_component_single_segment_self

   ! openspec/changes/graph-builder-resolution-index, task 4.2: a
   ! three-level synthetic hierarchy (parent/child/grandchild); a
   ! two-segment path ('child/grandchild') resolves to the grandchild's
   ! own OuterMetaComponent.
   @test(npes=[0])
   subroutine test_resolve_qualified_component_multi_level(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: child_driver, grandchild_driver
      type(ESMF_GridComp) :: child_gc, grandchild_gc
      type(OuterMetaComponent), pointer :: child_meta, grandchild_meta
      type(OuterMetaComponent), pointer :: resolved
      integer :: status

      call make_outer_meta('comp_resolve_multilevel_root', root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('MID', child_spec, _RC)
      child_driver = root_meta%get_child('MID', _RC)
      child_gc = child_driver%get_gridcomp()
      child_meta => get_outer_meta(child_gc, _RC)

      child_spec = ChildSpec()
      call child_meta%add_child('LEAF', child_spec, _RC)
      grandchild_driver = child_meta%get_child('LEAF', _RC)
      grandchild_gc = grandchild_driver%get_gridcomp()
      grandchild_meta => get_outer_meta(grandchild_gc, _RC)

      resolved => resolve_qualified_component(root_meta, 'MID/LEAF', status)
      @assert_that(status, is(0))
      @assert_that(associated(resolved, grandchild_meta), is(true()))

      ! Single-segment path to a direct child continues to resolve
      ! exactly as component_for's own "<self>"/direct-child dispatch
      ! already does (design.md "A connection naming a direct child or
      ! self is unaffected").
      resolved => resolve_qualified_component(root_meta, 'MID', status)
      @assert_that(status, is(0))
      @assert_that(associated(resolved, child_meta), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_qualified_component_multi_level

   ! openspec/changes/hierarchy-wide-component-graph, graph/component-
   ! hierarchy delta spec "Connection endpoint resolution never resolves
   ! upward past its declaring component" - scenario "A connection
   ! cannot name an ancestor": resolve_qualified_component, called with
   ! MID as root, has no code path that can reach ROOT (MID's own
   ! parent) or a name that is neither MID itself nor one of its
   ! descendants - get_child_outer_meta only ever looks up MID's OWN
   ! children map (OuterMetaComponent/get_child_by_name.F90), with no
   ! "get_parent" accessor anywhere in OuterMetaComponent to begin with
   ! (design.md D6 - "the walk has no 'look at my own parent' code path
   ! to begin with"). Naming ROOT (the ancestor) or SIBLING (neither
   ! MID nor a descendant of MID) therefore fails to resolve, exactly
   ! like naming any other nonexistent child would - this is a
   ! structural property of the walk, not a special-cased check.
   @test(npes=[0])
   subroutine test_resolve_qualified_component_cannot_name_ancestor(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: mid_driver
      type(ESMF_GridComp) :: mid_gc
      type(OuterMetaComponent), pointer :: mid_meta
      type(OuterMetaComponent), pointer :: resolved
      integer :: status

      call make_outer_meta('comp_resolve_ancestor_root', root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('MID', child_spec, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('SIBLING', child_spec, _RC)
      mid_driver = root_meta%get_child('MID', _RC)
      mid_gc = mid_driver%get_gridcomp()
      mid_meta => get_outer_meta(mid_gc, _RC)

      ! Naming the ancestor (ROOT's own name) starting from MID fails -
      ! MID has no child literally named after its own parent.
      resolved => resolve_qualified_component(mid_meta, 'comp_resolve_ancestor_root', status)
      @assertExceptionRaised('Child not found: <comp_resolve_ancestor_root>.')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assert_that(status, is(not(equal_to(0))))

      ! Naming a sibling (SIBLING - neither MID itself nor a descendant
      ! of MID) starting from MID also fails, for the same reason.
      resolved => resolve_qualified_component(mid_meta, 'SIBLING', status)
      @assertExceptionRaised('Child not found: <SIBLING>.')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assert_that(status, is(not(equal_to(0))))

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(resolved)
   end subroutine test_resolve_qualified_component_cannot_name_ancestor

end module Test_GraphBuilder
