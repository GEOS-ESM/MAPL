#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! Phase 3b (docs/graph/spec/20-implementation-roadmap.md sec 20.4.1,
! openspec/changes/graphbuilder-advertising-connections): GraphBuilder
! advertising, ordinary (exact-match) connection resolution, public-port/
! child-proxy population, and validate/freeze.
!
! Test-only OuterMetaComponent instances are built the same way
! Test_ComponentHierarchyGraph.pf does (bypassing SetServices/DSO
! machinery), with ComponentSpec%var_specs/connections populated
! directly rather than through the ComponentSpecParser/DSL - only the
! two fields GraphBuilder actually reads (short_name, state_intent) are
! exercised.
module Test_GraphBuilder
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetwork_mod, only: DependencyNetwork
   use mapl_DependencyNetworkId_mod, only: DependencyNetworkId
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_ChildSpec_mod, only: ChildSpec
   use mapl_ComponentSpec_mod, only: ComponentSpec
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_ConnectionPt_mod, only: ConnectionPt
   use mapl_VirtualConnectionPt_mod, only: VirtualConnectionPt
   use mapl_MatchConnection_mod, only: MatchConnection
   use mapl_SimpleConnection_mod, only: SimpleConnection
   use mapl_NodeId_mod, only: NodeId, operator(==)
   use mapl_NodeIdSet_mod, only: NodeIdSet, NodeIdSetIterator, operator(/=)
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem, operator(==)
   use mapl_StateItemMemberMap_mod, only: StateItemMemberMap
   use mapl_ExtensionResolution_mod, only: set_materialize_extensions
   use mapl_StateItem_mod, only: MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_STATE, MAPL_STATEITEM_FIELDBUNDLE
   use mapl_NodeIdLabelMap_mod, only: NodeIdLabelMap
   ! -- openspec/changes/callback-wiring -----------------------------------
   use mapl_CallbackInterfaceId_mod, only: CallbackInterfaceId
   use mapl_CallbackInterface_mod, only: CallbackInterface
   use mapl_CallbackInterfaceRegistry_mod, only: register_callback_interface
   use mapl_CallbackStateBinding_mod, only: CallbackStateBinding
   use mapl_CallbackMethodBinding_mod, only: CallbackMethodBinding
   use mapl_AccessSpec_mod, only: MAPL_ACCESS_IN, MAPL_ACCESS_OUT, MAPL_ACCESS_INOUT
   use mapl_StateItemFlag_mod, only: MAPL_VARIANT_FIELDBUNDLE => MAPL_STATEITEM_FIELDBUNDLE
   ! ------------------------------------------------------------------------
   use mapl_NodeLabel_mod, only: NodeLabel
   use mapl_GraphExport_mod, only: export_graph_dot, export_graph_json
   use mapl_FieldGet_mod, only: FieldGet
   use mapl_vertical_grid_api, only: mapl_BasicVerticalGrid
   use gFTL2_StringVector, only: StringVector
   use ESMF_TestMethod_mod
   use esmf
   use pfunit
   implicit none(type, external)

contains

   ! Directly builds a top-level OuterMetaComponent, bypassing
   ! SetServices/DSO machinery - same helper as
   ! Test_ComponentHierarchyGraph.pf.
   subroutine make_outer_meta(name, outer_gc, outer_meta, rc)
      character(*), intent(in) :: name
      type(ESMF_GridComp), intent(out) :: outer_gc
      type(OuterMetaComponent), pointer, intent(out) :: outer_meta
      integer, optional, intent(out) :: rc

      integer :: status
      type(ESMF_GridComp) :: user_gc
      type(GriddedComponentDriver) :: user_gc_driver
      type(ESMF_HConfig) :: hconfig

      hconfig = ESMF_HConfigCreate(content='{}', _RC)
      outer_gc = ESMF_GridCompCreate(name='['//trim(name)//']', _RC)
      user_gc = ESMF_GridCompCreate(name=name, _RC)
      user_gc_driver = GriddedComponentDriver(user_gc)

      call attach_outer_meta(outer_gc, _RC)
      outer_meta => get_outer_meta(outer_gc, _RC)
#ifndef __GFORTRAN__
      outer_meta = OuterMetaComponent(outer_gc, user_gc_driver, hconfig=hconfig)
#else
      block
         type(OuterMetaComponent) :: tmp
         tmp = OuterMetaComponent(outer_gc, user_gc_driver, hconfig=hconfig)
         outer_meta = tmp
      end block
#endif
      call outer_meta%init_meta(_RC)

      _RETURN(_SUCCESS)
   end subroutine make_outer_meta

   function make_var(state_intent, short_name, units) result(var_spec)
      type(ESMF_StateIntent_Flag), intent(in) :: state_intent
      character(*), intent(in) :: short_name
      character(*), optional, intent(in) :: units
      type(VariableSpec) :: var_spec

      var_spec%state_intent = state_intent
      var_spec%short_name = short_name
      if (present(units)) var_spec%units = units
   end function make_var

   ! Task 6.1 / spec "Advertising creates graph state-item nodes":
   ! advertised import/export/internal each produce exactly one
   ! StateItemNode, queryable by identity; re-advertising does not
   ! duplicate it.
   @test(npes=[0])
   subroutine test_advertise_creates_state_item_nodes(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: import_id, export_id, internal_id
      type(NodeIdSet) :: ids
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_advertise', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'Q'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_INTERNAL, 'INTERN'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()

      import_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      export_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'Q'))
      internal_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_INTERNAL, 'INTERN'))
      @assert_that(associated(import_id), is(true()))
      @assert_that(associated(export_id), is(true()))
      @assert_that(associated(internal_id), is(true()))
      @assert_that(graph%owns_node(import_id), is(true()))
      @assert_that(graph%owns_node(export_id), is(true()))
      @assert_that(graph%owns_node(internal_id), is(true()))

      ids = graph%get_node_ids()
      @assertEqual(3, ids%size())

      ! Re-advertising (e.g. a second init pass) does not duplicate.
      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))
      ids = graph%get_node_ids()
      @assertEqual(3, ids%size())

      _UNUSED_DUMMY(this)
   end subroutine test_advertise_creates_state_item_nodes

   ! Task 6.4 (public-port half) / spec "Declared public port is
   ! recorded": an advertised import/export item's identity is
   ! retrievable by name (resource index), and graphbuilder_advertise()
   ! reports success - which it would not if the internal
   ! add_import_port/add_export_port calls (REQ-HIER-002 "public ports")
   ! had failed, since those are guarded by ordinary rc/status checks.
   ! An internal item gets neither port kind.
   @test(npes=[0])
   subroutine test_public_port_recorded_and_reachable_by_name(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: import_id, export_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_ports', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'Q'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      import_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      export_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'Q'))
      @assert_that(associated(import_id), is(true()))
      @assert_that(associated(export_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_public_port_recorded_and_reachable_by_name

   ! Task 6.2 / spec "Matching export and import are wired" + "Import
   ! with no matching export is left unresolved" + task 4.2 "Child's
   ! published port gets a parent-local proxy": a parent declares a
   ! connect_all-style MatchConnection between two children; the parent
   ! ends up with proxy nodes (not the children's own NodeIds) wired in
   ! its own default network, and the one import with no matching export
   ! is reported, not silently dropped.
   @test(npes=[0])
   subroutine test_ordinary_connection_wires_matching_and_reports_unresolved(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph, src_graph, dst_graph
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved
      type(NodeId), pointer :: t_export_proxy, t_import_proxy, q_import_proxy
      type(NodeId), pointer :: t_export_native, t_import_native
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'Q')) ! no matching export

      ! Children advertise first - mirrors recursion order in
      ! OuterMetaComponent/initialize_advertise.F90 (children complete
      ! before the parent resolves its own connections).
      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      ! connect_all('child_src', 'child_dst')'s own "magic connect" shape
      ! (superstructure/generic/OuterMetaComponent/connect_all.F90).
      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))

      @assertEqual(1, unresolved%size())
      @assert_that(unresolved%at(1, status), is(equal_to('child_dst:Q')))

      parent_graph => parent_meta%get_component_graph()
      t_export_proxy => parent_graph%get_resource_index(proxy_key('child_src', ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_proxy => parent_graph%get_resource_index(proxy_key('child_dst', ESMF_STATEINTENT_IMPORT, 'T'))
      q_import_proxy => parent_graph%get_resource_index(proxy_key('child_dst', ESMF_STATEINTENT_IMPORT, 'Q'))
      @assert_that(associated(t_export_proxy), is(true()))
      @assert_that(associated(t_import_proxy), is(true()))
      @assert_that(associated(q_import_proxy), is(true()))

      ! Sanity: the children's own native items still exist in their own
      ! graphs (untouched by the parent's proxy creation).
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_native => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_native => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_native), is(true()))
      @assert_that(associated(t_import_native), is(true()))

      ! The proxy is owned by the parent's own graph.
      @assert_that(parent_graph%owns_node(t_export_proxy), is(true()))
      @assert_that(parent_graph%owns_node(t_import_proxy), is(true()))

      ! REQ-HIER-005 ("no reference to the child's internal NodeId"):
      ! NodeId values are graph-scoped sequence numbers, not globally
      ! unique, so a runtime cross-graph value/ownership comparison is
      ! not a meaningful way to test this (two independently-generated
      ! small id sequences will coincidentally collide, exactly as
      ! Test_ComponentHierarchyGraph.pf's own encapsulation test
      ! documents for a related case). This is instead a
      ! code-review-verifiable property of get_or_make_local_node_id()
      ! (GraphBuilder.F90): the child branch's returned node_id always
      ! comes from this_graph%next_node_id() - the child's own
      ! child_item_id is used only as a read-only existence check, never
      ! returned or stored as the resolved identity.

      net_id = parent_graph%get_default_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%contains_dependency(t_export_proxy, t_import_proxy), is(true()))
      @assert_that(net%has_predecessors(q_import_proxy), is(false()))
      @assert_that(net%has_successors(t_export_proxy), is(true()))
      @assert_that(net%has_predecessors(t_export_proxy), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_ordinary_connection_wires_matching_and_reports_unresolved

   ! openspec/changes/extension-reuse (roadmap sub-change 3c) - REQ-EXT-001/
   ! 002/003 end-to-end through GraphBuilder: a units mismatch between a
   ! matched export/import pair gets a real TransformGraphNode + extension
   ! StateItemNode interposed instead of a direct dependency edge, and the
   ! no-op case (elsewhere, a second, exactly-matching pair) still wires
   ! directly - both handled by the same resolve_connections() call.
   @test(npes=[0])
   subroutine test_ordinary_connection_units_mismatch_creates_chain(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_export_proxy, t_import_proxy
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_units', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='km'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))

      ! REQ-EXT scenario "Mismatched export and import are wired through
      ! an extension chain": not reported as unresolved, not reported as
      ! unsupported (units has a real registered provider).
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      t_export_proxy => parent_graph%get_resource_index(proxy_key('child_src', ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_proxy => parent_graph%get_resource_index(proxy_key('child_dst', ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_proxy), is(true()))
      @assert_that(associated(t_import_proxy), is(true()))

      net_id = parent_graph%get_default_network_id()
      net => parent_graph%get_network(net_id)

      ! Not a direct edge (spec "Mismatched export and import are wired
      ! through an extension chain") - a transform node is interposed.
      @assert_that(net%contains_dependency(t_export_proxy, t_import_proxy), is(false()))
      @assert_that(net%has_successors(t_export_proxy), is(true()))
      @assert_that(net%has_predecessors(t_import_proxy), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_ordinary_connection_units_mismatch_creates_chain

   ! Two-phase timing correction (GraphBuilder.F90 module header):
   ! graphbuilder_check_unsatisfied_imports() is the GENERIC_INIT_ADVERTISE
   ! -time (Connection%activate()) analog - it must report the same
   ! unresolved import as graphbuilder_resolve_connections() does, but
   ! MUST NOT create any graph structure (no proxy nodes, no dependency
   ! edges) - that is graphbuilder_resolve_connections()'s job, run later
   ! at GENERIC_INIT_ACCEPT_TRANSFER time (Connection%connect()).
   @test(npes=[0])
   subroutine test_check_unsatisfied_imports_reports_without_mutating_graph(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved
      type(NodeId), pointer :: t_export_proxy, t_import_proxy, q_import_proxy
      type(NodeIdSet) :: parent_ids
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_activate', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'Q')) ! no matching export

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      parent_graph => parent_meta%get_component_graph()
      parent_ids = parent_graph%get_node_ids()
      @assertEqual(0, parent_ids%size())

      call gb%check_unsatisfied_imports(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))

      ! Same unresolved report as the real (connect-time) resolution.
      @assertEqual(1, unresolved%size())
      @assert_that(unresolved%at(1, status), is(equal_to('child_dst:Q')))

      ! No graph mutation: no proxy nodes created, node count unchanged.
      t_export_proxy => parent_graph%get_resource_index(proxy_key('child_src', ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_proxy => parent_graph%get_resource_index(proxy_key('child_dst', ESMF_STATEINTENT_IMPORT, 'T'))
      q_import_proxy => parent_graph%get_resource_index(proxy_key('child_dst', ESMF_STATEINTENT_IMPORT, 'Q'))
      @assert_that(associated(t_export_proxy), is(false()))
      @assert_that(associated(t_import_proxy), is(false()))
      @assert_that(associated(q_import_proxy), is(false()))

      parent_ids = parent_graph%get_node_ids()
      @assertEqual(0, parent_ids%size())
      @assert_that(parent_graph%is_frozen(), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_check_unsatisfied_imports_reports_without_mutating_graph

   ! Task 6.3 / spec "Non-exact-match cases are not resolved by this
   ! capability": a SimpleConnection (not a MatchConnection) is skipped
   ! entirely - no dependency edge, not reported as an unresolved import
   ! either, since it never enters the ordinary-match loop at all.
   @test(npes=[0])
   subroutine test_non_matchconnection_is_skipped(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(SimpleConnection) :: conn
      type(StringVector) :: unresolved
      type(NodeId), pointer :: t_export, t_import
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_simple', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      conn = SimpleConnection( &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='export', short_name='T')), &
           ConnectionPt('<self>', VirtualConnectionPt(state_intent='import', short_name='T')))
      call comp_spec%add_connection(conn)

      call gb%resolve_connections(outer_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      graph => outer_meta%get_component_graph()
      t_export => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      net => graph%get_network(graph%get_default_network_id())
      @assert_that(net%contains_dependency(t_export, t_import), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_non_matchconnection_is_skipped

   ! Task 6.5 / spec "Successful resolution is followed by freeze" and
   ! "Validation failure prevents freeze".
   @test(npes=[0])
   subroutine test_freeze_succeeds_when_valid(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_freeze_ok', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      call gb%freeze(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      @assert_that(graph%is_frozen(), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_freeze_succeeds_when_valid

   @test(npes=[0])
   subroutine test_freeze_fails_and_leaves_graph_unfrozen_on_conflict(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: a_id, b_id, t_id
      type(DependencyNetworkId) :: default_net_id, second_net_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_freeze_conflict', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'A'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'B'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      a_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'A'))
      b_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'B'))
      t_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))

      default_net_id = graph%get_default_network_id()
      second_net_id = graph%create_network(_RC)

      ! REQ-DEP-008a: T written (has a predecessor) in two different
      ! networks within what would be one update pass - construction-time
      ! validation must reject this, not just at runtime.
      call graph%add_dependency(default_net_id, a_id, t_id, _RC)
      call graph%add_dependency(second_net_id, b_id, t_id, _RC)

      call gb%freeze(outer_meta, status)
      ! Four propagated frames to unwind, innermost first: the
      ! descriptive message from validate_cross_network_writes()
      ! (ComponentGraph.F90), then three bare "status=1" propagation
      ! frames (graph_validate -> graph_freeze -> graphbuilder_freeze) -
      ! same pattern as Test_MemoryCheckpoint.pf's multi-frame unwind.
      @assertExceptionRaised( &
           'ComponentGraph: validate found a state item written in more than one network within the same update pass')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assert_that(status, is(not(equal_to(0))))
      @assert_that(graph%is_frozen(), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_freeze_fails_and_leaves_graph_unfrozen_on_conflict

   ! -- openspec/changes/extension-registry-visibility, task group 6 -----

   ! Test-only helper: the extension chain's final item is wired as the
   ! sole predecessor of the import proxy (GraphBuilder.F90's own
   ! resolve_one - the last add_dependency call). Assumes exactly one
   ! predecessor, true for every single-mismatch fixture below.
   function single_predecessor(net, node) result(pred_id)
      type(DependencyNetwork), intent(in) :: net
      type(NodeId), intent(in) :: node
      type(NodeId) :: pred_id

      type(NodeIdSet), target :: preds
      type(NodeIdSetIterator) :: iter

      preds = net%get_predecessors(node)
      iter = preds%ftn_begin()
      call iter%next()
      pred_id = iter%of()
   end function single_predecessor

   ! Task 6.1 / spec "Materialization disabled by default": with the
   ! gate untouched (off), a units-mismatch extension chain's final item
   ! keeps 3c's own unallocated placeholder payload - zero behavior
   ! change from today.
   @test(npes=[0])
   subroutine test_materialize_extensions_disabled_leaves_placeholder(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_import_proxy
      type(NodeId) :: extension_id
      type(DependencyNetwork), pointer :: net
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: extension_payload
      integer :: status
      type(GraphBuilder) :: gb

      call set_materialize_extensions(.false.)

      call make_outer_meta('comp_parent_gate_off', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='km'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      t_import_proxy => parent_graph%get_resource_index(proxy_key('child_dst', ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_import_proxy), is(true()))

      net => parent_graph%get_network(parent_graph%get_default_network_id())
      extension_id = single_predecessor(net, t_import_proxy)

      node => parent_graph%get_node(extension_id)
      select type (node)
      class is (StateItemNode)
         extension_payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(extension_payload%itemType(rc=status) == ESMF_STATEITEM_NOTFOUND)

      _UNUSED_DUMMY(this)
   end subroutine test_materialize_extensions_disabled_leaves_placeholder

   ! Task 6.2/6.4 / spec "Resolved extension has a real payload" +
   ! "Resolved extension remains discoverable" + "Reused extension is
   ! not re-materialized": with the gate explicitly enabled, the
   ! extension chain's final item gets a real, correctly-shaped
   ! ESMF_Field, still discoverable via the same proxy/predecessor
   ! query, and calling resolve_connections a second time does not
   ! replace it.
   ! type=ESMF_TestMethod, npes=[1] (unlike this suite's other tests,
   ! Test_GeomAspect.pf's own precedent for real-geom pFUnit tests):
   ! this test calls FieldCreate on a real ESMF_Geom - a plain
   ! MpiTestMethod sub-communicator does not reconfigure ESMF's own
   ! default VM, so a real ESMF collective call still synchronizes
   ! against this suite's full ambient multi-PE test world and would
   ! deadlock without ESMF_TestMethod's proper per-test VM scoping.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_materialize_extensions_enabled_creates_real_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_import_proxy
      type(NodeId) :: extension_id
      type(DependencyNetwork), pointer :: net
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: extension_payload
      type(VariableSpec) :: export_var_spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: result_field
      type(ESMF_TypeKind_Flag) :: got_typekind
      character(:), allocatable :: got_units
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)

      call make_outer_meta('comp_parent_gate_on', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      ! Explicit-override geom (design.md Decisions "Geom/vgrid
      ! resolution order" case (a), the HistoryCollection-style case) -
      ! this synthetic OuterMetaComponent never runs initialize_geom_a/b,
      ! so it has no component-wide default of its own.
      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      export_var_spec%geom = geom
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='km'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_materialize_extensions(.true.)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      call set_materialize_extensions(.false.)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      t_import_proxy => parent_graph%get_resource_index(proxy_key('child_dst', ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_import_proxy), is(true()))

      net => parent_graph%get_network(parent_graph%get_default_network_id())
      extension_id = single_predecessor(net, t_import_proxy)

      node => parent_graph%get_node(extension_id)
      select type (node)
      class is (StateItemNode)
         extension_payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(extension_payload%itemType(rc=status) == ESMF_STATEITEM_FIELD)

      result_field = extension_payload%get_field(rc=status)
      @assertEqual(0, status)
      call FieldGet(result_field, typekind=got_typekind, units=got_units, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R4)
      @assertEqual('km', got_units)

      _UNUSED_DUMMY(this)
   end subroutine test_materialize_extensions_enabled_creates_real_field

   ! Task 6.6 / spec "A non-field item class fails explicitly": a
   ! Vector-typed mismatched pair is reported as an explicit,
   ! distinguishable failure - not a fabricated payload, and not
   ! confused with "no matching export" or "unregistered
   ! characteristic."
   @test(npes=[0])
   subroutine test_materialize_extensions_reports_unsupported_item_class(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved, unsupported
      type(VariableSpec) :: export_var_spec, import_var_spec
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_vector_mismatch', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      export_var_spec%itemType = MAPL_STATEITEM_VECTOR
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T', units='km')
      import_var_spec%itemType = MAPL_STATEITEM_VECTOR
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_var_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_materialize_extensions(.true.)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      call set_materialize_extensions(.false.)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      @assert_that(unsupported%at(1, status), is(equal_to('child_dst:T:unsupported_item_class:VECTOR')))

      _UNUSED_DUMMY(this)
   end subroutine test_materialize_extensions_reports_unsupported_item_class

   ! Task 6.5 / spec "An extension with no executing provider is still
   ! not given a payload": a vertical-grid mismatch (3c's own
   ! "unregistered characteristic fails loudly" case, no real
   ! build_transform) is unaffected by the materialization gate.
   @test(npes=[0])
   subroutine test_materialize_extensions_vgrid_mismatch_unaffected(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved, unsupported
      type(VariableSpec) :: export_var_spec, import_var_spec
      type(mapl_BasicVerticalGrid) :: export_vgrid, import_vgrid
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_vgrid_mismatch', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      call export_vgrid%set_id(1)
      call import_vgrid%set_id(2)

      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T')
      export_var_spec%vertical_grid = export_vgrid
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T')
      import_var_spec%vertical_grid = import_vgrid
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_var_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_materialize_extensions(.true.)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      call set_materialize_extensions(.false.)
      ! VerticalGridCharacteristic%build_transform's own internal _FAIL
      ! (no real vertical-regrid Transform implemented, unchanged 3c
      ! behavior) - a structured "unsupported" report to this test's own
      ! caller (status remains 0 below), but still registered with
      ! pFUnit's own exception mechanism and must be consumed here,
      ! matching this suite's test_freeze_fails_and_leaves_graph_unfrozen_on_conflict
      ! precedent for a propagated internal _FAIL/_ASSERT.
      @assertExceptionRaised('VerticalGridCharacteristic: no vertical-regrid Transform is implemented yet')
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(1, unsupported%size())
      @assert_that(unsupported%at(1, status), is(equal_to('child_dst:T:VERTICAL_GRID')))

      _UNUSED_DUMMY(this)
   end subroutine test_materialize_extensions_vgrid_mismatch_unaffected

   ! visualization-enrichment-layer change, task 3.1/3.2/4.1: a
   ! component's own advertised import/export/internal items are
   ! labeled by their own declared short_name when build_label_map's
   ! result is handed to the exporter (spec.md "Advertised item is
   ! labeled by its own name").
   @test(npes=[0])
   subroutine test_build_label_map_labels_own_advertised_items(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(NodeIdLabelMap) :: label_map
      character(:), allocatable :: dot_text, json_text
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_label_own', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'Q'))
      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_INTERNAL, 'INTERN'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      label_map = gb%build_label_map(outer_meta, status)
      @assert_that(status, is(0))

      dot_text = export_graph_dot(outer_meta%get_component_graph(), rc=status, label_map=label_map)
      @assert_that(status, is(0))
      @assertTrue(index(dot_text, 'label="T"') > 0)
      @assertTrue(index(dot_text, 'label="Q"') > 0)
      @assertTrue(index(dot_text, 'label="INTERN"') > 0)
      ! None of these three carries the proxy marking.
      @assertFalse(index(dot_text, 'shape="doublecircle"') > 0)

      json_text = export_graph_json(outer_meta%get_component_graph(), rc=status, label_map=label_map)
      @assert_that(status, is(0))
      @assertTrue(index(json_text, '"label": "T"') > 0)
      @assertTrue(index(json_text, '"label": "Q"') > 0)
      @assertTrue(index(json_text, '"label": "INTERN"') > 0)
      @assertFalse(index(json_text, '"proxy"') > 0)

      _UNUSED_DUMMY(this)
   end subroutine test_build_label_map_labels_own_advertised_items

   ! Task 3.3/4.2: a cached child-proxy node is labeled
   ! "<child_name>:<short_name>" and marked as a proxy.
   @test(npes=[0])
   subroutine test_build_label_map_labels_child_proxy(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved
      type(NodeIdLabelMap) :: label_map
      character(:), allocatable :: dot_text, json_text
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_label_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      ! Never referenced by any connection below - task 3.4's "no
      ! cached proxy" case: must produce no map entry, not an error.
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'R'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='T')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      label_map = gb%build_label_map(parent_meta, status)
      @assert_that(status, is(0))

      dot_text = export_graph_dot(parent_meta%get_component_graph(), rc=status, label_map=label_map)
      @assert_that(status, is(0))
      @assertTrue(index(dot_text, 'label="child_src:T", kind="StateItemNode", payload="NOTFOUND", shape="doublecircle"') > 0)
      @assertTrue(index(dot_text, 'label="child_dst:T", kind="StateItemNode", payload="NOTFOUND", shape="doublecircle"') > 0)
      ! child_dst:R was never referenced by the connection - no cached
      ! proxy exists for it at all, so no label mentions it.
      @assertFalse(index(dot_text, 'child_dst:R') > 0)

      json_text = export_graph_json(parent_meta%get_component_graph(), rc=status, label_map=label_map)
      @assert_that(status, is(0))
      @assertTrue(index(json_text, '"label": "child_src:T", "proxy": true') > 0)
      @assertTrue(index(json_text, '"label": "child_dst:T", "proxy": true') > 0)
      @assertFalse(index(json_text, 'child_dst:R') > 0)

      _UNUSED_DUMMY(this)
   end subroutine test_build_label_map_labels_child_proxy

   ! -- openspec/changes/composite-state-spec ------------------------------

   ! Task 4.2 / spec "Composite top-level item is represented like an
   ! ordinary advertised item" + "Leaf member of a composite is
   ! represented in the graph": advertising a VariableSpec with declared
   ! members builds a top-level node plus one node per member, each
   ! reachable via the top-level node's own GraphStateItem%state_members
   ! map.
   @test(npes=[0])
   subroutine test_composite_advertise_creates_node_tree(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: composite
      type(NodeId), pointer :: top_id
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: payload
      type(StateItemMemberMap) :: members
      type(NodeId), pointer :: tracer_id
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_composite_advertise', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      composite = make_var(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE')
      composite%itemType = MAPL_STATEITEM_STATE
      call composite%declare_member('tracers', make_var(ESMF_STATEINTENT_EXPORT, 'tracers'), rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(composite)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      top_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE'))
      @assert_that(associated(top_id), is(true()))

      node => graph%get_node(top_id)
      select type (node)
      class is (StateItemNode)
         payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(payload%itemType(rc=status) == ESMF_STATEITEM_STATE)

      members = payload%state_members()
      tracer_id => members%at('tracers')
      @assert_that(associated(tracer_id), is(true()))
      @assert_that(graph%owns_node(tracer_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_composite_advertise_creates_node_tree

   ! Task 4.2 / spec "Nested member of a composite is represented in the
   ! graph": a two-level-deep composite produces the full tree.
   @test(npes=[0])
   subroutine test_composite_advertise_multi_level(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: composite, inner
      type(NodeId), pointer :: top_id, inner_id, leaf_id
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: top_payload, inner_payload
      type(StateItemMemberMap) :: top_members, inner_members
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_composite_multilevel', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      inner = make_var(ESMF_STATEINTENT_EXPORT, 'inner_ignored')
      inner%itemType = MAPL_STATEITEM_STATE
      call inner%declare_member('leaf', make_var(ESMF_STATEINTENT_EXPORT, 'leaf'), rc=status)
      @assert_that(status, is(0))

      composite = make_var(ESMF_STATEINTENT_EXPORT, 'TOP')
      composite%itemType = MAPL_STATEITEM_STATE
      call composite%declare_member('inner_state', inner, rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(composite)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      top_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'TOP'))
      @assert_that(associated(top_id), is(true()))

      node => graph%get_node(top_id)
      select type (node)
      class is (StateItemNode)
         top_payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      top_members = top_payload%state_members()
      inner_id => top_members%at('inner_state')
      @assert_that(associated(inner_id), is(true()))

      node => graph%get_node(inner_id)
      select type (node)
      class is (StateItemNode)
         inner_payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(inner_payload%itemType(rc=status) == ESMF_STATEITEM_STATE)
      inner_members = inner_payload%state_members()
      leaf_id => inner_members%at('leaf')
      @assert_that(associated(leaf_id), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_composite_advertise_multi_level

   ! Task 4.2 / spec "Re-advertising the same composite declaration does
   ! not duplicate its node tree".
   @test(npes=[0])
   subroutine test_composite_readvertise_does_not_duplicate(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: composite
      type(NodeIdSet) :: ids
      integer :: status
      integer :: count_after_first
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_composite_readvertise', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      composite = make_var(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE')
      composite%itemType = MAPL_STATEITEM_STATE
      call composite%declare_member('tracers', make_var(ESMF_STATEINTENT_EXPORT, 'tracers'), rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(composite)

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      ids = graph%get_node_ids()
      count_after_first = ids%size()

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      ids = graph%get_node_ids()
      @assertEqual(count_after_first, ids%size())

      _UNUSED_DUMMY(this)
   end subroutine test_composite_readvertise_does_not_duplicate

   ! Task 4.3: this is the test that would have failed against this
   ! change's first (separate-CompositeStateSpec-vector) design - two
   ! components each advertise a composite VariableSpec under the same
   ! top-level short_name via ordinary add_var_spec; an ordinary
   ! MatchConnection wires the top-level composite items directly, using
   ! the EXISTING graphbuilder_resolve_connections/for_each_matching_import
   ! code path completely unmodified (design.md Decisions "Top-level
   ! connectability is a consequence of the representation, not
   ! separately-implemented logic"). Direct wire, not an extension chain,
   ! since neither composite carries units/vertical_grid of its own.
   @test(npes=[0])
   subroutine test_ordinary_connection_wires_matching_composite(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved
      type(VariableSpec) :: export_composite, import_composite
      type(NodeId), pointer :: export_proxy, import_proxy
      type(DependencyNetwork), pointer :: net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_composite_match', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_composite = make_var(ESMF_STATEINTENT_EXPORT, 'PHYS_STATE')
      export_composite%itemType = MAPL_STATEITEM_STATE
      call export_composite%declare_member('tracers', make_var(ESMF_STATEINTENT_EXPORT, 'tracers'), rc=status)
      @assert_that(status, is(0))
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_composite)

      import_composite = make_var(ESMF_STATEINTENT_IMPORT, 'PHYS_STATE')
      import_composite%itemType = MAPL_STATEITEM_STATE
      call import_composite%declare_member('tracers', make_var(ESMF_STATEINTENT_IMPORT, 'tracers'), rc=status)
      @assert_that(status, is(0))
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_composite)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      ! Unmodified call - no composite-aware branch added anywhere in
      ! graphbuilder_resolve_connections/for_each_matching_import/
      ! find_export_var_spec.
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      parent_graph => parent_meta%get_component_graph()
      export_proxy => parent_graph%get_resource_index(proxy_key('child_src', ESMF_STATEINTENT_EXPORT, 'PHYS_STATE'))
      import_proxy => parent_graph%get_resource_index(proxy_key('child_dst', ESMF_STATEINTENT_IMPORT, 'PHYS_STATE'))
      @assert_that(associated(export_proxy), is(true()))
      @assert_that(associated(import_proxy), is(true()))

      net => parent_graph%get_network(parent_graph%get_default_network_id())
      ! Direct wire (spec "Matching export and import are wired"), not an
      ! extension chain - the composite items carry no units/vertical_grid
      ! of their own, so find_mismatched_characteristics reports none.
      @assert_that(net%contains_dependency(export_proxy, import_proxy), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_ordinary_connection_wires_matching_composite

   ! -- openspec/changes/callback-wiring ------------------------------------

   ! Builds the PassiveTracer CallbackInterface (15-callbacks.md sec
   ! 15.3): one "tracers" FieldBundle argument, "get" (OUT) / "put" (IN)
   ! methods - same fixture shape as
   ! graph/tests/Test_CallbackStateBinding.pf's own
   ! make_passive_tracer_interface.
   function make_passive_tracer_interface(rc) result(iface)
      integer, optional, intent(out) :: rc
      type(CallbackInterface) :: iface

      integer :: status

      call iface%declare_argument('tracers', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call iface%declare_method('get', rc=status)
      @assertEqual(0, status)
      call iface%declare_method('put', rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('get', 'tracers', MAPL_ACCESS_OUT, rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('put', 'tracers', MAPL_ACCESS_IN, rc=status)
      @assertEqual(0, status)

      _RETURN(_SUCCESS)
   end function make_passive_tracer_interface

   ! An interface with a single INOUT argument, exercising REQ-CB-018's
   ! get+put-both-directions case (task 7.3) - distinct from
   ! PassiveTracer's own two-method get/put split.
   function make_exchanger_interface(rc) result(iface)
      integer, optional, intent(out) :: rc
      type(CallbackInterface) :: iface

      integer :: status

      call iface%declare_argument('value', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call iface%declare_method('exchange', rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('exchange', 'value', MAPL_ACCESS_INOUT, rc=status)
      @assertEqual(0, status)

      _RETURN(_SUCCESS)
   end function make_exchanger_interface

   ! One composite export satisfying PassiveTracer: itemType STATE, one
   ! declared 'tracers' FieldBundle member.
   function make_tracer_callback_export(short_name) result(var_spec)
      character(*), intent(in) :: short_name
      type(VariableSpec) :: var_spec

      type(VariableSpec) :: tracers_member
      integer :: status

      var_spec = make_var(ESMF_STATEINTENT_EXPORT, short_name)
      var_spec%itemType = MAPL_STATEITEM_STATE

      tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers')
      tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call var_spec%declare_member('tracers', tracers_member, rc=status)
      @assertEqual(0, status)
   end function make_tracer_callback_export

   ! Builds root -> CHEM -> DU, SS (each exporting a 'tracer_callback'
   ! composite satisfying PassiveTracer) plus root -> DYN (a plain child,
   ! left for the caller to advertise its own 'tracers' import onto) -
   ! mirrors 15-callbacks.md's own DU/SS/... tracer-callback example.
   ! Every component below DYN is already advertised, children before
   ! parents, matching real recursion order.
   subroutine build_tracer_hierarchy(service_name, root_gc, root_meta, chem_meta, du_meta, ss_meta, &
        dyn_meta, iface, interface_id, rc)
      character(*), intent(in) :: service_name
      type(ESMF_GridComp), intent(out) :: root_gc
      type(OuterMetaComponent), pointer, intent(out) :: root_meta
      type(OuterMetaComponent), pointer, intent(out) :: chem_meta
      type(OuterMetaComponent), pointer, intent(out) :: du_meta
      type(OuterMetaComponent), pointer, intent(out) :: ss_meta
      type(OuterMetaComponent), pointer, intent(out) :: dyn_meta
      type(CallbackInterface), intent(out) :: iface
      type(CallbackInterfaceId), intent(out) :: interface_id
      integer, optional, intent(out) :: rc

      integer :: status
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, dyn_driver, du_driver, ss_driver
      type(ESMF_GridComp) :: chem_gc, dyn_gc, du_gc, ss_gc
      type(ComponentSpec), pointer :: du_spec, ss_spec
      type(GraphBuilder) :: gb

      iface = make_passive_tracer_interface(_RC)
      call register_callback_interface(service_name, iface, interface_id, _RC)

      call make_outer_meta('root_' // service_name, root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('DYN', child_spec, _RC)

      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)

      dyn_driver = root_meta%get_child('DYN', _RC)
      dyn_gc = dyn_driver%get_gridcomp()
      dyn_meta => get_outer_meta(dyn_gc, _RC)

      child_spec = ChildSpec()
      call chem_meta%add_child('DU', child_spec, _RC)
      child_spec = ChildSpec()
      call chem_meta%add_child('SS', child_spec, _RC)

      du_driver = chem_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)

      ss_driver = chem_meta%get_child('SS', _RC)
      ss_gc = ss_driver%get_gridcomp()
      ss_meta => get_outer_meta(ss_gc, _RC)

      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_tracer_callback_export('tracer_callback'))

      ss_spec => ss_meta%get_component_spec()
      call ss_spec%add_var_spec(make_tracer_callback_export('tracer_callback'))

      call gb%advertise(du_meta, _RC)
      call gb%advertise(ss_meta, _RC)
      call gb%advertise(chem_meta, _RC)
      call gb%advertise(dyn_meta, _RC)
      call gb%advertise(root_meta, _RC)

      _RETURN(_SUCCESS)
   end subroutine build_tracer_hierarchy

   ! Task 2.2 / spec "Descendant exports are visible under a
   ! hierarchically-qualified name": own export under own name,
   ! descendant exports qualified and distinguishable, re-querying does
   ! not duplicate.
   @test(npes=[0])
   subroutine test_build_qualified_export_namespace_multilevel(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: chem_driver, du_driver, ss_driver
      type(ESMF_GridComp) :: chem_gc, du_gc, ss_gc
      type(OuterMetaComponent), pointer :: chem_meta, du_meta, ss_meta
      type(ComponentSpec), pointer :: chem_spec, du_spec, ss_spec
      type(QualifiedExportEntry), allocatable :: entries(:), entries_again(:)
      integer :: status
      type(GraphBuilder) :: gb
      logical :: found_own, found_du, found_ss
      integer :: i

      call make_outer_meta('ns_root', root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('CHEM', child_spec, _RC)
      chem_driver = root_meta%get_child('CHEM', _RC)
      chem_gc = chem_driver%get_gridcomp()
      chem_meta => get_outer_meta(chem_gc, _RC)

      chem_spec => chem_meta%get_component_spec()
      call chem_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'Y'))

      child_spec = ChildSpec()
      call chem_meta%add_child('DU', child_spec, _RC)
      child_spec = ChildSpec()
      call chem_meta%add_child('SS', child_spec, _RC)

      du_driver = chem_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)
      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'X'))

      ss_driver = chem_meta%get_child('SS', _RC)
      ss_gc = ss_driver%get_gridcomp()
      ss_meta => get_outer_meta(ss_gc, _RC)
      ss_spec => ss_meta%get_component_spec()
      call ss_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'X'))

      call gb%advertise(du_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(ss_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(chem_meta, status)
      @assert_that(status, is(0))

      entries = build_qualified_export_namespace(chem_meta, status)
      @assert_that(status, is(0))
      @assertEqual(3, size(entries))

      found_own = .false.
      found_du = .false.
      found_ss = .false.
      do i = 1, size(entries)
         if (entries(i)%qualified_name == 'Y' .and. len(entries(i)%comp_path) == 0) found_own = .true.
         if (entries(i)%qualified_name == 'DU/X') found_du = .true.
         if (entries(i)%qualified_name == 'SS/X') found_ss = .true.
      end do
      @assert_that(found_own, is(true()))
      @assert_that(found_du, is(true()))
      @assert_that(found_ss, is(true()))

      entries_again = build_qualified_export_namespace(chem_meta, status)
      @assert_that(status, is(0))
      @assertEqual(size(entries), size(entries_again))

      _UNUSED_DUMMY(this)
   end subroutine test_build_qualified_export_namespace_multilevel

   ! Task 2.3 / design.md Risks cross-check: the graph-native qualified
   ! name for a descendant export matches what
   ! VirtualConnectionPt%get_full_name() would produce for the same
   ! single-level case.
   @test(npes=[0])
   subroutine test_qualified_name_matches_virtualconnectionpt_convention(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: du_driver
      type(ESMF_GridComp) :: du_gc
      type(OuterMetaComponent), pointer :: du_meta
      type(ComponentSpec), pointer :: du_spec
      type(QualifiedExportEntry), allocatable :: entries(:)
      type(VirtualConnectionPt) :: expected_v_pt
      integer :: status
      type(GraphBuilder) :: gb
      integer :: i
      logical :: found

      call make_outer_meta('ns_crosscheck_root', root_gc, root_meta, _RC)
      child_spec = ChildSpec()
      call root_meta%add_child('DU', child_spec, _RC)
      du_driver = root_meta%get_child('DU', _RC)
      du_gc = du_driver%get_gridcomp()
      du_meta => get_outer_meta(du_gc, _RC)
      du_spec => du_meta%get_component_spec()
      call du_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'tracers'))

      call gb%advertise(du_meta, status)
      @assert_that(status, is(0))

      entries = build_qualified_export_namespace(root_meta, status)
      @assert_that(status, is(0))

      expected_v_pt = VirtualConnectionPt(state_intent='export', short_name='tracers')
      expected_v_pt = expected_v_pt%add_comp_name('DU')

      found = .false.
      do i = 1, size(entries)
         if (entries(i)%comp_path == 'DU') then
            @assertEqual(expected_v_pt%get_full_name(), entries(i)%qualified_name)
            found = .true.
         end if
      end do
      @assert_that(found, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_qualified_name_matches_virtualconnectionpt_convention

   ! Task 3.2 / spec "A destination with no declared callback interface
   ! is unaffected": ordinary resolution, unchanged, for a var_spec
   ! whose callback_interface_id is left at its default (unset) value.
   @test(npes=[0])
   subroutine test_non_callback_destination_unaffected(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved
      type(NodeId), pointer :: t_export_proxy, t_import_proxy
      type(DependencyNetwork), pointer :: net
      type(VariableSpec) :: import_var_spec
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_parent_no_callback', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T')
      @assertFalse(import_var_spec%callback_interface_id%is_valid())
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_var_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      parent_graph => parent_meta%get_component_graph()
      t_export_proxy => parent_graph%get_resource_index(proxy_key('child_src', ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_proxy => parent_graph%get_resource_index(proxy_key('child_dst', ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_proxy), is(true()))
      @assert_that(associated(t_import_proxy), is(true()))

      net => parent_graph%get_network(parent_graph%get_default_network_id())
      @assert_that(net%contains_dependency(t_export_proxy, t_import_proxy), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_non_callback_destination_unaffected

   ! Task 4.2 / spec "A pattern matching multiple qualified exports
   ! selects all of them" + "A matching export that does not implement
   ! the expected interface is rejected": DU/SS conform, BAD (no
   ! declared 'tracers' member) does not.
   @test(npes=[0])
   subroutine test_resolve_callback_import_matches_and_rejects(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, du_meta, ss_meta, dyn_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: bad_driver
      type(ESMF_GridComp) :: bad_gc
      type(OuterMetaComponent), pointer :: bad_meta
      type(ComponentSpec), pointer :: bad_spec
      type(VariableSpec) :: bad_export
      type(VariableSpec) :: dst_var_spec
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(StringVector) :: rejected
      integer :: status
      type(GraphBuilder) :: gb
      logical :: found_du, found_ss
      integer :: i

      call build_tracer_hierarchy('svc-4-2', root_gc, root_meta, chem_meta, du_meta, ss_meta, &
           dyn_meta, iface, interface_id, _RC)

      child_spec = ChildSpec()
      call chem_meta%add_child('BAD', child_spec, _RC)
      bad_driver = chem_meta%get_child('BAD', _RC)
      bad_gc = bad_driver%get_gridcomp()
      bad_meta => get_outer_meta(bad_gc, _RC)
      bad_export = make_var(ESMF_STATEINTENT_EXPORT, 'tracer_callback')
      bad_export%itemType = MAPL_STATEITEM_STATE
      bad_spec => bad_meta%get_component_spec()
      call bad_spec%add_var_spec(bad_export)
      call gb%advertise(bad_meta, status)
      @assert_that(status, is(0))

      dst_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'tracers')
      dst_var_spec%callback_interface_id = interface_id

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      matches = resolve_callback_import(root_meta, src_pt, dst_var_spec, rejected=rejected, rc=status)
      @assert_that(status, is(0))

      @assertEqual(2, size(matches))
      found_du = .false.
      found_ss = .false.
      do i = 1, size(matches)
         if (matches(i)%qualified_name == 'DU/tracer_callback') found_du = .true.
         if (matches(i)%qualified_name == 'SS/tracer_callback') found_ss = .true.
      end do
      @assert_that(found_du, is(true()))
      @assert_that(found_ss, is(true()))

      @assertEqual(1, rejected%size())
      @assertTrue(index(rejected%of(1), 'BAD/tracer_callback') > 0)
      @assertTrue(index(rejected%of(1), 'missing_member:tracers') > 0)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_matches_and_rejects

   ! Task 4.2 (empty-match case) / spec "A pattern matching no export
   ! resolves to an empty, valid selection".
   @test(npes=[0])
   subroutine test_resolve_callback_import_no_match_is_empty(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, du_meta, ss_meta, dyn_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(VariableSpec) :: dst_var_spec
      type(ConnectionPt) :: src_pt
      type(QualifiedExportEntry), allocatable :: matches(:)
      integer :: status

      call build_tracer_hierarchy('svc-4-2-empty', root_gc, root_meta, chem_meta, du_meta, ss_meta, &
           dyn_meta, iface, interface_id, _RC)

      dst_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'tracers')
      dst_var_spec%callback_interface_id = interface_id

      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='no_such_thing'))

      matches = resolve_callback_import(root_meta, src_pt, dst_var_spec, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, size(matches))

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_import_no_match_is_empty

   ! Task 5.3 / spec "The materialized collection contains exactly the
   ! resolved matches" + "Re-resolving does not duplicate collection
   ! members": full pipeline through the public
   ! GraphBuilder%resolve_connections() entry point.
   @test(npes=[0])
   subroutine test_callback_collection_materializes_and_wires_import(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, du_meta, ss_meta, dyn_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ComponentSpec), pointer :: root_spec, dyn_spec
      type(VariableSpec) :: dyn_import
      type(MatchConnection) :: conn
      type(StringVector) :: unresolved
      type(ComponentGraph), pointer :: root_graph
      type(NodeId), pointer :: import_id
      type(DependencyNetwork), pointer :: net
      type(NodeIdSet), target :: preds
      type(NodeIdSetIterator) :: pred_iter
      type(NodeId) :: collection_id, collection_id_again
      class(GraphNode), pointer :: collection_node
      type(GraphStateItem) :: collection_payload
      type(StateItemMemberMap) :: members
      integer :: status
      type(GraphBuilder) :: gb

      call build_tracer_hierarchy('svc-5-3', root_gc, root_meta, chem_meta, du_meta, ss_meta, &
           dyn_meta, iface, interface_id, _RC)

      dyn_import = make_var(ESMF_STATEINTENT_IMPORT, 'tracers')
      dyn_import%callback_interface_id = interface_id
      dyn_spec => dyn_meta%get_component_spec()
      call dyn_spec%add_var_spec(dyn_import)
      call gb%advertise(dyn_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback')), &
           ConnectionPt('DYN', VirtualConnectionPt(state_intent='import', short_name='tracers')))
      root_spec => root_meta%get_component_spec()
      call root_spec%add_connection(conn)

      call gb%resolve_connections(root_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      root_graph => root_meta%get_component_graph()
      import_id => root_graph%get_resource_index(proxy_key('DYN', ESMF_STATEINTENT_IMPORT, 'tracers'))
      @assert_that(associated(import_id), is(true()))

      net => root_graph%get_network(root_graph%get_default_network_id())
      preds = net%get_predecessors(import_id)
      @assertEqual(1, preds%size())
      pred_iter = preds%ftn_begin()
      call pred_iter%next()
      collection_id = pred_iter%of()

      collection_node => root_graph%get_node(collection_id)
      select type (collection_node)
      class is (StateItemNode)
         collection_payload = collection_node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      members = collection_payload%state_members()
      @assertEqual(2, members%size())
      @assert_that(associated(members%at('DU/tracer_callback')), is(true()))
      @assert_that(associated(members%at('SS/tracer_callback')), is(true()))

      ! Idempotency: re-resolving does not create a second collection.
      call gb%resolve_connections(root_meta, unresolved_imports=unresolved, rc=status)
      @assert_that(status, is(0))
      preds = net%get_predecessors(import_id)
      @assertEqual(1, preds%size())
      pred_iter = preds%ftn_begin()
      call pred_iter%next()
      collection_id_again = pred_iter%of()
      @assert_that(collection_id_again == collection_id, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_callback_collection_materializes_and_wires_import

   ! Task 6.2 / design.md Context: build_callback_state_binding's bound
   ! argument NodeIds match the real, already-materialized member
   ! NodeIds in DU's own graph - not caller-supplied stand-ins.
   @test(npes=[0])
   subroutine test_build_callback_state_binding_uses_real_member_nodeids(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: root_gc
      type(OuterMetaComponent), pointer :: root_meta, chem_meta, du_meta, ss_meta, dyn_meta
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ConnectionPt) :: src_pt
      type(VariableSpec) :: dst_var_spec
      type(QualifiedExportEntry), allocatable :: matches(:)
      type(CallbackStateBinding) :: binding
      type(ComponentGraph), pointer :: du_graph
      class(GraphNode), pointer :: du_node
      type(GraphStateItem) :: du_payload
      type(StateItemMemberMap) :: du_members
      type(NodeId), pointer :: expected_member_id
      type(NodeId), pointer :: bound_member_id
      type(NodeId), pointer :: du_state_id
      integer :: status
      integer :: i
      integer :: du_index

      call build_tracer_hierarchy('svc-6-2', root_gc, root_meta, chem_meta, du_meta, ss_meta, &
           dyn_meta, iface, interface_id, _RC)

      dst_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'tracers')
      dst_var_spec%callback_interface_id = interface_id
      src_pt = ConnectionPt('CHEM', VirtualConnectionPt(state_intent='export', short_name='.*/tracer_callback'))

      matches = resolve_callback_import(root_meta, src_pt, dst_var_spec, rc=status)
      @assert_that(status, is(0))

      du_index = 0
      do i = 1, size(matches)
         if (matches(i)%qualified_name == 'DU/tracer_callback') du_index = i
      end do
      @assert_that(du_index > 0, is(true()))

      binding = build_callback_state_binding(root_meta, 'CHEM', matches(du_index), interface_id, iface, status)
      @assert_that(status, is(0))

      du_graph => du_meta%get_component_graph()
      du_state_id => du_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'tracer_callback'))
      @assert_that(associated(du_state_id), is(true()))
      du_node => du_graph%get_node(du_state_id)
      select type (du_node)
      class is (StateItemNode)
         du_payload = du_node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      du_members = du_payload%state_members()
      expected_member_id => du_members%at('tracers')
      @assert_that(associated(expected_member_id), is(true()))

      bound_member_id => binding%get_argument_binding('tracers')
      @assert_that(associated(bound_member_id), is(true()))
      @assert_that(bound_member_id == expected_member_id, is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_build_callback_state_binding_uses_real_member_nodeids

   ! Task 7.3 / spec "Get and put networks are independently
   ! constructed" + "Each network is acyclic on its own even if their
   ! union is not": a single shared provider item feeds "get" and
   ! receives "put" - provider->value->provider would be a 2-cycle if
   ! the two networks were merged, but each network alone has only one
   ! edge.
   @test(npes=[0])
   subroutine test_callback_method_binding_builds_get_put_networks(this)
      class(MpiTestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(VariableSpec) :: exchanger_export, exchanger_member
      type(NodeId) :: state_node_id
      type(NodeId), pointer :: member_node_id
      type(NodeId) :: provider_id
      type(GraphStateItem) :: payload
      class(GraphNode), pointer :: node
      type(StateItemMemberMap) :: members
      type(StateItemMemberMap) :: provider_get_ids, provider_put_ids
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(CallbackStateBinding) :: state_binding
      type(CallbackMethodBinding) :: method_binding
      type(DependencyNetwork), pointer :: get_net, put_net
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('comp_exchanger', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()

      exchanger_export = make_var(ESMF_STATEINTENT_EXPORT, 'exchanger')
      exchanger_export%itemType = MAPL_STATEITEM_STATE
      exchanger_member = make_var(ESMF_STATEINTENT_EXPORT, 'value')
      exchanger_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call exchanger_export%declare_member('value', exchanger_member, rc=status)
      @assert_that(status, is(0))
      call comp_spec%add_var_spec(exchanger_export)

      call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'provider_shared'))

      call gb%advertise(outer_meta, status)
      @assert_that(status, is(0))

      graph => outer_meta%get_component_graph()
      state_node_id = graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'exchanger'))
      node => graph%get_node(state_node_id)
      select type (node)
      class is (StateItemNode)
         payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      members = payload%state_members()
      member_node_id => members%at('value')
      @assert_that(associated(member_node_id), is(true()))

      iface = make_exchanger_interface(status)
      @assert_that(status, is(0))
      call register_callback_interface('svc-7-3', iface, interface_id, status)
      @assert_that(status, is(0))

      state_binding = CallbackStateBinding(interface_id, iface, state_node_id)
      call state_binding%bind_argument('value', member_node_id, status)
      @assert_that(status, is(0))
      call state_binding%bind_method('exchange', status)
      @assert_that(status, is(0))

      provider_id = graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'provider_shared'))
      call provider_get_ids%insert('value', provider_id)
      call provider_put_ids%insert('value', provider_id)

      method_binding = build_callback_method_binding(outer_meta, iface, 'exchange', state_binding, &
           provider_get_ids, provider_put_ids, status)
      @assert_that(status, is(0))

      get_net => graph%get_network(method_binding%get_get_network_id())
      put_net => graph%get_network(method_binding%get_put_network_id())
      @assert_that(associated(get_net), is(true()))
      @assert_that(associated(put_net), is(true()))

      @assert_that(get_net%contains_dependency(provider_id, member_node_id), is(true()))
      @assert_that(put_net%contains_dependency(member_node_id, provider_id), is(true()))

      ! Each network individually acyclic - freeze runs
      ! ComponentGraph%validate() over every owned network, including
      ! these two, and would fail if either one contained a cycle.
      call graph%freeze(status)
      @assert_that(status, is(0))

      _UNUSED_DUMMY(this)
   end subroutine test_callback_method_binding_builds_get_put_networks

end module Test_GraphBuilder
