#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! Tests for GraphBuilder_CallbackRealization_smod.F90's
! graphbuilder_realize_callback_states: giving each Handler's declared
! callback composite (itemType STATE) a real ESMF_State holding its
! members, at the point initialize_realize_accepted.F90 calls
! gb%realize_callback_states (right after gb%allocate_internals).
!
! type=ESMF_TestMethod, npes=[1] throughout, following
! Test_GraphBuilderMaterializeGate.pf's own precedent: every test here
! creates a real ESMF_Geom and real Fields, which needs a real per-test
! ESMF VM.
module Test_GraphBuilder_CallbackRealization
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod
   use mapl_ComponentSpec_mod, only: ComponentSpec
   use mapl_ComponentSpecParser_mod, only: parse_var_specs
   use mapl_StateRegistry_mod, only: StateRegistry
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_VariableSpecVector_mod, only: VariableSpecVector, VariableSpecVectorIterator, operator(/=)
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_NodeId_mod, only: NodeId
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem
   use mapl_StateItem_mod, only: MAPL_STATEITEM_STATE, MAPL_STATEITEM_FIELDBUNDLE, MAPL_STATEITEM_FIELD
   use mapl_CallbackInterfaceId_mod, only: CallbackInterfaceId
   use mapl_CallbackInterface_mod, only: CallbackInterface
   use mapl_CallbackInterfaceRegistry_mod, only: register_callback_interface, &
        reset_callback_registry_for_testing
   use mapl_StateItemFlag_mod, only: MAPL_VARIANT_FIELDBUNDLE => MAPL_STATEITEM_FIELDBUNDLE, &
        MAPL_VARIANT_FIELD => MAPL_STATEITEM_FIELD
   use mapl_GeomUtilities_mod, only: GeomSetId
   use mapl_GraphOwnsUserStates_mod, only: set_graph_owns_user_states
   use mapl_GraphMode_mod, only: set_graph_mode, GRAPH_MODE_GRAPH, GRAPH_MODE_REGISTRY
   use mapl_field_api, only: MAPL_FieldGet
   use mapl_FieldCreate_mod, only: FieldsAreAliased
   use mapl_InfoUtilities_mod, only: MAPL_InfoHasCallbackInterface, MAPL_InfoGetCallbackInterface
   use mapl_geom_api, only: mapl_SameGeom
   use mapl_VerticalStaggerLoc_mod, only: VerticalStaggerLoc, VERTICAL_STAGGER_NONE, &
        VERTICAL_STAGGER_CENTER, VERTICAL_STAGGER_EDGE, operator(==)
   use mapl_vertical_grid_api, only: mapl_BasicVerticalGrid, mapl_BasicVerticalGridSpec, &
        mapl_VerticalGrid, mapl_VerticalGridManager, mapl_get_vertical_grid_manager
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_MultiState_mod, only: MultiState
   use mapl_ChildSpec_mod, only: ChildSpec
   use mapl_ConnectionPt_mod, only: ConnectionPt
   use mapl_VirtualConnectionPt_mod, only: VirtualConnectionPt
   use mapl_MatchConnection_mod, only: MatchConnection
   use mapl_GraphResolutionEntryVector_mod, only: GraphResolutionEntryVector
   use GraphBuilderTestSupport_mod, only: make_outer_meta, make_var
   use mapl_AccessSpec_mod, only: MAPL_ACCESS_IN, MAPL_ACCESS_OUT
   use mapl_CallbackMethodBinding_mod, only: CallbackMethodBinding
   use mapl_StateAddMethod_mod, only: StateAddMethod
   use mapl_ExtensionResolution_mod, only: set_materialize_extensions
   use mapl_NodeRevision_mod, only: NodeRevision, operator(/=)
   use mapl_FieldPointerUtilities_mod, only: assign_fptr
   use ESMF_TestMethod_mod
   use esmf
   use pfunit
   implicit none(type, external)

   ! Exercised through mapl_StateAddMethod_mod's I_CallBackMethod interface
   ! (infrastructure/esmf/ESMF_Interfaces.F90), the exact shape
   ! ESMF_MethodExecute invokes - see Test_EsmfStateMethodInvoker.pf's own
   ! precedent for a module-level recording flag.
   logical :: g_cb_put_called = .false.
   logical :: g_cb_get_called = .false.

contains

   ! Attached to the Handler's own 'cb' composite State under label 'put'
   ! (MAPL_ACCESS_IN argument access, the `provides:` direction): the real
   ! data movement for this direction happens before invoke(), in
   ! pull_callback_get_arguments, so this body only records that it ran.
   subroutine cb_put_method(state, rc)
      type(ESMF_State) :: state
      integer, intent(out) :: rc

      g_cb_put_called = .true.
      rc = 0
      _UNUSED_DUMMY(state)
   end subroutine cb_put_method

   ! Attached under label 'get' (MAPL_ACCESS_OUT argument access, the
   ! `receives:` direction): writes a known literal into the composite's
   ! own 'quantity' member Field, standing in for a Handler computing an
   ! output - advance_callback_put_arguments only advances the Invoker's
   ! receive-item NodeRevision afterward (bookkeeping), so no production
   ! code path copies this literal into the Invoker's own item.
   subroutine cb_get_method(state, rc)
      type(ESMF_State) :: state
      integer, intent(out) :: rc

      type(ESMF_Field) :: field
      real(ESMF_KIND_R4), pointer :: fptr(:)
      integer :: status

      call ESMF_StateGet(state, 'quantity', field, rc=status)
      if (status /= 0) then
         rc = status
         return
      end if
      call assign_fptr(field, fptr, rc=status)
      if (status /= 0) then
         rc = status
         return
      end if
      fptr = 42.0
      g_cb_get_called = .true.
      rc = 0
   end subroutine cb_get_method

   ! A declared composite's one FIELD member, never aliased, is a "new"
   ! member: ADVERTISE only attached its descriptor, and realization must
   ! create/complete a real Field for it and insert it into the
   ! composite's own real ESMF_State under its member name.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_creates_new_field_member(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(VariableSpec) :: cb_export, arg_member
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field
      type(ESMF_StateItem_Flag) :: cb_kind
      type(ESMF_TypeKind_Flag) :: got_typekind
      character(:), allocatable :: got_units
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 401, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_new_field', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE

      arg_member = make_var(ESMF_STATEINTENT_EXPORT, 'arg1', units='K')
      arg_member%itemType = MAPL_STATEITEM_FIELD
      arg_member%geom = geom
      call cb_export%declare_member('arg1', arg_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', itemType=cb_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(cb_kind == ESMF_STATEITEM_STATE)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(arg_field, typekind=got_typekind, units=got_units, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R4)
      @assertEqual('K', got_units)

      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_creates_new_field_member

   ! A member declared with callback_member_alias set shares the aliased
   ! INTERNAL item's own Field zero-copy: realization must not create a
   ! second Field, just insert the same one under the member's own name.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_alias_member_shares_internal_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(VariableSpec) :: internal_var, cb_export, tracer_member
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: tracer_field, internal_field
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: internal_id
      class(GraphNode), pointer :: internal_node
      type(GraphStateItem), pointer :: internal_payload
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 402, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_alias', gc, meta, _RC)
      spec => meta%get_component_spec()

      internal_var = make_var(ESMF_STATEINTENT_INTERNAL, 'TR1', units='kg kg-1')
      internal_var%itemType = MAPL_STATEITEM_FIELD
      internal_var%geom = geom
      call spec%add_var_spec(internal_var)

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE

      tracer_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracer')
      tracer_member%itemType = MAPL_STATEITEM_FIELD
      tracer_member%callback_member_alias = 'TR1'
      call cb_export%declare_member('tracer', tracer_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'tracer', tracer_field, rc=status)
      @assertEqual(0, status)

      ! The alias member's own node IS the aliased INTERNAL item's own
      ! node (CompositeStateMaterialization.F90's materialize_member),
      ! so the INTERNAL item's own real Field - fetched directly from the
      ! graph, not from the real internal ESMF_State (populate_state was
      ! never called in this test) - is the same object.
      graph => meta%get_component_graph()
      internal_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_INTERNAL, 'TR1'))
      @assertTrue(associated(internal_id))
      internal_node => graph%get_node(internal_id)
      select type (internal_node)
      class is (StateItemNode)
         internal_payload => internal_node%get_payload_ptr()
      class default
         @assertTrue(.false., 'TR1 is not a StateItemNode')
      end select
      internal_field = internal_payload%get_field(rc=status)
      @assertEqual(0, status)

      @assertTrue(FieldsAreAliased(tracer_field, internal_field))

      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_alias_member_shares_internal_field

   ! A Handler composite that declares a valid callback_interface_id gets
   ! its interface name recorded on the realized ESMF_State's own Info
   ! (MAPL_InfoSetCallbackInterface, through record_callback_interface_name),
   ! readable back via MAPL_InfoGetCallbackInterface.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_records_interface_name(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(VariableSpec) :: cb_export, tracers_member
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state
      logical :: has_interface
      character(:), allocatable :: recorded_name
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 403, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('tracers', MAPL_VARIANT_FIELDBUNDLE, rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-realize-name', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_iface_name', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE
      cb_export%callback_interface_id = interface_id

      tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers')
      tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      tracers_member%geom = geom
      call cb_export%declare_member('tracers', tracers_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)

      has_interface = MAPL_InfoHasCallbackInterface(cb_state, rc=status)
      @assertEqual(0, status)
      @assertTrue(has_interface)
      call MAPL_InfoGetCallbackInterface(cb_state, recorded_name, rc=status)
      @assertEqual(0, status)
      @assertEqual('svc-realize-name', recorded_name)

      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_records_interface_name

   ! REALIZE_ACCEPTED can run a second time (initialize_realize_accepted.F90's
   ! own call site may be reached more than once in some lifecycles) - a
   ! second gb%realize_callback_states call must not duplicate the
   ! composite entry in export_state, nor the member entry inside it, and
   ! must leave the SAME underlying Field object in place (add-or-replace
   ! by name via MAPL_NamedAlias+ESMF_StateAddReplace, not a fresh one).
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_idempotent_second_pass(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(VariableSpec) :: cb_export, arg_member
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field_pass1, arg_field_pass2
      integer :: export_item_count, cb_item_count
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 404, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_idempotent', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE

      arg_member = make_var(ESMF_STATEINTENT_EXPORT, 'arg1', units='K')
      arg_member%itemType = MAPL_STATEITEM_FIELD
      arg_member%geom = geom
      call cb_export%declare_member('arg1', arg_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)

      call gb%realize_callback_states(meta, export_state, status)
      @assertEqual(0, status)
      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field_pass1, rc=status)
      @assertEqual(0, status)

      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, itemCount=export_item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, export_item_count)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, itemCount=cb_item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, cb_item_count)

      call ESMF_StateGet(cb_state, 'arg1', arg_field_pass2, rc=status)
      @assertEqual(0, status)
      @assertTrue(FieldsAreAliased(arg_field_pass1, arg_field_pass2))

      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_idempotent_second_pass

   ! A composite member that declares no geom of its own (DEFERRED, not
   ! SPECIFIED) picks up the Handler's own component geometry, the same
   ! way an ordinary flat export does - graphbuilder_resolve_deferred
   ! (run via gb%run_geometry_hook) walks every registered StateItemNode,
   ! composite members included, not just advertise_one's flat items.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_member_defaults_geometry(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(VariableSpec) :: cb_export, arg_member
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_Geom), allocatable :: field_geom
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 405, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_geom_default', gc, meta, _RC)
      call meta%set_geom(geom)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE

      ! Built by hand, not make_var: make_var always assigns a geom_id,
      ! which would make the geometry entry SPECIFIED by identity alone
      ! rather than DEFERRED.
      arg_member%state_intent = ESMF_STATEINTENT_EXPORT
      arg_member%short_name = 'arg1'
      arg_member%itemType = MAPL_STATEITEM_FIELD
      arg_member%vertical_stagger = VERTICAL_STAGGER_NONE
      call cb_export%declare_member('arg1', arg_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%run_geometry_hook(meta)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(arg_field, geom=field_geom, rc=status)
      @assertEqual(0, status)
      @assertTrue(mapl_SameGeom(geom, field_geom))

      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_member_defaults_geometry

   ! A composite member nested one level deep (declared via its own
   ! declare_member on an intermediate composite member) recurses through
   ! realize_callback_member -> realize_callback_state a second time,
   ! producing a nested real ESMF_State inside the top-level composite.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_nested_composite_member(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(VariableSpec) :: cb_export, inner_state, leaf_member
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state, inner_cb_state
      type(ESMF_Field) :: leaf_field
      type(ESMF_StateItem_Flag) :: inner_kind
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 406, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_nested', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE

      inner_state = make_var(ESMF_STATEINTENT_EXPORT, 'inner')
      inner_state%itemType = MAPL_STATEITEM_STATE

      leaf_member = make_var(ESMF_STATEINTENT_EXPORT, 'leaf', units='K')
      leaf_member%itemType = MAPL_STATEITEM_FIELD
      leaf_member%geom = geom
      call inner_state%declare_member('leaf', leaf_member, rc=status)
      @assertEqual(0, status)

      call cb_export%declare_member('inner', inner_state, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'inner', itemType=inner_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(inner_kind == ESMF_STATEITEM_STATE)
      call ESMF_StateGet(cb_state, 'inner', inner_cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(inner_cb_state, 'leaf', leaf_field, rc=status)
      @assertEqual(0, status)

      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_nested_composite_member

   ! check_unit_placeholders also binds a fixed (non-placeholder)
   ! CallbackArgumentSpec unit onto its member's own
   ! PHYSICAL_UNITS_CHARACTERISTIC_KIND characteristic
   ! (CompositeStateMaterialization.F90's bind_concrete_units) when the
   ! member itself leaves its own units unspecified.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_binds_concrete_unit_from_interface(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(VariableSpec) :: cb_export, arg_member
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field
      character(:), allocatable :: got_units
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 407, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xy', units='kg kg-1', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-concrete-unit-fill', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_concrete_unit', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE
      cb_export%callback_interface_id = interface_id

      ! No units declared on the member: the interface's own fixed unit
      ! fills it.
      arg_member = make_var(ESMF_STATEINTENT_EXPORT, 'arg1')
      arg_member%itemType = MAPL_STATEITEM_FIELD
      arg_member%geom = geom
      call cb_export%declare_member('arg1', arg_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(arg_field, units=got_units, rc=status)
      @assertEqual(0, status)
      @assertEqual('kg kg-1', got_units)

      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_binds_concrete_unit_from_interface

   ! A member that declares its own fixed unit conflicting with the
   ! interface's own fixed (non-placeholder) unit for that argument is a
   ! hard wiring error at ADVERTISE.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_advertise_rejects_concrete_unit_mismatch(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(VariableSpec) :: cb_export, arg_member
      character(:), allocatable :: expected_message
      logical :: matched
      integer :: status

      type(GraphBuilder) :: gb

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xy', units='kg kg-1', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-concrete-unit-mismatch', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_concrete_mismatch', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE
      cb_export%callback_interface_id = interface_id

      arg_member = make_var(ESMF_STATEINTENT_EXPORT, 'arg1', units='g g-1')
      arg_member%itemType = MAPL_STATEITEM_FIELD
      call cb_export%declare_member('arg1', arg_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      expected_message = 'CompositeStateMaterialization: Handler "cb" argument "arg1" ' // &
           'expects unit "kg kg-1", member declares "g g-1"'

      call gb%advertise(meta, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      matched = catch(expected_message)
      do while (catch('status=1'))
      end do
      @assertTrue(matched)
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_advertise_rejects_concrete_unit_mismatch

   ! Two arguments sharing one unit placeholder name must agree on the
   ! concrete unit bound to it by their respective members.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_advertise_rejects_conflicting_placeholder_units(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(VariableSpec) :: cb_export, arg1_member, arg2_member
      character(:), allocatable :: expected_message
      logical :: matched
      integer :: status

      type(GraphBuilder) :: gb

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xy', units='$U', rc=status)
      @assertEqual(0, status)
      call iface%declare_argument('arg2', MAPL_VARIANT_FIELD, dims='xy', units='$U', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-conflicting-placeholder', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_conflicting_placeholder', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE
      cb_export%callback_interface_id = interface_id

      arg1_member = make_var(ESMF_STATEINTENT_EXPORT, 'arg1', units='kg kg-1')
      arg1_member%itemType = MAPL_STATEITEM_FIELD
      arg1_member%callback_unit_placeholder = 'U'
      call cb_export%declare_member('arg1', arg1_member, rc=status)
      @assertEqual(0, status)

      arg2_member = make_var(ESMF_STATEINTENT_EXPORT, 'arg2', units='g g-1')
      arg2_member%itemType = MAPL_STATEITEM_FIELD
      arg2_member%callback_unit_placeholder = 'U'
      call cb_export%declare_member('arg2', arg2_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      expected_message = 'CompositeStateMaterialization: Handler "cb" placeholder "U" bound to ' // &
           '"kg kg-1" and "g g-1" by different arguments'

      call gb%advertise(meta, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      matched = catch(expected_message)
      do while (catch('status=1'))
      end do
      @assertTrue(matched)
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_advertise_rejects_conflicting_placeholder_units

   ! A zero-member STATE export (registered via advertise_one's flat-item
   ! branch, not CompositeStateMaterialization) must be skipped by
   ! graphbuilder_realize_callback_states, not treated as a callback
   ! composite with an unallocated payload.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_skips_empty_state_var_spec(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(VariableSpec) :: empty_state
      type(ESMF_State) :: export_state
      type(ESMF_StateItem_Flag) :: item_kind
      integer :: status

      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_empty_state', gc, meta, _RC)
      spec => meta%get_component_spec()

      empty_state = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      empty_state%itemType = MAPL_STATEITEM_STATE
      call spec%add_var_spec(empty_state)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      @assertTrue(ESMF_StateIsCreated(export_state, rc=status))
      @assertEqual(0, status)
      call ESMF_StateGet(export_state, itemName='cb', itemType=item_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(item_kind == ESMF_STATEITEM_NOTFOUND)

      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_skips_empty_state_var_spec

   ! A Handler composite member bound to a CallbackArgumentSpec's unit
   ! placeholder ('$U') must itself declare a matching
   ! callback_unit_placeholder (check_unit_placeholders,
   ! CompositeStateMaterialization.F90) - a plain fixed-unit member is a
   ! hard wiring error at ADVERTISE, before realization is ever reached.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_advertise_rejects_missing_unit_placeholder_binding(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(VariableSpec) :: cb_export, tracers_member
      character(:), allocatable :: expected_message
      logical :: matched
      integer :: status

      type(GraphBuilder) :: gb

      call iface%declare_argument('tracers', MAPL_VARIANT_FIELDBUNDLE, units='$U', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-missing-placeholder', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_missing_placeholder', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE
      cb_export%callback_interface_id = interface_id

      ! 'tracers' binds a plain fixed unit, not the interface's
      ! placeholder - callback_unit_placeholder is left unallocated.
      tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers', units='kg kg-1')
      tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      call cb_export%declare_member('tracers', tracers_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      expected_message = 'CompositeStateMaterialization: Handler "cb" argument "tracers" ' // &
           'expects unit placeholder "U" bound on its member, but the member binds none'

      call gb%advertise(meta, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      matched = catch(expected_message)
      do while (catch('status=1'))
      end do
      @assertTrue(matched)
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_advertise_rejects_missing_unit_placeholder_binding

   ! A member that declares callback_unit_placeholder under a different
   ! name than the interface's own placeholder is a hard wiring error at
   ! ADVERTISE, distinct from binding none at all.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_advertise_rejects_wrong_unit_placeholder_name(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(VariableSpec) :: cb_export, tracers_member
      character(:), allocatable :: expected_message
      logical :: matched
      integer :: status

      type(GraphBuilder) :: gb

      call iface%declare_argument('tracers', MAPL_VARIANT_FIELDBUNDLE, units='$U', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-wrong-placeholder-name', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_wrong_placeholder', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE
      cb_export%callback_interface_id = interface_id

      ! 'tracers' binds a placeholder, but named "V", not the interface's
      ! own placeholder name "U".
      tracers_member = make_var(ESMF_STATEINTENT_EXPORT, 'tracers', units='kg kg-1')
      tracers_member%itemType = MAPL_STATEITEM_FIELDBUNDLE
      tracers_member%callback_unit_placeholder = 'V'
      call cb_export%declare_member('tracers', tracers_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      expected_message = 'CompositeStateMaterialization: Handler "cb" argument "tracers" ' // &
           'binds placeholder "V", interface expects "U"'

      call gb%advertise(meta, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      matched = catch(expected_message)
      do while (catch('status=1'))
      end do
      @assertTrue(matched)
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_advertise_rejects_wrong_unit_placeholder_name

   ! A `members:` YAML entry with no `alias:`/`units:` (parse_var_specs.F90's
   ! parse_callback_members) reaches declare_member as a plain new FIELD
   ! member, through the full pipeline (YAML text -> parse_var_specs ->
   ! add_var_spec -> advertise -> realize), not a hand-built VariableSpec -
   ! exercising the real HConfig-reading path, not just declare_member
   ! itself.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_yaml_members_new_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: cb_export
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field
      type(ESMF_TypeKind_Flag) :: got_typekind
      character(:), allocatable :: got_units
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 406, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xy', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-yaml-new-field', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_yaml_new_field', gc, meta, _RC)
      call meta%set_geom(geom, _RC)
      spec => meta%get_component_spec()

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {callback_interface: svc-yaml-new-field, members: {arg1: {units: K}}}' // &
           '}}}', rc=status)
      @assertEqual(0, status)
      var_specs = parse_var_specs(config, registry, 'TEST', rc=status)
      @assertEqual(0, status)
      @assertEqual(1, var_specs%size())

      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         call iter%next()
         cb_export => iter%of()
      end associate
      @assertTrue(cb_export%itemType == MAPL_STATEITEM_STATE)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%run_geometry_hook(meta)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(arg_field, typekind=got_typekind, units=got_units, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R4)
      @assertEqual('K', got_units)

      call ESMF_HConfigDestroy(config, _RC)
      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_yaml_members_new_field

   ! A `members:` YAML entry with `alias:` (parse_callback_members) reaches
   ! declare_member with callback_member_alias set, sharing the aliased
   ! INTERNAL item's own Field zero-copy, through the full YAML pipeline -
   ! the YAML counterpart of
   ! test_realize_callback_states_alias_member_shares_internal_field. The
   ! aliased INTERNAL item (TR1) is declared in the same YAML document, not
   ! hand-built, exercising the real parser's internal-items-first
   ! ordering (parse_var_specs parses INTERNAL before EXPORT).
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_yaml_members_alias(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: internal_var, cb_export
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: tracer_field, internal_field
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: internal_id
      class(GraphNode), pointer :: internal_node
      type(GraphStateItem), pointer :: internal_payload
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 407, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('tracer', MAPL_VARIANT_FIELD, dims='xy', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('toy_yaml_alias', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_yaml_alias', gc, meta, _RC)
      call meta%set_geom(geom, _RC)
      spec => meta%get_component_spec()

      config = ESMF_HConfigCreate(content='{states: {' // &
           'internal: {TR1: {units: kg kg-1}}, ' // &
           'export: {cb: {callback_interface: toy_yaml_alias, members: {tracer: {alias: TR1}}}}' // &
           '}}', rc=status)
      @assertEqual(0, status)
      var_specs = parse_var_specs(config, registry, 'TEST', rc=status)
      @assertEqual(0, status)
      @assertEqual(2, var_specs%size())

      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         call iter%next()
         internal_var => iter%of()
         call iter%next()
         cb_export => iter%of()
      end associate
      @assertEqual('TR1', internal_var%short_name)
      @assertEqual('cb', cb_export%short_name)
      @assertTrue(cb_export%itemType == MAPL_STATEITEM_STATE)

      call spec%add_var_spec(internal_var)
      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%run_geometry_hook(meta)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'tracer', tracer_field, rc=status)
      @assertEqual(0, status)

      graph => meta%get_component_graph()
      internal_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_INTERNAL, 'TR1'))
      @assertTrue(associated(internal_id))
      internal_node => graph%get_node(internal_id)
      select type (internal_node)
      class is (StateItemNode)
         internal_payload => internal_node%get_payload_ptr()
      class default
         @assertTrue(.false., 'TR1 is not a StateItemNode')
      end select
      internal_field = internal_payload%get_field(rc=status)
      @assertEqual(0, status)

      @assertTrue(FieldsAreAliased(tracer_field, internal_field))

      call ESMF_HConfigDestroy(config, _RC)
      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_yaml_members_alias

   ! A `members:` YAML entry whose `units:` is a one-entry map
   ! (`units: {U: '...'}`, parse_var_specs.F90's to_units_or_placeholder)
   ! binds the interface's own `$U` placeholder end to end: the realized
   ! member Field carries the bound concrete unit, not the placeholder
   ! text.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_yaml_binds_unit_placeholder(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: cb_export
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field
      character(:), allocatable :: got_units
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 408, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xy', units='$U', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-yaml-unit-placeholder', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_yaml_unit_placeholder', gc, meta, _RC)
      call meta%set_geom(geom, _RC)
      spec => meta%get_component_spec()

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           "cb: {callback_interface: svc-yaml-unit-placeholder, members: {arg1: {units: {U: 'kg kg-1'}}}}" // &
           '}}}', rc=status)
      @assertEqual(0, status)
      var_specs = parse_var_specs(config, registry, 'TEST', rc=status)
      @assertEqual(0, status)
      @assertEqual(1, var_specs%size())

      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         call iter%next()
         cb_export => iter%of()
      end associate
      @assertTrue(cb_export%itemType == MAPL_STATEITEM_STATE)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%run_geometry_hook(meta)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(arg_field, units=got_units, rc=status)
      @assertEqual(0, status)
      @assertEqual('kg kg-1', got_units)

      call ESMF_HConfigDestroy(config, _RC)
      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_yaml_binds_unit_placeholder

   ! gb%realize_callback_states is safe to call a second time into a
   ! different, independent ESMF_State (not just the idempotent-same-State
   ! case covered by test_realize_callback_states_idempotent_second_pass):
   ! each call reads the already-realized member Field/FieldBundle off the
   ! graph (no second materialize_field_extension) and inserts a fresh
   ! MAPL_NamedAlias of it into whichever target State it is given. This is
   ! necessary for, but does not by itself prove,
   ! initialize_realize_accepted.F90's own two real calls (one into the
   ! outer exportState, one into the user exportState) actually both run;
   ! see test_initialize_realize_accepted_reaches_both_export_states for
   ! that.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_repeats_into_second_state(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(VariableSpec) :: cb_export, arg_member
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: outer_export_state, user_export_state, cb_state
      type(ESMF_Field) :: arg_field
      type(ESMF_StateItem_Flag) :: cb_kind
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 409, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_both_exports', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE

      arg_member = make_var(ESMF_STATEINTENT_EXPORT, 'arg1', units='K')
      arg_member%itemType = MAPL_STATEITEM_FIELD
      arg_member%geom = geom
      call cb_export%declare_member('arg1', arg_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      outer_export_state = ESMF_StateCreate(name='outer_export', rc=status)
      @assertEqual(0, status)
      user_export_state = ESMF_StateCreate(name='user_export', rc=status)
      @assertEqual(0, status)

      call gb%realize_callback_states(meta, outer_export_state, status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, user_export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(outer_export_state, 'cb', itemType=cb_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(cb_kind == ESMF_STATEITEM_STATE)
      call ESMF_StateGet(outer_export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)

      call ESMF_StateGet(user_export_state, 'cb', itemType=cb_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(cb_kind == ESMF_STATEITEM_STATE)
      call ESMF_StateGet(user_export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)

      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_repeats_into_second_state

   ! The real routing regression test: drives the actual
   ! OuterMetaComponent%initialize_realize_accepted (not a direct
   ! gb%realize_callback_states call made by the test itself), so this
   ! fails if that routine ever drops either of its own two
   ! gb%realize_callback_states calls - the outer exportState one or the
   ! this%user_gc_driver exportState one (the exact gap round 1 found and
   ! fixed).
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_initialize_realize_accepted_reaches_both_export_states(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(VariableSpec) :: cb_export, arg_member
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: import_state, outer_export_state, user_export_state, cb_state
      type(ESMF_Clock) :: clock
      type(ESMF_Time) :: t0
      type(ESMF_TimeInterval) :: dt
      type(ESMF_Field) :: arg_field
      type(ESMF_StateItem_Flag) :: cb_kind
      type(GriddedComponentDriver) :: user_driver
      type(MultiState) :: user_states
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 410, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_init_realize_accepted', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE

      arg_member = make_var(ESMF_STATEINTENT_EXPORT, 'arg1', units='K')
      arg_member%itemType = MAPL_STATEITEM_FIELD
      arg_member%geom = geom
      call cb_export%declare_member('arg1', arg_member, rc=status)
      @assertEqual(0, status)

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)

      import_state = ESMF_StateCreate(name='import', rc=status)
      @assertEqual(0, status)
      outer_export_state = ESMF_StateCreate(name='outer_export', rc=status)
      @assertEqual(0, status)
      call ESMF_TimeSet(t0, timeString="2000-01-01T00:00:00", rc=status)
      @assertEqual(0, status)
      call ESMF_TimeIntervalSet(dt, h=1, rc=status)
      @assertEqual(0, status)
      clock = ESMF_ClockCreate(timestep=dt, startTime=t0, rc=status)
      @assertEqual(0, status)

      call meta%initialize_realize_accepted(import_state, outer_export_state, clock, rc=status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(outer_export_state, 'cb', itemType=cb_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(cb_kind == ESMF_STATEITEM_STATE)
      call ESMF_StateGet(outer_export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)

      user_driver = meta%get_user_gc_driver()
      user_states = user_driver%get_states()
      user_export_state = user_states%exportState
      call ESMF_StateGet(user_export_state, 'cb', itemType=cb_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(cb_kind == ESMF_STATEITEM_STATE)
      call ESMF_StateGet(user_export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)

      _UNUSED_DUMMY(this)
   end subroutine test_initialize_realize_accepted_reaches_both_export_states

   ! `vertical_dim_spec: center`/`edge` on a members: YAML entry gives the
   ! member a real (SPECIFIED) stagger immediately; its vertical grid
   ! (level count) stays DEFERRED, the same way an ordinary top-level
   ! item's does, until the Handler's own component vertical grid fills it
   ! in at GEOM_B (gb%run_geometry_hook), giving a real 3D Field with the
   ! stagger's own level count.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_yaml_members_vertical_stagger(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: cb_export
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(mapl_VerticalGridManager), pointer :: vgrid_manager
      class(mapl_VerticalGrid), pointer :: vgrid
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: center_field, edge_field
      type(VerticalStaggerLoc) :: got_stagger
      integer :: got_levels, got_rank
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 420, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('center_member', MAPL_VARIANT_FIELD, dims='xyz', rc=status)
      @assertEqual(0, status)
      call iface%declare_argument('edge_member', MAPL_VARIANT_FIELD, dims='xyz', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-yaml-vertical-stagger', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_yaml_vstagger', gc, meta, _RC)
      call meta%set_geom(geom, _RC)
      ! MAPL_FieldGet's num_levels resolves vert_staggerloc against the
      ! item's stored vgrid id by looking it up in the process-wide
      ! VerticalGridManager, so the component's vertical grid must come
      ! from the manager (not a bare mapl_BasicVerticalGrid%set_id()).
      vgrid_manager => mapl_get_vertical_grid_manager(_RC)
      vgrid => vgrid_manager%create_grid(mapl_BasicVerticalGridSpec(num_levels=3), _RC)
      call meta%set_vertical_grid(vgrid, _RC)
      spec => meta%get_component_spec()

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {callback_interface: svc-yaml-vertical-stagger, members: {' // &
           'center_member: {vertical_dim_spec: center}, ' // &
           'edge_member: {vertical_dim_spec: edge}}}' // &
           '}}}', rc=status)
      @assertEqual(0, status)
      var_specs = parse_var_specs(config, registry, 'TEST', rc=status)
      @assertEqual(0, status)
      @assertEqual(1, var_specs%size())

      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         call iter%next()
         cb_export => iter%of()
      end associate

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%run_geometry_hook(meta)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)

      call ESMF_StateGet(cb_state, 'center_member', center_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(center_field, vert_staggerloc=got_stagger, num_levels=got_levels, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_stagger == VERTICAL_STAGGER_CENTER)
      @assertEqual(3, got_levels)
      call ESMF_FieldGet(center_field, rank=got_rank, rc=status)
      @assertEqual(0, status)
      @assertEqual(3, got_rank)

      call ESMF_StateGet(cb_state, 'edge_member', edge_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(edge_field, vert_staggerloc=got_stagger, num_levels=got_levels, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_stagger == VERTICAL_STAGGER_EDGE)
      @assertEqual(4, got_levels)
      call ESMF_FieldGet(edge_field, rank=got_rank, rc=status)
      @assertEqual(0, status)
      @assertEqual(3, got_rank)

      call ESMF_HConfigDestroy(config, _RC)
      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_yaml_members_vertical_stagger

   ! `vertical_grid:` on a members: YAML entry names a vertical grid of the
   ! member's own (parse_callback_members -> the same parse_vertical_grid
   ! a top-level item's "geometry: {vertical_grid: ...}" uses), independent
   ! of the Handler's own component vertical grid: the realized Field's
   ! level count comes from the member's own named grid (5), not the
   ! component's (3).
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_yaml_members_own_vertical_grid(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: cb_export
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(mapl_VerticalGridManager), pointer :: vgrid_manager
      class(mapl_VerticalGrid), pointer :: comp_vgrid
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field
      type(VerticalStaggerLoc) :: got_stagger
      integer :: got_levels
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 421, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xyz', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-yaml-own-vgrid', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_yaml_own_vgrid', gc, meta, _RC)
      call meta%set_geom(geom, _RC)
      ! Component's vertical grid must come from the manager so
      ! MAPL_FieldGet's num_levels lookup (by stored id) succeeds; see
      ! the comment in test_realize_callback_states_yaml_members_vertical_stagger.
      vgrid_manager => mapl_get_vertical_grid_manager(_RC)
      comp_vgrid => vgrid_manager%create_grid(mapl_BasicVerticalGridSpec(num_levels=3), _RC)
      call meta%set_vertical_grid(comp_vgrid, _RC)
      spec => meta%get_component_spec()

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {callback_interface: svc-yaml-own-vgrid, members: {' // &
           'arg1: {vertical_dim_spec: center, vertical_grid: {num_levels: 5}}}}' // &
           '}}}', rc=status)
      @assertEqual(0, status)
      var_specs = parse_var_specs(config, registry, 'TEST', rc=status)
      @assertEqual(0, status)
      @assertEqual(1, var_specs%size())

      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         call iter%next()
         cb_export => iter%of()
      end associate

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%run_geometry_hook(meta)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(arg_field, vert_staggerloc=got_stagger, num_levels=got_levels, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_stagger == VERTICAL_STAGGER_CENTER)
      @assertEqual(5, got_levels)

      call ESMF_HConfigDestroy(config, _RC)
      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_yaml_members_own_vertical_grid

   ! A members: YAML entry with no vertical_dim_spec/vertical_grid of its
   ! own, on a Handler component with no vertical grid of its own either,
   ! resolves to a plain 2D Field (NONE stagger).
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_yaml_members_stay_2d(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: cb_export
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field
      type(VerticalStaggerLoc) :: got_stagger
      integer :: got_rank
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 422, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xy', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-yaml-stay-2d', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_yaml_stay_2d', gc, meta, _RC)
      call meta%set_geom(geom, _RC)
      spec => meta%get_component_spec()

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {callback_interface: svc-yaml-stay-2d, members: {arg1: {}}}' // &
           '}}}', rc=status)
      @assertEqual(0, status)
      var_specs = parse_var_specs(config, registry, 'TEST', rc=status)
      @assertEqual(0, status)
      @assertEqual(1, var_specs%size())

      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         call iter%next()
         cb_export => iter%of()
      end associate

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%run_geometry_hook(meta)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(arg_field, vert_staggerloc=got_stagger, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_stagger%is_none())
      call ESMF_FieldGet(arg_field, rank=got_rank, rc=status)
      @assertEqual(0, status)
      @assertEqual(2, got_rank)

      call ESMF_HConfigDestroy(config, _RC)
      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_yaml_members_stay_2d

   ! A members: YAML entry with no vertical_dim_spec/vertical_grid of its
   ! own stays NONE/2D even when the Handler's own component DOES have a
   ! vertical grid: a member has no realized field of its own for a
   ! harvest pass to read a stagger back from, so an omitted
   ! vertical_dim_spec must default explicitly rather than reach the
   ! component's vertical grid the way a top-level item's DEFERRED
   ! stagger would.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_members_stays_2d_with_component_vgrid(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: cb_export
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(mapl_VerticalGridManager), pointer :: vgrid_manager
      class(mapl_VerticalGrid), pointer :: comp_vgrid
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field
      type(VerticalStaggerLoc) :: got_stagger
      integer :: got_rank
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 423, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xy', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-yaml-2d-with-vgrid', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_yaml_2d_with_vgrid', gc, meta, _RC)
      call meta%set_geom(geom, _RC)
      vgrid_manager => mapl_get_vertical_grid_manager(_RC)
      comp_vgrid => vgrid_manager%create_grid(mapl_BasicVerticalGridSpec(num_levels=3), _RC)
      call meta%set_vertical_grid(comp_vgrid, _RC)
      spec => meta%get_component_spec()

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {callback_interface: svc-yaml-2d-with-vgrid, members: {arg1: {}}}' // &
           '}}}', rc=status)
      @assertEqual(0, status)
      var_specs = parse_var_specs(config, registry, 'TEST', rc=status)
      @assertEqual(0, status)
      @assertEqual(1, var_specs%size())

      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         call iter%next()
         cb_export => iter%of()
      end associate

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%run_geometry_hook(meta)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(arg_field, vert_staggerloc=got_stagger, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_stagger%is_none())
      call ESMF_FieldGet(arg_field, rank=got_rank, rc=status)
      @assertEqual(0, status)
      @assertEqual(2, got_rank)

      call ESMF_HConfigDestroy(config, _RC)
      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_members_stays_2d_with_component_vgrid

   ! `vertical_grid:` on a members: YAML entry with no vertical_dim_spec
   ! of its own defaults the member's stagger to CENTER (the DEFERRED
   ! status a top-level item would get here is never resolved for a
   ! member -- see test_realize_callback_members_stays_2d_with_component_vgrid).
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_members_vertical_grid_defaults_center(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: cb_export
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field
      type(VerticalStaggerLoc) :: got_stagger
      integer :: got_levels
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 424, rc=status)
      @assertEqual(0, status)

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xyz', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-yaml-vgrid-defaults-center', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_yaml_vgrid_defaults_center', gc, meta, _RC)
      call meta%set_geom(geom, _RC)
      spec => meta%get_component_spec()

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {callback_interface: svc-yaml-vgrid-defaults-center, members: {' // &
           'arg1: {vertical_grid: {num_levels: 5}}}}' // &
           '}}}', rc=status)
      @assertEqual(0, status)
      var_specs = parse_var_specs(config, registry, 'TEST', rc=status)
      @assertEqual(0, status)
      @assertEqual(1, var_specs%size())

      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         call iter%next()
         cb_export => iter%of()
      end associate

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%run_geometry_hook(meta)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(arg_field, vert_staggerloc=got_stagger, num_levels=got_levels, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_stagger == VERTICAL_STAGGER_CENTER)
      @assertEqual(5, got_levels)

      call ESMF_HConfigDestroy(config, _RC)
      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_members_vertical_grid_defaults_center

   ! `dims: z` on a members: YAML entry sets no horizontal dims, the same
   ! way it does on a top-level item: combined with an explicit
   ! vertical_dim_spec, the realized Field is rank 1 (vertical only).
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_realize_callback_states_yaml_members_dims_z(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(ESMF_HConfig) :: config
      type(StateRegistry) :: registry
      type(VariableSpecVector) :: var_specs
      type(VariableSpec), pointer :: cb_export
      type(VariableSpecVectorIterator) :: iter
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(mapl_VerticalGridManager), pointer :: vgrid_manager
      class(mapl_VerticalGrid), pointer :: comp_vgrid
      type(ESMF_State) :: export_state, cb_state
      type(ESMF_Field) :: arg_field
      type(VerticalStaggerLoc) :: got_stagger
      integer :: got_levels, got_rank
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 425, rc=status)
      @assertEqual(0, status)

      ! The interface argument itself declares dims the only way
      ! CallbackArgumentSpec accepts ('xyz' or 'xy'); the member's own
      ! "dims: z" (checked below) controls the realized Field's actual
      ! horizontal shape and is independent of this declaration.
      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xyz', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-yaml-dims-z', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_yaml_dims_z', gc, meta, _RC)
      call meta%set_geom(geom, _RC)
      vgrid_manager => mapl_get_vertical_grid_manager(_RC)
      comp_vgrid => vgrid_manager%create_grid(mapl_BasicVerticalGridSpec(num_levels=4), _RC)
      call meta%set_vertical_grid(comp_vgrid, _RC)
      spec => meta%get_component_spec()

      config = ESMF_HConfigCreate(content='{states: {export: {' // &
           'cb: {callback_interface: svc-yaml-dims-z, members: {' // &
           'arg1: {dims: z, vertical_dim_spec: center}}}' // &
           '}}}', rc=status)
      @assertEqual(0, status)
      var_specs = parse_var_specs(config, registry, 'TEST', rc=status)
      @assertEqual(0, status)
      @assertEqual(1, var_specs%size())

      associate (e => var_specs%ftn_end())
         iter = var_specs%ftn_begin()
         call iter%next()
         cb_export => iter%of()
      end associate

      call spec%add_var_spec(cb_export)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%run_geometry_hook(meta)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(cb_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(arg_field, vert_staggerloc=got_stagger, num_levels=got_levels, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_stagger == VERTICAL_STAGGER_CENTER)
      @assertEqual(4, got_levels)
      call ESMF_FieldGet(arg_field, rank=got_rank, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, got_rank)

      call ESMF_HConfigDestroy(config, _RC)
      _UNUSED_DUMMY(this)
   end subroutine test_realize_callback_states_yaml_members_dims_z

   ! -- graphbuilder_fill_callback_collections (Invoker-side IMPORT) ------
   !
   ! Builds a parent component with two children: HANDLER (exports a 'cb'
   ! callback composite, one 'arg1' FIELD member, declaring interface_id)
   ! and INVOKER (imports 'cb', declaring the same interface_id, no
   ! members - members: is Handler-EXPORT-only, so a callback IMPORT keeps
   ! the default FIELD declared_item_type). Wires them with a real
   ! MatchConnection and runs gb%resolve_connections, so the
   ! 'CALLBACK_COLLECTION:' reuse entry gb%fill_callback_collections reads
   ! is populated by production connection-resolution code
   ! (resolve_callback_destination), not hand-built. Stops right after
   ! resolve_connections: gb%allocate_internals/gb%realize_callback_states
   ! on handler_meta are left to each test, since not every test needs the
   ! matched member's own Field actually materialized.
   subroutine build_invoker_fixture(service_name, geom, parent_meta, handler_meta, invoker_meta, &
        interface_id, rc)
      character(*), intent(in) :: service_name
      type(ESMF_Geom), intent(in) :: geom
      type(OuterMetaComponent), pointer, intent(out) :: parent_meta
      type(OuterMetaComponent), pointer, intent(out) :: handler_meta
      type(OuterMetaComponent), pointer, intent(out) :: invoker_meta
      type(CallbackInterfaceId), intent(out) :: interface_id
      integer, optional, intent(out) :: rc

      integer :: status
      type(ESMF_GridComp) :: parent_gc
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: handler_driver, invoker_driver
      type(ESMF_GridComp) :: handler_gc, invoker_gc
      type(ComponentSpec), pointer :: handler_spec, invoker_spec, parent_spec
      type(CallbackInterface) :: iface
      type(VariableSpec) :: cb_export, arg_member, cb_import
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(GraphBuilder) :: gb

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xy', rc=status)
      @assertEqual(0, status)
      call register_callback_interface(service_name, iface, interface_id, status)
      @assertEqual(0, status)

      call make_outer_meta('parent_' // service_name, parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('HANDLER', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('INVOKER', child_spec, _RC)

      handler_driver = parent_meta%get_child('HANDLER', _RC)
      handler_gc = handler_driver%get_gridcomp()
      handler_meta => get_outer_meta(handler_gc, _RC)

      invoker_driver = parent_meta%get_child('INVOKER', _RC)
      invoker_gc = invoker_driver%get_gridcomp()
      invoker_meta => get_outer_meta(invoker_gc, _RC)

      handler_spec => handler_meta%get_component_spec()
      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE
      cb_export%callback_interface_id = interface_id
      arg_member = make_var(ESMF_STATEINTENT_EXPORT, 'arg1')
      arg_member%itemType = MAPL_STATEITEM_FIELD
      arg_member%geom = geom
      call cb_export%declare_member('arg1', arg_member, rc=status)
      @assertEqual(0, status)
      call handler_spec%add_var_spec(cb_export)

      invoker_spec => invoker_meta%get_component_spec()
      cb_import = make_var(ESMF_STATEINTENT_IMPORT, 'cb')
      cb_import%callback_interface_id = interface_id
      call invoker_spec%add_var_spec(cb_import)

      call gb%advertise(handler_meta, status)
      @assertEqual(0, status)
      call gb%advertise(invoker_meta, status)
      @assertEqual(0, status)
      call gb%advertise(parent_meta, status)
      @assertEqual(0, status)

      conn = MatchConnection( &
           ConnectionPt('HANDLER', VirtualConnectionPt(state_intent='export', short_name='cb')), &
           ConnectionPt('INVOKER', VirtualConnectionPt(state_intent='import', short_name='cb')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, unresolved%size())

      _RETURN(_SUCCESS)
   end subroutine build_invoker_fixture

   ! The matched Handler's own composite ESMF_State ends up, by alias,
   ! inside the collection (keyed by its qualified_name 'cb', since the
   ! connection names HANDLER directly - no intervening path prefix), and
   ! the collection itself ends up, by alias, inside the Invoker's own
   ! import_state under the import's short_name ('cb').
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_fill_callback_collections_wires_matched_member(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, handler_meta, invoker_meta
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: handler_export_state, invoker_import_state
      type(ESMF_State) :: collection_state, member_state
      type(ESMF_Field) :: arg_field
      type(ESMF_StateItem_Flag) :: item_kind
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 420, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call build_invoker_fixture('svc-5-2-wires', geom, parent_meta, handler_meta, invoker_meta, &
           interface_id, _RC)

      call gb%allocate_internals(handler_meta, status)
      @assertEqual(0, status)
      handler_export_state = ESMF_StateCreate(name='handler_export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(handler_meta, handler_export_state, status)
      @assertEqual(0, status)

      invoker_import_state = ESMF_StateCreate(name='invoker_import', rc=status)
      @assertEqual(0, status)
      call gb%fill_callback_collections(invoker_meta, invoker_import_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(invoker_import_state, 'cb', itemType=item_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(item_kind == ESMF_STATEITEM_STATE)
      call ESMF_StateGet(invoker_import_state, 'cb', collection_state, rc=status)
      @assertEqual(0, status)

      call ESMF_StateGet(collection_state, 'cb', itemType=item_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(item_kind == ESMF_STATEITEM_STATE)
      call ESMF_StateGet(collection_state, 'cb', member_state, rc=status)
      @assertEqual(0, status)

      call ESMF_StateGet(member_state, 'arg1', arg_field, rc=status)
      @assertEqual(0, status)

      _UNUSED_DUMMY(this)
   end subroutine test_fill_callback_collections_wires_matched_member

   ! A same-named stale Field (added here by hand - populate_one excludes
   ! callback imports, so no current call site produces this) must not
   ! survive gb%fill_callback_collections: ESMF_StateAddReplace does not
   ! change an existing record's reported item kind, so the FIELD->STATE
   ! swap needs fill_callback_collection's remove-then-add, exercised
   ! here as a safety net.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_fill_callback_collections_replaces_stale_empty_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, handler_meta, invoker_meta
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: handler_export_state, invoker_import_state
      type(ESMF_Field) :: stale_field
      type(ESMF_StateItem_Flag) :: item_kind
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 421, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call build_invoker_fixture('svc-5-2-replace', geom, parent_meta, handler_meta, invoker_meta, &
           interface_id, _RC)

      call gb%allocate_internals(handler_meta, status)
      @assertEqual(0, status)
      handler_export_state = ESMF_StateCreate(name='handler_export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(handler_meta, handler_export_state, status)
      @assertEqual(0, status)

      invoker_import_state = ESMF_StateCreate(name='invoker_import', rc=status)
      @assertEqual(0, status)
      stale_field = ESMF_FieldEmptyCreate(name='cb', rc=status)
      @assertEqual(0, status)
      call ESMF_StateAdd(invoker_import_state, [stale_field], rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(invoker_import_state, 'cb', itemType=item_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(item_kind == ESMF_STATEITEM_FIELD)

      call gb%fill_callback_collections(invoker_meta, invoker_import_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(invoker_import_state, 'cb', itemType=item_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(item_kind == ESMF_STATEITEM_STATE)

      _UNUSED_DUMMY(this)
   end subroutine test_fill_callback_collections_replaces_stale_empty_field

   ! A second gb%fill_callback_collections call into the same target_state
   ! must not duplicate either the collection entry or its member entry.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_fill_callback_collections_idempotent_second_pass(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, handler_meta, invoker_meta
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: handler_export_state, invoker_import_state
      type(ESMF_State) :: collection_state
      integer :: import_item_count, collection_item_count
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 422, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call build_invoker_fixture('svc-5-2-idempotent', geom, parent_meta, handler_meta, invoker_meta, &
           interface_id, _RC)

      call gb%allocate_internals(handler_meta, status)
      @assertEqual(0, status)
      handler_export_state = ESMF_StateCreate(name='handler_export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(handler_meta, handler_export_state, status)
      @assertEqual(0, status)

      invoker_import_state = ESMF_StateCreate(name='invoker_import', rc=status)
      @assertEqual(0, status)

      call gb%fill_callback_collections(invoker_meta, invoker_import_state, status)
      @assertEqual(0, status)
      call gb%fill_callback_collections(invoker_meta, invoker_import_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(invoker_import_state, itemCount=import_item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, import_item_count)

      call ESMF_StateGet(invoker_import_state, 'cb', collection_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(collection_state, itemCount=collection_item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, collection_item_count)

      _UNUSED_DUMMY(this)
   end subroutine test_fill_callback_collections_idempotent_second_pass

   ! An IMPORT declaring a callback interface but never matched by any
   ! connection (no 'CALLBACK_COLLECTION:' reuse entry exists for it - an
   ! unmet import, reported elsewhere) is left alone by
   ! gb%fill_callback_collections, not treated as an error.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_fill_callback_collections_skips_unmet_import(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: gc
      type(CallbackInterface) :: iface
      type(CallbackInterfaceId) :: interface_id
      type(VariableSpec) :: cb_import
      type(ESMF_State) :: import_state
      type(ESMF_StateItem_Flag) :: item_kind
      integer :: status

      type(GraphBuilder) :: gb

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xy', rc=status)
      @assertEqual(0, status)
      call register_callback_interface('svc-5-2-unmet', iface, interface_id, status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call make_outer_meta('comp_cb_fill_unmet', gc, meta, _RC)
      spec => meta%get_component_spec()

      cb_import = make_var(ESMF_STATEINTENT_IMPORT, 'cb')
      cb_import%callback_interface_id = interface_id
      call spec%add_var_spec(cb_import)

      call gb%advertise(meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(meta, status)
      @assertEqual(0, status)

      import_state = ESMF_StateCreate(name='import', rc=status)
      @assertEqual(0, status)
      call gb%fill_callback_collections(meta, import_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(import_state, itemName='cb', itemType=item_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(item_kind == ESMF_STATEITEM_NOTFOUND)

      _UNUSED_DUMMY(this)
   end subroutine test_fill_callback_collections_skips_unmet_import

   ! Builds parent -> {SRC, INVOKER}: SRC advertises no exports at all,
   ! INVOKER imports 'cb' declaring interface_id. The MatchConnection
   ! names SRC as source with a literal (non-regex) src_name, so
   ! gb%resolve_connections exercises the plain-name zero-Handler case
   ! through production connection-resolution code, not a hand-built
   ! reuse entry.
   subroutine build_invoker_fixture_no_handler(service_name, parent_meta, invoker_meta, interface_id, rc)
      character(*), intent(in) :: service_name
      type(OuterMetaComponent), pointer, intent(out) :: parent_meta
      type(OuterMetaComponent), pointer, intent(out) :: invoker_meta
      type(CallbackInterfaceId), intent(out) :: interface_id
      integer, optional, intent(out) :: rc

      integer :: status
      type(ESMF_GridComp) :: parent_gc
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: src_driver, invoker_driver
      type(ESMF_GridComp) :: src_gc, invoker_gc
      type(OuterMetaComponent), pointer :: src_meta
      type(ComponentSpec), pointer :: invoker_spec, parent_spec
      type(CallbackInterface) :: iface
      type(VariableSpec) :: cb_import
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(GraphBuilder) :: gb

      call iface%declare_argument('arg1', MAPL_VARIANT_FIELD, dims='xy', rc=status)
      @assertEqual(0, status)
      call register_callback_interface(service_name, iface, interface_id, status)
      @assertEqual(0, status)

      call make_outer_meta('parent_' // service_name, parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('SRC', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('INVOKER', child_spec, _RC)

      src_driver = parent_meta%get_child('SRC', _RC)
      src_gc = src_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)

      invoker_driver = parent_meta%get_child('INVOKER', _RC)
      invoker_gc = invoker_driver%get_gridcomp()
      invoker_meta => get_outer_meta(invoker_gc, _RC)

      invoker_spec => invoker_meta%get_component_spec()
      cb_import = make_var(ESMF_STATEINTENT_IMPORT, 'cb')
      cb_import%callback_interface_id = interface_id
      call invoker_spec%add_var_spec(cb_import)

      call gb%advertise(src_meta, status)
      @assertEqual(0, status)
      call gb%advertise(invoker_meta, status)
      @assertEqual(0, status)
      call gb%advertise(parent_meta, status)
      @assertEqual(0, status)

      conn = MatchConnection( &
           ConnectionPt('SRC', VirtualConnectionPt(state_intent='export', short_name='cb')), &
           ConnectionPt('INVOKER', VirtualConnectionPt(state_intent='import', short_name='cb')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, unresolved%size())

      _RETURN(_SUCCESS)
   end subroutine build_invoker_fixture_no_handler

   ! A plain src_name with no Handler of src_comp itself under that plain
   ! name (zero matches, zero rejected candidates) resolves with an empty
   ! collection rather than staying unresolved
   ! (build_invoker_fixture_no_handler already asserts
   ! unresolved%size() == 0). This confirms the Invoker's own import_state
   ! carries a real, empty STATE record it can loop zero times over, not a
   ! missing item.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_fill_callback_collections_plain_name_no_handler_is_empty(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, invoker_meta
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_State) :: invoker_import_state
      type(ESMF_State) :: collection_state
      type(ESMF_StateItem_Flag) :: item_kind
      integer :: collection_item_count
      integer :: status

      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call build_invoker_fixture_no_handler('svc-fill-no-handler', parent_meta, invoker_meta, interface_id, _RC)

      call gb%allocate_internals(invoker_meta, status)
      @assertEqual(0, status)

      invoker_import_state = ESMF_StateCreate(name='invoker_import', rc=status)
      @assertEqual(0, status)
      call gb%fill_callback_collections(invoker_meta, invoker_import_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(invoker_import_state, 'cb', itemType=item_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(item_kind == ESMF_STATEITEM_STATE)
      call ESMF_StateGet(invoker_import_state, 'cb', collection_state, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(collection_state, itemCount=collection_item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, collection_item_count)

      _UNUSED_DUMMY(this)
   end subroutine test_fill_callback_collections_plain_name_no_handler_is_empty

   ! The real routing regression test for the Invoker's IMPORT side,
   ! paralleling test_initialize_realize_accepted_reaches_both_export_states
   ! above: drives the actual OuterMetaComponent%initialize_accept_transfer
   ! and %initialize_realize_accepted (not a direct gb%fill_callback_collections
   ! call) through two full ACCEPT_TRANSFER/REALIZE_ACCEPTED rounds
   ! (GenericPhases.F90's GENERIC_INIT_PHASE_SEQUENCE repeats both).
   ! Does NOT regress populate_one's callback-import exclusion
   ! (GraphBuilder_StatePopulation_smod.F90): confirmed by reverting that
   ! exclusion that ESMF_StateAddReplace already no-ops a same-named FIELD
   ! added over an existing STATE record, leaving itemType, itemCount, and
   ! the member all intact, so no ESMF-visible probe here can tell the
   ! exclusion's presence from its absence. The exclusion still matters:
   ! without it, populate_one's fallback allocates a throwaway created
   ! Field for this import on every ACCEPT_TRANSFER pass only to have
   ! ESMF_StateAddReplace silently discard it, and that discard is
   ! undocumented ESMF behavior this code should not depend on.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_accept_transfer_does_not_clobber_invoker_collection(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, handler_meta, invoker_meta
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: handler_export_state
      type(ESMF_State) :: outer_import, outer_export
      type(ESMF_StateItem_Flag) :: cb_kind
      type(ESMF_Clock) :: clock
      type(ESMF_Time) :: t0
      type(ESMF_TimeInterval) :: dt
      type(GriddedComponentDriver) :: invoker_driver
      type(MultiState) :: invoker_user_states
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 423, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call build_invoker_fixture('svc-5-2-no-clobber', geom, parent_meta, handler_meta, invoker_meta, &
           interface_id, _RC)

      call gb%allocate_internals(handler_meta, status)
      @assertEqual(0, status)
      handler_export_state = ESMF_StateCreate(name='handler_export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(handler_meta, handler_export_state, status)
      @assertEqual(0, status)

      outer_import = ESMF_StateCreate(name='invoker_outer_import', rc=status)
      @assertEqual(0, status)
      outer_export = ESMF_StateCreate(name='invoker_outer_export', rc=status)
      @assertEqual(0, status)
      call ESMF_TimeSet(t0, timeString="2000-01-01T00:00:00", rc=status)
      @assertEqual(0, status)
      call ESMF_TimeIntervalSet(dt, h=1, rc=status)
      @assertEqual(0, status)
      clock = ESMF_ClockCreate(timestep=dt, startTime=t0, rc=status)
      @assertEqual(0, status)

      ! Round 1: ACCEPT_TRANSFER (nothing has filled the collection yet),
      ! then REALIZE_ACCEPTED (fills the real collection STATE into both
      ! the user and outer importStates).
      call invoker_meta%initialize_accept_transfer(outer_import, outer_export, clock, rc=status)
      @assertEqual(0, status)
      call invoker_meta%initialize_realize_accepted(outer_import, outer_export, clock, rc=status)
      @assertEqual(0, status)

      invoker_driver = invoker_meta%get_user_gc_driver()
      invoker_user_states = invoker_driver%get_states()
      call ESMF_StateGet(invoker_user_states%importState, 'cb', itemType=cb_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(cb_kind == ESMF_STATEITEM_STATE)

      call ESMF_StateGet(outer_import, 'cb', itemType=cb_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(cb_kind == ESMF_STATEITEM_STATE)

      ! Round 2: a second ACCEPT_TRANSFER must leave the user importState's
      ! collection STATE alone.
      call invoker_meta%initialize_accept_transfer(outer_import, outer_export, clock, rc=status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assertEqual(0, status)

      call ESMF_StateGet(invoker_user_states%importState, 'cb', itemType=cb_kind, rc=status)
      @assertEqual(0, status)
      @assertTrue(cb_kind == ESMF_STATEITEM_STATE)

      _UNUSED_DUMMY(this)
   end subroutine test_accept_transfer_does_not_clobber_invoker_collection

   ! -- resolve_callback_destination production binding --------------------
   !
   ! Builds a parent with HANDLER (exports 'cb', one 'quantity' FIELD
   ! member, units 'm') and INVOKER (imports 'cb', declaring the
   ! interface, plus two always-present INTERNAL items -
   ! provide_item (units 'km') and receive_item (units 'm') - whose
   ! VariableSpec carries `provides:`/`receives:` map entries only when
   ! requested, so the missing-provider test can build a fixture that
   ! declares receive_item but leaves 'quantity' with no get-side
   ! provider. Wired by a real MatchConnection and run through
   ! gb%resolve_connections, so resolve_callback_destination itself (not
   ! a hand-built binding) builds and stores every CallbackMethodBinding
   ! the tests below fetch and invoke. Stops right after
   ! resolve_connections, mirroring build_invoker_fixture's own scope:
   ! gb%allocate_internals/gb%realize_callback_states/StateAddMethod
   ! attachment are each caller's own responsibility. rc is propagated
   ! (not asserted here) so callers can exercise both the success path
   ! and the missing-provider failure.
   subroutine build_method_binding_fixture(service_name, geom, include_provides, include_receives, &
        parent_meta, handler_meta, invoker_meta, interface_id, rc, missing_item, ambiguous_item)
      character(*), intent(in) :: service_name
      type(ESMF_Geom), intent(in) :: geom
      logical, intent(in) :: include_provides
      logical, intent(in) :: include_receives
      type(OuterMetaComponent), pointer, intent(out) :: parent_meta
      type(OuterMetaComponent), pointer, intent(out) :: handler_meta
      type(OuterMetaComponent), pointer, intent(out) :: invoker_meta
      type(CallbackInterfaceId), intent(out) :: interface_id
      integer, optional, intent(out) :: rc
      ! `provides:` names a nonexistent item (resolve_invoker_item_id's
      ! "no such item" branch).
      logical, optional, intent(in) :: missing_item
      ! `provides:` names an item that exists under two different states
      ! on the Invoker (resolve_invoker_item_id's "ambiguous" branch).
      logical, optional, intent(in) :: ambiguous_item

      integer :: status
      type(ESMF_GridComp) :: parent_gc
      type(ChildSpec) :: child_spec
      type(GriddedComponentDriver) :: handler_driver, invoker_driver
      type(ESMF_GridComp) :: handler_gc, invoker_gc
      type(ComponentSpec), pointer :: handler_spec, invoker_spec, parent_spec
      type(CallbackInterface) :: iface
      type(VariableSpec) :: cb_export, quantity_member, cb_import, provide_item, receive_item, dup_item
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      logical :: missing_item_, ambiguous_item_
      character(:), allocatable :: provide_target_name

      type(GraphBuilder) :: gb

      missing_item_ = .false.
      if (present(missing_item)) missing_item_ = missing_item
      ambiguous_item_ = .false.
      if (present(ambiguous_item)) ambiguous_item_ = ambiguous_item
      provide_target_name = 'provide_item'
      if (missing_item_) provide_target_name = 'nonexistent_item'

      call iface%declare_argument('quantity', MAPL_VARIANT_FIELD, dims='xy', rc=status)
      @assertEqual(0, status)
      call iface%declare_method('put', rc=status)
      @assertEqual(0, status)
      call iface%declare_method('get', rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('put', 'quantity', MAPL_ACCESS_IN, rc=status)
      @assertEqual(0, status)
      call iface%set_method_argument_access('get', 'quantity', MAPL_ACCESS_OUT, rc=status)
      @assertEqual(0, status)
      call register_callback_interface(service_name, iface, interface_id, status)
      @assertEqual(0, status)

      call make_outer_meta('parent_' // service_name, parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('HANDLER', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('INVOKER', child_spec, _RC)

      handler_driver = parent_meta%get_child('HANDLER', _RC)
      handler_gc = handler_driver%get_gridcomp()
      handler_meta => get_outer_meta(handler_gc, _RC)

      invoker_driver = parent_meta%get_child('INVOKER', _RC)
      invoker_gc = invoker_driver%get_gridcomp()
      invoker_meta => get_outer_meta(invoker_gc, _RC)

      handler_spec => handler_meta%get_component_spec()
      cb_export = make_var(ESMF_STATEINTENT_EXPORT, 'cb')
      cb_export%itemType = MAPL_STATEITEM_STATE
      cb_export%callback_interface_id = interface_id
      quantity_member = make_var(ESMF_STATEINTENT_EXPORT, 'quantity', units='m')
      quantity_member%itemType = MAPL_STATEITEM_FIELD
      quantity_member%geom = geom
      call cb_export%declare_member('quantity', quantity_member, rc=status)
      @assertEqual(0, status)
      call handler_spec%add_var_spec(cb_export)

      invoker_spec => invoker_meta%get_component_spec()
      cb_import = make_var(ESMF_STATEINTENT_IMPORT, 'cb')
      cb_import%callback_interface_id = interface_id
      if (include_provides) call cb_import%callback_provides%insert('quantity', provide_target_name)
      if (include_receives) call cb_import%callback_receives%insert('quantity', 'receive_item')
      call invoker_spec%add_var_spec(cb_import)

      provide_item = make_var(ESMF_STATEINTENT_INTERNAL, 'provide_item', units='km')
      provide_item%itemType = MAPL_STATEITEM_FIELD
      provide_item%geom = geom
      call invoker_spec%add_var_spec(provide_item)

      if (ambiguous_item_) then
         dup_item = make_var(ESMF_STATEINTENT_EXPORT, 'provide_item', units='km')
         dup_item%itemType = MAPL_STATEITEM_FIELD
         dup_item%geom = geom
         call invoker_spec%add_var_spec(dup_item)
      end if

      receive_item = make_var(ESMF_STATEINTENT_INTERNAL, 'receive_item', units='m')
      receive_item%itemType = MAPL_STATEITEM_FIELD
      receive_item%geom = geom
      call invoker_spec%add_var_spec(receive_item)

      call gb%advertise(handler_meta, status)
      @assertEqual(0, status)
      call gb%advertise(invoker_meta, status)
      @assertEqual(0, status)
      call gb%advertise(parent_meta, status)
      @assertEqual(0, status)

      conn = MatchConnection( &
           ConnectionPt('HANDLER', VirtualConnectionPt(state_intent='export', short_name='cb')), &
           ConnectionPt('INVOKER', VirtualConnectionPt(state_intent='import', short_name='cb')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_materialize_extensions(.true.)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, rc=status)
      call set_materialize_extensions(.false.)

      _RETURN(status)
   end subroutine build_method_binding_fixture

   ! Fetches the CallbackMethodBinding resolve_callback_destination
   ! stored for (import_short_name, method_name) on the matched member's
   ! collection node - same lookup scheme resolve_callback_destination
   ! itself uses (CALLBACK_COLLECTION: reuse entry keyed by the import's
   ! own NodeId, read from the parent graph since that is where the
   ! collection and its reuse entry live). The binding key's other half is
   ! the matched member's own qualified_name (the Handler's export
   ! short_name, since the fixture's single match has no path prefix) -
   ! reusing import_short_name for it here only works because this
   ! fixture names both 'cb'; a fixture with differently-named
   ! import/export would need a separate argument.
   function fetch_method_binding(parent_meta, invoker_meta, import_short_name, method_name, rc) result(binding)
      type(OuterMetaComponent), pointer, intent(in) :: parent_meta
      type(OuterMetaComponent), pointer, intent(in) :: invoker_meta
      character(*), intent(in) :: import_short_name
      character(*), intent(in) :: method_name
      integer, optional, intent(out) :: rc
      type(CallbackMethodBinding), pointer :: binding

      integer :: status
      type(ComponentGraph), pointer :: invoker_graph, parent_graph
      type(NodeId), pointer :: import_id, collection_id
      character(:), allocatable :: collection_key
      class(GraphNode), pointer :: generic_node

      binding => null()
      invoker_graph => invoker_meta%get_component_graph()
      parent_graph => parent_meta%get_component_graph()

      import_id => invoker_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, import_short_name))
      @assertTrue(associated(import_id))

      collection_key = 'CALLBACK_COLLECTION:' // import_id%to_string()
      collection_id => parent_graph%get_reuse_entry(collection_key, _RC)
      @assertTrue(associated(collection_id))

      generic_node => parent_graph%get_node(collection_id)
      @assertTrue(associated(generic_node))
      select type (generic_node)
      class is (StateItemNode)
         binding => generic_node%get_callback_method_binding( &
              callback_method_binding_key(import_short_name, method_name))
      class default
         @assertTrue(.false., 'collection node is not a StateItemNode')
      end select

      _RETURN(_SUCCESS)
   end function fetch_method_binding

   ! Reads an Invoker INTERNAL item's own real Field value, fetched
   ! directly from the graph (gb%allocate_internals materializes a real
   ! backing Field for an INTERNAL VariableSpec independent of any
   ! ESMF_State population - see
   ! test_realize_callback_states_alias_member_shares_internal_field's
   ! own precedent above for this same lookup chain).
   subroutine set_invoker_internal_value(invoker_meta, short_name, value, rc)
      type(OuterMetaComponent), pointer, intent(in) :: invoker_meta
      character(*), intent(in) :: short_name
      real(ESMF_KIND_R4), intent(in) :: value
      integer, optional, intent(out) :: rc

      integer :: status
      type(ComponentGraph), pointer :: invoker_graph
      type(NodeId), pointer :: internal_id
      class(GraphNode), pointer :: generic_node
      type(GraphStateItem), pointer :: payload
      type(ESMF_Field) :: field
      real(ESMF_KIND_R4), pointer :: fptr(:)

      invoker_graph => invoker_meta%get_component_graph()
      internal_id => invoker_graph%get_resource_index(item_key(ESMF_STATEINTENT_INTERNAL, short_name))
      @assertTrue(associated(internal_id))
      generic_node => invoker_graph%get_node(internal_id)
      @assertTrue(associated(generic_node))
      select type (generic_node)
      class is (StateItemNode)
         payload => generic_node%get_payload_ptr()
      class default
         @assertTrue(.false., short_name // ' is not a StateItemNode')
      end select
      field = payload%get_field(rc=status)
      @assertEqual(0, status)
      call assign_fptr(field, fptr, rc=status)
      @assertEqual(0, status)
      fptr = value

      _RETURN(_SUCCESS)
   end subroutine set_invoker_internal_value

   real(ESMF_KIND_R4) function get_invoker_internal_value(invoker_meta, short_name, rc) result(value)
      type(OuterMetaComponent), pointer, intent(in) :: invoker_meta
      character(*), intent(in) :: short_name
      integer, optional, intent(out) :: rc

      integer :: status
      type(ComponentGraph), pointer :: invoker_graph
      type(NodeId), pointer :: internal_id
      class(GraphNode), pointer :: generic_node
      type(GraphStateItem), pointer :: payload
      type(ESMF_Field) :: field
      real(ESMF_KIND_R4), pointer :: fptr(:)

      invoker_graph => invoker_meta%get_component_graph()
      internal_id => invoker_graph%get_resource_index(item_key(ESMF_STATEINTENT_INTERNAL, short_name))
      @assertTrue(associated(internal_id))
      generic_node => invoker_graph%get_node(internal_id)
      @assertTrue(associated(generic_node))
      select type (generic_node)
      class is (StateItemNode)
         payload => generic_node%get_payload_ptr()
      class default
         @assertTrue(.false., short_name // ' is not a StateItemNode')
      end select
      field = payload%get_field(rc=status)
      @assertEqual(0, status)
      call assign_fptr(field, fptr, rc=status)
      @assertEqual(0, status)
      value = fptr(1)

      _RETURN(_SUCCESS)
   end function get_invoker_internal_value

   ! End-to-end: the `provides:` direction (method 'put', MAPL_ACCESS_IN)
   ! really moves data - the Invoker's own provide_item (units 'km', set
   ! to 1.0) is pulled through the UnitsConverterTransform
   ! wire_callback_argument's extension chain built into the Handler's
   ! 'quantity' member (units 'm'), reaching 1000.0, before the attached
   ! 'put' method body ever runs. Deliberately using a units mismatch
   ! (rather than equal units) proves graph%update() actually executed a
   ! real conversion, not merely an alias.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_resolve_callback_destination_converts_provides_value(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, handler_meta, invoker_meta
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: handler_export_state, cb_state
      type(ESMF_Field) :: quantity_field
      real(ESMF_KIND_R4), pointer :: quantity_fptr(:)
      type(CallbackMethodBinding), pointer :: binding
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 440, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call build_method_binding_fixture('svc-5-2b-provides', geom, .true., .true., &
           parent_meta, handler_meta, invoker_meta, interface_id, status)
      @assertEqual(0, status)

      call gb%allocate_internals(handler_meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(invoker_meta, status)
      @assertEqual(0, status)

      handler_export_state = ESMF_StateCreate(name='handler_export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(handler_meta, handler_export_state, status)
      @assertEqual(0, status)

      call ESMF_StateGet(handler_export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call StateAddMethod(cb_state, 'put', cb_put_method, rc=status)
      @assertEqual(0, status)
      call StateAddMethod(cb_state, 'get', cb_get_method, rc=status)
      @assertEqual(0, status)

      call set_invoker_internal_value(invoker_meta, 'provide_item', 1.0_ESMF_KIND_R4, status)
      @assertEqual(0, status)

      binding => fetch_method_binding(parent_meta, invoker_meta, 'cb', 'put', status)
      @assertEqual(0, status)
      @assertTrue(associated(binding))

      call invoke_callback_method(parent_meta%get_component_graph(), binding, status)
      @assertEqual(0, status)
      @assertTrue(g_cb_put_called)

      call ESMF_StateGet(cb_state, 'quantity', quantity_field, rc=status)
      @assertEqual(0, status)
      call assign_fptr(quantity_field, quantity_fptr, rc=status)
      @assertEqual(0, status)
      @assertEqual(1000.0_ESMF_KIND_R4, quantity_fptr(1), tolerance=1.0e-4_ESMF_KIND_R4)

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_destination_converts_provides_value

   ! The `receives:` direction (method 'get', MAPL_ACCESS_OUT) has no
   ! production code path that copies the Handler member's value into the
   ! Invoker's receive_item (advance_callback_put_arguments only advances
   ! receive_item's own NodeRevision) - a known gap (see
   ! docs/graph/callbacks.md). This test asserts only what the
   ! production path actually does: the attached 'get' method body runs
   ! and writes into the Handler's own 'quantity' member Field, and
   ! invoke_callback_method advances receive_item's NodeRevision -
   ! deliberately NOT asserting receive_item's own Field value changed,
   ! since nothing moves it there.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_resolve_callback_destination_advances_receive_revision(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, handler_meta, invoker_meta
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: handler_export_state, cb_state
      type(ESMF_Field) :: quantity_field
      real(ESMF_KIND_R4), pointer :: quantity_fptr(:)
      type(CallbackMethodBinding), pointer :: binding
      type(ComponentGraph), pointer :: invoker_graph
      type(NodeId), pointer :: receive_id
      class(GraphNode), pointer :: generic_node
      type(NodeRevision) :: revision_before, revision_after
      integer :: status

      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 441, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call build_method_binding_fixture('svc-5-2b-receives', geom, .true., .true., &
           parent_meta, handler_meta, invoker_meta, interface_id, status)
      @assertEqual(0, status)

      call gb%allocate_internals(handler_meta, status)
      @assertEqual(0, status)
      call gb%allocate_internals(invoker_meta, status)
      @assertEqual(0, status)

      handler_export_state = ESMF_StateCreate(name='handler_export', rc=status)
      @assertEqual(0, status)
      call gb%realize_callback_states(handler_meta, handler_export_state, status)
      @assertEqual(0, status)

      call ESMF_StateGet(handler_export_state, 'cb', cb_state, rc=status)
      @assertEqual(0, status)
      call StateAddMethod(cb_state, 'put', cb_put_method, rc=status)
      @assertEqual(0, status)
      call StateAddMethod(cb_state, 'get', cb_get_method, rc=status)
      @assertEqual(0, status)

      call set_invoker_internal_value(invoker_meta, 'provide_item', 1.0_ESMF_KIND_R4, status)
      @assertEqual(0, status)

      invoker_graph => invoker_meta%get_component_graph()
      receive_id => invoker_graph%get_resource_index(item_key(ESMF_STATEINTENT_INTERNAL, 'receive_item'))
      @assertTrue(associated(receive_id))
      generic_node => invoker_graph%get_node(receive_id)
      @assertTrue(associated(generic_node))
      select type (generic_node)
      class is (StateItemNode)
         revision_before = generic_node%get_revision()
      class default
         @assertTrue(.false., 'receive_item is not a StateItemNode')
      end select

      binding => fetch_method_binding(parent_meta, invoker_meta, 'cb', 'get', status)
      @assertEqual(0, status)
      @assertTrue(associated(binding))

      call invoke_callback_method(parent_meta%get_component_graph(), binding, status)
      @assertEqual(0, status)
      @assertTrue(g_cb_get_called)

      call ESMF_StateGet(cb_state, 'quantity', quantity_field, rc=status)
      @assertEqual(0, status)
      call assign_fptr(quantity_field, quantity_fptr, rc=status)
      @assertEqual(0, status)
      @assertEqual(42.0_ESMF_KIND_R4, quantity_fptr(1), tolerance=1.0e-4_ESMF_KIND_R4)

      select type (generic_node)
      class is (StateItemNode)
         revision_after = generic_node%get_revision()
      class default
         @assertTrue(.false., 'receive_item is not a StateItemNode')
      end select
      @assertTrue(revision_after /= revision_before)

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_destination_advances_receive_revision

   ! A required argument ('quantity') with no `provides:` entry fails at
   ! build_callback_method_binding's own assert, not later: the methods
   ! map iterates alphabetically, so 'get' (MAPL_ACCESS_OUT, needs only
   ! the `receives:` entry, present here) binds fully first, then 'put'
   ! (MAPL_ACCESS_IN, needs the missing `provides:` entry) fails
   ! deterministically - the fixture's own resolve_connections call
   ! returns that failure status, so this test never reaches
   ! allocate_internals/realize_callback_states.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_resolve_callback_destination_missing_provider_fails(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, handler_meta, invoker_meta
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 442, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call build_method_binding_fixture('svc-5-2b-missing', geom, .false., .true., &
           parent_meta, handler_meta, invoker_meta, interface_id, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      @assertExceptionRaised('GraphBuilder: build_callback_method_binding - ' // &
           'IMPORT "cb" method "put" has no "provides:" entry for argument: quantity')
      ! build_callback_bindings_for_match, resolve_callback_destination,
      ! resolve_one_pair, resolve_one, the for_each_matching_import
      ! callback check, resolve_match_connection, and the resolve_connections
      ! driving loop each pass the failure up (seven more status=1
      ! levels).
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_destination_missing_provider_fails

   ! A `provides:` entry naming an item that does not exist anywhere on
   ! the Invoker fails in resolve_invoker_item_id, naming the import,
   ! argument and item.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_resolve_callback_destination_rejects_missing_item(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, handler_meta, invoker_meta
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 443, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call build_method_binding_fixture('svc-5-2b-no-item', geom, .true., .true., &
           parent_meta, handler_meta, invoker_meta, interface_id, status, missing_item=.true.)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      @assertExceptionRaised('GraphBuilder: callback provider map - IMPORT "cb" argument "quantity" ' // &
           'names item "nonexistent_item": no such item on this component (any state)')
      ! build_callback_provider_maps, resolve_callback_destination,
      ! resolve_one_pair, resolve_one, the for_each_matching_import
      ! callback check, resolve_match_connection, and the resolve_connections
      ! driving loop each pass the failure up (seven more status=1
      ! levels) -- same depth as
      ! test_resolve_callback_destination_missing_provider_fails, since
      ! build_callback_provider_maps sits at the same nesting depth as
      ! the build_callback_bindings_for_match match loop.
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_destination_rejects_missing_item

   ! A `provides:` entry naming an item that exists under two different
   ! states on the Invoker (here: INTERNAL and EXPORT, both named
   ! 'provide_item') fails as ambiguous - the YAML gives only a short
   ! name, with no state to disambiguate.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_resolve_callback_destination_rejects_ambiguous_item(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, handler_meta, invoker_meta
      type(CallbackInterfaceId) :: interface_id
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 444, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)

      call build_method_binding_fixture('svc-5-2b-ambig-item', geom, .true., .true., &
           parent_meta, handler_meta, invoker_meta, interface_id, status, ambiguous_item=.true.)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      @assertExceptionRaised('GraphBuilder: callback provider map - IMPORT "cb" argument "quantity" ' // &
           'names item "provide_item": ambiguous - item exists under more than one state')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')

      _UNUSED_DUMMY(this)
   end subroutine test_resolve_callback_destination_rejects_ambiguous_item

   @before
   subroutine reset_graph_gates(this)
      class(ESMF_TestMethod), intent(inout) :: this

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      g_cb_put_called = .false.
      g_cb_get_called = .false.
      _UNUSED_DUMMY(this)
   end subroutine reset_graph_gates

   @after
   subroutine restore_graph_gates(this)
      class(ESMF_TestMethod), intent(inout) :: this

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      call set_materialize_extensions(.false.)
      call reset_callback_registry_for_testing()
      _UNUSED_DUMMY(this)
   end subroutine restore_graph_gates

end module Test_GraphBuilder_CallbackRealization
