#include "MAPL_TestErr.h"
! Integration tests: make_VariableSpec + FieldDictionary singleton interaction.
! These tests verify that make_VariableSpec correctly:
!   1. Fills `units` from the dictionary when not specified by the caller.
!   2. Fills `long_name` from the dictionary when a standard_name matches.
!   3. Lets caller-specified `units` take precedence over dictionary defaults.
!   4. Works correctly for multiple fields.
!
! generic/standard-name-enforcement (GEOS-ESM/MAPL#5413) made this lookup
! unconditional - there is no more use_field_dictionary opt-in flag.
!
! Note: the parse_var_specs (YAML) path does not yet propagate this;
! that is tracked separately in GH issue #4578.

module Test_FieldDictIntegration
   use funit
   use esmf
   use mapl_FieldDictionary_mod
   use mapl_VariableSpec_mod
   use mapl_ErrorHandling_mod
   implicit none(type, external)

   ! Mini field-dictionary YAML used by most tests.
   character(*), parameter :: DICT_YAML = &
      'air_temperature:' // new_line('a') // &
      '  canonical_units: K' // new_line('a') // &
      '  long_name: Air Temperature' // new_line('a') // &
      'specific_humidity:' // new_line('a') // &
      '  canonical_units: "kg kg-1"' // new_line('a') // &
      '  long_name: Specific Humidity' // new_line('a')

contains

   ! ------------------------------------------------------------------
   ! Helper: write DICT_YAML to a temp file; return the filename.
   ! ------------------------------------------------------------------
   subroutine write_dict_file(filename)
      character(*), intent(in) :: filename
      integer :: unit
      open(newunit=unit, file=filename, form='formatted', status='unknown')
      write(unit, '(a)') DICT_YAML
      close(unit)
   end subroutine write_dict_file

   ! Helper: delete a temp file.
   subroutine delete_file(filename)
      character(*), intent(in) :: filename
      integer :: unit
      open(newunit=unit, file=filename, form='formatted', status='unknown')
      close(unit, status='delete')
   end subroutine delete_file

   ! ==================================================================
   ! 1. make_VariableSpec fills units + long_name from singleton dict
   !    unconditionally, whenever standard_name matches an entry.
   ! ==================================================================
   @test
   subroutine test_units_and_long_name_filled_from_dict()
      type(VariableSpec) :: vs
      integer :: status

      character(*), parameter :: DICT_FILE = 'test_dict_units.yaml'

      call write_dict_file(DICT_FILE)
      call load_field_dictionary(DICT_FILE, rc=status)
      @assert_that(status, is(0))

      vs = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='T', &
           standard_name='air_temperature', rc=status)
      @assert_that(status, is(0))

      @assert_that(allocated(vs%units), is(true()))
      @assertEqual('K', vs%units)
      @assert_that(allocated(vs%long_name), is(true()))
      @assertEqual('Air Temperature', vs%long_name)

      call delete_file(DICT_FILE)
   end subroutine test_units_and_long_name_filled_from_dict

   ! ==================================================================
   ! 2. Caller-specified units take precedence over dictionary defaults
   ! ==================================================================
   @test
   subroutine test_caller_units_override_dict()
      type(VariableSpec) :: vs
      integer :: status

      character(*), parameter :: DICT_FILE = 'test_dict_override.yaml'

      call write_dict_file(DICT_FILE)
      call load_field_dictionary(DICT_FILE, rc=status)
      @assert_that(status, is(0))

      vs = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='T', &
           standard_name='air_temperature', units='degC', rc=status)
      @assert_that(status, is(0))

      ! Caller-specified units must win
      @assert_that(allocated(vs%units), is(true()))
      @assertEqual('degC', vs%units)
      ! long_name still filled from dict
      @assert_that(allocated(vs%long_name), is(true()))
      @assertEqual('Air Temperature', vs%long_name)

      call delete_file(DICT_FILE)
   end subroutine test_caller_units_override_dict

   ! ==================================================================
   ! 3. Dictionary lookup is unconditional (generic/standard-name-
   !    enforcement, GEOS-ESM/MAPL#5413): a VarSpec with a matching
   !    standard_name gets units/long_name filled in without needing any
   !    opt-in flag (the pre-#5413 use_field_dictionary flag no longer
   !    exists at all).
   ! ==================================================================
   @test
   subroutine test_fd_lookup_is_unconditional()
      type(VariableSpec) :: vs
      integer :: status

      character(*), parameter :: DICT_FILE = 'test_dict_noflag.yaml'

      call write_dict_file(DICT_FILE)
      call load_field_dictionary(DICT_FILE, rc=status)
      @assert_that(status, is(0))

      vs = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='T', &
           standard_name='air_temperature', rc=status)
      @assert_that(status, is(0))

      ! units and long_name ARE populated from dict, unconditionally.
      @assert_that(allocated(vs%units), is(true()))
      @assertEqual('K', vs%units)
      @assert_that(allocated(vs%long_name), is(true()))
      @assertEqual('Air Temperature', vs%long_name)

      call delete_file(DICT_FILE)
   end subroutine test_fd_lookup_is_unconditional

   ! ==================================================================
   ! 4. Multiple fields via make_VariableSpec both get dict defaults.
   ! ==================================================================
   @test
   subroutine test_multiple_fields_from_dict()
      type(VariableSpec) :: vs_t, vs_q
      integer :: status

      character(*), parameter :: DICT_FILE = 'test_dict_multi.yaml'

      call write_dict_file(DICT_FILE)
      call load_field_dictionary(DICT_FILE, rc=status)
      @assert_that(status, is(0))

      vs_t = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='T', &
           standard_name='air_temperature', rc=status)
      @assert_that(status, is(0))

      vs_q = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='Q', &
           standard_name='specific_humidity', rc=status)
      @assert_that(status, is(0))

      @assertEqual('K', vs_t%units)
      @assertEqual('Air Temperature', vs_t%long_name)
      @assertEqual('kg kg-1', vs_q%units)
      @assertEqual('Specific Humidity', vs_q%long_name)

      call delete_file(DICT_FILE)
   end subroutine test_multiple_fields_from_dict

end module Test_FieldDictIntegration
