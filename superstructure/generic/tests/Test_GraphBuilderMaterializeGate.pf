#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! Found during gfortran/NAG portability testing: split out of
! Test_GraphBuilder.pf - this file holds all five of Test_GraphBuilder.pf's own
! ESMF_TestMethod tests (type=ESMF_TestMethod, npes=[1] - each calls
! FieldCreate/populate_state on a real ESMF_Geom, needing a real per-test ESMF
! VM that a plain MpiTestMethod sub-communicator does not provide).
!
! The direct trigger: mapl_ExtensionResolution_mod's
! materialize-extensions gate is MODULE-LEVEL GLOBAL state
! (set_materialize_extensions/materialize_extensions_enabled). A test
! that calls set_materialize_extensions(.true.) and then
! fails/aborts/raises before reaching its own closing
! set_materialize_extensions(.false.) call leaks .true. into every
! subsequent test in the same process - corrupting unrelated later
! tests' own materialization behavior nondeterministically (observed
! under gfortran: a later, unrelated test segfaulted, with the exact
! test varying by MPI rank/process scheduling). Fixed via a suite-level
! @before/@after pair that unconditionally resets the gate to .false.
! before and after every test in this file - restored even when a test
! fails.
!
! Why all five tests, not just the one that touches the flag: pFUnit's
! @before/@after is NOT disambiguated by the @test subroutine's own
! dummy-argument type - confirmed via NAG's own compile error (far
! clearer than gfortran's, which silently miscompiled instead of
! rejecting the mismatch): "Actual procedure RESET_MATERIALIZE_
! EXTENSIONS_GATE argument 1 data type MPITESTMETHOD differs from
! dummy procedure SETUP argument data type ESMF_TESTMETHOD". A
! @before/@after pair declared anywhere in a .pf file is applied to
! EVERY @test in that file regardless of its own declared type. Since
! Test_GraphBuilder.pf's own fix needed an MpiTestMethod-typed pair for
! its 3 MpiTestMethod tests that touch the flag, every ESMF_TestMethod
! test in that same file would have been force-fed the wrong-typed
! pair - so all five had to move here, where this file's own
! ESMF_TestMethod-typed pair applies uniformly to everything in it (the
! four that never touch the flag get a harmless no-op reset/restore).
module Test_GraphBuilderMaterializeGate
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod
   use mapl_HorizontalDimsSpec_mod, only: HorizontalDimsSpec, HORIZONTAL_DIMS_GEOM, operator(==)
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetwork_mod, only: DependencyNetwork
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_ChildSpec_mod, only: ChildSpec
   use mapl_ComponentSpec_mod, only: ComponentSpec
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_RestartModes_mod, only: RestartMode, RESTART_REQUIRED, RESTART_SKIP, operator(==)
   use mapl_field_api, only: MAPL_FieldGet, MAPL_FieldSet
   use mapl_enums_api, only: MAPL_StateItemAllocation, operator(==)
   use mapl_enums_api, only: MAPL_STATEITEM_ALLOCATION_CREATED, &
        MAPL_STATEITEM_ALLOCATION_ACTIVE, MAPL_STATEITEM_ALLOCATION_ALLOCATED
   use mapl_field_api, only: MAPL_FieldCreate
   use mapl_GeomUtilities_mod, only: GeomSetId
   use mapl_SimpleConnection_mod, only: SimpleConnection
   use mapl_StateItem_mod, only: MAPL_STATEITEM_EXPRESSION
   use mapl_ConnectionPt_mod, only: ConnectionPt
   use mapl_VirtualConnectionPt_mod, only: VirtualConnectionPt
   use mapl_MatchConnection_mod, only: MatchConnection
   use mapl_ReexportConnection_mod, only: ReexportConnection
   use mapl_NodeId_mod, only: NodeId
   use mapl_NodeIdSet_mod, only: NodeIdSet, NodeIdSetIterator, operator(/=)
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem, operator(==)
   use mapl_ExtensionResolution_mod, only: set_materialize_extensions
   use mapl_ExtensionMaterialization_mod, only: field_extension_is_created
   use mapl_StateItemDescriptor_mod, only: StateItemDescriptor
   use mapl_StateItemCharacteristicKind_mod, only: GEOMETRY_CHARACTERISTIC_KIND
   use mapl_GeometryCharacteristic_mod, only: GeometryCharacteristic
   use mapl_VerticalStaggerLoc_mod, only: VERTICAL_STAGGER_NONE
   use mapl_GraphOwnsUserStates_mod, only: set_graph_owns_user_states
   use mapl_StateItem_mod, only: MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_FIELD
   use mapl_GraphMode_mod, only: set_graph_mode, GRAPH_MODE_REGISTRY, GRAPH_MODE_GRAPH, GRAPH_MODE_BOTH
   use mapl_MultiState_mod, only: MultiState
   use mapl_FieldCreate_mod, only: FieldsAreAliased
   use mapl_FieldGet_mod, only: FieldGet
   use mapl_GraphResolutionEntryVector_mod, only: GraphResolutionEntryVector
   use GraphBuilderTestSupport_mod, only: make_outer_meta, make_var
   use ESMF_TestMethod_mod
   use esmf
   use pfunit
   implicit none(type, external)

   type :: AdvertisePopulationSnapshot
      logical :: z_created = .false., e_created = .false., i_created = .false.
      logical :: e_is_node_field = .false.
      character(:), allocatable :: e_units, e_standard_name, e_long_name
      character(:), allocatable :: i_units, x_units
      character(len=ESMF_MAXSTR) :: x_name = ''
      integer :: import_count = -1, export_count = -1, a_count = -1
   end type AdvertisePopulationSnapshot

contains

   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_unitless_expression_input_precision_materializes(this)
      class(ESMF_TestMethod), intent(inout) :: this
      type(OuterMetaComponent), pointer :: parent, src, dst
      type(ComponentSpec), pointer :: spec
      type(ESMF_GridComp) :: parent_gc, child_gc
      type(GriddedComponentDriver) :: driver
      type(GriddedComponentDriver), pointer :: user_driver
      type(ChildSpec) :: child_spec
      type(VariableSpec) :: var
      type(SimpleConnection) :: connection
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: source_field, converted_field, result_field
      type(HorizontalDimsSpec) :: dims_spec
      type(ESMF_State) :: export_state
      type(MultiState) :: states
      type(ComponentGraph), pointer :: pg, dg
      type(DependencyNetwork), pointer :: net
      type(NodeId), pointer :: import_id, bound
      type(NodeId) :: result_id, evaluation_id
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: payload
      type(ESMF_TypeKind_Flag) :: typekind
      type(GraphResolutionEntryVector) :: unsupported
      type(GraphBuilder) :: gb
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)
      call GeomSetId(geom, 301, rc=status)
      @assertEqual(0, status)
      source_field = MAPL_FieldCreate(name='A', geom=geom, &
           typekind=ESMF_TYPEKIND_R4, rc=status)
      @assertEqual(0, status)

      call make_outer_meta('expr_unitless_input', parent_gc, parent, _RC)
      child_spec = ChildSpec()
      call parent%add_child('src', child_spec, _RC)
      call parent%add_child('dst', child_spec, _RC)
      driver = parent%get_child('src', _RC)
      child_gc = driver%get_gridcomp()
      src => get_outer_meta(child_gc, _RC)
      driver = parent%get_child('dst', _RC)
      child_gc = driver%get_gridcomp()
      dst => get_outer_meta(child_gc, _RC)
      spec => src%get_component_spec()
      ! Undeclared source-spec units make the input unit-less to the graph.
      var = make_var(ESMF_STATEINTENT_EXPORT, 'A')
      var%geom = geom
      call spec%add_var_spec(var)
      var = make_var(ESMF_STATEINTENT_EXPORT, 'expr', units='m')
      var%geom = geom
      var%itemType = MAPL_STATEITEM_EXPRESSION
      var%expression = 'A'
      call spec%add_var_spec(var)
      spec => dst%get_component_spec()
      var = make_var(ESMF_STATEINTENT_IMPORT, 'I', units='m')
      var%geom = geom
      var%typekind = ESMF_TYPEKIND_R8
      call spec%add_var_spec(var)
      spec => parent%get_component_spec()
      connection = SimpleConnection( &
           ConnectionPt('src', VirtualConnectionPt( &
           state_intent='export', short_name='expr')), &
           ConnectionPt('dst', VirtualConnectionPt( &
           state_intent='import', short_name='I')))
      call spec%add_connection(connection)
      call gb%advertise(src, _RC)
      call gb%advertise(dst, _RC)
      user_driver => src%get_user_gc_driver()
      states = user_driver%get_states()
      call states%get_state(export_state, ESMF_STATEINTENT_EXPORT, _RC)
      call ESMF_StateAdd(export_state, [source_field], _RC)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_materialize_extensions(.true.)
      call gb%resolve_connections(parent, &
           unsupported_characteristics=unsupported, rc=status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      @assertEqual(0, status)
      @assertEqual(0, unsupported%size())
      if (unsupported%size() /= 0) return
      pg => parent%get_component_graph()
      dg => dst%get_component_graph()
      import_id => dg%get_resource_index( &
           item_key(ESMF_STATEINTENT_IMPORT, 'I'))
      net => pg%get_network(pg%get_forward_network_id())
      @assertTrue(net%has_predecessors(import_id))
      if (.not. net%has_predecessors(import_id)) return
      result_id = single_predecessor(net, import_id)
      evaluation_id = single_predecessor(net, result_id)
      bound => pg%get_port_binding(pg%get_forward_network_id(), &
           evaluation_id, 'A')
      @assertTrue(associated(bound))
      if (.not. associated(bound)) return
      @assertTrue(pg%owns_node(bound))
      node => pg%get_node(bound)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
         @assertTrue(payload%itemType(rc=status) == ESMF_STATEITEM_FIELD)
         converted_field = payload%get_field(rc=status)
         @assertEqual(0, status)
         call MAPL_FieldGet(converted_field, typekind=typekind, rc=status)
         @assertEqual(0, status)
         @assertTrue(typekind == ESMF_TYPEKIND_R8)
      class default
         @assertTrue(.false., 'converted input is not a state item')
      end select

      ! The expression result spans the geom: the descriptor says so, and
      ! materialization writes no default of its own.
      node => pg%get_node(result_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
         @assertTrue(payload%itemType(rc=status) == ESMF_STATEITEM_FIELD)
         result_field = payload%get_field(rc=status)
         @assertEqual(0, status)
         call MAPL_FieldGet(result_field, horizontal_dims_spec=dims_spec, &
              rc=status)
         @assertEqual(0, status)
         @assertTrue(dims_spec == HORIZONTAL_DIMS_GEOM)
      class default
         @assertTrue(.false., 'expression result is not a state item')
      end select
      _UNUSED_DUMMY(this)
   end subroutine test_unitless_expression_input_precision_materializes

   @before
   subroutine reset_materialize_extensions_gate(this)
      class(ESMF_TestMethod), intent(inout) :: this

      call set_materialize_extensions(.false.)
      _UNUSED_DUMMY(this)
   end subroutine reset_materialize_extensions_gate

   @after
   subroutine restore_materialize_extensions_gate(this)
      class(ESMF_TestMethod), intent(inout) :: this

      call set_materialize_extensions(.false.)
      call set_graph_owns_user_states(.false.)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine restore_materialize_extensions_gate

   ! make_outer_meta/make_var shared via GraphBuilderTestSupport_mod
   ! (docs/graph/spec/20-implementation-roadmap.md sec 20.4.17).

   function single_predecessor(net, node) result(pred_id)
      type(DependencyNetwork), intent(in) :: net
      type(NodeId), intent(in) :: node
      type(NodeId) :: pred_id

      type(NodeIdSet), target :: preds
      type(NodeIdSetIterator) :: iter

      preds = net%get_predecessors(node)
      iter = preds%ftn_begin()
      call iter%next()
      pred_id = iter%of()
   end function single_predecessor

   ! Spec "Resolved extension has a real payload" + "Resolved extension remains
   ! discoverable" + "Reused extension is not re-materialized": with the gate
   ! explicitly enabled, the extension chain's final item gets a real,
   ! correctly-shaped ESMF_Field, still discoverable via the same
   ! proxy/predecessor query, and calling resolve_connections a second time
   ! does not replace it. type=ESMF_TestMethod, npes=[1] (unlike
   ! Test_GraphBuilder.pf's other tests, Test_GeomAspect.pf's own precedent for
   ! real-geom pFUnit tests): this test calls FieldCreate on a real ESMF_Geom -
   ! a plain MpiTestMethod sub-communicator does not reconfigure ESMF's own
   ! default VM, so a real ESMF collective call still synchronizes against this
   ! suite's full ambient multi-PE test world and would deadlock without
   ! ESMF_TestMethod's proper per-test VM scoping.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_materialize_extensions_enabled_creates_real_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_import_id
      type(NodeId) :: extension_id
      type(DependencyNetwork), pointer :: net
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: extension_payload
      type(VariableSpec) :: export_var_spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: result_field
      type(ESMF_TypeKind_Flag) :: got_typekind
      character(:), allocatable :: got_units
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)

      call make_outer_meta('comp_parent_gate_on', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      ! Explicit-override geom ("Geom/vgrid resolution order" case (a), the
      ! HistoryCollection-style case) - this synthetic OuterMetaComponent never
      ! runs initialize_geom_a/b, so it has no component-wide default of its
      ! own.
      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      export_var_spec%geom = geom
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='km'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_materialize_extensions(.true.)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      call set_materialize_extensions(.false.)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_import_id), is(true()))

      net => parent_graph%get_network(parent_graph%get_forward_network_id())
      extension_id = single_predecessor(net, t_import_id)

      node => parent_graph%get_node(extension_id)
      select type (node)
      class is (StateItemNode)
         extension_payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(extension_payload%itemType(rc=status) == ESMF_STATEITEM_FIELD)

      result_field = extension_payload%get_field(rc=status)
      @assertEqual(0, status)
      call FieldGet(result_field, typekind=got_typekind, units=got_units, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R4)
      @assertEqual('km', got_units)

      _UNUSED_DUMMY(this)
   end subroutine test_materialize_extensions_enabled_creates_real_field

   ! A BRACKET export -> FIELD import pairing reaches the narrowed export-side
   ! gate and is NOT reported as unsupported_item_class - unlike
   ! Test_GraphBuilder_ConnectionResolution.pf's own
   ! test_materialize_extensions_reports_unsupported_item_class
   ! (VECTOR->VECTOR), which still correctly fails (shape mismatch with no
   ! build_transform support). Units/typekind match on both sides, isolating
   ! the shape axis exactly as the synthetic-node test
   ! test_bracket_to_field_mismatch_builds_interpolation_chain in
   ! Test_ExtensionResolution.pf does. Lives in
   ! THIS file, not Test_GraphBuilder_ConnectionResolution.pf, because
   ! materialize_extension_chain (where the gate actually lives)
   ! calls resolve_export_geom, which needs a real geom - the same
   ! type=ESMF_TestMethod, npes=[1] real-ESMF-geom precedent as
   ! test_materialize_extensions_enabled_creates_real_field just above (a plain
   ! MpiTestMethod sub-communicator cannot run the real
   ! ESMF_GridCreateNoPeriDim/GeomCreate collective calls this test needs).
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_materialize_extensions_bracket_export_narrowed_gate(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(VariableSpec) :: export_var_spec, import_var_spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)

      call make_outer_meta('comp_parent_bracket_shape_gate', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      ! Explicit-override geom (same precedent as
      ! test_materialize_extensions_enabled_creates_real_field above) -
      ! this synthetic OuterMetaComponent never runs
      ! initialize_geom_a/b, so it has no component-wide default of its
      ! own; without this, the shape gate would pass but
      ! resolve_export_geom would then fail with 'unresolved_geom',
      ! masking whether the shape gate itself actually passed.
      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      export_var_spec%itemType = MAPL_STATEITEM_BRACKET
      export_var_spec%geom = geom
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      import_var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'T', units='m')
      import_var_spec%itemType = MAPL_STATEITEM_FIELD
      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(import_var_spec)

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_materialize_extensions(.true.)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      call set_materialize_extensions(.false.)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      ! A BRACKET export reaching try_materialize_field_extension/
      ! materialize_extension_chain is not rejected outright by the
      ! export-side unsupported_item_class check - it is the ITEM_SHAPE
      ! mismatch build_transform (ItemShapeCharacteristic ->
      ! BracketTimeInterpolationTransform) that resolves this pairing.
      @assertEqual(0, unsupported%size())

      _UNUSED_DUMMY(this)
   end subroutine test_materialize_extensions_bracket_export_narrowed_gate

   ! Spec "Matching export is materialized with a real field": with the graph
   ! mode selected as GRAPH_MODE_GRAPH (GRAPH_MODE_BOTH behaves identically for
   ! this call - both are "not GRAPH_MODE_REGISTRY"), resolve_one's no-mismatch
   ! branch gives the export's own node (here, the parent's own proxy standing
   ! in for child_src's export - no separate extension node exists for an exact
   ! match) a real, allocated field, reusing the same geom/vgrid resolution
   ! test_materialize_extensions_enabled_creates_real_field already exercises
   ! for the mismatch branch. type=ESMF_TestMethod, npes=[1]: same
   ! real-ESMF-geom precedent as that test.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_exact_match_materializes_field_in_graph_mode(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: parent_graph
      type(ComponentGraph), pointer :: src_graph, dst_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_export_id, t_import_id
      type(DependencyNetwork), pointer :: net
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: export_payload
      type(VariableSpec) :: export_var_spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: result_field
      type(ESMF_TypeKind_Flag) :: got_typekind
      character(:), allocatable :: got_units
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)

      call make_outer_meta('comp_parent_mode_graph', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      ! Explicit-override geom (same precedent as
      ! test_materialize_extensions_enabled_creates_real_field) - this
      ! synthetic OuterMetaComponent never runs initialize_geom_a/b.
      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      export_var_spec%geom = geom
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='m'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())
      @assertEqual(0, unsupported%size())

      parent_graph => parent_meta%get_component_graph()
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      t_import_id => dst_graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      @assert_that(associated(t_import_id), is(true()))

      ! No extension chain for an exact match - still a direct edge
      ! (spec "Matching export and import are wired" is unaffected by
      ! the materialization step).
      net => parent_graph%get_network(parent_graph%get_forward_network_id())
      @assert_that(net%contains_dependency(t_export_id, t_import_id), is(true()))

      node => src_graph%get_node(t_export_id)
      select type (node)
      class is (StateItemNode)
         export_payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertTrue(export_payload%itemType(rc=status) == ESMF_STATEITEM_FIELD)

      result_field = export_payload%get_field(rc=status)
      @assertEqual(0, status)
      call FieldGet(result_field, typekind=got_typekind, units=got_units, rc=status)
      @assertEqual(0, status)
      @assertTrue(got_typekind == ESMF_TYPEKIND_R4)
      @assertEqual('m', got_units)

      _UNUSED_DUMMY(this)
   end subroutine test_exact_match_materializes_field_in_graph_mode

   ! Direct coverage of graphbuilder_populate_state, called on the PARENT (the component that
   ! declared the MatchConnection), not either connected child. Covers spec "An exact-match
   ! import's real field is found via its export" (child_dst's own real import
   ! field, once inserted, is the SAME field object materialized on child_src's
   ! own export proxy - checked via FieldsAreAliased, not just typekind/units
   ! equality) and spec "Unresolved import is not populated" (Q, declared but
   ! never connected, produces no entry and no error) in one fixture.
   !
   ! The field this test checks for is the resolved item of a
   ! sibling-to-sibling (cross-component) connection: it lands in the own real
   ! ESMF_State of child_dst (get_user_gc_driver%get_states), never in the
   ! parent-supplied `multi_state` this test passes into populate_state
   ! (which is only used for the same-component/degenerate case of the
   ! parent). The parent-supplied `multi_state` is explicitly asserted to
   ! receive NEITHER field.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_aliases_export_and_skips_unresolved(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(ComponentGraph), pointer :: src_graph
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(NodeId), pointer :: t_export_id
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: export_payload
      type(VariableSpec) :: export_var_spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: export_field, import_state_field
      type(ESMF_State) :: real_import_state, real_export_state
      type(ESMF_State) :: dst_own_import_state
      type(MultiState) :: multi_state
      type(MultiState) :: dst_own_states
      type(GriddedComponentDriver), pointer :: dst_own_driver
      integer :: item_count
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)

      call make_outer_meta('comp_parent_populate', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      export_var_spec%geom = geom
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='m'))
      ! Declared but never connected - must be silently skipped, not an
      ! error (spec "Unresolved import is not populated").
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'Q', units='m'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      ! Q, declared but never connected, has no matching export.
      @assertEqual(1, unresolved%size())

      real_import_state = ESMF_StateCreate(name='import', rc=status)
      @assertEqual(0, status)
      real_export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      multi_state = MultiState(importState=real_import_state, exportState=real_export_state)

      call gb%populate_state(parent_meta, multi_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      @assert_that(status, is(0))

      ! The export's own real field, fetched directly from child_src's own real
      ! NodeId (same node checks) - no parent-local proxy exists.
      src_graph => src_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      node => src_graph%get_node(t_export_id)
      select type (node)
      class is (StateItemNode)
         export_payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      export_field = export_payload%get_field(rc=status)
      @assertEqual(0, status)

      ! A sibling connection's resolved import field lands in child_dst's
      ! OWN real ESMF_State (reached via get_user_gc_driver%get_states), never
      ! in the parent-supplied `multi_state` above - the field is still the
      ! SAME field object child_src's own export proxy materialized, not merely
      ! an equally-shaped copy.
      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_own_states = dst_own_driver%get_states()
      dst_own_import_state = dst_own_states%importState
      call ESMF_StateGet(dst_own_import_state, 'T', import_state_field, rc=status)
      @assertEqual(0, status)
      @assertTrue(FieldsAreAliased(export_field, import_state_field))

      ! Q was never connected (never wired, never populated) - no
      ! entry, no error, on child_dst's own state.
      call ESMF_StateGet(dst_own_import_state, itemCount=item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, item_count)

      ! The parent's own `multi_state` (passed into populate_state)
      ! receives NEITHER field - confirms the fix, not merely that
      ! population happened somewhere.
      call ESMF_StateGet(real_import_state, itemCount=item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, item_count)
      call ESMF_StateGet(real_export_state, itemCount=item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, item_count)

      _UNUSED_DUMMY(this)
   end subroutine test_populate_state_aliases_export_and_skips_unresolved

   ! Direct coverage of the per-child state population - child_src's own real EXPORT state and
   ! child_dst's own real IMPORT state each receive the resolved field under
   ! its own short name, the two states hold the SAME field object
   ! (FieldsAreAliased), and the parent's own multi_state is confirmed empty -
   ! the one assertion test_populate_state_aliases_export_and_skips_unresolved
   ! above does not make (it checks child_dst's own import state and the Q
   ! unresolved-import case, but not child_src's own export state explicitly).
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_reaches_each_childs_own_state(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(VariableSpec) :: export_var_spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: parent_import_state, parent_export_state
      type(ESMF_State) :: src_own_export_state, dst_own_import_state
      type(MultiState) :: parent_multi_state
      type(MultiState) :: src_own_states, dst_own_states
      type(GriddedComponentDriver), pointer :: src_own_driver, dst_own_driver
      type(ESMF_Field) :: src_field, dst_field
      integer :: src_item_count, dst_item_count, parent_import_count, parent_export_count
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)

      call make_outer_meta('comp_parent_populate_children', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      export_var_spec%geom = geom
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='m'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      parent_import_state = ESMF_StateCreate(name='import', rc=status)
      @assertEqual(0, status)
      parent_export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      parent_multi_state = MultiState(importState=parent_import_state, exportState=parent_export_state)

      call gb%populate_state(parent_meta, parent_multi_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      @assert_that(status, is(0))

      ! child_src's own real EXPORT state (the export side is touched
      ! symmetrically with the import side).
      src_own_driver => src_meta%get_user_gc_driver()
      src_own_states = src_own_driver%get_states()
      src_own_export_state = src_own_states%exportState
      call ESMF_StateGet(src_own_export_state, 'T', src_field, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(src_own_export_state, itemCount=src_item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, src_item_count)

      ! child_dst's own real IMPORT state.
      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_own_states = dst_own_driver%get_states()
      dst_own_import_state = dst_own_states%importState
      call ESMF_StateGet(dst_own_import_state, 'T', dst_field, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(dst_own_import_state, itemCount=dst_item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(1, dst_item_count)

      ! Same field object on both sides - not two independently
      ! materialized fields that happen to compare equal.
      @assertTrue(FieldsAreAliased(src_field, dst_field))

      ! Neither child's own field reaches the parent's own multi_state.
      call ESMF_StateGet(parent_import_state, itemCount=parent_import_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, parent_import_count)
      call ESMF_StateGet(parent_export_state, itemCount=parent_export_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, parent_export_count)

      _UNUSED_DUMMY(this)
   end subroutine test_populate_state_reaches_each_childs_own_state

   ! populate_one writes each alias's own per-alias keys (restart_mode,
   ! long_name) from its own item's descriptor.
   ! S: the export declares RESTART_SKIP, so its alias reads SKIP (the raw
   ! field's slot is still REQUIRED, so only a real write gets there).
   ! T: the raw field's own slot is set to SKIP before populate_state, so a
   ! no-op write would leave every alias of it at SKIP. The export declares
   ! RESTART_REQUIRED and the import declares nothing; both read REQUIRED
   ! only because populate_one writes it (imports sharing an export keep
   ! their own modes, not the exporter's).
   ! U: the import declares its own long_name and the export declares none,
   ! so the import's alias carries the import's.
   ! W: an export with a standard_name and no long_name gets
   ! long_name = standard_name on its alias.
   ! Not asserted: an UNCHECKED import inheriting the export's long_name. The
   ! export's value is written on the export's alias only, and the import's
   ! MAPL_NamedAlias copies the raw field's own slot, so the import reads
   ! 'unknown' under the graph path (gap until B4).
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_writes_per_alias_keys(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(VariableSpec) :: spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: parent_import_state, parent_export_state
      type(ESMF_State) :: src_export_state, dst_import_state
      type(MultiState) :: parent_multi_state, src_states, dst_states
      type(GriddedComponentDriver), pointer :: src_own_driver, dst_own_driver
      type(ESMF_Field) :: field, raw_field
      type(ComponentGraph), pointer :: src_graph
      type(NodeId), pointer :: t_export_id
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: export_payload
      type(RestartMode) :: mode
      character(:), allocatable :: long_name
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)

      call make_outer_meta('comp_parent_per_alias', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      dst_spec => dst_meta%get_component_spec()

      spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      spec%geom = geom
      spec%restart_mode = RESTART_REQUIRED
      spec%long_name = 'Export T'
      call src_spec%add_var_spec(spec)
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='m'))

      spec = make_var(ESMF_STATEINTENT_EXPORT, 'S', units='m')
      spec%geom = geom
      spec%restart_mode = RESTART_SKIP
      call src_spec%add_var_spec(spec)
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'S', units='m'))

      spec = make_var(ESMF_STATEINTENT_EXPORT, 'U', units='m')
      spec%geom = geom
      call src_spec%add_var_spec(spec)
      spec = make_var(ESMF_STATEINTENT_IMPORT, 'U', units='m')
      spec%long_name = 'Import U'
      call dst_spec%add_var_spec(spec)

      spec = make_var(ESMF_STATEINTENT_EXPORT, 'W', units='m')
      spec%geom = geom
      spec%standard_name = 'air_temperature'
      call src_spec%add_var_spec(spec)
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'W', units='m'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, unresolved%size())

      ! Put SKIP in T's raw field slot, which MAPL_NamedAlias copies onto
      ! every alias it creates.
      src_graph => src_meta%get_component_graph()
      t_export_id => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      @assert_that(associated(t_export_id), is(true()))
      node => src_graph%get_node(t_export_id)
      select type (node)
      class is (StateItemNode)
         export_payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      raw_field = export_payload%get_field(rc=status)
      @assertEqual(0, status)
      call MAPL_FieldSet(raw_field, restart_mode=RESTART_SKIP, rc=status)
      @assertEqual(0, status)

      parent_import_state = ESMF_StateCreate(name='import', rc=status)
      @assertEqual(0, status)
      parent_export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      parent_multi_state = MultiState(importState=parent_import_state, exportState=parent_export_state)

      call gb%populate_state(parent_meta, parent_multi_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      @assert_that(status, is(0))

      src_own_driver => src_meta%get_user_gc_driver()
      src_states = src_own_driver%get_states()
      src_export_state = src_states%exportState
      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_states = dst_own_driver%get_states()
      dst_import_state = dst_states%importState

      ! A declared SKIP reaches the export's alias.
      call ESMF_StateGet(src_export_state, 'S', field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(field, restart_mode=mode, rc=status)
      @assertEqual(0, status)
      @assertTrue(mode == RESTART_SKIP)

      ! The export's alias reads its declared mode and long_name, over the
      ! raw field's SKIP.
      call ESMF_StateGet(src_export_state, 'T', field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(field, restart_mode=mode, long_name=long_name, rc=status)
      @assertEqual(0, status)
      @assertTrue(mode == RESTART_REQUIRED)
      @assertEqual('Export T', long_name)

      ! The import of the same field keeps its own mode: REQUIRED, not the
      ! raw field's SKIP.
      call ESMF_StateGet(dst_import_state, 'T', field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(field, restart_mode=mode, rc=status)
      @assertEqual(0, status)
      @assertTrue(mode == RESTART_REQUIRED)

      ! An import that declares a long_name carries it on its own alias.
      call ESMF_StateGet(dst_import_state, 'U', field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(field, long_name=long_name, rc=status)
      @assertEqual(0, status)
      @assertEqual('Import U', long_name)

      ! The export's long_name falls back to its standard_name.
      call ESMF_StateGet(src_export_state, 'W', field, rc=status)
      @assertEqual(0, status)
      call MAPL_FieldGet(field, long_name=long_name, rc=status)
      @assertEqual(0, status)
      @assertEqual('air_temperature', long_name)

      _UNUSED_DUMMY(this)
   end subroutine test_populate_state_writes_per_alias_keys

   ! Spec "Graph mode governs whether population touches the real state": in
   ! both GRAPH_MODE_REGISTRY and GRAPH_MODE_BOTH, graphbuilder_populate_state
   ! inserts nothing into a real ESMF_State, even though GRAPH_MODE_BOTH's own
   ! materialization step above still gives the export's own node a real field
   ! (checked directly, out of band, same as
   ! test_exact_match_materializes_field_in_graph_mode already does for
   ! GRAPH_MODE_GRAPH - GRAPH_MODE_BOTH behaves identically there, "not
   ! GRAPH_MODE_REGISTRY").
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_no_insert_in_registry_or_both_mode(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(VariableSpec) :: export_var_spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: real_import_state, real_export_state
      type(MultiState) :: multi_state
      integer :: item_count
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      @assertEqual(0, status)
      geom = ESMF_GeomCreate(grid, rc=status)
      @assertEqual(0, status)

      call make_outer_meta('comp_parent_populate_both', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      export_var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      export_var_spec%geom = geom
      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(export_var_spec)

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='m'))

      call gb%advertise(src_meta, status)
      @assert_that(status, is(0))
      call gb%advertise(dst_meta, status)
      @assert_that(status, is(0))

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='T')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='T')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call set_graph_mode(GRAPH_MODE_BOTH)
      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, rc=status)
      @assert_that(status, is(0))

      real_import_state = ESMF_StateCreate(name='import', rc=status)
      @assertEqual(0, status)
      real_export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      multi_state = MultiState(importState=real_import_state, exportState=real_export_state)

      call gb%populate_state(parent_meta, multi_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      @assert_that(status, is(0))

      call ESMF_StateGet(real_import_state, itemCount=item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, item_count)
      call ESMF_StateGet(real_export_state, itemCount=item_count, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, item_count)

      _UNUSED_DUMMY(this)
   end subroutine test_populate_state_no_insert_in_registry_or_both_mode

   ! Builds child_src (INTERNAL Z, EXPORT E_unconn, EXPORT E_conn) and
   ! child_dst (IMPORT E_conn) under a parent, advertises both, and connects
   ! only E_conn. The caller sets the graph mode first: advertise reads it.
   ! With prefill, child_src's own real user states are filled as legacy
   ! leaves them after advertise (fields E_unconn, E_conn and Z, returned in
   ! legacy_fields in that order) before connections resolve.
   subroutine make_field_per_node_fixture(parent_name, parent_meta, src_meta, &
        dst_meta, prefill, legacy_conn_status, legacy_fields, rc)
      character(*), intent(in) :: parent_name
      type(OuterMetaComponent), pointer, intent(out) :: parent_meta
      type(OuterMetaComponent), pointer, intent(out) :: src_meta, dst_meta
      logical, intent(in) :: prefill
      type(MAPL_StateItemAllocation), intent(in) :: legacy_conn_status
      type(ESMF_Field), intent(out) :: legacy_fields(3)
      integer, intent(out) :: rc

      type(ESMF_GridComp) :: parent_gc
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved, unsupported
      type(VariableSpec) :: var_spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(GriddedComponentDriver), pointer :: src_own_driver
      type(MultiState) :: src_own_states
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      _VERIFY(status)
      geom = ESMF_GeomCreate(grid, rc=status)
      _VERIFY(status)

      call make_outer_meta(parent_name, parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      var_spec = make_var(ESMF_STATEINTENT_INTERNAL, 'Z', units='m')
      var_spec%geom = geom
      call src_spec%add_var_spec(var_spec)
      var_spec%state_intent = ESMF_STATEINTENT_INTERNAL
      var_spec%short_name = 'Zdef'
      var_spec%vertical_stagger = VERTICAL_STAGGER_NONE
      var_spec%units = 'm'
      call src_spec%add_var_spec(var_spec)
      var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'E_unconn', units='m')
      var_spec%geom = geom
      call src_spec%add_var_spec(var_spec)
      var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'E_conn', units='m')
      var_spec%geom = geom
      call src_spec%add_var_spec(var_spec)

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'E_conn', &
           units='m'))
      var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'I_unconn', units='m')
      var_spec%geom = geom
      call dst_spec%add_var_spec(var_spec)

      call gb%advertise(src_meta, _RC)
      call gb%advertise(dst_meta, _RC)

      if (prefill) then
         src_own_driver => src_meta%get_user_gc_driver()
         src_own_states = src_own_driver%get_states()
         legacy_fields(1) = ESMF_FieldEmptyCreate(name='E_unconn', rc=status)
         _VERIFY(status)
         legacy_fields(2) = ESMF_FieldEmptyCreate(name='E_conn', rc=status)
         _VERIFY(status)
         legacy_fields(3) = ESMF_FieldEmptyCreate(name='Z', rc=status)
         _VERIFY(status)
         ! Legacy at ACCEPT_TRANSFER: empty Fields; an unconnected export is
         ! CREATED, a connected export or an internal ACTIVE.
         call MAPL_FieldSet(legacy_fields(1), &
              allocation_status=MAPL_STATEITEM_ALLOCATION_CREATED, rc=status)
         _VERIFY(status)
         call MAPL_FieldSet(legacy_fields(2), &
              allocation_status=legacy_conn_status, rc=status)
         _VERIFY(status)
         call MAPL_FieldSet(legacy_fields(3), &
              allocation_status=MAPL_STATEITEM_ALLOCATION_ACTIVE, rc=status)
         _VERIFY(status)
         call ESMF_StateAdd(src_own_states%exportState, [legacy_fields(1), &
              legacy_fields(2)], rc=status)
         _VERIFY(status)
         call ESMF_StateAdd(src_own_states%internalState, [legacy_fields(3)], &
              rc=status)
         _VERIFY(status)
      end if

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt( &
                state_intent='export', short_name='E_conn')), &
           ConnectionPt('child_dst', &
                VirtualConnectionPt(state_intent='import', &
                short_name='E_conn')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      call gb%resolve_connections(parent_meta, unresolved_imports=unresolved, &
           unsupported_characteristics=unsupported, _RC)

      rc = 0
   end subroutine make_field_per_node_fixture

   ! Allocation status recorded in a Field's Info, read through MAPL_FieldGet.
   subroutine get_allocation_status(field, alloc_status, rc)
      type(ESMF_Field), intent(in) :: field
      type(MAPL_StateItemAllocation), intent(out) :: alloc_status
      integer, intent(out) :: rc

      call MAPL_FieldGet(field, allocation_status=alloc_status, rc=rc)
   end subroutine get_allocation_status

   ! In GRAPH mode every INTERNAL and EXPORT Field item gets one Field at
   ! advertise. Population (no registry add_to_states) then puts: an
   ! INTERNAL item allocated in the user internal state; an unconnected
   ! EXPORT created and not allocated in the user export state; a connected
   ! EXPORT allocated, and aliased by the import in the consumer state.
   ! Seeded to fail: with creation at advertise off, Z and E_unconn are
   ! absent from the states; with completion off, Z is only CREATED.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_field_per_node_graph_mode(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GriddedComponentDriver), pointer :: dst_own_driver
      type(MultiState) :: dst_own_states
      type(ESMF_State) :: internal_state, export_state, import_state
      type(ESMF_State) :: parent_import_state, parent_export_state
      type(MultiState) :: src_states, parent_states
      type(ESMF_Field) :: z_field, unconn_field, conn_field, import_field
      type(ESMF_Field) :: unconn_import
      type(ESMF_FieldStatus_Flag) :: unconn_import_fstatus
      integer :: import_count
      type(ESMF_FieldStatus_Flag) :: z_fstatus, unconn_fstatus
      type(MAPL_StateItemAllocation) :: z_alloc, unconn_alloc, conn_alloc
      integer :: status, status_z, status_u, status_c, status_i
      logical :: aliased
      type(GraphBuilder) :: gb
      type(ESMF_Field) :: legacy(3)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_fpn_graph', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))

      internal_state = ESMF_StateCreate(name='internal', rc=status)
      @assertEqual(0, status)
      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      import_state = ESMF_StateCreate(name='import', rc=status)
      @assertEqual(0, status)
      src_states = MultiState(importState=import_state, &
           exportState=export_state, internalState=internal_state)

      parent_import_state = ESMF_StateCreate(name='p_import', rc=status)
      @assertEqual(0, status)
      parent_export_state = ESMF_StateCreate(name='p_export', rc=status)
      @assertEqual(0, status)
      parent_states = MultiState(importState=parent_import_state, &
           exportState=parent_export_state)

      ! The parent walk fills each child's own real states (the consumer's
      ! import); the producer's own walk fills the states built above.
      call gb%populate_state(parent_meta, parent_states, status)
      @assert_that(status, is(0))
      call gb%populate_state(src_meta, src_states, status)
      @assert_that(status, is(0))
      ! A second pass (GENERIC_INIT_ACCEPT_TRANSFER runs twice) is harmless.
      call gb%populate_state(parent_meta, parent_states, status)
      @assert_that(status, is(0))
      call gb%populate_state(src_meta, src_states, status)
      @assert_that(status, is(0))
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      call ESMF_StateGet(internal_state, 'Z', z_field, rc=status_z)
      call ESMF_StateGet(export_state, 'E_unconn', unconn_field, rc=status_u)
      call ESMF_StateGet(export_state, 'E_conn', conn_field, rc=status_c)
      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_own_states = dst_own_driver%get_states()
      call ESMF_StateGet(dst_own_states%importState, 'E_conn', import_field, &
           rc=status_i)
      @assertEqual(0, status_z)
      @assertEqual(0, status_u)
      @assertEqual(0, status_c)
      @assertEqual(0, status_i)
      call ESMF_StateGet(dst_own_states%importState, 'I_unconn', &
           unconn_import, rc=status_i)
      @assertEqual(0, status_i)
      call ESMF_FieldGet(unconn_import, status=unconn_import_fstatus, &
           rc=status_i)
      @assertEqual(0, status_i)
      call ESMF_StateGet(dst_own_states%importState, itemCount=import_count, &
           rc=status_i)
      @assertEqual(0, status_i)

      call get_allocation_status(z_field, z_alloc, status_z)
      call get_allocation_status(unconn_field, unconn_alloc, status_u)
      call get_allocation_status(conn_field, conn_alloc, status_c)
      call ESMF_FieldGet(z_field, status=z_fstatus, rc=status)
      @assertEqual(0, status)
      call ESMF_FieldGet(unconn_field, status=unconn_fstatus, rc=status)
      @assertEqual(0, status)
      aliased = FieldsAreAliased(conn_field, import_field)
      @assertEqual(0, status_z)
      @assertEqual(0, status_u)
      @assertEqual(0, status_c)

      ! (a) INTERNAL: allocated.
      @assertTrue(z_alloc == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertTrue(z_fstatus == ESMF_FIELDSTATUS_COMPLETE)
      ! (b) unconnected EXPORT: created, not allocated.
      @assertTrue(unconn_alloc == MAPL_STATEITEM_ALLOCATION_CREATED)
      @assertFalse(unconn_fstatus == ESMF_FIELDSTATUS_COMPLETE)
      ! (c) connected EXPORT: allocated, one Field with the import.
      @assertTrue(conn_alloc == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertTrue(aliased)
      ! An unconnected import gets its own created Field with its geom
      ! (GRIDSET); the connected import got the producer Field, so only
      ! these two imports are in the state.
      @assertTrue(unconn_import_fstatus == ESMF_FIELDSTATUS_GRIDSET)
      @assertEqual(2, import_count)

      _UNUSED_DUMMY(this)
   end subroutine test_populate_state_field_per_node_graph_mode

   ! On the field-per-node fixture's parent: an INTERNAL PZ re-exported as
   ! PZout, child_src's unconnected export E_unconn re-exported as Eren, and
   ! the children's exports propagated as child_src/<name>.
   subroutine add_export_port_cases(parent_meta, rc)
      type(OuterMetaComponent), pointer, intent(in) :: parent_meta
      integer, intent(out) :: rc

      type(ComponentSpec), pointer :: parent_spec
      type(VariableSpec) :: var_spec
      type(ReexportConnection) :: conn
      type(GraphBuilder) :: gb
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      _VERIFY(status)
      geom = ESMF_GeomCreate(grid, rc=status)
      _VERIFY(status)
      parent_spec => parent_meta%get_component_spec()
      var_spec = make_var(ESMF_STATEINTENT_INTERNAL, 'PZ', units='m')
      var_spec%geom = geom
      var_spec%long_name = 'PZ long name'
      var_spec%restart_mode = RESTART_SKIP
      call parent_spec%add_var_spec(var_spec)
      var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'PE', units='m')
      var_spec%geom = geom
      call parent_spec%add_var_spec(var_spec)
      conn = ReexportConnection( &
           ConnectionPt('<self>', &
           VirtualConnectionPt(state_intent='internal', short_name='PZ')), &
           ConnectionPt('<self>', &
           VirtualConnectionPt(state_intent='export', short_name='PZout')))
      call parent_spec%add_connection(conn)
      conn = ReexportConnection( &
           ConnectionPt('child_src', &
           VirtualConnectionPt(state_intent='export', short_name='E_unconn')), &
           ConnectionPt('<self>', &
           VirtualConnectionPt(state_intent='export', short_name='Eren')))
      call parent_spec%add_connection(conn)

      call gb%advertise(parent_meta, _RC)
      call gb%run_reexport_hook(parent_meta, _RC)
      call gb%run_export_propagate_hook(parent_meta)
      rc = 0
   end subroutine add_export_port_cases

   ! Populates the parent twice (ACCEPT_TRANSFER runs twice) and returns its
   ! real export state.
   subroutine populate_parent_twice(parent_meta, export_state, rc, states_out)
      type(OuterMetaComponent), pointer, intent(in) :: parent_meta
      type(ESMF_State), intent(out) :: export_state
      integer, intent(out) :: rc
      type(MultiState), optional, intent(out) :: states_out

      type(ESMF_State) :: import_state, internal_state
      type(MultiState) :: states
      type(GraphBuilder) :: gb
      integer :: status

      import_state = ESMF_StateCreate(name='p_import', rc=status)
      _VERIFY(status)
      export_state = ESMF_StateCreate(name='p_export', rc=status)
      _VERIFY(status)
      internal_state = ESMF_StateCreate(name='p_internal', rc=status)
      _VERIFY(status)
      states = MultiState(importState=import_state, exportState=export_state, &
           internalState=internal_state)
      call gb%populate_state(parent_meta, states, _RC)
      call gb%populate_state(parent_meta, states, _RC)
      if (present(states_out)) states_out = states
      rc = 0
   end subroutine populate_parent_twice

   ! The export-port table feeds the user export state, with no registry
   ! add_to_states: (a) a renamed re-export of an INTERNAL is that internal's
   ! allocated Field, carrying its long_name; (b) a renamed re-export of an
   ! unconnected export is the producer's Field, still only GRIDSET; (c) a
   ! propagated child_src/E_conn is NOT in the user export state (it is an
   ! outer-state item, as in legacy). A second pass adds nothing.
   ! Seeded to fail: with the port walk off, the export state is empty; with
   ! the propagated filter off, the child_src substate appears.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_export_ports_graph_mode(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(ESMF_State) :: export_state, sub_state
      type(ESMF_Field) :: legacy(3), pz_port, pz_node, eren_port, eren_node
      type(ESMF_Field) :: pe_port, pe_node
      type(ESMF_FieldStatus_Flag) :: eren_fstatus
      type(RestartMode) :: pz_mode
      type(MultiState) :: parent_states
      type(GraphBuilder) :: gb
      type(MAPL_StateItemAllocation) :: pz_alloc, eren_alloc
      character(:), allocatable :: long_name
      integer :: status, st_pz, st_e, st_sub, st_n(3), st_a(3), st_l, st_ea, st_m, st_pe
      integer :: export_count
      logical :: pz_same, eren_same, pe_same

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_ports', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))
      call add_export_port_cases(parent_meta, status)
      @assert_that(status, is(0))
      call populate_parent_twice(parent_meta, export_state, status, parent_states)
      @assert_that(status, is(0))
      ! Then the internal's own Field slots are made to differ from its
      ! declaration, so a third pass gives the alias the declared values only
      ! through sync_alias_info.
      call get_node_field(parent_meta, ESMF_STATEINTENT_INTERNAL, 'PZ', &
           pz_node, status)
      @assert_that(status, is(0))
      call MAPL_FieldSet(pz_node, restart_mode=RESTART_REQUIRED, &
           long_name='raw long name', rc=status)
      @assert_that(status, is(0))
      call gb%populate_state(parent_meta, parent_states, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))

      call ESMF_StateGet(export_state, itemCount=export_count, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(export_state, 'PZout', pz_port, rc=st_pz)
      call ESMF_StateGet(export_state, 'Eren', eren_port, rc=st_e)
      call ESMF_StateGet(export_state, 'child_src', sub_state, rc=st_sub)
      @assertEqual(0, st_pz)
      @assertEqual(0, st_e)
      @assertTrue(st_sub /= 0)
      call ESMF_StateGet(export_state, 'PE', pe_port, rc=st_pe)
      @assertEqual(0, st_pe)

      call get_node_field(parent_meta, ESMF_STATEINTENT_INTERNAL, 'PZ', &
           pz_node, st_n(1))
      call get_node_field(src_meta, ESMF_STATEINTENT_EXPORT, 'E_unconn', &
           eren_node, st_n(2))
      call get_node_field(parent_meta, ESMF_STATEINTENT_EXPORT, 'PE', &
           pe_node, st_n(3))
      pe_same = FieldsAreAliased(pe_port, pe_node, rc=st_a(3))
      pz_same = FieldsAreAliased(pz_port, pz_node, rc=st_a(1))
      eren_same = FieldsAreAliased(eren_port, eren_node, rc=st_a(2))
      call get_allocation_status(pz_port, pz_alloc, st_l)
      call get_allocation_status(eren_port, eren_alloc, st_ea)
      call MAPL_FieldGet(pz_port, long_name=long_name, restart_mode=pz_mode, &
           rc=st_m)
      @assertEqual(0, st_l)
      @assertEqual(0, st_ea)
      @assertEqual(0, st_m)
      call ESMF_FieldGet(eren_port, status=eren_fstatus, rc=status)
      @assertEqual(0, status)
      @assertEqual(0, st_n(1))
      @assertEqual(0, st_n(2))
      @assertEqual(0, st_n(3))
      @assertEqual(0, st_a(3))
      @assertEqual(0, st_a(1))
      @assertEqual(0, st_a(2))

      @assertTrue(pz_same)
      @assertTrue(pz_alloc == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertEqual('PZ long name', long_name)
      ! The raw Field's slot is REQUIRED: SKIP is from sync_alias_info.
      @assertTrue(pz_mode == RESTART_SKIP)
      @assertTrue(eren_same)
      @assertTrue(eren_alloc == MAPL_STATEITEM_ALLOCATION_CREATED)
      @assertTrue(eren_fstatus == ESMF_FIELDSTATUS_GRIDSET)
      ! The declared export PE is in the state once and is its own Field.
      @assertTrue(pe_same)
      ! PZout, Eren and PE only: no child_src substate.
      @assertEqual(3, export_count)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_populate_export_ports_graph_mode

   ! The port walk adds nothing with the switch off or in BOTH mode: legacy
   ! add_to_states fills the user export state there.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_export_ports_off_in_hybrid_and_both(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(ESMF_State) :: export_state
      type(ESMF_Field) :: legacy(3)
      integer :: status, off_count, both_count

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_ports_off', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))
      call add_export_port_cases(parent_meta, status)
      @assert_that(status, is(0))

      call set_graph_owns_user_states(.false.)
      call populate_parent_twice(parent_meta, export_state, status)
      @assert_that(status, is(0))
      call ESMF_StateGet(export_state, itemCount=off_count, rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_BOTH)
      call set_graph_owns_user_states(.true.)
      call populate_parent_twice(parent_meta, export_state, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))
      call ESMF_StateGet(export_state, itemCount=both_count, rc=status)
      @assertEqual(0, status)

      @assertEqual(0, off_count)
      @assertEqual(0, both_count)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(src_meta)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_populate_export_ports_off_in_hybrid_and_both

   ! The own-only populate at advertise never writes a propagated child
   ! export (slash in the port name): that belongs to the outer state only.
   ! Seeded to fail: with the propagated filter off, the child_src substate
   ! appears in the user export state.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_own_only_skips_propagated(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(ESMF_State) :: import_state, export_state, sub_state
      type(ESMF_Field) :: legacy(3)
      type(MultiState) :: states
      type(GraphBuilder) :: gb
      integer :: status, st_sub, export_count

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_ports_own', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))
      call add_export_port_cases(parent_meta, status)
      @assert_that(status, is(0))
      import_state = ESMF_StateCreate(name='p_import', rc=status)
      @assert_that(status, is(0))
      export_state = ESMF_StateCreate(name='p_export', rc=status)
      @assert_that(status, is(0))
      states = MultiState(importState=import_state, exportState=export_state)

      call gb%populate_state(parent_meta, states, status, own_only=.true.)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))

      call ESMF_StateGet(export_state, 'child_src', sub_state, rc=st_sub)
      call ESMF_StateGet(export_state, itemCount=export_count, rc=status)
      @assertEqual(0, status)
      @assertTrue(st_sub /= 0)
      ! PZout, Eren and PE.
      @assertEqual(3, export_count)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(src_meta)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_populate_state_own_only_skips_propagated

   ! Fills the parent user states and outer states (the ones its own
   ! parent sees) as the lifecycle does, each pass twice.
   subroutine populate_user_and_outer(parent_meta, user_states, outer_states, &
        passes, rc)
      type(OuterMetaComponent), pointer, intent(in) :: parent_meta
      type(MultiState), intent(out) :: user_states, outer_states
      integer, intent(in) :: passes
      integer, intent(out) :: rc

      type(ESMF_State) :: u_import, u_export, o_import, o_export
      type(GraphBuilder) :: gb
      integer :: status, i

      u_import = ESMF_StateCreate(name='u_import', rc=status)
      _VERIFY(status)
      u_export = ESMF_StateCreate(name='u_export', rc=status)
      _VERIFY(status)
      o_import = ESMF_StateCreate(name='o_import', rc=status)
      _VERIFY(status)
      o_export = ESMF_StateCreate(name='o_export', rc=status)
      _VERIFY(status)
      user_states = MultiState(importState=u_import, exportState=u_export)
      outer_states = MultiState(importState=o_import, exportState=o_export)
      do i = 1, passes
         call gb%populate_state(parent_meta, user_states, status)
         _VERIFY(status)
         call gb%populate_outer_state(parent_meta, outer_states, status)
         _VERIFY(status)
      end do
      rc = 0
   end subroutine populate_user_and_outer

   ! The outer states hold the very Fields of the user states: the declared
   ! export PE, the re-exported internal PZout and the re-exported export
   ! Eren on the parent, and the connected import E_conn and the unconnected
   ! import I_unconn on child_dst. Seeded to fail: with the outer populate
   ! off the outer states are empty.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_outer_state_shares_user_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GriddedComponentDriver), pointer :: dst_driver
      type(MultiState) :: user_states, outer_states, dst_user, dst_outer
      type(ESMF_State) :: u_import, o_import
      type(ESMF_Field) :: legacy(3), u_pe, o_pe, u_pz, o_pz, u_er, o_er
      type(ESMF_Field) :: u_ec, o_ec, u_iu, o_iu
      logical :: pe_same, pz_same, er_same, ec_same, iu_same
      integer :: status, st(10), sa(5)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_outer', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))
      call add_export_port_cases(parent_meta, status)
      @assert_that(status, is(0))
      call populate_user_and_outer(parent_meta, user_states, outer_states, 2, &
           status)
      @assert_that(status, is(0))

      dst_driver => dst_meta%get_user_gc_driver()
      dst_user = dst_driver%get_states()
      call populate_dst_outer(dst_meta, dst_user, dst_outer, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))

      call ESMF_StateGet(user_states%exportState, 'PE', u_pe, rc=st(1))
      call ESMF_StateGet(outer_states%exportState, 'PE', o_pe, rc=st(2))
      call ESMF_StateGet(user_states%exportState, 'PZout', u_pz, rc=st(3))
      call ESMF_StateGet(outer_states%exportState, 'PZout', o_pz, rc=st(4))
      call ESMF_StateGet(user_states%exportState, 'Eren', u_er, rc=st(5))
      call ESMF_StateGet(outer_states%exportState, 'Eren', o_er, rc=st(6))
      u_import = dst_user%importState
      o_import = dst_outer%importState
      call ESMF_StateGet(u_import, 'E_conn', u_ec, rc=st(7))
      call ESMF_StateGet(o_import, 'E_conn', o_ec, rc=st(8))
      call ESMF_StateGet(u_import, 'I_unconn', u_iu, rc=st(9))
      call ESMF_StateGet(o_import, 'I_unconn', o_iu, rc=st(10))
      @assertEqual(0, maxval(abs(st)))

      pe_same = FieldsAreAliased(u_pe, o_pe, rc=sa(1))
      pz_same = FieldsAreAliased(u_pz, o_pz, rc=sa(2))
      er_same = FieldsAreAliased(u_er, o_er, rc=sa(3))
      ec_same = FieldsAreAliased(u_ec, o_ec, rc=sa(4))
      iu_same = FieldsAreAliased(u_iu, o_iu, rc=sa(5))
      @assertEqual(0, maxval(abs(sa)))
      @assertTrue(pe_same)
      @assertTrue(pz_same)
      @assertTrue(er_same)
      @assertTrue(ec_same)
      @assertTrue(iu_same)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(src_meta)
   end subroutine test_populate_outer_state_shares_user_field

   ! Fills the user and outer import/export states of child_dst.
   subroutine populate_dst_outer(dst_meta, dst_user, dst_outer, rc)
      type(OuterMetaComponent), pointer, intent(in) :: dst_meta
      type(MultiState), intent(inout) :: dst_user
      type(MultiState), intent(out) :: dst_outer
      integer, intent(out) :: rc

      type(ESMF_State) :: o_import, o_export
      type(GraphBuilder) :: gb
      integer :: status

      o_import = ESMF_StateCreate(name='d_import', rc=status)
      _VERIFY(status)
      o_export = ESMF_StateCreate(name='d_export', rc=status)
      _VERIFY(status)
      dst_outer = MultiState(importState=o_import, exportState=o_export)
      call gb%populate_state(dst_meta, dst_user, status)
      _VERIFY(status)
      call gb%populate_outer_state(dst_meta, dst_outer, status)
      _VERIFY(status)
      rc = 0
   end subroutine populate_dst_outer

   ! A propagated child export child_src/E_conn is in the OUTER export state
   ! only, aliased to the producer Field, as legacy does; the user export
   ! state has no child_src substate. Seeded to fail: with the slash filter
   ! off the user export state gains the substate; with the outer populate
   ! off the outer state lacks it.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_outer_state_propagated_only_in_outer(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(MultiState) :: user_states, outer_states
      type(ESMF_State) :: u_sub, o_sub
      type(ESMF_Field) :: legacy(3), o_conn, o_unconn, conn_node, unconn_node
      logical :: conn_same, unconn_same
      integer :: status, st(8)

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_outer_prop', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))
      call add_export_port_cases(parent_meta, status)
      @assert_that(status, is(0))
      call populate_user_and_outer(parent_meta, user_states, outer_states, 2, &
           status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))

      call ESMF_StateGet(user_states%exportState, 'child_src', u_sub, rc=st(1))
      call ESMF_StateGet(outer_states%exportState, 'child_src', o_sub, rc=st(2))
      call ESMF_StateGet(o_sub, 'E_conn', o_conn, rc=st(3))
      call ESMF_StateGet(o_sub, 'E_unconn', o_unconn, rc=st(4))
      call get_node_field(src_meta, ESMF_STATEINTENT_EXPORT, 'E_conn', &
           conn_node, st(5))
      call get_node_field(src_meta, ESMF_STATEINTENT_EXPORT, 'E_unconn', &
           unconn_node, st(6))
      conn_same = FieldsAreAliased(o_conn, conn_node, rc=st(7))
      unconn_same = FieldsAreAliased(o_unconn, unconn_node, rc=st(8))

      @assertTrue(st(1) /= 0)
      @assertEqual(0, st(2))
      @assertEqual(0, st(3))
      @assertEqual(0, st(4))
      @assertEqual(0, st(5))
      @assertEqual(0, st(6))
      @assertEqual(0, st(7))
      @assertEqual(0, st(8))
      @assertTrue(conn_same)
      @assertTrue(unconn_same)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_populate_outer_state_propagated_only_in_outer

   ! The outer states hold only the declared and port items of the component
   ! itself: no INTERNAL item (PZ itself, only its re-export PZout), no item
   ! of a child, and no population of the child states.
   ! Seeded to fail: an outer walk that included INTERNAL items would fill
   ! the outer internal state.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_outer_state_skips_internal_and_children(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GriddedComponentDriver), pointer :: src_driver
      type(MultiState) :: outer_states, src_user
      type(ESMF_State) :: o_import, o_export, o_internal
      type(GraphBuilder) :: gb
      type(ESMF_Field) :: legacy(3), f
      type(ESMF_State) :: sub
      integer :: status, st_pz, st_e, st_ec, st_sub
      integer :: import_count, export_count, internal_count, src_export_count, child_count

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_outer_int', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))
      call add_export_port_cases(parent_meta, status)
      @assert_that(status, is(0))
      ! Only the outer populate runs, so any item in the user
      ! states of the child would come from it.
      o_import = ESMF_StateCreate(name='o_import', rc=status)
      @assert_that(status, is(0))
      o_export = ESMF_StateCreate(name='o_export', rc=status)
      @assert_that(status, is(0))
      o_internal = ESMF_StateCreate(name='o_internal', rc=status)
      @assert_that(status, is(0))
      outer_states = MultiState(importState=o_import, exportState=o_export, &
           internalState=o_internal)
      call gb%populate_outer_state(parent_meta, outer_states, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))

      call ESMF_StateGet(outer_states%exportState, 'PZ', f, rc=st_pz)
      call ESMF_StateGet(outer_states%exportState, 'E_unconn', f, rc=st_e)
      call ESMF_StateGet(outer_states%exportState, 'E_conn', f, rc=st_ec)
      call ESMF_StateGet(outer_states%exportState, 'child_src', sub, rc=st_sub)
      call ESMF_StateGet(sub, itemCount=child_count, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(outer_states%importState, itemCount=import_count, &
           rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(outer_states%exportState, itemCount=export_count, &
           rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(o_internal, itemCount=internal_count, rc=status)
      @assertEqual(0, status)
      src_driver => src_meta%get_user_gc_driver()
      src_user = src_driver%get_states()
      call ESMF_StateGet(src_user%exportState, itemCount=src_export_count, &
           rc=status)
      @assertEqual(0, status)

      @assertTrue(st_pz /= 0)
      @assertTrue(st_e /= 0)
      @assertTrue(st_ec /= 0)
      @assertEqual(0, st_sub)
      ! The parent declares no import. PZout, Eren, PE and the child_src
      ! substate in the export state.
      @assertEqual(0, import_count)
      @assertEqual(4, export_count)
      ! E_unconn, E_conn: the two propagated child exports (Z is internal).
      @assertEqual(2, child_count)
      ! Z and PZ are INTERNAL: no internal item reaches the outer states.
      @assertEqual(0, internal_count)
      ! The parent walk never fills the user states of a child.
      @assertEqual(0, src_export_count)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_populate_outer_state_skips_internal_and_children

   ! The outer populate adds nothing with the switch off or in BOTH mode:
   ! legacy add_to_states fills the outer states there.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_outer_state_off_in_hybrid_and_both(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(MultiState) :: user_states, outer_states
      type(ESMF_Field) :: legacy(3)
      integer :: status, off_count, both_count

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_outer_off', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))
      call add_export_port_cases(parent_meta, status)
      @assert_that(status, is(0))

      call set_graph_owns_user_states(.false.)
      call populate_user_and_outer(parent_meta, user_states, outer_states, 2, &
           status)
      @assert_that(status, is(0))
      call ESMF_StateGet(outer_states%exportState, itemCount=off_count, &
           rc=status)
      @assertEqual(0, status)

      call set_graph_mode(GRAPH_MODE_BOTH)
      call set_graph_owns_user_states(.true.)
      call populate_user_and_outer(parent_meta, user_states, outer_states, 2, &
           status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))
      call ESMF_StateGet(outer_states%exportState, itemCount=both_count, &
           rc=status)
      @assertEqual(0, status)

      @assertEqual(0, off_count)
      @assertEqual(0, both_count)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(src_meta)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_populate_outer_state_off_in_hybrid_and_both

   ! Calling the outer populate again changes nothing: same item counts and
   ! the same Fields. Seeded to fail: an outer fill that added instead of
   ! replacing would raise the counts or fail on a duplicate name.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_outer_state_idempotent(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(MultiState) :: user_states, outer_states
      type(ESMF_State) :: sub
      type(ESMF_Field) :: legacy(3), before, after
      type(GraphBuilder) :: gb
      logical :: same
      integer :: status, st(6), count_before, count_after, sub_before, sub_after

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_outer_idem', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))
      call add_export_port_cases(parent_meta, status)
      @assert_that(status, is(0))
      call populate_user_and_outer(parent_meta, user_states, outer_states, 1, &
           status)
      @assert_that(status, is(0))
      call ESMF_StateGet(outer_states%exportState, itemCount=count_before, &
           rc=st(1))
      call ESMF_StateGet(outer_states%exportState, 'child_src', sub, rc=st(2))
      call ESMF_StateGet(sub, itemCount=sub_before, rc=st(3))
      call ESMF_StateGet(outer_states%exportState, 'PE', before, rc=st(4))

      call gb%populate_outer_state(parent_meta, outer_states, status)
      call gb%populate_outer_state(parent_meta, outer_states, rc=st(5))
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))
      @assert_that(st(5), is(0))

      call ESMF_StateGet(outer_states%exportState, itemCount=count_after, &
           rc=st(1))
      call ESMF_StateGet(outer_states%exportState, 'child_src', sub, rc=st(2))
      call ESMF_StateGet(sub, itemCount=sub_after, rc=st(3))
      call ESMF_StateGet(outer_states%exportState, 'PE', after, rc=st(4))
      same = FieldsAreAliased(before, after, rc=st(6))
      @assertEqual(0, maxval(abs(st)))
      @assertEqual(count_before, count_after)
      @assertEqual(sub_before, sub_after)
      @assertTrue(same)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(src_meta)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_populate_outer_state_idempotent

   ! (d) REGISTRY mode: advertise creates no Field, so population finds
   ! nothing for the INTERNAL item or the unconnected EXPORT.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_field_per_node_registry_unchanged(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(ESMF_State) :: internal_state, export_state, import_state
      type(MultiState) :: src_states
      integer :: status, internal_count, export_count, kinds_found, i
      type(GraphBuilder) :: gb
      type(ESMF_Field) :: legacy(3)
      type(ComponentGraph), pointer :: src_graph
      type(NodeId), pointer :: id_ptr
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: payload
      type(ESMF_StateIntent_Flag) :: intents(2)
      character(len=8) :: names(2)

      intents = [ESMF_STATEINTENT_INTERNAL, ESMF_STATEINTENT_EXPORT]
      names = ['Z       ', 'E_unconn']
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call make_field_per_node_fixture('comp_parent_fpn_reg', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))

      internal_state = ESMF_StateCreate(name='internal', rc=status)
      @assertEqual(0, status)
      export_state = ESMF_StateCreate(name='export', rc=status)
      @assertEqual(0, status)
      import_state = ESMF_StateCreate(name='import', rc=status)
      @assertEqual(0, status)
      src_states = MultiState(importState=import_state, &
           exportState=export_state, internalState=internal_state)

      ! Registry mode: populate is a no-op, and the nodes hold no Field.
      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call gb%populate_state(src_meta, src_states, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))

      call ESMF_StateGet(internal_state, itemCount=internal_count, rc=status)
      @assertEqual(0, status)
      call ESMF_StateGet(export_state, itemCount=export_count, rc=status)
      @assertEqual(0, status)
      src_graph => src_meta%get_component_graph()
      kinds_found = 0
      do i = 1, size(names)
         id_ptr => src_graph%get_resource_index(item_key(intents(i), &
              trim(names(i))))
         @assertTrue(associated(id_ptr))
         node => src_graph%get_node(id_ptr)
         select type (node)
         class is (StateItemNode)
            payload = node%get_payload()
         class default
            @assert_that(.false., is(true()))
         end select
         if (payload%itemType() == ESMF_STATEITEM_FIELD) then
            kinds_found = kinds_found + 1
         end if
      end do
      @assertEqual(0, internal_count)
      @assertEqual(0, export_count)
      @assertEqual(0, kinds_found)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(parent_meta)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_populate_state_field_per_node_registry_unchanged

   ! Reads the Field a node holds as its payload.
   subroutine get_node_field(meta, intent, name, field, rc)
      type(OuterMetaComponent), pointer, intent(in) :: meta
      type(ESMF_StateIntent_Flag), intent(in) :: intent
      character(*), intent(in) :: name
      type(ESMF_Field), intent(out) :: field
      integer, intent(out) :: rc

      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: id_ptr
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: payload

      rc = -1
      graph => meta%get_component_graph()
      id_ptr => graph%get_resource_index(item_key(intent, name))
      if (.not. associated(id_ptr)) return
      node => graph%get_node(id_ptr)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
         field = payload%get_field(rc=rc)
      end select
   end subroutine get_node_field

   ! Builds one component with an internal Z, an export E, an import I and a
   ! qualified import A/X, advertised in GRAPH mode and not connected. The
   ! caller sets graph mode and the switch first: advertise reads them.
   subroutine make_advertise_population_fixture(name, meta, states, rc)
      character(*), intent(in) :: name
      type(OuterMetaComponent), pointer, intent(out) :: meta
      type(MultiState), intent(out) :: states
      integer, intent(out) :: rc

      type(ESMF_GridComp) :: gc
      type(ComponentSpec), pointer :: spec
      type(VariableSpec) :: var_spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      type(ESMF_State) :: import_state, export_state, internal_state
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      _VERIFY(status)
      geom = ESMF_GeomCreate(grid, rc=status)
      _VERIFY(status)
      call GeomSetId(geom, 311, rc=status)
      _VERIFY(status)

      call make_outer_meta(name, gc, meta, _RC)
      spec => meta%get_component_spec()
      var_spec = make_var(ESMF_STATEINTENT_INTERNAL, 'Z', units='m')
      var_spec%geom = geom
      call spec%add_var_spec(var_spec)
      var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'E', units='K')
      var_spec%geom = geom
      var_spec%standard_name = 'air_temperature'
      var_spec%long_name = 'Air temperature'
      call spec%add_var_spec(var_spec)
      var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'I', units='K')
      var_spec%geom = geom
      call spec%add_var_spec(var_spec)
      var_spec = make_var(ESMF_STATEINTENT_IMPORT, 'A/X', units='m')
      var_spec%geom = geom
      call spec%add_var_spec(var_spec)

      call gb%advertise(meta, _RC)

      import_state = ESMF_StateCreate(name='import', rc=status)
      _VERIFY(status)
      export_state = ESMF_StateCreate(name='export', rc=status)
      _VERIFY(status)
      internal_state = ESMF_StateCreate(name='internal', rc=status)
      _VERIFY(status)
      states = MultiState(importState=import_state, exportState=export_state, &
           internalState=internal_state)

      rc = 0
   end subroutine make_advertise_population_fixture

   ! Everything the advertise-time populate needs to be checked on: the
   ! items in the three user states, what each holds, and the export node.
   subroutine read_advertise_population(meta, states, snapshot, rc)
      type(OuterMetaComponent), pointer, intent(in) :: meta
      type(MultiState), intent(inout) :: states
      type(AdvertisePopulationSnapshot), intent(out) :: snapshot
      integer, intent(out) :: rc

      type(ESMF_Field) :: z_field, e_field, i_field, x_field, e_node
      type(ESMF_State) :: a_state
      type(MAPL_StateItemAllocation) :: z_alloc, e_alloc, i_alloc
      integer :: status, st(8)

      st = 0
      call ESMF_StateGet(states%internalState, 'Z', z_field, rc=st(1))
      call ESMF_StateGet(states%exportState, 'E', e_field, rc=st(2))
      call ESMF_StateGet(states%importState, 'I', i_field, rc=st(3))
      call ESMF_StateGet(states%importState, 'A', a_state, rc=st(4))
      call ESMF_StateGet(a_state, 'X', x_field, rc=st(5))
      call get_node_field(meta, ESMF_STATEINTENT_EXPORT, 'E', e_node, st(6))
      call ESMF_StateGet(states%importState, itemCount=snapshot%import_count, &
           rc=st(7))
      call ESMF_StateGet(states%exportState, itemCount=snapshot%export_count, &
           rc=st(8))
      if (any(st /= 0)) then
         rc = maxval(abs(st))
         return
      end if

      call get_allocation_status(z_field, z_alloc, st(1))
      call get_allocation_status(e_field, e_alloc, st(2))
      call get_allocation_status(i_field, i_alloc, st(3))
      snapshot%z_created = (z_alloc == MAPL_STATEITEM_ALLOCATION_CREATED)
      snapshot%e_created = (e_alloc == MAPL_STATEITEM_ALLOCATION_CREATED)
      snapshot%i_created = (i_alloc == MAPL_STATEITEM_ALLOCATION_CREATED)
      call MAPL_FieldGet(e_field, units=snapshot%e_units, &
           standard_name=snapshot%e_standard_name, &
           long_name=snapshot%e_long_name, rc=st(4))
      call MAPL_FieldGet(i_field, units=snapshot%i_units, rc=st(5))
      call MAPL_FieldGet(x_field, units=snapshot%x_units, rc=st(6))
      snapshot%e_is_node_field = FieldsAreAliased(e_field, e_node, rc=st(7))
      call ESMF_FieldGet(x_field, name=snapshot%x_name, rc=st(8))
      call ESMF_StateGet(a_state, itemCount=snapshot%a_count, rc=status)
      st(1) = max(abs(st(1)), abs(status))
      rc = maxval(abs(st))
   end subroutine read_advertise_population

   ! GRAPH mode, switch on: the own-only populate at advertise puts the own
   ! created Field of each declared item in the user states, before any
   ! connection: the internal created and not allocated, the export created
   ! with units, standard name and long name readable, the import its own
   ! created Field, and the qualified import A/X as X in substate A. A later
   ! full populate (the accept_transfer one) leaves the item counts and the
   ! export Field as they were and the units unchanged.
   ! Seeded to fail: with the own-only populate off the states are empty;
   ! with the descriptive keys off the units read back unknown.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_own_only_at_advertise(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(MultiState) :: states
      type(AdvertisePopulationSnapshot) :: early, late
      integer :: status, status_early, status_late
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_advertise_population_fixture('comp_adv_pop', meta, states, &
           status)
      @assert_that(status, is(0))

      call gb%populate_state(meta, states, status, own_only=.true.)
      @assert_that(status, is(0))
      call read_advertise_population(meta, states, early, status_early)

      ! The accept_transfer populate, twice (it runs twice).
      call gb%populate_state(meta, states, status)
      @assert_that(status, is(0))
      call gb%populate_state(meta, states, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))
      call read_advertise_population(meta, states, late, status_late)

      @assertEqual(0, status_early)
      @assertEqual(0, status_late)
      @assertTrue(early%z_created)
      @assertTrue(early%e_created)
      @assertTrue(early%i_created)
      @assertEqual('K', early%e_units)
      @assertEqual('air_temperature', early%e_standard_name)
      @assertEqual('Air temperature', early%e_long_name)
      @assertEqual('K', early%i_units)
      @assertEqual('m', early%x_units)
      @assertEqual('X', trim(early%x_name))
      @assertEqual(2, early%import_count)
      @assertEqual(1, early%a_count)
      @assertEqual(1, early%export_count)
      @assertTrue(early%e_is_node_field)

      ! Repeating at accept_transfer: same export Field, same units, same
      ! counts. The internal is now completed, so it is no longer created.
      @assertTrue(late%e_is_node_field)
      @assertEqual('K', late%e_units)
      @assertEqual('air_temperature', late%e_standard_name)
      @assertEqual('Air temperature', late%e_long_name)
      @assertEqual('K', late%i_units)
      @assertEqual('m', late%x_units)
      @assertEqual(early%import_count, late%import_count)
      @assertEqual(early%export_count, late%export_count)
      @assertEqual(early%a_count, late%a_count)
      @assertFalse(late%z_created)

      _UNUSED_DUMMY(this)
   end subroutine test_populate_state_own_only_at_advertise

   ! Switch OFF: the own-only populate is a no-op. Nothing is inserted into
   ! the user states, and the Fields the graph created at advertise stay
   ! undescribed: no units are written onto them (legacy owns those Fields
   ! when the switch is off).
   ! Seeded to fail: an own-only populate that ignored the switch writes the
   ! declared units onto the export and import Fields.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_own_only_off_changes_nothing(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: meta
      type(MultiState) :: states
      type(ESMF_Field) :: e_node, i_node
      character(:), allocatable :: e_units, i_units
      integer :: status, import_count, export_count, internal_count
      integer :: st_i, st_e, st_z, st_en, st_in, st_eu, st_iu
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.false.)
      call make_advertise_population_fixture('comp_adv_pop_off', meta, &
           states, status)
      @assert_that(status, is(0))

      call gb%populate_state(meta, states, status, own_only=.true.)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      @assert_that(status, is(0))

      call ESMF_StateGet(states%importState, itemCount=import_count, rc=st_i)
      call ESMF_StateGet(states%exportState, itemCount=export_count, rc=st_e)
      call ESMF_StateGet(states%internalState, itemCount=internal_count, &
           rc=st_z)
      call get_node_field(meta, ESMF_STATEINTENT_EXPORT, 'E', e_node, st_en)
      call get_node_field(meta, ESMF_STATEINTENT_IMPORT, 'I', i_node, st_in)
      @assertEqual(0, st_i)
      @assertEqual(0, st_e)
      @assertEqual(0, st_z)
      @assertEqual(0, st_en)
      @assertEqual(0, st_in)
      call MAPL_FieldGet(e_node, units=e_units, rc=st_eu)
      call MAPL_FieldGet(i_node, units=i_units, rc=st_iu)
      @assertEqual(0, st_eu)
      @assertEqual(0, st_iu)
      @assertEqual(0, import_count)
      @assertEqual(0, export_count)
      @assertEqual(0, internal_count)
      ! No declared units reached the graph-created Fields.
      @assertFalse(allocated(e_units))
      @assertFalse(allocated(i_units))

      _UNUSED_DUMMY(this)
   end subroutine test_populate_state_own_only_off_changes_nothing

   ! Three levels, switch on, population in lifecycle order (children
   ! first). P declares MID and SRC; MID declares DST and SRC2. P connects
   ! SRC.T to MID/DST.T (a grandchild import: the edge is in P only); MID
   ! connects SRC2.X to DST.X (the edge is in MID only). After MID then P
   ! have populated, DST holds the producer Field for T (reached from P
   ! through the descendant walk) and still holds SRC2 Field for X: the P
   ! pass sees no producer for X in its own network and must not replace it
   ! with an own created Field.
   ! Seeded to fail: with the walk limited to direct children, T is absent
   ! from DST; with the no-fallback rule off, X is no longer SRC2 Field.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_reaches_grandchild_without_replacing(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: p_meta, mid_meta, src_meta
      type(OuterMetaComponent), pointer :: src2_meta, dst_meta
      type(GriddedComponentDriver), pointer :: dst_own_driver
      type(MultiState) :: dst_states, p_states, mid_states
      type(ESMF_Field) :: t_state, x_state, t_node, x_node
      logical :: t_same, x_same
      integer :: status, st(6)
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_three_level_fixture(p_meta, mid_meta, src_meta, src2_meta, &
           dst_meta, status)
      @assert_that(status, is(0))

      p_states = make_plain_states('p')
      mid_states = make_plain_states('mid')
      call gb%populate_state(mid_meta, mid_states, status)
      @assert_that(status, is(0))
      call gb%populate_state(p_meta, p_states, status)
      @assert_that(status, is(0))
      call gb%populate_state(p_meta, p_states, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))

      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_states = dst_own_driver%get_states()
      call ESMF_StateGet(dst_states%importState, 'T', t_state, rc=st(1))
      call ESMF_StateGet(dst_states%importState, 'X', x_state, rc=st(2))
      call get_node_field(src_meta, ESMF_STATEINTENT_EXPORT, 'T', t_node, st(3))
      call get_node_field(src2_meta, ESMF_STATEINTENT_EXPORT, 'X', x_node, &
           st(4))
      t_same = FieldsAreAliased(t_state, t_node, rc=st(5))
      x_same = FieldsAreAliased(x_state, x_node, rc=st(6))
      @assertEqual(0, st(1))
      @assertEqual(0, st(2))
      @assertEqual(0, st(3))
      @assertEqual(0, st(4))
      @assertEqual(0, st(5))
      @assertEqual(0, st(6))
      @assertTrue(t_same)
      @assertTrue(x_same)

      _UNUSED_DUMMY(this)
   end subroutine test_populate_state_reaches_grandchild_without_replacing

   function make_plain_states(prefix) result(states)
      character(*), intent(in) :: prefix
      type(MultiState) :: states

      type(ESMF_State) :: import_state, export_state, internal_state
      integer :: status

      import_state = ESMF_StateCreate(name=prefix // '_import', rc=status)
      export_state = ESMF_StateCreate(name=prefix // '_export', rc=status)
      internal_state = ESMF_StateCreate(name=prefix // '_internal', rc=status)
      states = MultiState(importState=import_state, exportState=export_state, &
           internalState=internal_state)
   end function make_plain_states

   ! P holds SRC (export T) and MID; MID holds SRC2 (export X) and DST
   ! (imports T and X). Advertised deepest first, connections resolved MID
   ! then P, as the lifecycle does.
   subroutine make_three_level_fixture(p_meta, mid_meta, src_meta, &
        src2_meta, dst_meta, rc)
      type(OuterMetaComponent), pointer, intent(out) :: p_meta, mid_meta
      type(OuterMetaComponent), pointer, intent(out) :: src_meta, src2_meta
      type(OuterMetaComponent), pointer, intent(out) :: dst_meta
      integer, intent(out) :: rc

      type(ESMF_GridComp) :: p_gc, gc
      type(GriddedComponentDriver) :: driver
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: spec
      type(MatchConnection) :: conn
      type(GraphResolutionEntryVector) :: unresolved
      type(VariableSpec) :: var_spec
      type(ESMF_Grid) :: grid
      type(ESMF_Geom) :: geom
      integer :: status
      type(GraphBuilder) :: gb

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[2,2], rc=status)
      _VERIFY(status)
      geom = ESMF_GeomCreate(grid, rc=status)
      _VERIFY(status)
      call GeomSetId(geom, 312, rc=status)
      _VERIFY(status)

      call make_outer_meta('comp_three_level_p', p_gc, p_meta, _RC)
      child_spec = ChildSpec()
      call p_meta%add_child('SRC', child_spec, _RC)
      child_spec = ChildSpec()
      call p_meta%add_child('MID', child_spec, _RC)
      driver = p_meta%get_child('SRC', _RC)
      gc = driver%get_gridcomp()
      src_meta => get_outer_meta(gc, _RC)
      driver = p_meta%get_child('MID', _RC)
      gc = driver%get_gridcomp()
      mid_meta => get_outer_meta(gc, _RC)

      child_spec = ChildSpec()
      call mid_meta%add_child('SRC2', child_spec, _RC)
      child_spec = ChildSpec()
      call mid_meta%add_child('DST', child_spec, _RC)
      driver = mid_meta%get_child('SRC2', _RC)
      gc = driver%get_gridcomp()
      src2_meta => get_outer_meta(gc, _RC)
      driver = mid_meta%get_child('DST', _RC)
      gc = driver%get_gridcomp()
      dst_meta => get_outer_meta(gc, _RC)

      spec => src_meta%get_component_spec()
      var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'T', units='m')
      var_spec%geom = geom
      call spec%add_var_spec(var_spec)
      spec => src2_meta%get_component_spec()
      var_spec = make_var(ESMF_STATEINTENT_EXPORT, 'X', units='m')
      var_spec%geom = geom
      call spec%add_var_spec(var_spec)
      spec => dst_meta%get_component_spec()
      call spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T', units='m'))
      call spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'X', units='m'))

      call gb%advertise(src_meta, _RC)
      call gb%advertise(src2_meta, _RC)
      call gb%advertise(dst_meta, _RC)
      call gb%advertise(mid_meta, _RC)
      call gb%advertise(p_meta, _RC)

      conn = MatchConnection( &
           ConnectionPt('SRC2', VirtualConnectionPt(state_intent='export', &
           short_name='X')), &
           ConnectionPt('DST', VirtualConnectionPt(state_intent='import', &
           short_name='X')))
      spec => mid_meta%get_component_spec()
      call spec%add_connection(conn)
      call gb%resolve_connections(mid_meta, unresolved_imports=unresolved, &
           _RC)

      conn = MatchConnection( &
           ConnectionPt('SRC', VirtualConnectionPt(state_intent='export', &
           short_name='T')), &
           ConnectionPt('MID/DST', VirtualConnectionPt(state_intent='import', &
           short_name='T')))
      spec => p_meta%get_component_spec()
      call spec%add_connection(conn)
      call gb%resolve_connections(p_meta, unresolved_imports=unresolved, _RC)

      rc = 0
   end subroutine make_three_level_fixture

   ! Switch OFF (production): legacy has filled the user states. Population
   ! must leave legacy Fields where they are: INTERNAL is not touched, a
   ! created-only export does not replace legacy's, and the connected export
   ! is an alias of legacy's Field (the graph Field made at advertise is not
   ! what the state holds). Seeded to fail: a populate that replaced legacy
   ! Fields makes the unconnected export or Z differ from the legacy Field.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_populate_state_switch_off_keeps_legacy_fields(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GriddedComponentDriver), pointer :: src_own_driver
      type(MultiState) :: src_states, parent_states
      type(ESMF_State) :: p_import, p_export
      type(ESMF_Field) :: legacy(3), z_field, unconn_field, conn_field, &
           node_conn
      logical :: z_same, unconn_same, conn_same, payload_same
      integer :: status, st_z, st_u, st_c, st_n, st_a, st_b, st_d, st_e
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.false.)
      call make_field_per_node_fixture('comp_parent_fpn_off', parent_meta, &
           src_meta, dst_meta, .true., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))

      p_import = ESMF_StateCreate(name='p_import', rc=status)
      @assertEqual(0, status)
      p_export = ESMF_StateCreate(name='p_export', rc=status)
      @assertEqual(0, status)
      parent_states = MultiState(importState=p_import, exportState=p_export)
      src_own_driver => src_meta%get_user_gc_driver()
      src_states = src_own_driver%get_states()

      ! The advertise-time own-only populate does nothing with the switch off.
      call gb%populate_state(src_meta, src_states, status, own_only=.true.)
      @assert_that(status, is(0))
      call gb%populate_state(parent_meta, parent_states, status)
      @assert_that(status, is(0))
      call gb%populate_state(src_meta, src_states, status)
      @assert_that(status, is(0))
      call set_graph_mode(GRAPH_MODE_REGISTRY)

      call ESMF_StateGet(src_states%internalState, 'Z', z_field, rc=st_z)
      call ESMF_StateGet(src_states%exportState, 'E_unconn', unconn_field, &
           rc=st_u)
      call ESMF_StateGet(src_states%exportState, 'E_conn', conn_field, rc=st_c)
      call get_node_field(src_meta, ESMF_STATEINTENT_EXPORT, 'E_conn', &
           node_conn, st_n)
      z_same = FieldsAreAliased(legacy(3), z_field, rc=st_a)
      unconn_same = FieldsAreAliased(legacy(1), unconn_field, rc=st_b)
      conn_same = FieldsAreAliased(legacy(2), conn_field, rc=st_d)
      payload_same = FieldsAreAliased(legacy(2), node_conn, rc=st_e)
      @assertEqual(0, st_z)
      @assertEqual(0, st_u)
      @assertEqual(0, st_c)
      @assertEqual(0, st_n)
      @assertEqual(0, st_a)
      @assertEqual(0, st_b)
      @assertEqual(0, st_d)
      @assertEqual(0, st_e)
      @assertTrue(z_same)
      @assertTrue(unconn_same)
      @assertTrue(conn_same)
      ! Off: the connected export node aliases legacy Field, as before.
      @assertTrue(payload_same)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_populate_state_switch_off_keeps_legacy_fields

   ! Switch ON: nothing to alias even if a Field of that name is already in
   ! the producer state. The connected export node keeps its own Field,
   ! completed in place (ALLOCATED, not an alias of the other one).
   ! Seeded to fail: aliasing as with the switch off makes it the same Field.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_connected_export_not_aliased_when_graph_owns_states(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(ESMF_Field) :: legacy(3), node_conn
      type(MAPL_StateItemAllocation) :: node_alloc
      logical :: same
      integer :: status, st_n, st_a, st_s

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_fpn_on', parent_meta, &
           src_meta, dst_meta, .true., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      call get_node_field(src_meta, ESMF_STATEINTENT_EXPORT, 'E_conn', &
           node_conn, st_n)
      call get_allocation_status(node_conn, node_alloc, st_a)
      same = FieldsAreAliased(legacy(2), node_conn, rc=st_s)
      @assertEqual(0, st_n)
      @assertEqual(0, st_a)
      @assertEqual(0, st_s)
      @assertTrue(node_alloc == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertFalse(same)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(parent_meta)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_connected_export_not_aliased_when_graph_owns_states

   ! An import whose producer Field is only created (the connection could
   ! not complete it) is not fed it: the created Field is no producer, so
   ! the import falls back to its own created Field.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_import_not_fed_a_created_only_export_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GriddedComponentDriver), pointer :: dst_own_driver
      type(MultiState) :: dst_states, parent_states
      type(ESMF_State) :: p_import, p_export
      type(ESMF_Field) :: legacy(3)
      type(ComponentGraph), pointer :: src_graph
      type(NodeId), pointer :: id_ptr
      class(GraphNode), pointer :: node
      type(StateItemNode), pointer :: item
      integer :: status, st_f
      type(ESMF_Field) :: import_field
      logical :: fed_producer
      type(GraphBuilder) :: gb
      type(GraphStateItem) :: empty_payload

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_fpn_imp', parent_meta, &
           src_meta, dst_meta, .false., &
           MAPL_STATEITEM_ALLOCATION_ACTIVE, legacy, status)
      @assert_that(status, is(0))

      ! Put the producer back to created-only: a fresh Field, no allocation.
      src_graph => src_meta%get_component_graph()
      id_ptr => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, &
           'E_conn'))
      @assertTrue(associated(id_ptr))
      node => src_graph%get_node(id_ptr)
      select type (node)
      class is (StateItemNode)
         item => node
         empty_payload = item%get_payload()
      end select
      legacy(2) = ESMF_FieldEmptyCreate(name='E_conn', rc=status)
      @assertEqual(0, status)
      call MAPL_FieldSet(legacy(2), &
           allocation_status=MAPL_STATEITEM_ALLOCATION_CREATED, rc=status)
      @assertEqual(0, status)
      call empty_payload%set(legacy(2), rc=status)
      @assertEqual(0, status)
      call item%set_payload(empty_payload)

      p_import = ESMF_StateCreate(name='p_import', rc=status)
      @assertEqual(0, status)
      p_export = ESMF_StateCreate(name='p_export', rc=status)
      @assertEqual(0, status)
      parent_states = MultiState(importState=p_import, exportState=p_export)
      call gb%populate_state(parent_meta, parent_states, status)
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)
      @assert_that(status, is(0))

      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_states = dst_own_driver%get_states()
      call ESMF_StateGet(dst_states%importState, 'E_conn', import_field, &
           rc=status)
      @assertEqual(0, status)
      fed_producer = FieldsAreAliased(legacy(2), import_field, rc=st_f)
      @assertEqual(0, st_f)
      @assertFalse(fed_producer)

      _UNUSED_DUMMY(this)
   end subroutine test_import_not_fed_a_created_only_export_field

   ! Switch OFF, but the Field legacy aliased is still marked CREATED in its
   ! Info (legacy writes the same status key). The node holds an alias of it,
   ! which is not a graph-created Field: it is not treated as created-only,
   ! so population still passes legacy Fields through, and the import
   ! is fed that Field as at HEAD. Pins the alias-id check.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_legacy_field_marked_created_is_not_graph_created(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GriddedComponentDriver), pointer :: dst_own_driver
      type(MultiState) :: dst_states, parent_states
      type(ESMF_State) :: p_import, p_export
      type(ESMF_Field) :: legacy(3), node_conn, import_field
      type(ComponentGraph), pointer :: src_graph
      type(NodeId), pointer :: id_ptr
      logical :: payload_aliased, import_aliased, is_created
      integer :: status, st_n, st_i, st_a, st_b
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call make_field_per_node_fixture('comp_parent_fpn_s1', parent_meta, &
           src_meta, dst_meta, .true., MAPL_STATEITEM_ALLOCATION_CREATED, &
           legacy, status)
      @assert_that(status, is(0))

      p_import = ESMF_StateCreate(name='p_import', rc=status)
      @assertEqual(0, status)
      p_export = ESMF_StateCreate(name='p_export', rc=status)
      @assertEqual(0, status)
      parent_states = MultiState(importState=p_import, exportState=p_export)
      call gb%populate_state(parent_meta, parent_states, status)
      @assert_that(status, is(0))
      call set_graph_mode(GRAPH_MODE_REGISTRY)

      call get_node_field(src_meta, ESMF_STATEINTENT_EXPORT, 'E_conn', &
           node_conn, st_n)
      payload_aliased = FieldsAreAliased(legacy(2), node_conn, rc=st_a)
      src_graph => src_meta%get_component_graph()
      id_ptr => src_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, &
           'E_conn'))
      is_created = field_extension_is_created(src_graph, id_ptr)
      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_states = dst_own_driver%get_states()
      call ESMF_StateGet(dst_states%importState, 'E_conn', import_field, &
           rc=st_i)
      import_aliased = FieldsAreAliased(legacy(2), import_field, rc=st_b)
      @assertEqual(0, st_n)
      @assertEqual(0, st_a)
      @assertEqual(0, st_i)
      @assertEqual(0, st_b)
      @assertTrue(payload_aliased)
      @assertFalse(is_created)
      @assertTrue(import_aliased)

      _UNUSED_DUMMY(this)
   end subroutine test_legacy_field_marked_created_is_not_graph_created

   ! At REALIZE_ACCEPTED (switch ON) an INTERNAL Field whose descriptor is
   ! complete is allocated; one still incomplete stays created. Seeded to
   ! fail: with the hook a no-op Z stays CREATED.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_allocate_internals_hook_completes_only_complete(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(ESMF_Field) :: legacy(3), z_field, zdef_field
      type(MAPL_StateItemAllocation) :: z_alloc, zdef_alloc
      integer :: status, st_z, st_d, st_za, st_da
      type(GraphBuilder) :: gb
      type(ComponentGraph), pointer :: src_graph
      type(NodeId), pointer :: id_ptr
      class(GraphNode), pointer :: node
      type(StateItemDescriptor), pointer :: descriptor

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_fpn_alloc', parent_meta, &
           src_meta, dst_meta, .false., MAPL_STATEITEM_ALLOCATION_ACTIVE, &
           legacy, status)
      @assert_that(status, is(0))

      ! Make Zdef incomplete: a geometry with no value yet.
      src_graph => src_meta%get_component_graph()
      id_ptr => src_graph%get_resource_index( &
           item_key(ESMF_STATEINTENT_INTERNAL, 'Zdef'))
      @assertTrue(associated(id_ptr))
      node => src_graph%get_node(id_ptr)
      select type (node)
      class is (StateItemNode)
         descriptor => node%get_descriptor()
      class default
         @assert_that(.false., is(true()))
      end select
      call descriptor%set_characteristic(GEOMETRY_CHARACTERISTIC_KIND, &
           GeometryCharacteristic(), rc=status)
      @assert_that(status, is(0))
      @assertTrue(size(descriptor%get_incomplete_kinds()) > 0)

      call gb%allocate_internals(src_meta, status)
      @assert_that(status, is(0))
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      call get_node_field(src_meta, ESMF_STATEINTENT_INTERNAL, 'Z', z_field, &
           st_z)
      call get_node_field(src_meta, ESMF_STATEINTENT_INTERNAL, 'Zdef', &
           zdef_field, st_d)
      call get_allocation_status(z_field, z_alloc, st_za)
      call get_allocation_status(zdef_field, zdef_alloc, st_da)
      @assertEqual(0, st_z)
      @assertEqual(0, st_d)
      @assertEqual(0, st_za)
      @assertEqual(0, st_da)
      @assertTrue(z_alloc == MAPL_STATEITEM_ALLOCATION_ALLOCATED)
      @assertTrue(zdef_alloc == MAPL_STATEITEM_ALLOCATION_CREATED)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(parent_meta)
      _UNUSED_DUMMY(dst_meta)
   end subroutine test_allocate_internals_hook_completes_only_complete

   ! An import with a producer is fed the producer Field; its own Field made
   ! at advertise stays on its node, created and in no state.
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_import_with_producer_gets_producer_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta, dst_meta
      type(GriddedComponentDriver), pointer :: dst_own_driver
      type(MultiState) :: dst_states, parent_states
      type(ESMF_State) :: p_import, p_export
      type(ESMF_Field) :: legacy(3), producer, import_field, own_import
      type(MAPL_StateItemAllocation) :: own_alloc
      logical :: fed_producer, own_is_in_state
      integer :: status, st_p, st_i, st_o, st_a, st_f, st_g
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call set_graph_owns_user_states(.true.)
      call make_field_per_node_fixture('comp_parent_fpn_prod', parent_meta, &
           src_meta, dst_meta, .false., MAPL_STATEITEM_ALLOCATION_ACTIVE, &
           legacy, status)
      @assert_that(status, is(0))

      p_import = ESMF_StateCreate(name='p_import', rc=status)
      @assertEqual(0, status)
      p_export = ESMF_StateCreate(name='p_export', rc=status)
      @assertEqual(0, status)
      parent_states = MultiState(importState=p_import, exportState=p_export)
      call gb%populate_state(parent_meta, parent_states, status)
      @assert_that(status, is(0))
      call set_graph_mode(GRAPH_MODE_REGISTRY)
      call set_graph_owns_user_states(.false.)

      call get_node_field(src_meta, ESMF_STATEINTENT_EXPORT, 'E_conn', &
           producer, st_p)
      call get_node_field(dst_meta, ESMF_STATEINTENT_IMPORT, 'E_conn', &
           own_import, st_o)
      dst_own_driver => dst_meta%get_user_gc_driver()
      dst_states = dst_own_driver%get_states()
      call ESMF_StateGet(dst_states%importState, 'E_conn', import_field, &
           rc=st_i)
      fed_producer = FieldsAreAliased(producer, import_field, rc=st_f)
      own_is_in_state = FieldsAreAliased(own_import, import_field, rc=st_g)
      call get_allocation_status(own_import, own_alloc, st_a)
      @assertEqual(0, st_p)
      @assertEqual(0, st_o)
      @assertEqual(0, st_i)
      @assertEqual(0, st_f)
      @assertEqual(0, st_g)
      @assertEqual(0, st_a)
      @assertTrue(fed_producer)
      @assertFalse(own_is_in_state)
      @assertTrue(own_alloc == MAPL_STATEITEM_ALLOCATION_CREATED)

      _UNUSED_DUMMY(this)
      _UNUSED_DUMMY(src_meta)
   end subroutine test_import_with_producer_gets_producer_field

end module Test_GraphBuilderMaterializeGate
