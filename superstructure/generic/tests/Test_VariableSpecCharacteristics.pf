   @test
   subroutine test_mirror_horizontal_dims_spec_on_export_is_an_error()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%horizontal_dims_spec = HORIZONTAL_DIMS_MIRROR
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression: X (HORIZONTAL_DIMS_SPEC)')
      @assertExceptionRaised('status=1')
   end subroutine test_mirror_horizontal_dims_spec_on_export_is_an_error

   ! A mirror_geom request on a NONE item is moot: its geometry is not compared.
   @test
   subroutine test_none_item_ignores_mirror_geom()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%horizontal_dims_spec = HORIZONTAL_DIMS_NONE
      var_spec%mirror_geom = .true.
      @assertTrue(geometry_status(var_spec, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)
   end subroutine test_none_item_ignores_mirror_geom

   @test
   subroutine test_horizontal_dims_spec_applicability()
      type(ESMF_StateItem_Flag) :: with_entry(5), without_entry(5)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      with_entry = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE]
      do i = 1, size(with_entry)
         descriptor = empty_descriptor
         var_spec = make_spec(with_entry(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertTrue(descriptor%has_characteristic(HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND))
      end do

      without_entry = [MAPL_STATEITEM_EXPRESSION, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_STATE, &
           MAPL_STATEITEM_WILDCARD, MAPL_STATEITEM_UNKNOWN]
      do i = 1, size(without_entry)
         descriptor = empty_descriptor
         var_spec = make_spec(without_entry(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND))
      end do
   end subroutine test_horizontal_dims_spec_applicability

   ! A NONE item is never compared on geometry, but still takes a geom later.
   @test
   subroutine test_none_item_geometry_is_unchecked()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%horizontal_dims_spec = HORIZONTAL_DIMS_NONE
      @assertTrue(geometry_status(var_spec, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)

      var_spec%geom_id = mapl_new_GeomId(7)
      @assertTrue(geometry_status(var_spec, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)
   end subroutine test_none_item_geometry_is_unchecked

   ! Status of the VERTICAL_STAGGER entry; has_entry is false when the
   ! item gets none.
   function stagger_entry_status(var_spec, has_entry, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      logical, intent(out) :: has_entry
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      has_entry = descriptor%has_characteristic(VERTICAL_STAGGER_CHARACTERISTIC_KIND)
      if (has_entry) then
         call descriptor%get_characteristic(VERTICAL_STAGGER_CHARACTERISTIC_KIND, c, _RC)
         char_status = c%get_status()
      end if
      _RETURN(_SUCCESS)
   end function stagger_entry_status

   ! Status of the VERTICAL_GRID entry; has_entry is false when the
   ! item gets none.
   function vcoord_status(var_spec, has_entry, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      logical, intent(out) :: has_entry
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      has_entry = descriptor%has_characteristic(VERTICAL_GRID_CHARACTERISTIC_KIND)
      if (has_entry) then
         call descriptor%get_characteristic(VERTICAL_GRID_CHARACTERISTIC_KIND, c, _RC)
         char_status = c%get_status()
      end if
      _RETURN(_SUCCESS)
   end function vcoord_status

   @test
   subroutine test_default_vertical_grid_is_deferred()
      logical :: has_entry
      integer :: status

      @assertTrue(vcoord_status(make_spec(MAPL_STATEITEM_FIELD), has_entry, rc=status) == CHARACTERISTIC_STATUS_DEFERRED)
      @assertEqual(0, status)
      @assertTrue(has_entry)
   end subroutine test_default_vertical_grid_is_deferred

   @test
   subroutine test_declared_vgrid_is_specified()
      type(VariableSpec) :: var_spec
      type(mapl_BasicVerticalGrid) :: vgrid
      logical :: has_entry
      integer :: status

      call vgrid%set_id(5)
      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%vertical_grid = vgrid
      @assertTrue(vcoord_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
   end subroutine test_declared_vgrid_is_specified

