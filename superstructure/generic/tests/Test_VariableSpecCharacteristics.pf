#include "MAPL_TestErr.h"

! VariableSpec characteristic factories: status rule and shape
! applicability for each characteristic a factory inserts.
module Test_VariableSpecCharacteristics
   use pfunit
   use mapl_VariableSpec_mod, only: VariableSpec, make_VariableSpec, MAPL_STRING_MIRROR
   use mapl_StateItem_mod, only: MAPL_STATEITEM_FIELD, MAPL_STATEITEM_FIELDBUNDLE, &
        MAPL_STATEITEM_EXPRESSION, MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
        MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_UNKNOWN, &
        MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER
   use mapl_StateItemDescriptor_mod, only: StateItemDescriptor
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristic
   use mapl_StateItemCharacteristicKind_mod, only: PHYSICAL_UNITS_CHARACTERISTIC_KIND, TYPE_KIND_CHARACTERISTIC_KIND, &
        UNGRIDDED_DIMS_CHARACTERISTIC_KIND, GEOMETRY_CHARACTERISTIC_KIND, &
        VERTICAL_GRID_CHARACTERISTIC_KIND, STANDARD_NAME_CHARACTERISTIC_KIND, &
        ATTRIBUTES_CHARACTERISTIC_KIND, VERTICAL_STAGGER_CHARACTERISTIC_KIND, &
        VERTICAL_ORIENTATION_CHARACTERISTIC_KIND, &
        HORIZONTAL_DIMS_SPEC_CHARACTERISTIC_KIND, LONG_NAME_CHARACTERISTIC_KIND, &
        RESTART_MODE_CHARACTERISTIC_KIND, QUANTITY_TYPE_CHARACTERISTIC_KIND, &
        CONSERVATION_CHARACTERISTIC_KIND, NORMALIZATION_CHARACTERISTIC_KIND
   use mapl_StateItemCharacteristicKind_mod, only: &
        ITEM_SHAPE => ITEM_SHAPE_CHARACTERISTIC_KIND, StateItemCharacteristicKind
   use mapl_ItemShapeCharacteristic_mod, only: ItemShapeCharacteristic
   use mapl_StateItemFlag_mod, only: MAPL_STATEITEM_VERTICALGRID
   use mapl_CharacteristicStatus_mod, only: CharacteristicStatus, operator(==), &
        CHARACTERISTIC_STATUS_SPECIFIED, CHARACTERISTIC_STATUS_UNCHECKED, CHARACTERISTIC_STATUS_MIRRORED, &
        CHARACTERISTIC_STATUS_DEFERRED
   use mapl_geom_api, only: mapl_new_GeomId
   use mapl_PhysicalUnitsCharacteristic_mod, only: PhysicalUnitsCharacteristic, UNKNOWN_UNITS
   use mapl_StandardNameCharacteristic_mod, only: StandardNameCharacteristic, UNKNOWN_STANDARD_NAME
   use mapl_LongNameCharacteristic_mod, only: LongNameCharacteristic
   use mapl_RestartModeCharacteristic_mod, only: RestartModeCharacteristic
   use mapl_RestartModes_mod, only: RestartMode, RESTART_REQUIRED, RESTART_SKIP, operator(==)
   use mapl_AttributesCharacteristic_mod, only: AttributesCharacteristic
   use mapl_QuantityTypeCharacteristic_mod, only: QuantityTypeCharacteristic
   use mapl_ConservationCharacteristic_mod, only: ConservationCharacteristic
   use mapl_NormalizationCharacteristic_mod, only: NormalizationCharacteristic
   use mapl_QuantityType_mod, only: QUANTITY_UNKNOWN, QUANTITY_TEMPERATURE, &
        BASIS_NONE, operator(==)
   use mapl_ConservationMetadata_mod, only: ConservationMetadata, &
        new_ConservationMetadata_mirror
   use mapl_ConservationType_mod, only: CONSERVE_NONE, &
        CONSERVE_MASS, operator(==)
   use mapl_NormalizationMetadata_mod, only: NormalizationMetadata
   use mapl_NormalizationType_mod, only: NORMALIZE_NONE, &
        NORMALIZE_DELP, operator(==)
   use gFTL2_StringVector, only: StringVector
   use mapl_TypeKindCharacteristic_mod, only: TypeKindCharacteristic
   use mapl_typekind_mod, only: MAPL_TYPEKIND_MIRROR
   use mapl_UngriddedDimsCharacteristic_mod, only: UngriddedDimsCharacteristic
   use mapl_UngriddedDims_mod, only: UngriddedDims, operator(==)
   use mapl_VerticalGridCharacteristic_mod, only: VerticalGridCharacteristic
   use mapl_vertical_grid_api, only: mapl_BasicVerticalGrid
   use mapl_VerticalOrientationCharacteristic_mod, only: VerticalOrientationCharacteristic
   use mapl_HorizontalDimsSpecCharacteristic_mod, only: HorizontalDimsSpecCharacteristic
   use mapl_HorizontalDimsSpec_mod, only: HorizontalDimsSpec, HORIZONTAL_DIMS_GEOM, HORIZONTAL_DIMS_NONE, &
        HORIZONTAL_DIMS_MIRROR, operator(==)
   use mapl_VerticalCoordinateDirection_mod, only: VerticalCoordinateDirection, VCOORD_DIRECTION_UP, &
        VCOORD_DIRECTION_DOWN, operator(==)
   use mapl_VerticalStaggerLoc_mod, only: VERTICAL_STAGGER_NONE, VERTICAL_STAGGER_CENTER, VERTICAL_STAGGER_EDGE, &
        VERTICAL_STAGGER_MIRROR, VERTICAL_STAGGER_INVALID
   use esmf, only: ESMF_StateItem_Flag, ESMF_STATEINTENT_EXPORT, ESMF_STATEINTENT_IMPORT, ESMF_STATEINTENT_INTERNAL, ESMF_StateIntent_Flag, ESMF_TYPEKIND_R8, ESMF_TYPEKIND_I4
   use esmf, only: operator(==)
   use esmf, only: ESMF_State, ESMF_StateCreate, ESMF_StateDestroy
   use mapl_GraphStateItem_mod, only: GraphStateItem
   use mapl_StateItemCharacteristic_mod, only: SYNC_PHASE_DESCRIPTIVE
   implicit none(type, external)

contains

   function make_spec(item_type, units) result(var_spec)
      type(ESMF_StateItem_Flag), intent(in) :: item_type
      character(*), optional, intent(in) :: units
      type(VariableSpec) :: var_spec

      ! A wildcard is only valid as an import; everything else defaults to export.
      var_spec%state_intent = ESMF_STATEINTENT_EXPORT
      if (item_type == MAPL_STATEITEM_WILDCARD) var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%short_name = 'X'
      var_spec%itemType = item_type
      if (present(units)) var_spec%units = units
   end function make_spec

   function units_status(var_spec, units, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      character(:), allocatable, intent(out) :: units
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (PhysicalUnitsCharacteristic)
         units = c%get_units()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function units_status

   function typekind_status(var_spec, type_kind, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      character(:), allocatable, intent(out) :: type_kind
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(TYPE_KIND_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (TypeKindCharacteristic)
         type_kind = c%get_type_kind()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function typekind_status

   @test
   subroutine test_declared_units_are_specified()
      character(:), allocatable :: units
      integer :: status

      @assertTrue(units_status(make_spec(MAPL_STATEITEM_FIELD, 'm'), units, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('m', units)
   end subroutine test_declared_units_are_specified

   @test
   subroutine test_undeclared_units_are_unchecked()
      character(:), allocatable :: units
      integer :: status

      @assertTrue(units_status(make_spec(MAPL_STATEITEM_FIELD), units, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)
      @assertEqual('', units)
   end subroutine test_undeclared_units_are_unchecked

   @test
   subroutine test_unknown_units_are_unchecked()
      character(:), allocatable :: units
      integer :: status

      @assertTrue(units_status(make_spec(MAPL_STATEITEM_EXPRESSION, UNKNOWN_UNITS), units, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)
      @assertEqual('', units)
   end subroutine test_unknown_units_are_unchecked

   @test
   subroutine test_bundle_units_are_inserted()
      character(:), allocatable :: units
      integer :: status

      @assertTrue(units_status(make_spec(MAPL_STATEITEM_FIELDBUNDLE, 'K'), units, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('K', units)
   end subroutine test_bundle_units_are_inserted

   @test
   subroutine test_all_unit_carrying_shapes_get_specified_units()
      type(ESMF_StateItem_Flag) :: shapes(3)
      character(:), allocatable :: units
      integer :: i, status

      shapes = [MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_VECTORBRACKET]
      do i = 1, size(shapes)
         @assertTrue(units_status(make_spec(shapes(i), 'Pa'), units, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
         @assertEqual(0, status)
         @assertEqual('Pa', units)
      end do
   end subroutine test_all_unit_carrying_shapes_get_specified_units

   @test
   subroutine test_shapes_without_units_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(6)
      type(StateItemDescriptor) :: descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i), 'm')
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_units_get_no_entry

   ! VariableSpec%typekind defaults to R4, which is SPECIFIED (never DEFERRED).
   @test
   subroutine test_default_typekind_is_specified_r4()
      character(:), allocatable :: type_kind
      integer :: status

      @assertTrue(typekind_status(make_spec(MAPL_STATEITEM_FIELD), type_kind, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('R4', type_kind)
   end subroutine test_default_typekind_is_specified_r4

   @test
   subroutine test_declared_typekind_is_specified()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: type_kind
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%typekind = ESMF_TYPEKIND_R8
      @assertTrue(typekind_status(var_spec, type_kind, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('R8', type_kind)

      var_spec%typekind = ESMF_TYPEKIND_I4
      @assertTrue(typekind_status(var_spec, type_kind, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('I4', type_kind)
   end subroutine test_declared_typekind_is_specified

   @test
   subroutine test_mirror_typekind_is_mirrored_without_value()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: type_kind
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%typekind = MAPL_TYPEKIND_MIRROR
      @assertTrue(typekind_status(var_spec, type_kind, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
      @assertEqual('', type_kind)
   end subroutine test_mirror_typekind_is_mirrored_without_value

   @test
   subroutine test_all_typekind_carrying_shapes_get_an_entry()
      type(ESMF_StateItem_Flag) :: shapes(6)
      character(:), allocatable :: type_kind
      integer :: i, status

      shapes = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE, MAPL_STATEITEM_EXPRESSION]
      do i = 1, size(shapes)
         @assertTrue(typekind_status(make_spec(shapes(i)), type_kind, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
         @assertEqual(0, status)
         @assertEqual('R4', type_kind)
      end do
   end subroutine test_all_typekind_carrying_shapes_get_an_entry

   @test
   subroutine test_shapes_without_typekind_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(6)
      type(StateItemDescriptor) :: descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(TYPE_KIND_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_typekind_get_no_entry

   function standard_name_status(var_spec, standard_name, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      character(:), allocatable, intent(out) :: standard_name
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(STANDARD_NAME_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (StandardNameCharacteristic)
         standard_name = c%get_standard_name()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function standard_name_status

   @test
   subroutine test_declared_standard_name_is_specified()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: standard_name
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%standard_name = 'air_temperature'
      @assertTrue(standard_name_status(var_spec, standard_name, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('air_temperature', standard_name)
   end subroutine test_declared_standard_name_is_specified

   @test
   subroutine test_undeclared_standard_name_is_unchecked()
      character(:), allocatable :: standard_name
      integer :: status

      @assertTrue(standard_name_status(make_spec(MAPL_STATEITEM_FIELD), standard_name, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)
      @assertEqual('', standard_name)
   end subroutine test_undeclared_standard_name_is_unchecked

   @test
   subroutine test_unknown_standard_name_is_unchecked()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: standard_name
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%standard_name = UNKNOWN_STANDARD_NAME
      @assertTrue(standard_name_status(var_spec, standard_name, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)
      @assertEqual('', standard_name)
   end subroutine test_unknown_standard_name_is_unchecked

   @test
   subroutine test_mirror_standard_name_on_import_is_mirrored()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: standard_name
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%standard_name_mirror = .true.
      @assertTrue(standard_name_status(var_spec, standard_name, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
   end subroutine test_mirror_standard_name_on_import_is_mirrored

   @test
   subroutine test_mirror_standard_name_on_export_is_an_error()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%standard_name_mirror = .true.
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X (STANDARD_NAME)')
      @assertExceptionRaised('status=1')
   end subroutine test_mirror_standard_name_on_export_is_an_error

   ! make_VariableSpec strips the sentinel so the legacy FieldDictionary and
   ! StandardNameAspect readers never see the literal string.
   @test
   subroutine test_make_VariableSpec_strips_mirror_sentinel()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_IMPORT, short_name='X', &
           standard_name=MAPL_STRING_MIRROR, rc=status)
      @assertEqual(0, status)
      @assertTrue(var_spec%standard_name_mirror)
      @assertFalse(allocated(var_spec%standard_name))
   end subroutine test_make_VariableSpec_strips_mirror_sentinel

   @test
   subroutine test_make_VariableSpec_rejects_mirror_sentinel_on_export()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           standard_name=MAPL_STRING_MIRROR, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X')
      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_mirror_sentinel_on_export

   @test
   subroutine test_make_VariableSpec_rejects_mirror_flags_on_field_export()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           mirror_geom=.true., rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X')
      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_mirror_flags_on_field_export

   @test
   subroutine test_make_VariableSpec_rejects_mirror_vgrid_on_field_export()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           mirror_vgrid=.true., rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X')
      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_mirror_vgrid_on_field_export

   @test
   subroutine test_export_mirror_flag_with_geom_rejected()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_FIELD, mirror_geom=.true., geom_id=mapl_new_GeomId(7), rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X')
      @assertTrue(status /= 0)
   end subroutine test_export_mirror_flag_with_geom_rejected

   @test
   subroutine test_export_mirror_flag_with_vgrid_rejected()
      type(VariableSpec) :: var_spec
      type(mapl_BasicVerticalGrid) :: vgrid
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_FIELD, mirror_vgrid=.true., vertical_grid=vgrid, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X')
      @assertTrue(status /= 0)
   end subroutine test_export_mirror_flag_with_vgrid_rejected

   @test
   subroutine test_export_sentinel_on_field_rejected()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_FIELD, standard_name=MAPL_STRING_MIRROR, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X')
      @assertTrue(status /= 0)
   end subroutine test_export_sentinel_on_field_rejected

   @test
   subroutine test_make_VariableSpec_accepts_sentinel_on_export_expression()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_EXPRESSION, standard_name=MAPL_STRING_MIRROR, rc=status)
      @assertEqual(0, status)
   end subroutine test_make_VariableSpec_accepts_sentinel_on_export_expression

   @test
   subroutine test_make_VariableSpec_accepts_export_expression_mirror()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_EXPRESSION, mirror_geom=.true., mirror_vgrid=.true., rc=status)
      @assertEqual(0, status)
   end subroutine test_make_VariableSpec_accepts_export_expression_mirror

   ! A bracket is never an import; an INTERNAL bracket is still accepted.
   @test
   subroutine test_make_VariableSpec_rejects_bracket_import()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_IMPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_BRACKET, rc=status)
      @assertExceptionRaised('a bracket is not valid on an import: X')
      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_bracket_import

   @test
   subroutine test_make_VariableSpec_rejects_vectorbracket_import()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_IMPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_VECTORBRACKET, rc=status)
      @assertExceptionRaised('a vector bracket is not valid on an import: X')
      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_vectorbracket_import

   @test
   subroutine test_make_VariableSpec_accepts_internal_bracket()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_INTERNAL, short_name='X', &
           itemtype=MAPL_STATEITEM_BRACKET, rc=status)
      @assertEqual(0, status)
   end subroutine test_make_VariableSpec_accepts_internal_bracket

   @test
   subroutine test_make_VariableSpec_rejects_export_wildcard()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_WILDCARD, rc=status)
      @assertExceptionRaised('a wildcard is only valid on an import: X')
      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_export_wildcard

   @test
   subroutine test_make_VariableSpec_rejects_internal_wildcard()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_INTERNAL, short_name='X', &
           itemtype=MAPL_STATEITEM_WILDCARD, rc=status)
      @assertExceptionRaised('a wildcard is only valid on an import: X')
      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_internal_wildcard

   @test
   subroutine test_hand_built_bracket_import_rejected_by_backstop()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_BRACKET)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('a bracket is not valid on an import: X')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
   end subroutine test_hand_built_bracket_import_rejected_by_backstop

   @test
   subroutine test_hand_built_export_wildcard_rejected_by_backstop()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_WILDCARD)
      var_spec%state_intent = ESMF_STATEINTENT_EXPORT
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('a wildcard is only valid on an import: X')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
   end subroutine test_hand_built_export_wildcard_rejected_by_backstop

   @test
   subroutine test_hand_built_vectorbracket_import_rejected_by_backstop()
      type(VariableSpec) :: var_spec
