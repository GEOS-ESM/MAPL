      @assertTrue(char_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('Derived', long_name)
   end subroutine test_expression_carries_long_name

   ! The fallback applies to an EXPRESSION export as it does to a FIELD.
   @test
   subroutine test_expression_export_long_name_falls_back_to_standard_name()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: long_name
      integer :: status
      type(CharacteristicStatus) :: char_status

      var_spec = make_spec(MAPL_STATEITEM_EXPRESSION)
      var_spec%standard_name = 'air_temperature'
      char_status = long_name_status(var_spec, long_name, rc=status)
      @assertTrue(char_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('air_temperature', long_name)
   end subroutine test_expression_export_long_name_falls_back_to_standard_name

   ! An EXPRESSION export may declare a mirror (A21 exemption); a mirrored
   ! long_name still never falls back to the standard name.
   @test
   subroutine test_expression_export_mirror_long_name_is_mirrored()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: long_name
      integer :: status
      type(CharacteristicStatus) :: char_status

      var_spec = make_spec(MAPL_STATEITEM_EXPRESSION)
      var_spec%long_name_mirror = .true.
      var_spec%standard_name = 'air_temperature'
      char_status = long_name_status(var_spec, long_name, rc=status)
      @assertTrue(char_status == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
      @assertEqual('', long_name)
   end subroutine test_expression_export_mirror_long_name_is_mirrored

   @test
   subroutine test_shapes_without_long_name_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(10)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE, &
           MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, &
           MAPL_STATEITEM_WILDCARD, MAPL_STATEITEM_UNKNOWN, &
           MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         descriptor = empty_descriptor
         var_spec = make_spec(shapes(i))
         var_spec%long_name = 'Declared'
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse( &
              descriptor%has_characteristic(LONG_NAME_CHARACTERISTIC_KIND))
         var_spec%long_name_mirror = .true.
         ! A bracket is never an import, so it has no import half.
         if (shapes(i) == MAPL_STATEITEM_BRACKET .or. shapes(i) == MAPL_STATEITEM_VECTORBRACKET) cycle
         var_spec%state_intent = ESMF_STATEINTENT_IMPORT
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse( &
              descriptor%has_characteristic(LONG_NAME_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_long_name_get_no_entry

   ! make_VariableSpec strips the sentinel, and the field dictionary default
   ! does not replace it.
   @test
   subroutine test_make_VariableSpec_strips_long_name_sentinel()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_IMPORT, short_name='X', &
           long_name=MAPL_STRING_MIRROR, rc=status)
      @assertEqual(0, status)
      @assertTrue(var_spec%long_name_mirror)
      @assertFalse(allocated(var_spec%long_name))
      @assertTrue(var_spec%requests_mirror())
   end subroutine test_make_VariableSpec_strips_long_name_sentinel

   @test
   subroutine test_make_VariableSpec_rejects_long_name_sentinel_on_export()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_FIELD, &
           long_name=MAPL_STRING_MIRROR, rc=status)
      @assertExceptionRaised( &
           'mirror is only valid on an import or an expression export: X')
      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_long_name_sentinel_on_export

   @test
   subroutine test_shapes_without_standard_name_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(11)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_VECTORBRACKET, &
           MAPL_STATEITEM_FIELDBUNDLE, MAPL_STATEITEM_EXPRESSION, &
           MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i))
         var_spec%standard_name = 'air_temperature'
         descriptor = empty_descriptor
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(STANDARD_NAME_CHARACTERISTIC_KIND))
         var_spec%standard_name_mirror = .true.
         ! A bracket is never an import, so it has no import half; an EXPRESSION exists only as an export.
         if (shapes(i) == MAPL_STATEITEM_BRACKET .or. shapes(i) == MAPL_STATEITEM_VECTORBRACKET) cycle
         if (.not. (shapes(i) == MAPL_STATEITEM_EXPRESSION)) var_spec%state_intent = ESMF_STATEINTENT_IMPORT
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(STANDARD_NAME_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_standard_name_get_no_entry

   function ungridded_dims_status(var_spec, dims, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      type(UngriddedDims), intent(out) :: dims
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(UNGRIDDED_DIMS_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (UngriddedDimsCharacteristic)
         dims = c%get_ungridded_dims()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function ungridded_dims_status

   @test
   subroutine test_default_ungridded_dims_is_specified_empty()
      type(UngriddedDims) :: dims
      integer :: status

      @assertTrue(ungridded_dims_status(make_spec(MAPL_STATEITEM_FIELD), dims, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertTrue(dims == UngriddedDims())
   end subroutine test_default_ungridded_dims_is_specified_empty

   @test
   subroutine test_declared_ungridded_dims_is_specified()
      type(VariableSpec) :: var_spec
      type(UngriddedDims) :: dims
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%ungridded_dims = UngriddedDims([5])
      @assertTrue(ungridded_dims_status(var_spec, dims, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertTrue(dims == UngriddedDims([5]))
   end subroutine test_declared_ungridded_dims_is_specified

   @test
   subroutine test_mirror_ungridded_dims_is_mirrored_without_value()
      type(VariableSpec) :: var_spec
      type(UngriddedDims) :: dims
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%ungridded_dims = UngriddedDims(is_mirror=.true.)
      @assertTrue(ungridded_dims_status(var_spec, dims, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
      @assertTrue(dims == UngriddedDims())
   end subroutine test_mirror_ungridded_dims_is_mirrored_without_value

   @test
   subroutine test_all_ungridded_dims_carrying_shapes_get_an_entry()
      type(ESMF_StateItem_Flag) :: shapes(5)
      type(UngriddedDims) :: dims
      integer :: i, status

      shapes = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE]
      do i = 1, size(shapes)
         @assertTrue(ungridded_dims_status(make_spec(shapes(i)), dims, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
         @assertEqual(0, status)
      end do
   end subroutine test_all_ungridded_dims_carrying_shapes_get_an_entry

   @test
   subroutine test_shapes_without_ungridded_dims_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(7)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_EXPRESSION, MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i))
         descriptor = empty_descriptor
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(UNGRIDDED_DIMS_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_ungridded_dims_get_no_entry

   function geometry_status(var_spec, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(GEOMETRY_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      _RETURN(_SUCCESS)
   end function geometry_status

   ! A value the item does not declare comes from the component later.
   @test
   subroutine test_default_geometry_is_deferred()
      integer :: status

      @assertTrue(geometry_status(make_spec(MAPL_STATEITEM_FIELD), rc=status) == CHARACTERISTIC_STATUS_DEFERRED)
      @assertEqual(0, status)
   end subroutine test_default_geometry_is_deferred

