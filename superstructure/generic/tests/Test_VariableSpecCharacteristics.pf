#include "MAPL_TestErr.h"

! VariableSpec characteristic factories: status rule and shape
! applicability for each characteristic a factory inserts.
module Test_VariableSpecCharacteristics
   use pfunit
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_StateItem_mod, only: MAPL_STATEITEM_FIELD, MAPL_STATEITEM_FIELDBUNDLE, &
        MAPL_STATEITEM_EXPRESSION, MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
        MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_UNKNOWN, &
        MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER
   use mapl_StateItemDescriptor_mod, only: StateItemDescriptor
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristic
   use mapl_StateItemCharacteristicKind_mod, only: PHYSICAL_UNITS_CHARACTERISTIC_KIND, TYPE_KIND_CHARACTERISTIC_KIND, &
        UNGRIDDED_DIMS_CHARACTERISTIC_KIND, GEOMETRY_CHARACTERISTIC_KIND, &
        VERTICAL_GRID_CHARACTERISTIC_KIND, STANDARD_NAME_CHARACTERISTIC_KIND, &
        ATTRIBUTES_CHARACTERISTIC_KIND, VERTICAL_STAGGER_CHARACTERISTIC_KIND
   use mapl_CharacteristicStatus_mod, only: CharacteristicStatus, operator(==), &
        CHARACTERISTIC_STATUS_SPECIFIED, CHARACTERISTIC_STATUS_UNCHECKED, CHARACTERISTIC_STATUS_MIRRORED, &
        CHARACTERISTIC_STATUS_DEFERRED
   use mapl_geom_api, only: mapl_new_GeomId
   use mapl_PhysicalUnitsCharacteristic_mod, only: PhysicalUnitsCharacteristic, UNKNOWN_UNITS
   use mapl_StandardNameCharacteristic_mod, only: StandardNameCharacteristic, UNKNOWN_STANDARD_NAME
   use mapl_AttributesCharacteristic_mod, only: AttributesCharacteristic
   use gFTL2_StringVector, only: StringVector
   use mapl_TypeKindCharacteristic_mod, only: TypeKindCharacteristic
   use mapl_typekind_mod, only: MAPL_TYPEKIND_MIRROR
   use mapl_UngriddedDimsCharacteristic_mod, only: UngriddedDimsCharacteristic
   use mapl_UngriddedDims_mod, only: UngriddedDims, operator(==)
   use mapl_VerticalGridCharacteristic_mod, only: VerticalGridCharacteristic
   use mapl_vertical_grid_api, only: mapl_BasicVerticalGrid
   use mapl_VerticalStaggerLoc_mod, only: VERTICAL_STAGGER_NONE, VERTICAL_STAGGER_CENTER, VERTICAL_STAGGER_EDGE, &
        VERTICAL_STAGGER_MIRROR, VERTICAL_STAGGER_INVALID
   use esmf, only: ESMF_StateItem_Flag, ESMF_STATEINTENT_EXPORT, ESMF_STATEINTENT_IMPORT, ESMF_TYPEKIND_R8, ESMF_TYPEKIND_I4
   implicit none(type, external)

contains

   function make_spec(item_type, units) result(var_spec)
      type(ESMF_StateItem_Flag), intent(in) :: item_type
      character(*), optional, intent(in) :: units
      type(VariableSpec) :: var_spec

      var_spec%state_intent = ESMF_STATEINTENT_EXPORT
      var_spec%short_name = 'X'
      var_spec%itemType = item_type
      if (present(units)) var_spec%units = units
   end function make_spec

   function units_status(var_spec, units, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      character(:), allocatable, intent(out) :: units
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (PhysicalUnitsCharacteristic)
         units = c%get_units()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function units_status

   function typekind_status(var_spec, type_kind, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      character(:), allocatable, intent(out) :: type_kind
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(TYPE_KIND_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (TypeKindCharacteristic)
         type_kind = c%get_type_kind()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function typekind_status

   @test
   subroutine test_declared_units_are_specified()
      character(:), allocatable :: units
      integer :: status

      @assertTrue(units_status(make_spec(MAPL_STATEITEM_FIELD, 'm'), units, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('m', units)
   end subroutine test_declared_units_are_specified

   @test
   subroutine test_undeclared_units_are_unchecked()
      character(:), allocatable :: units
      integer :: status

      @assertTrue(units_status(make_spec(MAPL_STATEITEM_FIELD), units, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)
      @assertEqual('', units)
   end subroutine test_undeclared_units_are_unchecked

   @test
   subroutine test_unknown_units_are_unchecked()
      character(:), allocatable :: units
      integer :: status

      @assertTrue(units_status(make_spec(MAPL_STATEITEM_EXPRESSION, UNKNOWN_UNITS), units, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)
      @assertEqual('', units)
   end subroutine test_unknown_units_are_unchecked

   @test
   subroutine test_bundle_units_are_inserted()
      character(:), allocatable :: units
      integer :: status

      @assertTrue(units_status(make_spec(MAPL_STATEITEM_FIELDBUNDLE, 'K'), units, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('K', units)
   end subroutine test_bundle_units_are_inserted

   @test
   subroutine test_all_unit_carrying_shapes_get_specified_units()
      type(ESMF_StateItem_Flag) :: shapes(3)
      character(:), allocatable :: units
      integer :: i, status

      shapes = [MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_VECTORBRACKET]
      do i = 1, size(shapes)
         @assertTrue(units_status(make_spec(shapes(i), 'Pa'), units, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
         @assertEqual(0, status)
         @assertEqual('Pa', units)
      end do
   end subroutine test_all_unit_carrying_shapes_get_specified_units

   @test
   subroutine test_shapes_without_units_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(6)
      type(StateItemDescriptor) :: descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i), 'm')
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(PHYSICAL_UNITS_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_units_get_no_entry

   ! VariableSpec%typekind defaults to R4, which is SPECIFIED (never DEFERRED).
   @test
   subroutine test_default_typekind_is_specified_r4()
      character(:), allocatable :: type_kind
      integer :: status

      @assertTrue(typekind_status(make_spec(MAPL_STATEITEM_FIELD), type_kind, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('R4', type_kind)
   end subroutine test_default_typekind_is_specified_r4

   @test
   subroutine test_declared_typekind_is_specified()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: type_kind
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%typekind = ESMF_TYPEKIND_R8
      @assertTrue(typekind_status(var_spec, type_kind, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('R8', type_kind)

      var_spec%typekind = ESMF_TYPEKIND_I4
      @assertTrue(typekind_status(var_spec, type_kind, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('I4', type_kind)
   end subroutine test_declared_typekind_is_specified

   @test
   subroutine test_mirror_typekind_is_mirrored_without_value()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: type_kind
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%typekind = MAPL_TYPEKIND_MIRROR
      @assertTrue(typekind_status(var_spec, type_kind, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
      @assertEqual('', type_kind)
   end subroutine test_mirror_typekind_is_mirrored_without_value

   @test
   subroutine test_all_typekind_carrying_shapes_get_an_entry()
      type(ESMF_StateItem_Flag) :: shapes(6)
      character(:), allocatable :: type_kind
      integer :: i, status

      shapes = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE, MAPL_STATEITEM_EXPRESSION]
      do i = 1, size(shapes)
         @assertTrue(typekind_status(make_spec(shapes(i)), type_kind, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
         @assertEqual(0, status)
         @assertEqual('R4', type_kind)
      end do
   end subroutine test_all_typekind_carrying_shapes_get_an_entry

   @test
   subroutine test_shapes_without_typekind_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(6)
      type(StateItemDescriptor) :: descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(TYPE_KIND_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_typekind_get_no_entry

   function standard_name_status(var_spec, standard_name, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      character(:), allocatable, intent(out) :: standard_name
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(STANDARD_NAME_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (StandardNameCharacteristic)
         standard_name = c%get_standard_name()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function standard_name_status

   @test
   subroutine test_declared_standard_name_is_specified()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: standard_name
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%standard_name = 'air_temperature'
      @assertTrue(standard_name_status(var_spec, standard_name, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertEqual('air_temperature', standard_name)
   end subroutine test_declared_standard_name_is_specified

   @test
   subroutine test_undeclared_standard_name_is_unchecked()
      character(:), allocatable :: standard_name
      integer :: status

      @assertTrue(standard_name_status(make_spec(MAPL_STATEITEM_FIELD), standard_name, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)
      @assertEqual('', standard_name)
   end subroutine test_undeclared_standard_name_is_unchecked

   @test
   subroutine test_unknown_standard_name_is_unchecked()
      type(VariableSpec) :: var_spec
      character(:), allocatable :: standard_name
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%standard_name = UNKNOWN_STANDARD_NAME
      @assertTrue(standard_name_status(var_spec, standard_name, rc=status) == CHARACTERISTIC_STATUS_UNCHECKED)
      @assertEqual(0, status)
      @assertEqual('', standard_name)
   end subroutine test_unknown_standard_name_is_unchecked

   @test
   subroutine test_shapes_without_standard_name_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(11)
      type(StateItemDescriptor) :: descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_VECTORBRACKET, &
           MAPL_STATEITEM_FIELDBUNDLE, MAPL_STATEITEM_EXPRESSION, &
           MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i))
         var_spec%standard_name = 'air_temperature'
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(STANDARD_NAME_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_standard_name_get_no_entry

   function ungridded_dims_status(var_spec, dims, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      type(UngriddedDims), intent(out) :: dims
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(UNGRIDDED_DIMS_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (UngriddedDimsCharacteristic)
         dims = c%get_ungridded_dims()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function ungridded_dims_status

   @test
   subroutine test_default_ungridded_dims_is_specified_empty()
      type(UngriddedDims) :: dims
      integer :: status

      @assertTrue(ungridded_dims_status(make_spec(MAPL_STATEITEM_FIELD), dims, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertTrue(dims == UngriddedDims())
   end subroutine test_default_ungridded_dims_is_specified_empty

   @test
   subroutine test_declared_ungridded_dims_is_specified()
      type(VariableSpec) :: var_spec
      type(UngriddedDims) :: dims
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%ungridded_dims = UngriddedDims([5])
      @assertTrue(ungridded_dims_status(var_spec, dims, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertTrue(dims == UngriddedDims([5]))
   end subroutine test_declared_ungridded_dims_is_specified

   @test
   subroutine test_mirror_ungridded_dims_is_mirrored_without_value()
      type(VariableSpec) :: var_spec
      type(UngriddedDims) :: dims
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%ungridded_dims = UngriddedDims(is_mirror=.true.)
      @assertTrue(ungridded_dims_status(var_spec, dims, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
      @assertTrue(dims == UngriddedDims())
   end subroutine test_mirror_ungridded_dims_is_mirrored_without_value

   @test
   subroutine test_all_ungridded_dims_carrying_shapes_get_an_entry()
      type(ESMF_StateItem_Flag) :: shapes(5)
      type(UngriddedDims) :: dims
      integer :: i, status

      shapes = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE]
      do i = 1, size(shapes)
         @assertTrue(ungridded_dims_status(make_spec(shapes(i)), dims, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
         @assertEqual(0, status)
      end do
   end subroutine test_all_ungridded_dims_carrying_shapes_get_an_entry

   @test
   subroutine test_shapes_without_ungridded_dims_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(7)
      type(StateItemDescriptor) :: descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_EXPRESSION, MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(UNGRIDDED_DIMS_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_ungridded_dims_get_no_entry

   function geometry_status(var_spec, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(GEOMETRY_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      _RETURN(_SUCCESS)
   end function geometry_status

   ! A value the item does not declare comes from the component later.
   @test
   subroutine test_default_geometry_is_deferred()
      integer :: status

      @assertTrue(geometry_status(make_spec(MAPL_STATEITEM_FIELD), rc=status) == CHARACTERISTIC_STATUS_DEFERRED)
      @assertEqual(0, status)
   end subroutine test_default_geometry_is_deferred

   @test
   subroutine test_declared_geom_id_is_specified()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%geom_id = mapl_new_GeomId(7)
      @assertTrue(geometry_status(var_spec, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
   end subroutine test_declared_geom_id_is_specified

   @test
   subroutine test_expression_geometry_is_mirrored()
      integer :: status

      @assertTrue(geometry_status(make_spec(MAPL_STATEITEM_EXPRESSION), rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
   end subroutine test_expression_geometry_is_mirrored

   @test
   subroutine test_mirror_geom_is_mirrored()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%mirror_geom = .true.
      @assertTrue(geometry_status(var_spec, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
   end subroutine test_mirror_geom_is_mirrored

   ! A declared geometry wins over the mirror request.
   @test
   subroutine test_declared_geom_id_overrides_mirror_geom()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%mirror_geom = .true.
      var_spec%geom_id = mapl_new_GeomId(7)
      @assertTrue(geometry_status(var_spec, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
   end subroutine test_declared_geom_id_overrides_mirror_geom

   @test
   subroutine test_geometry_applicability()
      type(ESMF_StateItem_Flag) :: with_entry(6), without_entry(3)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      with_entry = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE, MAPL_STATEITEM_SERVICE]
      do i = 1, size(with_entry)
         var_spec = make_spec(with_entry(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertTrue(descriptor%has_characteristic(GEOMETRY_CHARACTERISTIC_KIND))
      end do

      without_entry = [MAPL_STATEITEM_STATE, MAPL_STATEITEM_WILDCARD, MAPL_STATEITEM_UNKNOWN]
      do i = 1, size(without_entry)
         descriptor = empty_descriptor
         var_spec = make_spec(without_entry(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(GEOMETRY_CHARACTERISTIC_KIND))
      end do
   end subroutine test_geometry_applicability

   ! Status of the VERTICAL_STAGGER entry; has_entry is false when the
   ! item gets none.
   function stagger_entry_status(var_spec, has_entry, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      logical, intent(out) :: has_entry
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      has_entry = descriptor%has_characteristic(VERTICAL_STAGGER_CHARACTERISTIC_KIND)
      if (has_entry) then
         call descriptor%get_characteristic(VERTICAL_STAGGER_CHARACTERISTIC_KIND, c, _RC)
         char_status = c%get_status()
      end if
      _RETURN(_SUCCESS)
   end function stagger_entry_status

   ! Status of the VERTICAL_GRID entry; has_entry is false when the
   ! item gets none.
   function vcoord_status(var_spec, has_entry, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      logical, intent(out) :: has_entry
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      has_entry = descriptor%has_characteristic(VERTICAL_GRID_CHARACTERISTIC_KIND)
      if (has_entry) then
         call descriptor%get_characteristic(VERTICAL_GRID_CHARACTERISTIC_KIND, c, _RC)
         char_status = c%get_status()
      end if
      _RETURN(_SUCCESS)
   end function vcoord_status

   @test
   subroutine test_default_vertical_grid_is_deferred()
      logical :: has_entry
      integer :: status

      @assertTrue(vcoord_status(make_spec(MAPL_STATEITEM_FIELD), has_entry, rc=status) == CHARACTERISTIC_STATUS_DEFERRED)
      @assertEqual(0, status)
      @assertTrue(has_entry)
   end subroutine test_default_vertical_grid_is_deferred

   @test
   subroutine test_declared_vgrid_is_specified()
      type(VariableSpec) :: var_spec
      type(mapl_BasicVerticalGrid) :: vgrid
      logical :: has_entry
      integer :: status

      call vgrid%set_id(5)
      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%vertical_grid = vgrid
      @assertTrue(vcoord_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
   end subroutine test_declared_vgrid_is_specified

   @test
   subroutine test_expression_vertical_grid_is_mirrored()
      logical :: has_entry
      integer :: status

      @assertTrue(vcoord_status(make_spec(MAPL_STATEITEM_EXPRESSION), has_entry, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
   end subroutine test_expression_vertical_grid_is_mirrored

   @test
   subroutine test_mirror_vgrid_is_mirrored()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%mirror_vgrid = .true.
      @assertTrue(vcoord_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
   end subroutine test_mirror_vgrid_is_mirrored

   ! A declared vertical grid wins over the mirror request.
   @test
   subroutine test_declared_vgrid_overrides_mirror_vgrid()
      type(VariableSpec) :: var_spec
      type(mapl_BasicVerticalGrid) :: vgrid
      logical :: has_entry
      integer :: status

      call vgrid%set_id(5)
      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%vertical_grid = vgrid
      var_spec%mirror_vgrid = .true.
      @assertTrue(vcoord_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
   end subroutine test_declared_vgrid_overrides_mirror_vgrid

   ! Stagger NONE means no vertical dimension, so no entry.
   @test
   subroutine test_stagger_none_has_no_vertical_grid()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      type(CharacteristicStatus) :: char_status
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%vertical_stagger = VERTICAL_STAGGER_NONE
      char_status = vcoord_status(var_spec, has_entry, rc=status)
      @assertEqual(0, status)
      @assertFalse(has_entry)

      var_spec%vertical_stagger = VERTICAL_STAGGER_CENTER
      char_status = vcoord_status(var_spec, has_entry, rc=status)
      @assertEqual(0, status)
      @assertTrue(has_entry)
   end subroutine test_stagger_none_has_no_vertical_grid

   @test
   subroutine test_undeclared_vertical_stagger_is_deferred()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_DEFERRED)
      @assertEqual(0, status)
      @assertTrue(has_entry)

      var_spec%vertical_stagger = VERTICAL_STAGGER_INVALID
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_DEFERRED)
      @assertEqual(0, status)
   end subroutine test_undeclared_vertical_stagger_is_deferred

   @test
   subroutine test_declared_vertical_stagger_is_specified()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%vertical_stagger = VERTICAL_STAGGER_NONE
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertTrue(has_entry)

      var_spec%vertical_stagger = VERTICAL_STAGGER_EDGE
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
   end subroutine test_declared_vertical_stagger_is_specified

   ! MIRROR is legal on an import and on an expression export.
   @test
   subroutine test_mirror_vertical_stagger_is_mirrored()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%vertical_stagger = VERTICAL_STAGGER_MIRROR
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)

      var_spec = make_spec(MAPL_STATEITEM_EXPRESSION)
      var_spec%vertical_stagger = VERTICAL_STAGGER_MIRROR
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
   end subroutine test_mirror_vertical_stagger_is_mirrored

   @test
   subroutine test_mirror_vertical_stagger_on_field_export_fails()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%vertical_stagger = VERTICAL_STAGGER_MIRROR
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('VERTICAL_STAGGER_MIRROR is only valid on an import or an expression: X')
      @assertExceptionRaised('status=1')
   end subroutine test_mirror_vertical_stagger_on_field_export_fails

   ! mirror_vgrid with no stagger mirrors it too; a declared stagger wins.
   @test
   subroutine test_mirror_vgrid_without_stagger_is_mirrored()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%mirror_vgrid = .true.
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)

      var_spec%vertical_stagger = VERTICAL_STAGGER_CENTER
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
   end subroutine test_mirror_vgrid_without_stagger_is_mirrored

   @test
   subroutine test_expression_vertical_stagger_is_mirrored()
      logical :: has_entry
      integer :: status

      @assertTrue(stagger_entry_status(make_spec(MAPL_STATEITEM_EXPRESSION), has_entry, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
   end subroutine test_expression_vertical_stagger_is_mirrored

   @test
   subroutine test_vertical_stagger_applicability()
      type(ESMF_StateItem_Flag) :: with_entry(6), without_entry(4)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      with_entry = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE, MAPL_STATEITEM_EXPRESSION]
      do i = 1, size(with_entry)
         descriptor = empty_descriptor
         var_spec = make_spec(with_entry(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertTrue(descriptor%has_characteristic(VERTICAL_STAGGER_CHARACTERISTIC_KIND))
      end do

      without_entry = [MAPL_STATEITEM_STATE, MAPL_STATEITEM_WILDCARD, MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE]
      do i = 1, size(without_entry)
         descriptor = empty_descriptor
         var_spec = make_spec(without_entry(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(VERTICAL_STAGGER_CHARACTERISTIC_KIND))
      end do
   end subroutine test_vertical_stagger_applicability

   @test
   subroutine test_vertical_grid_applicability()
      type(ESMF_StateItem_Flag) :: with_entry(5), without_entry(4)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      with_entry = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE]
      do i = 1, size(with_entry)
         descriptor = empty_descriptor
         var_spec = make_spec(with_entry(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertTrue(descriptor%has_characteristic(VERTICAL_GRID_CHARACTERISTIC_KIND))
      end do

      without_entry = [MAPL_STATEITEM_STATE, MAPL_STATEITEM_WILDCARD, MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE]
      do i = 1, size(without_entry)
         descriptor = empty_descriptor
         var_spec = make_spec(without_entry(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(VERTICAL_GRID_CHARACTERISTIC_KIND))
      end do
   end subroutine test_vertical_grid_applicability


   function attribute_names_of(var_spec, char_status, rc) result(names)
      type(VariableSpec), intent(in) :: var_spec
      type(CharacteristicStatus), intent(out) :: char_status
      integer, optional, intent(out) :: rc
      type(StringVector) :: names

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(ATTRIBUTES_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (AttributesCharacteristic)
         names = c%get_attribute_names()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function attribute_names_of

   @test
   subroutine test_default_attributes_is_specified_and_empty()
      type(StringVector) :: names
      type(CharacteristicStatus) :: char_status
      integer :: status

      names = attribute_names_of(make_spec(MAPL_STATEITEM_FIELD), char_status, rc=status)
      @assertEqual(0, status)
      @assertTrue(char_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, names%size())
   end subroutine test_default_attributes_is_specified_and_empty

   @test
   subroutine test_declared_attributes_are_specified_with_names()
      type(VariableSpec) :: var_spec
      type(StringVector) :: names
      type(CharacteristicStatus) :: char_status
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      call var_spec%attributes%push_back('shared_attr')
      names = attribute_names_of(var_spec, char_status, rc=status)
      @assertEqual(0, status)
      @assertTrue(char_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(1, names%size())
      @assertEqual('shared_attr', names%of(1))
   end subroutine test_declared_attributes_are_specified_with_names

   @test
   subroutine test_all_attribute_carrying_shapes_get_an_entry()
      type(ESMF_StateItem_Flag) :: shapes(5)
      type(StringVector) :: names
      type(CharacteristicStatus) :: char_status
      integer :: i, status

      shapes = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE]
      do i = 1, size(shapes)
         names = attribute_names_of(make_spec(shapes(i)), char_status, rc=status)
         @assertEqual(0, status)
         @assertTrue(char_status == CHARACTERISTIC_STATUS_SPECIFIED)
      end do
   end subroutine test_all_attribute_carrying_shapes_get_an_entry

   @test
   subroutine test_shapes_without_attributes_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(7)
      type(StateItemDescriptor) :: descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_EXPRESSION, MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i))
         call var_spec%attributes%push_back('shared_attr')
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(ATTRIBUTES_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_attributes_get_no_entry

end module Test_VariableSpecCharacteristics
