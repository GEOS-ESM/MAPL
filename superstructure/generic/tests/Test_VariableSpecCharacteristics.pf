      @assertEqual(0, status)

      var_spec%vertical_stagger = VERTICAL_STAGGER_CENTER
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
   end subroutine test_mirror_vgrid_without_stagger_is_mirrored

