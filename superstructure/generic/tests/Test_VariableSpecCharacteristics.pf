   function attribute_names_of(var_spec, char_status, rc) result(names)
      type(VariableSpec), intent(in) :: var_spec
      type(CharacteristicStatus), intent(out) :: char_status
      integer, optional, intent(out) :: rc
      type(StringVector) :: names

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(ATTRIBUTES_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (AttributesCharacteristic)
         names = c%get_attribute_names()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function attribute_names_of

   @test
   subroutine test_default_attributes_is_specified_and_empty()
      type(StringVector) :: names
      type(CharacteristicStatus) :: char_status
      integer :: status

      names = attribute_names_of(make_spec(MAPL_STATEITEM_FIELD), char_status, rc=status)
      @assertEqual(0, status)
      @assertTrue(char_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, names%size())
   end subroutine test_default_attributes_is_specified_and_empty

   @test
   subroutine test_declared_attributes_are_specified_with_names()
      type(VariableSpec) :: var_spec
      type(StringVector) :: names
      type(CharacteristicStatus) :: char_status
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      call var_spec%attributes%push_back('shared_attr')
      names = attribute_names_of(var_spec, char_status, rc=status)
      @assertEqual(0, status)
      @assertTrue(char_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(1, names%size())
      @assertEqual('shared_attr', names%of(1))
   end subroutine test_declared_attributes_are_specified_with_names

   @test
   subroutine test_all_attribute_carrying_shapes_get_an_entry()
      type(ESMF_StateItem_Flag) :: shapes(5)
      type(StringVector) :: names
      type(CharacteristicStatus) :: char_status
      integer :: i, status

      shapes = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE]
      do i = 1, size(shapes)
         names = attribute_names_of(make_spec(shapes(i)), char_status, rc=status)
         @assertEqual(0, status)
         @assertTrue(char_status == CHARACTERISTIC_STATUS_SPECIFIED)
      end do
   end subroutine test_all_attribute_carrying_shapes_get_an_entry

   @test
   subroutine test_shapes_without_attributes_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(7)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_EXPRESSION, MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i))
         descriptor = empty_descriptor
         call var_spec%attributes%push_back('shared_attr')
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(ATTRIBUTES_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_attributes_get_no_entry

   ! Every shape gets a SPECIFIED ItemShape holding its declared class.
   @test
   subroutine test_every_shape_gets_specified_item_shape()
      type(ESMF_StateItem_Flag) :: shapes(9)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      class(StateItemCharacteristic), allocatable :: c
      integer :: i, status

      shapes = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, &
           MAPL_STATEITEM_VECTOR, MAPL_STATEITEM_VECTORBRACKET, &
           MAPL_STATEITEM_FIELDBUNDLE, MAPL_STATEITEM_EXPRESSION, &
           MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, &
           MAPL_STATEITEM_WILDCARD]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i))
         ! An EXPRESSION exists only as an export; a bracket is never an import.
         if (.not. (shapes(i) == MAPL_STATEITEM_EXPRESSION .or. shapes(i) == MAPL_STATEITEM_BRACKET &
              .or. shapes(i) == MAPL_STATEITEM_VECTORBRACKET)) var_spec%state_intent = ESMF_STATEINTENT_IMPORT
         descriptor = empty_descriptor
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         call descriptor%get_characteristic(ITEM_SHAPE, c, rc=status)
         @assertEqual(0, status)
         @assertTrue(c%get_status() == CHARACTERISTIC_STATUS_SPECIFIED)
         select type (c)
         type is (ItemShapeCharacteristic)
            @assertTrue(c%get_item_class() == shapes(i))
         class default
            @assertTrue(.false., 'ITEM_SHAPE entry has the wrong type')
         end select
      end do
   end subroutine test_every_shape_gets_specified_item_shape

   function restart_mode_status(var_spec, mode, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      type(RestartMode), intent(out) :: mode
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(RESTART_MODE_CHARACTERISTIC_KIND, c, _RC)
      char_status = c%get_status()
      select type (c)
      class is (RestartModeCharacteristic)
         mode = c%get_restart_mode()
      class default
         status = 1
         _VERIFY(status)
      end select
      _RETURN(_SUCCESS)
   end function restart_mode_status

   @test
   subroutine test_declared_restart_mode_is_specified()
      type(VariableSpec) :: var_spec
      type(RestartMode) :: mode
      integer :: status
      type(CharacteristicStatus) :: char_status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%restart_mode = RESTART_SKIP
      char_status = restart_mode_status(var_spec, mode, rc=status)
      @assertEqual(0, status)
      @assertTrue(char_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertTrue(mode == RESTART_SKIP)
   end subroutine test_declared_restart_mode_is_specified

   ! An undeclared mode is SPECIFIED RESTART_REQUIRED on every intent (the
   ! exporter's mode is never adopted), so it is always written.
   @test
   subroutine test_undeclared_restart_mode_is_required()
      type(VariableSpec) :: var_spec
      type(RestartMode) :: mode
      integer :: status, i
      type(CharacteristicStatus) :: char_status
      type(ESMF_StateIntent_Flag) :: intents(3)

      intents = [ESMF_STATEINTENT_EXPORT, ESMF_STATEINTENT_IMPORT, ESMF_STATEINTENT_INTERNAL]
      do i = 1, size(intents)
         var_spec = make_spec(MAPL_STATEITEM_FIELD)
         var_spec%state_intent = intents(i)
         char_status = restart_mode_status(var_spec, mode, rc=status)
         @assertEqual(0, status)
         @assertTrue(char_status == CHARACTERISTIC_STATUS_SPECIFIED)
         @assertTrue(mode == RESTART_REQUIRED)
      end do
   end subroutine test_undeclared_restart_mode_is_required

   ! Legacy passes restart_mode to FieldClassAspect only.
   @test
   subroutine test_shapes_without_restart_mode_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(11)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_EXPRESSION, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE, &
           MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, &
           MAPL_STATEITEM_WILDCARD, MAPL_STATEITEM_UNKNOWN, &
           MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         descriptor = empty_descriptor
         var_spec = make_spec(shapes(i))
         var_spec%restart_mode = RESTART_SKIP
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(RESTART_MODE_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_restart_mode_get_no_entry

   ! make_VariableSpec has no restart_mode keyword and never mirrors it.
   @test
   subroutine test_restart_mode_is_not_a_mirror_request()
      type(VariableSpec) :: var_spec

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%restart_mode = RESTART_SKIP
      @assertFalse(var_spec%requests_mirror())
   end subroutine test_restart_mode_is_not_a_mirror_request

   ! --- QuantityType, Conservation, Normalization ---

   function metadata_status(var_spec, kind, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      type(StateItemCharacteristicKind), intent(in) :: kind
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      call descriptor%get_characteristic(kind, c, _RC)
      char_status = c%get_status()
      _RETURN(_SUCCESS)
   end function metadata_status

   ! No keyword or YAML key sets these fields yet, so a spec carries the
   ! defaults: UNKNOWN, CONSERVE_NONE (not conservable), NORMALIZE_NONE
   ! (scale 1). They are SPECIFIED, never MIRRORED, and a default export is
   ! accepted.
   @test
   subroutine test_default_metadata_kinds_are_specified()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      type(ConservationMetadata) :: cmeta
      type(NormalizationMetadata) :: nmeta
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertEqual(0, status)

      call descriptor%get_characteristic(QUANTITY_TYPE_CHARACTERISTIC_KIND, c, rc=status)
      @assertEqual(0, status)
      @assertTrue(c%get_status() == CHARACTERISTIC_STATUS_SPECIFIED)
      select type (c)
      type is (QuantityTypeCharacteristic)
         @assertTrue(c%get_quantity_type() == QUANTITY_UNKNOWN)
         @assertTrue(c%get_basis() == BASIS_NONE)
      class default
         @assertTrue(.false., 'QUANTITY_TYPE entry has the wrong type')
      end select

      call descriptor%get_characteristic(CONSERVATION_CHARACTERISTIC_KIND, c, rc=status)
      @assertEqual(0, status)
      @assertTrue(c%get_status() == CHARACTERISTIC_STATUS_SPECIFIED)
      select type (c)
      type is (ConservationCharacteristic)
         cmeta = c%get_metadata()
         @assertFalse(cmeta%is_mirror())
         @assertTrue(cmeta%get_conservation_type() == CONSERVE_NONE)
         @assertFalse(cmeta%get_is_conservable())
      class default
         @assertTrue(.false., 'CONSERVATION entry has the wrong type')
      end select

      call descriptor%get_characteristic(NORMALIZATION_CHARACTERISTIC_KIND, c, rc=status)
      @assertEqual(0, status)
      @assertTrue(c%get_status() == CHARACTERISTIC_STATUS_SPECIFIED)
      select type (c)
      type is (NormalizationCharacteristic)
         nmeta = c%get_metadata()
         @assertFalse(nmeta%is_mirror())
         @assertTrue(nmeta%get_normalization_type() == NORMALIZE_NONE)
         @assertEqual(1.0, nmeta%get_normalization_scale())
      class default
         @assertTrue(.false., 'NORMALIZATION entry has the wrong type')
      end select
   end subroutine test_default_metadata_kinds_are_specified

   ! The make_VariableSpec keyword sets the field the factory reads, and is
   ! not a mirror request.
   @test
   subroutine test_quantity_type_keyword_sets_field_and_characteristic()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, 'X', &
           quantity_type=QUANTITY_TEMPERATURE, rc=status)
      @assertEqual(0, status)
      @assertTrue(var_spec%quantity_type == QUANTITY_TEMPERATURE)
      @assertFalse(var_spec%requests_mirror())

      call var_spec%make_characteristics(descriptor, rc=status)
      @assertEqual(0, status)
      call descriptor%get_characteristic(QUANTITY_TYPE_CHARACTERISTIC_KIND, c, rc=status)
      @assertEqual(0, status)
      @assertTrue(c%get_status() == CHARACTERISTIC_STATUS_SPECIFIED)
      select type (c)
      type is (QuantityTypeCharacteristic)
         @assertTrue(c%get_quantity_type() == QUANTITY_TEMPERATURE)
      class default
         @assertTrue(.false., 'QUANTITY_TYPE entry has the wrong type')
      end select
   end subroutine test_quantity_type_keyword_sets_field_and_characteristic

   @test
   subroutine test_quantity_type_keyword_absent_leaves_unknown()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, 'X', rc=status)
      @assertEqual(0, status)
      @assertTrue(var_spec%quantity_type == QUANTITY_UNKNOWN)
   end subroutine test_quantity_type_keyword_absent_leaves_unknown

   @test
   subroutine test_default_spec_does_not_request_metadata_mirror()
      type(VariableSpec) :: var_spec

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      @assertFalse(var_spec%requests_mirror())
   end subroutine test_default_spec_does_not_request_metadata_mirror

   ! The declared value is used, not legacy's fixed defaults.
   @test
   subroutine test_declared_metadata_values_are_used()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      type(ConservationMetadata) :: cmeta
      type(NormalizationMetadata) :: nmeta
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%quantity_type = QUANTITY_TEMPERATURE
      var_spec%conservation = ConservationMetadata(CONSERVE_MASS, &
           is_conservable=.true.)
      var_spec%normalization = NormalizationMetadata(NORMALIZE_DELP, &
           normalization_scale=2.0)
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertEqual(0, status)

      call descriptor%get_characteristic(QUANTITY_TYPE_CHARACTERISTIC_KIND, c, rc=status)
      @assertEqual(0, status)
      @assertTrue(c%get_status() == CHARACTERISTIC_STATUS_SPECIFIED)
      select type (c)
      type is (QuantityTypeCharacteristic)
         @assertTrue(c%get_quantity_type() == QUANTITY_TEMPERATURE)
      class default
         @assertTrue(.false., 'QUANTITY_TYPE entry has the wrong type')
      end select

      call descriptor%get_characteristic(CONSERVATION_CHARACTERISTIC_KIND, c, rc=status)
      @assertEqual(0, status)
      @assertTrue(c%get_status() == CHARACTERISTIC_STATUS_SPECIFIED)
      select type (c)
      type is (ConservationCharacteristic)
         cmeta = c%get_metadata()
         @assertTrue(cmeta%get_conservation_type() == CONSERVE_MASS)
         @assertTrue(cmeta%get_is_conservable())
      class default
         @assertTrue(.false., 'CONSERVATION entry has the wrong type')
      end select

      call descriptor%get_characteristic(NORMALIZATION_CHARACTERISTIC_KIND, c, rc=status)
      @assertEqual(0, status)
      @assertTrue(c%get_status() == CHARACTERISTIC_STATUS_SPECIFIED)
      select type (c)
      type is (NormalizationCharacteristic)
         nmeta = c%get_metadata()
         @assertTrue(nmeta%get_normalization_type() == NORMALIZE_DELP)
         @assertEqual(2.0, nmeta%get_normalization_scale())
      class default
         @assertTrue(.false., 'NORMALIZATION entry has the wrong type')
      end select
   end subroutine test_declared_metadata_values_are_used

   @test
   subroutine test_mirror_conservation_on_import_is_mirrored()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%conservation = new_ConservationMetadata_mirror()
      @assertTrue(var_spec%requests_mirror())
      @assertTrue(metadata_status(var_spec, CONSERVATION_CHARACTERISTIC_KIND, rc=status) == &
           CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
      ! Only its own kind turns mirrored.
      @assertTrue(metadata_status(var_spec, NORMALIZATION_CHARACTERISTIC_KIND, rc=status) == &
           CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
   end subroutine test_mirror_conservation_on_import_is_mirrored

   @test
   subroutine test_mirror_normalization_on_import_is_mirrored()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%normalization = NormalizationMetadata()
      @assertTrue(var_spec%requests_mirror())
      @assertTrue(metadata_status(var_spec, NORMALIZATION_CHARACTERISTIC_KIND, rc=status) == &
           CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
      @assertTrue(metadata_status(var_spec, CONSERVATION_CHARACTERISTIC_KIND, rc=status) == &
           CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
   end subroutine test_mirror_normalization_on_import_is_mirrored

   ! These fields have no make_VariableSpec keyword and are assigned after
   ! it runs, so only the check after the factory loop sees a mirror here.
   @test
   subroutine test_export_rejects_conservation_mirror()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%conservation = new_ConservationMetadata_mirror()
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X (CONSERVATION)')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
   end subroutine test_export_rejects_conservation_mirror

   @test
   subroutine test_export_rejects_normalization_mirror()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%normalization = NormalizationMetadata()
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X (NORMALIZATION)')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
   end subroutine test_export_rejects_normalization_mirror

   @test
   subroutine test_all_metadata_carrying_shapes_get_an_entry()
      type(ESMF_StateItem_Flag) :: shapes(5)
      integer :: i, status

      shapes = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE]
      do i = 1, size(shapes)
         @assertTrue(metadata_status(make_spec(shapes(i)), QUANTITY_TYPE_CHARACTERISTIC_KIND, rc=status) == &
              CHARACTERISTIC_STATUS_SPECIFIED)
         @assertEqual(0, status)
         @assertTrue(metadata_status(make_spec(shapes(i)), CONSERVATION_CHARACTERISTIC_KIND, rc=status) == &
              CHARACTERISTIC_STATUS_SPECIFIED)
         @assertEqual(0, status)
         @assertTrue(metadata_status(make_spec(shapes(i)), NORMALIZATION_CHARACTERISTIC_KIND, rc=status) == &
              CHARACTERISTIC_STATUS_SPECIFIED)
         @assertEqual(0, status)
      end do
   end subroutine test_all_metadata_carrying_shapes_get_an_entry

   @test
   subroutine test_shapes_without_metadata_kinds_get_no_entry()
      type(ESMF_StateItem_Flag) :: shapes(7)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      shapes = [MAPL_STATEITEM_EXPRESSION, MAPL_STATEITEM_STATE, MAPL_STATEITEM_SERVICE, MAPL_STATEITEM_WILDCARD, &
           MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE_PROVIDER, MAPL_STATEITEM_SERVICE_SUBSCRIBER]
      do i = 1, size(shapes)
         var_spec = make_spec(shapes(i))
         descriptor = empty_descriptor
         var_spec%quantity_type = QUANTITY_TEMPERATURE
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(QUANTITY_TYPE_CHARACTERISTIC_KIND))
         @assertFalse(descriptor%has_characteristic(CONSERVATION_CHARACTERISTIC_KIND))
         @assertFalse(descriptor%has_characteristic(NORMALIZATION_CHARACTERISTIC_KIND))
      end do
   end subroutine test_shapes_without_metadata_kinds_get_no_entry

   ! A State carries none of these kinds: write_info fails for it. A direct
   ! call records only the kind's own message.
   @test
   subroutine test_metadata_write_info_fails_for_a_state_handle()
      type(QuantityTypeCharacteristic) :: qty
      type(ConservationCharacteristic) :: cons
      type(NormalizationCharacteristic) :: norm
      type(GraphStateItem) :: handle
      type(ESMF_State) :: state
      integer :: status

      qty = QuantityTypeCharacteristic(QUANTITY_TEMPERATURE)
      cons = ConservationCharacteristic(ConservationMetadata(CONSERVE_MASS))
      norm = NormalizationCharacteristic(NormalizationMetadata(NORMALIZE_DELP))
      state = ESMF_StateCreate(rc=status)
      @assertEqual(0, status)
      call handle%set(state, rc=status)
      @assertEqual(0, status)

      call qty%write_info(handle, SYNC_PHASE_DESCRIPTIVE, rc=status)
      @assertExceptionRaised('QuantityTypeCharacteristic: needs Field or FieldBundle')
      @assertTrue(status /= 0)
      call cons%write_info(handle, SYNC_PHASE_DESCRIPTIVE, rc=status)
      @assertExceptionRaised('ConservationCharacteristic: needs Field or FieldBundle')
      @assertTrue(status /= 0)
      call norm%write_info(handle, SYNC_PHASE_DESCRIPTIVE, rc=status)
      @assertExceptionRaised('NormalizationCharacteristic: needs Field or FieldBundle')
      @assertTrue(status /= 0)
      call ESMF_StateDestroy(state)
   end subroutine test_metadata_write_info_fails_for_a_state_handle

   ! A declared variant is carried in the signature.
   @test
   subroutine test_item_shape_carries_declared_variant()
      type(StateItemDescriptor) :: descriptor
      type(VariableSpec) :: var_spec
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_STATE)
      var_spec%state_item_variant = MAPL_STATEITEM_VERTICALGRID
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertEqual(0, status)
      call descriptor%get_characteristic(ITEM_SHAPE, c, rc=status)
      @assertEqual(0, status)
      @assertEqual('item_class=STATE,variant=VERTICALGRID', &
           c%get_signature())
   end subroutine test_item_shape_carries_declared_variant

   ! -- Intent rules: a mirror only on an IMPORT or an EXPRESSION export, and
   ! an EXPRESSION only as an export. An INTERNAL never has a mirror; it
   ! takes no part in connections, so nothing could resolve one. --

   @test
   subroutine test_make_VariableSpec_rejects_sentinel_on_internal()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_INTERNAL, short_name='X', &
           itemtype=MAPL_STATEITEM_FIELD, standard_name=MAPL_STRING_MIRROR, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X')
      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_sentinel_on_internal

   @test
   subroutine test_make_VariableSpec_rejects_long_name_sentinel_on_internal()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_INTERNAL, short_name='X', &
           itemtype=MAPL_STATEITEM_FIELD, long_name=MAPL_STRING_MIRROR, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X')
      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_long_name_sentinel_on_internal

