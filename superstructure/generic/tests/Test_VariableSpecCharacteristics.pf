   ! MIRROR is legal on an import and on an expression export.
   @test
   subroutine test_mirror_vertical_stagger_is_mirrored()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%vertical_stagger = VERTICAL_STAGGER_MIRROR
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)

      var_spec = make_spec(MAPL_STATEITEM_EXPRESSION)
      var_spec%vertical_stagger = VERTICAL_STAGGER_MIRROR
      @assertTrue(stagger_entry_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
   end subroutine test_mirror_vertical_stagger_is_mirrored

   @test
   subroutine test_mirror_vertical_stagger_on_field_export_fails()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%vertical_stagger = VERTICAL_STAGGER_MIRROR
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X (VERTICAL_STAGGER)')
      @assertExceptionRaised('status=1')
   end subroutine test_mirror_vertical_stagger_on_field_export_fails

   ! mirror_vgrid with no stagger mirrors it too; a declared stagger wins.
