      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%vertical_grid = vgrid
      var_spec%mirror_vgrid = .true.
      @assertTrue(vcoord_status(var_spec, has_entry, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
