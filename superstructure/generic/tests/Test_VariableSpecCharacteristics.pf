      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_EXPRESSION)
      var_spec%state_intent = ESMF_STATEINTENT_INTERNAL
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('an expression is only valid on an export: X')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
   end subroutine test_hand_built_expression_internal_rejected

   ! Regressions: the two allowed places for a mirror still work.
   @test
   subroutine test_import_mirror_still_accepted()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_IMPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_FIELD, standard_name=MAPL_STRING_MIRROR, &
           typekind=MAPL_TYPEKIND_MIRROR, mirror_geom=.true., rc=status)
      @assertEqual(0, status)
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertEqual(0, status)
   end subroutine test_import_mirror_still_accepted

   @test
   subroutine test_expression_export_mirror_still_accepted()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_EXPRESSION, expression='A', mirror_geom=.true., rc=status)
      @assertEqual(0, status)
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertEqual(0, status)
   end subroutine test_expression_export_mirror_still_accepted


end module Test_VariableSpecCharacteristics
