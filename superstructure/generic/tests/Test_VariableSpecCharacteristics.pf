      @assertTrue(status /= 0)
   end subroutine test_make_VariableSpec_rejects_expression_internal

   ! The placement rule is reported alone: no mirror message follows it.
   @test
   subroutine test_expression_import_with_mirror_reports_expression_only()
      type(VariableSpec) :: var_spec
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_IMPORT, short_name='X', &
           itemtype=MAPL_STATEITEM_EXPRESSION, expression='A', mirror_geom=.true., rc=status)
      @assertExceptionRaised('an expression is only valid on an export: X')
      @assertEqual(1, status)
   end subroutine test_expression_import_with_mirror_reports_expression_only

   ! The rule also covers a hand-built spec that bypasses make_VariableSpec.
   @test
   subroutine test_hand_built_expression_import_rejected()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_EXPRESSION)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('an expression is only valid on an export: X')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
   end subroutine test_hand_built_expression_import_rejected

