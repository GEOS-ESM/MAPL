   @test
   subroutine test_vertical_stagger_applicability()
      type(ESMF_StateItem_Flag) :: with_entry(6), without_entry(4)
      type(StateItemDescriptor) :: descriptor, empty_descriptor
      type(VariableSpec) :: var_spec
      integer :: i, status

      with_entry = [MAPL_STATEITEM_FIELD, MAPL_STATEITEM_BRACKET, MAPL_STATEITEM_VECTOR, &
           MAPL_STATEITEM_VECTORBRACKET, MAPL_STATEITEM_FIELDBUNDLE, MAPL_STATEITEM_EXPRESSION]
      do i = 1, size(with_entry)
         descriptor = empty_descriptor
         var_spec = make_spec(with_entry(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertTrue(descriptor%has_characteristic(VERTICAL_STAGGER_CHARACTERISTIC_KIND))
      end do

      without_entry = [MAPL_STATEITEM_STATE, MAPL_STATEITEM_WILDCARD, MAPL_STATEITEM_UNKNOWN, MAPL_STATEITEM_SERVICE]
      do i = 1, size(without_entry)
         descriptor = empty_descriptor
         var_spec = make_spec(without_entry(i))
         call var_spec%make_characteristics(descriptor, rc=status)
         @assertEqual(0, status)
         @assertFalse(descriptor%has_characteristic(VERTICAL_STAGGER_CHARACTERISTIC_KIND))
      end do
   end subroutine test_vertical_stagger_applicability

