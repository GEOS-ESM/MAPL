      var_spec%horizontal_dims_spec = HORIZONTAL_DIMS_NONE
      @assertTrue(dims_spec_entry(var_spec, dims_spec, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertTrue(dims_spec == HORIZONTAL_DIMS_NONE)
   end subroutine test_declared_none_horizontal_dims_spec_is_specified_none

