   ! Stagger NONE means no vertical dimension, so no entry.
   @test
   subroutine test_stagger_none_has_no_vertical_grid()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      type(CharacteristicStatus) :: char_status
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%vertical_stagger = VERTICAL_STAGGER_NONE
      char_status = vcoord_status(var_spec, has_entry, rc=status)
      @assertEqual(0, status)
      @assertFalse(has_entry)

      var_spec%vertical_stagger = VERTICAL_STAGGER_CENTER
      char_status = vcoord_status(var_spec, has_entry, rc=status)
      @assertEqual(0, status)
      @assertTrue(has_entry)
   end subroutine test_stagger_none_has_no_vertical_grid

   ! Status of the VERTICAL_ORIENTATION entry and, for a SPECIFIED one, its
   ! direction; has_entry is false when the item gets none.
   function orientation_entry_status(var_spec, has_entry, direction, rc) result(char_status)
      type(VariableSpec), intent(in) :: var_spec
      logical, intent(out) :: has_entry
      type(VerticalCoordinateDirection), intent(out) :: direction
      integer, optional, intent(out) :: rc
      type(CharacteristicStatus) :: char_status

      type(StateItemDescriptor) :: descriptor
      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call var_spec%make_characteristics(descriptor, _RC)
      has_entry = descriptor%has_characteristic(VERTICAL_ORIENTATION_CHARACTERISTIC_KIND)
      if (has_entry) then
         call descriptor%get_characteristic(VERTICAL_ORIENTATION_CHARACTERISTIC_KIND, c, _RC)
         char_status = c%get_status()
         select type (c)
         type is (VerticalOrientationCharacteristic)
            direction = c%get_direction()
         end select
      end if
      _RETURN(_SUCCESS)
   end function orientation_entry_status

   ! Unspecified follows the grid, which the component supplies later.
   @test
   subroutine test_undeclared_vertical_orientation_is_deferred()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      type(VerticalCoordinateDirection) :: direction
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      @assertTrue(orientation_entry_status(var_spec, has_entry, direction, rc=status) == CHARACTERISTIC_STATUS_DEFERRED)
      @assertEqual(0, status)
      @assertTrue(has_entry)

      var_spec%vertical_alignment = 'with_grid'
      @assertTrue(orientation_entry_status(var_spec, has_entry, direction, rc=status) == CHARACTERISTIC_STATUS_DEFERRED)
      @assertEqual(0, status)
   end subroutine test_undeclared_vertical_orientation_is_deferred

   @test
   subroutine test_declared_vertical_orientation_is_specified()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      type(VerticalCoordinateDirection) :: direction
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%vertical_alignment = 'upward'
      @assertTrue(orientation_entry_status(var_spec, has_entry, direction, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertTrue(direction == VCOORD_DIRECTION_UP)

      var_spec%vertical_alignment = 'downward'
      @assertTrue(orientation_entry_status(var_spec, has_entry, direction, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertTrue(direction == VCOORD_DIRECTION_DOWN)
   end subroutine test_declared_vertical_orientation_is_specified

   ! An item grid is known at construction, so with_grid resolves there.
   @test
   subroutine test_item_vgrid_resolves_vertical_orientation()
      type(VariableSpec) :: var_spec
      type(mapl_BasicVerticalGrid) :: vgrid
      logical :: has_entry
      type(VerticalCoordinateDirection) :: direction
      integer :: status

      call vgrid%set_coordinate_direction(VCOORD_DIRECTION_UP)
      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%vertical_grid = vgrid
      @assertTrue(orientation_entry_status(var_spec, has_entry, direction, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertTrue(direction == VCOORD_DIRECTION_UP)

      var_spec%vertical_alignment = 'downward'
      @assertTrue(orientation_entry_status(var_spec, has_entry, direction, rc=status) == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(0, status)
      @assertTrue(direction == VCOORD_DIRECTION_DOWN)
   end subroutine test_item_vgrid_resolves_vertical_orientation

   @test
   subroutine test_mirror_vertical_orientation_is_mirrored()
      type(VariableSpec) :: var_spec
      logical :: has_entry
      type(VerticalCoordinateDirection) :: direction
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%vertical_alignment = 'mirror'
      @assertTrue(orientation_entry_status(var_spec, has_entry, direction, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)

      var_spec = make_spec(MAPL_STATEITEM_EXPRESSION)
      @assertTrue(orientation_entry_status(var_spec, has_entry, direction, rc=status) == CHARACTERISTIC_STATUS_MIRRORED)
      @assertEqual(0, status)
   end subroutine test_mirror_vertical_orientation_is_mirrored

