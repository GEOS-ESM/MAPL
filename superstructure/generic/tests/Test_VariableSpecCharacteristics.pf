   end subroutine test_make_VariableSpec_rejects_alignment_mirror_on_internal

   ! Conservation has no make_VariableSpec keyword, so only the check after
   ! the factory loop sees it.
   @test
   subroutine test_internal_rejects_conservation_mirror()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_INTERNAL
      var_spec%conservation = new_ConservationMetadata_mirror()
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X (CONSERVATION)')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
   end subroutine test_internal_rejects_conservation_mirror

   ! A hand-built internal reaches the backstop with a MIRRORED entry.
   @test
   subroutine test_internal_rejects_hand_built_mirror_geom()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_FIELD)
      var_spec%state_intent = ESMF_STATEINTENT_INTERNAL
      var_spec%mirror_geom = .true.
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X (GEOMETRY)')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
   end subroutine test_internal_rejects_hand_built_mirror_geom

   ! A STATE has no TYPE_KIND entry, so no MIRRORED entry exists to find;
   ! the backstop still rejects the request, as make_VariableSpec would.
   @test
   subroutine test_internal_rejects_hand_built_request_on_shape_without_entry()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_spec(MAPL_STATEITEM_STATE)
      var_spec%state_intent = ESMF_STATEINTENT_INTERNAL
      var_spec%typekind = MAPL_TYPEKIND_MIRROR
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertExceptionRaised('mirror is only valid on an import or an expression export: X')
      @assertExceptionRaised('status=1')
      @assertEqual(1, status)
      @assertFalse(descriptor%has_characteristic(TYPE_KIND_CHARACTERISTIC_KIND))
   end subroutine test_internal_rejects_hand_built_request_on_shape_without_entry

   ! An internal without a mirror request is unaffected, whatever the shape.
   @test
   subroutine test_internal_without_mirror_is_accepted()
      type(VariableSpec) :: var_spec
      type(StateItemDescriptor) :: descriptor
      integer :: status

      var_spec = make_VariableSpec(ESMF_STATEINTENT_INTERNAL, short_name='X', &
           itemtype=MAPL_STATEITEM_FIELD, rc=status)
      @assertEqual(0, status)
      call var_spec%make_characteristics(descriptor, rc=status)
      @assertEqual(0, status)
   end subroutine test_internal_without_mirror_is_accepted

   @test
   subroutine test_make_VariableSpec_rejects_expression_import()
