   ! Test StateItemSpec%set_geometry inserts a missing GeomAspect
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_set_geometry_inserts_missing_geom_aspect(this)
      class(ESMF_TestMethod), intent(inout) :: this
      type(StateRegistry), target :: registry
      type(VariableSpec) :: var_spec
      type(StateItemSpec), target :: spec
      type(GeomAspect) :: aspect
      type(ESMF_Geom) :: geom1, actual_geom
      type(VirtualConnectionPt) :: virtual_pt
      type(AspectMap), pointer :: aspects
      logical :: same, has_geom
      integer :: status, num_erased

      geom1 = get_geom()
      registry = StateRegistry('StateRegistry')
      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, 'TEST', typekind=EXPORT_TYPEKIND, itemtype=ITEMTYPE, _RC)
      spec = var_spec%make_StateItemSpec(registry, _RC)
      call spec%create(_RC)

      aspects => spec%get_aspects()
      ! Remove GeomAspect to test insertion
      num_erased = aspects%erase(GEOM_ASPECT_ID)
      has_geom = aspects%count(GEOM_ASPECT_ID) > 0
      @assertFalse(has_geom, 'GeomAspect should be removed.')

      ! Call set_geometry (it should insert it)
      call spec%set_geometry(geom=geom1, _RC)

      has_geom = aspects%count(GEOM_ASPECT_ID) > 0
      @assertTrue(has_geom, 'GeomAspect should be inserted.')

      ! Also assert the inserted aspect's status is SPECIFIED.
      virtual_pt = VirtualConnectionPt(state_intent='export', short_name='TEST')
      call registry%add_primary_spec(virtual_pt=virtual_pt, spec=spec, _RC)
      aspect = get_geom_aspect(registry, virtual_pt, _RC)
      @assertTrue(aspect%is_specified(), 'Inserted GeomAspect should be SPECIFIED.')

      actual_geom = aspect%get_geom(_RC)
      same = mapl_SameGeom(actual_geom, geom1)
      @assertTrue(same, 'Inserted aspect should have the correct geom.')

      _UNUSED_DUMMY(this)
   end subroutine test_set_geometry_inserts_missing_geom_aspect


   ! Test errors inside set_geometry propagate
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_set_geometry_propagates_errors(this)
      class(ESMF_TestMethod), intent(inout) :: this
      type(StateRegistry), target :: registry
      type(VariableSpec) :: var_spec
      type(StateItemSpec), target :: spec
      type(ESMF_Geom) :: geom1
      type(AspectMap), pointer :: aspects
      integer :: status, num_erased

      geom1 = get_geom()
      registry = StateRegistry('StateRegistry')
      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, 'TEST', typekind=EXPORT_TYPEKIND, itemtype=ITEMTYPE, _RC)
      spec = var_spec%make_StateItemSpec(registry, _RC)
      call spec%create(_RC)

      aspects => spec%get_aspects()
      num_erased = aspects%erase(CLASS_ASPECT_ID)

      ! Call set_geometry, expect failure to propagate
      call spec%set_geometry(geom=geom1, rc=status)
      @assertExceptionRaised('status=1')
      @assertExceptionRaised('status=1')
      @assertTrue(status /= 0, 'rc should not be swallowed')

      _UNUSED_DUMMY(this)
   end subroutine test_set_geometry_propagates_errors



   ! Test undeclared item geom_id takes component geom_id
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_undeclared_item_geom_id_takes_component_geom_id(this)
      class(ESMF_TestMethod), intent(inout) :: this
      type(StateRegistry), target :: registry
      type(VariableSpec) :: var_spec
      type(StateItemSpec) :: spec
      type(GeomAspect) :: aspect
      type(ESMF_Geom) :: geom1, geom2
      type(mapl_GeomId) :: g_id1, g_id2, actual_id
      type(VirtualConnectionPt) :: virtual_pt
      logical :: same_id
      integer :: status

      geom1 = get_geom()
      geom2 = get_other_geom(_RC)
      g_id1 = mapl_GeomGetId(geom1, _RC)
      g_id2 = mapl_GeomGetId(geom2, _RC)
      same_id = (g_id1%get_value() == g_id2%get_value())
      @assertFalse(same_id, 'Seed geoms must have different ids.')

      registry = StateRegistry('StateRegistry')
      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, 'TEST', typekind=EXPORT_TYPEKIND, itemtype=ITEMTYPE, _RC)
      spec = var_spec%make_StateItemSpec(registry, _RC)
      call spec%create(_RC)
      virtual_pt = VirtualConnectionPt(state_intent='export', short_name='TEST')
      call registry%add_primary_spec(virtual_pt=virtual_pt, spec=spec, _RC)

      ! First push G1
      call registry%set_geometry(geom=geom1, _RC)

      ! Second push G2
      call registry%set_geometry(geom=geom2, _RC)

      aspect = get_geom_aspect(registry, virtual_pt, _RC)
      actual_id = aspect%get_geom_id()
      same_id = (actual_id%get_value() == g_id2%get_value())
      @assertTrue(same_id, 'Undeclared item geom_id should take the second component geom_id.')
      _UNUSED_DUMMY(this)
   end subroutine test_undeclared_item_geom_id_takes_component_geom_id

   ! Test id-only item keeps its geom_id after multiple pushes
   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_id_only_item_keeps_geom_id_after_multiple_pushes(this)
      class(ESMF_TestMethod), intent(inout) :: this
      type(StateRegistry), target :: registry
      type(VariableSpec) :: var_spec
      type(StateItemSpec) :: spec
      type(GeomAspect) :: aspect
      type(ESMF_Geom) :: geom1, geom2
      type(mapl_GeomId) :: id_7, actual_id
      type(VirtualConnectionPt) :: virtual_pt
      logical :: same_id
      integer :: status

      geom1 = get_geom()
      geom2 = get_other_geom(_RC)
      id_7 = mapl_new_GeomId(7)

      registry = StateRegistry('StateRegistry')
      var_spec = make_VariableSpec(ESMF_STATEINTENT_EXPORT, 'TEST', typekind=EXPORT_TYPEKIND, itemtype=ITEMTYPE, geom_id=id_7, _RC)
      spec = var_spec%make_StateItemSpec(registry, _RC)
      call spec%create(_RC)
      virtual_pt = VirtualConnectionPt(state_intent='export', short_name='TEST')
      call registry%add_primary_spec(virtual_pt=virtual_pt, spec=spec, _RC)

      ! First push G1
      call registry%set_geometry(geom=geom1, _RC)

      ! Second push G2
      call registry%set_geometry(geom=geom2, _RC)

      aspect = get_geom_aspect(registry, virtual_pt, _RC)
      actual_id = aspect%get_geom_id()
      same_id = (actual_id%get_value() == id_7%get_value())
      @assertTrue(same_id, 'ID-only item should keep its geom_id after multiple pushes.')
      _UNUSED_DUMMY(this)
   end subroutine test_id_only_item_keeps_geom_id_after_multiple_pushes

end module Test_Couplers
