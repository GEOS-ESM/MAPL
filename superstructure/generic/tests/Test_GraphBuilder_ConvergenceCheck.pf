#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! Tasks 5.2/5.3 (spec/12-methods-and-drivers.md REQ-MTH-011 step (c),
! griddedcomponentdriver-integration-lifecycle spec.md "The realize/
! accept/realize initialization cycle terminates on defined convergence
! or fails explicitly"). Originally graphbuilder_run_connect_hook's own
! hard-error check for an unresolved required import once that
! component's own graph froze; openspec/changes/hierarchy-wide-
! component-graph, tasks.md Group 9 (design.md D7) moved both freezing
! and this convergence check to a single, hierarchy-wide call -
! GraphBuilder%run_graph_freeze_hook, the GENERIC_INIT_GRAPH_FREEZE
! phase's own entry point (OuterMetaComponent/
! initialize_graph_freeze.F90) - run exactly once, at the hierarchy
! root, after every component's own connections are resolved
! (run_connect_hook, which no longer freezes or checks convergence
! itself). Rewritten against that new call site (tasks.md task 9.4).
!
! Test-only OuterMetaComponent instances are built the same way
! Test_GraphBuilder.pf does (bypassing SetServices/DSO machinery).
module Test_GraphBuilder_ConvergenceCheck
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_NodeId_mod, only: NodeId
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_ChildSpec_mod, only: ChildSpec
   use mapl_ComponentSpec_mod, only: ComponentSpec
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_ConnectionPt_mod, only: ConnectionPt
   use mapl_VirtualConnectionPt_mod, only: VirtualConnectionPt
   use mapl_MatchConnection_mod, only: MatchConnection
   use gFTL2_StringVector, only: StringVector
   use GraphBuilderTestSupport_mod, only: make_outer_meta, make_var
   use esmf
   use pfunit
   implicit none(type, external)

contains

   ! make_outer_meta/make_var shared via GraphBuilderTestSupport_mod
   ! (docs/graph/spec/20-implementation-roadmap.md sec 20.4.17,
   ! sub-step 17-1). make_outer_meta does not pass a hierarchy_id to
   ! init_meta - matching every real top-level/cap component, this
   ! makes `outer_meta` the true root of its own one-component
   ! hierarchy (OuterMetaComponent.F90's own is_hierarchy_root
   ! field-declaration comment) - required for run_graph_freeze_hook
   ! below to be anything other than a no-op when called on it.

   ! Shared two-child (child_src/child_dst) parent fixture, matching
   ! Test_GraphBuilder.pf's own connect_all-style MatchConnection shape.
   ! When leave_unresolved is .true., child_dst additionally declares an
   ! import ('Q') with no matching export - the never-resolvable case.
   ! Resolves connections on both children (run_connect_hook) but does
   ! NOT freeze or check convergence - callers do that explicitly via
   ! run_graph_freeze_hook, called once on parent_meta (the hierarchy
   ! root), matching the real lifecycle's own GENERIC_INIT_GRAPH_FREEZE
   ! phase ordering (resolve everywhere first, freeze+check once, after).
   subroutine make_two_child_fixture(parent_meta, leave_unresolved, rc)
      type(OuterMetaComponent), pointer, intent(out) :: parent_meta
      logical, intent(in) :: leave_unresolved
      integer, optional, intent(out) :: rc

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphBuilder) :: gb
      integer :: status

      call make_outer_meta('comp_convergence_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      if (leave_unresolved) then
         call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'Q')) ! never matched
      end if

      call gb%run_advertise_hook(src_meta)
      call gb%run_advertise_hook(dst_meta)

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      ! connect()-time resolution on every component (matches the real
      ! lifecycle's own per-component GENERIC_INIT_ACCEPT_TRANSFER call,
      ! which no longer freezes - tasks.md Group 9). parent_meta itself
      ! declares no imports of its own, so this call on it is a no-op
      ! other than resolving the MatchConnection it declares between its
      ! two children.
      call gb%run_connect_hook(src_meta)
      call gb%run_connect_hook(dst_meta)
      call gb%run_connect_hook(parent_meta)

      _RETURN(_SUCCESS)
   end subroutine make_two_child_fixture

   ! Spec scenario "Cycle reaching the iteration limit without
   ! convergence fails explicitly": an import that can never be
   ! resolved is still unresolved once the whole hierarchy is frozen
   ! (the fixed schedule has run out) - the hard error check raises an
   ! explicit failure rather than only logging a warning, but freezing
   ! itself already succeeded for every component (component
   ! initialization is not aborted - design.md Risks "still caught...
   ! downgraded to a logged failure").
   @test(npes=[0])
   subroutine test_unresolved_import_after_freeze_fails_explicitly(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta
      type(ComponentGraph), pointer :: parent_graph
      type(GraphBuilder) :: gb
      integer :: status

      call make_two_child_fixture(parent_meta, leave_unresolved=.true., _RC)

      call gb%run_graph_freeze_hook(parent_meta)
      @assertExceptionRaised( &
           'GraphBuilder: unresolved required import(s) remain once the fixed realize/accept/realize '// &
           'schedule ends (griddedcomponentdriver-integration-lifecycle design.md "REQ-MTH-011 step (c) convergence")')

      ! freeze() itself already succeeded (for every component in the
      ! hierarchy) before the new check ran - the hard error does not
      ! roll that back.
      parent_graph => parent_meta%get_component_graph()
      @assert_that(parent_graph%is_frozen(), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_unresolved_import_after_freeze_fails_explicitly

   ! Spec scenario "Cycle converging within the iteration limit proceeds
   ! normally": every declared import resolves by the time the whole
   ! hierarchy freezes - no exception, ordinary success.
   !
   ! openspec/changes/hierarchy-wide-component-graph, tasks.md 9.2/9.3:
   ! also directly confirms the hierarchy-wide property itself - every
   ! component in the hierarchy (both children, not merely the root
   ! parent_meta on which run_graph_freeze_hook was called) reports
   ! frozen afterward. A single run_graph_freeze_hook(parent_meta) call
   ! walking only parent_meta's own graph (the old, per-component
   ! behavior) would leave src_meta/dst_meta's own graphs unfrozen -
   ! this assertion is what distinguishes "hierarchy-wide" from
   ! "per-component, called once more."
   @test(npes=[0])
   subroutine test_fully_resolved_proceeds_without_error(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ComponentGraph), pointer :: parent_graph, src_graph, dst_graph
      type(GraphBuilder) :: gb
      integer :: status

      call make_two_child_fixture(parent_meta, leave_unresolved=.false., _RC)

      call gb%run_graph_freeze_hook(parent_meta)

      parent_graph => parent_meta%get_component_graph()
      @assert_that(parent_graph%is_frozen(), is(true()))

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      @assert_that(src_graph%is_frozen(), is(true()))
      @assert_that(dst_graph%is_frozen(), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_fully_resolved_proceeds_without_error

   ! openspec/changes/hierarchy-wide-component-graph, tasks.md 9.3
   ! ("Update frozen-structure-rejects-mutation test coverage to
   ! exercise attempted mutation from an arbitrary component anywhere
   ! in an already-frozen hierarchy, not only the component that issued
   ! the freeze call"): a non-root child's own graph - never the
   ! component run_graph_freeze_hook was directly called on - rejects a
   ! mutation attempt once the hierarchy-wide freeze has run, exactly as
   ! graph/component-hierarchy's own "Frozen structure rejects mutation"
   ! scenario requires.
   @test(npes=[0])
   subroutine test_mutation_rejected_from_arbitrary_hierarchy_component(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta
      type(GriddedComponentDriver) :: src_driver
      type(ESMF_GridComp) :: src_gc
      type(ComponentGraph), pointer :: src_graph
      type(NodeId) :: bogus_id
      type(GraphBuilder) :: gb
      integer :: status

      call make_two_child_fixture(parent_meta, leave_unresolved=.false., _RC)
      call gb%run_graph_freeze_hook(parent_meta)

      src_driver = parent_meta%get_child('child_src', _RC)
      src_gc = src_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      src_graph => src_meta%get_component_graph()
      @assert_that(src_graph%is_frozen(), is(true()))

      ! child_src never itself called run_graph_freeze_hook (only
      ! parent_meta, the hierarchy root, did) - its own graph is frozen
      ! purely as a consequence of the hierarchy-wide walk. Attempting
      ! to register a fresh node on it now must fail, exactly as it
      ! would for the root.
      bogus_id = src_graph%next_node_id(rc=status)
      @assertExceptionRaised('ComponentGraph: next_node_id called on a frozen graph')

      _UNUSED_DUMMY(this)
   end subroutine test_mutation_rejected_from_arbitrary_hierarchy_component

   ! Task 5.3 (regression), updated for tasks.md Group 9's new call
   ! site: a second call to run_graph_freeze_hook on an already-frozen,
   ! fully-resolved hierarchy is a safe no-op - it must not re-raise the
   ! hard-error check with stale/inconsistent state, and must not
   ! attempt to mutate the already-frozen graph (ComponentGraph%freeze()
   ! is itself idempotent, ComponentGraph.F90 graph_freeze - "Idempotent
   ! if already frozen").
   @test(npes=[0])
   subroutine test_second_call_on_frozen_graph_is_noop(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta
      type(ComponentGraph), pointer :: parent_graph
      type(GraphBuilder) :: gb
      integer :: status

      call make_two_child_fixture(parent_meta, leave_unresolved=.false., _RC)

      call gb%run_graph_freeze_hook(parent_meta)
      parent_graph => parent_meta%get_component_graph()
      @assert_that(parent_graph%is_frozen(), is(true()))

      ! Second invocation - no exception expected, graph remains frozen.
      call gb%run_graph_freeze_hook(parent_meta)
      @assert_that(parent_graph%is_frozen(), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_second_call_on_frozen_graph_is_noop

end module Test_GraphBuilder_ConvergenceCheck
