#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! Convergence check: the realize/accept/realize
! initialization cycle terminates on defined convergence or fails explicitly.
! The hard-error check for an unresolved required import lives in a single,
! hierarchy-wide call - GraphBuilder%run_graph_freeze_hook, the
! GENERIC_INIT_GRAPH_FREEZE phase's own entry point (OuterMetaComponent/
! initialize_graph_freeze.F90) - run exactly once, at the hierarchy root, after
! every component's own connections are resolved (run_connect_hook, which no
! longer freezes or checks convergence itself).
!
! Test-only OuterMetaComponent instances are built the same way
! Test_GraphBuilder.pf does (bypassing SetServices/DSO machinery).
module Test_GraphBuilder_ConvergenceCheck
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_NodeId_mod, only: NodeId
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_ChildSpec_mod, only: ChildSpec
   use mapl_ComponentSpec_mod, only: ComponentSpec
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_ConnectionPt_mod, only: ConnectionPt
   use mapl_VirtualConnectionPt_mod, only: VirtualConnectionPt
   use mapl_MatchConnection_mod, only: MatchConnection
   use mapl_GraphResolutionEntry_mod, only: GraphResolutionEntry
   use mapl_GraphResolutionEntryVector_mod, only: GraphResolutionEntryVector
   use gFTL2_StringVector, only: StringVector
   use GraphBuilderTestSupport_mod, only: make_outer_meta, make_var
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_StateItemDescriptor_mod, only: StateItemDescriptor
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristic
   use mapl_StateItemCharacteristicKind_mod, only: TYPE_KIND_CHARACTERISTIC_KIND
   use mapl_CharacteristicStatus_mod, only: CHARACTERISTIC_STATUS_DEFERRED
   use mapl_PortIdNodeIdMap_mod, only: PortIdNodeIdMap, PortIdNodeIdMapIterator, operator(/=)
   use mapl_FieldDictionaryConfig_mod, only: FieldDictionaryConfig, &
        set_field_dictionary_config, get_field_dictionary_config
   use esmf
   use pfunit
   implicit none(type, external)

   type(FieldDictionaryConfig), save :: saved_fd_config

contains

   @before
   subroutine save_validation_config(this)
      class(MpiTestMethod), intent(inout) :: this

      saved_fd_config = get_field_dictionary_config()
      _UNUSED_DUMMY(this)
   end subroutine save_validation_config

   @after
   subroutine restore_validation_config(this)
      class(MpiTestMethod), intent(inout) :: this

      call set_field_dictionary_config(saved_fd_config)
      _UNUSED_DUMMY(this)
   end subroutine restore_validation_config

   subroutine use_validation(content)
      character(*), intent(in) :: content
      type(ESMF_HConfig) :: node

      node = ESMF_HConfigCreate(content=content)
      call set_field_dictionary_config(FieldDictionaryConfig(node))
      call ESMF_HConfigDestroy(node)
   end subroutine use_validation

   ! make_outer_meta/make_var shared via GraphBuilderTestSupport_mod
   ! (docs/graph/spec/20-implementation-roadmap.md sec 20.4.17).
   ! make_outer_meta does not pass a hierarchy_id to
   ! init_meta - matching every real top-level/cap component, this
   ! makes `outer_meta` the true root of its own one-component
   ! hierarchy (OuterMetaComponent.F90's own is_hierarchy_root
   ! field-declaration comment) - required for run_graph_freeze_hook
   ! below to be anything other than a no-op when called on it.

   ! Shared two-child (child_src/child_dst) parent fixture, matching
   ! Test_GraphBuilder.pf's own connect_all-style MatchConnection shape.
   ! When leave_unresolved is .true., child_dst additionally declares an
   ! import ('Q') with no matching export - the never-resolvable case.
   ! Resolves connections on both children (run_connect_hook) but does
   ! NOT freeze or check convergence - callers do that explicitly via
   ! run_graph_freeze_hook, called once on parent_meta (the hierarchy
   ! root), matching the real lifecycle's own GENERIC_INIT_GRAPH_FREEZE
   ! phase ordering (resolve everywhere first, freeze+check once, after).
   subroutine make_two_child_fixture(parent_meta, leave_unresolved, &
        fallback_warnings, rc)
      type(OuterMetaComponent), pointer, intent(out) :: parent_meta
      logical, intent(in) :: leave_unresolved
      type(GraphResolutionEntryVector), optional, intent(out) :: fallback_warnings
      integer, optional, intent(out) :: rc

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec, src_spec, dst_spec
      type(MatchConnection) :: conn
      type(GraphBuilder) :: gb
      integer :: status

      call make_outer_meta('comp_convergence_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_src', child_spec, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('child_dst', child_spec, _RC)

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)

      src_spec => src_meta%get_component_spec()
      call src_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, 'T'))

      dst_spec => dst_meta%get_component_spec()
      call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'T'))
      if (leave_unresolved) then
         call dst_spec%add_var_spec(make_var(ESMF_STATEINTENT_IMPORT, 'Q')) ! never matched
      end if

      call gb%run_advertise_hook(src_meta)
      call gb%run_advertise_hook(dst_meta)

      conn = MatchConnection( &
           ConnectionPt('child_src', VirtualConnectionPt(state_intent='export', short_name='^.*$')), &
           ConnectionPt('child_dst', VirtualConnectionPt(state_intent='import', short_name='^.*$')))
      parent_spec => parent_meta%get_component_spec()
      call parent_spec%add_connection(conn)

      ! connect()-time resolution on every component (matches the real
      ! lifecycle's own per-component GENERIC_INIT_ACCEPT_TRANSFER call,
      ! which does not freeze). parent_meta itself declares no imports of its
      ! own, so this call on it is a no-op other than resolving the
      ! MatchConnection it declares between its two children.
      if (present(fallback_warnings)) then
         call gb%run_connect_hook(src_meta, fallback_warnings)
      else
         call gb%run_connect_hook(src_meta)
      end if
      call gb%run_connect_hook(dst_meta)
      call gb%run_connect_hook(parent_meta)

      _RETURN(_SUCCESS)
   end subroutine make_two_child_fixture

   @test(npes=[0])
   subroutine test_quantity_type_permissive_fallback_wires(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta
      type(GraphResolutionEntryVector) :: warnings
      type(GraphBuilder) :: gb
      integer :: status

      call use_validation( &
           '{validation_mode: permissive, require_quantity_type: false}')
      call make_two_child_fixture(parent_meta, leave_unresolved=.false., &
           fallback_warnings=warnings, _RC)

      @assertEqual(1, warnings%size())
      @assertFalse(parent_meta%has_waiting_connections())
      call gb%run_graph_freeze_hook(parent_meta)

      _UNUSED_DUMMY(this)
   end subroutine test_quantity_type_permissive_fallback_wires

   @test(npes=[0])
   subroutine test_quantity_type_strict_without_requirement_falls_back(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta
      type(GraphResolutionEntryVector) :: warnings
      type(GraphBuilder) :: gb
      integer :: status

      call use_validation( &
           '{validation_mode: strict, require_quantity_type: false}')
      call make_two_child_fixture(parent_meta, leave_unresolved=.false., &
           fallback_warnings=warnings, _RC)

      @assertEqual(1, warnings%size())
      @assertFalse(parent_meta%has_waiting_connections())
      call gb%run_graph_freeze_hook(parent_meta)

      _UNUSED_DUMMY(this)
   end subroutine test_quantity_type_strict_without_requirement_falls_back

   @test(npes=[0])
   subroutine test_quantity_type_required_is_fatal_in_permissive_mode(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, src_meta
      type(GraphResolutionEntryVector) :: warnings
      type(GraphBuilder) :: gb
      integer :: status

      call use_validation( &
           '{validation_mode: permissive, require_quantity_type: true}')
      call make_two_child_fixture(parent_meta, leave_unresolved=.false., &
           fallback_warnings=warnings, _RC)
      src_meta => parent_meta%get_child_outer_meta('child_src', _RC)

      @assertEqual(0, warnings%size())
      call gb%run_graph_freeze_hook(parent_meta)
      @assertExceptionRaised('StateItemDescriptor: item ' // &
           src_meta%get_name() // &
           ':T has characteristic QUANTITY_TYPE still DEFERRED at freeze')
      @assertExceptionRaised('GraphBuilder: characteristics unresolved at freeze')

      _UNUSED_DUMMY(this)
   end subroutine test_quantity_type_required_is_fatal_in_permissive_mode

   @test(npes=[0])
   subroutine test_quantity_type_fallback_warning_is_summarized(this)
      class(MpiTestMethod), intent(inout) :: this

      character(2), parameter :: names(6) = ['T ', 'Q ', 'U ', 'V ', &
           'PS', 'TS']
      type(ESMF_GridComp) :: outer_gc
      type(OuterMetaComponent), pointer :: outer_meta
      type(ComponentSpec), pointer :: comp_spec
      type(GraphResolutionEntryVector) :: warnings
      type(GraphResolutionEntry), pointer :: entry
      type(GraphBuilder) :: gb
      integer :: i, status

      call use_validation( &
           '{validation_mode: permissive, require_quantity_type: false}')
      call make_outer_meta('comp_quantity_fallback', outer_gc, outer_meta, _RC)
      comp_spec => outer_meta%get_component_spec()
      do i = 1, size(names)
         call comp_spec%add_var_spec(make_var(ESMF_STATEINTENT_EXPORT, &
              trim(names(i))))
      end do
      call gb%run_advertise_hook(outer_meta)

      call gb%run_connect_hook(outer_meta, warnings)

      @assertEqual(1, warnings%size())
      entry => warnings%at(1, status)
      @assertEqual(0, status)
      @assertEqual(outer_meta%get_name(), entry%component_name)
      @assertEqual('', entry%short_name)
      @assertEqual('6 items fell back to UNCHECKED (QUANTITY_TYPE not supplied): T, Q, U, V, PS, ...', &
           entry%reason)

      _UNUSED_DUMMY(this)
   end subroutine test_quantity_type_fallback_warning_is_summarized

   ! Spec scenario "Cycle reaching the iteration limit without convergence
   ! fails explicitly": an import that can never be resolved is still
   ! unresolved once the whole hierarchy is frozen (the fixed schedule has run
   ! out) - the hard error check raises an explicit failure rather than only
   ! logging a warning, but freezing itself already succeeded for every
   ! component (component initialization is not aborted - "still caught...
   ! downgraded to a logged failure").
   @test(npes=[0])
   subroutine test_unresolved_import_after_freeze_fails_explicitly(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta
      type(ComponentGraph), pointer :: parent_graph
      type(GraphBuilder) :: gb
      integer :: status

      call make_two_child_fixture(parent_meta, leave_unresolved=.true., _RC)

      call gb%run_graph_freeze_hook(parent_meta)
      @assertExceptionRaised( &
           'GraphBuilder: unresolved required import(s) remain once the fixed realize/accept/realize '// &
           'schedule ends (griddedcomponentdriver-integration-lifecycle design.md "REQ-MTH-011 step (c) convergence")')

      ! freeze() itself already succeeded (for every component in the
      ! hierarchy) before the new check ran - the hard error does not
      ! roll that back.
      parent_graph => parent_meta%get_component_graph()
      @assert_that(parent_graph%is_frozen(), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_unresolved_import_after_freeze_fails_explicitly

   ! Spec scenario "Cycle converging within the iteration limit proceeds
   ! normally": every declared import resolves by the time the whole
   ! hierarchy freezes - no exception, ordinary success.
   !
   ! Also directly confirms the hierarchy-wide property itself - every
   ! component in the hierarchy (both children, not merely the root parent_meta
   ! on which run_graph_freeze_hook was called) reports frozen afterward. A
   ! single run_graph_freeze_hook(parent_meta) call walking only parent_meta's
   ! own graph (the old, per-component behavior) would leave
   ! src_meta/dst_meta's own graphs unfrozen - this assertion is what
   ! distinguishes "hierarchy-wide" from "per-component, called once more."
   @test(npes=[0])
   subroutine test_fully_resolved_proceeds_without_error(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta, dst_meta
      type(GriddedComponentDriver) :: src_driver, dst_driver
      type(ESMF_GridComp) :: src_gc, dst_gc
      type(ComponentGraph), pointer :: parent_graph, src_graph, dst_graph
      type(GraphBuilder) :: gb
      integer :: status

      call make_two_child_fixture(parent_meta, leave_unresolved=.false., _RC)

      call gb%run_graph_freeze_hook(parent_meta)

      parent_graph => parent_meta%get_component_graph()
      @assert_that(parent_graph%is_frozen(), is(true()))

      src_driver = parent_meta%get_child('child_src', _RC)
      dst_driver = parent_meta%get_child('child_dst', _RC)
      src_gc = src_driver%get_gridcomp()
      dst_gc = dst_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      dst_meta => get_outer_meta(dst_gc, _RC)
      src_graph => src_meta%get_component_graph()
      dst_graph => dst_meta%get_component_graph()
      @assert_that(src_graph%is_frozen(), is(true()))
      @assert_that(dst_graph%is_frozen(), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_fully_resolved_proceeds_without_error

   ! Attempted mutation from an arbitrary component anywhere in an
   ! already-frozen hierarchy, not only the component that issued the freeze
   ! call: a non-root child's own graph - never the component
   ! run_graph_freeze_hook was directly called on - rejects a mutation attempt
   ! once the hierarchy-wide freeze has run (the "Frozen structure rejects
   ! mutation" scenario).
   @test(npes=[0])
   subroutine test_mutation_rejected_from_arbitrary_hierarchy_component(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta
      type(OuterMetaComponent), pointer :: src_meta
      type(GriddedComponentDriver) :: src_driver
      type(ESMF_GridComp) :: src_gc
      type(ComponentGraph), pointer :: src_graph
      type(NodeId) :: bogus_id
      type(GraphBuilder) :: gb
      integer :: status

      call make_two_child_fixture(parent_meta, leave_unresolved=.false., _RC)
      call gb%run_graph_freeze_hook(parent_meta)

      src_driver = parent_meta%get_child('child_src', _RC)
      src_gc = src_driver%get_gridcomp()
      src_meta => get_outer_meta(src_gc, _RC)
      src_graph => src_meta%get_component_graph()
      @assert_that(src_graph%is_frozen(), is(true()))

      ! child_src never itself called run_graph_freeze_hook (only
      ! parent_meta, the hierarchy root, did) - its own graph is frozen
      ! purely as a consequence of the hierarchy-wide walk. Attempting
      ! to register a fresh node on it now must fail, exactly as it
      ! would for the root.
      bogus_id = src_graph%next_node_id(rc=status)
      @assertExceptionRaised('ComponentGraph: next_node_id called on a frozen graph')

      _UNUSED_DUMMY(this)
   end subroutine test_mutation_rejected_from_arbitrary_hierarchy_component

   ! A second call to
   ! run_graph_freeze_hook on an already-frozen, fully-resolved hierarchy is a
   ! safe no-op - it must not re-raise the hard-error check with
   ! stale/inconsistent state, and must not attempt to mutate the
   ! already-frozen graph (ComponentGraph%freeze is itself idempotent,
   ! ComponentGraph.F90 graph_freeze - "Idempotent if already frozen").
   @test(npes=[0])
   subroutine test_second_call_on_frozen_graph_is_noop(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta
      type(ComponentGraph), pointer :: parent_graph
      type(GraphBuilder) :: gb
      integer :: status

      call make_two_child_fixture(parent_meta, leave_unresolved=.false., _RC)

      call gb%run_graph_freeze_hook(parent_meta)
      parent_graph => parent_meta%get_component_graph()
      @assert_that(parent_graph%is_frozen(), is(true()))

      ! Second invocation - no exception expected, graph remains frozen.
      call gb%run_graph_freeze_hook(parent_meta)
      @assert_that(parent_graph%is_frozen(), is(true()))

      _UNUSED_DUMMY(this)
   end subroutine test_second_call_on_frozen_graph_is_noop

   ! A characteristic still DEFERRED at freeze fails the freeze hook with a
   ! message naming the item and the kind.
   @test(npes=[0])
   subroutine test_deferred_characteristic_at_freeze_fails(this)
      class(MpiTestMethod), intent(inout) :: this

      type(OuterMetaComponent), pointer :: parent_meta, dst_meta
      type(GriddedComponentDriver) :: dst_driver
      type(ESMF_GridComp) :: dst_gc
      type(ComponentGraph), pointer :: dst_graph
      type(PortIdNodeIdMap), target :: import_ports
      type(PortIdNodeIdMapIterator) :: iter
      class(GraphNode), pointer :: node
      type(StateItemDescriptor), pointer :: descriptor
      class(StateItemCharacteristic), allocatable :: type_kind
      type(GraphBuilder) :: gb
      logical :: marked
      integer :: status

      call make_two_child_fixture(parent_meta, leave_unresolved=.false., _RC)

      dst_driver = parent_meta%get_child('child_dst', _RC)
      dst_gc = dst_driver%get_gridcomp()
      dst_meta => get_outer_meta(dst_gc, _RC)
      dst_graph => dst_meta%get_component_graph()

      marked = .false.
      import_ports = dst_graph%get_import_ports()
      associate (e => import_ports%ftn_end())
         iter = import_ports%ftn_begin()
         do while (iter /= e)
            call iter%next()
            node => dst_graph%get_node(iter%second())
            select type (node)
            class is (StateItemNode)
               if (node%get_short_name() /= 'T') cycle
               descriptor => node%get_descriptor()
               call descriptor%get_characteristic(TYPE_KIND_CHARACTERISTIC_KIND, type_kind, _RC)
               call type_kind%set_status(CHARACTERISTIC_STATUS_DEFERRED)
               call descriptor%set_characteristic(TYPE_KIND_CHARACTERISTIC_KIND, type_kind, _RC)
               marked = .true.
            end select
         end do
      end associate
      @assertTrue(marked, 'import T not found in child_dst graph')

      call gb%run_graph_freeze_hook(parent_meta)
      @assertExceptionRaised('StateItemDescriptor: item ' // dst_meta%get_name() // ':T has characteristic TYPE_KIND still DEFERRED at freeze')
      @assertExceptionRaised('GraphBuilder: characteristics unresolved at freeze')

      _UNUSED_DUMMY(this)
   end subroutine test_deferred_characteristic_at_freeze_fails

end module Test_GraphBuilder_ConvergenceCheck
