#include "MAPL_TestErr.h"
#include "unused_dummy.H"

! openspec/changes/horizontal-geometry-graph-state-item (Phase 4e),
! tasks 4.3/4.4: GraphBuilder's geometry hook
! (run_geometry_hook/advertise_geometry/resolve_geometry_from_child/
! push_geometry_to_child), covering REQ-GEO-002's three single-source
! cases and the mismatch-fails-loudly path.
!
! Entirely gated behind mapl_GraphMode_mod%graph_mode() reporting
! something other than GRAPH_MODE_REGISTRY - every test here explicitly
! selects GRAPH_MODE_GRAPH (set_graph_mode(GRAPH_MODE_GRAPH)) and
! restores GRAPH_MODE_REGISTRY afterward, mirroring
! mapl_ExtensionResolution_mod%set_materialize_extensions's own
! test-only-setter precedent.
!
! Test-only OuterMetaComponent instances are built the same way
! Test_GraphBuilder.pf does (bypassing SetServices/DSO machinery);
! geometry is given directly via OuterMetaComponent%set_geom (the same
! accessor initialize_geom_a.F90/propagate_geom_to_children.F90 already
! use in production) rather than by driving the full GEOM_A/GEOM_B
! lifecycle phases, since the hook under test only ever reads
! this%get_geom()/this%has_geom() - it does not re-derive GeometrySpec's
! own resolution.
!
! type=ESMF_TestMethod, npes=[1] on every test here (Test_GraphBuilder.pf's
! own test_materialize_extensions_enabled_creates_real_field precedent):
! make_test_geom calls real, collective ESMF entry points
! (ESMF_GridCreateNoPeriDim/ESMF_GeomCreate) - a plain MpiTestMethod
! sub-communicator does not reconfigure ESMF's own default VM, so those
! calls would synchronize against this suite's full ambient multi-PE
! test world and deadlock without ESMF_TestMethod's per-test VM scoping.
module Test_GraphGeometryHook
   use mapl_OuterMetaComponent_mod
   use mapl_GraphBuilder_mod
   use mapl_GraphMode_mod, only: set_graph_mode, GRAPH_MODE_GRAPH, GRAPH_MODE_REGISTRY
   use mapl_GeometrySpec_mod, only: GeometrySpec, GEOMETRY_FROM_PARENT, GEOMETRY_FROM_CHILD
   use mapl_GeomId_mod, only: GeomId, GeomIdManager, get_geom_id_manager
   use mapl_GeomUtilities_mod, only: GeomSetId
   use mapl_ComponentGraph_mod, only: ComponentGraph
   use mapl_DependencyNetwork_mod, only: DependencyNetwork
   use mapl_DependencyNetworkId_mod, only: DependencyNetworkId
   use mapl_GriddedComponentDriver_mod, only: GriddedComponentDriver
   use mapl_ChildSpec_mod, only: ChildSpec
   use mapl_ComponentSpec_mod, only: ComponentSpec
   use mapl_NodeId_mod, only: NodeId, operator(==)
   use mapl_GraphNode_mod, only: GraphNode
   use mapl_StateItemNode_mod, only: StateItemNode
   use mapl_GraphStateItem_mod, only: GraphStateItem
   use mapl_StateItemFlag_mod, only: MAPL_STATEITEM_GEOM, MAPL_STATEITEM_VERTICALGRID, operator(==)
   ! -- openspec/changes/vertical-grid-graph-state-item (Phase 4f) -------
   use mapl_VariableSpec_mod, only: VariableSpec
   use mapl_StateItemDescriptor_mod, only: StateItemDescriptor
   use mapl_MultiState_mod, only: MultiState
   use mapl_StateItemMemberMap_mod, only: StateItemMemberMap
   use mapl_StateItem_mod, only: MAPL_STATEITEM_STATE
   ! ----------------------------------------------------------------------
   use esmf, only: ESMF_STATEINTENT_EXPORT
   use esmf, only: ESMF_Geom, ESMF_GeomCreate
   use esmf, only: ESMF_Grid, ESMF_GridCreateNoPeriDim
   use esmf, only: ESMF_GridComp, ESMF_GridCompCreate
   use esmf, only: ESMF_HConfig, ESMF_HConfigCreate
   use GraphBuilderTestSupport_mod, only: make_outer_meta
   use mapl_VerticalStaggerLoc_mod, only: VerticalStaggerLoc, VERTICAL_STAGGER_NONE, VERTICAL_STAGGER_CENTER, &
        VERTICAL_STAGGER_EDGE
   use mapl_StateItemCharacteristic_mod, only: StateItemCharacteristic
   use mapl_VerticalStaggerCharacteristic_mod, only: VerticalStaggerCharacteristic
   use mapl_CharacteristicStatus_mod, only: CharacteristicStatus, operator(==), &
        CHARACTERISTIC_STATUS_SPECIFIED, CHARACTERISTIC_STATUS_DEFERRED
   use mapl_StateItemCharacteristicKind_mod, only: QUANTITY_TYPE_CHARACTERISTIC_KIND
   use mapl_field_api, only: MAPL_FieldSet
   use mapl_field_bundle_api, only: MAPL_FieldBundleSet
   use mapl_QuantityTypeCharacteristic_mod, only: QuantityTypeCharacteristic
   use mapl_QuantityTypeMetadata_mod, only: QuantityTypeMetadata
   use mapl_QuantityType_mod, only: QUANTITY_UNKNOWN, QUANTITY_TEMPERATURE, &
        QUANTITY_MIXING_RATIO, BASIS_NONE, BASIS_DRY_MASS, BASIS_WET_MASS, &
        operator(==)
   use mapl_geom_api, only: mapl_new_GeomId
   use mapl_StateItemCharacteristicKind_mod, only: VERTICAL_GRID_CHARACTERISTIC_KIND, VERTICAL_STAGGER_CHARACTERISTIC_KIND
   use mapl_vertical_grid_api, only: mapl_BasicVerticalGrid
   use mapl_HorizontalDimsSpec_mod, only: HORIZONTAL_DIMS_NONE
   use mapl_GeometryCharacteristic_mod, only: GeometryCharacteristic
   use mapl_StateItemCharacteristicKind_mod, only: GEOMETRY_CHARACTERISTIC_KIND
   use mapl_CharacteristicStatus_mod, only: CHARACTERISTIC_STATUS_UNCHECKED
   use mapl_geom_api, only: mapl_SameGeom
   use ESMF_TestMethod_mod
   use esmf
   use pfunit
   implicit none(type, external)

contains

   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_fills_unchecked_geometry_without_deferred(this)
      class(ESMF_TestMethod), intent(inout) :: this
      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: spec
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: id
      class(GraphNode), pointer :: node
      type(StateItemDescriptor), pointer :: descriptor
      class(StateItemCharacteristic), allocatable :: characteristic
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_Geom) :: geom
      type(ESMF_Geom), allocatable :: harvested
      type(ESMF_Field) :: field
      type(VariableSpec) :: var
      type(GraphBuilder) :: gb
      integer :: status

      call make_outer_meta('unchecked_geom_harvest', gc, meta, _RC)
      var%state_intent = ESMF_STATEINTENT_EXPORT
      var%short_name = 'T'
      var%horizontal_dims_spec = HORIZONTAL_DIMS_NONE
      var%vertical_stagger = VERTICAL_STAGGER_NONE
      var%quantity_type = QUANTITY_TEMPERATURE
      spec => meta%get_component_spec()
      call spec%add_var_spec(var)
      call gb%advertise(meta, rc=status)
      @assertEqual(0, status)
      graph => meta%get_component_graph()
      id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      node => graph%get_node(id)
      select type (node)
      class is (StateItemNode)
         descriptor => node%get_descriptor()
      class default
         @assertTrue(.false.)
         return
      end select
      @assertEqual(0, size(descriptor%get_unresolved_kinds()))
      call descriptor%get_characteristic( &
           GEOMETRY_CHARACTERISTIC_KIND, characteristic, rc=status)
      @assertEqual(0, status)
      select type (characteristic)
      class is (GeometryCharacteristic)
         @assertTrue(characteristic%get_status() == &
              CHARACTERISTIC_STATUS_UNCHECKED)
         @assertFalse(characteristic%has_geom())
      class default
         @assertTrue(.false.)
         return
      end select
      geom = make_test_geom(_RC)
      field = ESMF_FieldCreate(geom=geom, typekind=ESMF_TYPEKIND_R4, &
           name='T', rc=status)
      @assertEqual(0, status)
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      call ESMF_StateAdd(states%exportState, [field], rc=status)
      @assertEqual(0, status)
      call gb%harvest_deferred(meta, rc=status)
      @assertEqual(0, status)
      deallocate(characteristic)
      call descriptor%get_characteristic( &
           GEOMETRY_CHARACTERISTIC_KIND, characteristic, rc=status)
      @assertEqual(0, status)
      select type (characteristic)
      class is (GeometryCharacteristic)
         @assertTrue(characteristic%has_geom())
         @assertTrue(characteristic%get_status() == &
              CHARACTERISTIC_STATUS_UNCHECKED)
         if (characteristic%has_geom()) then
            harvested = characteristic%get_geom()
            @assertTrue(mapl_SameGeom(geom, harvested))
         end if
      end select
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_fills_unchecked_geometry_without_deferred

   ! make_outer_meta shared via GraphBuilderTestSupport_mod
   ! (docs/graph/spec/20-implementation-roadmap.md sec 20.4.17,
   ! sub-step 17-1).

   ! Same helper as Test_GeomProxyField.pf's own make_test_geom - a
   ! freshly-created, untagged (no GeomId yet) real ESMF_Geom.
   ! Unlike Test_GeomProxyField.pf's own make_test_geom, this one
   ! immediately tags the geom with a fresh GeomId (mirroring how a real
   ! geom sourced from mapl_GeomManager/MaplGeom%set_id already arrives
   ! pre-tagged before any OuterMetaComponent%set_geom call ever sees
   ! it). This matters here specifically because OuterMetaComponent%
   ! set_geom's own fallback (mint a fresh id when none is present) has
   ! no public way to write that freshly-minted id back onto the geom's
   ! own Info - only propagate_geom_to_children.F90/initialize_geom_a.F90
   ! can do that, via same-module private field access
   ! (child_meta%geom_id = this%geom_id) this test module does not have.
   ! Pre-tagging here is what lets two independent set_geom calls on the
   ! same (or a copied handle to the same) geom agree on one GeomId, the
   ! way production code's two-step field-then-set_geom sequence does.
   function make_test_geom(rc) result(geom)
      integer, optional, intent(out) :: rc
      type(ESMF_Geom) :: geom

      type(ESMF_Grid) :: grid
      type(GeomIdManager), pointer :: manager
      type(GeomId) :: new_id
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(countsPerDeDim1=[2], countsPerDeDim2=[2], _RC)
      geom = ESMF_GeomCreate(grid=grid, _RC)

      ! Bound to named variables, not chained (a type-bound call cannot
      ! be invoked directly on another type-bound call's non-pointer
      ! function result - see GraphBuilder.F90's own comment on this).
      manager => get_geom_id_manager()
      new_id = manager%get_next_geom_id()
      call GeomSetId(geom, new_id%get_value(), _RC)

      _RETURN(_SUCCESS)
   end function make_test_geom

   ! REQ-GEO-002 "a component providing its own geometry": no import
   ! resolution needed - the geometry item is available directly after
   ! advertise_geometry, tagged with the GEOM variant.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_own_geometry_needs_no_resolution(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(ComponentGraph), pointer :: graph
      type(ESMF_Geom) :: geom
      type(NodeId), pointer :: geom_id
      class(GraphNode), pointer :: node
      type(GraphStateItem) :: payload
      integer :: status
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)

      call make_outer_meta('geom_own', gc, meta, _RC)
      geom = make_test_geom(_RC)
      call meta%set_geom(geom)

      call gb%run_geometry_hook(meta)

      graph => meta%get_component_graph()
      geom_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, GEOMETRY_ITEM_NAME))
      @assert_that(associated(geom_id), is(true()))

      node => graph%get_node(geom_id)
      select type (node)
      class is (StateItemNode)
         payload = node%get_payload()
      class default
         @assert_that(.false., is(true()))
      end select
      @assert_that(payload%variant(rc=status) == MAPL_STATEITEM_GEOM, is(true()))

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_own_geometry_needs_no_resolution

   ! REQ-GEO-002 "a component receiving geometry from an ancestor"
   ! (GEOMETRY_FROM_PARENT, the default GeometrySpec kind): the parent
   ! wires a direct dependency edge from its own real geometry NodeId to
   ! the child's own real geometry NodeId, in the CHILD's own graph (no
   ! proxy on either side - openspec/changes/hierarchy-wide-component-
   ! graph, tasks.md 4.1/4.2).
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_child_receives_geometry_from_parent(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta, child_meta
      type(GriddedComponentDriver) :: child_driver
      type(ESMF_GridComp) :: child_gc
      type(ChildSpec) :: child_spec
      type(ComponentGraph), pointer :: parent_graph, child_graph
      type(ESMF_Geom) :: geom
      type(NodeId), pointer :: parent_own_id, child_own_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)

      call make_outer_meta('geom_parent', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('geom_child', child_spec, _RC)
      child_driver = parent_meta%get_child('geom_child', _RC)
      child_gc = child_driver%get_gridcomp()
      child_meta => get_outer_meta(child_gc, _RC)

      ! GeometrySpec's default kind is GEOMETRY_FROM_PARENT - no
      ! override needed on the child's own ComponentSpec.
      geom = make_test_geom(_RC)
      call parent_meta%set_geom(geom)
      ! Mirrors propagate_geom_to_children.F90's own effect by the time
      ! GENERIC_INIT_ADVERTISE runs (GEOM_B completes, hierarchy-wide,
      ! before ADVERTISE starts anywhere) - the child already has the
      ! parent's own (now GeomId-tagged) geom by the time its own
      ! advertise_geometry runs.
      geom = parent_meta%get_geom(_RC)
      call child_meta%set_geom(geom)

      ! Bottom-up: child's own hook completes before the parent's.
      call gb%run_geometry_hook(child_meta)
      call gb%run_geometry_hook(parent_meta)

      parent_graph => parent_meta%get_component_graph()
      child_graph => child_meta%get_component_graph()

      parent_own_id => parent_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, GEOMETRY_ITEM_NAME))
      child_own_id => child_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, GEOMETRY_ITEM_NAME))
      @assert_that(associated(parent_own_id), is(true()))
      @assert_that(associated(child_own_id), is(true()))

      ! The edge lives in the CHILD's own graph/network, connecting the
      ! parent's own real NodeId directly to the child's own real
      ! NodeId - no proxy, in either direction.
      net_id = child_graph%get_forward_network_id()
      net => child_graph%get_network(net_id)
      @assert_that(net%contains_dependency(parent_own_id, child_own_id), is(true()))

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_child_receives_geometry_from_parent

   ! REQ-GEO-002 "a component receiving geometry from a child"
   ! (GEOMETRY_FROM_CHILD): the parent wires a direct dependency edge
   ! from the child's own real geometry NodeId to its own real geometry
   ! NodeId, in the PARENT's own graph - structurally identical to an
   ! ordinary cross-boundary MatchConnection's own direct-edge wiring
   ! (openspec/changes/hierarchy-wide-component-graph, Group 3).
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_parent_receives_geometry_from_child(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta, child_meta
      type(GriddedComponentDriver) :: child_driver
      type(ESMF_GridComp) :: child_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec
      type(ComponentGraph), pointer :: parent_graph, child_graph
      type(ESMF_Geom) :: geom
      type(NodeId), pointer :: parent_own_id, child_own_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)

      call make_outer_meta('geom_parent2', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('geom_provider', child_spec, _RC)
      child_driver = parent_meta%get_child('geom_provider', _RC)
      child_gc = child_driver%get_gridcomp()
      child_meta => get_outer_meta(child_gc, _RC)

      parent_spec => parent_meta%get_component_spec()
      parent_spec%geometry_spec = GeometrySpec('geom_provider')
      @assert_that(parent_spec%geometry_spec%kind == GEOMETRY_FROM_CHILD, is(true()))

      geom = make_test_geom(_RC)
      call child_meta%set_geom(geom)
      ! Mirrors initialize_geom_a.F90's own FROM_CHILD branch effect:
      ! `this%geom_id = provider_meta%geom_id; call this%set_geom(provider_meta%geom)`.
      geom = child_meta%get_geom(_RC)
      call parent_meta%set_geom(geom)

      call gb%run_geometry_hook(child_meta)
      call gb%run_geometry_hook(parent_meta)

      parent_graph => parent_meta%get_component_graph()
      child_graph => child_meta%get_component_graph()

      parent_own_id => parent_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, GEOMETRY_ITEM_NAME))
      child_own_id => child_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, GEOMETRY_ITEM_NAME))
      @assert_that(associated(parent_own_id), is(true()))
      @assert_that(associated(child_own_id), is(true()))

      net_id = parent_graph%get_forward_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%contains_dependency(child_own_id, parent_own_id), is(true()))

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_parent_receives_geometry_from_child

   ! A genuine geometry mismatch (both sides independently resolved to
   ! different geoms - the "should be unreachable given GeometrySpec's
   ! own exclusive resolution" defensive case) is reported, not silently
   ! wired and not a crash: no dependency edge is added.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_mismatched_geometry_from_child_is_not_wired(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: parent_gc
      type(OuterMetaComponent), pointer :: parent_meta, child_meta
      type(GriddedComponentDriver) :: child_driver
      type(ESMF_GridComp) :: child_gc
      type(ChildSpec) :: child_spec
      type(ComponentSpec), pointer :: parent_spec
      type(ComponentGraph), pointer :: parent_graph, child_graph
      type(ESMF_Geom) :: parent_geom, child_geom
      type(NodeId), pointer :: parent_own_id, child_own_id
      type(DependencyNetwork), pointer :: net
      type(DependencyNetworkId) :: net_id
      integer :: status
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)

      call make_outer_meta('geom_parent3', parent_gc, parent_meta, _RC)
      child_spec = ChildSpec()
      call parent_meta%add_child('geom_provider2', child_spec, _RC)
      child_driver = parent_meta%get_child('geom_provider2', _RC)
      child_gc = child_driver%get_gridcomp()
      child_meta => get_outer_meta(child_gc, _RC)

      parent_spec => parent_meta%get_component_spec()
      parent_spec%geometry_spec = GeometrySpec('geom_provider2')

      ! Deliberately independent (untagged) geoms - each gets its own,
      ! distinct, freshly-assigned GeomId via set_geom, unlike the
      ! matching tests above which reuse the same tagged geom object.
      parent_geom = make_test_geom(_RC)
      child_geom = make_test_geom(_RC)
      call parent_meta%set_geom(parent_geom)
      call child_meta%set_geom(child_geom)

      call gb%run_geometry_hook(child_meta)
      call gb%run_geometry_hook(parent_meta)

      ! graphbuilder_run_geometry_hook swallows the failure into a
      ! logged warning (report_if_failed) rather than propagating rc -
      ! a GraphBuilder defect must never break real component
      ! initialization (design.md Risks) - but the underlying
      ! _ASSERT/_VERIFY chain still throws pFUnit-visible exceptions
      ! that must be explicitly consumed here, matching this test
      ! target's own established idiom (e.g. Test_MemoryCheckpoint.pf).
      @assertExceptionRaised('GraphBuilder: geometry from child geom_provider2 does not match the receiving component' // &
           ' own resolved geometry (unsupported: GEOMETRY) - should be unreachable given GeometrySpec own exclusive resolution')
      
      ! graphbuilder_resolve_geometry's own RC on the call into
      ! resolve_geometry_from_child adds one more generic layer, same
      ! precedent as Test_MemoryCheckpoint.pf/
      ! Test_OuterMetaComponentDriverResolver.pf's own multi-layer
      ! exception chains.
      @assertExceptionRaised('status=1')

      parent_graph => parent_meta%get_component_graph()
      child_graph => child_meta%get_component_graph()
      parent_own_id => parent_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, GEOMETRY_ITEM_NAME))
      @assert_that(associated(parent_own_id), is(true()))

      child_own_id => child_graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, GEOMETRY_ITEM_NAME))
      @assert_that(associated(child_own_id), is(true()))

      net_id = parent_graph%get_forward_network_id()
      net => parent_graph%get_network(net_id)
      @assert_that(net%contains_dependency(child_own_id, parent_own_id), is(false()))

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_mismatched_geometry_from_child_is_not_wired

   ! The toggle itself: run_geometry_hook is a documented no-op when
   ! graph-native mode is not enabled - the default for every real
   ! production run today.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_hook_is_noop_when_graph_native_disabled(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(ComponentGraph), pointer :: graph
      type(ESMF_Geom) :: geom
      type(NodeId), pointer :: geom_id
      integer :: status
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_REGISTRY)

      call make_outer_meta('geom_disabled', gc, meta, _RC)
      geom = make_test_geom(_RC)
      call meta%set_geom(geom)

      call gb%run_geometry_hook(meta)

      graph => meta%get_component_graph()
      geom_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, GEOMETRY_ITEM_NAME))
      @assert_that(associated(geom_id), is(false()))

      _UNUSED_DUMMY(this)
   end subroutine test_hook_is_noop_when_graph_native_disabled

   ! openspec/changes/vertical-grid-graph-state-item, task 4.1 / design.md
   ! D4: verifies the already-true structural fact this capability's
   ! geometry-association requirement relies on - a coordinate-set item
   ! materialized from a MAPL_STATEITEM_VERTICALGRID-tagged composite is
   ! registered in the SAME ComponentGraph as that component's own
   ! Phase-4e horizontal-geometry item, so the geometry is identifiable
   ! via the existing get_resource_index lookup without any new
   ! per-item reference mechanism. No new production code is exercised
   ! here beyond what groups 1-3 already added - this test is
   ! verification only.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_vertical_grid_member_shares_graph_with_geometry(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(ESMF_Geom) :: geom
      type(NodeId), pointer :: geom_node_id
      type(NodeId), pointer :: vgrid_top_id
      type(NodeId), pointer :: pressure_id
      class(GraphNode), pointer :: node
      type(GraphStateItem), pointer :: payload
      type(StateItemMemberMap), pointer :: members
      type(VariableSpec) :: vgrid
      integer :: status
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)

      call make_outer_meta('geom_and_vgrid', gc, meta, _RC)
      geom = make_test_geom(_RC)
      call meta%set_geom(geom)
      call gb%run_geometry_hook(meta)

      vgrid%state_intent = ESMF_STATEINTENT_EXPORT
      vgrid%short_name = 'MY_VGRID'
      vgrid%itemType = MAPL_STATEITEM_STATE
      vgrid%state_item_variant = MAPL_STATEITEM_VERTICALGRID
      block
         type(VariableSpec) :: pressure_member
         pressure_member%state_intent = ESMF_STATEINTENT_EXPORT
         pressure_member%short_name = 'PLE'
         call vgrid%declare_member('pressure', pressure_member, rc=status)
         @assert_that(status, is(0))
      end block
      comp_spec => meta%get_component_spec()
      call comp_spec%add_var_spec(vgrid)
      call gb%advertise(meta, status)
      @assert_that(status, is(0))

      graph => meta%get_component_graph()

      geom_node_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, GEOMETRY_ITEM_NAME))
      @assert_that(associated(geom_node_id), is(true()))

      vgrid_top_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'MY_VGRID'))
      @assert_that(associated(vgrid_top_id), is(true()))

      node => graph%get_node(vgrid_top_id)
      select type (node)
      class is (StateItemNode)
         payload => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      members => payload%state_members_ptr()
      pressure_id => members%at('pressure')
      @assert_that(associated(pressure_id), is(true()))

      ! The assertion this test exists for: the geometry item and the
      ! vertical-grid composite's own coordinate-set member both belong
      ! to the SAME ComponentGraph - no cross-graph lookup is needed to
      ! find "this component's own geometry" starting from a
      ! coordinate-set NodeId.
      @assert_that(graph%owns_node(geom_node_id), is(true()))
      @assert_that(graph%owns_node(pressure_id), is(true()))

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_vertical_grid_member_shares_graph_with_geometry

   ! A component with no default geom puts the geom on the item it
   ! realizes; harvest reads it back from the state and fills the DEFERRED
   ! characteristic without binding the node's handle. Before the item
   ! exists, nothing changes.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_fills_deferred_from_realized_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: t_id
      class(GraphNode), pointer :: node
      type(StateItemDescriptor), pointer :: descriptor
      type(GraphStateItem), pointer :: handle
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_State) :: export_state
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: field
      type(VariableSpec) :: var_spec
      integer :: status
      type(GraphBuilder) :: gb
      type(ESMF_StateItem_Flag) :: payload_kind
      type(ESMF_Field) :: payload_field
      type(ESMF_FieldStatus_Flag) :: payload_status

      call set_graph_mode(GRAPH_MODE_GRAPH)

      call make_outer_meta('harvest_comp', gc, meta, _RC)
      var_spec%state_intent = ESMF_STATEINTENT_EXPORT
      var_spec%short_name = 'T'
      var_spec%vertical_stagger = VERTICAL_STAGGER_NONE
      var_spec%quantity_type = QUANTITY_TEMPERATURE
      comp_spec => meta%get_component_spec()
      call comp_spec%add_var_spec(var_spec)
      call gb%advertise(meta, status)
      @assert_that(status, is(0))

      graph => meta%get_component_graph()
      t_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_EXPORT, 'T'))
      @assert_that(associated(t_id), is(true()))
      node => graph%get_node(t_id)
      select type (node)
      class is (StateItemNode)
         descriptor => node%get_descriptor()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertEqual(1, size(descriptor%get_unresolved_kinds()))

      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      @assertEqual(1, size(descriptor%get_unresolved_kinds()))

      geom = make_test_geom(_RC)
      field = ESMF_FieldCreate(geom=geom, typekind=ESMF_TYPEKIND_R4, name='T', _RC)
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      export_state = states%exportState
      call ESMF_StateAdd(export_state, [field], _RC)

      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      @assertEqual(0, size(descriptor%get_unresolved_kinds()))

      select type (node)
      class is (StateItemNode)
         handle => node%get_payload_ptr()
      class default
         @assert_that(.false., is(true()))
      end select
      ! The node keeps the Field created at advertise, still empty: harvest
      ! read the component's field but bound nothing.
      payload_kind = handle%itemType()
      payload_field = handle%get_field(_RC)
      call ESMF_FieldGet(payload_field, status=payload_status, _RC)
      @assertTrue(payload_kind == ESMF_STATEITEM_FIELD)
      @assertTrue(payload_status == ESMF_FIELDSTATUS_EMPTY)

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_fills_deferred_from_realized_field

   ! An import is never harvested: its geometry comes from the connected
   ! export, even when the import state holds a field of that name.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_skips_imports(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: t_id
      class(GraphNode), pointer :: node
      type(StateItemDescriptor), pointer :: descriptor
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_State) :: import_state
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: field
      type(VariableSpec) :: var_spec
      integer :: status
      type(GraphBuilder) :: gb

      call set_graph_mode(GRAPH_MODE_GRAPH)

      call make_outer_meta('harvest_import_comp', gc, meta, _RC)
      var_spec%state_intent = ESMF_STATEINTENT_IMPORT
      var_spec%short_name = 'T'
      var_spec%vertical_stagger = VERTICAL_STAGGER_NONE
      comp_spec => meta%get_component_spec()
      call comp_spec%add_var_spec(var_spec)
      call gb%advertise(meta, status)
      @assert_that(status, is(0))

      geom = make_test_geom(_RC)
      field = ESMF_FieldCreate(geom=geom, typekind=ESMF_TYPEKIND_R4, name='T', _RC)
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      import_state = states%importState
      call ESMF_StateAdd(import_state, [field], _RC)

      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))

      graph => meta%get_component_graph()
      t_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'T'))
      node => graph%get_node(t_id)
      select type (node)
      class is (StateItemNode)
         descriptor => node%get_descriptor()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertEqual(1, size(descriptor%get_unresolved_kinds()))

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_skips_imports

   ! A component that has its own geom (a History collection declaring
   ! `geom:`) gives it to every item with no geometry of its own when the
   ! geometry hook runs at GEOM_B; an item that mirrors stays MIRRORED.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_geometry_hook_resolves_deferred_imports_from_own_geom(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(ComponentSpec), pointer :: comp_spec
      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: plain_id, mirror_id
      class(GraphNode), pointer :: node
      type(StateItemDescriptor), pointer :: plain, mirror
      type(ESMF_Geom) :: geom
      type(VariableSpec) :: plain_spec, mirror_spec
      integer :: status
      type(GraphBuilder) :: gb

      call make_outer_meta('geom_comp', gc, meta, _RC)
      geom = make_test_geom(_RC)
      call meta%set_geom(geom)

      plain_spec%state_intent = ESMF_STATEINTENT_IMPORT
      plain_spec%short_name = 'P'
      plain_spec%vertical_stagger = VERTICAL_STAGGER_NONE
      mirror_spec%state_intent = ESMF_STATEINTENT_IMPORT
      mirror_spec%short_name = 'M'
      mirror_spec%vertical_stagger = VERTICAL_STAGGER_NONE
      mirror_spec%mirror_geom = .true.
      comp_spec => meta%get_component_spec()
      call comp_spec%add_var_spec(plain_spec)
      call comp_spec%add_var_spec(mirror_spec)
      call gb%advertise(meta, status)
      @assert_that(status, is(0))

      graph => meta%get_component_graph()
      plain_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'P'))
      mirror_id => graph%get_resource_index(item_key(ESMF_STATEINTENT_IMPORT, 'M'))
      node => graph%get_node(plain_id)
      select type (node)
      class is (StateItemNode)
         plain => node%get_descriptor()
      class default
         @assert_that(.false., is(true()))
      end select
      node => graph%get_node(mirror_id)
      select type (node)
      class is (StateItemNode)
         mirror => node%get_descriptor()
      class default
         @assert_that(.false., is(true()))
      end select
      @assertEqual(1, size(plain%get_unresolved_kinds()))

      call gb%run_geometry_hook(meta)

      @assertEqual(0, size(plain%get_unresolved_kinds()))
      @assertEqual(0, size(mirror%get_unresolved_kinds()))

      _UNUSED_DUMMY(this)
   end subroutine test_geometry_hook_resolves_deferred_imports_from_own_geom

   ! At GEOM_B a component's vertical grid fills an item's DEFERRED vertical
   ! coordinate. Without one the entry is dropped (the item has no vertical
   ! dimension), and a mirrored entry survives either way.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_geometry_hook_resolves_or_drops_vertical_grid(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc_with, gc_without
      type(OuterMetaComponent), pointer :: meta_with, meta_without
      type(mapl_BasicVerticalGrid) :: vgrid
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)

      call vgrid%set_id(9)
      call make_outer_meta('vgrid_comp', gc_with, meta_with, _RC)
      call meta_with%set_vertical_grid(vgrid, _RC)
      call advertise_and_hook(meta_with, _RC)
      call check_item(meta_with, 'D', ESMF_STATEINTENT_EXPORT, is_present=.true., _RC)
      call check_item(meta_with, 'M', ESMF_STATEINTENT_IMPORT, is_present=.true., _RC)

      call make_outer_meta('no_vgrid_comp', gc_without, meta_without, _RC)
      call advertise_and_hook(meta_without, _RC)
      call check_item(meta_without, 'D', ESMF_STATEINTENT_EXPORT, is_present=.false., _RC)
      call check_item(meta_without, 'M', ESMF_STATEINTENT_IMPORT, is_present=.true., _RC)

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)

   contains

      subroutine advertise_and_hook(meta, rc)
         type(OuterMetaComponent), pointer, intent(inout) :: meta
         integer, optional, intent(out) :: rc

         type(ComponentSpec), pointer :: comp_spec
         type(VariableSpec) :: deferred_spec, mirror_spec
         type(GraphBuilder) :: gb
         integer :: status

         deferred_spec%state_intent = ESMF_STATEINTENT_EXPORT
         deferred_spec%short_name = 'D'
         deferred_spec%vertical_stagger = VERTICAL_STAGGER_CENTER
         deferred_spec%geom_id = mapl_new_GeomId(1)
         deferred_spec%quantity_type = QUANTITY_TEMPERATURE
         mirror_spec%state_intent = ESMF_STATEINTENT_IMPORT
         mirror_spec%short_name = 'M'
         mirror_spec%geom_id = mapl_new_GeomId(1)
         mirror_spec%mirror_vgrid = .true.
         comp_spec => meta%get_component_spec()
         call comp_spec%add_var_spec(deferred_spec)
         call comp_spec%add_var_spec(mirror_spec)
         call gb%advertise(meta, _RC)
         call gb%run_geometry_hook(meta)
         _RETURN(_SUCCESS)
      end subroutine advertise_and_hook

      subroutine check_item(meta, name, intent, is_present, rc)
         type(OuterMetaComponent), pointer, intent(inout) :: meta
         character(*), intent(in) :: name
         type(ESMF_StateIntent_Flag), intent(in) :: intent
         logical, intent(in) :: is_present
         integer, optional, intent(out) :: rc

         type(ComponentGraph), pointer :: graph
         type(NodeId), pointer :: id
         class(GraphNode), pointer :: node
         type(StateItemDescriptor), pointer :: descriptor
         integer :: status

         graph => meta%get_component_graph()
         id => graph%get_resource_index(item_key(intent, name))
         @assert_that(associated(id), is(true()))
         node => graph%get_node(id)
         select type (node)
         class is (StateItemNode)
            descriptor => node%get_descriptor()
            @assertEqual(is_present, descriptor%has_characteristic(VERTICAL_GRID_CHARACTERISTIC_KIND))
            @assertEqual(0, size(descriptor%get_unresolved_kinds()))
         class default
            @assert_that(.false., is(true()))
         end select
         _RETURN(_SUCCESS)
      end subroutine check_item

   end subroutine test_geometry_hook_resolves_or_drops_vertical_grid

   ! -- VerticalStagger: harvest, GEOM_B, and freeze --

   subroutine find_descriptor(meta, name, intent, descriptor, rc)
      type(OuterMetaComponent), pointer, intent(inout) :: meta
      character(*), intent(in) :: name
      type(ESMF_StateIntent_Flag), intent(in) :: intent
      type(StateItemDescriptor), pointer, intent(out) :: descriptor
      integer, optional, intent(out) :: rc

      type(ComponentGraph), pointer :: graph
      type(NodeId), pointer :: id
      class(GraphNode), pointer :: node
      integer :: status

      graph => meta%get_component_graph()
      id => graph%get_resource_index(item_key(intent, name))
      @assert_that(associated(id), is(true()))
      node => graph%get_node(id)
      select type (node)
      class is (StateItemNode)
         descriptor => node%get_descriptor()
      class default
         @assert_that(.false., is(true()))
      end select
      _RETURN(_SUCCESS)
   end subroutine find_descriptor

   ! The status of the item's VERTICAL_STAGGER entry and, when it is
   ! SPECIFIED, its value.
   subroutine read_stagger(descriptor, entry_status, stagger, rc)
      type(StateItemDescriptor), intent(in) :: descriptor
      type(CharacteristicStatus), intent(out) :: entry_status
      type(VerticalStaggerLoc), intent(out) :: stagger
      integer, optional, intent(out) :: rc

      class(StateItemCharacteristic), allocatable :: c
      integer :: status

      call descriptor%get_characteristic(VERTICAL_STAGGER_CHARACTERISTIC_KIND, c, _RC)
      entry_status = c%get_status()
      select type (c)
      type is (VerticalStaggerCharacteristic)
         if (entry_status == CHARACTERISTIC_STATUS_SPECIFIED) stagger = c%get_vertical_stagger()
      end select
      _RETURN(_SUCCESS)
   end subroutine read_stagger

   ! Advertises an item with no declared stagger, in a component that
   ! has a vertical grid when with_vgrid.
   subroutine advertise_undeclared_stagger(meta, intent, with_vgrid, rc)
      type(OuterMetaComponent), pointer, intent(inout) :: meta
      type(ESMF_StateIntent_Flag), intent(in) :: intent
      logical, intent(in) :: with_vgrid
      integer, optional, intent(out) :: rc

      type(mapl_BasicVerticalGrid) :: vgrid
      type(ComponentSpec), pointer :: comp_spec
      type(VariableSpec) :: var_spec
      type(GraphBuilder) :: gb
      integer :: status

      if (with_vgrid) then
         call vgrid%set_id(9)
         call meta%set_vertical_grid(vgrid, _RC)
      end if
      var_spec%state_intent = intent
      var_spec%short_name = 'T'
      var_spec%quantity_type = QUANTITY_TEMPERATURE
      if (intent == ESMF_STATEINTENT_IMPORT) then
         var_spec%mirror_geom = .true.
      else
         var_spec%geom_id = mapl_new_GeomId(1)
      end if
      comp_spec => meta%get_component_spec()
      call comp_spec%add_var_spec(var_spec)
      call gb%advertise(meta, _RC)
      _RETURN(_SUCCESS)
   end subroutine advertise_undeclared_stagger

   ! Advertises an item whose geometry and stagger are declared, then makes
   ! its QuantityType entry DEFERRED holding a different value than any test
   ! supplies, so a resolved value is never the seed.
   subroutine advertise_deferred_quantity_type(meta, intent, descriptor, rc)
      type(OuterMetaComponent), pointer, intent(inout) :: meta
      type(ESMF_StateIntent_Flag), intent(in) :: intent
      type(StateItemDescriptor), pointer, intent(out) :: descriptor
      integer, optional, intent(out) :: rc

      type(ComponentSpec), pointer :: comp_spec
      type(VariableSpec) :: var_spec
      type(QuantityTypeCharacteristic) :: deferred
      type(GraphBuilder) :: gb
      integer :: status

      var_spec%state_intent = intent
      var_spec%short_name = 'T'
      var_spec%vertical_stagger = VERTICAL_STAGGER_NONE
      var_spec%geom_id = mapl_new_GeomId(1)
      if (intent == ESMF_STATEINTENT_IMPORT) var_spec%mirror_geom = .true.
      comp_spec => meta%get_component_spec()
      call comp_spec%add_var_spec(var_spec)
      call gb%advertise(meta, _RC)

      call find_descriptor(meta, 'T', intent, descriptor, _RC)
      deferred = QuantityTypeCharacteristic(QUANTITY_MIXING_RATIO, BASIS_DRY_MASS)
      call deferred%set_status(CHARACTERISTIC_STATUS_DEFERRED)
      call descriptor%set_characteristic(QUANTITY_TYPE_CHARACTERISTIC_KIND, deferred, _RC)
      _RETURN(_SUCCESS)
   end subroutine advertise_deferred_quantity_type

   ! The status of the item's QUANTITY_TYPE entry and its value.
   subroutine read_quantity_type(descriptor, entry_status, c, rc)
      type(StateItemDescriptor), intent(in) :: descriptor
      type(CharacteristicStatus), intent(out) :: entry_status
      type(QuantityTypeCharacteristic), intent(out) :: c
      integer, optional, intent(out) :: rc

      class(StateItemCharacteristic), allocatable :: entry
      integer :: status

      call descriptor%get_characteristic(QUANTITY_TYPE_CHARACTERISTIC_KIND, entry, _RC)
      entry_status = entry%get_status()
      select type (entry)
      type is (QuantityTypeCharacteristic)
         c = entry
      end select
      _RETURN(_SUCCESS)
   end subroutine read_quantity_type

   ! A quantity type the component set on its realized Field fills the
   ! DEFERRED entry. Before the Field exists, or when it carries no
   ! metadata, the entry stays DEFERRED.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_fills_quantity_type_from_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(StateItemDescriptor), pointer :: descriptor
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_State) :: export_state
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: field
      type(CharacteristicStatus) :: entry_status
      type(QuantityTypeCharacteristic) :: c
      type(GraphBuilder) :: gb
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call make_outer_meta('qt_harvest_field', gc, meta, _RC)
      call advertise_deferred_quantity_type(meta, ESMF_STATEINTENT_EXPORT, descriptor, _RC)

      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_quantity_type(descriptor, entry_status, c, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_DEFERRED)

      geom = make_test_geom(_RC)
      field = ESMF_FieldCreate(geom=geom, typekind=ESMF_TYPEKIND_R4, name='T', _RC)
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      export_state = states%exportState
      call ESMF_StateAdd(export_state, [field], _RC)

      ! No metadata set: an absent key reads back as a mirror.
      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_quantity_type(descriptor, entry_status, c, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_DEFERRED)

      ! An explicit UNKNOWN supplies nothing.
      call MAPL_FieldSet(field, quantity_type_metadata= &
           QuantityTypeMetadata(QUANTITY_UNKNOWN), _RC)
      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_quantity_type(descriptor, entry_status, c, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_DEFERRED)

      call MAPL_FieldSet(field, quantity_type_metadata= &
           QuantityTypeMetadata(QUANTITY_TEMPERATURE, basis=BASIS_NONE), _RC)
      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_quantity_type(descriptor, entry_status, c, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertTrue(c%get_quantity_type() == QUANTITY_TEMPERATURE)
      @assertTrue(c%get_basis() == BASIS_NONE)

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_fills_quantity_type_from_field

   ! The basis comes with the quantity type, not only the type.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_fills_quantity_type_and_basis(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(StateItemDescriptor), pointer :: descriptor
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_State) :: export_state
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: field
      type(CharacteristicStatus) :: entry_status
      type(QuantityTypeCharacteristic) :: c
      type(GraphBuilder) :: gb
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call make_outer_meta('qt_harvest_basis', gc, meta, _RC)
      call advertise_deferred_quantity_type(meta, ESMF_STATEINTENT_EXPORT, descriptor, _RC)

      geom = make_test_geom(_RC)
      field = ESMF_FieldCreate(geom=geom, typekind=ESMF_TYPEKIND_R4, name='T', _RC)
      call MAPL_FieldSet(field, quantity_type_metadata= &
           QuantityTypeMetadata(QUANTITY_TEMPERATURE, basis=BASIS_WET_MASS), _RC)
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      export_state = states%exportState
      call ESMF_StateAdd(export_state, [field], _RC)

      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_quantity_type(descriptor, entry_status, c, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertTrue(c%get_quantity_type() == QUANTITY_TEMPERATURE)
      @assertTrue(c%get_basis() == BASIS_WET_MASS)

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_fills_quantity_type_and_basis

   ! A FieldBundle's own metadata supplies the quantity type and basis.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_fills_quantity_type_from_bundle(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(StateItemDescriptor), pointer :: descriptor
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_State) :: export_state
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: field
      type(ESMF_FieldBundle) :: bundle
      type(CharacteristicStatus) :: entry_status
      type(QuantityTypeCharacteristic) :: c
      type(GraphBuilder) :: gb
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call make_outer_meta('qt_harvest_bundle', gc, meta, _RC)
      call advertise_deferred_quantity_type(meta, ESMF_STATEINTENT_EXPORT, descriptor, _RC)

      geom = make_test_geom(_RC)
      field = ESMF_FieldCreate(geom=geom, typekind=ESMF_TYPEKIND_R4, name='F', _RC)
      bundle = ESMF_FieldBundleCreate(fieldList=[field], name='T', _RC)
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      export_state = states%exportState
      call ESMF_StateAdd(export_state, fieldbundleList=[bundle], _RC)

      ! No metadata set: the bundle reads back QUANTITY_UNKNOWN, not a mirror.
      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_quantity_type(descriptor, entry_status, c, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_DEFERRED)

      call MAPL_FieldBundleSet(bundle, quantity_type_metadata= &
           QuantityTypeMetadata(QUANTITY_TEMPERATURE, basis=BASIS_NONE), _RC)
      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_quantity_type(descriptor, entry_status, c, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertTrue(c%get_quantity_type() == QUANTITY_TEMPERATURE)

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_fills_quantity_type_from_bundle

   ! An import is never harvested, even when its field carries metadata.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_skips_imports_for_quantity_type(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(StateItemDescriptor), pointer :: descriptor
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_State) :: import_state
      type(ESMF_Geom) :: geom
      type(ESMF_Field) :: field
      type(CharacteristicStatus) :: entry_status
      type(QuantityTypeCharacteristic) :: c
      type(GraphBuilder) :: gb
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call make_outer_meta('qt_harvest_import', gc, meta, _RC)
      call advertise_deferred_quantity_type(meta, ESMF_STATEINTENT_IMPORT, descriptor, _RC)

      geom = make_test_geom(_RC)
      field = ESMF_FieldCreate(geom=geom, typekind=ESMF_TYPEKIND_R4, name='T', _RC)
      call MAPL_FieldSet(field, quantity_type_metadata= &
           QuantityTypeMetadata(QUANTITY_TEMPERATURE, basis=BASIS_NONE), _RC)
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      import_state = states%importState
      call ESMF_StateAdd(import_state, [field], _RC)

      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_quantity_type(descriptor, entry_status, c, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_DEFERRED)

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_skips_imports_for_quantity_type

   function make_field_with_stagger(recorded, rc) result(field)
      type(VerticalStaggerLoc), optional, intent(in) :: recorded
      integer, optional, intent(out) :: rc
      type(ESMF_Field) :: field

      type(ESMF_Geom) :: geom
      integer :: status

      geom = make_test_geom(_RC)
      field = ESMF_FieldCreate(geom=geom, typekind=ESMF_TYPEKIND_R4, name='T', _RC)
      if (present(recorded)) call MAPL_FieldSet(field, vert_staggerloc=recorded, _RC)
      _RETURN(_SUCCESS)
   end function make_field_with_stagger

   ! A stagger the component recorded on its realized Field fills the
   ! DEFERRED entry, even though the component has a vertical grid.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_fills_vertical_stagger_from_field(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(StateItemDescriptor), pointer :: descriptor
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_State) :: export_state
      type(ESMF_Field) :: field
      type(CharacteristicStatus) :: entry_status
      type(VerticalStaggerLoc) :: stagger
      type(GraphBuilder) :: gb
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call make_outer_meta('stagger_harvest_field', gc, meta, _RC)
      call advertise_undeclared_stagger(meta, ESMF_STATEINTENT_EXPORT, with_vgrid=.true., _RC)
      call find_descriptor(meta, 'T', ESMF_STATEINTENT_EXPORT, descriptor, _RC)

      call read_stagger(descriptor, entry_status, stagger, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_DEFERRED)

      field = make_field_with_stagger(VERTICAL_STAGGER_EDGE, _RC)
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      export_state = states%exportState
      call ESMF_StateAdd(export_state, [field], _RC)

      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_stagger(descriptor, entry_status, stagger, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(VERTICAL_STAGGER_EDGE%to_string(), stagger%to_string())

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_fills_vertical_stagger_from_field

   ! A bundle's first member supplies the stagger.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_fills_vertical_stagger_from_bundle(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(StateItemDescriptor), pointer :: descriptor
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_State) :: export_state
      type(ESMF_Field) :: field
      type(ESMF_FieldBundle) :: bundle
      type(CharacteristicStatus) :: entry_status
      type(VerticalStaggerLoc) :: stagger
      type(GraphBuilder) :: gb
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call make_outer_meta('stagger_harvest_bundle', gc, meta, _RC)
      call advertise_undeclared_stagger(meta, ESMF_STATEINTENT_EXPORT, with_vgrid=.true., _RC)
      call find_descriptor(meta, 'T', ESMF_STATEINTENT_EXPORT, descriptor, _RC)

      field = make_field_with_stagger(VERTICAL_STAGGER_CENTER, _RC)
      bundle = ESMF_FieldBundleCreate(fieldList=[field], name='T', _RC)
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      export_state = states%exportState
      call ESMF_StateAdd(export_state, fieldbundleList=[bundle], _RC)

      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_stagger(descriptor, entry_status, stagger, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(VERTICAL_STAGGER_CENTER%to_string(), stagger%to_string())

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_fills_vertical_stagger_from_bundle

   ! A realized field that recorded no stagger leaves the entry DEFERRED;
   ! freeze reports it rather than a default being invented.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_leaves_stagger_when_field_recorded_none(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(StateItemDescriptor), pointer :: descriptor
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_State) :: export_state
      type(ESMF_Field) :: field
      type(CharacteristicStatus) :: entry_status
      type(VerticalStaggerLoc) :: stagger
      type(GraphBuilder) :: gb
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call make_outer_meta('stagger_harvest_unrecorded', gc, meta, _RC)
      call advertise_undeclared_stagger(meta, ESMF_STATEINTENT_EXPORT, with_vgrid=.true., _RC)
      call find_descriptor(meta, 'T', ESMF_STATEINTENT_EXPORT, descriptor, _RC)

      field = make_field_with_stagger(rc=status)
      @assert_that(status, is(0))
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      export_state = states%exportState
      call ESMF_StateAdd(export_state, [field], _RC)

      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_stagger(descriptor, entry_status, stagger, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_DEFERRED)

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_leaves_stagger_when_field_recorded_none

   ! An import never harvests: its stagger comes from the connected export.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_harvest_skips_import_vertical_stagger(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(StateItemDescriptor), pointer :: descriptor
      type(GriddedComponentDriver), pointer :: driver
      type(MultiState) :: states
      type(ESMF_State) :: import_state
      type(ESMF_Field) :: field
      type(CharacteristicStatus) :: entry_status
      type(VerticalStaggerLoc) :: stagger
      type(GraphBuilder) :: gb
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call make_outer_meta('stagger_harvest_import', gc, meta, _RC)
      call advertise_undeclared_stagger(meta, ESMF_STATEINTENT_IMPORT, with_vgrid=.true., _RC)
      call find_descriptor(meta, 'T', ESMF_STATEINTENT_IMPORT, descriptor, _RC)

      field = make_field_with_stagger(VERTICAL_STAGGER_EDGE, _RC)
      driver => meta%get_user_gc_driver()
      states = driver%get_states()
      import_state = states%importState
      call ESMF_StateAdd(import_state, [field], _RC)

      call gb%harvest_deferred(meta, rc=status)
      @assert_that(status, is(0))
      call read_stagger(descriptor, entry_status, stagger, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_DEFERRED)

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_harvest_skips_import_vertical_stagger

   ! At GEOM_B an undeclared stagger becomes NONE only in a component with
   ! no vertical grid; with a grid it waits for the harvest.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_geometry_hook_resolves_undeclared_stagger(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc_with, gc_without
      type(OuterMetaComponent), pointer :: meta_with, meta_without
      type(StateItemDescriptor), pointer :: with_grid, without_grid
      type(CharacteristicStatus) :: entry_status
      type(VerticalStaggerLoc) :: stagger
      type(GraphBuilder) :: gb
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)

      call make_outer_meta('stagger_geomb_with', gc_with, meta_with, _RC)
      call advertise_undeclared_stagger(meta_with, ESMF_STATEINTENT_EXPORT, with_vgrid=.true., _RC)
      call find_descriptor(meta_with, 'T', ESMF_STATEINTENT_EXPORT, with_grid, _RC)
      call gb%run_geometry_hook(meta_with)
      call read_stagger(with_grid, entry_status, stagger, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_DEFERRED)

      call make_outer_meta('stagger_geomb_without', gc_without, meta_without, _RC)
      call advertise_undeclared_stagger(meta_without, ESMF_STATEINTENT_EXPORT, with_vgrid=.false., _RC)
      call find_descriptor(meta_without, 'T', ESMF_STATEINTENT_EXPORT, without_grid, _RC)
      call gb%run_geometry_hook(meta_without)
      call read_stagger(without_grid, entry_status, stagger, _RC)
      @assertTrue(entry_status == CHARACTERISTIC_STATUS_SPECIFIED)
      @assertEqual(VERTICAL_STAGGER_NONE%to_string(), stagger%to_string())
      @assertFalse(without_grid%has_characteristic(VERTICAL_GRID_CHARACTERISTIC_KIND))

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_geometry_hook_resolves_undeclared_stagger

   ! A stagger that is never harvested fails freeze, naming the item.
   @test(type=ESMF_TestMethod, npes=[1])
   subroutine test_unharvested_stagger_fails_freeze(this)
      class(ESMF_TestMethod), intent(inout) :: this

      type(ESMF_GridComp) :: gc
      type(OuterMetaComponent), pointer :: meta
      type(GraphBuilder) :: gb
      integer :: status

      call set_graph_mode(GRAPH_MODE_GRAPH)
      call make_outer_meta('stagger_freeze', gc, meta, _RC)
      call advertise_undeclared_stagger(meta, ESMF_STATEINTENT_EXPORT, with_vgrid=.true., _RC)
      call gb%run_geometry_hook(meta)

      call gb%run_graph_freeze_hook(meta)
      @assertExceptionRaised('StateItemDescriptor: item ' // meta%get_name() // ':T has characteristic VERTICAL_STAGGER still DEFERRED at freeze')
      @assertExceptionRaised('GraphBuilder: characteristics unresolved at freeze')

      call set_graph_mode(GRAPH_MODE_REGISTRY)
      _UNUSED_DUMMY(this)
   end subroutine test_unharvested_stagger_fails_freeze

end module Test_GraphGeometryHook
