      call ConfigurableCallbackCreate(state, hconfig, rc=status)
      @assertExceptionRaised('ConfigurableCallback: key <geometry> is not supported; pass the grid to ConfigurableCallbackCreate')
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_geometry_rejected

   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_function_form_rejected(this)
      class(ESMF_TestMethod), intent(inout) :: this
      type(ESMF_State) :: state
      type(ESMF_Grid) :: grid
      type(ESMF_HConfig) :: hconfig
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[4,4], rc=status)
      @assertEqual(0, status)
      hconfig = ESMF_HConfigCreate(content= &
           '{fields: {num: {dims: xy}}, methods: {m: {supply: {fields: {num: {function: lon}}}}}}', rc=status)
      @assertEqual(0, status)
      call ConfigurableCallbackCreate(state, hconfig, grid=grid, rc=status)
      @assertExceptionRaised('ConfigurableCallback: key <methods/m/supply/fields/num/function>: the function supply form is not supported')
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_function_form_rejected

   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_xyz_field_requires_num_levels(this)
      class(ESMF_TestMethod), intent(inout) :: this
      type(ESMF_State) :: state
      type(ESMF_Grid) :: grid
      type(ESMF_HConfig) :: hconfig
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[4,4], rc=status)
      @assertEqual(0, status)
      hconfig = ESMF_HConfigCreate(content='{fields: {T: {dims: xyz}}}', rc=status)
      @assertEqual(0, status)
      call ConfigurableCallbackCreate(state, hconfig, grid=grid, rc=status)
      @assertExceptionRaised('ConfigurableCallback: field <T> has dims xyz but no positive num_levels was passed to ConfigurableCallbackCreate')
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_xyz_field_requires_num_levels

   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_profile_wrong_length(this)
      class(ESMF_TestMethod), intent(inout) :: this
      type(ESMF_State) :: state
      type(ESMF_Grid) :: grid
      type(ESMF_HConfig) :: hconfig
      integer :: status

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[4,4], rc=status)
      @assertEqual(0, status)
      hconfig = ESMF_HConfigCreate(content= &
           '{fields: {T: {dims: xyz}}, methods: {m: {supply: {fields: {T: {profile: [1.5, 2.5]}}}}}}', rc=status)
      @assertEqual(0, status)
      call ConfigurableCallbackCreate(state, hconfig, grid=grid, num_levels=NUM_LEVELS, rc=status)
      @assertExceptionRaised('ConfigurableCallback: key <methods/m/supply/fields/T/profile> must be a list of 3 numbers')
      @assertTrue(status /= 0)

      _UNUSED_DUMMY(this)
   end subroutine test_profile_wrong_length

   @Test(type=ESMF_TestMethod, npes=[1])
   subroutine test_by_call_past_end(this)
      class(ESMF_TestMethod), intent(inout) :: this
      type(ESMF_State) :: state
      type(ESMF_Grid) :: grid
      type(ESMF_HConfig) :: hconfig
      integer :: status, user_rc

      grid = ESMF_GridCreateNoPeriDim(maxIndex=[4,4], rc=status)
      @assertEqual(0, status)
      hconfig = ESMF_HConfigCreate(content= &
           '{fields: {num: {dims: xy}}, methods: {m: {supply: {fields: {num: {by_call: [{constant: 1.5}]}}}}}}', rc=status)
      @assertEqual(0, status)
      call ConfigurableCallbackCreate(state, hconfig, grid=grid, rc=status)
      @assertEqual(0, status)

      call client_execute(state, 'm')
      @assertEqual(1.5, field_value_2d(state, 'num'))

      call ESMF_MethodExecute(state, label='m', userRc=user_rc, rc=status)
      @assertExceptionRaised('ConfigurableCallback: method <m>, <supply/fields/num>: by_call has 1 forms but this is call 2')
      call drain_exceptions()
      @assertEqual(ESMF_SUCCESS, status)
      @assertEqual(MOCK_INTERNAL_ERROR_RC, user_rc)

      _UNUSED_DUMMY(this)
   end subroutine test_by_call_past_end

end module Test_ConfigurableCallback
