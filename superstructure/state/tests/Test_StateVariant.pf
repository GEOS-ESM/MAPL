#include "MAPL_TestErr.h"

module Test_StateVariant
   use mapl_state_api, only: MAPL_StateSet, MAPL_StateGet
   use mapl_StateItemFlag_mod
   use pfunit
   use esmf
   implicit none(type,external)

contains

   @test
   subroutine test_state_variant_round_trip()
      type(ESMF_State) :: state
      type(MAPL_StateItem_Flag) :: variant
      integer :: status

      state = ESMF_StateCreate(name='s', _RC)

      call MAPL_StateGet(state, state_item_variant=variant, _RC)
      @assert_that(variant == MAPL_STATEITEM_INVALID, is(.true.))

      call MAPL_StateSet(state, state_item_variant=MAPL_STATEITEM_VERTICALGRID, _RC)
      call MAPL_StateGet(state, state_item_variant=variant, _RC)
      @assert_that(variant == MAPL_STATEITEM_VERTICALGRID, is(.true.))
   end subroutine test_state_variant_round_trip

end module Test_StateVariant
